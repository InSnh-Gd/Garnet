<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key><string>com.garnet.native-translate</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Library/Application Support/Garnet/native/native-translate</string>
    </array>
    <key>UserName</key><string>nobody</string>
    <key>GroupName</key><string>nobody</string>
    <key>RunAtLoad</key><true/>
    <key>KeepAlive</key><true/>
    <key>ThrottleInterval</key><integer>5</integer>
    <key>ProcessType</key><string>Background</string>
    <key>Nice</key><integer>5</integer>
    <key>Umask</key><integer>18</integer>
    <key>SoftResourceLimits</key>
    <dict><key>NumberOfFiles</key><integer>256</integer><key>Core</key><integer>0</integer></dict>
    <key>ExitTimeOut</key><integer>5</integer>
    <key>StandardOutPath</key><string>/Library/Logs/GarnetTranslate/translate.stdout</string>
    <key>StandardErrorPath</key><string>/Library/Logs/GarnetTranslate/translate.stderr</string>
</dict>
</plist>
