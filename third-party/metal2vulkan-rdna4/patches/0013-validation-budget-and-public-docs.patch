+
+fn reserve_budget(counter: &AtomicUsize, limit: &AtomicUsize, bytes: usize) -> bool {
+    let mut live = counter.load(Ordering::Relaxed);
+    loop {
+        let Some(next) = live.checked_add(bytes) else {
+            return false;
+        };
+        if next > limit.load(Ordering::Relaxed) {
+            return false;
+        }
+        match counter.compare_exchange_weak(live, next, Ordering::Relaxed, Ordering::Relaxed) {
+            Ok(_) => return true,
+            Err(current) => live = current,
+        }
+    }
+}
+
+#[test]
+fn allocation_budget_preserves_boundaries_and_released_capacity() {
+    let counter = AtomicUsize::new(7);
+    let limit = AtomicUsize::new(10);
+    assert!(reserve_budget(&counter, &limit, 3));
+    assert!(!reserve_budget(&counter, &limit, 1));
+    assert_eq!(counter.load(Ordering::Relaxed), 10);
+    counter.fetch_sub(4, Ordering::Relaxed);
+    assert!(reserve_budget(&counter, &limit, 4));
+    limit.store(9, Ordering::Relaxed);
+    assert!(!reserve_budget(&counter, &limit, 0));
+    counter.store(usize::MAX, Ordering::Relaxed);
+    limit.store(usize::MAX, Ordering::Relaxed);
+    assert!(!reserve_budget(&counter, &limit, 1));
+    assert_eq!(counter.load(Ordering::Relaxed), usize::MAX);
+}
+
+#[test]
+fn allocation_budget_serializes_concurrent_reservations() {
+    let counter = AtomicUsize::new(0);
+    let limit = AtomicUsize::new(1000);
+    let start = Barrier::new(8);
+    let reserved = std::thread::scope(|scope| {
+        let threads: Vec<_> = (0..8)
+            .map(|_| {
+                scope.spawn(|| {
+                    start.wait();
+                    (0..1000)
+                        .filter(|_| reserve_budget(&counter, &limit, 1))
+                        .count()
+                })
+            })
+            .collect();
+        threads
+            .into_iter()
+            .map(|thread| thread.join().unwrap())
+            .sum::<usize>()
+    });
+    assert_eq!(reserved, 1000);
+    assert_eq!(counter.load(Ordering::Relaxed), 1000);
 }
 
