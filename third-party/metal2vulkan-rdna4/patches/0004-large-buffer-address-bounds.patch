+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+struct IntRange {
+    min: i128,
+    max: i128,
+}
+
+impl IntRange {
+    const ZERO: Self = Self { min: 0, max: 0 };
+
+    fn point(value: i128) -> Self {
+        Self {
+            min: value,
+            max: value,
+        }
+    }
+
+    fn full() -> Self {
+        Self {
+            min: i128::MIN,
+            max: i128::MAX,
+        }
+    }
+
+    fn signed(bits: u32) -> Self {
+        if bits == 0 || bits >= 127 {
+            return Self::full();
+        }
+        let half = 1i128 << (bits - 1);
+        Self {
+            min: -half,
+            max: half - 1,
+        }
+    }
+
+    fn unsigned(bits: u32) -> Self {
+        if bits == 0 || bits >= 127 {
+            return Self::full();
+        }
+        Self {
+            min: 0,
+            max: (1i128 << bits) - 1,
+        }
+    }
+
+    fn union(self, other: Self) -> Self {
+        Self {
+            min: self.min.min(other.min),
+            max: self.max.max(other.max),
+        }
+    }
+
+    fn checked_add(self, other: Self) -> Self {
+        self.min
+            .checked_add(other.min)
+            .zip(self.max.checked_add(other.max))
+            .map_or_else(Self::full, |(min, max)| Self { min, max })
+    }
+
+    fn checked_sub(self, other: Self) -> Self {
+        self.min
+            .checked_sub(other.max)
+            .zip(self.max.checked_sub(other.min))
+            .map_or_else(Self::full, |(min, max)| Self { min, max })
+    }
+
+    fn checked_mul(self, other: Self) -> Self {
+        let products = [
+            self.min.checked_mul(other.min),
+            self.min.checked_mul(other.max),
+            self.max.checked_mul(other.min),
+            self.max.checked_mul(other.max),
+        ];
+        let [Some(first), Some(second), Some(third), Some(fourth)] = products else {
+            return Self::full();
+        };
+        Self {
+            min: first.min(second).min(third).min(fourth),
+            max: first.max(second).max(third).max(fourth),
+        }
+    }
+
+    fn scaled(self, factor: u64) -> Self {
+        self.checked_mul(Self::point(i128::from(factor)))
+    }
+
+    fn clamp(self, bounds: Self) -> Self {
+        let min = self.min.max(bounds.min);
+        let max = self.max.min(bounds.max);
+        if min <= max {
+            Self { min, max }
+        } else {
+            Self::full()
+        }
+    }
+
+    fn needs_64bit_addressing(self) -> bool {
+        self.max > i128::from(u32::MAX) || self.min < i128::from(i32::MIN)
+    }
+}
+
+fn integer_bits(parsed: &LlModule, ty: &LlType) -> Option<u32> {
+    match parsed.resolve_known_type(ty) {
+        LlType::Int(bits) => Some(bits),
+        _ => None,
+    }
+}
+
+fn unsigned_constant(value: &LlValue, bits: u32) -> Option<u128> {
+    if bits > 128 {
+        return None;
+    }
+    let mask = if bits == 128 {
+        u128::MAX
+    } else {
+        (1u128 << bits) - 1
+    };
+    let value = match value {
+        LlValue::Zero => 0,
+        LlValue::Int(value) | LlValue::Hex(value) => u128::from(*value),
+        LlValue::SignedInt(value) => *value as i128 as u128,
+        _ => return None,
+    };
+    Some(value & mask)
+}
+
+fn signed_constant(value: &LlValue, bits: u32) -> Option<i128> {
+    let value = unsigned_constant(value, bits)?;
+    if bits == 0 {
+        return None;
+    }
+    if bits == 128 {
+        return Some(value as i128);
+    }
+    let sign = 1u128 << (bits - 1);
+    if value & sign == 0 {
+        return Some(value as i128);
+    }
+    let extended = value | (!0u128 << bits);
+    Some(extended as i128)
+}
+
+fn size_align(parsed: &LlModule, ty: &LlType) -> Option<(u64, u64)> {
+    crate::layout::raw_size_align(
+        ty,
