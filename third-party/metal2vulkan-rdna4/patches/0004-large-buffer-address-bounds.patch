+            let shifted = if byte == 0 {
+                int_value
+            } else {
+                let shift = self.const_int(bits, byte * 8)?;
+                let shifted = self.fresh();
+                instructions.push(Self::inst(
+                    Op::ShiftRightLogical,
+                    Some(int_ty),
+                    Some(shifted),
+                    vec![Operand::IdRef(int_value), Operand::IdRef(shift)],
