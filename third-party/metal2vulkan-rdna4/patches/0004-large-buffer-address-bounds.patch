+        let length = phi_i64(self, |bounds| bounds.length, instructions)?;
+        let access = phi_i64(self, |bounds| bounds.access, instructions)?;
+        let all_always_checked = bounds
+            .iter()
+            .all(|bounds| bounds.as_ref().is_some_and(|bounds| bounds.when.is_none()));
