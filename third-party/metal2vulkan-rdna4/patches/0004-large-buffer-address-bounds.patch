+                shifted
+            };
+            let byte_value = self.fresh();
+            instructions.push(Self::inst(
+                Op::UConvert,
+                Some(uchar_ty),
+                Some(byte_value),
+                vec![Operand::IdRef(shifted)],
+            ));
