+                .iter()
+                .filter_map(|(bounds, _)| match bounds {
+                    ForwardTableBounds::Checked(bounds) => Some(bounds.clone()),
+                    ForwardTableBounds::Unchecked | ForwardTableBounds::Recursive => None,
