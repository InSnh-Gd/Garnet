+fn integer_range(
+    parsed: &LlModule,
+    defs: &HashMap<&str, &crate::native::tir::TirInst>,
+    ty: &LlType,
+    value: &LlValue,
+    visiting: &mut HashSet<String>,
+) -> IntRange {
+    let Some(bits) = integer_bits(parsed, ty) else {
+        return IntRange::full();
+    };
+    let fallback = IntRange::signed(bits);
+    if let Some(value) = signed_constant(value, bits) {
+        return IntRange::point(value);
+    }
+    let LlValue::Local(name) = value else {
+        return fallback;
+    };
+    let Some(inst) = defs.get(name.as_str()) else {
+        return fallback;
+    };
+    if !visiting.insert(name.clone()) {
+        return fallback;
+    }
+
+    let operands = inst
+        .operands
+        .iter()
+        .filter_map(crate::native::tir::TirOperand::as_typed_value)
+        .collect::<Vec<_>>();
+    let range = match inst.opcode.as_str() {
+        "freeze" => operands.first().map_or(fallback, |operand| {
+            integer_range(parsed, defs, &operand.ty, &operand.value, visiting)
+        }),
+        "select" => {
+            inst.select_arms().as_ref().map_or(fallback, |arms| {
+                integer_range(parsed, defs, &arms.0.ty, &arms.0.value, visiting).union(
+                    integer_range(parsed, defs, &arms.1.ty, &arms.1.value, visiting),
+                )
+            })
+        }
+        "phi" => inst
+            .phi_incoming()
+            .as_ref()
+            .map_or(fallback, |(ty, incoming)| {
+                let mut values = incoming.iter();
+                let Some((first, _)) = values.next() else {
+                    return fallback;
+                };
+                values.fold(
+                    integer_range(parsed, defs, ty, first, visiting),
+                    |range, (value, _)| {
+                        range.union(integer_range(parsed, defs, ty, value, visiting))
+                    },
+                )
+            }),
+        "and" => operands
+            .iter()
+            .find_map(|operand| {
+                let mask = unsigned_constant(&operand.value, bits)?;
+                (bits > 0 && mask < (1u128 << (bits - 1))).then(|| IntRange {
+                    min: 0,
+                    max: mask.min(i128::MAX as u128) as i128,
+                })
+            })
+            .unwrap_or(fallback),
+        "or" | "xor" if operands.len() == 2 => {
+            let zero_lhs = unsigned_constant(&operands[0].value, bits) == Some(0);
+            let zero_rhs = unsigned_constant(&operands[1].value, bits) == Some(0);
+            if zero_lhs {
+                integer_range(parsed, defs, &operands[1].ty, &operands[1].value, visiting)
+            } else if zero_rhs {
+                integer_range(parsed, defs, &operands[0].ty, &operands[0].value, visiting)
+            } else {
+                fallback
+            }
+        }
+        "add" | "sub" | "mul" if operands.len() == 2 => {
+            let lhs = integer_range(parsed, defs, &operands[0].ty, &operands[0].value, visiting);
+            let rhs = integer_range(parsed, defs, &operands[1].ty, &operands[1].value, visiting);
+            match inst.opcode.as_str() {
+                "add" => lhs.checked_add(rhs),
+                "sub" => lhs.checked_sub(rhs),
+                _ => lhs.checked_mul(rhs),
+            }
+        }
+        "shl" if operands.len() == 2 => {
+            let shift = signed_constant(&operands[1].value, bits)
+                .and_then(|shift| u32::try_from(shift).ok());
+            shift
+                .and_then(|shift| {
+                    (shift < bits && shift < 64).then(|| {
+                        integer_range(parsed, defs, &operands[0].ty, &operands[0].value, visiting)
+                            .scaled(1u64 << shift)
+                    })
+                })
+                .unwrap_or(fallback)
+        }
+        "zext" => operands.first().map_or(fallback, |operand| {
+            integer_bits(parsed, &operand.ty)
+                .map_or(fallback, IntRange::unsigned)
+                .clamp(IntRange::unsigned(bits))
+        }),
+        "sext" => operands.first().map_or(fallback, |operand| {
+            integer_range(parsed, defs, &operand.ty, &operand.value, visiting)
+                .clamp(IntRange::signed(bits))
+        }),
+        "trunc" => fallback,
+        _ => fallback,
+    };
+    visiting.remove(name);
+    // Integer arithmetic wraps modulo the declared width. An interval that crosses the signed
+    // domain therefore cannot be narrowed by intersecting it with that domain: wrapping can place
+    // the result on the opposite side. Keep the whole domain whenever overflow is possible.
+    if range.min < fallback.min || range.max > fallback.max {
+        fallback
+    } else {
+        range
+    }
+}
+
+fn gep_byte_offset_range(
+    parsed: &LlModule,
+    source_ty: &LlType,
+    indices: &[TypedValue],
+    mut index_range: impl FnMut(&TypedValue) -> IntRange,
+) -> Option<IntRange> {
+    let mut offset = IntRange::ZERO;
+    let mut cur = parsed.resolve_known_type(source_ty);
+    for (position, index) in indices.iter().enumerate() {
+        if position == 0 {
+            let (stride, _) = size_align(parsed, &cur)?;
+            offset = offset.checked_add(index_range(index).scaled(stride));
+            continue;
+        }
+        match cur {
+            LlType::Struct(fields) => {
+                let member = signed_constant(&index.value, integer_bits(parsed, &index.ty)?)?;
+                let member = usize::try_from(member).ok()?;
+                let field = fields.get(member)?.clone();
+                offset = offset.checked_add(IntRange::point(i128::from(member_offset(
+                    parsed, &fields, member,
+                )?)));
+                cur = parsed.resolve_known_type(&field);
+            }
+            LlType::Array(elem, _) => {
+                let (size, align) = size_align(parsed, &elem)?;
+                if align == 0 {
+                    return None;
+                }
+                let stride = size.div_ceil(align).checked_mul(align)?;
+                offset = offset.checked_add(index_range(index).scaled(stride));
+                cur = parsed.resolve_known_type(&elem);
+            }
+            LlType::Vector(elem, _) => {
+                let (stride, _) = size_align(parsed, &elem)?;
+                offset = offset.checked_add(index_range(index).scaled(stride));
+                cur = parsed.resolve_known_type(&elem);
+            }
+            _ => return None,
+        }
+    }
+    Some(offset)
+}
+
+fn merge_root_ranges(into: &mut HashMap<usize, IntRange>, from: &HashMap<usize, IntRange>) {
+    for (root, range) in from {
+        into.entry(*root)
+            .and_modify(|current| *current = current.union(*range))
+            .or_insert(*range);
+    }
+}
+
+fn pointer_root_ranges(
+    parsed: &LlModule,
+    function: &LlFunction,
+    defs: &HashMap<&str, &crate::native::tir::TirInst>,
+    value: &LlValue,
+    visiting: &mut HashSet<String>,
+) -> Option<HashMap<usize, IntRange>> {
+    if let LlValue::Local(name) = value {
+        if let Some(index) = function
+            .params
+            .iter()
+            .position(|(param, ty)| param == name && matches!(ty, LlType::Ptr(0..=2)))
+        {
+            return Some(HashMap::from([(index, IntRange::ZERO)]));
+        }
+    }
+    let LlValue::Local(name) = value else {
+        return None;
+    };
+    let inst = defs.get(name.as_str())?;
+    if !visiting.insert(name.clone()) {
+        return None;
+    }
+    let ranges = if let Some(gep) = inst.gep().as_deref() {
+        let ranges = pointer_root_ranges(parsed, function, defs, &gep.base.value, visiting)?;
+        let offset = gep_byte_offset_range(parsed, &gep.source_ty, &gep.indices, |index| {
+            integer_range(parsed, defs, &index.ty, &index.value, &mut HashSet::new())
+        })?;
+        Some(
+            ranges
+                .into_iter()
+                .map(|(root, range)| (root, range.checked_add(offset)))
+                .collect(),
+        )
+    } else if let Some((_, base)) = inst.identity_ptr_bitcast() {
+        pointer_root_ranges(
+            parsed,
+            function,
+            defs,
+            &LlValue::Local(base.to_string()),
+            visiting,
+        )
+    } else if inst.opcode == "freeze" {
+        let operand = inst.operands.first().and_then(|op| op.as_typed_value())?;
+        pointer_root_ranges(parsed, function, defs, &operand.value, visiting)
+    } else if let Some(arms) = inst.select_arms().as_ref() {
+        let mut ranges = pointer_root_ranges(parsed, function, defs, &arms.0.value, visiting)?;
+        merge_root_ranges(
+            &mut ranges,
+            &pointer_root_ranges(parsed, function, defs, &arms.1.value, visiting)?,
+        );
+        Some(ranges)
+    } else if let Some((_, incoming)) = inst.phi_incoming().as_ref() {
+        let mut ranges = HashMap::new();
+        for (value, _) in incoming {
+            merge_root_ranges(
+                &mut ranges,
+                &pointer_root_ranges(parsed, function, defs, value, visiting)?,
+            );
+        }
+        Some(ranges)
+    } else {
+        None
+    };
+    visiting.remove(name);
+    ranges
+}
+
+pub(super) fn large_buffer_addressing_roots(parsed: &LlModule) -> HashSet<(String, String)> {
+    let functions_by_name = parsed
+        .functions
+        .iter()
+        .map(|function| (function.name.as_str(), function))
+        .collect::<HashMap<_, _>>();
+    let mut large_params = parsed
+        .metadata_data_buffer_params
+        .iter()
+        .filter(|key| !parsed.metadata_argument_buffer_params.contains(key))
+        .filter_map(|(function_name, parameter_name)| {
+            let function = functions_by_name.get(function_name.as_str())?;
+            function
+                .params
+                .iter()
+                .position(|(name, ty)| name == parameter_name && matches!(ty, LlType::Ptr(0..=2)))
+                .map(|index| (function_name.clone(), index))
+        })
+        .collect::<HashSet<_>>();
+    if large_params.is_empty() {
+        return HashSet::new();
+    }
+
+    // A direct entry buffer can reach a helper through another GEP/bitcast/phi. Propagate the
+    // "rooted in an ordinary top-level buffer" fact across call edges before looking at indexing.
+    loop {
+        let mut additions = Vec::new();
+        for function in &parsed.functions {
+            for inst in function.carrier_insts() {
+                let Some(call) = inst.call().as_deref() else {
+                    continue;
+                };
+                let Some(callee) = functions_by_name.get(call.callee.as_str()) else {
+                    continue;
+                };
+                for (callee_index, argument) in call.args.iter().enumerate() {
+                    let LlValue::Local(argument_name) = &argument.value else {
+                        continue;
+                    };
+                    if !pointer_parameter_roots(function, argument_name)
+                        .into_iter()
+                        .any(|index| large_params.contains(&(function.name.clone(), index)))
+                    {
+                        continue;
+                    }
+                    let Some((_, callee_ty)) = callee.params.get(callee_index) else {
+                        continue;
+                    };
+                    if matches!(callee_ty, LlType::Ptr(0..=2))
+                        && !large_params.contains(&(call.callee.clone(), callee_index))
+                    {
+                        additions.push((call.callee.clone(), callee_index));
+                    }
+                }
+            }
+        }
+        if additions.is_empty() {
+            break;
+        }
+        large_params.extend(additions);
+    }
+
+    let mut selected = HashSet::new();
+    for function in &parsed.functions {
+        let defs = function
+            .carrier_insts()
+            .filter_map(|inst| inst.result.as_deref().map(|result| (result, inst)))
+            .collect::<HashMap<_, _>>();
+        for inst in function.carrier_insts() {
+            if inst.opcode == "ptrtoint" {
+                let mut roots = HashSet::new();
+                inst.visit_uses(|source| roots.extend(pointer_parameter_roots(function, source)));
+                selected.extend(
+                    roots
+                        .into_iter()
+                        .filter(|index| large_params.contains(&(function.name.clone(), *index)))
+                        .filter_map(|index| function.params.get(index))
+                        .map(|(name, _)| (function.name.clone(), name.clone())),
+                );
+            }
+            let Some(gep) = inst.gep().as_deref() else {
+                continue;
+            };
+            let LlValue::Local(base) = &gep.base.value else {
+                continue;
+            };
+            let Some(result) = inst.result.as_deref() else {
+                continue;
+            };
+            let declared_wide_index = gep.indices.iter().any(|index| {
+                let Some(bits) = integer_bits(parsed, &index.ty) else {
+                    return false;
+                };
+                bits > 32 && unsigned_constant(&index.value, bits).is_none()
+            });
+            let root_ranges = pointer_root_ranges(
+                parsed,
+                function,
+                &defs,
+                &LlValue::Local(result.to_string()),
+                &mut HashSet::new(),
+            );
+            let mut wide_roots = root_ranges
+                .as_ref()
+                .into_iter()
+                .flatten()
+                .filter_map(|(root, range)| range.needs_64bit_addressing().then_some(*root))
+                .collect::<HashSet<_>>();
+            if declared_wide_index {
+                wide_roots.extend(pointer_parameter_roots(function, base));
+            }
+            if root_ranges.is_none() {
+                let local_offset =
+                    gep_byte_offset_range(parsed, &gep.source_ty, &gep.indices, |index| {
+                        integer_range(parsed, &defs, &index.ty, &index.value, &mut HashSet::new())
+                    });
+                if local_offset.is_some_and(IntRange::needs_64bit_addressing) {
+                    wide_roots.extend(pointer_parameter_roots(function, base));
+                }
+            }
+            selected.extend(
+                wide_roots
+                    .into_iter()
+                    .filter(|index| large_params.contains(&(function.name.clone(), *index)))
+                    .filter_map(|index| function.params.get(index))
+                    .map(|(name, _)| (function.name.clone(), name.clone())),
+            );
+        }
+    }
+
+    // A qualifying GEP may live in a helper. The helper parameter is then not a table root, so
+    // select the caller-side roots that reach it as well. This keeps the checked table row attached
+    // across the call (the emitter later inlines that boundary) without physicalizing unrelated
+    // direct buffers such as an argument buffer whose only GEPs use constants.
+    loop {
+        let mut additions = HashSet::new();
+        for function in &parsed.functions {
+            for inst in function.carrier_insts() {
+                let Some(call) = inst.call().as_deref() else {
+                    continue;
+                };
+                let Some(callee) = functions_by_name.get(call.callee.as_str()) else {
+                    continue;
+                };
+                for (callee_index, argument) in call.args.iter().enumerate() {
+                    let Some((callee_param, _)) = callee.params.get(callee_index) else {
+                        continue;
+                    };
+                    if !selected.contains(&(call.callee.clone(), callee_param.clone())) {
+                        continue;
+                    }
+                    let LlValue::Local(argument_name) = &argument.value else {
+                        continue;
+                    };
+                    additions.extend(
+                        pointer_parameter_roots(function, argument_name)
+                            .into_iter()
+                            .filter_map(|index| function.params.get(index))
+                            .map(|(name, _)| (function.name.clone(), name.clone())),
+                    );
+                }
+            }
+        }
+        let previous_len = selected.len();
+        selected.extend(additions);
+        if selected.len() == previous_len {
+            break;
+        }
+    }
+    selected
+}
+
+pub(super) fn requires_large_buffer_addressing(parsed: &LlModule) -> bool {
+    !large_buffer_addressing_roots(parsed).is_empty()
+}
