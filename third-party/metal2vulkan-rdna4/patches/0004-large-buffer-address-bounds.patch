+    fn resolve_forward_table_bounds(
+        &mut self,
+        value: &LlValue,
+        active: &mut HashSet<String>,
+        instructions: &mut Vec<Instruction>,
+    ) -> Result<ForwardTableBounds, String> {
+        let LlValue::Local(name) = value else {
+            return Ok(ForwardTableBounds::Unchecked);
+        };
+        if !active.insert(name.clone()) {
+            return Ok(ForwardTableBounds::Recursive);
+        }
+        let result = self.resolve_forward_local_table_bounds(name, active, instructions);
+        active.remove(name);
+        result
+    }
