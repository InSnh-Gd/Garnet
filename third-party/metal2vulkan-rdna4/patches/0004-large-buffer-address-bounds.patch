+    pub(in crate::native::emitter) fn emit_phi_raw_table_bounds(
+        &mut self,
+        name: &str,
+        incoming: &[(LlValue, String)],
+        instructions: &mut Vec<Instruction>,
+    ) -> Result<Option<RawBufferBounds>, String> {
