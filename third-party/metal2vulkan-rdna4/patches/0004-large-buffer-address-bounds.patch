+                    Op::CompositeExtract,
+                    Some(elem_type),
+                    Some(elem_value),
+                    vec![Operand::IdRef(value), Operand::LiteralBit32(index as u32)],
+                ));
+                self.emit_under_aligned_bda_value_store(
+                    &elem,
+                    elem_value,
+                    elem_address,
+                    instructions,
+                )?;
+            }
+            return Ok(());
+        }
+        let bits = Self::under_aligned_bda_bit_width(&ty).ok_or_else(|| {
+            format!("native emitter: under-aligned physical store of {ty:?} is not byte-lowerable")
