+#[test]
+fn large_buffer_roots_include_constant_data_but_not_the_argument_buffer() {
+    let ll = r#"
+target datalayout = "e-p:64:64:64-i1:8:8-i8:8:8-i16:16:16-i32:32:32-i64:64:64-f32:32:32-f64:64:64"
+
+%Args = type { [1 x ptr addrspace(1)] }
+
+define void @k(ptr addrspace(2) %data, ptr addrspace(2) %args, ptr addrspace(1) %out, i32 %index) {
+entry:
+  %datum = getelementptr inbounds i32, ptr addrspace(2) %data, i32 %index
+  %value = load i32, ptr addrspace(2) %datum, align 4
+  %slot = getelementptr inbounds %Args, ptr addrspace(2) %args, i64 0, i32 0, i32 %index
+  %pointer = load ptr addrspace(1), ptr addrspace(2) %slot, align 8
+  store i32 %value, ptr addrspace(1) %pointer, align 4
+  store i32 %value, ptr addrspace(1) %out, align 4
+  ret void
+}
+
+!air.kernel = !{!0}
+!0 = !{ptr @k, !1, !2}
+!1 = !{}
+!2 = !{!3, !4, !5}
+!3 = !{i32 0, !"air.buffer", !"air.location_index", i32 0, i32 1, !"air.read", !"air.address_space", i32 2, !"air.arg_type_name", !"uint", !"air.arg_name", !"data"}
+!4 = !{i32 1, !"air.indirect_buffer", !"air.location_index", i32 1, i32 1, !"air.read", !"air.address_space", i32 2, !"air.struct_type_info", !6, !"air.arg_type_name", !"Args", !"air.arg_name", !"args"}
+!5 = !{i32 2, !"air.buffer", !"air.location_index", i32 2, i32 1, !"air.write", !"air.address_space", i32 1, !"air.arg_type_name", !"uint", !"air.arg_name", !"out"}
+!6 = !{i32 0, i32 8, i32 0, !"ptr addrspace(1)", !"buffers", !"air.indirect_argument", !7}
+!7 = !{i32 0, !"air.buffer", !"air.location_index", i32 0, i32 1, !"air.read", !"air.address_space", i32 1, !"air.arg_type_name", !"uint"}
+"#;
+    let kern = meta::parse_air_kernel_meta(ll).expect("parse kernel metadata");
+    assert_eq!(kern.argument_buffer_params, vec![1]);
+    let parsed = crate::native::ir::LlModule::parse_with_stage_meta(ll, Some(&kern), Some("k"))
+        .expect("parse module with metadata");
+    let roots = crate::native::emit_tiers::large_buffer_addressing_roots(&parsed);
+    assert!(roots.contains(&("k".into(), "%data".into())), "{roots:?}");
+    assert!(!roots.contains(&("k".into(), "%args".into())), "{roots:?}");
+}
