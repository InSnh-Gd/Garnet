+
+fn assert_physical_memory_bytes(module: &Module, load_bytes: u64, store_bytes: u64, checked: bool) {
+    let definitions = module
+        .all_inst_iter()
+        .filter_map(|inst| Some((inst.result_id?, inst)))
+        .collect::<HashMap<_, _>>();
+    fn value_bytes(module: &Module, ty: Word) -> u64 {
+        let def = module
+            .types_global_values
+            .iter()
+            .find(|inst| inst.result_id == Some(ty))
+            .unwrap();
+        match (def.class.opcode, def.operands.as_slice()) {
+            (Op::TypeInt | Op::TypeFloat, [Operand::LiteralBit32(bits), ..]) => {
+                u64::from(*bits).div_ceil(8)
+            }
+            (Op::TypeVector, [Operand::IdRef(elem), Operand::LiteralBit32(lanes)]) => {
+                value_bytes(module, *elem) * u64::from(*lanes)
+            }
+            _ => panic!("unexpected memory value type: {def:?}"),
+        }
+    }
+    for (opcode, expected) in [(Op::Load, load_bytes), (Op::Store, store_bytes)] {
+        let accesses = physical_memory_operations(module, opcode);
+        let bytes: u64 = accesses
+            .iter()
+            .map(|inst| {
+                let ty = match opcode {
+                    Op::Load => inst.result_type.unwrap(),
+                    _ => definitions[&inst.operands.get(1).and_then(id_ref_operand).unwrap()]
+                        .result_type
+                        .unwrap(),
+                };
+                value_bytes(module, ty)
+            })
+            .sum();
+        assert_eq!(bytes, expected, "{opcode:?}: {accesses:?}");
+        if !checked {
+            continue;
+        }
+        for access in accesses {
+            let block = module
+                .functions
+                .iter()
+                .flat_map(|function| &function.blocks)
+                .find(|block| {
+                    block
+                        .instructions
+                        .iter()
+                        .any(|inst| std::ptr::eq(inst, access))
+                })
+                .unwrap();
+            let label = block
+                .label
+                .as_ref()
+                .and_then(|inst| inst.result_id)
+                .unwrap();
+            let guards = module
+                .all_inst_iter()
+                .filter_map(|inst| match (inst.class.opcode, inst.operands.as_slice()) {
+                    (
+                        Op::BranchConditional,
+                        [Operand::IdRef(condition), Operand::IdRef(target), ..],
+                    ) if *target == label => Some(*condition),
+                    _ => None,
+                })
+                .collect::<Vec<_>>();
+            assert!(!guards.is_empty(), "unguarded physical access: {access:?}");
+            let mut pending = guards;
+            let mut seen = HashSet::new();
+            let mut opcodes = HashSet::new();
+            while let Some(id) = pending.pop() {
+                if !seen.insert(id) {
+                    continue;
+                }
+                if let Some(inst) = definitions.get(&id) {
+                    opcodes.insert(inst.class.opcode);
+                    pending.extend(inst.operands.iter().filter_map(id_ref_operand));
+                }
+            }
+            for required in [
+                Op::UGreaterThanEqual,
+                Op::ULessThanEqual,
+                Op::BitwiseAnd,
+                Op::IEqual,
+            ] {
+                assert!(
+                    opcodes.contains(&required),
+                    "physical access lost {required:?}: {access:?}"
+                );
+            }
+        }
+    }
+}
