+    assert_eq!(
+        e.raw_type_size_align(&LlType::Array(Box::new(vec3_i32), 2))
+            .expect("array allocation layout"),
+        (32, 16)
+    );
+    assert_eq!(
+        e.raw_memory_store_size(&LlType::Array(Box::new(vec(LlType::Int(32), 3)), 2))
+            .expect("array memory operation size"),
+        32
+    );
+}
