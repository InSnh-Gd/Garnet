+    fn resolve_forward_local_table_bounds(
+        &mut self,
+        name: &str,
+        active: &mut HashSet<String>,
+        instructions: &mut Vec<Instruction>,
+    ) -> Result<ForwardTableBounds, String> {
+        if let Some(bounds) = self
+            .raw_offsets
+            .get(name)
+            .and_then(|raw| raw.table_bounds.clone())
+        {
+            return Ok(ForwardTableBounds::Checked(bounds));
+        }
+        if let Some(bounds) = self.bda_integer_bounds.get(name).cloned() {
+            return Ok(ForwardTableBounds::Checked(bounds));
+        }
+        if let Some(gep) = self.forward_geps.get(name).cloned() {
+            return self.resolve_forward_table_bounds(&gep.base.value, active, instructions);
+        }
+        if let Some(source) = self.bda_forward_sources.get(name).cloned() {
+            return self.resolve_forward_table_bounds(&source.value, active, instructions);
+        }
+        if let Some(source) = self.bda_inttoptr_sources.get(name).cloned() {
+            return self.resolve_forward_table_bounds(&source.value, active, instructions);
+        }
+        if let Some((op, lhs, rhs)) = self.bda_integer_arithmetic.get(name).cloned() {
+            let lhs = self.resolve_forward_table_bounds(&lhs.value, active, instructions)?;
+            let rhs = self.resolve_forward_table_bounds(&rhs.value, active, instructions)?;
+            return match (lhs, rhs) {
+                (bounds, ForwardTableBounds::Unchecked) => Ok(bounds),
+                (ForwardTableBounds::Unchecked, bounds) if op == Op::IAdd => Ok(bounds),
+                (ForwardTableBounds::Recursive, _) | (_, ForwardTableBounds::Recursive) => {
+                    Ok(ForwardTableBounds::Recursive)
+                }
+                _ => Err(format!(
+                    "native emitter: checked buffer address arithmetic {name} has no single base"
+                )),
+            };
+        }
+        if let (Some((true_value, false_value)), Some(condition)) = (
+            self.forward_pointer_selects.get(name).cloned(),
+            self.forward_pointer_select_conditions.get(name).cloned(),
+        ) {
+            let true_bounds =
+                self.resolve_forward_table_bounds(&true_value.value, active, instructions)?;
+            let false_bounds =
+                self.resolve_forward_table_bounds(&false_value.value, active, instructions)?;
+            if matches!(true_bounds, ForwardTableBounds::Recursive)
+                || matches!(false_bounds, ForwardTableBounds::Recursive)
+            {
+                // Both arms can still be inside the same loop-carried table row. The enclosing phi
+                // resolves that row from its concrete entry arm; inventing a gate here would be
+                // premature, because neither arm has a bound value yet.
+                return Ok(ForwardTableBounds::Recursive);
+            }
+            let (true_bounds, false_bounds) = match (true_bounds, false_bounds) {
+                (
+                    ForwardTableBounds::Checked(true_bounds),
+                    ForwardTableBounds::Checked(false_bounds),
+                ) if true_bounds == false_bounds => {
+                    return Ok(ForwardTableBounds::Checked(true_bounds));
+                }
+                (ForwardTableBounds::Checked(bounds), ForwardTableBounds::Unchecked) => {
+                    (Some(bounds), None)
+                }
+                (ForwardTableBounds::Unchecked, ForwardTableBounds::Checked(bounds)) => {
+                    (None, Some(bounds))
+                }
+                (
+                    ForwardTableBounds::Checked(true_bounds),
+                    ForwardTableBounds::Checked(false_bounds),
+                ) => (Some(true_bounds), Some(false_bounds)),
+                (ForwardTableBounds::Unchecked, ForwardTableBounds::Unchecked) => {
+                    return Ok(ForwardTableBounds::Unchecked)
+                }
+                (ForwardTableBounds::Recursive, _) | (_, ForwardTableBounds::Recursive) => {
+                    unreachable!()
+                }
+            };
+            let condition = self.value_id_in(&condition.value, &condition.ty, instructions)?;
+            let bounds = self.emit_selected_raw_table_bounds(
+                true_bounds.as_ref(),
+                false_bounds.as_ref(),
+                condition,
+                instructions,
+            )?;
+            return Ok(match bounds {
+                Some(bounds) => ForwardTableBounds::Checked(bounds),
+                None => ForwardTableBounds::Unchecked,
+            });
+        }
+        if let Some(incoming) = self.tir_phi_incomings.get(name).cloned() {
+            let mut resolutions = Vec::with_capacity(incoming.len());
+            for (value, _) in &incoming {
+                resolutions.push(self.resolve_forward_table_bounds(value, active, instructions)?);
+            }
+            let has_recursive = resolutions
+                .iter()
+                .any(|bounds| matches!(bounds, ForwardTableBounds::Recursive));
+            let has_unchecked = resolutions
+                .iter()
+                .any(|bounds| matches!(bounds, ForwardTableBounds::Unchecked));
+            let mut checked = resolutions.iter().filter_map(|bounds| match bounds {
+                ForwardTableBounds::Checked(bounds) => Some(bounds.clone()),
+                ForwardTableBounds::Unchecked | ForwardTableBounds::Recursive => None,
+            });
+            let fallback = checked.next();
+            let ambiguous = checked.any(|bounds| Some(&bounds) != fallback.as_ref());
+            if fallback.is_none() {
+                return Ok(if has_recursive {
+                    ForwardTableBounds::Recursive
+                } else {
+                    ForwardTableBounds::Unchecked
+                });
+            }
+            if ambiguous || (has_recursive && has_unchecked) {
+                return Err(format!(
+                    "native emitter: forward pointer phi {name} has ambiguous checked bounds \
+                     provenance"
