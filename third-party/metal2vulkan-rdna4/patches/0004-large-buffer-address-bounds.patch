+            }
+            if fallback.is_some() && has_unchecked {
+                return Err(format!(
+                    "native emitter: forward pointer phi {name} mixes checked and unchecked \
+                     bounds provenance without an explicit gate"
+                ));
+            }
+            if let Some(fallback) = fallback {
+                return Ok(ForwardTableBounds::Checked(fallback));
+            }
+            if has_recursive {
+                return Ok(ForwardTableBounds::Recursive);
+            }
+            return Ok(ForwardTableBounds::Unchecked);
+        }
+        if self.raw_offsets.contains_key(name) {
+            return Ok(ForwardTableBounds::Unchecked);
+        }
+        Ok(ForwardTableBounds::Unchecked)
+    }
