+        }
+        Ok(())
+    }
+
+    fn emit_under_aligned_bda_load(
+        &mut self,
+        result: Word,
+        ty: &LlType,
+        address: Word,
+        guard: Option<Word>,
+        instructions: &mut Vec<Instruction>,
+    ) -> Result<(), String> {
+        let Some(guard) = guard else {
+            return self.emit_under_aligned_bda_value_load(result, ty, address, instructions);
+        };
+        let access_label = self.fresh();
+        let zero_label = self.fresh();
+        let merge_label = self.fresh();
+        let zero = self.zero_bda_value(ty, instructions)?;
+        let loaded = self.fresh();
+        let result_ty = self.type_id(ty)?;
+
+        instructions.push(Self::inst(
+            Op::SelectionMerge,
+            None,
+            None,
+            vec![
+                Operand::IdRef(merge_label),
+                Operand::SelectionControl(SelectionControl::NONE),
+            ],
+        ));
+        instructions.push(Self::inst(
+            Op::BranchConditional,
+            None,
+            None,
+            vec![
+                Operand::IdRef(guard),
+                Operand::IdRef(access_label),
+                Operand::IdRef(zero_label),
+            ],
+        ));
+        instructions.push(Self::inst(Op::Label, None, Some(access_label), vec![]));
+        self.emit_under_aligned_bda_value_load(loaded, ty, address, instructions)?;
+        instructions.push(Self::inst(
+            Op::Branch,
+            None,
+            None,
+            vec![Operand::IdRef(merge_label)],
+        ));
+        instructions.push(Self::inst(Op::Label, None, Some(zero_label), vec![]));
+        instructions.push(Self::inst(
+            Op::Branch,
+            None,
+            None,
+            vec![Operand::IdRef(merge_label)],
+        ));
+        instructions.push(Self::inst(Op::Label, None, Some(merge_label), vec![]));
+        instructions.push(Self::inst(
+            Op::Phi,
+            Some(result_ty),
+            Some(result),
+            vec![
+                Operand::IdRef(zero),
+                Operand::IdRef(zero_label),
+                Operand::IdRef(loaded),
+                Operand::IdRef(access_label),
+            ],
+        ));
+        Ok(())
+    }
+
+    fn emit_under_aligned_bda_store(
+        &mut self,
+        ty: &LlType,
+        value: Word,
+        address: Word,
+        guard: Option<Word>,
+        instructions: &mut Vec<Instruction>,
+    ) -> Result<(), String> {
+        let Some(guard) = guard else {
+            return self.emit_under_aligned_bda_value_store(ty, value, address, instructions);
+        };
+        let store_label = self.fresh();
+        let merge_label = self.fresh();
+        instructions.push(Self::inst(
+            Op::SelectionMerge,
+            None,
+            None,
+            vec![
+                Operand::IdRef(merge_label),
+                Operand::SelectionControl(SelectionControl::NONE),
+            ],
+        ));
+        instructions.push(Self::inst(
+            Op::BranchConditional,
+            None,
+            None,
+            vec![
+                Operand::IdRef(guard),
+                Operand::IdRef(store_label),
+                Operand::IdRef(merge_label),
+            ],
+        ));
+        instructions.push(Self::inst(Op::Label, None, Some(store_label), vec![]));
+        self.emit_under_aligned_bda_value_store(ty, value, address, instructions)?;
+        instructions.push(Self::inst(
+            Op::Branch,
+            None,
+            None,
+            vec![Operand::IdRef(merge_label)],
+        ));
+        instructions.push(Self::inst(Op::Label, None, Some(merge_label), vec![]));
+        Ok(())
+    }
