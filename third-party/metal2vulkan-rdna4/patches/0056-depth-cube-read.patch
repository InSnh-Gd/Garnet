diff --git a/tests/depth_cube_read.rs b/tests/depth_cube_read.rs
new file mode 100644
--- /dev/null
+++ b/tests/depth_cube_read.rs
@@ -0,0 +1,59 @@
+use metal2vulkan::{disassemble, passes::Stage};
+
+fn source(arrayed: bool) -> String {
+    let dim = if arrayed { "cube_array" } else { "cube" };
+    let slice = if arrayed { "i32 %slice, " } else { "" };
+    let slice_type = if arrayed { "i32, " } else { "" };
+    format!(
+        r#"target triple = "air64-apple-macosx"
+define void @entry(ptr addrspace(1) %image, ptr addrspace(2) %sampler, ptr addrspace(1) %out, i32 %index) {{
+entry:
+  %face = urem i32 %index, 6
+  %slice = and i32 %index, 1
+  %read = call {{ float, i8 }} @air.read_depth_{dim}.f32(ptr addrspace(1) %image, ptr addrspace(2) %sampler, i32 1, <2 x i32> <i32 2, i32 1>, i32 %face, {slice}i32 1, i32 0)
+  %depth = extractvalue {{ float, i8 }} %read, 0
+  store float %depth, ptr addrspace(1) %out, align 4
+  %sample = call {{ float, i8 }} @air.sample_depth_{dim}.f32(ptr addrspace(1) %image, ptr addrspace(2) %sampler, i32 1, <3 x float> <float 0.25, float 1.0, float -0.25>, {slice}i1 true, float 0.0, float 0.0, i32 0)
+  %sampled = extractvalue {{ float, i8 }} %sample, 0
+  %next = getelementptr float, ptr addrspace(1) %out, i64 1
+  store float %sampled, ptr addrspace(1) %next, align 4
+  ret void
+}}
+declare {{ float, i8 }} @air.read_depth_{dim}.f32(ptr addrspace(1), ptr addrspace(2), i32, <2 x i32>, i32, {slice_type}i32, i32)
+declare {{ float, i8 }} @air.sample_depth_{dim}.f32(ptr addrspace(1), ptr addrspace(2), i32, <3 x float>, {slice_type}i1, float, float, i32)
+!air.kernel = !{{!0}}
+!0 = !{{ptr @entry, !1, !2}}
+!1 = !{{}}
+!2 = !{{!3, !4, !5, !6}}
+!3 = !{{i32 0, !"air.texture", !"air.location_index", i32 0, i32 1, !"air.sample", !"air.arg_type_name", !"depth{dim}<float, sample>"}}
+!4 = !{{i32 1, !"air.sampler", !"air.location_index", i32 0, i32 1}}
+!5 = !{{i32 2, !"air.buffer", !"air.location_index", i32 0, i32 1, !"air.write", !"air.address_space", i32 1, !"air.arg_type_name", !"float*"}}
+!6 = !{{i32 3, !"air.thread_position_in_grid", !"air.arg_type_name", !"uint"}}
+"#
+    )
+}
+
+#[test]
+fn sampled_depth_cube_read_uses_the_shared_face_slice_and_named_mip_path() {
+    for arrayed in [false, true] {
+        let directory =
+            std::env::temp_dir().join(format!("depth-cube-read-{}-{arrayed}", std::process::id()));
+        std::fs::create_dir_all(&directory).unwrap();
+        let bytes =
+            metal2vulkan::translate_sanitized_native(&source(arrayed), Stage::Kernel, &directory)
+                .unwrap();
+        let text = disassemble(&bytes).unwrap();
+        assert!(!text.contains("OpImageFetch"), "{text}");
+        assert!(
+            text.matches("OpImageSampleExplicitLod").count() >= 2,
+            "{text}"
+        );
+        assert!(text.contains("OpImageQuerySizeLod"), "{text}");
+        assert!(
+            text.contains("OpIEqual") && text.contains("OpSelect"),
+            "{text}"
+        );
+        metal2vulkan::tools::spirv_val_bytes(&bytes, &directory).unwrap();
+        std::fs::remove_dir_all(directory).unwrap();
+    }
+}
