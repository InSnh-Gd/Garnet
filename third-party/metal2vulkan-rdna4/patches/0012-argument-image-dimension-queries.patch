+fn image_query(name: &str) -> Option<(u32, bool)> {
+    for (prefix, field, mip) in [
+        ("air.get_width_", 0, true),
+        ("air.get_height_", 1, true),
+        ("air.get_depth_", 2, true),
+        ("air.get_array_size_", 3, false),
+        ("air.get_num_mip_levels_", 4, false),
+        ("air.get_num_samples_", 5, false),
+    ] {
+        if name.starts_with(prefix) && (name.contains("_texture_") || name.contains("_depth_")) {
+            return Some((field, mip));
+        }
+    }
+    None
+}
