+            crate::passes::Stage::Fragment,
+            Some(&meta),
+            None,
+            None,
+            Some("myFragment"),
+            &options,
+        )
+        .unwrap()
+    };
+
+    let legacy = build(crate::passes::TransformOptions::default());
+    assert_eq!(legacy.reflection_version, REFLECTION_VERSION);
+    assert!(!legacy.normalized_sampler_coordinates);
+
+    let normalized =
+        build(crate::passes::TransformOptions::default().with_normalized_sampler_coordinates());
+    assert_eq!(normalized.reflection_version, REFLECTION_VERSION);
+    assert!(normalized.normalized_sampler_coordinates);
 }
 
