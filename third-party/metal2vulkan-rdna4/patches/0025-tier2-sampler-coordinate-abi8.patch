+//! ABI 8 runtime sampler-coordinate selection.
+
+use super::*;
+use std::collections::HashMap;
+
+#[derive(Clone, Copy)]
+struct DescriptorVariable {
+    set: u32,
+    binding: u32,
+}
+
+fn descriptor_variables(
+    ctx: &Ctx,
+    defs: &HashMap<Word, Instruction>,
+) -> HashMap<Word, DescriptorVariable> {
+    let mut sets = HashMap::new();
+    let mut bindings = HashMap::new();
+    for annotation in &ctx.module.annotations {
+        match annotation.operands.as_slice() {
+            [Operand::IdRef(id), Operand::Decoration(spirv::Decoration::DescriptorSet), Operand::LiteralBit32(set)] =>
+            {
+                sets.insert(*id, *set);
+            }
+            [Operand::IdRef(id), Operand::Decoration(spirv::Decoration::Binding), Operand::LiteralBit32(binding)] =>
+            {
+                bindings.insert(*id, *binding);
+            }
+            _ => {}
+        }
+    }
+    defs.iter()
+        .filter_map(|(id, instruction)| {
+            if instruction.class.opcode != Op::Variable {
+                return None;
+            }
+            Some((
+                *id,
+                DescriptorVariable {
+                    set: *sets.get(id)?,
+                    binding: *bindings.get(id)?,
+                },
+            ))
+        })
+        .collect()
+}
+
+fn definitions(ctx: &Ctx) -> HashMap<Word, Instruction> {
+    ctx.module
+        .all_inst_iter()
+        .chain(ctx.new_globals.iter())
+        .filter_map(|instruction| instruction.result_id.map(|id| (id, instruction.clone())))
+        .collect()
+}
+
+fn sampler_load(ctx: &Ctx, samp: Word) -> Option<(Word, Option<Word>)> {
+    let defs = definitions(ctx);
+    let mut value = samp;
+    for _ in 0..32 {
+        let instruction = defs.get(&value)?;
+        match instruction.class.opcode {
+            Op::Load => {
+                let mut pointer = match instruction.operands.first()? {
+                    Operand::IdRef(pointer) => *pointer,
+                    _ => return None,
+                };
+                let mut index = None;
+                for _ in 0..32 {
+                    let instruction = defs.get(&pointer)?;
+                    match instruction.class.opcode {
+                        Op::Variable => return Some((pointer, index)),
+                        Op::AccessChain | Op::InBoundsAccessChain => {
+                            if index.is_none() {
+                                index =
+                                    instruction
+                                        .operands
+                                        .get(1)
+                                        .and_then(|operand| match operand {
+                                            Operand::IdRef(index) => Some(*index),
+                                            _ => None,
+                                        });
+                            }
+                            pointer = match instruction.operands.first()? {
+                                Operand::IdRef(base) => *base,
+                                _ => return None,
+                            };
+                        }
+                        Op::CopyObject | Op::Bitcast => {
+                            pointer = match instruction.operands.first()? {
+                                Operand::IdRef(base) => *base,
+                                _ => return None,
+                            };
+                        }
+                        _ => return None,
+                    }
+                }
+                return None;
+            }
+            Op::CopyObject | Op::Bitcast => {
+                value = match instruction.operands.first()? {
+                    Operand::IdRef(source) => *source,
+                    _ => return None,
+                };
+            }
+            _ => return None,
+        }
+    }
+    None
+}
+
+fn boolean_from_flag_word(ctx: &mut Ctx, word: Word, out: &mut Vec<Instruction>) -> Word {
+    let one = ctx.const_uint(1);
+    let masked = ctx.module.fresh_id();
+    out.push(Instruction::new(
+        Op::BitwiseAnd,
+        Some(ctx.ty_uint()),
+        Some(masked),
+        vec![Operand::IdRef(word), Operand::IdRef(one)],
+    ));
+    let zero = ctx.const_uint(0);
+    let pixel = ctx.module.fresh_id();
+    out.push(Instruction::new(
+        Op::INotEqual,
+        Some(ctx.ty_bool()),
+        Some(pixel),
+        vec![Operand::IdRef(masked), Operand::IdRef(zero)],
+    ));
+    pixel
+}
+
+fn load_word(ctx: &mut Ctx, buffer: Word, index: Word, out: &mut Vec<Instruction>) -> Word {
+    let uint = ctx.ty_uint();
+    let pointer_ty = ctx.ty_ptr(StorageClass::StorageBuffer, uint);
+    let zero = ctx.const_uint(0);
+    let pointer = ctx.module.fresh_id();
+    out.push(Instruction::new(
+        Op::AccessChain,
+        Some(pointer_ty),
+        Some(pointer),
+        vec![
+            Operand::IdRef(buffer),
+            Operand::IdRef(zero),
+            Operand::IdRef(index),
+        ],
+    ));
+    let word = ctx.module.fresh_id();
+    out.push(Instruction::new(
+        Op::Load,
+        Some(uint),
+        Some(word),
+        vec![Operand::IdRef(pointer)],
+    ));
+    word
+}
+
+impl Ctx {
+    fn sampler_coordinate_flags_var(&mut self) -> Word {
+        if let Some(var) = self.sampler_coordinate_flags_var {
+            return var;
+        }
+        let uint = self.ty_uint();
+        let array = self.ty_runtime_array(uint);
+        let stride = vec![
+            Operand::IdRef(array),
+            Operand::Decoration(spirv::Decoration::ArrayStride),
+            Operand::LiteralBit32(4),
+        ];
+        if !self.module.annotations.iter().any(|instruction| {
+            instruction.class.opcode == Op::Decorate && instruction.operands == stride
+        }) {
+            self.module
+                .annotations
+                .push(Instruction::new(Op::Decorate, None, None, stride));
+        }
+        let structure = self.module.fresh_id();
+        self.new_globals.push(Instruction::new(
+            Op::TypeStruct,
+            None,
+            Some(structure),
+            vec![Operand::IdRef(array)],
+        ));
+        self.module.annotations.push(Instruction::new(
+            Op::Decorate,
+            None,
+            None,
+            vec![
+                Operand::IdRef(structure),
+                Operand::Decoration(Decoration::Block),
+            ],
+        ));
+        self.module.annotations.push(Instruction::new(
+            Op::MemberDecorate,
+            None,
+            None,
+            vec![
+                Operand::IdRef(structure),
+                Operand::LiteralBit32(0),
+                Operand::Decoration(Decoration::Offset),
+                Operand::LiteralBit32(0),
+            ],
+        ));
+        let pointer = self.ty_ptr(StorageClass::StorageBuffer, structure);
+        let var = self.module.fresh_id();
+        self.new_globals.push(Instruction::new(
+            Op::Variable,
+            Some(pointer),
+            Some(var),
+            vec![Operand::StorageClass(StorageClass::StorageBuffer)],
+        ));
+        decorate_binding(
+            &mut self.module,
+            var,
+            self.descriptor_layout.set,
+            crate::reflect::SAMPLER_COORDINATE_FLAGS_BINDING,
+        );
+        self.module.annotations.push(Instruction::new(
+            Op::Decorate,
+            None,
+            None,
+            vec![
+                Operand::IdRef(var),
+                Operand::Decoration(Decoration::NonWritable),
+            ],
+        ));
+        self.interface_buffer_var(var);
+        self.sampler_coordinate_flags_var = Some(var);
+        var
+    }
+}
+
+fn runtime_word_flag(ctx: &mut Ctx, index: Word, out: &mut Vec<Instruction>) -> Word {
+    let buffer = ctx.sampler_coordinate_flags_var();
+    let word = load_word(ctx, buffer, index, out);
+    boolean_from_flag_word(ctx, word, out)
+}
+
+fn gpu_table_flag(
+    ctx: &mut Ctx,
+    table: Word,
+    token_index: Word,
+    out: &mut Vec<Instruction>,
+) -> Result<Word, String> {
+    let word = crate::passes::resources::table_sampler_flag_word(ctx, out, table, token_index);
+    Ok(boolean_from_flag_word(ctx, word, out))
+}
+
+fn sampler_coordinate_source(
+    ctx: &mut Ctx,
+    samp: Word,
+    out: &mut Vec<Instruction>,
+) -> Result<SamplerCoordinateSource, String> {
+    if let Some(source) = ctx.sampler_coordinate_sources.get(&samp).copied() {
+        return Ok(source);
+    }
+    if let Some(state) = ctx.sampler_states.get(&samp).copied() {
+        return Ok(if state.uses_pixel_coordinates() {
+            SamplerCoordinateSource::Pixel
+        } else {
+            SamplerCoordinateSource::Normalized
+        });
+    }
+    let defs = definitions(ctx);
+    let variables = descriptor_variables(ctx, &defs);
+    if let Some((variable, token_index)) = sampler_load(ctx, samp) {
+        if let Some(descriptor) = variables.get(&variable) {
+            if descriptor.set == 4 && descriptor.binding == 0 {
+                let table = variables
+                    .iter()
+                    .find_map(|(id, candidate)| {
+                        (candidate.set == 0 && candidate.binding == ARGUMENT_RESOURCE_TABLE_BINDING)
+                            .then_some(*id)
+                    })
+                    .ok_or("GPU sampler has no argument resource table")?;
+                let token_index = token_index.ok_or("GPU sampler array load has no token index")?;
+                return Ok(SamplerCoordinateSource::RuntimeFlag(gpu_table_flag(
+                    ctx,
+                    table,
+                    token_index,
+                    out,
+                )?));
+            }
+            let ordinary =
+                if crate::reflect::COMPARISON_SAMPLER_BINDING_RANGE.contains(descriptor.binding) {
+                    descriptor
+                        .binding
+                        .checked_sub(crate::reflect::COMPARISON_SAMPLER_BINDING_OFFSET)
+                } else {
+                    Some(descriptor.binding)
+                };
+            if let Some(word) = ordinary
+                .filter(|binding| crate::reflect::SAMPLER_BINDING_RANGE.contains(*binding))
+                .map(|binding| binding - crate::reflect::SAMPLER_BINDING_BASE)
+            {
+                return Ok(SamplerCoordinateSource::RuntimeWord(word));
+            }
+        }
+    }
+    Err("normalized sampler sampling has no recoverable coordinate source".into())
+}
+
+fn coordinate_type(ctx: &Ctx, coord: Word, out: &[Instruction]) -> Result<Word, String> {
+    out.iter()
+        .rev()
+        .find(|instruction| instruction.result_id == Some(coord))
+        .and_then(|instruction| instruction.result_type)
+        .or_else(|| value_result_type(ctx, coord))
+        .ok_or_else(|| "sampler coordinate has no type".to_string())
+}
+
+fn pixel_to_normalized(
+    ctx: &mut Ctx,
+    img: Word,
+    dim: Dim,
+    arrayed: bool,
+    coord: Word,
+    lod: Word,
+    out: &mut Vec<Instruction>,
+) -> Result<Word, String> {
+    let (spatial, coord_lanes) = match dim {
+        Dim::Dim1D => (1usize, 1u32),
+        Dim::Dim2D => (2, 2),
+        Dim::Dim3D => (3, 3),
+        Dim::DimCube => (2, 3),
+        _ => {
+            return Err(format!(
+                "pixel coordinates are unsupported for image dimension {dim:?}"
+            ))
+        }
+    };
+    let coord_ty = coordinate_type(ctx, coord, out)?;
+    let size = query_image_size(ctx, img, spatial, arrayed, lod, out);
+    let float_ty = ctx.ty_float();
+    let mut components = sample_coord_components(ctx, coord, coord_lanes, out)?;
+    for (axis, component) in components.iter_mut().take(spatial).enumerate() {
+        let Operand::IdRef(component_id) = *component else {
+            return Err("pixel sampler coordinate component is not an id".into());
+        };
+        let extent = image_size_component(ctx, size, axis, spatial, arrayed, out)?;
+        let extent_f = ctx.module.fresh_id();
+        out.push(Instruction::new(
+            Op::ConvertUToF,
+            Some(float_ty),
+            Some(extent_f),
+            vec![Operand::IdRef(extent)],
+        ));
+        let normalized = ctx.module.fresh_id();
+        out.push(Instruction::new(
+            Op::FDiv,
+            Some(float_ty),
+            Some(normalized),
+            vec![Operand::IdRef(component_id), Operand::IdRef(extent_f)],
+        ));
+        *component = Operand::IdRef(normalized);
+    }
+    if coord_lanes == 1 {
+        if coord_ty != float_ty {
+            return Err("scalar pixel sampler coordinate is not float".into());
+        }
+        let Operand::IdRef(component) = components[0] else {
+            unreachable!();
+        };
+        return Ok(component);
+    }
+    let normalized = ctx.module.fresh_id();
+    out.push(Instruction::new(
+        Op::CompositeConstruct,
+        Some(coord_ty),
+        Some(normalized),
+        components,
+    ));
+    Ok(normalized)
+}
