+    /// `@__m2v.rq.query.lookup_prim_data`). Loads through these pointers use a direct non-null
+    /// check instead of the user-buffer `RegistryV3` table scan.
+    pub(super) trusted_ro_bda_params: HashSet<(String, String)>,
+    /// Function-wide monotone set of `(function_name, ssa_value_name)` pointer values proven to
+    /// hold only read-only RT `primitiveDataBuffer` BDA addresses (or null/undef), independent of
+    /// block/instruction order. Queried directly by local-alloca/phi load emission so mixed
+    /// trusted+untrusted allocas never bypass `RegistryV3`.
+    pub(super) trusted_ro_bda_values: HashSet<(String, String)>,
+}
+
+fn const_gep_u32(val: &LlValue) -> Option<u32> {
+    match *val {
+        LlValue::Zero => Some(0),
+        LlValue::Int(v) => u32::try_from(v).ok(),
+        LlValue::SignedInt(v) if v >= 0 => u32::try_from(v).ok(),
+        _ => None,
+    }
+}
+
+impl LlModule {
+    pub(super) fn infer_trusted_ro_bda_params(&mut self, ll: &str) {
+        self.metadata_trusted_ro_bda_params.clear();
+        // Step 1: Seed from `!air.intersection` metadata nodes carrying `!"air.primitive_data"`.
+        let mut md_nodes = HashMap::<u32, &str>::new();
+        let mut inter_roots = Vec::<u32>::new();
+        let parse_refs = |body: &str| -> Vec<u32> {
+            body.split(',')
+                .filter_map(|part| {
+                    part.trim()
+                        .strip_prefix('!')?
+                        .trim_end_matches('}')
+                        .trim()
+                        .parse::<u32>()
+                        .ok()
+                })
+                .collect()
+        };
+        for line in ll.lines() {
+            let trimmed = line.trim();
+            if !trimmed.starts_with('!') {
+                continue;
+            }
+            let Some((lhs, rhs)) = trimmed.split_once(" = ") else {
+                continue;
+            };
+            let lhs = lhs.trim();
+            let Some(body) = rhs.trim().strip_prefix("!{").and_then(|s| s.strip_suffix('}')) else {
+                continue;
+            };
+            if let Some(id_str) = lhs.strip_prefix('!') {
+                if let Ok(id) = id_str.parse::<u32>() {
+                    md_nodes.insert(id, body);
+                    continue;
+                }
+            }
+            if lhs == "!air.intersection" {
+                inter_roots.extend(parse_refs(body));
+            }
+        }
+        for root_id in inter_roots {
+            let Some(&root_body) = md_nodes.get(&root_id) else {
+                continue;
+            };
+            let Some(at) = root_body.find('@') else {
+                continue;
+            };
+            let rest = &root_body[at + 1..];
+            let fn_name = if let Some(quoted) = rest.strip_prefix('"') {
+                let Some(end) = quoted.find('"') else {
+                    continue;
+                };
+                &quoted[..end]
+            } else {
+                let end = rest.find([' ', '\t', ',', '}']).unwrap_or(rest.len());
+                &rest[..end]
+            };
+            let Some(func) = self.functions.iter().find(|f| f.name == fn_name) else {
+                continue;
+            };
+            let refs = parse_refs(root_body);
+            let Some(&in_list_id) = refs.get(1) else {
+                continue;
+            };
+            let Some(&in_list_body) = md_nodes.get(&in_list_id) else {
+                continue;
+            };
+            for param_ref in parse_refs(in_list_body) {
+                let Some(&param_body) = md_nodes.get(&param_ref) else {
+                    continue;
+                };
+                if !param_body.contains("!\"air.primitive_data\"") {
+                    continue;
+                }
+                if let Some(idx_str) = param_body
+                    .split(',')
+                    .next()
+                    .and_then(|s| s.trim().strip_prefix("i32 "))
+                {
+                    if let Ok(idx) = idx_str.trim().parse::<usize>() {
+                        if let Some((pname, LlType::Ptr(1 | 2))) = func.params.get(idx) {
+                            self.metadata_trusted_ro_bda_params
+                                .insert((func.name.clone(), pname.clone()));
+                        }
+                    }
+                }
+            }
+        }
+        self.propagate_trusted_ro_bda();
+    }
+
+    /// Monotone, block/instruction-order-independent fixpoint over all functions to compute both
+    /// `trusted_ro_bda_params` and `trusted_ro_bda_values`. Re-run after `inline_ordinary_leaf_helpers`
+    /// so post-inline SSA names remain exact.
+    pub(super) fn propagate_trusted_ro_bda(&mut self) {
+        self.trusted_ro_bda_params = self.metadata_trusted_ro_bda_params.clone();
+        self.trusted_ro_bda_values.clear();
+
+        // Pre-scan per-function alloca field paths, escapes, and complete store sets ONCE before
+        // the monotone fixpoint so loads NEVER observe a partial store set.
+        struct FuncAllocaInfo {
+            slot_path: HashMap<String, (String, Vec<u32>)>,
+            escaped_allocas: HashSet<String>,
+            field_stores: HashMap<(String, Vec<u32>), Vec<LlValue>>,
+        }
+        let mut alloca_info: HashMap<String, FuncAllocaInfo> = HashMap::new();
+        for f in &self.functions {
+            let mut slot_path: HashMap<String, (String, Vec<u32>)> = HashMap::new();
+            let mut escaped_allocas: HashSet<String> = HashSet::new();
+            for inst in f.carrier_insts() {
+                if inst.alloca_ty().is_some() {
+                    if let Some(res) = inst.result.as_deref() {
+                        slot_path.insert(res.to_string(), (res.to_string(), Vec::new()));
+                    }
+                }
+            }
+            // Propagate transparent alloca aliases and constant zero-based field GEPs.
+            let mut alias_changed = true;
+            while alias_changed {
+                alias_changed = false;
+                for inst in f.carrier_insts() {
+                    if let Some((res, base)) = inst.identity_ptr_bitcast() {
+                        if !slot_path.contains_key(res) {
+                            if let Some(p) = slot_path.get(base).cloned() {
+                                slot_path.insert(res.to_string(), p);
+                                alias_changed = true;
+                            }
+                        }
+                    } else if let Some(gep) = inst.gep().as_deref() {
+                        if let (Some(res), LlValue::Local(base)) =
+                            (inst.result.as_deref(), &gep.base.value)
+                        {
+                            if let Some((root, path)) = slot_path.get(base).cloned() {
+                                let valid_const = gep
+                                    .indices
+                                    .first()
+                                    .is_some_and(|tv| const_gep_u32(&tv.value) == Some(0))
+                                    && gep
+                                        .indices
+                                        .iter()
+                                        .skip(1)
+                                        .all(|tv| const_gep_u32(&tv.value).is_some());
+                                if valid_const {
+                                    if !slot_path.contains_key(res) {
+                                        let mut new_path = path;
+                                        for tv in gep.indices.iter().skip(1) {
+                                            if let Some(idx) = const_gep_u32(&tv.value) {
+                                                new_path.push(idx);
+                                            }
+                                        }
+                                        slot_path.insert(res.to_string(), (root, new_path));
+                                        alias_changed = true;
+                                    }
+                                } else {
+                                    escaped_allocas.insert(root);
+                                }
+                            }
+                        }
+                    }
+                }
+            }
+            // Collect complete store sets and disqualify any alloca that escapes or receives
+            // non-pointer writes.
+            let mut field_stores: HashMap<(String, Vec<u32>), Vec<LlValue>> = HashMap::new();
+            for inst in f.carrier_insts() {
+                if let Some(store) = inst.store().as_deref() {
+                    if let LlValue::Local(val_name) = &store.0.value {
+                        if let Some((root, _)) = slot_path.get(val_name) {
+                            escaped_allocas.insert(root.clone());
+                        }
+                    }
+                    if let LlValue::Local(dst_name) = &store.1.value {
+                        if let Some(key) = slot_path.get(dst_name) {
+                            if matches!(store.0.ty, LlType::Ptr(1 | 2)) {
+                                field_stores
+                                    .entry(key.clone())
+                                    .or_default()
+                                    .push(store.0.value.clone());
+                            } else {
+                                escaped_allocas.insert(key.0.clone());
+                            }
+                        }
+                    }
+                    continue;
+                }
+                if inst.load().is_some()
+                    || inst.alloca_ty().is_some()
+                    || inst.identity_ptr_bitcast().is_some()
+                    || inst.gep().is_some()
+                {
+                    continue;
+                }
+                if let Some(call) = inst.call().as_deref() {
+                    if call.callee.starts_with("llvm.lifetime.start")
+                        || call.callee.starts_with("llvm.lifetime.end")
+                    {
+                        continue;
+                    }
+                }
+                inst.visit_uses(|used| {
+                    if let Some((root, _)) = slot_path.get(used) {
+                        escaped_allocas.insert(root.clone());
+                    }
+                });
+            }
+            for block in &f.blocks {
+                if let Some(typed) = block.typed.as_ref() {
+                    if let crate::native::tir::RetEmit::Value(tv) = &typed.ret {
+                        if let LlValue::Local(ret_name) = &tv.value {
+                            if let Some((root, _)) = slot_path.get(ret_name) {
+                                escaped_allocas.insert(root.clone());
+                            }
+                        }
+                    }
+                }
+            }
+            alloca_info.insert(
+                f.name.clone(),
+                FuncAllocaInfo {
+                    slot_path,
+                    escaped_allocas,
+                    field_stores,
+                },
+            );
+        }
+
+        // Step 2: Monotone fixpoint call-site and intra-function propagation.
+        let mut trusted_by_func: HashMap<String, HashSet<String>>;
+        loop {
+            trusted_by_func = HashMap::new();
+            for f in &self.functions {
+                let mut locals = HashSet::<String>::new();
+                for (pname, ty) in &f.params {
+                    if matches!(ty, LlType::Ptr(1 | 2))
+                        && self
+                            .trusted_ro_bda_params
+                            .contains(&(f.name.clone(), pname.clone()))
+                    {
+                        locals.insert(pname.clone());
+                    }
+                }
+                let in_prim_helper = f.name == "__m2v.rq.query.lookup_prim_data"
+                    || f.name == "__m2v.rq.query.probe_prim_slot";
+                let finfo = alloca_info.get(&f.name);
+                let mut inner_changed = true;
+                while inner_changed {
+                    inner_changed = false;
+                    for inst in f.carrier_insts() {
+                        let Some(res) = inst.result.as_deref() else {
+                            continue;
+                        };
+                        if locals.contains(res) {
+                            continue;
+                        }
+                        if inst.opcode == "inttoptr" {
+                            let is_trusted = in_prim_helper
+                                || inst.operands.iter().any(|op| match op {
+                                    crate::native::tir::TirOperand::Value { name, .. } => {
+                                        name.contains("__m2v.rq.prim_data")
+                                    }
+                                    _ => false,
+                                });
+                            if is_trusted && locals.insert(res.to_string()) {
+                                inner_changed = true;
+                            }
+                            continue;
+                        }
+                        if let Some((_, base)) = inst.identity_ptr_bitcast() {
+                            if locals.contains(base) && locals.insert(res.to_string()) {
+                                inner_changed = true;
+                            }
+                            continue;
+                        }
+                        if let Some(gep) = inst.gep().as_deref() {
+                            if let LlValue::Local(base) = &gep.base.value {
+                                if locals.contains(base) && locals.insert(res.to_string()) {
+                                    inner_changed = true;
+                                }
+                            }
+                            continue;
+                        }
+                        if inst.opcode == "freeze" {
+                            if let Some(crate::native::tir::TirOperand::Value { name, .. }) =
+                                inst.operands.first()
+                            {
+                                if locals.contains(name) && locals.insert(res.to_string()) {
+                                    inner_changed = true;
+                                }
+                            }
+                            continue;
+                        }
+                        if let Some((t_tv, f_tv)) = inst.select_arms().as_deref() {
+                            let arm_ok = |v: &LlValue| match v {
+                                LlValue::Zero | LlValue::Undef => true,
+                                LlValue::Local(n) => locals.contains(n),
+                                _ => false,
+                            };
+                            let any_local = matches!(t_tv.value, LlValue::Local(_))
+                                || matches!(f_tv.value, LlValue::Local(_));
+                            if any_local
+                                && arm_ok(&t_tv.value)
+                                && arm_ok(&f_tv.value)
+                                && locals.insert(res.to_string())
+                            {
+                                inner_changed = true;
+                            }
+                            continue;
+                        }
+                        if let Some((_, incoming)) = inst.phi_incoming() {
+                            let mut any_trusted = false;
+                            let mut all_ok = true;
+                            for (val, _) in incoming {
+                                match val {
+                                    LlValue::Zero | LlValue::Undef => {}
+                                    LlValue::Local(n) if locals.contains(n) => {
+                                        any_trusted = true;
+                                    }
+                                    _ => {
+                                        all_ok = false;
+                                        break;
+                                    }
+                                }
+                            }
+                            if any_trusted && all_ok && locals.insert(res.to_string()) {
+                                inner_changed = true;
+                            }
+                            continue;
+                        }
+                        if let Some(load) = inst.load().as_deref() {
+                            if matches!(load.result_ty, LlType::Ptr(1 | 2)) {
+                                if let (LlValue::Local(ptr_name), Some(info)) =
+                                    (&load.ptr.value, finfo)
+                                {
+                                    if let Some(key) = info.slot_path.get(ptr_name) {
+                                        if !info.escaped_allocas.contains(&key.0) {
+                                            if let Some(stores) = info.field_stores.get(key) {
+                                                let mut any_trusted = false;
+                                                let mut all_ok = !stores.is_empty();
+                                                for stored in stores {
+                                                    match stored {
+                                                        LlValue::Zero | LlValue::Undef => {}
+                                                        LlValue::Local(n) if locals.contains(n) => {
+                                                            any_trusted = true;
+                                                        }
+                                                        _ => {
+                                                            all_ok = false;
+                                                            break;
+                                                        }
+                                                    }
+                                                }
+                                                if any_trusted
+                                                    && all_ok
+                                                    && locals.insert(res.to_string())
+                                                {
+                                                    inner_changed = true;
+                                                }
+                                            }
+                                        }
+                                    }
+                                }
+                            }
+                        }
+                    }
+                }
+                trusted_by_func.insert(f.name.clone(), locals);
+            }
+
+            // Aggregate per-(callee, param_idx): (has_any_trusted_call, all_calls_ok)
+            let mut callee_param_status: HashMap<(String, usize), (bool, bool)> = HashMap::new();
+            for caller in &self.functions {
+                let caller_trusted = trusted_by_func.get(&caller.name);
+                for inst in caller.carrier_insts() {
+                    let Some(call) = inst.call().as_deref() else {
+                        continue;
+                    };
+                    for (ai, arg) in call.args.iter().enumerate() {
+                        if !matches!(arg.ty, LlType::Ptr(1 | 2)) {
+                            continue;
+                        }
+                        let (is_trusted, is_ok) = match &arg.value {
+                            LlValue::Zero | LlValue::Undef => (false, true),
+                            LlValue::Local(n)
+                                if caller_trusted.is_some_and(|s| s.contains(n)) =>
+                            {
+                                (true, true)
+                            }
+                            _ => (false, false),
+                        };
+                        let st = callee_param_status
+                            .entry((call.callee.clone(), ai))
+                            .or_insert((false, true));
+                        st.0 |= is_trusted;
+                        st.1 &= is_ok;
+                    }
+                }
+            }
+
+            let mut added = false;
+            for f in &self.functions {
+                if self.entry_functions.contains(&f.name) {
+                    continue;
+                }
+                for (pi, (pname, ty)) in f.params.iter().enumerate() {
+                    if !matches!(ty, LlType::Ptr(1 | 2)) {
+                        continue;
+                    }
+                    if let Some(&(any_trusted, all_ok)) =
+                        callee_param_status.get(&(f.name.clone(), pi))
+                    {
+                        if any_trusted
+                            && all_ok
+                            && self
+                                .trusted_ro_bda_params
+                                .insert((f.name.clone(), pname.clone()))
+                        {
+                            added = true;
+                        }
+                    }
+                }
+            }
+            if !added {
+                break;
+            }
+        }
+
+        for (func_name, locals) in trusted_by_func {
+            for local in locals {
+                self.trusted_ro_bda_values
+                    .insert((func_name.clone(), local));
+            }
+        }
+    }
 }
 
