+
+/// Lazily emit the read-only `[33 x u64]` StorageBuffer at `(descriptor_layout.set, 676)` for
+/// RT `primitiveDataBuffer` table lookup:
+/// - `words64[0]`: `global_table_bda` (u64)
+/// - `words64[1]`: `table_mask` (u64, low 32 bits = `capacity - 1`)
+/// - `words64[2 + slot]` (`slot` 0..30): `slot_as_bda[slot]` (u64)
+fn ensure_rt_prim_data_table_var(
+    ctx: &mut Ctx,
+    cache: &mut Option<(Word, Word, Word)>,
+) -> (Word, Word, Word) {
+    if let Some(cached) = *cache {
+        return cached;
+    }
+    ctx.add_capability(spirv::Capability::Int64);
+    let u64_ty = ty_u64(ctx);
+    let len_33 = ctx.const_uint(33);
+    let arr_ty = ctx.module.fresh_id();
+    ctx.new_globals.push(type_inst(
+        Op::TypeArray,
+        arr_ty,
+        vec![Operand::IdRef(u64_ty), Operand::IdRef(len_33)],
+    ));
+    ctx.module.annotations.push(Instruction::new(
+        Op::Decorate,
+        None,
+        None,
+        vec![
+            Operand::IdRef(arr_ty),
+            Operand::Decoration(Decoration::ArrayStride),
+            Operand::LiteralBit32(8),
+        ],
+    ));
+    let struct_ty = ctx.module.fresh_id();
+    ctx.new_globals
+        .push(type_inst(Op::TypeStruct, struct_ty, vec![Operand::IdRef(arr_ty)]));
+    ctx.module.annotations.push(Instruction::new(
+        Op::Decorate,
+        None,
+        None,
+        vec![
+            Operand::IdRef(struct_ty),
+            Operand::Decoration(Decoration::Block),
+        ],
+    ));
+    ctx.module.annotations.push(Instruction::new(
+        Op::MemberDecorate,
+        None,
+        None,
+        vec![
+            Operand::IdRef(struct_ty),
+            Operand::LiteralBit32(0),
+            Operand::Decoration(Decoration::Offset),
+            Operand::LiteralBit32(0),
+        ],
+    ));
+    let ptr_struct_ty = ctx.ty_ptr(StorageClass::StorageBuffer, struct_ty);
+    let var = ctx.module.fresh_id();
+    ctx.new_globals.push(Instruction::new(
+        Op::Variable,
+        Some(ptr_struct_ty),
+        Some(var),
+        vec![Operand::StorageClass(StorageClass::StorageBuffer)],
+    ));
+    decorate_binding(
+        &mut ctx.module,
+        var,
+        ctx.descriptor_layout.set,
+        crate::reflect::RT_PRIM_DATA_BINDING,
+    );
+    ctx.module.annotations.push(Instruction::new(
+        Op::Decorate,
+        None,
+        None,
+        vec![
+            Operand::IdRef(var),
+            Operand::Decoration(Decoration::NonWritable),
+        ],
+    ));
+    ctx.interface_buffer_var(var);
+    let ptr_u64_ty = ctx.ty_ptr(StorageClass::StorageBuffer, u64_ty);
+    let entry = (var, ptr_u64_ty, u64_ty);
+    *cache = Some(entry);
+    entry
+}
