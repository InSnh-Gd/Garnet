+#[test]
+fn large_buffer_spliced_helper_stores_opaque_texture_in_local_struct() {
+    let entry_template = r#"
+%"struct.RB::Layer" = type { ptr addrspace(1), [2 x <2 x float>] }
+@__air_sampler_state = internal addrspace(2) constant [2 x i64] [i64 34901797601020489, i64 0], align 8
+
+define <4 x half> @frag(<2 x float> %coord, ptr addrspace(2) noundef %globals, ptr addrspace(1) %fill_tex) {
+entry:
+  %p = getelementptr inbounds float, ptr addrspace(2) %globals, i64 2
+  %res = call <4 x half> @helper(<2 x float> %coord, ptr addrspace(2) %p, ptr addrspace(1) %fill_tex)
+  ret <4 x half> %res
+}
+
+define <4 x half> @helper(<2 x float> %p, ptr addrspace(2) %params, ptr addrspace(1) %tex) {
+entry:
+  %layer = alloca %"struct.RB::Layer", align 8
+  %tex_slot = getelementptr inbounds %"struct.RB::Layer", ptr %layer, i64 0, i32 0
+  store ptr addrspace(1) %tex, ptr %tex_slot, align 8
+  br label %loop
+
+loop:
+  %i = phi i32 [ 0, %entry ], [ %next_i, %loop ]
+  %idx = zext i32 %i to i64
+  %src = getelementptr inbounds float, ptr addrspace(2) %params, i64 %idx
+  %val = load float, ptr addrspace(2) %src, align 4
+  %uv = insertelement <2 x float> poison, float %val, i64 0
+  %uv2 = shufflevector <2 x float> %uv, <2 x float> poison, <2 x i32> zeroinitializer
+  %dst = getelementptr inbounds %"struct.RB::Layer", ptr %layer, i64 0, i32 1, i64 %idx
+  store <2 x float> %uv2, ptr %dst, align 8
+  %next_i = add nuw nsw i32 %i, 1
+  %done = icmp eq i32 %next_i, 2
+  br i1 %done, label %exit, label %loop
+
+exit:
+  %uv_load_ptr = getelementptr inbounds %"struct.RB::Layer", ptr %layer, i64 0, i32 1, i64 0
+  %uv_final = load <2 x float>, ptr %uv_load_ptr, align 8
+  %sample_tex = __SAMPLE_TEX_EXPR__
+  %sampled = call { <4 x half>, i8 } @air.sample_texture_2d.v4f16(ptr addrspace(1) %sample_tex, ptr addrspace(2) @__air_sampler_state, <2 x float> %uv_final, i1 true, <2 x i32> zeroinitializer, i1 false, float 0.0, float 0.0, i32 0)
+  %color = extractvalue { <4 x half>, i8 } %sampled, 0
+  ret <4 x half> %color
+}
+
+declare { <4 x half>, i8 } @air.sample_texture_2d.v4f16(ptr addrspace(1), ptr addrspace(2), <2 x float>, i1, <2 x i32>, i1, float, float, i32)
+
+!air.fragment = !{!0}
+!air.sampler_states = !{!1}
+!0 = !{ptr @frag, !2, !3}
+!1 = !{!"air.sampler_state", ptr addrspace(2) @__air_sampler_state}
+!2 = !{!4}
+!3 = !{!5, !6, !7}
+!4 = !{!"air.render_target", i32 0, i32 0, !"air.arg_type_name", !"half4"}
+!5 = !{i32 0, !"air.fragment_input", !"generated(coord)", !"air.center", !"air.no_perspective", !"air.arg_type_name", !"float2"}
+!6 = !{i32 1, !"air.buffer", !"air.location_index", i32 0, i32 1, !"air.read", !"air.address_space", i32 2, !"air.arg_type_size", i32 32, !"air.arg_type_align_size", i32 4, !"air.arg_type_name", !"Globals", !"air.arg_name", !"globals"}
+!7 = !{i32 2, !"air.texture", !"air.location_index", i32 0, i32 1, !"air.sample", !"air.arg_type_name", !"texture2d<half, sample>", !"air.arg_name", !"fill_tex"}
+"#;
+    let direct_ll = entry_template.replace(
+        "%sample_tex = __SAMPLE_TEX_EXPR__",
+        "%sample_tex = bitcast ptr addrspace(1) %tex to ptr addrspace(1)",
+    );
+    let reload_ll = entry_template.replace(
+        "%sample_tex = __SAMPLE_TEX_EXPR__",
+        "%sample_tex = load ptr addrspace(1), ptr %tex_slot, align 8",
+    );
+    for (label, ll) in [("direct", direct_ll), ("reload", reload_ll)] {
+        let (spv, reflection) = crate::translate_sanitized_native_reflected_unvalidated(
+            &ll,
+            Stage::Fragment,
+            std::path::Path::new(""),
+            crate::passes::TransformOptions::default(),
+            None,
+        )
+        .unwrap_or_else(|e| panic!("{label} sample path should translate cleanly: {e}"));
+        let module = load_bytes(&spv).expect("valid SPIR-V bytes");
+        assert!(!module.functions.is_empty(), "{label}: missing function");
+        let has_texture_binding = reflection.bindings.iter().any(|b| {
+            b.kind == crate::reflect::ResourceKind::Texture && b.metal_index == 0
+        });
+        assert!(
+            has_texture_binding,
+            "{label}: expected texture(0) in reflection bindings: {:?}",
+            reflection.bindings
+        );
+    }
+}
