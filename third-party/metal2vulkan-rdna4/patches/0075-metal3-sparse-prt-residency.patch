+  store <4 x float> %packed, ptr addrspace(1) %out, align 16
+  ret void
+}
+declare { <4 x float>, i8 } @air.sample_texture_2d.sparse.v4f32(ptr addrspace(1), ptr addrspace(2), <2 x float>, i1, <2 x i32>, i1, float, float, i32)
+!air.kernel = !{!0}
