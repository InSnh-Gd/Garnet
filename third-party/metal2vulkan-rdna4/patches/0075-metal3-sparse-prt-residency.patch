+/// Decide whether a texture `sample`/`read`/`gather` call must lower to `OpImageSparse*` +
+/// `OpImageSparseTexelsResident` (emitting `OpCapability SparseResidency`).
+///
+/// Triggers either when the AIR intrinsic explicitly names `.sparse` (e.g.,
+/// `air.sample_texture_2d.sparse.v4f32`) OR when the call returns Metal's `{ texel, i8 }`
+/// `sparse_color<T>` struct and member 1 (the residency flag) is actually read/escaped in the
+/// function body. Ordinary non-sparse calls that only extract member 0 stay non-sparse so
+/// `SparseResidency` is never requested unless needed.
+pub(in crate::passes) fn is_sparse_texture_call(
+    ctx: &Ctx,
+    name: &str,
+    res: Word,
+    rty: Word,
+) -> bool {
+    let explicit_sparse = name.split('.').any(|tok| tok == "sparse") || name.contains("_sparse_");
+    let Some(rdef) = type_def_of(ctx, rty) else {
+        return false;
+    };
+    if rdef.class.opcode != Op::TypeStruct || rdef.operands.len() < 2 {
+        return false;
+    }
+    if explicit_sparse {
+        return true;
+    }
+    residency_member_is_used(ctx, res)
+}
+
+fn residency_member_is_used(ctx: &Ctx, root: Word) -> bool {
+    let Some(body) = ctx.air_call_body.as_ref() else {
+        return false;
+    };
+    let Some(function) = ctx.module.functions.get(body.function) else {
+        return false;
+    };
+    let mut function_vars = HashSet::<Word>::new();
+    for block in &function.blocks {
+        for inst in &block.instructions {
+            if inst.class.opcode == Op::Variable
+                && inst.operands.first() == Some(&Operand::StorageClass(StorageClass::Function))
+            {
+                if let Some(id) = inst.result_id {
+                    function_vars.insert(id);
+                }
+            }
+        }
+    }
+
+    let mut worklist = vec![root];
+    let mut visited = HashSet::from([root]);
+    let mut tracked_ptrs = HashSet::<Word>::new();
+    while let Some(val) = worklist.pop() {
+        for block in &function.blocks {
+            for inst in &block.instructions {
+                match inst.class.opcode {
+                    Op::CompositeExtract => {
+                        if inst.operands.first() == Some(&Operand::IdRef(val)) {
+                            if inst.operands.get(1) != Some(&Operand::LiteralBit32(0)) {
+                                return true;
+                            }
+                        }
+                    }
+                    Op::CopyObject | Op::Phi | Op::Select => {
+                        let uses_val = inst
+                            .operands
+                            .iter()
+                            .any(|op| op == &Operand::IdRef(val));
+                        if uses_val {
+                            if let Some(rid) = inst.result_id {
+                                if visited.insert(rid) {
+                                    worklist.push(rid);
+                                }
+                            }
+                        }
+                    }
+                    Op::Store => {
+                        if inst.operands.get(1) == Some(&Operand::IdRef(val)) {
+                            if let Some(Operand::IdRef(ptr)) = inst.operands.first() {
+                                if function_vars.contains(ptr) {
+                                    if tracked_ptrs.insert(*ptr) {
+                                        for blk in &function.blocks {
+                                            for use_inst in &blk.instructions {
+                                                match use_inst.class.opcode {
+                                                    Op::Load
+                                                        if use_inst.operands.first()
+                                                            == Some(&Operand::IdRef(*ptr)) =>
+                                                    {
+                                                        if let Some(lid) = use_inst.result_id {
+                                                            if visited.insert(lid) {
+                                                                worklist.push(lid);
+                                                            }
+                                                        }
+                                                    }
+                                                    Op::AccessChain | Op::InBoundsAccessChain
+                                                        if use_inst.operands.first()
+                                                            == Some(&Operand::IdRef(*ptr)) =>
+                                                    {
+                                                        let idx_is_zero = use_inst
+                                                            .operands
+                                                            .get(1)
+                                                            .and_then(|op| match op {
+                                                                Operand::IdRef(id) => Some(
+                                                                    integer_operand_is_constant_zero(
+                                                                        ctx, *id,
+                                                                    ),
+                                                                ),
+                                                                _ => None,
+                                                            })
+                                                            .unwrap_or(false);
+                                                        if !idx_is_zero {
+                                                            return true;
+                                                        }
+                                                    }
+                                                    _ => {}
+                                                }
+                                            }
+                                        }
+                                    }
+                                } else {
+                                    // Stored to Output / StorageBuffer / Private: whole struct escapes.
+                                    return true;
+                                }
+                            }
+                        }
+                    }
+                    Op::ReturnValue | Op::FunctionCall | Op::CompositeConstruct | Op::CompositeInsert => {
+                        if inst.operands.iter().any(|op| op == &Operand::IdRef(val)) {
+                            return true;
+                        }
+                    }
+                    _ => {}
+                }
+            }
+        }
+    }
+    false
+}
