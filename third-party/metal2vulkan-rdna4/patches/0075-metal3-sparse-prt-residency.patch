+/// Unpack a SPIR-V `OpImageSparse*` result `{ u32 residency_code, texel }` into
+/// `(texel, resident_bool)` using `OpImageSparseTexelsResident`.
+pub(in crate::passes) fn emit_sparse_unpack(
+    ctx: &mut Ctx,
+    out: &mut Vec<Instruction>,
+    sparse_result: Word,
+    texel_ty: Word,
+) -> (Word, Word) {
+    let uint_ty = ctx.ty_uint();
+    let bool_ty = ctx.ty_bool();
+    let res_code = ctx.module.fresh_id();
+    out.push(Instruction::new(
+        Op::CompositeExtract,
+        Some(uint_ty),
+        Some(res_code),
+        vec![Operand::IdRef(sparse_result), Operand::LiteralBit32(0)],
+    ));
+    let texel = ctx.module.fresh_id();
+    out.push(Instruction::new(
+        Op::CompositeExtract,
+        Some(texel_ty),
+        Some(texel),
+        vec![Operand::IdRef(sparse_result), Operand::LiteralBit32(1)],
+    ));
+    let resident_bool = ctx.module.fresh_id();
+    out.push(Instruction::new(
+        Op::ImageSparseTexelsResident,
+        Some(bool_ty),
+        Some(resident_bool),
+        vec![Operand::IdRef(res_code)],
+    ));
+    (texel, resident_bool)
+}
+
+/// Guard a sparse residency boolean for a clamped-to-border out-of-bounds fetch: an out-of-bounds
+/// border texel is synthesized as zero by the sampler (resident = true) rather than reflecting an
+/// unbound tile at a clamped coordinate.
+pub(in crate::passes) fn guard_residency_in_bounds(
+    ctx: &mut Ctx,
+    out: &mut Vec<Instruction>,
+    resident_bool: Option<Word>,
+    in_bounds: Word,
+) -> Option<Word> {
+    let res_b = resident_bool?;
+    let bool_ty = ctx.ty_bool();
+    let true_c = ctx.const_bool_of(bool_ty, true);
+    let guarded = ctx.module.fresh_id();
+    out.push(Instruction::new(
+        Op::Select,
+        Some(bool_ty),
+        Some(guarded),
+        vec![
+            Operand::IdRef(in_bounds),
+            Operand::IdRef(res_b),
+            Operand::IdRef(true_c),
+        ],
+    ));
+    Some(guarded)
+}
+
+/// Materialize member 1 of AIR's `{ texel, residency }` struct: `OpUndef` on non-sparse ops, or
+/// the converted residency boolean (`bool` directly, or `OpSelect` 1/0 for `i8`/`i32`) on sparse.
+pub(in crate::passes) fn encode_residency_member(
+    ctx: &mut Ctx,
+    out: &mut Vec<Instruction>,
+    rdef: Option<&Instruction>,
+    resident_bool: Option<Word>,
+) -> Word {
+    let member1_ty = rdef
+        .and_then(|d| d.operands.get(1))
+        .and_then(|o| match o {
+            Operand::IdRef(m) => Some(*m),
+            _ => None,
+        })
+        .unwrap_or_else(|| ctx.ty_int8());
+    let Some(is_res) = resident_bool else {
+        let undef = ctx.module.fresh_id();
+        out.push(Instruction::new(
+            Op::Undef,
+            Some(member1_ty),
+            Some(undef),
+            vec![],
+        ));
+        return undef;
+    };
+    if type_def_of(ctx, member1_ty).is_some_and(|d| d.class.opcode == Op::TypeBool) {
+        return is_res;
+    }
+    let one = ctx.const_int_of(member1_ty, 1);
+    let zero = ctx.const_int_of(member1_ty, 0);
+    let flag = ctx.module.fresh_id();
+    out.push(Instruction::new(
+        Op::Select,
+        Some(member1_ty),
+        Some(flag),
+        vec![Operand::IdRef(is_res), Operand::IdRef(one), Operand::IdRef(zero)],
+    ));
+    flag
+}
