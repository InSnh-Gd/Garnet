+    #[test]
+    fn sparse_sample_implicit_and_explicit_lod_emit_sparse_ops_and_capability() {
+        let frag_ll = r#"
+target triple = "spirv-unknown-vulkan1.2"
+define <4 x float> @frag(ptr addrspace(1) %tex, ptr addrspace(2) %sampler, <2 x float> %uv) {
+entry:
+  %sample = tail call { <4 x float>, i8 } @air.sample_texture_2d.sparse.v4f32(ptr addrspace(1) %tex, ptr addrspace(2) %sampler, <2 x float> %uv)
+  %color = extractvalue { <4 x float>, i8 } %sample, 0
+  %res = extractvalue { <4 x float>, i8 } %sample, 1
+  %is_res = icmp ne i8 %res, 0
+  %alpha = select i1 %is_res, float 1.000000e+00, float 0.000000e+00
+  %out = insertelement <4 x float> %color, float %alpha, i32 3
+  ret <4 x float> %out
+}
+
+declare { <4 x float>, i8 } @air.sample_texture_2d.sparse.v4f32(ptr addrspace(1), ptr addrspace(2), <2 x float>)
+
+!air.fragment = !{!0}
+!0 = !{ptr @frag, !1, !2}
+!1 = !{!3}
+!2 = !{!4, !5, !6}
+!3 = !{!"air.render_target", i32 0, i32 0, !"air.arg_type_name", !"float4"}
+!4 = !{i32 0, !"air.texture", !"air.location_index", i32 0, i32 1, !"air.sample", !"air.arg_type_name", !"texture2d<float, sample>", !"air.arg_name", !"tex"}
+!5 = !{i32 1, !"air.sampler", !"air.location_index", i32 1, i32 1, !"air.arg_type_name", !"sampler", !"air.arg_name", !"sampler"}
+!6 = !{i32 2, !"air.fragment_input", !"air.location_index", i32 0, i32 1, !"air.center", !"air.perspective", !"air.arg_type_name", !"float2", !"air.arg_name", !"uv"}
+"#;
+        let frag_asm = translate_sparse_asm(frag_ll, Stage::Fragment);
+        assert!(frag_asm.contains("OpCapability SparseResidency"), "{frag_asm}");
+        assert!(frag_asm.contains("OpImageSparseSampleImplicitLod"), "{frag_asm}");
+        assert!(frag_asm.contains("OpImageSparseTexelsResident"), "{frag_asm}");
+        assert!(!frag_asm.contains("OpImageSampleImplicitLod"), "{frag_asm}");
+
+        let compute_ll = r#"
+target triple = "spirv-unknown-vulkan1.2"
+define void @k(ptr addrspace(1) %tex, ptr addrspace(2) %sampler, ptr addrspace(1) %out) {
+entry:
+  %sample = tail call { <4 x float>, i8 } @air.sample_texture_2d.v4f32(ptr addrspace(1) %tex, ptr addrspace(2) %sampler, <2 x float> <float 2.500000e-01, float 7.500000e-01>)
+  %color = extractvalue { <4 x float>, i8 } %sample, 0
+  %res = extractvalue { <4 x float>, i8 } %sample, 1
