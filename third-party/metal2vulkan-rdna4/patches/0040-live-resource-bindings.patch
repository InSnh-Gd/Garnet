 use super::*;
+
+/// Retract unused synthetic address reads left after opaque resource helpers become descriptors.
+pub(in crate::passes) fn prune_unused_buffer_address_scaffolding(ctx: &mut Ctx) -> bool {
+    let mut bindings = HashMap::new();
+    let mut sets = HashMap::new();
+    for annotation in &ctx.module.annotations {
+        match annotation.operands.as_slice() {
+            [Operand::IdRef(id), Operand::Decoration(Decoration::Binding), Operand::LiteralBit32(binding)] =>
+            {
+                bindings.insert(*id, *binding);
+            }
+            [Operand::IdRef(id), Operand::Decoration(Decoration::DescriptorSet), Operand::LiteralBit32(set)] =>
+            {
+                sets.insert(*id, *set);
+            }
+            _ => {}
+        }
+    }
+    let mut pointers = ctx
+        .module
+        .types_global_values
+        .iter()
+        .filter_map(|inst| {
+            let id = inst.result_id?;
+            (inst.class.opcode == Op::Variable
+                && inst.operands.first()
+                    == Some(&Operand::StorageClass(StorageClass::StorageBuffer))
+                && sets.get(&id) == Some(&ctx.descriptor_layout.set)
+                && bindings
+                    .get(&id)
+                    .is_some_and(|binding| ctx.descriptor_layout.synthetic.contains(*binding)))
+            .then_some(id)
+        })
+        .collect::<HashSet<_>>();
+    if pointers.is_empty() {
+        return false;
+    }
+    let mut candidates = pointers.clone();
+    loop {
+        let before = candidates.len();
+        for inst in ctx
+            .module
+            .functions
+            .iter()
+            .flat_map(|function| function.all_inst_iter())
+        {
+            let Some(id) = inst.result_id else { continue };
+            let base_is_table = matches!(inst.operands.first(), Some(Operand::IdRef(base)) if pointers.contains(base));
+            if matches!(
+                inst.class.opcode,
+                Op::AccessChain | Op::InBoundsAccessChain | Op::CopyObject
+            ) && base_is_table
+            {
+                pointers.insert(id);
+                candidates.insert(id);
+            } else if inst.class.opcode == Op::Load && base_is_table && inst.operands.len() == 1 {
+                // Only the generated plain readonly table loads qualify, never volatile/device reads.
+                candidates.insert(id);
+            } else if matches!(
+                inst.class.opcode,
+                Op::CopyObject
+                    | Op::Bitcast
+                    | Op::UConvert
+                    | Op::SConvert
+                    | Op::ShiftLeftLogical
+                    | Op::ShiftRightLogical
+                    | Op::BitwiseOr
+                    | Op::BitwiseAnd
+                    | Op::CompositeConstruct
+                    | Op::CompositeExtract
+                    | Op::VectorShuffle
+            ) && inst.operands.iter().any(
+                |operand| matches!(operand, Operand::IdRef(input) if candidates.contains(input)),
+            ) {
+                candidates.insert(id);
+            }
+        }
+        if candidates.len() == before {
+            break;
+        }
+    }
+    // Keep every other value rooted: this cleanup is limited to address scaffolding, not a new
+    // whole-shader optimization. Live address consumers keep the entire table chain through DCE.
+    let preserved = ctx
+        .module
+        .all_inst_iter()
+        .filter_map(|inst| inst.result_id)
+        .filter(|id| !candidates.contains(id))
+        .collect();
+    crate::native::eliminate_dead_values_module(&mut ctx.module, &preserved)
+}
 
