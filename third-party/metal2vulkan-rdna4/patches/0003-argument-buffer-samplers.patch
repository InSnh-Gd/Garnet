+use metal2vulkan::meta::parse_air_kernel_meta;
+use metal2vulkan::passes::{Stage, TransformOptions};
+use metal2vulkan::reflect::{ResourceKind, ShaderReflection, SAMPLER_BINDING_BASE};
+use std::path::Path;
+
+const SOURCE: &str = include_str!("fixtures/argument_buffer_sampler.ll");
+
+fn translate(source: &str) -> Result<(Vec<u8>, ShaderReflection), String> {
+    let (sanitized, layout) = metal2vulkan::tools::sanitize_ll_text_with_datalayout(source);
+    metal2vulkan::translate_sanitized_native_reflected_unvalidated(
+        &sanitized,
+        Stage::Kernel,
+        Path::new(""),
+        TransformOptions {
+            kernel_local_size: [1, 1, 1],
+            ..Default::default()
+        },
+        layout.as_deref(),
+    )
+}
+
+fn with_direct_sampler(index: u32) -> String {
+    let source = SOURCE
+        .replace("i32 %i) {", "i32 %i, ptr addrspace(2) %direct) {")
+        .replace("!2 = !{!3, !4, !5, !6}", "!2 = !{!3, !4, !5, !6, !30}");
+    format!("{source}\n!30 = !{{i32 4, !\"air.sampler\", !\"air.location_index\", i32 {index}, i32 1, !\"air.arg_type_name\", !\"sampler\", !\"air.arg_name\", !\"direct\"}}\n")
+}
+
+#[test]
+fn constant_argbuf_sampler_is_a_typed_descriptor() {
+    let (spv, reflection) = translate(SOURCE).expect("embedded sampler must translate");
+    reflection.validate_descriptor_abi().unwrap();
+    metal2vulkan::tools::spirv_val_bytes(&spv, &std::env::temp_dir()).unwrap();
+    let sampler = reflection
+        .bindings
+        .iter()
+        .find(|binding| binding.kind == ResourceKind::EmbeddedArgBufferSampler)
+        .unwrap();
+    let descriptor = sampler.descriptor.as_ref().unwrap();
+    assert_eq!(
+        (descriptor.set, descriptor.binding, descriptor.count),
+        (0, SAMPLER_BINDING_BASE, 1)
+    );
+    let owner = sampler.embedded_source.as_ref().unwrap();
+    assert_eq!((owner.buffer_param_index, owner.buffer_index), (2, 2));
+    assert_eq!((owner.field_offset, owner.argument_index), (16, 2));
+    let assembly = metal2vulkan::disassemble(&spv).unwrap();
+    let sampler_ty = assembly
+        .lines()
+        .find(|line| line.contains("= OpTypeSampler"))
+        .unwrap()
+        .split_whitespace()
+        .next()
+        .unwrap();
+    let values = assembly
+        .lines()
+        .filter_map(|line| {
+            let words = line.split_whitespace().collect::<Vec<_>>();
+            (words.len() >= 5 && words[2] == "OpLoad" && words[3] == sampler_ty)
+                .then(|| words[0].to_string())
+        })
+        .collect::<Vec<_>>();
+    assert!(
+        assembly.lines().any(|line| {
+            let words = line.split_whitespace().collect::<Vec<_>>();
+            words.len() >= 6
+                && words[2] == "OpSampledImage"
+                && values.iter().any(|value| value == words[5])
+        }),
+        "sample must consume a descriptor-loaded sampler"
+    );
+}
+
+#[test]
+fn embedded_sampler_follows_direct_slots() {
+    let (spv, reflection) = translate(&with_direct_sampler(3)).unwrap();
+    assert!(!spv.is_empty());
+    let sampler = reflection
+        .bindings
+        .iter()
+        .find(|binding| binding.kind == ResourceKind::EmbeddedArgBufferSampler)
+        .unwrap();
+    assert_eq!(sampler.metal_index, 4);
+    assert_eq!(
+        sampler.descriptor.as_ref().unwrap().binding,
+        SAMPLER_BINDING_BASE + 4
+    );
+}
+
+#[test]
+fn exhausted_sampler_band_refuses() {
+    let error = translate(&with_direct_sampler(15)).unwrap_err();
+    assert!(
+        error.contains("EmbeddedArgBufferSampler(16)") && error.contains("descriptor ABI band"),
+        "{error}"
+    );
+}
+
+#[test]
+fn sampler_arrays_are_not_surfaced_as_one_scalar() {
+    let source = SOURCE.replace(
+        "i32 16, i32 8, i32 0, !\"sampler\"",
+        "i32 16, i32 8, i32 2, !\"sampler\"",
+    );
+    let metadata = parse_air_kernel_meta(&source).unwrap();
+    assert!(metadata.embedded_samplers.is_empty());
+    assert!(metadata
+        .unsurfaced_embedded_resources
+        .iter()
+        .any(|reason| reason.contains("sampler")));
+}
