+/// Recover only statically addressed scalar sampler fields. A token is not a device address:
+/// replace the opaque field load by a real descriptor load, retaining owner/offset in reflection.
+fn register_embedded_samplers(
+    ctx: &mut Ctx,
+    entry_idx: usize,
+    embedded: Option<&[crate::meta::EmbeddedSampler]>,
+) -> Result<(), String> {
+    let Some(embedded) = embedded else {
+        return Ok(());
+    };
+    let layout = ctx.descriptor_layout;
+    let mut loads = Vec::new();
+    for sampler in embedded {
+        let binding = sampler_resource_binding(layout, sampler.synthetic_sampler_index)?;
+        let root = ctx.module.functions[entry_idx]
+            .parameters
+            .get(sampler.buffer_param_index as usize)
+            .and_then(|parameter| parameter.result_id)
+            .ok_or_else(|| "embedded sampler owner parameter is missing".to_string())?;
+        if ctx
+            .emit_sidecar
+            .buffer_pointer_dynamic_field_loads
+            .iter()
+            .any(|fact| fact.root == root && fact.byte_offset == u64::from(sampler.field_offset))
+        {
+            return Err("dynamic argument-buffer sampler field access is unsupported".into());
+        }
+        let handles = ctx
+            .emit_sidecar
+            .buffer_pointer_field_loads
+            .iter()
+            .filter(|fact| fact.root == root && fact.byte_offset == u64::from(sampler.field_offset))
+            .map(|fact| fact.id)
+            .collect::<Vec<_>>();
+        let sampler_ty = ctx.ty_sampler();
+        let pointer_ty = ctx.ty_ptr(StorageClass::UniformConstant, sampler_ty);
+        let var = ctx.module.fresh_id();
+        ctx.new_globals.push(Instruction::new(
+            Op::Variable,
+            Some(pointer_ty),
+            Some(var),
+            vec![Operand::StorageClass(StorageClass::UniformConstant)],
+        ));
+        decorate_binding(&mut ctx.module, var, layout.set, binding);
+        ctx.interface_buffer_var(var);
+        let value = ctx.module.fresh_id();
+        loads.push(Instruction::new(
+            Op::Load,
+            Some(sampler_ty),
+            Some(value),
+            vec![Operand::IdRef(var)],
+        ));
+        for handle in handles {
+            replace_id_in_function(&mut ctx.module.functions[entry_idx], handle, value);
+        }
+    }
+    if let Some(entry) = ctx.module.functions[entry_idx].blocks.first_mut() {
+        let at = entry
+            .instructions
+            .iter()
+            .position(|instruction| instruction.class.opcode != Op::Variable)
+            .unwrap_or(entry.instructions.len());
+        entry.instructions.splice(at..at, loads);
+    }
+    Ok(())
+}
