+++ b/src/native/inline_cursor_tests.rs
@@ -0,0 +1,74 @@
+use super::{inline_cursor_call_sites, inline_nonrecursive_internal_calls};
+use std::collections::HashSet;
+
+#[test]
+fn cursor_repair_inlines_only_selected_calls_and_keeps_exported_definition() {
+    let source = r#"
+define void @entry(ptr addrspace(1) %buffer, i64 %index) {
+entry:
+  %cursor = getelementptr i32, ptr addrspace(1) %buffer, i64 %index
+  call void @writer(ptr addrspace(1) %cursor)
+  call void @writer(ptr addrspace(1) %buffer)
+  ret void
+}
+define void @writer(ptr addrspace(1) %destination) {
+entry:
+  store i32 37, ptr addrspace(1) %destination, align 4
+  ret void
+}
+"#;
+    assert_eq!(inline_nonrecursive_internal_calls(source), source);
+    let sites = HashSet::from([("writer".into(), "%cursor".into())]);
+    let result = inline_cursor_call_sites(source, &sites).expect("defined helper is spliceable");
+    assert!(!result.contains("call void @writer(ptr addrspace(1) %cursor)"));
+    assert!(result.contains("store i32 37, ptr addrspace(1) %cursor"));
+    assert!(result.contains("call void @writer(ptr addrspace(1) %buffer)"));
+    assert!(result.contains("define void @writer"));
+    assert!(inline_cursor_call_sites(&result, &sites).is_none());
+    let unrelated_cycle = format!(
+        "{source}\ndefine void @cycle() {{\nentry:\n  call void @cycle()\n  ret void\n}}\n"
+    );
+    assert!(inline_cursor_call_sites(&unrelated_cycle, &sites).is_some());
+}
+
+#[test]
+fn cursor_repair_does_not_inline_a_declaration() {
+    let source = r#"
+define void @entry(ptr addrspace(1) %cursor) {
+entry:
+  call void @writer(ptr addrspace(1) %cursor)
+  ret void
+}
+declare void @writer(ptr addrspace(1))
+"#;
+    let sites = HashSet::from([("writer".into(), "%cursor".into())]);
+    assert!(inline_cursor_call_sites(source, &sites).is_none());
+}
+
+#[test]
+fn cursor_repair_rejects_cycles_through_unselected_definitions() {
+    let source = r#"
+define void @entry(ptr addrspace(1) %cursor) {
+entry:
+  call void @writer(ptr addrspace(1) %cursor)
+  ret void
+}
+define void @writer(ptr addrspace(1) %destination) {
+entry:
+  call void @relay(ptr addrspace(1) %destination)
+  ret void
+}
+define internal void @relay(ptr addrspace(1) %p) {
+entry:
+  call void @writer(ptr addrspace(1) %p)
+  ret void
+}
+"#;
+    let sites = HashSet::from([("writer".into(), "%cursor".into())]);
+    assert!(inline_cursor_call_sites(source, &sites).is_none());
+    let recursive = source.replace(
+        "@relay(ptr addrspace(1) %destination)",
+        "@writer(ptr addrspace(1) %destination)",
+    );
+    assert!(inline_cursor_call_sites(&recursive, &sites).is_none());
+}
