 use super::*;
 
+pub(super) struct UnwrappedCoordinate {
+    pub raw: Word,
+    pub dead_candidates: Vec<Word>,
+}
+
+fn is_zero_constant(id: Word, defs: &HashMap<Word, Instruction>) -> bool {
+    let Some(def) = defs.get(&id) else {
+        return false;
+    };
+    def.class.opcode == Op::ConstantNull
+        || (def.class.opcode == Op::Constant
+            && def.operands.as_slice() == [Operand::LiteralBit32(0)])
+}
+
+/// Unwrap an earlier `normalize_sampler_coordinate` `OpSelect` when postpass re-lowers a fragment LOD query.
+pub(super) fn unwrap_normalized_query_coordinate(
+    coord: Word,
+    image: Word,
+    defs: &HashMap<Word, Instruction>,
+) -> Option<UnwrappedCoordinate> {
+    let select = defs.get(&coord)?;
+    if select.class.opcode != Op::Select {
+        return None;
+    }
+    let [Operand::IdRef(cond), Operand::IdRef(norm), Operand::IdRef(raw)] =
+        select.operands.as_slice()
+    else {
+        return None;
+    };
+    let construct = defs.get(norm)?;
+    if construct.class.opcode != Op::CompositeConstruct {
+        return None;
+    }
+    let [Operand::IdRef(div0), Operand::IdRef(div1)] = construct.operands.as_slice() else {
+        return None;
+    };
+    let mut size_query = None;
+    let mut dead = vec![coord, *norm];
+    for (axis, div_id) in [(0u32, *div0), (1u32, *div1)] {
+        let div = defs.get(&div_id)?;
+        if div.class.opcode != Op::FDiv {
+            return None;
+        }
+        let [Operand::IdRef(raw_comp), Operand::IdRef(u2f)] = div.operands.as_slice() else {
+            return None;
+        };
+        let raw_ext = defs.get(raw_comp)?;
+        if raw_ext.class.opcode != Op::CompositeExtract
+            || raw_ext.operands.as_slice() != [Operand::IdRef(*raw), Operand::LiteralBit32(axis)]
+        {
+            return None;
+        }
+        let convert = defs.get(u2f)?;
+        if convert.class.opcode != Op::ConvertUToF {
+            return None;
+        }
+        let [Operand::IdRef(size_ext_id)] = convert.operands.as_slice() else {
+            return None;
+        };
+        let size_ext = defs.get(size_ext_id)?;
+        if size_ext.class.opcode != Op::CompositeExtract {
+            return None;
+        }
+        let [Operand::IdRef(size_id), Operand::LiteralBit32(s_axis)] = size_ext.operands.as_slice()
+        else {
+            return None;
+        };
+        if *s_axis != axis {
+            return None;
+        }
+        if let Some(prev) = size_query {
+            if prev != *size_id {
+                return None;
+            }
+        } else {
+            size_query = Some(*size_id);
+        }
+        dead.extend([div_id, *raw_comp, *u2f, *size_ext_id]);
+    }
+    let size_id = size_query?;
+    let query = defs.get(&size_id)?;
+    if query.class.opcode != Op::ImageQuerySizeLod {
+        return None;
+    }
+    let [Operand::IdRef(query_img), Operand::IdRef(lod)] = query.operands.as_slice() else {
+        return None;
+    };
+    if *query_img != image || !is_zero_constant(*lod, defs) {
+        return None;
+    }
+    dead.push(size_id);
+    if let Some(neq) = defs.get(cond).filter(|i| i.class.opcode == Op::INotEqual) {
+        if let [Operand::IdRef(and_id), Operand::IdRef(zero_id)] = neq.operands.as_slice() {
+            if is_zero_constant(*zero_id, defs) {
+                if let Some(band) = defs
+                    .get(and_id)
+                    .filter(|i| i.class.opcode == Op::BitwiseAnd)
+                {
+                    dead.extend([*cond, *and_id]);
+                    if let Some(Operand::IdRef(flag_word)) = band.operands.first() {
+                        if let Some(load) =
+                            defs.get(flag_word).filter(|i| i.class.opcode == Op::Load)
+                        {
+                            dead.push(*flag_word);
+                            if let Some(Operand::IdRef(ptr)) = load.operands.first() {
+                                if defs.get(ptr).is_some_and(|i| {
+                                    matches!(
+                                        i.class.opcode,
+                                        Op::AccessChain | Op::InBoundsAccessChain
+                                    )
+                                }) {
+                                    dead.push(*ptr);
+                                }
+                            }
+                        }
+                    }
+                }
+            }
+        }
+    }
+    Some(UnwrappedCoordinate {
+        raw: *raw,
+        dead_candidates: dead,
+    })
+}
+
+pub(super) fn prune_dead_candidates(ctx: &mut Ctx, function_index: usize, candidates: &[Word]) {
+    if candidates.is_empty() {
+        return;
+    }
+    let mut protected = HashSet::new();
+    for inst in ctx
+        .module
+        .annotations
+        .iter()
+        .chain(&ctx.module.debug_names)
+        .chain(&ctx.module.entry_points)
+        .chain(&ctx.module.execution_modes)
+        .chain(&ctx.module.types_global_values)
+    {
+        for op in &inst.operands {
+            if let Operand::IdRef(id) = op {
+                protected.insert(*id);
+            }
+        }
+    }
+    let candidate_set: HashSet<Word> = candidates
+        .iter()
+        .copied()
+        .filter(|id| !protected.contains(id))
+        .collect();
+    if candidate_set.is_empty() {
+        return;
+    }
+    loop {
+        let mut used = HashSet::new();
+        for block in &ctx.module.functions[function_index].blocks {
+            for inst in &block.instructions {
+                for op in &inst.operands {
+                    if let Operand::IdRef(id) = op {
+                        used.insert(*id);
+                    }
+                }
+            }
+        }
+        let mut removed = false;
+        for block in &mut ctx.module.functions[function_index].blocks {
+            let before = block.instructions.len();
+            block.instructions.retain(|inst| {
+                let Some(id) = inst.result_id else {
+                    return true;
+                };
+                !candidate_set.contains(&id) || used.contains(&id)
+            });
+            if block.instructions.len() != before {
+                removed = true;
+            }
+        }
+        if !removed {
+            break;
+        }
+    }
+}
