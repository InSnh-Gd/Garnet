@@ -0,0 +1,213 @@
+//! `air.gather_compare_depth_2d[_array].f32` must lower to a comparison gather, not to a color
+//! gather followed by an unrelated scalar comparison.
+
+use metal2vulkan::passes::Stage;
+use metal2vulkan::{disassemble, translate_sanitized_native};
+use std::path::PathBuf;
+
+const COMPARE_LESS: i64 = 34_901_797_600_561_737;
+const COMPARE_NONE: i64 = 34_901_797_600_496_201;
+const PIXEL_COMPARE_LESS: i64 = 34_901_797_600_594_505;
+
+fn scratch(label: &str) -> PathBuf {
+    let directory = std::env::temp_dir().join(format!(
+        "metal2vulkan_gather_compare_depth_{}_{}",
+        std::process::id(),
+        label
+    ));
+    std::fs::create_dir_all(&directory).expect("create scratch directory");
+    directory
+}
+
+fn translate(source: &str, label: &str) -> Result<Vec<u8>, String> {
+    let directory = scratch(label);
+    let result = translate_sanitized_native(source, Stage::Kernel, &directory);
+    let _ = std::fs::remove_dir_all(directory);
+    result
+}
+
+fn assert_depth_image(assembly: &str, arrayed: bool) {
+    let shape = if arrayed {
+        " 2D 1 1 0 1 "
+    } else {
+        " 2D 1 0 0 1 "
+    };
+    assert!(
+        assembly
+            .lines()
+            .any(|line| line.contains("OpTypeImage") && line.contains(shape)),
+        "expected a Depth=1 image type ({shape})\n\n{assembly}"
+    );
+}
+
+fn comparison_gather_ll(
+    sampler_word: i64,
+    arrayed: bool,
+    offset: &str,
+    include_texture: bool,
+) -> String {
+    let (type_name, intrinsic, array_arg, array_decl) = if arrayed {
+        (
+            "depth2d_array<float, sample>",
+            "air.gather_compare_depth_2d_array.f32",
+            " i32 1,",
+            " i32,",
+        )
+    } else {
+        (
+            "depth2d<float, sample>",
+            "air.gather_compare_depth_2d.f32",
+            "",
+            "",
+        )
+    };
+    let params = if include_texture {
+        "ptr addrspace(1) %depth, ptr addrspace(1) %out"
+    } else {
+        "ptr addrspace(1) %out"
+    };
+    let texture_operand = if include_texture {
+        "ptr addrspace(1) %depth"
+    } else {
+        "ptr addrspace(1) null"
+    };
+    let metadata_args = if include_texture {
+        r#"!3, !4"#
+    } else {
+        r#"!4"#
+    };
+    let texture_metadata = if include_texture {
+        format!(
+            r#"!3 = !{{i32 0, !"air.texture", !"air.location_index", i32 0, i32 1, !"air.sample", !"air.arg_type_name", !"{type_name}", !"air.arg_name", !"depth"}}
+"#
+        )
+    } else {
+        String::new()
+    };
+    format!(
+        r#"
+target triple = "spirv-unknown-vulkan1.2"
+
+@__air_sampler_state = internal addrspace(2) constant [2 x i64] [i64 {sampler_word}, i64 0], align 8
+
+define void @k({params}) {{
+entry:
+  %c0 = insertelement <2 x float> poison, float 5.000000e-01, i32 0
+  %coord = insertelement <2 x float> %c0, float 5.000000e-01, i32 1
+  %gather = tail call {{ <4 x float>, i8 }} @{intrinsic}({texture_operand}, ptr addrspace(2) @__air_sampler_state, i32 1, <2 x float> %coord,{array_arg} float 5.000000e-01, i1 true, {offset}, i32 0)
+  %values = extractvalue {{ <4 x float>, i8 }} %gather, 0
+  store <4 x float> %values, ptr addrspace(1) %out, align 16
+  ret void
+}}
+
+declare {{ <4 x float>, i8 }} @{intrinsic}(ptr addrspace(1), ptr addrspace(2), i32, <2 x float>,{array_decl} float, i1, <2 x i32>, i32)
+
+!air.kernel = !{{!0}}
+!air.sampler_states = !{{!5}}
+!0 = !{{ptr @k, !1, !2}}
+!1 = !{{}}
+!2 = !{{{metadata_args}}}
+{texture_metadata}!4 = !{{i32 1, !"air.buffer", !"air.buffer_size", i32 16, !"air.location_index", i32 0, i32 1, !"air.write", !"air.address_space", i32 1, !"air.arg_type_size", i32 16, !"air.arg_type_align_size", i32 16, !"air.arg_type_name", !"float4*", !"air.arg_name", !"out"}}
+!5 = !{{!"air.sampler_state", ptr addrspace(2) @__air_sampler_state}}
+"#
+    )
+}
+
+#[test]
+fn normalized_depth_compare_gather_uses_dref_gather() {
+    let source = comparison_gather_ll(COMPARE_LESS, false, "<2 x i32> zeroinitializer", true);
+    let spv = translate(&source, "normalized").expect("depth comparison gather translates");
+    let assembly = disassemble(&spv).expect("disassemble");
+    assert_eq!(
+        assembly.matches("OpImageDrefGather").count(),
+        1,
+        "{assembly}"
+    );
+    let gather = assembly
+        .lines()
+        .find(|line| line.contains("OpImageDrefGather"))
+        .expect("Dref gather instruction");
+    assert!(!gather.contains("ConstOffset"), "{gather}\n\n{assembly}");
+    assert!(assembly.contains("OpSampledImage"), "{assembly}");
+    assert_depth_image(&assembly, false);
+    assert!(!assembly.contains("air.gather_compare_depth"), "{assembly}");
+}
+
+#[test]
+fn depth_compare_gather_preserves_a_nonzero_constant_offset() {
+    let source = comparison_gather_ll(COMPARE_LESS, false, "<2 x i32> <i32 1, i32 -1>", true);
+    let spv = translate(&source, "constant_offset").expect("offset gather translates");
+    let assembly = disassemble(&spv).expect("disassemble");
+    let gather = assembly
+        .lines()
+        .find(|line| line.contains("OpImageDrefGather"))
+        .expect("Dref gather instruction");
+    assert!(gather.contains("ConstOffset"), "{gather}\n\n{assembly}");
+}
+
+#[test]
+fn depth_compare_gather_2d_array_appends_the_layer() {
+    let source = comparison_gather_ll(COMPARE_LESS, true, "<2 x i32> zeroinitializer", true);
+    let spv = translate(&source, "array").expect("arrayed depth comparison gather translates");
+    let assembly = disassemble(&spv).expect("disassemble");
+    assert_eq!(
+        assembly.matches("OpImageDrefGather").count(),
+        1,
+        "{assembly}"
+    );
+    assert_depth_image(&assembly, true);
+    let float_type = assembly
+        .lines()
+        .find(|line| line.contains("OpTypeFloat 32"))
+        .and_then(|line| line.split_whitespace().next())
+        .expect("float type");
+    assert!(
+        assembly.contains(&format!("OpTypeVector {float_type} 3")),
+        "{assembly}"
+    );
+    assert!(assembly.contains("OpConvertUToF"), "{assembly}");
+}
+
+#[test]
+fn depth_compare_gather_reflection_reports_the_depth_image() {
+    let source = comparison_gather_ll(COMPARE_LESS, false, "<2 x i32> zeroinitializer", true);
+    let directory = scratch("reflection");
+    let (_, reflection) = metal2vulkan::translate_sanitized_native_reflected(
+        &source,
+        Stage::Kernel,
+        &directory,
+        Default::default(),
+    )
+    .expect("reflected depth comparison gather translates");
+    let _ = std::fs::remove_dir_all(directory);
+    let shape = reflection
+        .bindings
+        .iter()
+        .find_map(|binding| binding.texture_shape)
+        .expect("the depth texture reflects a shape");
+    assert!(shape.depth, "{shape:?}");
+}
+
+#[test]
+fn absent_texture_compare_gather_returns_zero_without_an_image_operation() {
+    let source = comparison_gather_ll(COMPARE_LESS, false, "<2 x i32> zeroinitializer", false);
+    let spv = translate(&source, "null").expect("null depth comparison gather translates");
+    let assembly = disassemble(&spv).expect("disassemble");
+    assert!(!assembly.contains("OpImageDrefGather"), "{assembly}");
+    assert!(!assembly.contains("OpSampledImage"), "{assembly}");
+    assert!(assembly.contains("OpConstantNull"), "{assembly}");
+}
+
+#[test]
+fn depth_compare_gather_requires_a_comparison_sampler() {
+    let source = comparison_gather_ll(COMPARE_NONE, false, "<2 x i32> zeroinitializer", true);
+    let error = translate(&source, "compare_none").expect_err("comparison must be enabled");
+    assert!(error.contains("comparison enabled"), "{error}");
+}
+
+#[test]
+fn depth_compare_gather_rejects_pixel_coordinate_samplers() {
+    let source = comparison_gather_ll(PIXEL_COMPARE_LESS, false, "<2 x i32> zeroinitializer", true);
+    let error = translate(&source, "pixel").expect_err("pixel coordinates are unsupported");
+    assert!(error.contains("pixel-coordinate"), "{error}");
+}
