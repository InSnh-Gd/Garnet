@@ -0,0 +1,100 @@
+use metal2vulkan::{
+    passes::{Stage, TransformOptions},
+    translate_sanitized_native_reflected_unvalidated,
+};
+
+fn fragment(arrayed: bool, bias: bool) -> String {
+    let dimension = if arrayed { "2d_array" } else { "2d" };
+    let layer = if arrayed { " i32 1," } else { "" };
+    let layer_type = if arrayed { " i32," } else { "" };
+    let bias_value = if bias { "%runtime_bias" } else { "0.0" };
+    format!(
+        r#"
+target triple = "air64-apple-macosx"
+%Args = type {{ [2 x ptr addrspace(1)], [2 x ptr addrspace(2)] }}
+define <4 x float> @fragment(ptr addrspace(2) %args, <4 x float> %position) {{
+entry:
+  %x = extractelement <4 x float> %position, i32 0
+  %runtime_bias = extractelement <4 x float> %position, i32 1
+  %pixel = call i32 @air.convert.u.i32.f.f32(float %x)
+  %index32 = and i32 %pixel, 1
+  %index = zext i32 %index32 to i64
+  %image_slot = getelementptr %Args, ptr addrspace(2) %args, i64 0, i32 0, i64 %index
+  %sampler_slot = getelementptr %Args, ptr addrspace(2) %args, i64 0, i32 1, i64 %index
+  %image = load ptr addrspace(1), ptr addrspace(2) %image_slot, align 8
+  %sampler = load ptr addrspace(2), ptr addrspace(2) %sampler_slot, align 8
+  %coord = shufflevector <4 x float> %position, <4 x float> poison, <2 x i32> <i32 0, i32 1>
+  %sample = call {{ <4 x float>, i8 }} @air.sample_texture_{dimension}.v4f32(ptr addrspace(1) %image, ptr addrspace(2) %sampler, <2 x float> %coord,{layer} i1 true, <2 x i32> zeroinitializer, i1 false, float {bias_value}, float 0.0, i32 0)
+  %rgba = extractvalue {{ <4 x float>, i8 }} %sample, 0
+  ret <4 x float> %rgba
+}}
+declare {{ <4 x float>, i8 }} @air.sample_texture_{dimension}.v4f32(ptr addrspace(1), ptr addrspace(2), <2 x float>,{layer_type} i1, <2 x i32>, i1, float, float, i32)
+declare i32 @air.convert.u.i32.f.f32(float)
+!air.fragment = !{{!0}}
+!0 = !{{ptr @fragment, !1, !2}}
+!1 = !{{!5}}
+!2 = !{{!3, !4}}
+!3 = !{{i32 0, !"air.indirect_buffer", !"air.location_index", i32 3, i32 1, !"air.read", !"air.address_space", i32 2, !"air.arg_type_name", !"Args"}}
+!4 = !{{i32 1, !"air.position", !"air.center", !"air.no_perspective", !"air.arg_type_name", !"float4"}}
+!5 = !{{!"air.render_target", i32 0, i32 0, !"air.arg_type_name", !"float4"}}
+"#
+    )
+}
+
+#[test]
+fn nonuniform_implicit_samples_compute_spatial_gradients_before_resource_selection() {
+    for (arrayed, bias) in [(false, false), (false, true), (true, false), (true, true)] {
+        let directory = std::env::temp_dir().join(format!(
+            "argument-implicit-lod-{}-{arrayed}-{bias}",
+            std::process::id()
+        ));
+        std::fs::create_dir_all(&directory).unwrap();
+        let (spv, reflection) = translate_sanitized_native_reflected_unvalidated(
+            &fragment(arrayed, bias),
+            Stage::Fragment,
+            &directory,
+            TransformOptions::default(),
+            None,
+        )
+        .unwrap_or_else(|error| panic!("arrayed={arrayed} bias={bias}: {error}"));
+        reflection.validate_descriptor_abi().unwrap();
+        metal2vulkan::tools::spirv_val_bytes(&spv, &directory).unwrap();
+        let assembly = metal2vulkan::disassemble(&spv).unwrap();
+        assert!(!assembly.contains("OpImageSampleImplicitLod"), "{assembly}");
+        let lines = assembly
+            .lines()
+            .map(|line| line.split_whitespace().collect::<Vec<_>>())
+            .collect::<Vec<_>>();
+        let float = lines
+            .iter()
+            .find(|line| line.get(2) == Some(&"OpTypeFloat") && line.get(3) == Some(&"32"))
+            .unwrap()[0];
+        let float2 = lines
+            .iter()
+            .find(|line| {
+                line.get(2) == Some(&"OpTypeVector")
+                    && line.get(3) == Some(&float)
+                    && line.get(4) == Some(&"2")
+            })
+            .unwrap()[0];
+        for derivative in ["OpDPdx", "OpDPdy"] {
+            assert!(
+                lines
+                    .iter()
+                    .any(|line| line.get(2) == Some(&derivative) && line.get(3) == Some(&float2)),
+                "{assembly}"
+            );
+        }
+        assert!(
+            assembly
+                .lines()
+                .any(|line| line.contains("OpImageSampleExplicitLod") && line.contains("Grad")),
+            "{assembly}"
+        );
+        if bias {
+            assert!(assembly.contains("FClamp"), "{assembly}");
+            assert!(assembly.contains("Exp2"), "{assembly}");
+        }
+        std::fs::remove_dir_all(directory).unwrap();
+    }
+}
