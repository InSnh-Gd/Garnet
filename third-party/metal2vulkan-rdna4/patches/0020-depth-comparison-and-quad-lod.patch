new file mode 100644
--- /dev/null
+++ b/tests/runtime_depth_comparison.rs
@@ -0,0 +1,146 @@
+use metal2vulkan::passes::Stage;
+
+const KERNEL: &str = r#"
+target triple = "spirv-unknown-vulkan1.2"
+define void @k(ptr addrspace(1) %depth, ptr addrspace(2) %sampler, ptr addrspace(1) %out) {
+entry:
+  %reference = load float, ptr addrspace(1) %out, align 4
+  %sample = call { float, i8 } @air.sample_compare_depth_2d.f32(ptr addrspace(1) %depth, ptr addrspace(2) %sampler, i32 0, <2 x float> <float 2.500000e-01, float 7.500000e-01>, float %reference, i1 true, <2 x i32> zeroinitializer, i1 true, float 0.000000e+00, float 0.000000e+00, i32 0)
+  %value = extractvalue { float, i8 } %sample, 0
+  store float %value, ptr addrspace(1) %out, align 4
+  ret void
+}
+declare { float, i8 } @air.sample_compare_depth_2d.f32(ptr addrspace(1), ptr addrspace(2), i32, <2 x float>, float, i1, <2 x i32>, i1, float, float, i32)
+!air.kernel = !{!0}
+!0 = !{ptr @k, !1, !2}
+!1 = !{}
+!2 = !{!3, !4, !5}
+!3 = !{i32 0, !"air.texture", !"air.location_index", i32 0, i32 1, !"air.sample", !"air.arg_type_name", !"depth2d<float, sample>"}
+!4 = !{i32 1, !"air.sampler", !"air.location_index", i32 0, i32 1}
+!5 = !{i32 2, !"air.buffer", !"air.location_index", i32 0, i32 1, !"air.read_write", !"air.address_space", i32 1, !"air.arg_type_size", i32 4, !"air.arg_type_align_size", i32 4, !"air.arg_type_name", !"float*"}
+"#;
+
+#[test]
+fn runtime_depth_comparison_uses_the_sampler_instead_of_guessing_its_compare_function() {
+    let tmp = std::env::temp_dir().join(format!("runtime-depth-compare-{}", std::process::id()));
+    std::fs::create_dir_all(&tmp).unwrap();
+    let spv = metal2vulkan::translate_sanitized_native(KERNEL, Stage::Kernel, &tmp)
+        .expect("runtime comparison sampler");
+    let asm = metal2vulkan::disassemble(&spv).unwrap();
+    assert_eq!(
+        asm.matches("OpImageSampleDrefExplicitLod").count(),
+        1,
+        "{asm}"
+    );
+    assert!(!asm.contains("OpImageSampleExplicitLod"), "{asm}");
+    assert!(!asm.contains("OpFOrd"), "{asm}");
+    assert!(
+        asm.lines()
+            .any(|line| line.contains("OpTypeImage") && line.contains(" 2D 1 0 0 1 ")),
+        "{asm}"
+    );
+    metal2vulkan::tools::spirv_val_bytes(&spv, &tmp).unwrap();
+    std::fs::remove_dir_all(tmp).unwrap();
+}
+
+fn depth_graph(arrayed: bool, gather: bool) -> String {
+    let dimension = if arrayed { "2d_array" } else { "2d" };
+    let family = if gather {
+        "gather_compare"
+    } else {
+        "sample_compare"
+    };
+    let result = if gather { "<4 x float>" } else { "float" };
+    let layer = if arrayed { " i32 1," } else { "" };
+    let layer_type = if arrayed { " i32," } else { "" };
+    let tail = if gather {
+        ""
+    } else {
+        ", i1 true, float 0.0, float 0.0"
+    };
+    let tail_type = if gather { "" } else { ", i1, float, float" };
+    let output = if gather {
+        "%red = extractelement <4 x float> %value, i32 0"
+    } else {
+        "%red = fadd float %value, 0.0"
+    };
+    format!(
+        r#"
+target triple = "air64-apple-macosx"
+%Root = type {{ ptr addrspace(2) }}
+%Record = type {{ [2 x ptr addrspace(1)], ptr addrspace(2) }}
+define void @depth_graph(ptr addrspace(2) %args, ptr addrspace(1) %out, i32 %i) {{
+entry:
+  %slot = getelementptr %Root, ptr addrspace(2) %args, i64 0, i32 0
+  %base = load ptr addrspace(2), ptr addrspace(2) %slot, align 8
+  %group32 = and i32 %i, 1
+  %group = zext i32 %group32 to i64
+  %image_slot = getelementptr %Record, ptr addrspace(2) %base, i64 %group, i32 0, i64 1
+  %sampler_slot = getelementptr %Record, ptr addrspace(2) %base, i64 %group, i32 1
+  %image = load ptr addrspace(1), ptr addrspace(2) %image_slot, align 8
+  %sampler = load ptr addrspace(2), ptr addrspace(2) %sampler_slot, align 8
+  %reference = load float, ptr addrspace(1) %out, align 4
+  %sample = call {{ {result}, i8 }} @air.{family}_depth_{dimension}.f32(ptr addrspace(1) %image, ptr addrspace(2) %sampler, i32 0, <2 x float> <float 0.25, float 0.75>,{layer} float %reference, i1 true, <2 x i32> zeroinitializer{tail}, i32 0)
+  %value = extractvalue {{ {result}, i8 }} %sample, 0
+  {output}
+  store float %red, ptr addrspace(1) %out, align 4
+  ret void
+}}
+declare {{ {result}, i8 }} @air.{family}_depth_{dimension}.f32(ptr addrspace(1), ptr addrspace(2), i32, <2 x float>,{layer_type} float, i1, <2 x i32>{tail_type}, i32)
+!air.kernel = !{{!0}}
+!0 = !{{ptr @depth_graph, !1, !2}}
+!1 = !{{}}
+!2 = !{{!3, !4, !5}}
+!3 = !{{i32 0, !"air.indirect_buffer", !"air.location_index", i32 3, i32 1, !"air.read", !"air.address_space", i32 2, !"air.arg_type_name", !"Root"}}
+!4 = !{{i32 1, !"air.buffer", !"air.location_index", i32 0, i32 1, !"air.read_write", !"air.address_space", i32 1, !"air.arg_type_name", !"float"}}
+!5 = !{{i32 2, !"air.thread_position_in_grid", !"air.arg_type_name", !"uint"}}
+"#
+    )
+}
+
+#[test]
+fn nested_depth_tokens_keep_depth_views_and_shape_correct_null_descriptors() {
+    for (arrayed, gather) in [(false, false), (false, true), (true, false), (true, true)] {
+        let tmp = std::env::temp_dir().join(format!(
+            "depth-graph-{}-{arrayed}-{gather}",
+            std::process::id()
+        ));
+        std::fs::create_dir_all(&tmp).unwrap();
+        let (spv, reflection) = metal2vulkan::translate_sanitized_native_reflected_unvalidated(
+            &depth_graph(arrayed, gather),
+            Stage::Kernel,
+            &tmp,
+            Default::default(),
+            None,
+        )
+        .unwrap_or_else(|error| panic!("arrayed={arrayed} gather={gather}: {error}"));
+        reflection.validate_descriptor_abi().unwrap();
+        metal2vulkan::tools::spirv_val_bytes(&spv, &tmp).unwrap();
+        let asm = metal2vulkan::disassemble(&spv).unwrap();
+        let shape = format!(" 2D 1 {} 0 1 ", u32::from(arrayed));
+        assert!(
+            asm.lines()
+                .any(|line| line.contains("OpTypeImage") && line.contains(&shape)),
+            "{asm}"
+        );
+        assert!(
+            asm.contains(if gather {
+                "OpImageDrefGather"
+            } else {
+                "OpImageSampleDrefExplicitLod"
+            }),
+            "{asm}"
+        );
+        assert!(
+            asm.contains("DescriptorSet 2") && asm.contains("OpConvertUToPtr"),
+            "{asm}"
+        );
+        let shape_index = format!(" {}", 10 + u32::from(arrayed));
+        assert!(
+            asm.lines()
+                .any(|line| line.contains("OpConstant ") && line.ends_with(&shape_index)),
+            "depth null descriptor shape missing: {asm}"
+        );
+        std::fs::remove_dir_all(tmp).unwrap();
+    }
+}
