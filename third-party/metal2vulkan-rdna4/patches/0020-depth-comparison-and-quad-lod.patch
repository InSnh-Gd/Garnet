@@ -0,0 +1,217 @@
+//! Compute derivatives before the backend serializes nonuniform image/sampler selection.
+
+use super::*;
+use spirv::{Decoration, ExecutionModel, GlslStd450Op, ImageOperands};
+
+pub(in crate::passes) fn lower_argument_implicit_lod(ctx: &mut Ctx) -> Result<(), String> {
+    if !ctx.module.entry_points.iter().any(|entry| {
+        entry.operands.first() == Some(&Operand::ExecutionModel(ExecutionModel::Fragment))
+    }) {
+        return Ok(());
+    }
+    let mut sets = HashMap::new();
+    let mut bindings = HashMap::new();
+    let mut nonuniform = HashSet::new();
+    for annotation in &ctx.module.annotations {
+        match annotation.operands.as_slice() {
+            [Operand::IdRef(id), Operand::Decoration(Decoration::DescriptorSet), Operand::LiteralBit32(set)] =>
+            {
+                sets.insert(*id, *set);
+            }
+            [Operand::IdRef(id), Operand::Decoration(Decoration::Binding), Operand::LiteralBit32(binding)] =>
+            {
+                bindings.insert(*id, *binding);
+            }
+            [Operand::IdRef(id), Operand::Decoration(Decoration::NonUniform)] => {
+                nonuniform.insert(*id);
+            }
+            _ => {}
+        }
+    }
+    let Some(table) = bindings.iter().find_map(|(&id, &binding)| {
+        (binding == gpu_arguments::ARGUMENT_RESOURCE_TABLE_BINDING && sets.get(&id) == Some(&0))
+            .then_some(id)
+    }) else {
+        return Ok(());
+    };
+    let defs = ctx
+        .module
+        .all_inst_iter()
+        .chain(ctx.new_globals.iter())
+        .filter_map(|inst| inst.result_id.map(|id| (id, inst.clone())))
+        .collect::<HashMap<_, _>>();
+    for function in 0..ctx.module.functions.len() {
+        for block in 0..ctx.module.functions[function].blocks.len() {
+            let original = ctx.module.functions[function].blocks[block]
+                .instructions
+                .clone();
+            let mut body = Vec::with_capacity(original.len());
+            for mut inst in original {
+                let (opcode, operands) = match inst.class.opcode {
+                    Op::ImageSampleImplicitLod => (Op::ImageSampleExplicitLod, 2),
+                    Op::ImageSampleDrefImplicitLod => (Op::ImageSampleDrefExplicitLod, 3),
+                    _ => {
+                        body.push(inst);
+                        continue;
+                    }
+                };
+                let Some(Operand::IdRef(sampled)) = inst.operands.first() else {
+                    return Err("implicit image sample has no sampled image".into());
+                };
+                if !nonuniform.contains(sampled) {
+                    body.push(inst);
+                    continue;
+                }
+                let image = defs
+                    .get(sampled)
+                    .and_then(|value| value.result_type)
+                    .and_then(|ty| defs.get(&ty))
+                    .filter(|ty| ty.class.opcode == Op::TypeSampledImage)
+                    .and_then(|ty| ty.operands.first())
+                    .and_then(|operand| match operand {
+                        Operand::IdRef(id) => defs.get(id),
+                        _ => None,
+                    })
+                    .ok_or("nonuniform sample has no image type")?;
+                let spatial = match image.operands.get(1) {
+                    Some(Operand::Dim(Dim::Dim1D)) => 1,
+                    Some(Operand::Dim(Dim::Dim2D)) => 2,
+                    Some(Operand::Dim(Dim::Dim3D | Dim::DimCube)) => 3,
+                    _ => {
+                        return Err(
+                            "implicit argument sampling has an unsupported image dimension".into(),
+                        )
+                    }
+                };
+                let Some(Operand::IdRef(coord)) = inst.operands.get(1) else {
+                    return Err("implicit argument sample has no coordinate".into());
+                };
+                let coord = *coord;
+                let coord_type = defs
+                    .get(&coord)
+                    .and_then(|value| value.result_type)
+                    .ok_or("implicit argument sample coordinate has no type")?;
+                let gradient_type = if spatial == 1 {
+                    ctx.ty_float()
+                } else {
+                    ctx.ty_vecf(spatial)
+                };
+                let gradient_coord = if coord_type == gradient_type {
+                    coord
+                } else {
+                    let id = ctx.module.fresh_id();
+                    let (op, args) = if spatial == 1 {
+                        (
+                            Op::CompositeExtract,
+                            vec![Operand::IdRef(coord), Operand::LiteralBit32(0)],
+                        )
+                    } else {
+                        let mut args = vec![Operand::IdRef(coord), Operand::IdRef(coord)];
+                        args.extend((0..spatial).map(Operand::LiteralBit32));
+                        (Op::VectorShuffle, args)
+                    };
+                    body.push(Instruction::new(op, Some(gradient_type), Some(id), args));
+                    id
+                };
+                let mut gradients = [0; 2];
+                for (gradient, op) in gradients.iter_mut().zip([Op::DPdx, Op::DPdy]) {
+                    *gradient = ctx.module.fresh_id();
+                    body.push(Instruction::new(
+                        op,
+                        Some(gradient_type),
+                        Some(*gradient),
+                        vec![Operand::IdRef(gradient_coord)],
+                    ));
+                }
+                let (mut mask, mut trailing) = match inst.operands.get(operands) {
+                    None => (ImageOperands::empty(), Vec::new()),
+                    Some(Operand::ImageOperands(mask)) => {
+                        (*mask, inst.operands[operands + 1..].to_vec())
+                    }
+                    _ => return Err("implicit argument sample has invalid image operands".into()),
+                };
+                if mask.intersects(ImageOperands::LOD | ImageOperands::GRAD) {
+                    return Err(
+                        "implicit argument sample unexpectedly names a level or gradient".into(),
+                    );
+                }
+                if mask.contains(ImageOperands::BIAS) {
+                    let Some(Operand::IdRef(bias)) = trailing.first().cloned() else {
+                        return Err("implicit argument sample has no bias operand".into());
+                    };
+                    trailing.remove(0);
+                    mask.remove(ImageOperands::BIAS);
+                    // ABI 6 stores the actual Vulkan bias limit after the three offset/count pairs.
+                    let uint = ctx.ty_uint();
+                    let pointer = ctx.ty_ptr(StorageClass::StorageBuffer, uint);
+                    let zero = ctx.const_uint(0);
+                    let slot = ctx.const_uint(6);
+                    let bits =
+                        gpu_arguments::load_word(ctx, &mut body, table, pointer, uint, zero, slot);
+                    let float = ctx.ty_float();
+                    let limit = gpu_arguments::value(
+                        ctx,
+                        &mut body,
+                        Op::Bitcast,
+                        float,
+                        vec![Operand::IdRef(bits)],
+                    );
+                    let negative = gpu_arguments::value(
+                        ctx,
+                        &mut body,
+                        Op::FNegate,
+                        float,
+                        vec![Operand::IdRef(limit)],
+                    );
+                    let glsl = ctx.glsl();
+                    let bias = gpu_arguments::value(
+                        ctx,
+                        &mut body,
+                        Op::ExtInst,
+                        float,
+                        vec![
+                            Operand::IdRef(glsl),
+                            Operand::LiteralExtInstInteger(GlslStd450Op::FClamp as u32),
+                            Operand::IdRef(bias),
+                            Operand::IdRef(negative),
+                            Operand::IdRef(limit),
+                        ],
+                    );
+                    let scale = gpu_arguments::value(
+                        ctx,
+                        &mut body,
+                        Op::ExtInst,
+                        float,
+                        vec![
+                            Operand::IdRef(glsl),
+                            Operand::LiteralExtInstInteger(GlslStd450Op::Exp2 as u32),
+                            Operand::IdRef(bias),
+                        ],
+                    );
+                    for gradient in &mut gradients {
+                        *gradient = gpu_arguments::value(
+                            ctx,
+                            &mut body,
+                            if spatial == 1 {
+                                Op::FMul
+                            } else {
+                                Op::VectorTimesScalar
+                            },
+                            gradient_type,
+                            vec![Operand::IdRef(*gradient), Operand::IdRef(scale)],
+                        );
+                    }
+                }
+                mask.insert(ImageOperands::GRAD);
+                inst.class.opcode = opcode;
+                inst.operands.truncate(operands);
+                inst.operands.push(Operand::ImageOperands(mask));
+                inst.operands.extend(gradients.map(Operand::IdRef));
+                inst.operands.extend(trailing);
+                body.push(inst);
+            }
+            ctx.module.functions[function].blocks[block].instructions = body;
+        }
+    }
+    Ok(())
+}
