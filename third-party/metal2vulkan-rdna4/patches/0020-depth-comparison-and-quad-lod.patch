+/// Lower `air.gather_compare_depth_2d[_array].f32`: gather four depth comparisons around the
+/// coordinate.
+///
+/// The non-array AIR ABI observed in real fragment AIR is
+/// `(texture, sampler, i32 control, coord, compare_reference, i1, offset, i32 flags)`. Keep the
+/// comparison in Vulkan: `OpImageDrefGather` consumes the sampler's runtime comparison state and
+/// returns the four comparison results in the same shape as Metal's `gather_compare`. This is
+/// uses the same runtime comparison state as the scalar Dref `sample_compare` path.
+///
+/// The image type carries `Depth=1`, derived from the AIR `depth2d...` type name. Although
+/// `OpImageDrefGather` also validates against a `Depth=0` image type, the runtime derives the shape
+/// of a null descriptor from that operand. A null depth descriptor built as a color image therefore
+/// selects the wrong image format/view and cannot be bound as the depth texture the call describes.
+pub(in crate::passes) fn lower_gather_compare_depth(
+    ctx: &mut Ctx,
+    name: &str,
+    res: Option<Word>,
+    rty: Option<Word>,
+    args: &[Word],
+    v4: Word,
+) -> Result<Vec<Instruction>, String> {
+    let (res, rty) = match (res, rty) {
+        (Some(r), Some(t)) => (r, t),
+        _ => return Err("air.gather_compare_depth has no result".into()),
+    };
+    let array_form = name.starts_with("air.gather_compare_depth_2d_array.");
+    let minimum_args = if array_form { 9 } else { 8 };
+    if args.len() < minimum_args {
+        return Err(
+            "air.gather_compare_depth missing texture/sampler/coord/reference/offset".into(),
+        );
+    }
+
+    let samp = args[1];
+    let coord = args[3];
+    // Real 2D-array AIR inserts the layer between the spatial coordinate and the reference:
+    // `(texture, sampler, control, coord, layer, reference, i1, offset, flags)`.
+    let (layer, reference, offset) = if array_form {
+        (Some(args[4]), args[5], args[7])
+    } else {
+        (None, args[4], args[6])
+    };
+    let mut img = resolve_image_value(ctx, args[0]);
+    if texture_operand_is_absent(ctx, img) {
+        if let Some(sampled_img) =
+            recovered_image_for_private_operand(ctx, img, name, ImageOperandUse::Sampled)
+        {
+            img = sampled_img;
+        } else {
+            return lower_null_texture_result(ctx, res, rty);
+        }
+    }
+
+    let mut out = vec![];
+    img = load_image_if_pointer(ctx, img, &mut out);
+    let (fallback_dim, fallback_arrayed, fallback_comp) = image_shape_or_recorded(ctx, img);
+    let (img_ty, dim, arrayed, comp) =
+        sampled_operand_image_info(ctx, img, fallback_dim, fallback_arrayed, fallback_comp);
+    if comp != crate::passes::ImageComp::Float {
+        return Err("air.gather_compare_depth on non-float texture".into());
+    }
+    if dim != Dim::Dim2D || arrayed != array_form {
+        return Err("air.gather_compare_depth requires a matching 2D texture shape".into());
+    }
+
+    let sampler_state = ctx.sampler_states.get(&samp).copied();
+    if sampler_state.is_some_and(|state| state.uses_pixel_coordinates()) {
+        return Err(
+            "air.gather_compare_depth with pixel-coordinate samplers is not supported".into(),
+        );
+    }
+    if sampler_state
+        .is_some_and(|state| state.compare_function == crate::reflect::SamplerCompareFunction::None)
+    {
+        return Err("air.gather_compare_depth requires a sampler with comparison enabled".into());
+    }
+
+    let mut coord_for_gather = build_gather_coord_2d(ctx, array_form, coord, layer, &mut out)?;
+    let (const_offset, dynamic_offset) = gather_const_or_dynamic_offset(ctx, offset)?;
+    if let Some(offset) = dynamic_offset {
+        coord_for_gather = apply_dynamic_sample_offset(
+            ctx,
+            img,
+            array_form,
+            coord_for_gather,
+            offset,
+            2,
+            &mut out,
+        )?;
+    }
+
+    let si_ty = ctx.ty_sampled_image(img_ty);
+    let valid_sampler = valid_sampler_value(ctx, samp, &mut out)?;
+    let si = ctx.module.fresh_id();
+    out.push(Instruction::new(
+        Op::SampledImage,
+        Some(si_ty),
+        Some(si),
+        vec![Operand::IdRef(img), Operand::IdRef(valid_sampler)],
+    ));
+
+    let color = ctx.module.fresh_id();
+    let mut ops = vec![
+        Operand::IdRef(si),
+        Operand::IdRef(coord_for_gather),
+        Operand::IdRef(reference),
+    ];
+    if let Some(offset) = const_offset {
+        if offset != [0, 0] {
+            ops.push(Operand::ImageOperands(spirv::ImageOperands::CONST_OFFSET));
+            ops.push(Operand::IdRef(const_sint_vec(ctx, &offset)));
+        }
+    }
+    out.push(Instruction::new(
+        Op::ImageDrefGather,
+        Some(v4),
+        Some(color),
+        ops,
+    ));
+
+    finish_sample_result(ctx, res, rty, color, v4, out)
+}
