+/// Whether `value` is a scalar integer constant of exactly zero.
+pub(in crate::passes) fn integer_operand_is_constant_zero(ctx: &Ctx, value: Word) -> bool {
+    let Some(def) = value_def_instruction(ctx, value) else {
+        return false;
+    };
+    let Some(ty) = def.result_type else {
+        return false;
+    };
+    if type_def_of(ctx, ty).is_none_or(|ty| ty.class.opcode != Op::TypeInt) {
+        return false;
+    }
+    match def.class.opcode {
+        Op::ConstantNull => true,
+        Op::Constant => matches!(
+            def.operands.first(),
+            Some(Operand::LiteralBit32(0) | Operand::LiteralBit64(0))
+        ),
+        _ => false,
+    }
+}
