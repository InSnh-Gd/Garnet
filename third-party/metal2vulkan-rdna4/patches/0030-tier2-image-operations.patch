+fn indirect(source: &str) -> Result<(Vec<u8>, Vec<u8>), String> {
+    let (spv, metadata) = garnetxlate::translate_bytes(source.as_bytes(), [8, 1, 1])?;
+    garnetxlate::lower_gpu_arguments(&spv, &metadata)
+}
