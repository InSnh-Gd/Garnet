diff --git a/src/passes/resources/gpu_argument_graph.rs b/src/passes/resources/gpu_argument_graph.rs
new file mode 100644
--- /dev/null
+++ b/src/passes/resources/gpu_argument_graph.rs
@@ -0,0 +1,232 @@
+//! Resource handles reached through affine record indexing or device-address pointers.
+
+use super::gpu_arguments::{lookup_function, raw_buffer, value};
+use super::*;
+use crate::meta::{EmbeddedSampler, EmbeddedTexture};
+use spirv::Capability;
+use std::collections::BTreeMap;
+
+/// Keep the static ABI when every token has a representable root/field coordinate. Otherwise
+/// consume the emitter's actual token words, so nested addresses are evaluated on the GPU.
+pub(in crate::passes) fn lower_argument_resource_graph(
+    ctx: &mut Ctx,
+    entry: usize,
+    textures: &[EmbeddedTexture],
+    samplers: &[EmbeddedSampler],
+) -> Result<bool, String> {
+    let mut payloads = ctx
+        .emit_sidecar
+        .opaque_resource_payloads
+        .iter()
+        .map(|fact| (fact.id, (fact.low, fact.high)))
+        .collect::<HashMap<_, _>>();
+    if payloads.is_empty() {
+        return Ok(false);
+    }
+    let mut covered = HashSet::new();
+    for (param, offset, length) in textures
+        .iter()
+        .map(|field| {
+            (
+                field.buffer_param_index,
+                field.field_offset,
+                field.array_length.unwrap_or(1),
+            )
+        })
+        .chain(samplers.iter().map(|field| {
+            (
+                field.buffer_param_index,
+                field.field_offset,
+                field.array_length.unwrap_or(1),
+            )
+        }))
+    {
+        let Some(root) = ctx.module.functions[entry]
+            .parameters
+            .get(param as usize)
+            .and_then(|p| p.result_id)
+        else {
+            continue;
+        };
+        let start = u64::from(offset);
+        let end = start + u64::from(length) * 8;
+        covered.extend(
+            ctx.emit_sidecar
+                .buffer_pointer_field_loads
+                .iter()
+                .filter(|fact| {
+                    fact.root == root
+                        && fact.byte_offset >= start
+                        && fact.byte_offset < end
+                        && (fact.byte_offset - start) % 8 == 0
+                })
+                .map(|fact| fact.id),
+        );
+        covered.extend(
+            ctx.emit_sidecar
+                .buffer_pointer_dynamic_field_loads
+                .iter()
+                .filter(|fact| fact.root == root && fact.byte_offset == start)
+                .map(|fact| fact.id),
+        );
+    }
+    let copies = ctx.module.functions[entry]
+        .blocks
+        .iter()
+        .flat_map(|block| &block.instructions)
+        .filter(|inst| matches!(inst.class.opcode, Op::CopyObject | Op::Bitcast))
+        .filter_map(|inst| match (inst.result_id, inst.operands.first()) {
+            (Some(id), Some(Operand::IdRef(source))) => Some((id, *source)),
+            _ => None,
+        })
+        .collect::<Vec<_>>();
+    loop {
+        let before = (payloads.len(), covered.len());
+        for &(id, source) in &copies {
+            if let Some(&words) = payloads.get(&source) {
+                payloads.entry(id).or_insert(words);
+            }
+            if let Some(&words) = payloads.get(&id) {
+                payloads.entry(source).or_insert(words);
+            }
+            if covered.contains(&source) {
+                covered.insert(id);
+            }
+            if covered.contains(&id) {
+                covered.insert(source);
+            }
+        }
+        if before == (payloads.len(), covered.len()) {
+            break;
+        }
+    }
+    let names = air_names(&ctx.module);
+    let needs_graph = ctx.module.functions[entry].blocks.iter().flat_map(|block| &block.instructions)
+        .filter(|inst| inst.class.opcode == Op::FunctionCall)
+        .filter(|inst| matches!(inst.operands.first(), Some(Operand::IdRef(callee)) if names.get(callee).is_some_and(|name| name.starts_with("air.") && (name.contains("_texture_") || name.contains("_depth_")))))
+        .any(|inst| inst.operands.iter().skip(1).take(2).any(|operand|
+            matches!(operand, Operand::IdRef(id) if payloads.contains_key(id) && !covered.contains(id))));
+    if !needs_graph {
+        return Ok(false);
+    }
+    if ctx.descriptor_layout != crate::reflect::DescriptorLayout::default() {
+        return Err("GPU argument graphs require the default stage descriptor ABI".into());
+    }
+    let table = raw_buffer(ctx, super::gpu_arguments::ARGUMENT_RESOURCE_TABLE_BINDING);
+    ctx.interface_buffer_var(table);
+    let lookup = lookup_function(ctx, table);
+    let uint = ctx.ty_uint();
+    let mut globals = BTreeMap::new();
+    for block in 0..ctx.module.functions[entry].blocks.len() {
+        let instructions = ctx.module.functions[entry].blocks[block]
+            .instructions
+            .clone();
+        let mut body = Vec::with_capacity(instructions.len());
+        for mut inst in instructions {
+            let name = match (inst.class.opcode, inst.operands.first()) {
+                (Op::FunctionCall, Some(Operand::IdRef(callee))) => names.get(callee),
+                _ => None,
+            };
+            if let Some(name) = name {
+                for position in 1..=2 {
+                    let Some(Operand::IdRef(handle)) = inst.operands.get(position) else {
+                        continue;
+                    };
+                    let Some(&(low, high)) = payloads.get(handle) else {
+                        continue;
+                    };
+                    if !(name.starts_with("air.sample_") || name.starts_with("air.gather_")) {
+                        if name.contains("_texture_") || name.contains("_depth_") {
+                            return Err(format!("GPU argument graph does not yet model {name}"));
+                        }
+                        continue;
+                    }
+                    let (category, element, shape) = if position == 2 {
+                        (2, ctx.ty_sampler(), None)
+                    } else {
+                        let (dim, arrayed) = super::super::air_calls::intrinsic_texture_shape(name)
+                            .ok_or("GPU argument texture intrinsic has no known shape")?;
+                        if dim == Dim::DimBuffer {
+                            return Err("GPU argument graph texel buffers are unsupported".into());
+                        }
+                        let component = name
+                            .rsplit('.')
+                            .next()
+                            .ok_or("missing image component type")?;
+                        let comp = match component {
+                            "v4f16" | "v4f32" | "f16" | "f32" => ImageComp::Float,
+                            "v4i16" | "v4i32" | "i16" | "i32" => {
+                                if name.split('.').any(|part| part == "u") {
+                                    ImageComp::Uint
+                                } else {
+                                    ImageComp::Sint
+                                }
+                            }
+                            _ => {
+                                return Err(format!(
+                                    "unknown GPU argument image component in {name}"
+                                ))
+                            }
+                        };
+                        (
+                            0,
+                            ctx.ty_image(dim, arrayed, comp),
+                            Some((dim, arrayed, comp)),
+                        )
+                    };
+                    let global = *globals.entry((category, element)).or_insert_with(|| {
+                        let array = ctx.ty_runtime_array(element);
+                        let pointer = ctx.ty_ptr(StorageClass::UniformConstant, array);
+                        let global = ctx.module.fresh_id();
+                        ctx.new_globals.push(Instruction::new(
+                            Op::Variable,
+                            Some(pointer),
+                            Some(global),
+                            vec![Operand::StorageClass(StorageClass::UniformConstant)],
+                        ));
+                        decorate_binding(&mut ctx.module, global, 2 + category, 0);
+                        ctx.interface_buffer_var(global);
+                        global
+                    });
+                    let category = ctx.const_uint(category);
+                    let index = value(
+                        ctx,
+                        &mut body,
+                        Op::FunctionCall,
+                        uint,
+                        vec![
+                            Operand::IdRef(lookup),
+                            Operand::IdRef(low),
+                            Operand::IdRef(high),
+                            Operand::IdRef(category),
+                        ],
+                    );
+                    let pointer_ty = ctx.ty_ptr(StorageClass::UniformConstant, element);
+                    let pointer = value(
+                        ctx,
+                        &mut body,
+                        Op::AccessChain,
+                        pointer_ty,
+                        vec![Operand::IdRef(global), Operand::IdRef(index)],
+                    );
+                    let loaded = value(
+                        ctx,
+                        &mut body,
+                        Op::Load,
+                        element,
+                        vec![Operand::IdRef(pointer)],
+                    );
+                    if let Some((dim, arrayed, comp)) = shape {
+                        ctx.image_dims.insert(loaded, (dim, arrayed));
+                        ctx.image_comp.insert(loaded, comp);
+                    }
+                    inst.operands[position] = Operand::IdRef(loaded);
+                }
+            }
+            body.push(inst);
+        }
+        ctx.module.functions[entry].blocks[block].instructions = body;
+    }
+    ctx.add_capability(Capability::RuntimeDescriptorArray);
+    Ok(true)
+}
