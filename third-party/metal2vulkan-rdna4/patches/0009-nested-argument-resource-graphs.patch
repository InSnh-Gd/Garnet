new file mode 100644
--- /dev/null
+++ b/tests/argument_buffer_graph.rs
@@ -0,0 +1,130 @@
+//! Authored dynamic record and pointer graphs, independent of captured AIR.
+use metal2vulkan::{
+    passes::{Stage, TransformOptions},
+    translate_sanitized_native_reflected_unvalidated,
+};
+
+fn source(indirect: bool) -> String {
+    let root = if indirect {
+        "%Root = type { ptr addrspace(2) }"
+    } else {
+        "%Root = type { [2 x %Record] }"
+    };
+    let access = if indirect {
+        "%slot = getelementptr %Root, ptr addrspace(2) %args, i64 0, i32 0\n  %base = load ptr addrspace(2), ptr addrspace(2) %slot, align 8\n  %image_slot = getelementptr %Record, ptr addrspace(2) %base, i64 %group, i32 0, i64 %index\n  %sampler_slot = getelementptr %Record, ptr addrspace(2) %base, i64 %group, i32 1"
+    } else {
+        "%image_slot = getelementptr %Root, ptr addrspace(2) %args, i64 0, i32 0, i64 %group, i32 0, i64 %index\n  %sampler_slot = getelementptr %Root, ptr addrspace(2) %args, i64 0, i32 0, i64 %group, i32 1"
+    };
+    format!(
+        r#"target triple = "air64-apple-macosx"
+{root}
+%Record = type {{ [2 x ptr addrspace(1)], ptr addrspace(2) }}
+define void @graph(ptr addrspace(2) %args, ptr addrspace(1) %out, i32 %i) {{
+entry:
+  %g = lshr i32 %i, 2
+  %g1 = and i32 %g, 1
+  %group = zext i32 %g1 to i64
+  %ix = and i32 %i, 1
+  %index = zext i32 %ix to i64
+  {access}
+  %image = load ptr addrspace(1), ptr addrspace(2) %image_slot, align 8
+  %sampler = load ptr addrspace(2), ptr addrspace(2) %sampler_slot, align 8
+  %sample = call {{ <4 x float>, i8 }} @air.sample_texture_2d.v4f32(ptr addrspace(1) %image, ptr addrspace(2) %sampler, <2 x float> zeroinitializer, i1 true, <2 x i32> zeroinitializer, i1 false, float 0.0, float 0.0, i32 0)
+  %rgba = extractvalue {{ <4 x float>, i8 }} %sample, 0
+  %red = extractelement <4 x float> %rgba, i32 0
+  store float %red, ptr addrspace(1) %out, align 4
+  ret void
+}}
+declare {{ <4 x float>, i8 }} @air.sample_texture_2d.v4f32(ptr addrspace(1), ptr addrspace(2), <2 x float>, i1, <2 x i32>, i1, float, float, i32)
+!air.kernel = !{{!0}}
+!0 = !{{ptr @graph, !1, !2}}
+!1 = !{{}}
+!2 = !{{!3, !4, !5}}
+!3 = !{{i32 0, !"air.indirect_buffer", !"air.location_index", i32 3, i32 1, !"air.read", !"air.address_space", i32 2, !"air.arg_type_name", !"Root"}}
+!4 = !{{i32 1, !"air.buffer", !"air.location_index", i32 0, i32 1, !"air.read_write", !"air.address_space", i32 1, !"air.arg_type_name", !"float"}}
+!5 = !{{i32 2, !"air.thread_position_in_grid", !"air.arg_type_name", !"uint"}}
+"#
+    )
+}
+
+#[test]
+fn dynamic_record_and_indirect_resource_graphs() {
+    for (indirect, helper) in [(false, false), (true, false), (false, true), (true, true)] {
+        let text = if helper {
+            source(indirect).replace("define void @graph(", "define internal void @helper(")
+                .replace("declare {", "define void @graph(ptr addrspace(2) %args, ptr addrspace(1) %out, i32 %i) {\nentry:\n  call void @helper(ptr addrspace(2) %args, ptr addrspace(1) %out, i32 %i)\n  ret void\n}\ndeclare {")
+        } else {
+            source(indirect)
+        };
+        let (spv, reflection) = translate_sanitized_native_reflected_unvalidated(
+            &text,
+            Stage::Kernel,
+            &std::env::temp_dir(),
+            TransformOptions::default(),
+            None,
+        )
+        .unwrap_or_else(|e| panic!("indirect={indirect} helper={helper}: {e}"));
+        let directory = std::env::temp_dir().join(format!(
+            "m2v-graph-{}-{indirect}-{helper}",
+            std::process::id()
+        ));
+        std::fs::create_dir_all(&directory).unwrap();
+        let path = directory.join("graph.spv");
+        std::fs::write(&path, spv).unwrap();
+        let result = std::process::Command::new("spirv-val")
+            .args(["--target-env", "vulkan1.2"])
+            .arg(&path)
+            .output()
+            .unwrap();
+        assert!(
+            result.status.success(),
+            "{}",
+            String::from_utf8_lossy(&result.stderr)
+        );
+        #[cfg(feature = "serde")]
+        {
+            let json = serde_json::to_value(&reflection).unwrap();
+            assert_eq!(json["argument_resource_tables"]["version"], 2);
+            assert_eq!(
+                json["argument_resource_tables"]["categories"],
+                serde_json::json!([0, 2])
+            );
+        }
+        reflection.validate_descriptor_abi().unwrap();
+        std::fs::remove_dir_all(directory).unwrap();
+    }
+}
+
+#[test]
+fn unknown_graph_shape_is_refused() {
+    let text = source(false).replace("sample_texture_2d", "sample_texture_7d");
+    let error = translate_sanitized_native_reflected_unvalidated(
+        &text,
+        Stage::Kernel,
+        &std::env::temp_dir(),
+        TransformOptions::default(),
+        None,
+    )
+    .unwrap_err();
+    assert!(error.contains("no known shape"), "{error}");
+}
+
+#[test]
+fn custom_layout_does_not_silently_change_the_graph_abi() {
+    let options = TransformOptions {
+        descriptor_layout: metal2vulkan::reflect::DescriptorLayout {
+            set: 1,
+            ..Default::default()
+        },
+        ..Default::default()
+    };
+    let error = translate_sanitized_native_reflected_unvalidated(
+        &source(false),
+        Stage::Kernel,
+        &std::env::temp_dir(),
+        options,
+        None,
+    )
+    .unwrap_err();
+    assert!(error.contains("default stage descriptor ABI"), "{error}");
+}
