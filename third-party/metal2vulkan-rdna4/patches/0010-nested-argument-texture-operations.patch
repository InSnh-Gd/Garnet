 use crate::meta::{EmbeddedSampler, EmbeddedTexture};
 use spirv::Capability;
 use std::collections::BTreeMap;
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+struct ImageShape {
+    dim: Dim,
+    arrayed: bool,
+    comp: ImageComp,
+    storage: bool,
+    multisampled: bool,
+}
+
+fn image_shape(
+    name: &str,
+    inst: &Instruction,
+    defs: &HashMap<Word, Instruction>,
+) -> Result<Option<ImageShape>, String> {
+    let sample = name.starts_with("air.sample_") || name.starts_with("air.gather_");
+    let read = name.starts_with("air.read_texture") || name.starts_with("air.read_depth");
+    let write = name.starts_with("air.write_texture");
+    if !(sample || read || write) {
+        return Ok(None);
+    }
+    let (dim, arrayed) = super::super::air_calls::intrinsic_texture_shape(name)
+        .ok_or("GPU argument texture intrinsic has no known shape")?;
+    if dim == Dim::DimBuffer {
+        return Err("GPU argument graph texel buffers are unsupported".into());
+    }
+    let component = name
+        .rsplit('.')
+        .next()
+        .ok_or("missing image component type")?;
+    let comp = match component {
+        "v4f16" | "v4f32" | "f16" | "f32" => ImageComp::Float,
+        "v4i16" | "v4i32" | "i16" | "i32" => {
+            if name.split('.').any(|part| part == "u") {
+                ImageComp::Uint
+            } else {
+                ImageComp::Sint
+            }
+        }
+        _ => return Err(format!("unknown GPU argument image component in {name}")),
+    };
+    let storage = if sample {
+        false
+    } else {
+        let access = inst
+            .operands
+            .last()
+            .and_then(|operand| match operand {
+                Operand::IdRef(id) => defs.get(id),
+                _ => None,
+            })
+            .filter(|def| def.class.opcode == Op::Constant)
+            .and_then(|def| match def.operands.as_slice() {
+                [Operand::LiteralBit32(value)] => Some(*value),
+                _ => None,
+            })
+            .ok_or("GPU argument image access must be a constant AIR access class")?;
+        match access {
+            1 if !write => false,
+            2 if write => true,
+            3 => true,
+            _ => {
+                return Err(format!(
+                    "invalid GPU argument image access {access} for {name}"
+                ))
+            }
+        }
+    };
+    let multisampled = name
+        .split('.')
+        .next()
+        .is_some_and(|family| family.ends_with("_ms") || family.ends_with("_ms_array"));
+    if storage && multisampled {
+        return Err("GPU argument multisampled storage images are unsupported".into());
+    }
+    Ok(Some(ImageShape {
+        dim,
+        arrayed,
+        comp,
+        storage,
+        multisampled,
+    }))
+}
 
