+/// Promote `constant` (`ptr addrspace(2)`) attached-buffer parameters of a linked intersection
+/// callback to `device` (`ptr addrspace(1)`) so they carry `PhysicalStorageBuffer` device
+/// addresses across the callback call boundary without disturbing loaded `ptr addrspace(2)`
+/// sampler handles.
+fn normalize_callback_const_buffer_params(
+    ll: &str,
+    target_global: &str,
+    const_param_indices: &HashSet<usize>,
+) -> String {
+    if const_param_indices.is_empty() || !ll.contains("addrspace(2)") {
+        return ll.to_string();
+    }
+    let mut out = String::with_capacity(ll.len());
+    let mut in_target = false;
+    let mut promoted = HashSet::<String>::new();
+    for raw_line in ll.lines() {
+        let trimmed = raw_line.trim_start();
+        if !in_target && trimmed.starts_with("define ") {
+            if definition_global(trimmed).as_deref() == Some(target_global) {
+                in_target = !trimmed.ends_with('}');
+                promoted.clear();
+                if let Some(at) = raw_line.find(target_global) {
+                    if let Some(open_rel) = raw_line[at..].find('(') {
+                        let open = at + open_rel;
+                        if let Some(close) = find_matching_paren_lf(raw_line, open) {
+                            let params_str = &raw_line[open + 1..close];
+                            let mut rewritten_params = Vec::new();
+                            for (pi, p) in split_top_level(params_str, ',').into_iter().enumerate() {
+                                if const_param_indices.contains(&pi) {
+                                    let p_trim = p.trim();
+                                    let pname = value_operand(p_trim);
+                                    if pname.starts_with('%') {
+                                        promoted.insert(pname.to_string());
+                                    }
+                                    rewritten_params.push(
+                                        p_trim.replacen("ptr addrspace(2)", "ptr addrspace(1)", 1),
+                                    );
+                                } else {
+                                    rewritten_params.push(p.trim().to_string());
+                                }
+                            }
+                            out.push_str(&raw_line[..open + 1]);
+                            out.push_str(&rewritten_params.join(", "));
+                            out.push_str(&raw_line[close..]);
+                            out.push('\n');
+                            continue;
+                        }
+                    }
+                }
+            }
+            out.push_str(raw_line);
+            out.push('\n');
+            continue;
+        }
+        if in_target {
+            if trimmed == "}" {
+                in_target = false;
+                promoted.clear();
+                out.push_str(raw_line);
+                out.push('\n');
+                continue;
+            }
+            let mut line = raw_line.to_string();
+            let mut result_promoted = false;
+            for p in promoted.clone() {
+                let needle = format!("ptr addrspace(2) {p}");
+                if line.contains(&needle) {
+                    let repl = format!("ptr addrspace(1) {p}");
+                    line = replace_typed_ptr_operand(&line, &needle, &repl);
+                    if let Some((_, rhs)) = trimmed.split_once(" = ") {
+                        if rhs.starts_with("getelementptr ")
+                            || rhs.starts_with("bitcast ")
+                            || rhs.starts_with("select ")
+                            || rhs.starts_with("phi ")
+                        {
+                            result_promoted = true;
+                        }
+                    }
+                }
+            }
+            if result_promoted {
+                if let Some((lhs, _)) = trimmed.split_once(" = ") {
+                    let res = lhs.trim();
+                    if res.starts_with('%') {
+                        promoted.insert(res.to_string());
+                    }
+                }
+            }
+            out.push_str(&line);
+            out.push('\n');
+            continue;
+        }
+        out.push_str(raw_line);
+        out.push('\n');
+    }
+    out
+}
+
+fn replace_typed_ptr_operand(line: &str, needle: &str, replacement: &str) -> String {
+    let mut out = String::with_capacity(line.len());
+    let mut rest = line;
+    while let Some(pos) = rest.find(needle) {
+        let after_idx = pos + needle.len();
+        let boundary_ok = rest[after_idx..]
+            .chars()
+            .next()
+            .is_none_or(|ch| !matches!(ch, 'a'..='z' | 'A'..='Z' | '0'..='9' | '_' | '.' | '-'));
+        out.push_str(&rest[..pos]);
+        if boundary_ok {
+            out.push_str(replacement);
+        } else {
+            out.push_str(needle);
+        }
+        rest = &rest[after_idx..];
+    }
+    out.push_str(rest);
+    out
+}
