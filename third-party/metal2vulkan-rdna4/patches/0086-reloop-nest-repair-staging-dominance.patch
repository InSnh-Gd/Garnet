+    /// definition. Demoting ONLY those staging-broken spillable values to function-scope slots
+    /// preserves the nested loop/selection structure without falling back to the flat state-machine
+    /// switch. Values that did not dominate their uses in the input graph (or have non-spillable
+    /// pointer/opaque types) are left untouched so the post-emit contract check declines safely.
+    fn repair_non_dominating_values(&mut self, entry_label: Word, graph: &Graph) {
+        let mut labels = Vec::with_capacity(self.out.len());
