+    /// A loop-exit value computed inside a loop body whose definition dominates the post-loop
+    /// trampoline in the input CFG, but loses dominance in the nested CFG once a multi-exit
+    /// loop stages exits through a merge dispatch. Selective demotion of ONLY that staging-broken
+    /// value must keep the function in genuinely nested loop form and pass `spirv-val` instead of
+    /// falling back to the flat state-machine switch.
+    const STAGED_LOOP_EXIT_VALUE: &str = r#"
+               OpCapability Shader
+               OpMemoryModel Logical GLSL450
+               OpEntryPoint GLCompute %main "main"
+               OpExecutionMode %main LocalSize 1 1 1
+       %void = OpTypeVoid
+       %uint = OpTypeInt 32 0
+       %bool = OpTypeBool
+     %uint_0 = OpConstant %uint 0
+     %uint_1 = OpConstant %uint 1
+     %uint_4 = OpConstant %uint 4
+     %uint_7 = OpConstant %uint 7
+     %fnvoid = OpTypeFunction %void
+       %main = OpFunction %void None %fnvoid
+      %entry = OpLabel
+      %skip0 = OpIEqual %bool %uint_0 %uint_1
+               OpBranchConditional %skip0 %after %loop_hdr
+   %loop_hdr = OpLabel
+          %i = OpPhi %uint %uint_0 %entry %next %latch
+        %acc = OpPhi %uint %uint_0 %entry %acc1 %latch
+        %cmp = OpULessThan %bool %i %uint_4
+               OpBranchConditional %cmp %body %exit_a
+       %body = OpLabel
+       %acc1 = OpIAdd %uint %acc %i
+       %brk  = OpIEqual %bool %i %uint_1
+               OpBranchConditional %brk %exit_b %latch
+      %latch = OpLabel
+       %next = OpIAdd %uint %i %uint_1
+               OpBranch %loop_hdr
+     %exit_a = OpLabel
+               OpBranch %after
+     %exit_b = OpLabel
+      %final = OpIAdd %uint %acc1 %uint_7
+               OpBranch %after
+      %after = OpLabel
+        %res = OpPhi %uint %uint_0 %entry %acc %exit_a %final %exit_b
+        %use = OpIAdd %uint %res %uint_1
+               OpReturn
+               OpFunctionEnd
+"#;
+
+    #[test]
+    fn staged_loop_exit_value_is_selectively_repaired_and_validates() {
+        let Some(spv) = assemble(STAGED_LOOP_EXIT_VALUE) else {
+            return;
+        };
+        let nested = nested_bytes(&spv)
+            .expect("staging-broken loop-exit value must be selectively repaired and nested");
+        assert!(validates(&nested));
+        let asm = disassemble(&nested);
+        assert!(asm.contains("OpLoopMerge"), "{asm}");
+        // Only the loop's real structure + tiny merge dispatch — never a whole-function switch.
+        assert_eq!(asm.matches("OpLoopMerge").count(), 1, "{asm}");
+        assert!(asm.matches("OpVariable").count() <= 4, "{asm}");
+    }
 }
