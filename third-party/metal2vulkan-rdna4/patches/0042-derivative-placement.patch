+#[test]
+fn supported_image_dimensions_use_only_spatial_gradient_components() {
+    for (dimension, spatial, arrayed, capability) in [
+        ("1D", 1, 0, "OpCapability Sampled1D\n"),
+        ("1D", 1, 1, "OpCapability Sampled1D\n"),
+        ("3D", 3, 0, ""),
+        ("Cube", 3, 0, ""),
+        ("Cube", 3, 1, "OpCapability SampledCubeArray\n"),
+    ] {
+        let components = spatial + arrayed;
+        let coordinate = if components == 1 {
+            "%coord = OpConstant %float 0".to_string()
+        } else {
+            format!(
+                "%coord = OpConstantComposite %v{components}float {}",
+                vec!["%float_0"; components].join(" ")
+            )
+        };
+        let preamble = PREAMBLE
+            .replace(
+                "OpCapability Shader\n",
+                &format!("OpCapability Shader\n{capability}"),
+            )
+            .replace(
+                "%v2float = OpTypeVector %float 2\n",
+                "%v2float = OpTypeVector %float 2\n%v3float = OpTypeVector %float 3\n",
+            )
+            .replace(
+                "%coord = OpConstantComposite %v2float %float_0 %float_0",
+                &coordinate,
+            )
+            .replace(
+                "%image = OpTypeImage %float 2D 0 0 0 1 Unknown",
+                &format!("%image = OpTypeImage %float {dimension} 0 {arrayed} 0 1 Unknown"),
+            );
+        let Some(module) = assemble(&format!(
+            "{preamble}
+%main = OpFunction %void None %fn
+%entry = OpLabel
+%sampled = OpLoad %sampled_type %sampled_var
+%color = OpImageSampleImplicitLod %v4float %sampled %coord
+OpReturn
+OpFunctionEnd
+"
+        )) else {
+            return;
+        };
+        let lowered = run(module, &[]).unwrap();
+        validate(&lowered);
+        for derivative in lowered
+            .all_inst_iter()
+            .filter(|inst| matches!(inst.class.opcode, Op::DPdx | Op::DPdy))
+        {
+            let ty = lowered
+                .types_global_values
+                .iter()
+                .find(|ty| ty.result_id == derivative.result_type)
+                .unwrap();
+            if spatial == 1 {
+                assert_eq!(ty.class.opcode, Op::TypeFloat);
+            } else {
+                assert_eq!(ty.class.opcode, Op::TypeVector);
+                assert_eq!(
+                    ty.operands.get(1),
+                    Some(&Operand::LiteralBit32(spatial as u32))
+                );
+            }
+        }
+    }
+}
