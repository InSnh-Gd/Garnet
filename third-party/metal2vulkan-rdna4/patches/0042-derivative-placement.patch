+fn branch_source(coordinate: &str) -> String {
+    format!(
+        "{PREAMBLE}
+OpName %arm \"sample_arm\"
+OpName %local_coord \"local_coordinate\"
+%main = OpFunction %void None %fn
+%entry = OpLabel
+%pos = OpLoad %v4float %position
+%x = OpCompositeExtract %float %pos 0
+%condition = OpFOrdGreaterThan %bool %x %float_0
+OpSelectionMerge %merge None
+OpBranchConditional %condition %arm %merge
+%arm = OpLabel
+{coordinate}
+%sampled = OpLoad %sampled_type %sampled_var
+%color = OpImageSampleImplicitLod %v4float %sampled %local_coord
+OpBranch %merge
+%merge = OpLabel
+OpReturn
+OpFunctionEnd
+"
+    )
+}
