+use super::*;
+use std::sync::atomic::{AtomicU64, Ordering};
+
+static COUNTER: AtomicU64 = AtomicU64::new(0);
+
+fn assemble(source: &str) -> Option<crate::spirv_module::Module> {
+    if std::process::Command::new("spirv-as")
+        .arg("--version")
+        .output()
+        .is_err()
+    {
+        return None;
+    }
+    let directory = std::env::temp_dir().join(format!(
+        "metal2vulkan-quad-control-{}-{}",
+        std::process::id(),
+        COUNTER.fetch_add(1, Ordering::Relaxed)
+    ));
+    std::fs::create_dir_all(&directory).unwrap();
+    let source_path = directory.join("input.spvasm");
+    let binary_path = directory.join("output.spv");
+    std::fs::write(&source_path, source).unwrap();
+    let output = std::process::Command::new("spirv-as")
+        .args(["--target-env", crate::tools::VULKAN_TARGET_ENV])
+        .arg(&source_path)
+        .arg("-o")
+        .arg(&binary_path)
+        .output()
+        .unwrap();
+    assert!(
+        output.status.success(),
+        "spirv-as: {}",
+        String::from_utf8_lossy(&output.stderr)
+    );
+    let bytes = std::fs::read(binary_path).unwrap();
+    std::fs::remove_dir_all(directory).unwrap();
+    crate::spirv_module::load_bytes(&bytes).ok()
+}
+
+fn named_id(module: &Module, wanted: &str) -> Word {
+    module
+        .debug_names
+        .iter()
+        .find_map(|instruction| match instruction.operands.as_slice() {
+            [Operand::IdRef(id), Operand::LiteralString(name)]
+                if instruction.class.opcode == Op::Name && name == wanted =>
+            {
+                Some(*id)
+            }
+            _ => None,
+        })
+        .unwrap_or_else(|| panic!("missing OpName {wanted:?}"))
+}
+
+fn function_index(module: &Module, function: Word) -> usize {
+    module
+        .functions
+        .iter()
+        .position(|definition| {
+            definition.def.as_ref().and_then(|def| def.result_id) == Some(function)
+        })
+        .unwrap()
+}
+
+fn block_index(module: &Module, function: Word, block: Word) -> usize {
+    let function = function_index(module, function);
+    module.functions[function]
+        .blocks
+        .iter()
+        .position(|value| value.label.as_ref().and_then(|label| label.result_id) == Some(block))
+        .unwrap()
+}
+
+fn run(
+    module: crate::spirv_module::Module,
+    facts: &[(Word, Word)],
+) -> Result<crate::spirv_module::Module, String> {
+    let sidecar = crate::emit_sidecar::EmitSidecar {
+        uniform_value_facts: facts
+            .iter()
+            .map(|&(function, value)| crate::emit_sidecar::UniformValueFact { function, value })
+            .collect(),
+        ..crate::emit_sidecar::EmitSidecar::default()
+    };
+    let mut ctx = Ctx::with_options_and_sidecar(
+        module,
+        sidecar,
+        Stage::Fragment,
+        TransformOptions::default(),
+    );
+    lower_argument_implicit_lod(&mut ctx)?;
+    ctx.module.types_global_values.append(&mut ctx.new_globals);
+    Ok(ctx.module)
+}
+
+fn validate(module: &crate::spirv_module::Module) {
+    let directory = std::env::temp_dir().join(format!(
+        "metal2vulkan-quad-validate-{}-{}",
+        std::process::id(),
+        COUNTER.fetch_add(1, Ordering::Relaxed)
+    ));
+    std::fs::create_dir_all(&directory).unwrap();
+    let path = directory.join("output.spv");
+    let bytes = module
+        .assemble()
+        .into_iter()
+        .flat_map(Word::to_le_bytes)
+        .collect::<Vec<_>>();
+    std::fs::write(&path, &bytes).unwrap();
+    let output = std::process::Command::new("spirv-val")
+        .args(["--target-env", crate::tools::VULKAN_TARGET_ENV])
+        .arg(&path)
+        .output()
+        .unwrap();
+    assert!(
+        output.status.success(),
+        "spirv-val: {}",
+        String::from_utf8_lossy(&output.stderr)
+    );
+    std::fs::remove_dir_all(directory).unwrap();
+}
+
+fn has_derivatives(
+    module: &crate::spirv_module::Module,
+    function: Word,
+    block: Word,
+) -> (bool, bool) {
+    let function_position = function_index(module, function);
+    let block_position = block_index(module, function, block);
+    let body = &module.functions[function_position].blocks[block_position].instructions;
+    (
+        body.iter()
+            .any(|instruction| instruction.class.opcode == Op::DPdx),
+        body.iter()
+            .any(|instruction| instruction.class.opcode == Op::DPdy),
+    )
+}
+
