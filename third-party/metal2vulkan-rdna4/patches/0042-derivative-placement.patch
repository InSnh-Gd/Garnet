+#[test]
+fn branch_local_coordinate_is_recomputed_before_the_varying_branch() {
+    let Some(module) = assemble(&branch_source(
+        "%local_pos = OpLoad %v4float %position
+%xy = OpVectorShuffle %v2float %local_pos %local_pos 0 1
+%local_coord = OpFAdd %v2float %xy %xy",
+    )) else {
+        return;
+    };
+    let main = named_id(&module, "entry");
+    let lowered = run(module, &[]).unwrap();
+    validate(&lowered);
+    assert_eq!(
+        has_derivatives(&lowered, main, named_id(&lowered, "entry_block")),
+        (true, true)
+    );
+    assert_eq!(
+        has_derivatives(&lowered, main, named_id(&lowered, "sample_arm")),
+        (false, false)
+    );
+    let entry = &lowered.functions[function_index(&lowered, main)].blocks[0].instructions;
+    assert_eq!(
+        entry.iter().filter(|i| i.class.opcode == Op::FAdd).count(),
+        1
+    );
+    assert_eq!(
+        entry.iter().filter(|i| i.class.opcode == Op::Load).count(),
+        2
+    );
+    let local = named_id(&lowered, "local_coordinate");
+    let sample = lowered
+        .all_inst_iter()
+        .find(|i| i.class.opcode == Op::ImageSampleExplicitLod)
+        .unwrap();
+    assert_eq!(sample.operands.get(1), Some(&Operand::IdRef(local)));
+}
