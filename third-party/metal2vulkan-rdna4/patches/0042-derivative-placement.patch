+//! Plan coordinate recomputation at the nearest derivative-group-uniform dominator.
+//!
+//! Only the coordinate and its pure dependency slice are speculated; the descriptor lookup,
+//! sample, bias and side effects stay at their original site. Loop membership must match so a
+//! loop-carried value is never reused across different dynamic iterations.
+
+use super::*;
+use crate::passes::resources::fragment_control::{ControlStatus, FragmentControl};
+use crate::passes::spirv_cfg::BlockDominance;
+
+pub(super) struct CoordinatePlacement {
+    dominance: BlockDominance,
+    owners: HashMap<Word, usize>,
+    external: HashSet<Word>,
+    immutable_inputs: HashSet<Word>,
+    loops: Vec<(usize, usize)>,
+}
+
+pub(super) struct CoordinatePlan {
+    pub(super) block: usize,
+    coordinate: Word,
+    recompute: Vec<Instruction>,
+}
+
+impl CoordinatePlacement {
+    pub(super) fn new(
+        ctx: &Ctx,
+        function: usize,
+        definitions: &HashMap<Word, Instruction>,
+    ) -> Result<Self, String> {
+        let function = &ctx.module.functions[function];
+        let mut mutable_inputs = ctx.module.annotations.iter().filter_map(|annotation| {
+            match annotation.operands.as_slice() {
+                [Operand::IdRef(id), Operand::Decoration(Decoration::BuiltIn), Operand::BuiltIn(spirv::BuiltIn::HelperInvocation)] => Some(*id),
+                _ => None,
+            }
+        }).collect::<HashSet<_>>();
+        for annotation in &ctx.module.annotations {
+            if annotation.class.opcode == Op::GroupDecorate
+                && matches!(annotation.operands.first(), Some(Operand::IdRef(group)) if mutable_inputs.contains(group))
+            {
+                mutable_inputs.extend(annotation.operands.iter().skip(1).filter_map(|operand| {
+                    match operand {
+                        Operand::IdRef(id) => Some(*id),
+                        _ => None,
+                    }
+                }));
+            }
+        }
+        let immutable_inputs = definitions
+            .iter()
+            .filter_map(|(&id, instruction)| {
+                if mutable_inputs.contains(&id)
+                    || instruction.class.opcode != Op::Variable
+                    || instruction.operands.first()
+                        != Some(&Operand::StorageClass(StorageClass::Input))
+                {
+                    return None;
+                }
+                let pointer = definitions.get(&instruction.result_type?)?;
+                let Some(Operand::IdRef(pointee)) = pointer.operands.get(1) else {
+                    return None;
+                };
+                matches!(
+                    definitions.get(pointee)?.class.opcode,
+                    Op::TypeFloat | Op::TypeInt | Op::TypeBool | Op::TypeVector | Op::TypeMatrix
+                )
+                .then_some(id)
+            })
+            .collect();
+        let positions = function
+            .blocks
+            .iter()
+            .enumerate()
+            .filter_map(|(index, block)| Some((block.label.as_ref()?.result_id?, index)))
+            .collect::<HashMap<_, _>>();
+        let mut loops = Vec::new();
+        for (header, block) in function.blocks.iter().enumerate() {
+            for instruction in &block.instructions {
+                if instruction.class.opcode != Op::LoopMerge {
+                    continue;
+                }
+                let Some(Operand::IdRef(merge)) = instruction.operands.first() else {
+                    return Err("derivative placement has a malformed loop merge".into());
+                };
+                let merge = *positions
+                    .get(merge)
+                    .ok_or("derivative placement has an unknown loop merge")?;
+                loops.push((header, merge));
+            }
+        }
+        Ok(Self {
+            dominance: BlockDominance::of(&function.blocks),
+            owners: function
+                .blocks
+                .iter()
+                .enumerate()
+                .flat_map(|(block, definition)| {
+                    definition
+                        .instructions
+                        .iter()
+                        .filter_map(move |instruction| Some((instruction.result_id?, block)))
+                })
+                .collect(),
+            external: ctx
+                .module
+                .types_global_values
+                .iter()
+                .chain(&ctx.new_globals)
+                .chain(&function.parameters)
+                .filter_map(|instruction| instruction.result_id)
+                .collect(),
+            loops,
+            immutable_inputs,
+        })
+    }
+
+    pub(super) fn plan(
+        &self,
+        control: &FragmentControl,
+        function: usize,
+        block: usize,
+        coordinate: Word,
+        definitions: &HashMap<Word, Instruction>,
+    ) -> Result<CoordinatePlan, String> {
+        if control.status(function, block) == ControlStatus::Uniform {
+            return Ok(CoordinatePlan {
+                block,
+                coordinate,
+                recompute: Vec::new(),
+            });
+        }
+        let mut target = block;
+        while let Some(parent) = self.dominance.immediate_dominator(target) {
+            target = parent;
+            if control.status(function, target) != ControlStatus::Uniform {
+                continue;
+            }
+            if !self.loops.iter().all(|&(header, merge)| {
+                let contains = |site| {
+                    self.dominance.dominates(header, site) && !self.dominance.dominates(merge, site)
+                };
+                contains(target) == contains(block)
+            }) {
+                return Err("derivative placement cannot cross a loop instance".into());
+            }
+            return Ok(CoordinatePlan {
+                block: target,
+                coordinate,
+                recompute: self.recompute(coordinate, target, definitions)?,
+            });
+        }
+        Err(
+            "derivative placement has no derivative-group-uniform dominator in this call instance"
+                .into(),
+        )
+    }
+
+    fn recompute(
+        &self,
+        coordinate: Word,
+        target: usize,
+        definitions: &HashMap<Word, Instruction>,
+    ) -> Result<Vec<Instruction>, String> {
+        let mut result = Vec::new();
+        let mut visited = HashSet::new();
+        let mut pending = vec![(coordinate, false)];
+        while let Some((value, finish)) = pending.pop() {
+            let instruction = definitions
+                .get(&value)
+                .ok_or_else(|| format!("undefined derivative coordinate dependency %{value}"))?;
+            if finish {
+                result.push(instruction.clone());
+                continue;
+            }
+            if !visited.insert(value) || self.external.contains(&value) {
+                continue;
+            }
+            let owner = *self.owners.get(&value).ok_or_else(|| {
+                format!("derivative coordinate dependency %{value} belongs to another function")
+            })?;
+            if self.dominance.dominates(owner, target) {
+                continue;
+            }
+            if !can_speculate(instruction, &self.immutable_inputs) {
+                return Err(format!(
+                    "cannot safely recompute derivative coordinate dependency %{value} ({:?})",
+                    instruction.class.opcode
+                ));
+            }
+            pending.push((value, true));
+            pending.extend(
+                instruction
+                    .operands
+                    .iter()
+                    .rev()
+                    .filter_map(|operand| match operand {
+                        Operand::IdRef(id) => Some((*id, false)),
+                        _ => None,
+                    }),
+            );
+        }
+        Ok(result)
+    }
+}
+
+impl CoordinatePlan {
+    pub(super) fn materialize(self, ctx: &mut Ctx) -> (Word, Vec<Instruction>) {
+        if self.recompute.is_empty() {
+            return (self.coordinate, Vec::new());
+        }
+        let mut replacements = HashMap::new();
+        let mut body = Vec::with_capacity(self.recompute.len());
+        for mut instruction in self.recompute {
+            let old = instruction.result_id.unwrap();
+            let new = ctx.module.fresh_id();
+            replacements.insert(old, new);
+            instruction.result_id = Some(new);
+            for operand in &mut instruction.operands {
+                if let Operand::IdRef(value) = operand {
+                    if let Some(&new) = replacements.get(value) {
+                        *value = new;
+                    }
+                }
+            }
+            body.push(instruction);
+        }
+        let mut annotations = Vec::new();
+        for annotation in &ctx.module.annotations {
+            if annotation.class.opcode == Op::GroupDecorate {
+                let mut members = vec![annotation.operands[0].clone()];
+                members.extend(annotation.operands.iter().skip(1).filter_map(
+                    |operand| match operand {
+                        Operand::IdRef(id) => replacements.get(id).copied().map(Operand::IdRef),
+                        _ => None,
+                    },
+                ));
+                if members.len() > 1 {
+                    annotations.push(Instruction::new(Op::GroupDecorate, None, None, members));
+                }
+            } else if matches!(annotation.class.opcode, Op::Decorate | Op::DecorateId) {
+                if let Some(Operand::IdRef(id)) = annotation.operands.first() {
+                    if let Some(&new) = replacements.get(id) {
+                        let mut copy = annotation.clone();
+                        copy.operands[0] = Operand::IdRef(new);
+                        annotations.push(copy);
+                    }
+                }
+            }
+        }
+        ctx.module.annotations.extend(annotations);
+        (
+            replacements
+                .get(&self.coordinate)
+                .copied()
+                .unwrap_or(self.coordinate),
+            body,
+        )
+    }
+}
+
+fn can_speculate(instruction: &Instruction, immutable_inputs: &HashSet<Word>) -> bool {
+    match instruction.class.opcode {
+        Op::Load => matches!(instruction.operands.as_slice(), [Operand::IdRef(pointer)]
+        if immutable_inputs.contains(pointer)),
+        Op::CopyObject
+        | Op::CompositeConstruct
+        | Op::CompositeExtract
+        | Op::CompositeInsert
+        | Op::VectorShuffle
+        | Op::VectorExtractDynamic
+        | Op::VectorInsertDynamic
+        | Op::FAdd
+        | Op::FSub
+        | Op::FMul
+        | Op::FDiv
+        | Op::FNegate
+        | Op::FConvert
+        | Op::ConvertSToF
+        | Op::ConvertUToF
+        | Op::SConvert
+        | Op::UConvert
+        | Op::Bitcast
+        | Op::IAdd
+        | Op::ISub
+        | Op::IMul
+        | Op::SNegate
+        | Op::VectorTimesScalar
+        | Op::VectorTimesMatrix
+        | Op::MatrixTimesVector
+        | Op::MatrixTimesScalar
+        | Op::MatrixTimesMatrix
+        | Op::Dot
+        | Op::Transpose
+        | Op::Select
+        | Op::BitwiseAnd
+        | Op::BitwiseOr
+        | Op::BitwiseXor
+        | Op::Not
+        | Op::LogicalAnd
+        | Op::LogicalOr
+        | Op::LogicalNot
+        | Op::LogicalEqual
+        | Op::LogicalNotEqual
+        | Op::IEqual
+        | Op::INotEqual
+        | Op::FOrdEqual
+        | Op::FOrdNotEqual
+        | Op::FOrdLessThan
+        | Op::FOrdGreaterThan
+        | Op::FOrdLessThanEqual
+        | Op::FOrdGreaterThanEqual => true,
+        _ => false,
+    }
+}
