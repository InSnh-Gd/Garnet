+pub(super) fn finalize_null_shape_indices(ctx: &mut Ctx) -> Result<(), String> {
+    let live = ctx
+        .module
+        .all_inst_iter()
+        .filter_map(|inst| inst.result_id)
+        .collect::<HashSet<_>>();
+    let mut registry = NullShapeRegistry::default();
+    for (id, shape) in &ctx.null_index_fixups {
+        if live.contains(id) {
+            registry.register(*shape)?;
+        }
+    }
+    registry.validate()?;
+    let words = registry.all_words();
+    for inst in &mut ctx.module.types_global_values {
+        if let Some(shape) = inst.result_id.and_then(|id| ctx.null_index_fixups.get(&id)) {
+            let ordinal = words
+                .binary_search(&shape.canonical_word()?)
+                .map_err(|_| "missing final null shape")?;
+            inst.operands = vec![Operand::LiteralBit32(32 + ordinal as u32)];
+        }
+    }
+    ctx.null_shape_registry = registry;
+    Ok(())
+}
