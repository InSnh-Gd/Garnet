+//! Typed image-shape and nullness facts.
+//!
+//! AIR image handles are values, not names: they survive through copies, loads/stores, aggregate
+//! insert/extract, selects, and phis. The legacy `image_dims`/`null_image_values` maps describe only
+//! a few of those forms, so a guard such as `is_null_texture(phi(null, bound))` used to observe
+//! whichever spelling happened to be registered. This module carries one typed fact through that
+//! value graph and materializes `is_null_texture` as ordinary boolean SSA.
+//!
+//! The shape word and access classes match the ABI-9 schema. Nothing here keys a fact by a shader,
+//! variable, or helper name; AIR intrinsic symbols only identify the stable operation family that
+//! states Dim/array/component/Depth/MS/access.
+
+use super::*;
+use crate::passes::air_calls::intrinsic_texture_shape;
+use std::collections::BTreeSet;
+
+/// A null predicate is allowed to contain vectors of phi inputs, so it is deliberately `Clone` but
+/// not `Copy`.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub(in crate::passes) enum ImageNullPredicate {
+    /// `KnownIsNull(true)` means the value is the null texture; the wording avoids polarity drift.
+    KnownIsNull(bool),
+    /// A serialized GPU argument is null exactly when both token words are zero.
+    #[allow(dead_code)]
+    GpuToken {
+        low: Word,
+        high: Word,
+    },
+    /// Select between two image values; the fields name the condition and image arms.
+    Select {
+        condition: Word,
+        when_true: Word,
+        when_false: Word,
+    },
+    /// A control-flow join. Each pair is `(incoming image value, predecessor block)`.
+    Phi(Vec<(Word, Word)>),
+    Unknown,
+}
+
+impl ImageNullPredicate {
+    #[cfg(test)]
+    fn remap_ids(&mut self, remap: &HashMap<Word, Word>) -> Result<(), String> {
+        let map = |id: &mut Word| {
+            if let Some(new) = remap.get(id).copied() {
+                *id = new;
+            }
+        };
+        match self {
+            ImageNullPredicate::KnownIsNull(_) | ImageNullPredicate::Unknown => {}
+            ImageNullPredicate::GpuToken { low, high } => {
+                map(low);
+                map(high);
+            }
+            ImageNullPredicate::Select {
+                condition,
+                when_true,
+                when_false,
+            } => {
+                map(condition);
+                map(when_true);
+                map(when_false);
+            }
+            ImageNullPredicate::Phi(arms) => {
+                let mut seen = HashSet::new();
+                for (incoming, predecessor) in arms.iter_mut() {
+                    map(incoming);
+                    map(predecessor);
+                    if !seen.insert((*incoming, *predecessor)) {
+                        return Err(
+                            "image null phi remap produced a duplicate incoming edge".into()
+                        );
+                    }
+                }
+            }
+        }
+        Ok(())
+    }
+}
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub(in crate::passes) struct ImageFacts {
+    pub(in crate::passes) shape: Option<ImageShape>,
+    pub(in crate::passes) nullness: ImageNullPredicate,
+}
+
+impl Default for ImageFacts {
+    fn default() -> Self {
+        Self {
+            shape: None,
+            nullness: ImageNullPredicate::Unknown,
+        }
+    }
+}
+
+impl ImageFacts {
+    pub(in crate::passes) fn known(shape: ImageShape, is_null: bool) -> Self {
+        Self {
+            shape: Some(shape),
+            nullness: ImageNullPredicate::KnownIsNull(is_null),
+        }
+    }
+
+    /// Remap every SSA id carried by these facts. Returning an error on a shape collision keeps a
+    /// caller from silently merging two differently typed image facts after canonicalization.
+    #[cfg(test)]
+    pub(in crate::passes) fn remap_ids(
+        &mut self,
+        remap: &HashMap<Word, Word>,
+    ) -> Result<(), String> {
+        self.nullness.remap_ids(remap)?;
+        Ok(())
+    }
+}
+
+/// ABI-9 canonical shape registry.
+///
+/// Ordinals are per access class over a sorted set. The serialized list is de-duplicated and sorted
+/// before any ordinal is consumed, so an unused shape never occupies a slot.
+#[derive(Clone, Debug, Default, PartialEq, Eq)]
+pub(in crate::passes) struct NullShapeRegistry {
+    by_access: [BTreeSet<u32>; 4],
+}
+
+impl NullShapeRegistry {
+    fn slot(access: ImageAccess) -> usize {
+        match access {
+            ImageAccess::Sampled => 0,
+            ImageAccess::Storage => 1,
+            ImageAccess::UniformTexel => 2,
+            ImageAccess::StorageTexel => 3,
+        }
+    }
+
+    pub(in crate::passes) fn register(&mut self, shape: ImageShape) -> Result<(), String> {
+        let word = shape.canonical_word()?;
+        let slot = Self::slot(shape.access);
+        if !self.by_access[slot].contains(&word)
+            && self.by_access.iter().map(BTreeSet::len).sum::<usize>() >= 64
+        {
+            return Err("ABI-9 null shape registry exceeds its 64-entry ABI limit".into());
+        }
+        let set = &mut self.by_access[slot];
+        set.insert(word);
+        Ok(())
+    }
+
+    #[cfg(test)]
+    pub(in crate::passes) fn ordinal(&self, shape: ImageShape) -> Option<u32> {
+        let word = shape.canonical_word().ok()?;
+        let set = &self.by_access[Self::slot(shape.access)];
+        set.contains(&word)
+            .then(|| set.range(..word).count() as u32)
+    }
+
+    pub(in crate::passes) fn words(&self, access: ImageAccess) -> Vec<u32> {
+        self.by_access[Self::slot(access)].iter().copied().collect()
+    }
+
+    /// The ABI-9 wire list is globally sorted by the full word, not grouped by access. The four
+    /// per-access sets above are only an ordinal index; this helper is the authoritative order the
+    /// metadata producer and native decoder consume.
+    pub(in crate::passes) fn all_words(&self) -> Vec<u32> {
+        let mut words = self
+            .by_access
+            .iter()
+            .flat_map(BTreeSet::iter)
+            .copied()
+            .collect::<Vec<_>>();
+        words.sort_unstable();
+        words.dedup();
+        words
+    }
+
+    pub(in crate::passes) fn access_count(&self, access: ImageAccess) -> u32 {
+        self.by_access[Self::slot(access)].len() as u32
+    }
+
+    pub(in crate::passes) fn validate(&self) -> Result<(), String> {
+        let all = self.all_words();
+        if all.len() > 64 {
+            return Err("ABI-9 null shape registry exceeds its 64-entry ABI limit".into());
+        }
+        for access in [
+            ImageAccess::Sampled,
+            ImageAccess::Storage,
+            ImageAccess::UniformTexel,
+            ImageAccess::StorageTexel,
+        ] {
+            let words = self.words(access);
+            if words.len() != self.access_count(access) as usize {
+                return Err("ABI-9 null shape per-access index is inconsistent".into());
+            }
+            for word in words {
+                validate_canonical_null_shape_word(word)?;
+            }
+        }
+        Ok(())
+    }
+}
+
+impl ImageShape {
+    pub(in crate::passes) fn sampled(
+        dim: Dim,
+        arrayed: bool,
+        comp: ImageComp,
+        multisampled: bool,
+        depth: bool,
+    ) -> Self {
+        let access = if dim == Dim::DimBuffer {
+            ImageAccess::UniformTexel
+        } else {
+            ImageAccess::Sampled
+        };
+        Self {
+            dim,
+            arrayed,
+            comp,
+            depth,
+            multisampled,
+            access,
+        }
+    }
+
+    /// Encode the exact ABI-9 word:
+    /// `dim[0..3] | arrayed<<3 | component<<4 | depth<<6 | ms<<7 | access<<8`.
+    pub(in crate::passes) fn canonical_word(self) -> Result<u32, String> {
+        self.validate()?;
+        let dim = match self.dim {
+            Dim::Dim1D => 0,
+            Dim::Dim2D => 1,
+            Dim::Dim3D => 2,
+            Dim::DimCube => 3,
+            Dim::DimBuffer => 4,
+            other => return Err(format!("unsupported image dimension {other:?}")),
+        };
+        let component = match self.comp {
+            ImageComp::Float => 0,
+            ImageComp::Uint => 1,
+            ImageComp::Sint => 2,
+        };
+        let access = match self.access {
+            ImageAccess::Sampled => 0,
+            ImageAccess::Storage => 1,
+            ImageAccess::UniformTexel => 2,
+            ImageAccess::StorageTexel => 3,
+        };
+        Ok(dim
+            | ((self.arrayed as u32) << 3)
+            | (component << 4)
+            | ((self.depth as u32) << 6)
+            | ((self.multisampled as u32) << 7)
+            | (access << 8))
+    }
+
+    pub(in crate::passes) fn from_canonical_word(word: u32) -> Result<Self, String> {
+        if word & !0x3ff != 0 {
+            return Err(format!(
+                "image shape word 0x{word:08x} has non-zero reserved bits 10..31"
+            ));
+        }
+        let dim = match word & 0x7 {
+            0 => Dim::Dim1D,
+            1 => Dim::Dim2D,
+            2 => Dim::Dim3D,
+            3 => Dim::DimCube,
+            4 => Dim::DimBuffer,
+            value => {
+                return Err(format!(
+                    "image shape word 0x{word:08x} has invalid dim {value}"
+                ))
+            }
+        };
+        let component = match (word >> 4) & 0x3 {
+            0 => ImageComp::Float,
+            1 => ImageComp::Uint,
+            2 => ImageComp::Sint,
+            value => {
+                return Err(format!(
+                    "image shape word 0x{word:08x} has invalid component {value}"
+                ))
+            }
+        };
+        let access = ImageAccess::from_bits((word >> 8) & 0x3)
+            .ok_or_else(|| format!("image shape word 0x{word:08x} has invalid access"))?;
+        let shape = Self {
+            dim,
+            arrayed: word & (1 << 3) != 0,
+            comp: component,
+            depth: word & (1 << 6) != 0,
+            multisampled: word & (1 << 7) != 0,
+            access,
+        };
+        shape.validate()?;
+        Ok(shape)
+    }
+
+    pub(in crate::passes) fn validate(self) -> Result<(), String> {
+        if self.dim == Dim::DimBuffer {
+            if self.arrayed {
+                return Err("buffer image must not be arrayed".into());
+            }
+            if !self.access.is_texel() {
+                return Err("Dim::Buffer requires UniformTexel or StorageTexel access".into());
+            }
+        } else if self.access.is_texel() {
+            return Err(format!(
+                "{:?} cannot use texel-buffer access {:?}",
+                self.dim, self.access
+            ));
+        }
+        if self.dim == Dim::Dim3D && self.arrayed {
+            return Err("3D images cannot be arrayed".into());
+        }
+        if self.access == ImageAccess::Storage {
+            if self.depth {
+                return Err("storage images cannot carry the Depth operand".into());
+            }
+            if self.multisampled {
+                return Err("storage images cannot be multisampled".into());
+            }
+            if self.dim == Dim::DimCube {
+                return Err("storage images cannot be cubes".into());
+            }
+        }
+        if self.depth {
+            if self.access != ImageAccess::Sampled {
+                return Err("depth images must use sampled access".into());
+            }
+            if self.comp != ImageComp::Float {
+                return Err("depth images require Float component".into());
+            }
+            if !matches!(self.dim, Dim::Dim2D | Dim::DimCube) {
+                return Err("depth images must be 2D or cube".into());
+            }
+            if self.multisampled && self.dim != Dim::Dim2D {
+                return Err("only 2D depth images may be multisampled".into());
+            }
+        }
+        if self.multisampled {
+            if self.access != ImageAccess::Sampled {
+                return Err("multisampled images must use sampled access".into());
+            }
+            if self.dim != Dim::Dim2D {
+                return Err("ABI-9 multisample images must be 2D".into());
+            }
+        }
+        Ok(())
+    }
+
+    pub(in crate::passes) fn spirv_sampled(self) -> u32 {
+        self.access.spirv_sampled()
+    }
+}
+
+/// Validate one ABI-9 canonical image-shape word without exposing the pass-local shape type at the
+/// public reflection boundary.
+pub(crate) fn validate_canonical_null_shape_word(word: u32) -> Result<(), String> {
+    ImageShape::from_canonical_word(word).map(|_| ())
+}
+
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub(in crate::passes) struct ImageShapeEvidence {
+    dim: Option<Dim>,
+    arrayed: Option<bool>,
+    comp: Option<ImageComp>,
+    depth: Option<bool>,
+    multisampled: Option<bool>,
+    access: Option<ImageAccess>,
+}
+
+impl ImageShapeEvidence {
+    pub(in crate::passes) fn exact(shape: ImageShape) -> Self {
+        Self {
+            dim: Some(shape.dim),
+            arrayed: Some(shape.arrayed),
+            comp: Some(shape.comp),
+            depth: Some(shape.depth),
+            multisampled: Some(shape.multisampled),
+            access: Some(shape.access),
+        }
+    }
+
+    fn merge(&mut self, other: Self) -> Result<bool, String> {
+        let before = *self;
+        macro_rules! merge_field {
+            ($field:ident, $label:expr) => {
+                match (self.$field, other.$field) {
+                    (None, value) => self.$field = value,
+                    (Some(current), Some(incoming)) if current != incoming => {
+                        return Err(format!(
+                            "conflicting image {} evidence: {current:?} vs {incoming:?}",
+                            $label
+                        ))
+                    }
+                    _ => {}
+                }
+            };
+        }
+        merge_field!(dim, "dimension");
+        merge_field!(arrayed, "arrayed");
+        merge_field!(comp, "component");
+        merge_field!(depth, "Depth");
+        merge_field!(multisampled, "multisample");
+        merge_field!(access, "access");
+        Ok(before != *self)
+    }
+
+    fn materialize(self) -> Result<Option<ImageShape>, String> {
+        let Some(dim) = self.dim else {
+            return Ok(None);
+        };
+        let access = self.access.unwrap_or(if dim == Dim::DimBuffer {
+            ImageAccess::UniformTexel
+        } else {
+            ImageAccess::Sampled
+        });
+        let shape = ImageShape {
+            dim,
+            arrayed: self.arrayed.unwrap_or(false),
+            comp: self.comp.unwrap_or(ImageComp::Float),
+            depth: self.depth.unwrap_or(false),
+            multisampled: self.multisampled.unwrap_or(false),
+            access,
+        };
+        shape.validate()?;
+        Ok(Some(shape))
+    }
+}
+
+#[derive(Clone, Default)]
+struct FactGraph {
+    evidence: HashMap<Word, ImageShapeEvidence>,
+    field_evidence: HashMap<(Word, Vec<u32>), ImageShapeEvidence>,
+    facts: HashMap<Word, ImageFacts>,
+    field_facts: HashMap<(Word, Vec<u32>), ImageFacts>,
+}
+
+impl FactGraph {
+    fn set_evidence(&mut self, id: Word, evidence: ImageShapeEvidence) -> Result<bool, String> {
+        if evidence == ImageShapeEvidence::default() {
+            return Ok(false);
+        }
+        let entry = self.evidence.entry(id).or_default();
+        entry.merge(evidence)
+    }
+
+    fn set_field_evidence(
+        &mut self,
+        id: Word,
+        path: Vec<u32>,
+        evidence: ImageShapeEvidence,
+    ) -> Result<bool, String> {
+        if evidence == ImageShapeEvidence::default() {
+            return Ok(false);
+        }
+        let entry = self.field_evidence.entry((id, path)).or_default();
+        entry.merge(evidence)
+    }
+
+    fn alias_fact(&mut self, dst: Word, src: Word) -> Result<bool, String> {
+        let Some(src_fact) = self.facts.get(&src).cloned() else {
+            return Ok(false);
+        };
+        let entry = self.facts.entry(dst).or_default();
+        let before = entry.clone();
+        if let Some(src_shape) = src_fact.shape {
+            match entry.shape {
+                Some(dst_shape) if dst_shape != src_shape => {
+                    return Err(format!(
+                        "image facts for %{dst} and %{src} disagree on shape: {dst_shape:?} vs {src_shape:?}"
+                    ))
+                }
+                None => entry.shape = Some(src_shape),
+                _ => {}
+            }
+        }
+        match (&entry.nullness, &src_fact.nullness) {
+            (ImageNullPredicate::Unknown, incoming) => {
+                entry.nullness = incoming.clone();
+            }
+            (_current, ImageNullPredicate::Unknown) => {}
+            (current, incoming) if current == incoming => {}
+            (current, incoming) => {
+                return Err(format!(
+                    "image null facts for %{dst} and %{src} disagree: {current:?} vs {incoming:?}"
+                ))
+            }
+        }
+        Ok(*entry != before)
+    }
+
+    fn alias_field_fact(&mut self, dst: Word, src: Word, path: &[u32]) -> Result<bool, String> {
+        let Some(src_fact) = self.field_facts.get(&(src, path.to_vec())).cloned() else {
+            return Ok(false);
+        };
+        let key = (dst, path.to_vec());
+        let entry = self.field_facts.entry(key).or_default();
+        let before = entry.clone();
+        if let Some(src_shape) = src_fact.shape {
+            match entry.shape {
+                Some(dst_shape) if dst_shape != src_shape => {
+                    return Err(format!(
+                        "aggregate image fields {src:?}/{path:?} and {dst:?}/{path:?} disagree on shape"
+                    ))
+                }
+                None => entry.shape = Some(src_shape),
+                _ => {}
+            }
+        }
+        match (&entry.nullness, &src_fact.nullness) {
+            (ImageNullPredicate::Unknown, incoming) => entry.nullness = incoming.clone(),
+            (_current, ImageNullPredicate::Unknown) => {}
+            (current, incoming) if current == incoming => {}
+            (current, incoming) => {
+                return Err(format!(
+                    "aggregate image fields {src:?}/{path:?} and {dst:?}/{path:?} disagree on nullness: {current:?} vs {incoming:?}"
+                ))
+            }
+        }
+        Ok(*entry != before)
+    }
+
+    fn set_join(
+        &mut self,
+        result: Word,
+        arms: Vec<(Word, Word)>,
+        predicate: ImageNullPredicate,
+    ) -> Result<bool, String> {
+        let mut changed = false;
+        for (incoming, _) in &arms {
+            if let Some(fact) = self.facts.get(incoming).cloned() {
+                let entry = self.facts.entry(result).or_default();
+                let before = entry.clone();
+                if let Some(shape) = fact.shape {
+                    match entry.shape {
+                        Some(current) if current != shape => {
+                            return Err(format!(
+                                "image join %{result} mixes shapes {current:?} and {shape:?} from %{incoming}"
+                            ))
+                        }
+                        None => entry.shape = Some(shape),
+                        _ => {}
+                    }
+                }
+                changed |= *entry != before;
+            }
+        }
+        let entry = self.facts.entry(result).or_default();
+        if entry.nullness != predicate {
+            entry.nullness = predicate;
+            changed = true;
+        }
+        Ok(changed)
+    }
+
+    fn finalize(
+        &mut self,
+    ) -> Result<
+        (
+            HashMap<Word, ImageFacts>,
+            HashMap<(Word, Vec<u32>), ImageFacts>,
+        ),
+        String,
+    > {
+        for (id, evidence) in &self.evidence {
+            if let Some(shape) = evidence.materialize()? {
+                let fact = self.facts.entry(*id).or_default();
+                match fact.shape {
+                    Some(current) if current != shape => {
+                        return Err(format!(
+                            "image %{id} has contradictory full shapes {current:?} and {shape:?}"
+                        ))
+                    }
+                    None => fact.shape = Some(shape),
+                    _ => {}
+                }
+            }
+        }
+        for ((id, path), evidence) in &self.field_evidence {
+            if let Some(shape) = evidence.materialize()? {
+                let fact = self.field_facts.entry((*id, path.clone())).or_default();
+                match fact.shape {
+                    Some(current) if current != shape => {
+                        return Err(format!(
+                            "aggregate image field %{id}/{path:?} has contradictory shapes"
+                        ))
+                    }
+                    None => fact.shape = Some(shape),
+                    _ => {}
+                }
+            }
+        }
+        for fact in self.facts.values() {
+            if let Some(shape) = fact.shape {
+                shape.validate()?;
+            }
+        }
+        for fact in self.field_facts.values() {
+            if let Some(shape) = fact.shape {
+                shape.validate()?;
+            }
+        }
+        Ok((self.facts.clone(), self.field_facts.clone()))
+    }
+}
+
+/// Gather shape/nullness facts for the entry before AIR calls are rewritten. This runs after
+/// interface binding and GPU-token materialization, so every real image has its final SSA form.
+pub(in crate::passes) fn prepare_image_facts(
+    ctx: &mut Ctx,
+    entry_idx: usize,
+) -> Result<(), String> {
+    let names = air_names(&ctx.module);
+    let needs_null_facts = ctx.module.functions[entry_idx].blocks.iter().flat_map(|block| &block.instructions).any(|inst| inst.class.opcode == Op::FunctionCall && matches!(inst.operands.first(), Some(Operand::IdRef(callee)) if names.get(callee).is_some_and(|name| name.starts_with("air.get_null_texture") || name.starts_with("air.is_null_texture"))));
+    if !needs_null_facts {
+        return Ok(());
+    }
+    let mut graph = FactGraph::default();
+    seed_interface_facts(ctx, &mut graph)?;
+    collect_intrinsic_facts(ctx, entry_idx, &names, &mut graph)?;
+
+    let instructions = ctx
+        .module
+        .all_inst_iter()
+        .chain(ctx.new_globals.iter())
+        .cloned()
+        .collect::<Vec<_>>();
+    // A conservative fixed point bounded by the instruction count. Alias joins converge
+    // monotonically; this limit turns a malformed cyclic type graph into a diagnosis.
+    let limit = instructions.len().saturating_mul(2).max(16);
+    for _ in 0..limit {
+        if !propagate_once(ctx, &instructions, &mut graph)? {
+            break;
+        }
+    }
+    let (facts, field_facts) = graph.finalize()?;
+    for (id, evidence) in graph.evidence.drain() {
+        let entry = ctx.image_shape_evidence.entry(id).or_default();
+        entry.merge(evidence)?;
+    }
+    for (key, evidence) in graph.field_evidence.drain() {
+        let entry = ctx.image_field_shape_evidence.entry(key).or_default();
+        entry.merge(evidence)?;
+    }
+    for fact in facts.values().chain(field_facts.values()) {
+        if let (Some(shape), false) = (
+            fact.shape,
+            matches!(fact.nullness, ImageNullPredicate::KnownIsNull(false)),
+        ) {
+            // Collect candidates now; final liveness closes the registry and relocates accesses.
+            ctx.null_shape_registry.register(shape)?;
+        }
+    }
+    ctx.null_shape_registry.validate()?;
+    ctx.image_facts = facts;
+    ctx.image_field_facts = field_facts;
+    materialize_is_null_predicates(ctx, entry_idx, &names)?;
+    Ok(())
+}
+
+fn seed_interface_facts(ctx: &Ctx, graph: &mut FactGraph) -> Result<(), String> {
+    let mut ids = ctx
+        .image_dims
+        .keys()
+        .copied()
+        .chain(ctx.image_storage.iter().copied())
+        .collect::<BTreeSet<_>>();
+    ids.extend(ctx.null_image_values.iter().copied());
+    for id in ids {
+        let Some((dim, arrayed)) = ctx.image_dims.get(&id).copied() else {
+            continue;
+        };
+        let shape = shape_from_image_value(ctx, id).unwrap_or_else(|| {
+            let access = if ctx.image_storage.contains(&id) {
+                if dim == Dim::DimBuffer {
+                    ImageAccess::StorageTexel
+                } else {
+                    ImageAccess::Storage
+                }
+            } else if dim == Dim::DimBuffer {
+                ImageAccess::UniformTexel
+            } else {
+                ImageAccess::Sampled
+            };
+            ImageShape {
+                dim,
+                arrayed,
+                comp: ctx.image_comp.get(&id).copied().unwrap_or(ImageComp::Float),
+                depth: false,
+                multisampled: ctx.image_multisampled.contains(&id),
+                access,
+            }
+        });
+        graph.set_evidence(id, ImageShapeEvidence::exact(shape))?;
+        let predicate = if ctx.null_image_values.contains(&id) {
+            ImageNullPredicate::KnownIsNull(true)
+        } else if value_def_instruction(ctx, id)
+            .is_some_and(|inst| matches!(inst.class.opcode, Op::Select | Op::Phi))
+        {
+            ImageNullPredicate::Unknown
+        } else {
+            ImageNullPredicate::KnownIsNull(false)
+        };
+        graph.facts.insert(
+            id,
+            ImageFacts {
+                shape: Some(shape),
+                nullness: predicate,
+            },
+        );
+    }
+    Ok(())
+}
+
+fn collect_intrinsic_facts(
+    ctx: &Ctx,
+    entry_idx: usize,
+    names: &HashMap<Word, String>,
+    graph: &mut FactGraph,
+) -> Result<(), String> {
+    for inst in ctx.module.functions[entry_idx]
+        .blocks
+        .iter()
+        .flat_map(|block| &block.instructions)
+    {
+        if inst.class.opcode != Op::FunctionCall {
+            continue;
+        }
+        let Some(Operand::IdRef(callee)) = inst.operands.first() else {
+            continue;
+        };
+        let Some(name) = names.get(callee) else {
+            continue;
+        };
+        if name.starts_with("air.get_null_texture") {
+            let Some(result) = inst.result_id else {
+                return Err(format!("{name} has no result"));
+            };
+            let (dim, arrayed) = intrinsic_texture_shape(name).unwrap_or((Dim::Dim2D, false));
+            graph.set_evidence(
+                result,
+                ImageShapeEvidence {
+                    dim: Some(dim),
+                    arrayed: Some(arrayed),
+                    ..ImageShapeEvidence::default()
+                },
+            )?;
+            graph.facts.insert(
+                result,
+                ImageFacts {
+                    shape: None,
+                    nullness: ImageNullPredicate::KnownIsNull(true),
+                },
+            );
+            continue;
+        }
+        let Some(evidence) = intrinsic_evidence(ctx, name, inst)? else {
+            continue;
+        };
+        let Some(Operand::IdRef(image)) = inst.operands.get(1) else {
+            continue;
+        };
+        if graph
+            .facts
+            .get(image)
+            .is_some_and(|fact| matches!(fact.nullness, ImageNullPredicate::KnownIsNull(false)))
+        {
+            continue;
+        }
+        graph.set_evidence(*image, evidence)?;
+    }
+    Ok(())
+}
+
+fn propagate_once(
+    ctx: &Ctx,
+    instructions: &[Instruction],
+    graph: &mut FactGraph,
+) -> Result<bool, String> {
+    let mut changed = false;
+    for inst in instructions {
+        let Some(result) = inst.result_id else {
+            continue;
+        };
+        match (inst.class.opcode, inst.operands.as_slice()) {
+            (Op::CopyObject | Op::Bitcast, [Operand::IdRef(source)]) => {
+                changed |= alias_all(graph, result, *source)?;
+            }
+            (Op::Load, [Operand::IdRef(pointer)]) => {
+                if let Some(stored) = unique_store_value(ctx, *pointer) {
+                    changed |= alias_all(graph, result, stored)?;
+                }
+                changed |= alias_fields_between(graph, result, *pointer)?;
+            }
+            (Op::Store, [Operand::IdRef(pointer), Operand::IdRef(value)]) => {
+                if unique_store_value(ctx, *pointer) == Some(*value) {
+                    changed |= alias_all(graph, *pointer, *value)?;
+                    changed |= alias_fields_between(graph, *pointer, *value)?;
+                }
+            }
+            (Op::CompositeExtract, [Operand::IdRef(composite), rest @ ..]) => {
+                let path = literal_path(rest);
+                if let Some(source) = resolve_composite_path(ctx, *composite, &path) {
+                    changed |= alias_all(graph, result, source)?;
+                }
+                if let Some(fact) = graph.field_facts.get(&(*composite, path.clone())).cloned() {
+                    changed |= merge_fact(graph, result, fact)?;
+                }
+                if let Some(evidence) = graph
+                    .field_evidence
+                    .get(&(*composite, path.clone()))
+                    .copied()
+                {
+                    changed |= graph.set_evidence(result, evidence)?;
+                }
+            }
+            (Op::CompositeInsert, [Operand::IdRef(inserted), Operand::IdRef(base), rest @ ..]) => {
+                let path = literal_path(rest);
+                changed |= alias_fields_between(graph, result, *base)?;
+                if let Some(evidence) = graph.evidence.get(inserted).copied() {
+                    changed |= graph.set_field_evidence(result, path.clone(), evidence)?;
+                }
+                if let Some(fact) = graph.facts.get(inserted).cloned() {
+                    let entry = graph.field_facts.entry((result, path.clone())).or_default();
+                    let before = entry.clone();
+                    merge_into_fact_entry(entry, fact)?;
+                    changed |= *entry != before;
+                }
+                let inserted_fields = graph
+                    .field_evidence
+                    .iter()
+                    .filter(|((base, _), _)| base == inserted)
+                    .map(|((_, child), evidence)| (child.clone(), *evidence))
+                    .collect::<Vec<_>>();
+                for (child, evidence) in inserted_fields {
+                    let mut nested = path.clone();
+                    nested.extend(child);
+                    changed |= graph.set_field_evidence(result, nested, evidence)?;
+                }
+            }
+            (
+                Op::Select,
+                [Operand::IdRef(condition), Operand::IdRef(when_true), Operand::IdRef(when_false)],
+            ) => {
+                if graph.evidence.contains_key(&result) || graph.facts.contains_key(&result) {
+                    if let Some(evidence) = graph.evidence.get(&result).copied() {
+                        changed |= graph.set_evidence(*when_true, evidence)?;
+                        changed |= graph.set_evidence(*when_false, evidence)?;
+                    }
+                }
+                let mut arms = Vec::new();
+                for arm in [*when_true, *when_false] {
+                    if let Some(evidence) = graph.evidence.get(&arm).copied() {
+                        changed |= graph.set_evidence(result, evidence)?;
+                        arms.push((arm, graph.facts.get(&arm).cloned()));
+                    }
+                }
+                changed |= merge_join_fields(graph, result, &[*when_true, *when_false])?;
+                if arms.len() == 2 && arms.iter().all(|(arm, _)| graph.facts.contains_key(arm)) {
+                    changed |= graph.set_join(
+                        result,
+                        vec![(*when_true, *condition), (*when_false, *condition)],
+                        ImageNullPredicate::Select {
+                            condition: *condition,
+                            when_true: *when_true,
+                            when_false: *when_false,
+                        },
+                    )?;
+                }
+            }
+            (Op::Phi, operands) if operands.len().is_multiple_of(2) => {
+                let pairs = operands
+                    .chunks_exact(2)
+                    .filter_map(|pair| match pair {
+                        [Operand::IdRef(value), Operand::IdRef(label)] => Some((*value, *label)),
+                        _ => None,
+                    })
+                    .collect::<Vec<_>>();
+                if pairs.len() != operands.len() / 2 {
+                    continue;
+                }
+                if let Some(evidence) = graph.evidence.get(&result).copied() {
+                    for (incoming, _) in &pairs {
+                        changed |= graph.set_evidence(*incoming, evidence)?;
+                    }
+                }
+                let incoming = pairs.iter().map(|(value, _)| *value).collect::<Vec<_>>();
+                changed |= merge_join_fields(graph, result, &incoming)?;
+                for (value, _) in &pairs {
+                    if let Some(evidence) = graph.evidence.get(value).copied() {
+                        changed |= graph.set_evidence(result, evidence)?;
+                    }
+                }
+                if pairs
+                    .iter()
+                    .all(|(value, _)| graph.facts.contains_key(value))
+                {
+                    changed |=
+                        graph.set_join(result, pairs.clone(), ImageNullPredicate::Phi(pairs))?;
+                }
+            }
+            _ => {}
+        }
+    }
+    Ok(changed)
+}
+
+fn alias_all(graph: &mut FactGraph, dst: Word, src: Word) -> Result<bool, String> {
+    let mut changed = graph.alias_fact(dst, src)?;
+    changed |= graph.alias_fact(src, dst)?;
+    if let Some(evidence) = graph.evidence.get(&src).copied() {
+        changed |= graph.set_evidence(dst, evidence)?;
+    }
+    if let Some(evidence) = graph.evidence.get(&dst).copied() {
+        changed |= graph.set_evidence(src, evidence)?;
+    }
+    Ok(changed)
+}
+
+fn alias_fields_between(graph: &mut FactGraph, a: Word, b: Word) -> Result<bool, String> {
+    let keys = graph
+        .field_evidence
+        .keys()
+        .chain(graph.field_facts.keys())
+        .filter(|(id, _)| *id == a || *id == b)
+        .cloned()
+        .collect::<BTreeSet<_>>();
+    let mut changed = false;
+    for (id, path) in keys {
+        let other = if id == a { b } else { a };
+        if let Some(evidence) = graph.field_evidence.get(&(id, path.clone())).copied() {
+            changed |= graph.set_field_evidence(other, path.clone(), evidence)?;
+        }
+        if let Some(fact) = graph.field_facts.get(&(id, path.clone())).cloned() {
+            changed |= graph.alias_field_fact(other, id, &path)?;
+            let entry = graph.field_facts.entry((other, path.clone())).or_default();
+            let before = entry.clone();
+            merge_into_fact_entry(entry, fact)?;
+            changed |= *entry != before;
+        }
+    }
+    Ok(changed)
+}
+
+fn merge_join_fields(graph: &mut FactGraph, result: Word, inputs: &[Word]) -> Result<bool, String> {
+    let mut changed = false;
+    let keys = graph
+        .field_evidence
+        .keys()
+        .chain(graph.field_facts.keys())
+        .filter(|(id, _)| inputs.contains(id) || *id == result)
+        .cloned()
+        .collect::<BTreeSet<_>>();
+    for (id, path) in keys {
+        if id == result {
+            if let Some(evidence) = graph.field_evidence.get(&(result, path.clone())).copied() {
+                for input in inputs {
+                    changed |= graph.set_field_evidence(*input, path.clone(), evidence)?;
+                }
+            }
+            if let Some(fact) = graph.field_facts.get(&(result, path.clone())).cloned() {
+                for input in inputs {
+                    let entry = graph.field_facts.entry((*input, path.clone())).or_default();
+                    let before = entry.clone();
+                    merge_into_fact_entry(entry, fact.clone())?;
+                    changed |= *entry != before;
+                }
+            }
+        } else {
+            if let Some(evidence) = graph.field_evidence.get(&(id, path.clone())).copied() {
+                changed |= graph.set_field_evidence(result, path.clone(), evidence)?;
+            }
+            if let Some(fact) = graph.field_facts.get(&(id, path.clone())).cloned() {
+                let entry = graph.field_facts.entry((result, path.clone())).or_default();
+                let before = entry.clone();
+                merge_into_fact_entry(entry, fact)?;
+                changed |= *entry != before;
+            }
+        }
+    }
+    Ok(changed)
+}
+
+fn merge_fact(graph: &mut FactGraph, id: Word, fact: ImageFacts) -> Result<bool, String> {
+    let entry = graph.facts.entry(id).or_default();
+    let before = entry.clone();
+    merge_into_fact_entry(entry, fact)?;
+    Ok(*entry != before)
+}
+
+fn merge_into_fact_entry(entry: &mut ImageFacts, fact: ImageFacts) -> Result<(), String> {
+    if let Some(shape) = fact.shape {
+        match entry.shape {
+            Some(current) if current != shape => {
+                return Err(format!(
+                    "image fact merge has contradictory shapes {current:?} and {shape:?}"
+                ))
+            }
+            None => entry.shape = Some(shape),
+            _ => {}
+        }
+    }
+    match (&entry.nullness, fact.nullness) {
+        (ImageNullPredicate::Unknown, incoming) => entry.nullness = incoming,
+        (_, ImageNullPredicate::Unknown) => {}
+        (current, incoming) if *current == incoming => {}
+        (current, incoming) => {
+            return Err(format!(
+                "image fact merge has contradictory nullness {current:?} and {incoming:?}"
+            ))
+        }
+    }
+    Ok(())
+}
+
+fn resolve_composite_path(ctx: &Ctx, mut value: Word, path: &[u32]) -> Option<Word> {
+    for _ in 0..32 {
+        let inst = value_def_instruction(ctx, value)?;
+        match inst.class.opcode {
+            Op::CopyObject => {
+                value = match inst.operands.first()? {
+                    Operand::IdRef(source) => *source,
+                    _ => return None,
+                };
+            }
+            Op::Load => {
+                let pointer = match inst.operands.first()? {
+                    Operand::IdRef(pointer) => *pointer,
+                    _ => return None,
+                };
+                value = unique_store_value(ctx, pointer)?;
+            }
+            Op::CompositeInsert => {
+                let inserted = match inst.operands.first()? {
+                    Operand::IdRef(id) => *id,
+                    _ => return None,
+                };
+                let base = match inst.operands.get(1)? {
+                    Operand::IdRef(id) => *id,
+                    _ => return None,
+                };
+                let insert_path = literal_path(&inst.operands[2..]);
+                if insert_path == path {
+                    return Some(inserted);
+                }
+                value = base;
+            }
+            _ => return None,
+        }
+    }
+    None
+}
+
+/// Value stored through `pointer`, when every store to it agrees on exactly one value.
+fn unique_store_value(ctx: &Ctx, pointer: Word) -> Option<Word> {
+    let mut found = None;
+    for inst in ctx.module.all_inst_iter().chain(ctx.new_globals.iter()) {
+        if inst.class.opcode != Op::Store || inst.operands.first() != Some(&Operand::IdRef(pointer))
+        {
+            continue;
+        }
+        let Some(Operand::IdRef(value)) = inst.operands.get(1) else {
+            return None;
+        };
+        if found.replace(*value).is_some() {
+            return None;
+        }
+    }
+    found
+}
+
+fn materialize_is_null_predicates(
+    ctx: &mut Ctx,
+    entry_idx: usize,
+    names: &HashMap<Word, String>,
+) -> Result<(), String> {
+    let calls = ctx.module.functions[entry_idx]
+        .blocks
+        .iter()
+        .flat_map(|block| &block.instructions)
+        .filter(|inst| inst.class.opcode == Op::FunctionCall)
+        .filter_map(|inst| {
+            let Operand::IdRef(callee) = inst.operands.first()? else {
+                return None;
+            };
+            names
+                .get(callee)
+                .is_some_and(|name| name.starts_with("air.is_null_texture"))
+                .then(|| match inst.operands.get(1) {
+                    Some(Operand::IdRef(image)) => Some(*image),
+                    _ => None,
+                })
+        })
+        .flatten()
+        .collect::<Vec<_>>();
+    for image in calls {
+        let mut visiting = HashSet::new();
+        materialize_predicate(ctx, image, &mut visiting)?;
+    }
+    Ok(())
+}
+
+fn materialize_predicate(
+    ctx: &mut Ctx,
+    image: Word,
+    visiting: &mut HashSet<Word>,
+) -> Result<Word, String> {
+    if let Some(value) = ctx.materialized_null_predicates.get(&image).copied() {
+        return Ok(value);
+    }
+    if !visiting.insert(image) {
+        return Err(format!(
+            "cyclic image null predicate at %{image}; a phi backedge must name the materialized phi itself"
+        ));
+    }
+    let fact =
+        ctx.image_facts.get(&image).cloned().ok_or_else(|| {
+            format!("no image shape/null fact for is_null_texture operand %{image}")
+        })?;
+    let value = match fact.nullness.clone() {
+        ImageNullPredicate::KnownIsNull(is_null) => {
+            let bool_ty = ctx.ty_bool();
+            ctx.const_bool_of(bool_ty, is_null)
+        }
+        ImageNullPredicate::GpuToken { low, high } => {
+            let mut ops = Vec::new();
+            let uint = ctx.ty_uint();
+            let zero = ctx.const_uint(0);
+            let words = ctx.module.fresh_id();
+            ops.push(Instruction::new(
+                Op::BitwiseOr,
+                Some(uint),
+                Some(words),
+                vec![Operand::IdRef(low), Operand::IdRef(high)],
+            ));
+            let boolean = ctx.ty_bool();
+            let value = ctx.module.fresh_id();
+            ops.push(Instruction::new(
+                Op::IEqual,
+                Some(boolean),
+                Some(value),
+                vec![Operand::IdRef(words), Operand::IdRef(zero)],
+            ));
+            insert_after_image_definition(ctx, image, ops)?;
+            value
+        }
+        ImageNullPredicate::Select {
+            condition,
+            when_true,
+            when_false,
+        } => {
+            let when_true = materialize_predicate(ctx, when_true, visiting)?;
+            let when_false = materialize_predicate(ctx, when_false, visiting)?;
+            let bool_ty = ctx.ty_bool();
+            let value = ctx.module.fresh_id();
+            insert_after_image_definition(
+                ctx,
+                image,
+                vec![Instruction::new(
+                    Op::Select,
+                    Some(bool_ty),
+                    Some(value),
+                    vec![
+                        Operand::IdRef(condition),
+                        Operand::IdRef(when_true),
+                        Operand::IdRef(when_false),
+                    ],
+                )],
+            )?;
+            value
+        }
+        ImageNullPredicate::Phi(arms) => {
+            let bool_ty = ctx.ty_bool();
+            let value = ctx.module.fresh_id();
+            // A loop header's backedge names the image phi itself. Reserving the boolean phi before
+            // walking the incoming values makes that self edge direct rather than recursive.
+            ctx.materialized_null_predicates.insert(image, value);
+            let mut operands = Vec::with_capacity(arms.len() * 2);
+            for (incoming, predecessor) in arms {
+                let predicate = if incoming == image {
+                    value
+                } else {
+                    materialize_predicate(ctx, incoming, visiting)?
+                };
+                operands.push(Operand::IdRef(predicate));
+                operands.push(Operand::IdRef(predecessor));
+            }
+            insert_phi(
+                ctx,
+                image,
+                Instruction::new(Op::Phi, Some(bool_ty), Some(value), operands),
+            )?;
+            value
+        }
+        ImageNullPredicate::Unknown => {
+            return Err(format!(
+                "is_null_texture operand %{image} has no closed nullness predicate"
+            ))
+        }
+    };
+    visiting.remove(&image);
+    ctx.materialized_null_predicates.insert(image, value);
+    Ok(value)
+}
+
+fn insert_after_image_definition(
+    ctx: &mut Ctx,
+    image: Word,
+    instructions: Vec<Instruction>,
+) -> Result<(), String> {
+    for function in &mut ctx.module.functions {
+        for block in &mut function.blocks {
+            let Some(index) = block
+                .instructions
+                .iter()
+                .position(|inst| inst.result_id == Some(image))
+            else {
+                continue;
+            };
+            block
+                .instructions
+                .splice(index + 1..index + 1, instructions);
+            return Ok(());
+        }
+    }
+    // Function parameters and module-scope image declarations dominate every use; put ancillary
+    // predicate arithmetic in the entry block after its leading phis and local variables.
+    let entry = ctx
+        .module
+        .functions
+        .iter_mut()
+        .find(|function| !function.blocks.is_empty())
+        .ok_or_else(|| "cannot place image null predicate without a function body".to_string())?;
+    let block = &mut entry.blocks[0];
+    let at = block
+        .instructions
+        .iter()
+        .take_while(|inst| matches!(inst.class.opcode, Op::Phi | Op::Variable))
+        .count();
+    block.instructions.splice(at..at, instructions);
+    Ok(())
+}
+
+fn insert_phi(ctx: &mut Ctx, image: Word, phi: Instruction) -> Result<(), String> {
+    for function in &mut ctx.module.functions {
+        for block in &mut function.blocks {
+            if !block
+                .instructions
+                .iter()
+                .any(|inst| inst.result_id == Some(image) && inst.class.opcode == Op::Phi)
+            {
+                continue;
+            }
+            let at = block
+                .instructions
+                .iter()
+                .take_while(|inst| inst.class.opcode == Op::Phi)
+                .count();
+            block.instructions.insert(at, phi);
+            return Ok(());
+        }
+    }
+    Err(format!(
+        "cannot materialize null predicate for image phi %{image}: defining block not found"
+    ))
+}
+
+fn shape_from_image_value(ctx: &Ctx, image: Word) -> Option<ImageShape> {
+    let mut ty = value_result_type(ctx, image)?;
+    for _ in 0..4 {
+        let def = type_def_of(ctx, ty)?;
+        match def.class.opcode {
+            Op::TypePointer => {
+                ty = match def.operands.get(1)? {
+                    Operand::IdRef(pointee) => *pointee,
+                    _ => return None,
+                };
+            }
+            Op::TypeImage => {
+                let sampled_ty = match def.operands.first()? {
+                    Operand::IdRef(id) => *id,
+                    _ => return None,
+                };
+                let comp = match type_def_of(ctx, sampled_ty)?.class.opcode {
+                    Op::TypeFloat => ImageComp::Float,
+                    Op::TypeInt => match type_def_of(ctx, sampled_ty)?.operands.get(1) {
+                        Some(Operand::LiteralBit32(0)) => ImageComp::Uint,
+                        Some(Operand::LiteralBit32(1)) => ImageComp::Sint,
+                        _ => return None,
+                    },
+                    _ => return None,
+                };
+                let dim = match def.operands.get(1)? {
+                    Operand::Dim(dim) => *dim,
+                    _ => return None,
+                };
+                let depth = matches!(def.operands.get(2), Some(Operand::LiteralBit32(1)));
+                let arrayed = matches!(def.operands.get(3), Some(Operand::LiteralBit32(1)));
+                let multisampled = matches!(def.operands.get(4), Some(Operand::LiteralBit32(1)));
+                let sampled = match def.operands.get(5) {
+                    Some(Operand::LiteralBit32(1)) => true,
+                    Some(Operand::LiteralBit32(2)) => false,
+                    _ => ctx.image_storage.contains(&image),
+                };
+                let access = match (dim, sampled) {
+                    (Dim::DimBuffer, true) => ImageAccess::UniformTexel,
+                    (Dim::DimBuffer, false) => ImageAccess::StorageTexel,
+                    (_, true) => ImageAccess::Sampled,
+                    (_, false) => ImageAccess::Storage,
+                };
+                return Some(ImageShape {
+                    dim,
+                    arrayed,
+                    comp,
+                    depth,
+                    multisampled,
+                    access,
+                });
+            }
+            _ => return None,
+        }
+    }
+    None
+}
+
+fn intrinsic_evidence(
+    ctx: &Ctx,
+    name: &str,
+    inst: &Instruction,
+) -> Result<Option<ImageShapeEvidence>, String> {
+    let Some((dim, arrayed)) = intrinsic_texture_shape(name) else {
+        return Ok(None);
+    };
+    if name.starts_with("air.get_null_texture") {
+        return Ok(None);
+    }
+    let is_null = name.starts_with("air.is_null_texture");
+    let depth = intrinsic_depth_evidence(name);
+    let multisampled = name
+        .split('.')
+        .nth(1)
+        .is_some_and(|family| family.ends_with("_ms") || family.ends_with("_ms_array"));
+    let evidence = ImageShapeEvidence {
+        dim: Some(dim),
+        arrayed: Some(arrayed),
+        comp: if is_null {
+            None
+        } else {
+            intrinsic_component(name)
+        },
+        depth,
+        multisampled: multisampled.then_some(true),
+        access: intrinsic_access(ctx, name, inst, dim)?,
+    };
+    Ok(Some(evidence))
+}
+
+fn intrinsic_access(
+    ctx: &Ctx,
+    name: &str,
+    inst: &Instruction,
+    dim: Dim,
+) -> Result<Option<ImageAccess>, String> {
+    let storage = || {
+        Some(if dim == Dim::DimBuffer {
+            ImageAccess::StorageTexel
+        } else {
+            ImageAccess::Storage
+        })
+    };
+    let sampled = || {
+        Some(if dim == Dim::DimBuffer {
+            ImageAccess::UniformTexel
+        } else {
+            ImageAccess::Sampled
+        })
+    };
+    if name.starts_with("air.is_null_texture") || name.starts_with("air.get_") {
+        // Queries and nullness do not select a descriptor compatibility class. The resource's
+        // structural image type or an actual sample/read/write use supplies it.
+        return Ok(None);
+    }
+    if name.starts_with("air.sample_") || name.starts_with("air.gather_") {
+        return Ok(sampled());
+    }
+    let write = name.starts_with("air.write_texture")
+        || name.starts_with("air.write_depth")
+        || name.starts_with("air.write_imageblock_slice_to_texture")
+        || name.starts_with("air.atomic_fetch_")
+            && (name.contains("_texture_") || name.contains("_depth_"));
+    if write {
+        return Ok(storage());
+    }
+    if name.starts_with("air.read_texture") || name.starts_with("air.read_depth") {
+        let Some(Operand::IdRef(access)) = inst.operands.last() else {
+            return Ok(None);
+        };
+        let value = match value_def_instruction(ctx, *access) {
+            Some(definition) => match definition.operands.first() {
+                Some(Operand::LiteralBit32(value)) => *value,
+                _ => return Ok(None),
+            },
+            None => return Ok(None),
+        };
+        return match value {
+            0 => Ok(None),
+            1 => Ok(sampled()),
+            2 | 3 => Ok(storage()),
+            _ => Err(format!(
+                "AIR image access {value} in {name} is not a known image access class"
+            )),
+        };
+    }
+    Ok(None)
+}
+
+pub(in crate::passes) fn intrinsic_component(name: &str) -> Option<ImageComp> {
+    let suffix = name.rsplit('.').next()?;
+    match suffix {
+        "v4f16" | "v4f32" | "f16" | "f32" => Some(ImageComp::Float),
+        "v4i16" | "v4i32" | "i16" | "i32" => Some(if name.split('.').any(|part| part == "u") {
+            ImageComp::Uint
+        } else {
+            ImageComp::Sint
+        }),
+        _ => None,
+    }
+}
+
+fn intrinsic_depth_evidence(name: &str) -> Option<bool> {
+    const DEPTH: &[&str] = &[
+        "air.sample_depth",
+        "air.sample_compare_depth",
+        "air.gather_depth",
+        "air.gather_compare_depth",
+        "air.read_depth",
+        "air.write_depth",
+        "air.get_width_depth",
+        "air.get_height_depth",
+        "air.get_depth_depth",
+        "air.get_num_mip_levels_depth",
+        "air.get_num_samples_depth",
+        "air.get_array_size_depth",
+    ];
+    if DEPTH.iter().any(|prefix| name.starts_with(prefix)) {
+        return Some(true);
+    }
+    const COLOR: &[&str] = &[
+        "air.sample_texture",
+        "air.gather_texture",
+        "air.read_texture",
+        "air.write_texture",
+        "air.get_width_texture",
+        "air.get_height_texture",
+        "air.get_depth_texture",
+        "air.get_num_mip_levels_texture",
+        "air.get_num_samples_texture",
+        "air.get_array_size_texture",
+    ];
+    COLOR
+        .iter()
+        .any(|prefix| name.starts_with(prefix))
+        .then_some(false)
+}
