+//! ABI 9 null descriptors and stage-local registry relocation.
+use super::*;
+
+impl Ctx {
+    pub(in crate::passes) fn null_shape_from_type(&self, ty: Word) -> Result<ImageShape, String> {
+        let image = self
+            .module
+            .all_inst_iter()
+            .chain(self.new_globals.iter())
+            .find(|inst| inst.result_id == Some(ty))
+            .ok_or("missing image type")?;
+        let [Operand::IdRef(component), Operand::Dim(dim), Operand::LiteralBit32(depth), Operand::LiteralBit32(arrayed), Operand::LiteralBit32(ms), Operand::LiteralBit32(sampled), ..] =
+            image.operands.as_slice()
+        else {
+            return Err("invalid null image type".into());
+        };
+        let component = self
+            .module
+            .all_inst_iter()
+            .chain(self.new_globals.iter())
+            .find(|inst| inst.result_id == Some(*component))
+            .ok_or("missing image component")?;
+        let comp = match (component.class.opcode, component.operands.as_slice()) {
+            (Op::TypeFloat, _) => ImageComp::Float,
+            (Op::TypeInt, [_, Operand::LiteralBit32(0)]) => ImageComp::Uint,
+            (Op::TypeInt, [_, Operand::LiteralBit32(1)]) => ImageComp::Sint,
+            _ => return Err("invalid image component type".into()),
+        };
+        let access = match (*dim == Dim::DimBuffer, sampled) {
+            (false, 1) => ImageAccess::Sampled,
+            (false, 2) => ImageAccess::Storage,
+            (true, 1) => ImageAccess::UniformTexel,
+            (true, 2) => ImageAccess::StorageTexel,
+            _ => return Err("image access is not explicit".into()),
+        };
+        let shape = ImageShape {
+            dim: *dim,
+            arrayed: *arrayed != 0,
+            depth: *depth != 0,
+            multisampled: *ms != 0,
+            comp,
+            access,
+        };
+        shape.validate()?;
+        Ok(shape)
+    }
+
+    pub(in crate::passes) fn restore_null_shape_indices(
+        &mut self,
+        words: &[u32],
+    ) -> Result<HashMap<Word, ImageShape>, String> {
+        let metadata = self.module.annotations.iter().find_map(|inst| match inst.operands.as_slice() {
+            [Operand::IdRef(id), Operand::Decoration(spirv::Decoration::Binding), Operand::LiteralBit32(674)] => Some(*id), _ => None,
+        });
+        let Some(metadata) = metadata else {
+            return Ok(HashMap::new());
+        };
+        let constants = self
+            .module
+            .types_global_values
+            .iter()
+            .filter_map(|inst| {
+                match (inst.class.opcode, inst.result_id, inst.operands.as_slice()) {
+                    (Op::Constant, Some(id), [Operand::LiteralBit32(value)]) => Some((id, *value)),
+                    _ => None,
+                }
+            })
+            .collect::<HashMap<_, _>>();
+        let uint = self.ty_uint();
+        let mut pointers = HashMap::new();
+        for fi in 0..self.module.functions.len() {
+            for bi in 0..self.module.functions[fi].blocks.len() {
+                let mut body = self.module.functions[fi].blocks[bi].instructions.clone();
+                for inst in &mut body {
+                    if let [Operand::IdRef(base), _, Operand::IdRef(slot)] =
+                        inst.operands.as_slice()
+                    {
+                        if *base == metadata
+                            && matches!(
+                                inst.class.opcode,
+                                Op::AccessChain | Op::InBoundsAccessChain
+                            )
+                        {
+                            let Some(index) =
+                                constants.get(slot).and_then(|index| index.checked_sub(32))
+                            else {
+                                continue;
+                            };
+                            let word = *words
+                                .get(index as usize)
+                                .ok_or("null metadata index exceeds cached registry")?;
+                            let shape = ImageShape::from_canonical_word(word)?;
+                            let slot = self.module.fresh_id();
+                            self.new_globals.push(Instruction::new(
+                                Op::Constant,
+                                Some(uint),
+                                Some(slot),
+                                vec![Operand::LiteralBit32(0)],
+                            ));
+                            self.null_index_fixups.insert(slot, shape);
+                            inst.operands[2] = Operand::IdRef(slot);
+                            if let Some(id) = inst.result_id {
+                                pointers.insert(id, shape);
+                            }
+                        }
+                    }
+                }
+                self.module.functions[fi].blocks[bi].instructions = body;
+            }
+        }
+        Ok(self
+            .module
+            .all_inst_iter()
+            .filter_map(
+                |inst| match (inst.class.opcode, inst.result_id, inst.operands.first()) {
+                    (Op::Load, Some(id), Some(Operand::IdRef(pointer))) => pointers
+                        .get(pointer)
+                        .copied()
+                        .filter(|shape| !shape.access.is_texel())
+                        .map(|shape| (id, shape)),
+                    _ => None,
+                },
+            )
+            .collect())
+    }
+
+    pub(in crate::passes) fn rebase_cached_null_images(
+        &mut self,
+        loads: &HashMap<Word, ImageShape>,
+    ) -> Result<(), String> {
+        if loads.is_empty() {
+            return Ok(());
+        }
+        let table = self.module.annotations.iter().find_map(|inst| match inst.operands.as_slice() {
+            [Operand::IdRef(id), Operand::Decoration(spirv::Decoration::Binding), Operand::LiteralBit32(672)] => Some(*id), _ => None,
+        }).ok_or("cached null image rebase needs token table")?;
+        let uint = self.ty_uint();
+        let zero = self.const_uint(0);
+        let pointer_ty = self.ty_ptr(StorageClass::StorageBuffer, uint);
+        for fi in 0..self.module.functions.len() {
+            for bi in 0..self.module.functions[fi].blocks.len() {
+                let mut body = Vec::new();
+                for mut inst in self.module.functions[fi].blocks[bi].instructions.clone() {
+                    if let Some((id, shape)) = inst
+                        .result_id
+                        .and_then(|id| loads.get(&id).map(|shape| (id, shape)))
+                    {
+                        let raw = self.module.fresh_id();
+                        inst.result_id = Some(raw);
+                        body.push(inst);
+                        let slot = self.const_uint(if shape.access == ImageAccess::Sampled {
+                            1
+                        } else {
+                            3
+                        });
+                        let pointer = self.module.fresh_id();
+                        body.push(Instruction::new(
+                            Op::AccessChain,
+                            Some(pointer_ty),
+                            Some(pointer),
+                            vec![
+                                Operand::IdRef(table),
+                                Operand::IdRef(zero),
+                                Operand::IdRef(slot),
+                            ],
+                        ));
+                        let count = self.module.fresh_id();
+                        body.push(Instruction::new(
+                            Op::Load,
+                            Some(uint),
+                            Some(count),
+                            vec![Operand::IdRef(pointer)],
+                        ));
+                        body.push(Instruction::new(
+                            Op::IAdd,
+                            Some(uint),
+                            Some(id),
+                            vec![Operand::IdRef(raw), Operand::IdRef(count)],
+                        ));
+                    } else {
+                        body.push(inst);
+                    }
+                }
+                self.module.functions[fi].blocks[bi].instructions = body;
+            }
+        }
+        Ok(())
+    }
+
+    pub(in crate::passes) fn null_descriptor_array(
+        &mut self,
+        shape: ImageShape,
+    ) -> Result<Word, String> {
+        shape.validate()?;
+        if self.descriptor_layout != crate::reflect::DescriptorLayout::default() {
+            return Err("ABI 9 null descriptors require the default descriptor layout".into());
+        }
+        if let Some(&var) = self.null_arrays.get(&shape) {
+            return Ok(var);
+        }
+        let image = self.ty_image_shape(shape);
+        let array = self.ty_runtime_array(image);
+        let pointer = self.ty_ptr(StorageClass::UniformConstant, array);
+        let var = self.module.fresh_id();
+        self.new_globals.push(Instruction::new(
+            Op::Variable,
+            Some(pointer),
+            Some(var),
+            vec![Operand::StorageClass(StorageClass::UniformConstant)],
+        ));
+        let set = match shape.access {
+            ImageAccess::Sampled | ImageAccess::UniformTexel => 2,
+            _ => 3,
+        };
+        decorate_binding(
+            &mut self.module,
+            var,
+            set,
+            u32::from(shape.access.is_texel()),
+        );
+        self.interface_buffer_var(var);
+        self.add_capability(spirv::Capability::RuntimeDescriptorArray);
+        if !self.module.extensions.iter().any(|inst| {
+            inst.operands == vec![Operand::LiteralString("SPV_EXT_descriptor_indexing".into())]
+        }) {
+            self.module.extensions.push(Instruction::new(
+                Op::Extension,
+                None,
+                None,
+                vec![Operand::LiteralString("SPV_EXT_descriptor_indexing".into())],
+            ));
+        }
+        if shape.access.is_texel() {
+            self.add_capability(if shape.access == ImageAccess::UniformTexel {
+                spirv::Capability::UniformTexelBufferArrayDynamicIndexing
+            } else {
+                spirv::Capability::StorageTexelBufferArrayDynamicIndexing
+            });
+            self.add_capability(if shape.access == ImageAccess::UniformTexel {
+                spirv::Capability::SampledBuffer
+            } else {
+                spirv::Capability::ImageBuffer
+            });
+        }
+        if shape.access == ImageAccess::Storage {
+            self.add_capability(spirv::Capability::StorageImageReadWithoutFormat);
+            self.add_capability(spirv::Capability::StorageImageWriteWithoutFormat);
+        }
+        self.null_arrays.insert(shape, var);
+        Ok(var)
+    }
+
+    pub(in crate::passes) fn null_descriptor_index(
+        &mut self,
+        shape: ImageShape,
+        table: Option<Word>,
+        out: &mut Vec<Instruction>,
+    ) -> Result<Word, String> {
+        shape.validate()?;
+        // This unique constant is relocated only after all lowering and global liveness finish.
+        let uint = self.ty_uint();
+        let slot = self.module.fresh_id();
+        self.new_globals.push(Instruction::new(
+            Op::Constant,
+            Some(uint),
+            Some(slot),
+            vec![Operand::LiteralBit32(0)],
+        ));
+        self.null_index_fixups.insert(slot, shape);
+        let metadata = self.sampler_coordinate_flags_var();
+        let zero = self.const_uint(0);
+        let pointer_ty = self.ty_ptr(StorageClass::StorageBuffer, uint);
+        let pointer = self.module.fresh_id();
+        out.push(Instruction::new(
+            Op::AccessChain,
+            Some(pointer_ty),
+            Some(pointer),
+            vec![
+                Operand::IdRef(metadata),
+                Operand::IdRef(zero),
+                Operand::IdRef(slot),
+            ],
+        ));
+        let index = self.module.fresh_id();
+        out.push(Instruction::new(
+            Op::Load,
+            Some(uint),
+            Some(index),
+            vec![Operand::IdRef(pointer)],
+        ));
+        if let Some(table) = table.filter(|_| !shape.access.is_texel()) {
+            let count_at = self.const_uint(if shape.access == ImageAccess::Sampled {
+                1
+            } else {
+                3
+            });
+            let count_ptr = self.module.fresh_id();
+            out.push(Instruction::new(
+                Op::AccessChain,
+                Some(pointer_ty),
+                Some(count_ptr),
+                vec![
+                    Operand::IdRef(table),
+                    Operand::IdRef(zero),
+                    Operand::IdRef(count_at),
+                ],
+            ));
+            let count = self.module.fresh_id();
+            out.push(Instruction::new(
+                Op::Load,
+                Some(uint),
+                Some(count),
+                vec![Operand::IdRef(count_ptr)],
+            ));
+            let tail = self.module.fresh_id();
+            out.push(Instruction::new(
+                Op::IAdd,
+                Some(uint),
+                Some(tail),
+                vec![Operand::IdRef(count), Operand::IdRef(index)],
+            ));
+            return Ok(tail);
+        }
+        Ok(index)
+    }
+}
