+pub(super) fn prune_dead_null_value_scaffolding(ctx: &mut Ctx) {
+    let mut candidates = ctx
+        .image_facts
+        .iter()
+        .filter_map(|(id, fact)| {
+            (!matches!(
+                fact.nullness,
+                ImageNullPredicate::KnownIsNull(false) | ImageNullPredicate::Unknown
+            ))
+            .then_some(*id)
+        })
+        .collect::<HashSet<_>>();
+    candidates.extend(ctx.null_image_values.iter().copied());
+    loop {
+        let used = ctx
+            .module
+            .functions
+            .iter()
+            .flat_map(|function| function.all_inst_iter())
+            .flat_map(|inst| &inst.operands)
+            .filter_map(|operand| match operand {
+                Operand::IdRef(id) => Some(*id),
+                _ => None,
+            })
+            .collect::<HashSet<_>>();
+        let mut retired = HashSet::new();
+        let mut dependencies = HashSet::new();
+        for function in &mut ctx.module.functions {
+            for block in &mut function.blocks {
+                block.instructions.retain(|inst| {
+                    let dead = inst
+                        .result_id
+                        .is_some_and(|id| candidates.contains(&id) && !used.contains(&id))
+                        && matches!(
+                            inst.class.opcode,
+                            Op::Load
+                                | Op::CopyObject
+                                | Op::Bitcast
+                                | Op::Select
+                                | Op::Phi
+                                | Op::AccessChain
+                                | Op::InBoundsAccessChain
+                                | Op::IAdd
+                        );
+                    if dead {
+                        retired.extend(inst.result_id);
+                        dependencies.extend(inst.operands.iter().filter_map(
+                            |operand| match operand {
+                                Operand::IdRef(id) => Some(*id),
+                                _ => None,
+                            },
+                        ));
+                    }
+                    !dead
+                });
+            }
+        }
+        if retired.is_empty() {
+            break;
+        }
+        candidates.extend(dependencies.into_iter().filter(|id| {
+            !ctx.image_facts
+                .get(id)
+                .is_some_and(|fact| matches!(fact.nullness, ImageNullPredicate::KnownIsNull(false)))
+        }));
+        for list in [&mut ctx.module.annotations, &mut ctx.module.debug_names] {
+            list.retain(|inst| !matches!(inst.operands.first(), Some(Operand::IdRef(id)) if retired.contains(id)));
+        }
+    }
+}
