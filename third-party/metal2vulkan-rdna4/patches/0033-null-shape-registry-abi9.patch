+use metal2vulkan::{
+    passes::{Stage, TransformOptions},
+    reflect::ResourceKind,
+};
+use std::{path::PathBuf, process::Command};
+
+fn translate(
+    body: &str,
+    declarations: &str,
+    label: &str,
+) -> (String, metal2vulkan::reflect::ShaderReflection) {
+    translate_with_sampler(body, declarations, label, false)
+}
+
+fn translate_with_sampler(
+    body: &str,
+    declarations: &str,
+    label: &str,
+    sampler: bool,
+) -> (String, metal2vulkan::reflect::ShaderReflection) {
+    let source = format!(
+        r#"target triple = "spirv-unknown-vulkan1.2"
+define void @main_kernel(ptr addrspace(1) %out) {{
+entry:
+{body}
+  ret void
+}}
+{declarations}
+!air.kernel = !{{!0}}
+!0 = !{{ptr @main_kernel, !1, !2}}
+!1 = !{{}}
+!2 = !{{!3}}
+!3 = !{{i32 0, !"air.buffer", !"air.buffer_size", i32 16, !"air.location_index", i32 0, i32 1, !"air.write", !"air.address_space", i32 1, !"air.arg_type_size", i32 16, !"air.arg_type_align_size", i32 4, !"air.arg_type_name", !"uint4", !"air.arg_name", !"out"}}
+"#
+    );
+    let source = if sampler {
+        source.replace("%out) {", "%out, ptr addrspace(2) %sampler) {")
+            .replace("!2 = !{!3}", "!2 = !{!3, !4}")
+            + "\n!4 = !{i32 1, !\"air.sampler\", !\"air.location_index\", i32 0, i32 1, !\"air.arg_type_name\", !\"sampler\", !\"air.arg_name\", !\"sampler\"}\n"
+    } else if label.starts_with("bound_") {
+        source.replace("%out) {", "%out, ptr addrspace(1) %bound) {")
+            .replace("!2 = !{!3}", "!2 = !{!3, !4}")
+            + "\n!4 = !{i32 1, !\"air.texture\", !\"air.location_index\", i32 0, i32 1, !\"air.read\", !\"air.arg_type_name\", !\"texture2d<float, read>\", !\"air.arg_name\", !\"bound\"}\n"
+    } else {
+        source
+    };
+    let dir: PathBuf =
+        std::env::temp_dir().join(format!("nullshape_{}_{}", std::process::id(), label));
+    std::fs::create_dir_all(&dir).unwrap();
+    let (bytes, reflection) = metal2vulkan::translate_sanitized_native_reflected(
+        &source,
+        Stage::Kernel,
+        &dir,
+        TransformOptions::default(),
+    )
+    .unwrap_or_else(|e| panic!("{label}: {e}"));
+    let path = dir.join("shader.spv");
+    std::fs::write(&path, bytes).unwrap();
+    let output = Command::new("spirv-dis").arg(&path).output().unwrap();
+    assert!(output.status.success());
+    (String::from_utf8(output.stdout).unwrap(), reflection)
+}
