new file mode 100644
--- /dev/null
+++ b/src/passes/resources/nonuniform.rs
@@ -0,0 +1,168 @@
+//! Descriptor indices derived from runtime values may differ between invocations.
+
+use std::collections::{HashMap, HashSet};
+
+use super::*;
+use spirv::{Capability, Decoration};
+
+pub(crate) fn decorate_nonuniform_descriptor_accesses(ctx: &mut Ctx) {
+    let defs = ctx
+        .module
+        .types_global_values
+        .iter()
+        .filter_map(|inst| inst.result_id.map(|id| (id, inst)))
+        .collect::<HashMap<_, _>>();
+    let constants = defs
+        .iter()
+        .filter_map(|(&id, inst)| {
+            matches!(inst.class.opcode, Op::Constant | Op::ConstantNull).then_some(id)
+        })
+        .collect::<HashSet<_>>();
+    let mut resources = HashMap::new();
+    for (&id, inst) in &defs {
+        if inst.class.opcode != Op::Variable {
+            continue;
+        }
+        let Some(pointer) = inst.result_type.and_then(|ty| defs.get(&ty)) else {
+            continue;
+        };
+        if pointer.operands.first() != Some(&Operand::StorageClass(StorageClass::UniformConstant)) {
+            continue;
+        }
+        let Some(Operand::IdRef(array_ty)) = pointer.operands.get(1) else {
+            continue;
+        };
+        let Some(array) = defs.get(array_ty) else {
+            continue;
+        };
+        if !matches!(array.class.opcode, Op::TypeArray | Op::TypeRuntimeArray) {
+            continue;
+        }
+        let Some(Operand::IdRef(element)) = array.operands.first() else {
+            continue;
+        };
+        let Some(element) = defs.get(element) else {
+            continue;
+        };
+        let capability = match element.class.opcode {
+            Op::TypeSampler => Capability::SampledImageArrayNonUniformIndexing,
+            Op::TypeImage => {
+                let storage = element.operands.get(5) == Some(&Operand::LiteralBit32(2));
+                match element.operands.get(1) {
+                    Some(Operand::Dim(spirv::Dim::DimBuffer)) => {
+                        if storage {
+                            Capability::StorageTexelBufferArrayNonUniformIndexing
+                        } else {
+                            Capability::UniformTexelBufferArrayNonUniformIndexing
+                        }
+                    }
+                    Some(Operand::Dim(spirv::Dim::DimSubpassData)) => {
+                        Capability::InputAttachmentArrayNonUniformIndexing
+                    }
+                    _ => {
+                        if storage {
+                            Capability::StorageImageArrayNonUniformIndexing
+                        } else {
+                            Capability::SampledImageArrayNonUniformIndexing
+                        }
+                    }
+                }
+            }
+            _ => continue,
+        };
+        resources.insert(id, (capability, false));
+    }
+    if resources.is_empty() {
+        return;
+    }
+    let mut capabilities = HashSet::new();
+    let mut decorated = HashSet::new();
+    loop {
+        let before = (resources.len(), decorated.len());
+        for function in &ctx.module.functions {
+            for inst in function.blocks.iter().flat_map(|block| &block.instructions) {
+                let Some(id) = inst.result_id else { continue };
+                if resources.get(&id).is_some_and(|(_, dynamic)| *dynamic) {
+                    continue;
+                }
+                let source = match inst.class.opcode {
+                    Op::AccessChain
+                    | Op::InBoundsAccessChain
+                    | Op::Load
+                    | Op::CopyObject
+                    | Op::Bitcast
+                    | Op::Image => inst.operands.first().and_then(|operand| match operand {
+                        Operand::IdRef(id) => resources.get(id).copied(),
+                        _ => None,
+                    }),
+                    Op::SampledImage | Op::Select | Op::Phi => inst
+                        .operands
+                        .iter()
+                        .filter_map(|operand| match operand {
+                            Operand::IdRef(id) => resources.get(id).copied(),
+                            _ => None,
+                        })
+                        .find(|(_, dynamic)| *dynamic),
+                    _ => None,
+                };
+                let Some((capability, mut dynamic)) = source else {
+                    continue;
+                };
+                if matches!(inst.class.opcode, Op::AccessChain | Op::InBoundsAccessChain) {
+                    dynamic |= inst.operands.iter().skip(1).any(|operand| match operand {
+                        Operand::IdRef(index) => !constants.contains(index),
+                        _ => false,
+                    });
+                }
+                resources.insert(id, (capability, dynamic));
+                if dynamic {
+                    capabilities.insert(capability);
+                    decorated.insert(id);
+                }
+            }
+        }
+        if before == (resources.len(), decorated.len()) {
+            break;
+        }
+    }
+    if decorated.is_empty() {
+        return;
+    }
+    if !ctx.module.extensions.iter().any(|inst| {
+        inst.operands.first()
+            == Some(&Operand::LiteralString(
+                "SPV_EXT_descriptor_indexing".into(),
+            ))
+    }) {
+        ctx.module.extensions.push(Instruction::new(
+            Op::Extension,
+            None,
+            None,
+            vec![Operand::LiteralString("SPV_EXT_descriptor_indexing".into())],
+        ));
+    }
+    ctx.add_capability(Capability::ShaderNonUniform);
+    let mut capabilities = capabilities.into_iter().collect::<Vec<_>>();
+    capabilities.sort_unstable_by_key(|capability| *capability as u32);
+    for capability in capabilities {
+        ctx.add_capability(capability);
+    }
+    let mut ids = decorated.into_iter().collect::<Vec<_>>();
+    ids.sort_unstable();
+    for id in ids {
+        let operands = vec![
+            Operand::IdRef(id),
+            Operand::Decoration(Decoration::NonUniform),
+        ];
+        if !ctx
+            .module
+            .annotations
+            .iter()
+            .any(|inst| inst.class.opcode == Op::Decorate && inst.operands == operands)
+        {
+            ctx.module
+                .annotations
+                .push(Instruction::new(Op::Decorate, None, None, operands));
+        }
+    }
+}
