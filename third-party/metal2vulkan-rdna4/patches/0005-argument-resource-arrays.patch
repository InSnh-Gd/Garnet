+    let copies = ctx.module.functions[entry_idx]
+        .blocks
+        .iter()
+        .flat_map(|block| &block.instructions)
+        .filter(|inst| matches!(inst.class.opcode, Op::CopyObject | Op::Bitcast))
+        .filter_map(|inst| match (inst.result_id, inst.operands.first()) {
+            (Some(id), Some(Operand::IdRef(source))) => Some((id, *source)),
+            _ => None,
+        })
+        .collect::<Vec<_>>();
+    loop {
