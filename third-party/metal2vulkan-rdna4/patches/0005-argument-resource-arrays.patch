+    ctx.interface_buffer_var(var);
+    let start = u64::from(sampler.field_offset);
+    let end = start + u64::from(length) * 8;
+    let fixed = ctx
+        .emit_sidecar
+        .buffer_pointer_field_loads
+        .iter()
+        .filter(|fact| {
+            fact.root == root
+                && fact.byte_offset >= start
+                && fact.byte_offset < end
+                && (fact.byte_offset - start) % 8 == 0
+        })
+        .map(|fact| (fact.id, ((fact.byte_offset - start) / 8) as u32))
+        .collect::<Vec<_>>();
+    let mut handles = fixed
+        .into_iter()
+        .map(|(id, element)| (id, ctx.const_uint(element)))
+        .collect::<HashMap<_, _>>();
+    handles.extend(
+        ctx.emit_sidecar
+            .buffer_pointer_dynamic_field_loads
+            .iter()
+            .filter(|fact| fact.root == root && fact.byte_offset == start)
+            .map(|fact| (fact.id, fact.index)),
+    );
