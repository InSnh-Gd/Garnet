+fn register_embedded_sampler_array(
+    ctx: &mut Ctx,
+    entry_idx: usize,
+    sampler: &crate::meta::EmbeddedSampler,
+    root: Word,
+    binding: u32,
+    length: u32,
+) -> Result<(), String> {
+    if length == 0 {
+        return Err("empty argument-buffer sampler array".into());
+    }
