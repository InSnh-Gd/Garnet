+    let array_ty = ctx.ty_array(sampler_ty, length);
+    let array_ptr = ctx.ty_ptr(StorageClass::UniformConstant, array_ty);
+    let elem_ptr = ctx.ty_ptr(StorageClass::UniformConstant, sampler_ty);
+    let var = ctx.module.fresh_id();
+    ctx.new_globals.push(Instruction::new(
+        Op::Variable,
+        Some(array_ptr),
+        Some(var),
+        vec![Operand::StorageClass(StorageClass::UniformConstant)],
+    ));
