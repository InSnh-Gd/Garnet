+            continue;
+        };
+        let decoded = decode_llvm_global(global)?;
+        let Some(logical) = decoded.strip_suffix(".MTL_VISIBLE_FN_REF") else {
+            continue;
+        };
+        if logical.is_empty() || stubs.contains_key(global) {
+            continue;
+        }
+        stubs.insert(global.to_string(), logical.to_string());
+        references.push(AirVisibleFunctionReference {
+            stub_global: global.to_string(),
+            symbol: logical.to_string(),
+        });
+    }
     Ok(references)
 }
 
