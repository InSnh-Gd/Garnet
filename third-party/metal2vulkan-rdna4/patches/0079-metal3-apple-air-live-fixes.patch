+#[test]
+fn native_threadgroup_atomic_array_of_struct_peels_index_zero() {
+    // Exact Apple AIR pattern from #169 (`k_float_atomics`): opaque-pointer index-0 GEP folds
+    // away, passing `[4 x %"struct.metal::_atomic.0"]` directly to `@air.atomic.local.*.i32` / `.f32`.
+    let ll = r#"
+target triple = "spirv-unknown-vulkan1.2"
+%"struct.metal::_atomic.0" = type { i32 }
+%"struct.metal::_atomic.1" = type { float }
+@tgU = internal addrspace(3) global [4 x %"struct.metal::_atomic.0"] zeroinitializer, align 4
+@tgF = internal addrspace(3) global [4 x %"struct.metal::_atomic.1"] zeroinitializer, align 4
+
+define void @k(ptr addrspace(1) %out) {
+entry:
+  tail call void @air.atomic.local.store.i32(ptr addrspace(3) nocapture @tgU, i32 0, i32 0, i32 1, i1 true)
+  tail call void @air.atomic.local.store.i32(ptr addrspace(3) nocapture getelementptr inbounds ([4 x %"struct.metal::_atomic.0"], ptr addrspace(3) @tgU, i64 0, i64 1, i32 0), i32 5000, i32 0, i32 1, i1 true)
+  tail call void @air.atomic.local.store.f32(ptr addrspace(3) nocapture @tgF, float 1.5, i32 0, i32 1, i1 true)
+  tail call void @air.wg.barrier(i32 2, i32 1)
+  %u0 = tail call i32 @air.atomic.local.add.u.i32(ptr addrspace(3) nocapture @tgU, i32 7, i32 0, i32 1, i1 true)
+  %u1 = tail call i32 @air.atomic.local.load.i32(ptr addrspace(3) nocapture @tgU, i32 0, i32 1, i1 true)
+  %f0 = tail call float @air.atomic.local.add.f32(ptr addrspace(3) nocapture @tgF, float 2.25, i32 0, i32 1, i1 true)
+  %f1 = tail call float @air.atomic.local.load.f32(ptr addrspace(3) nocapture @tgF, i32 0, i32 1, i1 true)
+  %fi = bitcast float %f1 to i32
+  %sum = add i32 %u1, %fi
+  store i32 %sum, ptr addrspace(1) %out, align 4
+  ret void
+}
+
+declare void @air.atomic.local.store.i32(ptr addrspace(3), i32, i32, i32, i1)
+declare i32 @air.atomic.local.load.i32(ptr addrspace(3), i32, i32, i1)
+declare i32 @air.atomic.local.add.u.i32(ptr addrspace(3), i32, i32, i32, i1)
+declare void @air.atomic.local.store.f32(ptr addrspace(3), float, i32, i32, i1)
+declare float @air.atomic.local.load.f32(ptr addrspace(3), i32, i32, i1)
+declare float @air.atomic.local.add.f32(ptr addrspace(3), float, i32, i32, i1)
+declare void @air.wg.barrier(i32, i32)
+
+!air.kernel = !{!0}
+!0 = !{ptr @k, !1, !2}
+!1 = !{}
+!2 = !{!3}
+!3 = !{i32 0, !"air.buffer", !"air.location_index", i32 0, i32 1, !"air.read_write", !"air.address_space", i32 1, !"air.arg_type_name", !"uint"}
+"#;
+    let tmp = std::env::temp_dir().join(format!(
+        "metal2vulkan_threadgroup_atomic_array_struct_{}",
+        std::process::id()
