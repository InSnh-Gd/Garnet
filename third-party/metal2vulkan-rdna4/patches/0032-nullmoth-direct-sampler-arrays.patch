+fn append_direct_samplers(bindings: &mut Vec<ResourceBinding>, first: u32, param: u32, count: u32) {
+    let end = first.checked_add(count);
+    if count == 0 || end.is_none_or(|end| end > SAMPLER_ARGUMENT_COUNT) {
+        let mut invalid = sampler_binding(first, Some(param));
+        invalid.descriptor = None;
+        bindings.push(invalid);
+        return;
+    }
+    for element in 0..count {
+        bindings.push(sampler_binding(first + element, Some(param)));
+    }
+}
