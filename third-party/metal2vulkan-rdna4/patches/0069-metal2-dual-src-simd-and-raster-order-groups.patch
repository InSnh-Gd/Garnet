+fn collect_raster_order_groups(
+    node: &str,
+    nodes: &HashMap<u32, String>,
+    groups: &mut Vec<u32>,
+) {
+    let scan_node = |text: &str, groups: &mut Vec<u32>| {
+        let toks = tokenize(text);
+        for pair in toks.windows(2) {
+            if let [Tok::Str(marker), Tok::Int(group)] = pair {
+                if marker == "air.raster_order_group" {
+                    groups.push(*group);
+                }
+            }
+        }
+    };
+    scan_node(node, groups);
+    let Some(sref) = struct_info_ref(node) else {
+        return;
+    };
+    let mut stack = vec![sref];
+    let mut seen = std::collections::HashSet::new();
+    while let Some(id) = stack.pop() {
+        if !seen.insert(id) {
+            continue;
+        }
+        let Some(sub) = nodes.get(&id) else { continue };
+        scan_node(sub, groups);
+        for child in refs_in(sub) {
+            stack.push(child);
+        }
+    }
+}
