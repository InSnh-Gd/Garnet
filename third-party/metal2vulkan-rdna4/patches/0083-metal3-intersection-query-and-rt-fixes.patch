+fn lower_air_intersection_queries(ll: &str, slot_base: u32) -> Result<Option<String>, String> {
+    if !ll.contains("_intersection_query") {
+        return Ok(None);
+    }
+
+    let scoped_lines = llvm_line_scopes(ll);
+    let descriptor_as_params = discover_descriptor_as_params(ll);
+
+    // Pass 1: discover every `allocate_intersection_query` -> unique slot_id per function scope.
+    let mut alloc_slots: HashMap<(usize, String), u32> = HashMap::new();
+    let mut scope_slots: HashMap<usize, Vec<u32>> = HashMap::new();
+    let mut next_slot = slot_base;
+    let mut ops_by_line: HashMap<usize, IqOpCall> = HashMap::new();
+    let mut null_ptr_vars: Vec<(usize, String)> = Vec::new();
+    let mut dead_load_lines: HashSet<usize> = HashSet::new();
+    let mut commit_aabb_slots: Vec<u32> = Vec::new();
+
+    for (line_idx, &(line, scope)) in scoped_lines.iter().enumerate() {
+        if scope == 0 {
+            continue;
+        }
+        let trimmed = line.trim_start();
+        let (lhs, call_part) = if let Some((l, r)) = trimmed.split_once(" = ") {
+            (Some(l.trim().to_string()), r.trim())
+        } else {
+            (None, trimmed)
+        };
+        let Some(at_pos) = call_part.find("@air.") else {
+            continue;
+        };
+        let Some(open_rel) = call_part[at_pos..].find('(') else {
+            continue;
+        };
+        let open = at_pos + open_rel;
+        let callee = &call_part[at_pos + 1..open];
+        let Some((op, has_instancing, has_motion)) = parse_iq_callee(callee) else {
+            continue;
+        };
+        let Some(close) = find_matching_paren(call_part, open) else {
+            return Err(format!("malformed @{callee} call: {trimmed}"));
+        };
+        let raw_arg_strs = split_top_level_commas(&call_part[open + 1..close]);
+        let mut raw_args = Vec::with_capacity(raw_arg_strs.len());
+        for a in raw_arg_strs {
+            let parsed = split_typed_arg(a)
+                .ok_or_else(|| format!("malformed operand {a:?} in @{callee}"))?;
+            raw_args.push(parsed);
+        }
+
+        if op == "allocate" {
+            let var = lhs
+                .clone()
+                .ok_or_else(|| format!("@{callee} missing result SSA value"))?;
+            let slot_id = next_slot;
+            next_slot += 1;
+            alloc_slots.insert((scope, var), slot_id);
+            scope_slots.entry(scope).or_default().push(slot_id);
+            ops_by_line.insert(
+                line_idx,
+                IqOpCall {
+                    lhs,
+                    op,
+                    has_instancing,
+                    has_motion,
+                    raw_args,
+                    slot_id,
+                    accel_is_bda: false,
+                    bda_source_load_ptr: None,
+                    bda_source_val: None,
+                },
+            );
+            continue;
+        }
+
+        let q_val = raw_args
+            .first()
+            .map(|(_, v)| v.as_str())
+            .ok_or_else(|| format!("@{callee} missing query handle operand"))?;
+        let slot_id = resolve_iq_slot(&scoped_lines, scope, q_val, &alloc_slots)
+            .ok_or_else(|| format!("@{callee} references untracked query handle {q_val}"))?;
+
+        let mut accel_is_bda = false;
+        let mut bda_source_load_ptr = None;
+        let mut bda_source_val = None;
+        if op == "reset" {
+            if raw_args.len() < 12 {
+                return Err(format!(
+                    "@{callee} has {} operands, expected >= 12",
+                    raw_args.len()
+                ));
+            }
+            let (accel_ty, accel_val) = &raw_args[5];
+            let (is_bda, src_ptr, src_val, dead_line) = classify_accel_operand(
+                &scoped_lines,
+                scope,
+                accel_ty,
+                accel_val,
+                &descriptor_as_params,
+            );
+            accel_is_bda = is_bda;
+            bda_source_load_ptr = src_ptr;
+            bda_source_val = src_val;
+            if let Some(dl) = dead_line {
+                dead_load_lines.insert(dl);
+            }
+        } else if op == "commit_bounding_box_intersection" {
+            if !commit_aabb_slots.contains(&slot_id) {
+                commit_aabb_slots.push(slot_id);
+            }
+        } else if matches!(
+            op.as_str(),
+            "get_candidate_primitive_data" | "get_committed_primitive_data"
+        ) {
+            if let Some(ref var) = lhs {
+                null_ptr_vars.push((scope, var.clone()));
+            }
+        }
+
+        ops_by_line.insert(
+            line_idx,
+            IqOpCall {
+                lhs,
+                op,
+                has_instancing,
