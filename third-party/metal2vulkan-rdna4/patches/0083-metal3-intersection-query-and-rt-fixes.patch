+struct IqOpCall {
+    lhs: Option<String>,
+    op: String,
+    has_instancing: bool,
+    has_motion: bool,
+    raw_args: Vec<(String, String)>,
+    slot_id: u32,
+    accel_is_bda: bool,
+    bda_source_load_ptr: Option<String>,
+    bda_source_val: Option<String>,
+}
+
+fn parse_iq_callee(callee: &str) -> Option<(String, bool, bool)> {
+    let rest = callee.strip_prefix("air.")?;
+    let marker = rest.find("_intersection_query")?;
+    let op = &rest[..marker];
+    let after = &rest[marker + "_intersection_query".len()..];
+    if !after.is_empty() && !after.starts_with('.') {
+        return None;
+    }
+    let tags = after.strip_prefix('.').unwrap_or("");
+    let has_instancing = tags
+        .split('.')
+        .any(|t| matches!(t, "instancing" | "multi_level_instancing"));
+    let has_motion = tags
+        .split('.')
+        .any(|t| matches!(t, "primitive_motion" | "instance_motion"));
+    Some((op.to_string(), has_instancing, has_motion))
+}
+
+fn resolve_iq_slot(
+    scoped_lines: &[(&str, usize)],
+    scope: usize,
+    q_val: &str,
+    alloc_slots: &HashMap<(usize, String), u32>,
+) -> Option<u32> {
+    let mut cur = q_val.trim().to_string();
+    for _ in 0..8 {
+        if let Some(&slot) = alloc_slots.get(&(scope, cur.clone())) {
+            return Some(slot);
+        }
+        if !cur.starts_with('%') {
+            return None;
+        }
+        let def_rhs = scoped_lines.iter().find_map(|&(line, s)| {
+            if s != scope {
+                return None;
+            }
+            let (lhs, rhs) = line.trim_start().split_once(" = ")?;
+            (lhs.trim() == cur).then_some(rhs.trim())
+        })?;
+        if let Some(rest) = def_rhs
+            .strip_prefix("bitcast ")
+            .or_else(|| def_rhs.strip_prefix("addrspacecast "))
+        {
+            if let Some((src, _)) = rest.split_once(" to ") {
+                if let Some((_, next_val)) = split_typed_arg(src) {
+                    cur = next_val;
+                    continue;
+                }
+            }
+        }
+        return None;
+    }
+    None
+}
