+/// Normalize Apple AIR `ray_data` (`ptr addrspace(5)`) pointers in linked intersection callbacks
+/// to thread/Private (`ptr`, i.e. `addrspace(0)`) so they match caller `alloca` payloads directly.
+fn normalize_ray_data_addrspace5(ll: &str) -> String {
+    if !ll.contains("addrspace(5)") {
+        return ll.to_string();
+    }
+    let mut out = String::with_capacity(ll.len());
+    for line in ll.lines() {
+        let mut s = line.replace("ptr addrspace(5)", "ptr");
+        if s.contains("addrspacecast ptr ") && s.contains(" to ptr") {
+            let trimmed = s.trim_start();
+            if let Some((_, rhs)) = trimmed.split_once(" = ") {
+                if rhs.starts_with("addrspacecast ptr ")
+                    && rhs
+                        .split_once(" to ")
+                        .is_some_and(|(_, dst)| dst.trim() == "ptr" || dst.trim().starts_with("ptr,"))
+                {
+                    s = s.replacen("addrspacecast ptr ", "bitcast ptr ", 1);
+                }
+            }
+        }
+        out.push_str(&s);
+        out.push('\n');
+    }
+    out
+}
