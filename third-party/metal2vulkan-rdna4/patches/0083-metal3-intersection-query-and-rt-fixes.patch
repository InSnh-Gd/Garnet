+/// Transitively fold dead `bitcast`/`addrspacecast`/`getelementptr`/`load`/`store` operations
+/// derived from null-substituted pointers (e.g. `primitive_data` before Wave 4 wiring) so dead
+/// null-guarded branches never attempt to emit a load from `null`.
+fn propagate_null_ptr_eliminations(
+    scoped_lines: &[(&str, usize)],
+    initial: &[(usize, String)],
+) -> (HashSet<usize>, Vec<(usize, String, String)>) {
+    if initial.is_empty() {
+        return (HashSet::new(), Vec::new());
+    }
+    let mut null_ptrs: HashSet<(usize, String)> = initial.iter().cloned().collect();
+    let mut drop_lines: HashSet<usize> = HashSet::new();
+    let mut replacements: Vec<(usize, String, String)> = initial
+        .iter()
+        .map(|(s, v)| (*s, v.clone(), "null".to_string()))
+        .collect();
+    let mut replaced_vars: HashSet<(usize, String)> = initial.iter().cloned().collect();
+
+    loop {
+        let mut progressed = false;
+        for (line_idx, &(line, scope)) in scoped_lines.iter().enumerate() {
+            if scope == 0 || drop_lines.contains(&line_idx) {
+                continue;
+            }
+            let trimmed = line.trim_start();
+            if let Some((lhs_raw, rhs_raw)) = trimmed.split_once(" = ") {
+                let lhs = lhs_raw.trim();
+                let rhs = rhs_raw.trim();
+                if rhs.starts_with("bitcast ")
+                    || rhs.starts_with("addrspacecast ")
+                    || rhs.starts_with("getelementptr ")
+                {
+                    let uses_null = null_ptrs
+                        .iter()
+                        .any(|(s, v)| *s == scope && line_uses_llvm_value(rhs, v));
+                    if uses_null {
+                        drop_lines.insert(line_idx);
+                        if null_ptrs.insert((scope, lhs.to_string())) {
+                            progressed = true;
+                        }
+                        if replaced_vars.insert((scope, lhs.to_string())) {
+                            replacements.push((scope, lhs.to_string(), "null".to_string()));
+                            progressed = true;
+                        }
+                    }
+                } else if let Some(rest) = rhs.strip_prefix("load ") {
+                    let rest = rest
+                        .strip_prefix("volatile ")
+                        .unwrap_or(rest)
+                        .trim_start();
+                    let parts = split_top_level_commas(rest);
+                    if parts.len() >= 2 {
+                        if let Some((_, ptr_val)) = split_typed_arg(parts[1]) {
+                            if null_ptrs.contains(&(scope, ptr_val)) {
+                                drop_lines.insert(line_idx);
+                                if replaced_vars.insert((scope, lhs.to_string())) {
+                                    replacements.push((
+                                        scope,
+                                        lhs.to_string(),
+                                        llvm_zero_literal(parts[0]).to_string(),
+                                    ));
+                                    progressed = true;
+                                }
+                            }
+                        }
+                    }
+                }
+            } else if let Some(rest) = trimmed.strip_prefix("store ") {
+                let rest = rest
+                    .strip_prefix("volatile ")
+                    .unwrap_or(rest)
+                    .trim_start();
+                let parts = split_top_level_commas(rest);
+                if parts.len() >= 2 {
+                    if let Some((_, ptr_val)) = split_typed_arg(parts[1]) {
+                        if null_ptrs.contains(&(scope, ptr_val)) {
+                            drop_lines.insert(line_idx);
+                            progressed = true;
+                        }
+                    }
+                }
+            }
+        }
+        if !progressed {
+            break;
+        }
+    }
+    (drop_lines, replacements)
+}
