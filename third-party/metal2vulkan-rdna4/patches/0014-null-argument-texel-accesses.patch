+
+    /// Drop embedded texture and sampler entries whose descriptors the finished module discarded.
+    ///
+    /// AIR metadata names these fields even when the specialized entry never reads one. The
+    /// interface pass then removes the unused descriptor, so reporting the metadata-only entry
+    /// asks a consumer to bind a resource the returned module does not declare. Keep the owner
+    /// fields in `argument_buffer_fields`: they describe the argument-buffer layout, not the set
+    /// of descriptors that survived specialization.
+    pub(crate) fn retract_unbound_embedded_resources(&mut self, module: &Module) {
+        use crate::spirv_module::Operand;
+        use std::collections::{BTreeSet, HashMap};
+
+        if !self.bindings.iter().any(|resource| {
+            matches!(
+                resource.kind,
+                ResourceKind::EmbeddedArgBufferTexture | ResourceKind::EmbeddedArgBufferSampler
+            )
+        }) {
+            return;
+        }
+        let types = module
+            .types_global_values
+            .iter()
+            .filter_map(|instruction| Some((instruction.result_id?, instruction)))
+            .collect::<HashMap<_, _>>();
+        let mut sets = HashMap::new();
+        let mut bindings = HashMap::new();
+        for instruction in &module.annotations {
+            if instruction.class.opcode != spirv::Op::Decorate {
+                continue;
+            }
+            match instruction.operands.as_slice() {
+                [Operand::IdRef(id), Operand::Decoration(spirv::Decoration::DescriptorSet), Operand::LiteralBit32(set)] =>
+                {
+                    sets.insert(*id, *set);
+                }
+                [Operand::IdRef(id), Operand::Decoration(spirv::Decoration::Binding), Operand::LiteralBit32(binding)] =>
+                {
+                    bindings.insert(*id, *binding);
+                }
+                _ => {}
+            }
+        }
+        let mut images = BTreeSet::new();
+        let mut samplers = BTreeSet::new();
+        for instruction in module
+            .types_global_values
+            .iter()
+            .filter(|instruction| instruction.class.opcode == spirv::Op::Variable)
+        {
+            let Some(variable) = instruction.result_id else {
+                continue;
+            };
+            let (Some(set), Some(binding)) = (sets.get(&variable), bindings.get(&variable)) else {
+                continue;
+            };
+            let Some(pointee) = instruction
+                .result_type
+                .and_then(|pointer| pointee_of(&types, pointer))
+            else {
+                continue;
+            };
+            match types
+                .get(&pointee)
+                .map(|instruction| instruction.class.opcode)
+            {
+                Some(spirv::Op::TypeImage) => {
+                    images.insert((*set, *binding));
+                }
+                Some(spirv::Op::TypeSampler) => {
+                    samplers.insert((*set, *binding));
+                }
+                _ => {}
+            }
+        }
+        self.bindings.retain(|resource| match resource.kind {
+            ResourceKind::EmbeddedArgBufferTexture => resource
+                .descriptor
+                .is_none_or(|location| images.contains(&(location.set, location.binding))),
+            ResourceKind::EmbeddedArgBufferSampler => resource
+                .descriptor
+                .is_none_or(|location| samplers.contains(&(location.set, location.binding))),
+            _ => true,
         });
     }
 
