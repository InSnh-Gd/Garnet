+use metal2vulkan::passes::{Stage, TransformOptions};
+use metal2vulkan::reflect::{ResourceKind, ShaderReflection};
+use std::path::Path;
+
+fn translate(source: &str) -> (Vec<u8>, ShaderReflection) {
+    let (sanitized, layout) = metal2vulkan::tools::sanitize_ll_text_with_datalayout(source);
+    metal2vulkan::translate_sanitized_native_reflected_unvalidated(
+        &sanitized,
+        Stage::Kernel,
+        Path::new(""),
+        TransformOptions {
+            kernel_local_size: [1, 1, 1],
+            ..Default::default()
+        },
+        layout.as_deref(),
+    )
+    .unwrap()
+}
+
+fn source(operation: &str) -> String {
+    let image = if operation == "none" {
+        ""
+    } else {
+        " %index = and i32 %i, 1\n %wide = zext i32 %index to i64\n %slot = getelementptr %Resources, ptr addrspace(2) %r, i64 0, i32 0, i64 %wide, i32 0\n %image = load ptr addrspace(1), ptr addrspace(2) %slot, align 8\n"
+    };
+    let body = match operation {
+        "sample" => " %filter_slot = getelementptr %Resources, ptr addrspace(2) %r, i64 0, i32 1, i64 %wide, i32 0\n %filter = load ptr addrspace(2), ptr addrspace(2) %filter_slot, align 8\n %result = call { <4 x float>, i8 } @air.sample_texture_2d.v4f32(ptr addrspace(1) %image, ptr addrspace(2) %filter, <2 x float> zeroinitializer, i1 true, <2 x i32> zeroinitializer, i1 true, float 0.0, float 0.0, i32 0)\n",
+        "read" => " %filter = call ptr addrspace(2) @air.get_read_sampler()\n %result = call { <4 x float>, i8 } @air.read_texture_2d.v4f32(ptr addrspace(1) %image, ptr addrspace(2) %filter, <2 x i32> zeroinitializer, <2 x i32> zeroinitializer, i32 0, i32 1)\n",
+        "none" => "",
+        _ => unreachable!(),
+    };
+    let output = if operation == "none" {
+        " store float 0.0, ptr addrspace(1) %out, align 4\n"
+    } else {
+        " %rgba = extractvalue { <4 x float>, i8 } %result, 0\n %red = extractelement <4 x float> %rgba, i32 0\n store float %red, ptr addrspace(1) %out, align 4\n"
+    };
+    let header = r#"target triple = "air64-apple-macosx"
+%Resources = type { [2 x %Image], [2 x %Filter] }
+%Image = type { ptr addrspace(1) }
+%Filter = type { ptr addrspace(2) }
+define void @resources(ptr addrspace(2) %r, ptr addrspace(1) %out, i32 %i) {
+entry:
+"#;
+    let footer = r#" ret void
+}
+declare ptr addrspace(2) @air.get_read_sampler()
+declare { <4 x float>, i8 } @air.read_texture_2d.v4f32(ptr addrspace(1), ptr addrspace(2), <2 x i32>, <2 x i32>, i32, i32)
+declare { <4 x float>, i8 } @air.sample_texture_2d.v4f32(ptr addrspace(1), ptr addrspace(2), <2 x float>, i1, <2 x i32>, i1, float, float, i32)
+!air.kernel = !{!0}
+!0 = !{ptr @resources, !1, !2}
+!1 = !{}
+!2 = !{!3, !4, !5}
+!3 = !{i32 0, !"air.indirect_buffer", !"air.buffer_size", i32 32, !"air.location_index", i32 3, i32 1, !"air.read", !"air.address_space", i32 2, !"air.struct_type_info", !6, !"air.arg_type_size", i32 32, !"air.arg_type_align_size", i32 8, !"air.arg_type_name", !"Resources"}
+!4 = !{i32 1, !"air.buffer", !"air.location_index", i32 0, i32 1, !"air.read_write", !"air.address_space", i32 1, !"air.arg_type_name", !"float"}
+!5 = !{i32 2, !"air.thread_position_in_grid", !"air.arg_type_name", !"uint"}
+!6 = !{i32 0, i32 16, i32 0, !"array<texture2d<float, sample>, 2>", !"images", !"air.indirect_argument", !7, i32 16, i32 16, i32 0, !"array<sampler, 2>", !"filters", !"air.indirect_argument", !8}
+!7 = !{i32 0, !"air.texture", !"air.location_index", i32 1, i32 2, !"air.sample", !"air.arg_type_name", !"array<texture2d<float, sample>, 2>"}
+!8 = !{i32 1, !"air.sampler", !"air.location_index", i32 4, i32 2, !"air.arg_type_name", !"array<sampler, 2>"}
+"#;
+    let source = [header, image, body, output, footer].concat();
+    if operation == "read" {
+        source
+            .replace("texture2d<float, sample>", "texture2d<float, read>")
+            .replace("!\"air.sample\"", "!\"air.read\"")
+    } else {
+        source
+    }
+}
+
+#[test]
+fn embedded_descriptor_reflection_tracks_the_finished_module_and_keeps_layout() {
+    for operation in ["sample", "read", "none"] {
+        let (spv, reflection) = translate(&source(operation));
+        let assembly = metal2vulkan::disassemble(&spv).unwrap();
+        for (kind, expected, binding) in [
+            (
+                ResourceKind::EmbeddedArgBufferTexture,
+                operation != "none",
+                32,
+            ),
+            (
+                ResourceKind::EmbeddedArgBufferSampler,
+                operation == "sample",
+                160,
+            ),
+        ] {
+            assert_eq!(
+                assembly.contains(&format!("Binding {binding}\n")),
+                expected,
+                "{operation}: {assembly}"
+            );
+            assert_eq!(
+                reflection.bindings.iter().any(|row| row.kind == kind),
+                expected,
+                "{operation}: {reflection:?}"
+            );
+        }
+        assert_eq!(reflection.argument_buffer_fields.len(), 2, "{operation}");
+        reflection.validate_descriptor_abi().unwrap();
+    }
+}
+
+#[test]
+fn scalar_descriptor_loads_that_survive_keep_their_binding() {
+    let (spv, reflection) = translate(include_str!("fixtures/argument_buffer_sampler.ll"));
+    let assembly = metal2vulkan::disassemble(&spv).unwrap();
+    for kind in [
+        ResourceKind::EmbeddedArgBufferTexture,
+        ResourceKind::EmbeddedArgBufferSampler,
+    ] {
+        let binding = reflection
+            .bindings
+            .iter()
+            .find(|row| row.kind == kind)
+            .unwrap()
+            .descriptor
+            .unwrap();
+        assert!(
+            assembly.contains(&format!("Binding {}\n", binding.binding)),
+            "{assembly}"
+        );
+    }
+    assert_eq!(reflection.argument_buffer_fields.len(), 3);
+}
