+//! Null argument textures must not access a descriptor of an unrelated image shape.
+
+use super::*;
+use crate::spirv_module::{Block, Function};
+use spirv::{Decoration, FunctionControl, SelectionControl};
+
+#[derive(Clone, Copy)]
+struct Image {
+    array: Word,
+    element: Word,
+    index: Word,
+}
+
+pub(in crate::passes) fn guard_argument_texel_accesses(ctx: &mut Ctx) -> Result<(), String> {
+    let mut sets = HashMap::new();
+    let mut bindings = HashMap::new();
+    for inst in &ctx.module.annotations {
+        match inst.operands.as_slice() {
+            [Operand::IdRef(id), Operand::Decoration(Decoration::DescriptorSet), Operand::LiteralBit32(set)] =>
+            {
+                sets.insert(*id, *set);
+            }
+            [Operand::IdRef(id), Operand::Decoration(Decoration::Binding), Operand::LiteralBit32(binding)] =>
+            {
+                bindings.insert(*id, *binding);
+            }
+            _ => {}
+        }
+    }
+    if !bindings
+        .iter()
+        .any(|(id, binding)| *binding == 672 && sets.get(id) == Some(&0))
+    {
+        return Ok(());
+    }
+    let defs = ctx
+        .module
+        .all_inst_iter()
+        .chain(ctx.new_globals.iter())
+        .filter_map(|inst| inst.result_id.map(|id| (id, inst.clone())))
+        .collect::<HashMap<_, _>>();
+    let mut arrays = HashMap::new();
+    for (&id, &set) in &sets {
+        if !matches!(set, 2 | 3) || bindings.get(&id) != Some(&0) {
+            continue;
+        }
+        let Some(pointer) = defs
+            .get(&id)
+            .and_then(|var| var.result_type)
+            .and_then(|ty| defs.get(&ty))
+        else {
+            continue;
+        };
+        let [Operand::StorageClass(StorageClass::UniformConstant), Operand::IdRef(array)] =
+            pointer.operands.as_slice()
+        else {
+            continue;
+        };
+        let Some(array) = defs
+            .get(array)
+            .filter(|array| array.class.opcode == Op::TypeRuntimeArray)
+        else {
+            continue;
+        };
+        if let [Operand::IdRef(element)] = array.operands.as_slice() {
+            arrays.insert(id, *element);
+        }
+    }
+    if arrays.is_empty() {
+        return Ok(());
+    }
+    let mut paths = HashMap::new();
+    let mut images = HashMap::new();
+    loop {
+        let before = (paths.len(), images.len());
+        for (&id, inst) in &defs {
+            match (inst.class.opcode, inst.operands.as_slice()) {
+                (
+                    Op::AccessChain | Op::InBoundsAccessChain,
+                    [Operand::IdRef(array), Operand::IdRef(index)],
+                ) => {
+                    if let Some(&element) = arrays.get(array) {
+                        paths.insert(
+                            id,
+                            Image {
+                                array: *array,
+                                element,
+                                index: *index,
+                            },
+                        );
+                    }
+                }
+                (Op::Load, [Operand::IdRef(pointer)]) => {
+                    if let Some(&image) = paths.get(pointer) {
+                        images.insert(id, image);
+                    }
+                }
+                (Op::CopyObject | Op::Bitcast | Op::Image, [Operand::IdRef(source)]) => {
+                    if let Some(&image) = images.get(source) {
+                        images.insert(id, image);
+                    }
+                }
+                (Op::SampledImage, [Operand::IdRef(source), _]) => {
+                    if let Some(&image) = images.get(source) {
+                        images.insert(id, image);
+                    }
+                }
+                _ => {}
+            }
+        }
+        if before == (paths.len(), images.len()) {
+            break;
+        }
+    }
+    // A helper owns the branch so loop headers, merge blocks and caller Phi predecessors stay intact.
+    for function in 0..ctx.module.functions.len() {
+        for block in 0..ctx.module.functions[function].blocks.len() {
+            let old = ctx.module.functions[function].blocks[block]
+                .instructions
+                .clone();
+            let mut body = Vec::with_capacity(old.len());
+            for inst in old {
+                if matches!(
+                    inst.class.opcode,
+                    Op::ImageFetch | Op::ImageRead | Op::ImageWrite
+                ) {
+                    if let Some(image) = inst.operands.first().and_then(|op| match op {
+                        Operand::IdRef(id) => images.get(id),
+                        _ => None,
+                    }) {
+                        body.push(guarded_call(ctx, &inst, *image, &defs)?);
+                        continue;
+                    }
+                }
+                body.push(inst);
+            }
+            ctx.module.functions[function].blocks[block].instructions = body;
+        }
+    }
+    let mut candidates = paths
+        .keys()
+        .chain(images.keys())
+        .copied()
+        .collect::<HashSet<_>>();
+    let mut retired = HashSet::new();
+    loop {
+        let used = ctx
+            .module
+            .functions
+            .iter()
+            .flat_map(Function::all_inst_iter)
+            .flat_map(|inst| &inst.operands)
+            .filter_map(|op| match op {
+                Operand::IdRef(id) => Some(*id),
+                _ => None,
+            })
+            .collect::<HashSet<_>>();
+        let dead = candidates
+            .difference(&used)
+            .copied()
+            .collect::<HashSet<_>>();
+        if dead.is_empty() {
+            break;
+        }
+        for function in &mut ctx.module.functions {
+            for block in &mut function.blocks {
+                block
+                    .instructions
+                    .retain(|inst| !inst.result_id.is_some_and(|id| dead.contains(&id)));
+            }
+        }
+        candidates.retain(|id| !dead.contains(id));
+        retired.extend(dead);
+    }
+    for instructions in [&mut ctx.module.annotations, &mut ctx.module.debug_names] {
+        instructions.retain(|inst| !matches!(inst.operands.first(), Some(Operand::IdRef(id)) if retired.contains(id)));
+    }
+    Ok(())
+}
+
+fn block(label: Word, instructions: Vec<Instruction>) -> Block {
+    Block {
+        label: Some(Instruction::new(Op::Label, None, Some(label), vec![])),
+        instructions,
+    }
+}
+
+fn guarded_call(
+    ctx: &mut Ctx,
+    inst: &Instruction,
+    image: Image,
+    defs: &HashMap<Word, Instruction>,
+) -> Result<Instruction, String> {
+    let uint = ctx.ty_uint();
+    let boolean = ctx.ty_bool();
+    let zero = ctx.const_uint(0);
+    let result_ty = inst.result_type.unwrap_or_else(|| ctx.ty_void());
+    let mut types = vec![Operand::IdRef(result_ty), Operand::IdRef(uint)];
+    let index = ctx.module.fresh_id();
+    let mut parameters = vec![Instruction::new(
+        Op::FunctionParameter,
+        Some(uint),
+        Some(index),
+        vec![],
+    )];
+    let mut arguments = vec![Operand::IdRef(image.index)];
+    let mut operation = inst.clone();
+    for operand in operation.operands.iter_mut().skip(1) {
+        if let Operand::IdRef(id) = operand {
+            // ConstOffset and other constant image operands must remain compile-time constants.
+            if defs.get(id).is_some_and(|def| {
+                matches!(
+                    def.class.opcode,
+                    Op::Constant
+                        | Op::ConstantComposite
+                        | Op::ConstantNull
+                        | Op::ConstantTrue
+                        | Op::ConstantFalse
+                        | Op::SpecConstant
+                        | Op::SpecConstantComposite
+                        | Op::SpecConstantOp
+                        | Op::SpecConstantTrue
+                        | Op::SpecConstantFalse
+                )
+            }) {
+                continue;
+            }
+            let ty = defs
+                .get(id)
+                .and_then(|def| def.result_type)
+                .ok_or("argument texel operand has no value type")?;
+            types.push(Operand::IdRef(ty));
+            arguments.push(Operand::IdRef(*id));
+            let parameter = ctx.module.fresh_id();
+            parameters.push(Instruction::new(
+                Op::FunctionParameter,
+                Some(ty),
+                Some(parameter),
+                vec![],
+            ));
+            *id = parameter;
+        }
+    }
+    let function_type = ctx.get_or_create(Op::TypeFunction, None, types);
+    let function = ctx.module.fresh_id();
+    let entry = ctx.module.fresh_id();
+    let access = ctx.module.fresh_id();
+    let exit = ctx.module.fresh_id();
+    let valid = ctx.module.fresh_id();
+    let first = vec![
+        Instruction::new(
+            Op::INotEqual,
+            Some(boolean),
+            Some(valid),
+            vec![Operand::IdRef(index), Operand::IdRef(zero)],
+        ),
+        Instruction::new(
+            Op::SelectionMerge,
+            None,
+            None,
+            vec![
+                Operand::IdRef(exit),
+                Operand::SelectionControl(SelectionControl::NONE),
+            ],
+        ),
+        Instruction::new(
+            Op::BranchConditional,
+            None,
+            None,
+            vec![
+                Operand::IdRef(valid),
+                Operand::IdRef(access),
+                Operand::IdRef(exit),
+            ],
+        ),
+    ];
+    let pointer_ty = ctx.ty_ptr(StorageClass::UniformConstant, image.element);
+    let pointer = ctx.module.fresh_id();
+    let loaded = ctx.module.fresh_id();
+    let mut body = vec![
+        Instruction::new(
+            Op::AccessChain,
+            Some(pointer_ty),
+            Some(pointer),
+            vec![Operand::IdRef(image.array), Operand::IdRef(index)],
+        ),
+        Instruction::new(
+            Op::Load,
+            Some(image.element),
+            Some(loaded),
+            vec![Operand::IdRef(pointer)],
+        ),
+    ];
+    operation.operands[0] = Operand::IdRef(loaded);
+    let result = operation.result_type.map(|_| ctx.module.fresh_id());
+    operation.result_id = result;
+    body.push(operation);
+    body.push(Instruction::new(
+        Op::Branch,
+        None,
+        None,
+        vec![Operand::IdRef(exit)],
+    ));
+    let mut last = vec![];
+    if let Some(result) = result {
+        let zero = ctx.const_null(result_ty);
+        let selected = ctx.module.fresh_id();
+        last.push(Instruction::new(
+            Op::Phi,
+            Some(result_ty),
+            Some(selected),
+            vec![
+                Operand::IdRef(zero),
+                Operand::IdRef(entry),
+                Operand::IdRef(result),
+                Operand::IdRef(access),
+            ],
+        ));
+        last.push(Instruction::new(
+            Op::ReturnValue,
+            None,
+            None,
+            vec![Operand::IdRef(selected)],
+        ));
+    } else {
+        last.push(Instruction::new(Op::Return, None, None, vec![]));
+    }
+    ctx.module.functions.push(Function {
+        def: Some(Instruction::new(
+            Op::Function,
+            Some(result_ty),
+            Some(function),
+            vec![
+                Operand::FunctionControl(FunctionControl::NONE),
+                Operand::IdRef(function_type),
+            ],
+        )),
+        end: Some(Instruction::new(Op::FunctionEnd, None, None, vec![])),
+        parameters,
+        blocks: vec![block(entry, first), block(access, body), block(exit, last)],
+    });
+    let mut operands = vec![Operand::IdRef(function)];
+    operands.extend(arguments);
+    Ok(Instruction::new(
+        Op::FunctionCall,
+        Some(result_ty),
+        Some(inst.result_id.unwrap_or_else(|| ctx.module.fresh_id())),
+        operands,
+    ))
+}
