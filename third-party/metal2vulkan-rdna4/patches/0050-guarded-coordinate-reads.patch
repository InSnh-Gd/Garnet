+use super::*;
+use crate::native::ir::LlType;
+
+fn sample(value: &str) -> String {
+    format!("%sample = call float @air.sample_texture_2d.f32(ptr addrspace(1) %image, ptr addrspace(2) %sampler, float {value})")
+}
+
+fn source(prefix: &str, load: &str) -> String {
+    format!("define float @main(ptr addrspace(2) %buffer, ptr addrspace(1) %output, ptr addrspace(1) %image, ptr addrspace(2) %sampler, i1 %condition, i64 %index) {{\nentry:\n br i1 %condition, label %arm, label %exit\narm:\n {prefix}\n %p = getelementptr i8, ptr addrspace(2) %buffer, i64 8\n %value = load {load}, ptr addrspace(2) %p, align 4\n {}\n br label %exit\nexit:\n %result = phi float [ %sample, %arm ], [ 0.0, %entry ]\n ret float %result\n}}\n", sample("%value"))
+}
+
+fn rewritten(source: &str) -> Vec<BodyBlock> {
+    let parsed = LlModule::parse_with_stage_meta(source, None, Some("main")).unwrap();
+    let function = &parsed.functions[0];
+    let mut blocks = function.blocks.clone();
+    reconverge(&parsed, function, &mut blocks);
+    blocks
+}
+
+fn named<'a>(blocks: &'a [BodyBlock], name: &str) -> &'a TirBlock {
+    blocks
+        .iter()
+        .find(|b| b.name == name)
+        .unwrap()
+        .typed
+        .as_ref()
+        .unwrap()
+}
+
+#[test]
+fn guarded_read_retains_true_predicate_and_reconverges_before_original_selection() {
+    let source = source("", "float");
+    let blocks = rewritten(&source);
+    assert_eq!(blocks.len(), 5);
+    let entry = &blocks[0];
+    assert!(!entry
+        .typed
+        .as_ref()
+        .unwrap()
+        .insts
+        .iter()
+        .any(|i| i.load().is_some()));
+    let TirTerminator::BrCond { cond, t, f } = &entry.typed.as_ref().unwrap().terminator else {
+        panic!()
+    };
+    assert_eq!(cond, "%condition");
+    let guard = named(&blocks, t);
+    assert_eq!(guard.insts.iter().filter(|i| i.load().is_some()).count(), 1);
+    let merge = named(&blocks, f);
+    assert_eq!(guard.terminator, TirTerminator::Br(f.clone()));
+    assert_eq!(
+        merge.terminator,
+        TirTerminator::BrCond {
+            cond: cond.clone(),
+            t: "%arm".into(),
+            f: "%exit".into()
+        }
+    );
+    let phi = merge
+        .insts
+        .iter()
+        .find(|i| i.result.as_deref() == Some("%value"))
+        .unwrap();
+    let Some((ty, incoming)) = phi.phi_incoming() else {
+        panic!()
+    };
+    assert_eq!(*ty, LlType::Float);
+    assert_eq!(incoming[1], (LlValue::Zero, entry.name.clone()));
+    assert!(!named(&blocks, "%arm")
+        .insts
+        .iter()
+        .any(|i| i.load().is_some()));
+    assert!(named(&blocks, "%arm")
+        .insts
+        .iter()
+        .any(|i| i.call().is_some()));
+    assert!(named(&blocks, "%exit").insts[0]
+        .phi_incoming()
+        .as_ref()
+        .unwrap()
+        .1
+        .iter()
+        .any(|(_, pred)| pred == f));
+    let parsed = LlModule::parse_with_stage_meta(&source, None, Some("main")).unwrap();
+    let mut repeated = blocks.clone();
+    reconverge(&parsed, &parsed.functions[0], &mut repeated);
+    assert_eq!(
+        repeated.iter().map(BodyBlock::lines).collect::<Vec<_>>(),
+        blocks.iter().map(BodyBlock::lines).collect::<Vec<_>>()
+    );
+}
+
+#[test]
+fn side_effects_ordered_reads_and_dynamic_addresses_remain_in_the_source_arm() {
+    for (prefix, load) in [
+        ("store i32 7, ptr addrspace(1) %output", "float"),
+        ("call void @side_effect()", "float"),
+        ("fence seq_cst", "float"),
+        ("", "volatile float"),
+        ("", "atomic float"),
+    ] {
+        let blocks = rewritten(&source(prefix, load));
+        assert_eq!(blocks.len(), 3, "{prefix} {load}");
+        assert!(named(&blocks, "%arm")
+            .insts
+            .iter()
+            .any(|i| i.opcode == TirOpcode::Load));
+    }
+    let blocks = rewritten(&source("", "float").replace("i64 8", "i64 %index"));
+    assert_eq!(blocks.len(), 3);
+}
+
+#[test]
+fn unrelated_numeric_loads_do_not_create_a_coordinate_phase() {
+    let source = source("", "float").replace(&sample("%value"), &sample("0.25"));
+    assert_eq!(rewritten(&source).len(), 3);
+}
+
+#[test]
+fn duplicate_predecessors_cannot_be_replaced_by_a_single_branch_guard() {
+    let source = source("", "float")
+        .replace("label %arm, label %exit", "label %arm, label %other")
+        .replace("arm:\n", "other:\n br label %arm\narm:\n");
+    assert_eq!(rewritten(&source).len(), 4);
+}
+
+#[test]
+fn generated_names_never_capture_existing_parameter_names() {
+    let source = source("", "float").replace("%index", "%metal2vulkan.guarded.read.0");
+    let blocks = rewritten(&source);
+    assert!(!blocks
+        .iter()
+        .any(|b| b.name == "%metal2vulkan.guarded.read.0"));
+}
+
+#[test]
+fn false_and_two_sided_guards_preserve_selected_values() {
+    let false_arm =
+        source("", "float").replace("label %arm, label %exit", "label %exit, label %arm");
+    let blocks = rewritten(&false_arm);
+    let TirTerminator::BrCond { t, f, .. } = &blocks[0].typed.as_ref().unwrap().terminator else {
+        panic!()
+    };
+    assert_eq!(
+        named(&blocks, f)
+            .insts
+            .iter()
+            .filter(|i| i.load().is_some())
+            .count(),
+        1
+    );
+    assert_eq!(named(&blocks, f).terminator, TirTerminator::Br(t.clone()));
+    let mut both =
+        source("", "float").replace("label %arm, label %exit", "label %arm, label %other");
+    both = both.replace("exit:\n", &format!("other:\n %other_p = getelementptr i8, ptr addrspace(2) %buffer, i64 12\n %other_value = load float, ptr addrspace(2) %other_p, align 4\n {}\n br label %exit\nexit:\n", sample("%other_value").replace("%sample", "%other_sample")))
+        .replace("[ 0.0, %entry ]", "[ %other_sample, %other ]");
+    let blocks = rewritten(&both);
+    assert_eq!(blocks.len(), 7);
+    let TirTerminator::BrCond { t, f, .. } = &blocks[0].typed.as_ref().unwrap().terminator else {
+        panic!()
+    };
+    for guard in [t, f] {
+        assert_eq!(
+            named(&blocks, guard)
+                .insts
+                .iter()
+                .filter(|i| i.load().is_some())
+                .count(),
+            1
+        );
+    }
+    let TirTerminator::Br(merge) = &named(&blocks, t).terminator else {
+        panic!()
+    };
+    assert_eq!(named(&blocks, merge).insts.len(), 2);
+    for phi in &named(&blocks, merge).insts {
+        let (_, incoming) = phi.phi_incoming().as_ref().unwrap();
+        assert!(incoming.iter().any(|(v, _)| v == &LlValue::Zero));
+        assert_eq!(
+            incoming.iter().map(|(_, p)| p).collect::<HashSet<_>>(),
+            HashSet::from([t, f])
+        );
+    }
+}
