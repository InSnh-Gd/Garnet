+++ b/src/native/guarded_reads.rs
@@ -0,0 +1,287 @@
+//! Reconverge guarded coordinate reads without speculating their memory accesses.
+//!
+//! Reads keep their source condition, then supply zero on inactive paths at a new merge before
+//! the original selection. Derivatives can use the dominating value after reconvergence while
+//! descriptor selection, sampling and side effects keep their original execution sites.
+
+use super::cfg::{BlockRole, BodyBlock};
+use super::ir::{LlFunction, LlModule, LlValue};
+use super::tir::{TirBlock, TirInst, TirOpcode, TirTerminator};
+use std::collections::{HashMap, HashSet};
+use std::sync::Arc;
+
+#[cfg(test)]
+mod tests;
+
+struct Arm {
+    block: usize,
+    reads: Vec<TirInst>,
+    dependencies: Vec<TirInst>,
+}
+
+pub(super) fn reconverge(parsed: &LlModule, function: &LlFunction, blocks: &mut Vec<BodyBlock>) {
+    if !parsed.entry_functions.contains(&function.name) {
+        return;
+    }
+    let positions = blocks
+        .iter()
+        .enumerate()
+        .map(|(i, b)| (b.name.clone(), i))
+        .collect::<HashMap<_, _>>();
+    let definitions = blocks
+        .iter()
+        .filter_map(|b| b.typed.as_ref())
+        .flat_map(|b| &b.insts)
+        .filter_map(|i| Some((i.result.as_deref()?, i)))
+        .collect::<HashMap<_, _>>();
+    let mut predecessors = HashMap::<&str, Vec<usize>>::new();
+    for (index, block) in blocks.iter().enumerate() {
+        if let Some(typed) = &block.typed {
+            for successor in typed.terminator.successors() {
+                predecessors.entry(successor).or_default().push(index);
+            }
+        }
+    }
+    let plans = blocks
+        .iter()
+        .enumerate()
+        .filter_map(|(header, block)| {
+            let TirTerminator::BrCond { t, f, .. } = &block.typed.as_ref()?.terminator else {
+                return None;
+            };
+            if t == f {
+                return None;
+            }
+            let arms = [t, f].map(|name| {
+                let index = *positions.get(name)?;
+                if index == header || predecessors.get(name.as_str())?.as_slice() != [header] {
+                    return None;
+                }
+                plan_arm(
+                    parsed,
+                    function,
+                    index,
+                    blocks[index].typed.as_ref()?,
+                    &definitions,
+                )
+            });
+            arms.iter().any(Option::is_some).then_some((header, arms))
+        })
+        .collect::<Vec<_>>();
+    if plans.is_empty() {
+        return;
+    }
+    let mut names = positions
+        .keys()
+        .cloned()
+        .chain(definitions.keys().map(|s| s.to_string()))
+        .chain(function.params.iter().map(|(name, _)| name.clone()))
+        .collect::<HashSet<_>>();
+    let mut serial = 0usize;
+    let mut additions = Vec::new();
+    for (header, arms) in plans {
+        let merge_name = fresh(&mut names, &mut serial);
+        let guard_names = arms
+            .each_ref()
+            .map(|arm| arm.as_ref().map(|_| fresh(&mut names, &mut serial)));
+        let original_header = blocks[header].name.clone();
+        let typed = blocks[header].typed.as_ref().expect("planned typed header");
+        let mut merge = typed.terminator_only_block(&merge_name);
+        let successors = typed
+            .terminator
+            .successors()
+            .iter()
+            .map(|s| s.to_string())
+            .collect::<Vec<_>>();
+        for successor in &successors {
+            if let Some(&index) = positions.get(successor) {
+                blocks[index]
+                    .typed_mut()
+                    .expect("planned typed arm")
+                    .rewrite_phi_predecessor(&original_header, &merge_name);
+            }
+        }
+        for (side, arm) in arms.into_iter().enumerate() {
+            let target = guard_names[side].as_deref().unwrap_or(&merge_name);
+            blocks[header]
+                .typed_mut()
+                .expect("planned typed header")
+                .redirect_successor(&successors[side], target);
+            let Some(arm) = arm else {
+                continue;
+            };
+            let name = guard_names[side].as_ref().expect("active arm label");
+            let inactive = guard_names[1 - side].as_ref().unwrap_or(&original_header);
+            let mut guard = merge.terminator_only_block(name);
+            guard.set_unconditional_branch(&merge_name);
+            let remap = arm
+                .dependencies
+                .iter()
+                .filter_map(|i| i.result.as_ref())
+                .map(|value| (value.clone(), fresh(&mut names, &mut serial)))
+                .collect::<HashMap<_, _>>();
+            guard.insts = arm.dependencies;
+            guard.rename(&remap);
+            for read in &arm.reads {
+                let value = read.result.as_ref().expect("planned read result");
+                let ty = &read.load().as_ref().expect("planned read").result_ty;
+                merge.push_value_phi(
+                    value,
+                    ty,
+                    &[
+                        (LlValue::Local(remap[value].clone()), name.clone()),
+                        (LlValue::Zero, inactive.clone()),
+                    ],
+                );
+            }
+            let removed = arm
+                .reads
+                .iter()
+                .filter_map(|i| i.result.as_ref())
+                .collect::<HashSet<_>>();
+            blocks[arm.block]
+                .typed_mut()
+                .expect("planned source arm")
+                .insts
+                .retain(|i| i.result.as_ref().is_none_or(|name| !removed.contains(name)));
+            additions.push(body(guard));
+        }
+        additions.push(body(merge));
+    }
+    blocks.extend(additions);
+}
+
+fn fresh(names: &mut HashSet<String>, serial: &mut usize) -> String {
+    loop {
+        let name = format!("%metal2vulkan.guarded.read.{serial}");
+        *serial += 1;
+        if names.insert(name.clone()) {
+            return name;
+        }
+    }
+}
+
+fn body(block: TirBlock) -> BodyBlock {
+    BodyBlock {
+        name: block.label.clone(),
+        role: BlockRole::Normal,
+        typed: Some(Arc::new(block)),
+    }
+}
+
+fn plan_arm(
+    parsed: &LlModule,
+    function: &LlFunction,
+    index: usize,
+    block: &TirBlock,
+    definitions: &HashMap<&str, &TirInst>,
+) -> Option<Arm> {
+    let local = block
+        .insts
+        .iter()
+        .filter_map(|i| i.result.as_deref())
+        .collect::<HashSet<_>>();
+    let mut needed = HashSet::new();
+    let mut pending = block
+        .insts
+        .iter()
+        .filter_map(|i| i.call().as_ref())
+        .filter(|call| {
+            [
+                "air.sample_texture",
+                "air.sample_depth",
+                "air.sample_compare_depth",
+            ]
+            .iter()
+            .any(|prefix| call.callee.starts_with(prefix))
+        })
+        .filter_map(|call| {
+            match &call
+                .args
+                .get(if call.callee.starts_with("air.sample_texture") {
+                    2
+                } else {
+                    3
+                })?
+                .value
+            {
+                LlValue::Local(name) => Some(name.clone()),
+                _ => None,
+            }
+        })
+        .collect::<Vec<_>>();
+    while let Some(name) = pending.pop() {
+        if !needed.insert(name.clone()) {
+            continue;
+        }
+        if let Some(instruction) = definitions
+            .get(name.as_str())
+            .filter(|_| local.contains(name.as_str()))
+        {
+            instruction.visit_uses(|value| pending.push(value.to_string()));
+        }
+    }
+    let mut reads = Vec::new();
+    let mut dependencies = Vec::new();
+    let mut copied = HashSet::new();
+    for instruction in &block.insts {
+        if !readable_prefix(instruction) {
+            break;
+        }
+        if !instruction
+            .result
+            .as_ref()
+            .is_some_and(|name| needed.contains(name))
+        {
+            continue;
+        }
+        let Some((path, _)) =
+            super::constant_reads::entry_read_path(parsed, function, definitions, instruction)
+        else {
+            continue;
+        };
+        for dependency in path {
+            if copied.insert(dependency.result.clone()?) {
+                dependencies.push(dependency.clone());
+            }
+        }
+        reads.push(instruction.clone());
+    }
+    (!reads.is_empty()).then_some(Arm {
+        block: index,
+        reads,
+        dependencies,
+    })
+}
+
+fn readable_prefix(instruction: &TirInst) -> bool {
+    if let Some(load) = instruction.load().as_ref() {
+        return !load.ordered;
+    }
+    matches!(
+        instruction.opcode,
+        TirOpcode::GetElementPtr
+            | TirOpcode::Bitcast
+            | TirOpcode::Metal2VulkanInlineParameter
+            | TirOpcode::ExtractElement
+            | TirOpcode::InsertElement
+            | TirOpcode::ShuffleVector
+            | TirOpcode::ExtractValue
+            | TirOpcode::InsertValue
+            | TirOpcode::FAdd
+            | TirOpcode::FSub
+            | TirOpcode::FMul
+            | TirOpcode::FDiv
+            | TirOpcode::FNeg
+            | TirOpcode::Add
+            | TirOpcode::Sub
+            | TirOpcode::Mul
+            | TirOpcode::And
+            | TirOpcode::Or
+            | TirOpcode::Xor
+            | TirOpcode::ZExt
+            | TirOpcode::SExt
+            | TirOpcode::Trunc
+            | TirOpcode::Select
+    )
+}
