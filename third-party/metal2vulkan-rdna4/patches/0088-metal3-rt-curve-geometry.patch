+fn emit_curve_callback_case(
+    s: &mut String,
+    slot: u32,
+    cb: &LinkedRayCallback,
+    has_instancing: bool,
+    idx: &ParsedParamIndices,
+    p: &PendingCall,
+    ift_abi_v2: bool,
+    prim_data_enabled: bool,
+    table_param: &str,
+) -> Result<(), String> {
+    let hid = cb.handle_id;
+    let prefix = format!("cc{hid}");
+    s.push_str(&format!("curve_case_{hid}:\n"));
+    let args = emit_callback_args(
+        s,
+        slot,
+        &prefix,
+        cb,
+        false,
+        has_instancing,
+        idx,
+        p,
+        ift_abi_v2,
+        prim_data_enabled,
+        table_param,
+        Some(("%c_t", "%c_u", "%c_seg")),
+    );
+    let rty = cb.return_type.trim();
+    s.push_str(&format!(
+        "  %{prefix}_ret = call {rty} {}({})\n",
+        cb.llvm_symbol,
+        args.join(", ")
+    ));
+    let (accept_val, continue_val) = if rty == "i1" {
+        (format!("%{prefix}_ret"), "true".to_string())
+    } else if rty == "i8" || rty == "i32" {
+        s.push_str(&format!(
+            "  %{prefix}_acc = icmp ne {rty} %{prefix}_ret, 0\n"
+        ));
+        (format!("%{prefix}_acc"), "true".to_string())
+    } else if let Some(fields) = struct_field_types(rty) {
+        let mut bool_fields = Vec::new();
+        for (fi, ft) in fields.iter().enumerate() {
+            if ft == "i1" || ft == "i8" || ft == "i32" {
+                s.push_str(&format!(
+                    "  %{prefix}_f{fi} = extractvalue {rty} %{prefix}_ret, {fi}\n"
+                ));
+                if ft == "i1" {
+                    bool_fields.push(format!("%{prefix}_f{fi}"));
+                } else {
+                    s.push_str(&format!(
+                        "  %{prefix}_b{fi} = icmp ne {ft} %{prefix}_f{fi}, 0\n"
+                    ));
+                    bool_fields.push(format!("%{prefix}_b{fi}"));
+                }
+            }
+        }
+        let acc = bool_fields
+            .first()
+            .cloned()
+            .unwrap_or_else(|| "true".to_string());
+        let cont = bool_fields
+            .get(1)
+            .cloned()
+            .unwrap_or_else(|| "true".to_string());
+        (acc, cont)
+    } else {
+        return Err(format!(
+            "unsupported curve intersection callback return type {rty:?} on {}",
+            cb.llvm_symbol
+        ));
+    };
+    s.push_str(&format!(
+        "  %{prefix}_stop_cb = xor i1 {continue_val}, true\n\
+         \x20 %{prefix}_stop = or i1 %accept_any, %{prefix}_stop_cb\n\
+         \x20 br i1 {accept_val}, label %curve_confirm_{hid}, label %curve_reject_{hid}\n\n\
+         curve_confirm_{hid}:\n\
+         \x20 call void @__m2v.rq.generate(i32 {slot}, float %c_t)\n\
+         \x20 store i32 1, ptr %comm_is_curve, align 4\n\
+         \x20 store float %c_u, ptr %comm_curve_u, align 4\n\
+         \x20 store i32 %c_seg, ptr %comm_curve_seg, align 4\n\
+         \x20 br i1 %{prefix}_stop, label %term_hit, label %proceed_hdr\n\n\
+         curve_reject_{hid}:\n\
+         \x20 br i1 %{prefix}_stop_cb, label %term_hit, label %proceed_hdr\n\n"
+    ));
+    Ok(())
+}
