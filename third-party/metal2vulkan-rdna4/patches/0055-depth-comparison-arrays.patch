diff --git a/tests/embedded_depth_comparison.rs b/tests/embedded_depth_comparison.rs
new file mode 100644
--- /dev/null
+++ b/tests/embedded_depth_comparison.rs
@@ -0,0 +1,80 @@
+use metal2vulkan::{
+    passes::{Stage, TransformOptions},
+    translate_sanitized_native_reflected_unvalidated,
+};
+
+fn fragment(arrayed: bool, explicit: bool) -> String {
+    let dimension = if arrayed { "2d_array" } else { "2d" };
+    let layer = if arrayed { "i32 %index32, " } else { "" };
+    let layer_type = if arrayed { "i32, " } else { "" };
+    format!(
+        r#"
+target triple = "air64-apple-macosx"
+%Root = type {{ %Images, %Filters }}
+%Images = type {{ [2 x %Image] }}
+%Image = type {{ ptr addrspace(1) }}
+%Filters = type {{ [2 x %Filter] }}
+%Filter = type {{ ptr addrspace(2) }}
+define <4 x float> @entry(<4 x float> %position, ptr addrspace(2) %args) {{
+entry:
+  %x = extractelement <4 x float> %position, i32 0
+  %pixel = call i32 @air.convert.u.i32.f.f32(float %x)
+  %index32 = and i32 %pixel, 1
+  %index = zext i32 %index32 to i64
+  %image_slot = getelementptr %Root, ptr addrspace(2) %args, i64 0, i32 0, i32 0, i64 %index, i32 0
+  %sampler_slot = getelementptr %Root, ptr addrspace(2) %args, i64 0, i32 1, i32 0, i64 %index, i32 0
+  %image = load ptr addrspace(1), ptr addrspace(2) %image_slot, align 8
+  %sampler = load ptr addrspace(2), ptr addrspace(2) %sampler_slot, align 8
+  %coord = shufflevector <4 x float> %position, <4 x float> poison, <2 x i32> <i32 0, i32 1>
+  %sample = call {{ float, i8 }} @air.sample_compare_depth_{dimension}.f32(ptr addrspace(1) readonly captures(none) %image, ptr addrspace(2) readonly captures(none) %sampler, i32 1, <2 x float> %coord, {layer}float 0.5, i1 true, <2 x i32> <i32 1, i32 -1>, i1 {explicit}, float 0.0, float 0.0, i32 0)
+  %value = extractvalue {{ float, i8 }} %sample, 0
+  %out = insertelement <4 x float> zeroinitializer, float %value, i32 0
+  ret <4 x float> %out
+}}
+declare {{ float, i8 }} @air.sample_compare_depth_{dimension}.f32(ptr addrspace(1), ptr addrspace(2), i32, <2 x float>, {layer_type}float, i1, <2 x i32>, i1, float, float, i32)
+declare i32 @air.convert.u.i32.f.f32(float)
+!air.fragment = !{{!0}}
+!0 = !{{ptr @entry, !1, !2}}
+!1 = !{{!3}}
+!2 = !{{!4, !5}}
+!3 = !{{!"air.render_target", i32 0, i32 0, !"air.arg_type_name", !"float4"}}
+!4 = !{{i32 0, !"air.position", !"air.center", !"air.no_perspective", !"air.arg_type_name", !"float4"}}
+!5 = !{{i32 1, !"air.indirect_buffer", !"air.buffer_size", i32 32, !"air.location_index", i32 3, i32 1, !"air.read", !"air.address_space", i32 2, !"air.struct_type_info", !6, !"air.arg_type_name", !"Root"}}
+!6 = !{{i32 0, i32 16, i32 0, !"array<depth{dimension}<float, sample>, 2>", !"images", !"air.indirect_argument", !7, i32 16, i32 16, i32 0, !"array<sampler, 2>", !"filters", !"air.indirect_argument", !8}}
+!7 = !{{i32 0, !"air.texture", !"air.location_index", i32 0, i32 2, !"air.sample", !"air.arg_type_name", !"array<depth{dimension}<float, sample>, 2>"}}
+!8 = !{{i32 1, !"air.sampler", !"air.location_index", i32 2, i32 2, !"air.arg_type_name", !"array<sampler, 2>"}}
+"#
+    )
+}
+
+#[test]
+fn dynamic_embedded_depth_comparison_keeps_its_image_and_offset() {
+    for (arrayed, explicit) in [(false, false), (false, true), (true, false), (true, true)] {
+        let directory = std::env::temp_dir().join(format!(
+            "embedded-depth-comparison-{}-{arrayed}-{explicit}",
+            std::process::id()
+        ));
+        std::fs::create_dir_all(&directory).unwrap();
+        let (spv, reflection) = translate_sanitized_native_reflected_unvalidated(
+            &fragment(arrayed, explicit),
+            Stage::Fragment,
+            &directory,
+            TransformOptions::default(),
+            None,
+        )
+        .unwrap();
+        reflection.validate_descriptor_abi().unwrap();
+        let assembly = metal2vulkan::disassemble(&spv).unwrap();
+        let opcode = if explicit {
+            "OpImageSampleDrefExplicitLod"
+        } else {
+            "OpImageSampleDrefImplicitLod"
+        };
+        assert_eq!(assembly.matches(opcode).count(), 1, "{assembly}");
+        assert!(assembly.contains("ConstOffset"), "{assembly}");
+        assert!(!assembly.contains("OpDPdx "), "{assembly}");
+        assert!(!assembly.contains("OpDPdy "), "{assembly}");
+        metal2vulkan::tools::spirv_val_bytes(&spv, &directory).unwrap();
+        std::fs::remove_dir_all(directory).unwrap();
+    }
+}
diff --git a/docs/REFLECTION.md b/docs/REFLECTION.md
--- a/docs/REFLECTION.md
+++ b/docs/REFLECTION.md
@@ -695,3 +695,8 @@
 Single-predecessor identity phis are substituted using the existing typed-CFG
 canonicalizer before guarded address/read planning. Multi-predecessor, incomplete,
 conflicting and self-referential phis retain their normal analysis boundary.
+
+Depth comparison sampling participates in sampled-image discovery and dynamic
+texture-array handle materialization alongside ordinary depth sampling. A
+`sample_compare`-only argument array keeps its image descriptor and comparison
+sampler; the depth handle must not fall through to null-result protection.
