+//! GPU-visible opaque argument tokens, resolved against dense per-command resource tables.
+
+use super::*;
+use crate::spirv_module::{Block, Function};
+use spirv::{Capability, Decoration, FunctionControl, LoopControl};
+use std::collections::{BTreeMap, HashMap, HashSet};
+
+pub const ARGUMENT_RESOURCE_TABLE_BINDING: u32 = 672;
+pub const ARGUMENT_RESOURCE_ROOT_BINDING: u32 = 704;
+pub const ARGUMENT_RESOURCE_FIRST_SET: u32 = 2;
+
+/// The original standalone descriptor and its exact serialized argument-buffer coordinate.
+#[derive(Clone, Copy, Debug)]
+pub struct ArgumentResourceField {
+    pub binding: u32,
+    pub buffer_index: u32,
+    pub byte_offset: u32,
+}
+
+/// Replace finished static argument descriptors with GPU token loads and runtime descriptor arrays.
+///
+/// Set 0 binding 672 is a read-only u32 token table. Its first six words are
+/// `(word_offset, count)` for sampled images, storage images and samplers. Each
+/// sorted list contains low/high token words, with index zero reserved for a dummy.
+/// The matching descriptor arrays use binding zero of sets 2, 3 and 4. Argument
+/// buffer roots are raw u32 views at set 0 binding `704 + buffer_index`.
+/// Missing tokens select dummy index zero; no token becomes a device address.
+pub fn lower_argument_resource_tables(
+    bytes: &[u8],
+    fields: &[ArgumentResourceField],
+) -> Result<Vec<u8>, String> {
+    if fields.is_empty() {
+        return Ok(bytes.to_vec());
+    }
+    let module = crate::spirv_module::load_bytes(bytes)
+        .map_err(|error| format!("argument resource SPIR-V: {error:?}"))?;
+    let mut ctx = Ctx::with_options_and_sidecar(
+        module,
+        crate::emit_sidecar::EmitSidecar::default(),
+        Stage::Kernel,
+        TransformOptions::default(),
+    );
+    lower(&mut ctx, fields)?;
+    ctx.module.types_global_values.append(&mut ctx.new_globals);
+    super::nonuniform::decorate_nonuniform_descriptor_accesses(&mut ctx);
+    super::super::canonicalize_ids(&mut ctx.module);
+    Ok(ctx
+        .module
+        .assemble()
+        .iter()
+        .flat_map(|word| word.to_le_bytes())
+        .collect())
+}
+
+#[derive(Clone, Copy)]
+struct Resource {
+    owner: u32,
+    offset: u32,
+    element: Word,
+    category: u32,
+    array: bool,
+}
+
+fn lower(ctx: &mut Ctx, fields: &[ArgumentResourceField]) -> Result<(), String> {
+    let defs = type_defs(&ctx.module);
+    let mut sets = HashMap::new();
+    let mut bindings = HashMap::new();
+    for inst in &ctx.module.annotations {
+        if inst.class.opcode != Op::Decorate {
+            continue;
+        }
+        match inst.operands.as_slice() {
+            [Operand::IdRef(id), Operand::Decoration(Decoration::DescriptorSet), Operand::LiteralBit32(set)] =>
+            {
+                sets.insert(*id, *set);
+            }
+            [Operand::IdRef(id), Operand::Decoration(Decoration::Binding), Operand::LiteralBit32(binding)] =>
+            {
+                bindings.insert(*id, *binding);
+            }
+            _ => {}
+        }
+    }
+    if sets.values().any(|set| *set >= ARGUMENT_RESOURCE_FIRST_SET) {
+        return Err("GPU argument resource sets 2..4 are already occupied".into());
+    }
+    if bindings.iter().any(|(id, binding)| {
+        sets.get(id) == Some(&0)
+            && (*binding == ARGUMENT_RESOURCE_TABLE_BINDING
+                || (ARGUMENT_RESOURCE_ROOT_BINDING..ARGUMENT_RESOURCE_ROOT_BINDING + 31)
+                    .contains(binding))
+    }) {
+        return Err("GPU argument table/root bindings are already occupied".into());
+    }
+    let mut resources = BTreeMap::new();
+    let mut seen = HashSet::new();
+    for field in fields {
+        if field.buffer_index >= 31 || field.byte_offset % 8 != 0 || !seen.insert(field.binding) {
+            return Err("invalid or duplicate GPU argument resource coordinate".into());
+        }
+        let vars = bindings
+            .iter()
+            .filter(|(id, binding)| **binding == field.binding && sets.get(id) == Some(&0))
+            .map(|(&id, _)| id)
+            .collect::<Vec<_>>();
+        if vars.len() != 1 {
+            return Err("GPU argument resource descriptor is missing or ambiguous".into());
+        }
+        let var = vars[0];
+        let pointer = defs
+            .get(&var)
+            .filter(|inst| inst.class.opcode == Op::Variable)
+            .and_then(|inst| inst.result_type)
+            .ok_or("GPU argument descriptor has no variable type")?;
+        let mut element =
+            ptr_pointee(&defs, pointer).ok_or("GPU argument descriptor has no pointee")?;
+        let mut array = false;
+        let mut count = 1;
+        if defs
+            .get(&element)
+            .is_some_and(|inst| inst.class.opcode == Op::TypeArray)
+        {
+            count = match defs[&element].operands.get(1) {
+                Some(Operand::IdRef(id)) => match defs.get(id) {
+                    Some(inst) if inst.class.opcode == Op::Constant => {
+                        match inst.operands.as_slice() {
+                            [Operand::LiteralBit32(count)] => *count,
+                            _ => return Err("invalid resource array length".into()),
+                        }
+                    }
+                    _ => return Err("nonconstant resource array length".into()),
+                },
+                _ => return Err("missing resource array length".into()),
+            };
+            element = match defs[&element].operands.first() {
+                Some(Operand::IdRef(id)) => *id,
+                _ => return Err("invalid resource array".into()),
+            };
+            array = true;
+        }
+        if count == 0
+            || count
+                .checked_mul(8)
+                .and_then(|size| field.byte_offset.checked_add(size))
+                .is_none()
+        {
+            return Err("GPU argument resource extent exceeds its raw descriptor view".into());
+        }
+        let category = match defs.get(&element) {
+            Some(inst) if inst.class.opcode == Op::TypeSampler => 2,
+            Some(inst) if inst.class.opcode == Op::TypeImage => {
+                if matches!(
+                    inst.operands.get(1),
+                    Some(Operand::Dim(
+                        spirv::Dim::DimBuffer | spirv::Dim::DimSubpassData
+                    ))
+                ) {
+                    return Err(
+                        "GPU argument image requires a non-image descriptor category".into(),
+                    );
+                }
+                if inst.operands.get(5) == Some(&Operand::LiteralBit32(2)) {
+                    1
+                } else {
+                    0
+                }
+            }
+            _ => return Err("GPU argument descriptor is not a texture or sampler".into()),
+        };
+        resources.insert(
+            var,
+            Resource {
+                owner: field.buffer_index,
+                offset: field.byte_offset,
+                element,
+                category,
+                array,
+            },
+        );
+    }
+    let table = raw_buffer(ctx, ARGUMENT_RESOURCE_TABLE_BINDING);
+    let mut roots = BTreeMap::new();
+    for resource in resources.values() {
+        roots
+            .entry(resource.owner)
+            .or_insert_with(|| raw_buffer(ctx, ARGUMENT_RESOURCE_ROOT_BINDING + resource.owner));
+    }
+    let lookup = lookup_function(ctx, table);
+    let mut globals = BTreeMap::new();
+    let mut replacement = BTreeMap::new();
+    for (&var, resource) in &resources {
+        let new_var = *globals
+            .entry((resource.category, resource.element))
+            .or_insert_with(|| {
+                let array_ty = ctx.ty_runtime_array(resource.element);
+                let pointer = ctx.ty_ptr(StorageClass::UniformConstant, array_ty);
+                let id = ctx.module.fresh_id();
+                ctx.new_globals.push(Instruction::new(
+                    Op::Variable,
+                    Some(pointer),
+                    Some(id),
+                    vec![Operand::StorageClass(StorageClass::UniformConstant)],
+                ));
+                decorate_binding(
+                    &mut ctx.module,
+                    id,
+                    ARGUMENT_RESOURCE_FIRST_SET + resource.category,
+                    0,
+                );
+                id
+            });
+        replacement.insert(var, new_var);
+    }
+    let uint = ctx.ty_uint();
+    let zero = ctx.const_uint(0);
+    let one = ctx.const_uint(1);
+    let two = ctx.const_uint(2);
+    let word_ptr = ctx.ty_ptr(StorageClass::StorageBuffer, uint);
+    let value_types = ctx
+        .module
+        .all_inst_iter()
+        .filter_map(|inst| Some((inst.result_id?, inst.result_type?)))
+        .collect::<HashMap<_, _>>();
+    let mut retired = resources.keys().copied().collect::<HashSet<_>>();
+    for function_index in 0..ctx.module.functions.len() - 1 {
+        let mut projections = HashMap::<Word, (Word, Word)>::new();
+        for block in &ctx.module.functions[function_index].blocks {
+            for inst in &block.instructions {
+                if matches!(inst.class.opcode, Op::AccessChain | Op::InBoundsAccessChain) {
+                    if let [Operand::IdRef(base), Operand::IdRef(index)] = inst.operands.as_slice()
+                    {
+                        if resources.get(base).is_some_and(|resource| resource.array) {
+                            projections.insert(
+                                inst.result_id.ok_or("resource access has no result")?,
+                                (*base, *index),
+                            );
+                        }
+                    }
+                }
+            }
+        }
+        retired.extend(projections.keys().copied());
+        for block_index in 0..ctx.module.functions[function_index].blocks.len() {
+            let old = ctx.module.functions[function_index].blocks[block_index]
+                .instructions
+                .clone();
+            let mut body = Vec::with_capacity(old.len());
+            for mut inst in old {
+                if inst.class.opcode == Op::Load {
+                    let coordinate = match inst.operands.first() {
+                        Some(Operand::IdRef(pointer)) => resources
+                            .get(pointer)
+                            .filter(|resource| !resource.array)
+                            .map(|_| (*pointer, zero))
+                            .or_else(|| projections.get(pointer).copied()),
+                        _ => None,
+                    };
+                    if let Some((var, index)) = coordinate {
+                        let resource = resources[&var];
+                        let index = if index == zero || value_types.get(&index) == Some(&uint) {
+                            index
+                        } else {
+                            let operation = if value_types
+                                .get(&index)
+                                .and_then(|ty| defs.get(ty))
+                                .is_some_and(|ty| {
+                                    ty.class.opcode == Op::TypeInt
+                                        && ty.operands.first() == Some(&Operand::LiteralBit32(32))
+                                }) {
+                                Op::Bitcast
+                            } else {
+                                Op::UConvert
+                            };
+                            value(ctx, &mut body, operation, uint, vec![Operand::IdRef(index)])
+                        };
+                        let base = ctx.const_uint(resource.offset / 4);
+                        let scaled = value(
+                            ctx,
+                            &mut body,
+                            Op::IMul,
+                            uint,
+                            vec![Operand::IdRef(index), Operand::IdRef(two)],
+                        );
+                        let at = value(
+                            ctx,
+                            &mut body,
+                            Op::IAdd,
+                            uint,
+                            vec![Operand::IdRef(base), Operand::IdRef(scaled)],
+                        );
+                        let next = value(
+                            ctx,
+                            &mut body,
+                            Op::IAdd,
+                            uint,
+                            vec![Operand::IdRef(at), Operand::IdRef(one)],
+                        );
+                        let low = load_word(
+                            ctx,
+                            &mut body,
+                            roots[&resource.owner],
+                            word_ptr,
+                            uint,
+                            zero,
+                            at,
+                        );
+                        let high = load_word(
+                            ctx,
+                            &mut body,
+                            roots[&resource.owner],
+                            word_ptr,
+                            uint,
+                            zero,
+                            next,
+                        );
+                        let category = ctx.const_uint(resource.category);
+                        let selected = value(
+                            ctx,
+                            &mut body,
+                            Op::FunctionCall,
+                            uint,
+                            vec![
+                                Operand::IdRef(lookup),
+                                Operand::IdRef(low),
+                                Operand::IdRef(high),
+                                Operand::IdRef(category),
+                            ],
+                        );
+                        let pointer_ty =
+                            ctx.ty_ptr(StorageClass::UniformConstant, resource.element);
+                        let pointer = value(
+                            ctx,
+                            &mut body,
+                            Op::AccessChain,
+                            pointer_ty,
+                            vec![Operand::IdRef(replacement[&var]), Operand::IdRef(selected)],
+                        );
+                        inst.operands[0] = Operand::IdRef(pointer);
+                        body.push(inst);
+                        continue;
+                    }
+                }
+                if inst
+                    .result_id
+                    .is_some_and(|id| projections.contains_key(&id))
+                {
+                    continue;
+                }
+                body.push(inst);
+            }
+            ctx.module.functions[function_index].blocks[block_index].instructions = body;
+        }
+    }
+    // Refuse a representation we did not consume; retaining an old descriptor here would lie.
+    for function in &ctx.module.functions {
+        if function.all_inst_iter().any(|inst| {
+            inst.operands
+                .iter()
+                .any(|operand| matches!(operand, Operand::IdRef(id) if retired.contains(id)))
+        }) {
+            return Err("unsupported GPU argument resource projection".into());
+        }
+    }
+    ctx.module
+        .types_global_values
+        .retain(|inst| !inst.result_id.is_some_and(|id| retired.contains(&id)));
+    ctx.module.annotations.retain(
+        |inst| !matches!(inst.operands.first(), Some(Operand::IdRef(id)) if retired.contains(id)),
+    );
+    ctx.module.debug_names.retain(
+        |inst| !matches!(inst.operands.first(), Some(Operand::IdRef(id)) if retired.contains(id)),
+    );
+    let mut interface = globals
+        .values()
+        .copied()
+        .chain(roots.values().copied())
+        .chain([table])
+        .collect::<Vec<_>>();
+    interface.sort_unstable();
+    interface.dedup();
+    for entry in &mut ctx.module.entry_points {
+        entry
+            .operands
+            .retain(|operand| !matches!(operand, Operand::IdRef(id) if retired.contains(id)));
+        entry
+            .operands
+            .extend(interface.iter().copied().map(Operand::IdRef));
+    }
+    ctx.add_capability(Capability::RuntimeDescriptorArray);
+    Ok(())
+}
+
+fn raw_buffer(ctx: &mut Ctx, binding: u32) -> Word {
+    let uint = ctx.ty_uint();
+    let array = ctx.ty_runtime_array(uint);
+    let stride = vec![
+        Operand::IdRef(array),
+        Operand::Decoration(Decoration::ArrayStride),
+        Operand::LiteralBit32(4),
+    ];
+    if !ctx
+        .module
+        .annotations
+        .iter()
+        .any(|inst| inst.class.opcode == Op::Decorate && inst.operands == stride)
+    {
+        ctx.module
+            .annotations
+            .push(Instruction::new(Op::Decorate, None, None, stride));
+    }
+    let structure = ctx.module.fresh_id();
+    ctx.new_globals.push(type_inst(
+        Op::TypeStruct,
+        structure,
+        vec![Operand::IdRef(array)],
+    ));
+    ctx.module.annotations.push(Instruction::new(
+        Op::Decorate,
+        None,
+        None,
+        vec![
+            Operand::IdRef(structure),
+            Operand::Decoration(Decoration::Block),
+        ],
+    ));
+    ctx.module.annotations.push(Instruction::new(
+        Op::MemberDecorate,
+        None,
+        None,
+        vec![
+            Operand::IdRef(structure),
+            Operand::LiteralBit32(0),
+            Operand::Decoration(Decoration::Offset),
+            Operand::LiteralBit32(0),
+        ],
+    ));
+    let ptr = ctx.ty_ptr(StorageClass::StorageBuffer, structure);
+    let var = ctx.module.fresh_id();
+    ctx.new_globals.push(Instruction::new(
+        Op::Variable,
+        Some(ptr),
+        Some(var),
+        vec![Operand::StorageClass(StorageClass::StorageBuffer)],
+    ));
+    decorate_binding(&mut ctx.module, var, 0, binding);
+    ctx.module.annotations.push(Instruction::new(
+        Op::Decorate,
+        None,
+        None,
+        vec![
+            Operand::IdRef(var),
+            Operand::Decoration(Decoration::NonWritable),
+        ],
+    ));
+    var
+}
+
+fn value(
+    ctx: &mut Ctx,
+    body: &mut Vec<Instruction>,
+    op: Op,
+    ty: Word,
+    operands: Vec<Operand>,
+) -> Word {
+    let id = ctx.module.fresh_id();
+    body.push(Instruction::new(op, Some(ty), Some(id), operands));
+    id
+}
+
+fn load_word(
+    ctx: &mut Ctx,
+    body: &mut Vec<Instruction>,
+    var: Word,
+    pointer: Word,
+    uint: Word,
+    zero: Word,
+    index: Word,
+) -> Word {
+    let ptr = value(
+        ctx,
+        body,
+        Op::AccessChain,
+        pointer,
+        vec![
+            Operand::IdRef(var),
+            Operand::IdRef(zero),
+            Operand::IdRef(index),
+        ],
+    );
+    value(ctx, body, Op::Load, uint, vec![Operand::IdRef(ptr)])
+}
+
+fn block(label: Word, instructions: Vec<Instruction>) -> Block {
+    Block {
+        label: Some(Instruction::new(Op::Label, None, Some(label), vec![])),
+        instructions,
+    }
+}
+
+fn lookup_function(ctx: &mut Ctx, table: Word) -> Word {
+    let uint = ctx.ty_uint();
+    let boolean = ctx.ty_bool();
+    let pointer = ctx.ty_ptr(StorageClass::StorageBuffer, uint);
+    let zero = ctx.const_uint(0);
+    let one = ctx.const_uint(1);
+    let two = ctx.const_uint(2);
+    let ty = ctx.get_or_create(Op::TypeFunction, None, vec![Operand::IdRef(uint); 4]);
+    let function = ctx.module.fresh_id();
+    let low_key = ctx.module.fresh_id();
+    let high_key = ctx.module.fresh_id();
+    let category = ctx.module.fresh_id();
+    let entry = ctx.module.fresh_id();
+    let header = ctx.module.fresh_id();
+    let search = ctx.module.fresh_id();
+    let continuing = ctx.module.fresh_id();
+    let exit = ctx.module.fresh_id();
+    let low = ctx.module.fresh_id();
+    let high = ctx.module.fresh_id();
+    let next_low = ctx.module.fresh_id();
+    let next_high = ctx.module.fresh_id();
+    let mut first = vec![];
+    let pair = value(
+        ctx,
+        &mut first,
+        Op::IMul,
+        uint,
+        vec![Operand::IdRef(category), Operand::IdRef(two)],
+    );
+    let count_at = value(
+        ctx,
+        &mut first,
+        Op::IAdd,
+        uint,
+        vec![Operand::IdRef(pair), Operand::IdRef(one)],
+    );
+    let offset = load_word(ctx, &mut first, table, pointer, uint, zero, pair);
+    let count = load_word(ctx, &mut first, table, pointer, uint, zero, count_at);
+    first.push(Instruction::new(
+        Op::Branch,
+        None,
+        None,
+        vec![Operand::IdRef(header)],
+    ));
+    let mut loop_header = vec![
+        Instruction::new(
+            Op::Phi,
+            Some(uint),
+            Some(low),
+            vec![
+                Operand::IdRef(zero),
+                Operand::IdRef(entry),
+                Operand::IdRef(next_low),
+                Operand::IdRef(continuing),
+            ],
+        ),
+        Instruction::new(
+            Op::Phi,
+            Some(uint),
+            Some(high),
+            vec![
+                Operand::IdRef(count),
+                Operand::IdRef(entry),
+                Operand::IdRef(next_high),
+                Operand::IdRef(continuing),
+            ],
+        ),
+    ];
+    let active = value(
+        ctx,
+        &mut loop_header,
+        Op::ULessThan,
+        boolean,
+        vec![Operand::IdRef(low), Operand::IdRef(high)],
+    );
+    loop_header.push(Instruction::new(
+        Op::LoopMerge,
+        None,
+        None,
+        vec![
+            Operand::IdRef(exit),
+            Operand::IdRef(continuing),
+            Operand::LoopControl(LoopControl::NONE),
+        ],
+    ));
+    loop_header.push(Instruction::new(
+        Op::BranchConditional,
+        None,
+        None,
+        vec![
+            Operand::IdRef(active),
+            Operand::IdRef(search),
+            Operand::IdRef(exit),
+        ],
+    ));
+    let mut body = vec![];
+    let remaining = value(
+        ctx,
+        &mut body,
+        Op::ISub,
+        uint,
+        vec![Operand::IdRef(high), Operand::IdRef(low)],
+    );
+    let half = value(
+        ctx,
+        &mut body,
+        Op::ShiftRightLogical,
+        uint,
+        vec![Operand::IdRef(remaining), Operand::IdRef(one)],
+    );
+    let middle = value(
+        ctx,
+        &mut body,
+        Op::IAdd,
+        uint,
+        vec![Operand::IdRef(low), Operand::IdRef(half)],
+    );
+    let scaled = value(
+        ctx,
+        &mut body,
+        Op::IMul,
+        uint,
+        vec![Operand::IdRef(middle), Operand::IdRef(two)],
+    );
+    let at = value(
+        ctx,
+        &mut body,
+        Op::IAdd,
+        uint,
+        vec![Operand::IdRef(offset), Operand::IdRef(scaled)],
+    );
+    let high_at = value(
+        ctx,
+        &mut body,
+        Op::IAdd,
+        uint,
+        vec![Operand::IdRef(at), Operand::IdRef(one)],
+    );
+    let row_low = load_word(ctx, &mut body, table, pointer, uint, zero, at);
+    let row_high = load_word(ctx, &mut body, table, pointer, uint, zero, high_at);
+    let high_less = value(
+        ctx,
+        &mut body,
+        Op::ULessThan,
+        boolean,
+        vec![Operand::IdRef(row_high), Operand::IdRef(high_key)],
+    );
+    let high_equal = value(
+        ctx,
+        &mut body,
+        Op::IEqual,
+        boolean,
+        vec![Operand::IdRef(row_high), Operand::IdRef(high_key)],
+    );
+    let low_less = value(
+        ctx,
+        &mut body,
+        Op::ULessThan,
+        boolean,
+        vec![Operand::IdRef(row_low), Operand::IdRef(low_key)],
+    );
+    let low_when_equal = value(
+        ctx,
+        &mut body,
+        Op::LogicalAnd,
+        boolean,
+        vec![Operand::IdRef(high_equal), Operand::IdRef(low_less)],
+    );
+    let less = value(
+        ctx,
+        &mut body,
+        Op::LogicalOr,
+        boolean,
+        vec![Operand::IdRef(high_less), Operand::IdRef(low_when_equal)],
+    );
+    let after = value(
+        ctx,
+        &mut body,
+        Op::IAdd,
+        uint,
+        vec![Operand::IdRef(middle), Operand::IdRef(one)],
+    );
+    body.push(Instruction::new(
+        Op::Select,
+        Some(uint),
+        Some(next_low),
+        vec![
+            Operand::IdRef(less),
+            Operand::IdRef(after),
+            Operand::IdRef(low),
+        ],
+    ));
+    body.push(Instruction::new(
+        Op::Select,
+        Some(uint),
+        Some(next_high),
+        vec![
+            Operand::IdRef(less),
+            Operand::IdRef(high),
+            Operand::IdRef(middle),
+        ],
+    ));
+    body.push(Instruction::new(
+        Op::Branch,
+        None,
+        None,
+        vec![Operand::IdRef(continuing)],
+    ));
+    let mut last = vec![];
+    let in_range = value(
+        ctx,
+        &mut last,
+        Op::ULessThan,
+        boolean,
+        vec![Operand::IdRef(low), Operand::IdRef(count)],
+    );
+    let candidate = value(
+        ctx,
+        &mut last,
+        Op::Select,
+        uint,
+        vec![
+            Operand::IdRef(in_range),
+            Operand::IdRef(low),
+            Operand::IdRef(zero),
+        ],
+    );
+    let scaled = value(
+        ctx,
+        &mut last,
+        Op::IMul,
+        uint,
+        vec![Operand::IdRef(candidate), Operand::IdRef(two)],
+    );
+    let at = value(
+        ctx,
+        &mut last,
+        Op::IAdd,
+        uint,
+        vec![Operand::IdRef(offset), Operand::IdRef(scaled)],
+    );
+    let high_at = value(
+        ctx,
+        &mut last,
+        Op::IAdd,
+        uint,
+        vec![Operand::IdRef(at), Operand::IdRef(one)],
+    );
+    let row_low = load_word(ctx, &mut last, table, pointer, uint, zero, at);
+    let row_high = load_word(ctx, &mut last, table, pointer, uint, zero, high_at);
+    let low_equal = value(
+        ctx,
+        &mut last,
+        Op::IEqual,
+        boolean,
+        vec![Operand::IdRef(row_low), Operand::IdRef(low_key)],
+    );
+    let high_equal = value(
+        ctx,
+        &mut last,
+        Op::IEqual,
+        boolean,
+        vec![Operand::IdRef(row_high), Operand::IdRef(high_key)],
+    );
+    let equal = value(
+        ctx,
+        &mut last,
+        Op::LogicalAnd,
+        boolean,
+        vec![Operand::IdRef(low_equal), Operand::IdRef(high_equal)],
+    );
+    let result = value(
+        ctx,
+        &mut last,
+        Op::Select,
+        uint,
+        vec![
+            Operand::IdRef(equal),
+            Operand::IdRef(candidate),
+            Operand::IdRef(zero),
+        ],
+    );
+    last.push(Instruction::new(
+        Op::ReturnValue,
+        None,
+        None,
+        vec![Operand::IdRef(result)],
+    ));
+    ctx.module.functions.push(Function {
+        def: Some(Instruction::new(
+            Op::Function,
+            Some(uint),
+            Some(function),
+            vec![
+                Operand::FunctionControl(FunctionControl::NONE),
+                Operand::IdRef(ty),
+            ],
+        )),
+        end: Some(Instruction::new(Op::FunctionEnd, None, None, vec![])),
+        parameters: [low_key, high_key, category]
+            .into_iter()
+            .map(|id| Instruction::new(Op::FunctionParameter, Some(uint), Some(id), vec![]))
+            .collect(),
+        blocks: vec![
+            block(entry, first),
+            block(header, loop_header),
+            block(search, body),
+            block(
+                continuing,
+                vec![Instruction::new(
+                    Op::Branch,
+                    None,
+                    None,
+                    vec![Operand::IdRef(header)],
+                )],
+            ),
+            block(exit, last),
+        ],
+    });
+    function
+}
