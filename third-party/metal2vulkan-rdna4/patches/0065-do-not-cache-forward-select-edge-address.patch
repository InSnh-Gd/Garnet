+#[test]
+fn native_bda_forward_pointer_select_does_not_poison_loop_exit_phi() {
+    // Regression for RenderBox cubic-path binary search: a BDA pointer `select` inside a loop
+    // body feeds BOTH the loop-header phi (from the latch) and the loop-exit phi (from the
+    // exit edge). The forward edge materialization for the loop header must not record its
+    // latch-local OpSelect ID into `bda_direct_addresses`, or the loop-exit phi reads the
+    // non-dominating latch value (dropping the final binary-search iteration's update).
+    let ll = r#"
+define void @k(ptr addrspace(1) %segs, ptr addrspace(1) %out, ptr addrspace(2) %params) {
+entry:
+  %target = load i32, ptr addrspace(2) %params, align 4
+  %count = load i32, ptr addrspace(1) %segs, align 4
+  %start = getelementptr inbounds i8, ptr addrspace(1) %segs, i64 32
+  %has_loop = icmp sgt i32 %count, 1
+  br i1 %has_loop, label %loop, label %exit
+
+loop:
+  %cur = phi ptr addrspace(1) [ %start, %entry ], [ %next, %latch ]
+  %n = phi i32 [ %count, %entry ], [ %next_n, %latch ]
+  %half = lshr i32 %n, 1
+  %half64 = zext i32 %half to i64
+  %off = mul i64 %half64, 32
+  %mid = getelementptr inbounds i8, ptr addrspace(1) %cur, i64 %off
+  %key = load i32, ptr addrspace(1) %mid, align 4
+  %go_left = icmp sgt i32 %key, %target
+  %rem = sub i32 %n, %half
+  %next_n = select i1 %go_left, i32 %half, i32 %rem
+  %next = select i1 %go_left, ptr addrspace(1) %cur, ptr addrspace(1) %mid
+  %more = icmp sgt i32 %next_n, 1
+  br i1 %more, label %latch, label %exit_edge
+
+latch:
+  br label %loop
+
+exit_edge:
+  br label %exit
+
+exit:
+  %final = phi ptr addrspace(1) [ %start, %entry ], [ %next, %exit_edge ]
+  %val_ptr = getelementptr inbounds i8, ptr addrspace(1) %final, i64 8
+  %val = load float, ptr addrspace(1) %val_ptr, align 4
+  store float %val, ptr addrspace(1) %out, align 4
+  ret void
+}
+
+!air.kernel = !{!0}
+!0 = !{ptr @k, !1, !2}
+!1 = !{}
+!2 = !{!3, !4, !5}
+!3 = !{i32 0, !"air.buffer", !"air.location_index", i32 0, i32 1, !"air.read", !"air.address_space", i32 1, !"air.arg_type_size", i32 32, !"air.arg_type_align_size", i32 4, !"air.arg_type_name", !"Seg", !"air.arg_name", !"segs"}
+!4 = !{i32 1, !"air.buffer", !"air.location_index", i32 1, i32 1, !"air.write", !"air.address_space", i32 1, !"air.arg_type_size", i32 4, !"air.arg_type_align_size", i32 4, !"air.arg_type_name", !"float", !"air.arg_name", !"out"}
+!5 = !{i32 2, !"air.buffer", !"air.location_index", i32 2, i32 1, !"air.read", !"air.address_space", i32 2, !"air.arg_type_size", i32 4, !"air.arg_type_align_size", i32 4, !"air.arg_type_name", !"uint", !"air.arg_name", !"params"}
+"#;
+    let tmp = std::env::temp_dir().join(format!(
+        "metal2vulkan_bda_fwd_select_loop_exit_{}",
+        std::process::id()
+    ));
+    let _ = std::fs::create_dir_all(&tmp);
+    let spv = crate::translate_bda_probe(ll, Stage::Kernel, &tmp).expect("BDA translate");
+    let asm = disassemble(&spv).expect("disassemble");
+    tools::spirv_val_bytes(&spv, &tmp).expect("spirv-val");
+    // The loop must structure cleanly without falling back to the flat relooper switch due to a
+    // non-dominating edge-local OpSelect ID, and the exit phi must reference the loop-body select
+    // rather than an edge-local copy emitted only on the latch.
+    assert!(
+        !asm.contains("OpSwitch"),
+        "expected structured loop (no dominance-broken fallback to relooper switch):\n{asm}"
+    );
+    let _ = std::fs::remove_dir_all(tmp);
+}
