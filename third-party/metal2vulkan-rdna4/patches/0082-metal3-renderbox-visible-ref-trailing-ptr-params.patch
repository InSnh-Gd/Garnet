+fn visible_ref_params_compatible(
+    exp_params: &[crate::native::ir::LlType],
+    act_params: &[crate::native::ir::LlType],
+) -> bool {
+    if exp_params == act_params {
+        return true;
+    }
+    if act_params.len() > exp_params.len() {
+        return false;
+    }
+    // Apple RenderBox / [[stitchable]] visible-function references declare a fixed superset stub
+    // (including unused pointer slots) while the linked privateFunction defines only the parameters
+    // it uses; `native::emitter::body::calls::function_call_args_for_params` aligns them in order.
+    let mut ei = 0usize;
+    for act in act_params {
+        let Some(off) = exp_params[ei..].iter().position(|exp| exp == act) else {
+            return false;
+        };
+        if !exp_params[ei..ei + off]
+            .iter()
+            .all(|skipped| matches!(skipped, crate::native::ir::LlType::Ptr(_)))
+        {
+            return false;
+        }
+        ei += off + 1;
+    }
+    exp_params[ei..]
+        .iter()
+        .all(|skipped| matches!(skipped, crate::native::ir::LlType::Ptr(_)))
+}
