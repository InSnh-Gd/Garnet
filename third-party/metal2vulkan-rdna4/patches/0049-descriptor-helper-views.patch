 #[test]
+fn descriptor_pointer_reinterpretation_keeps_typed_accesses_in_a_shared_raw_layout() {
+    for space in [1, 2] {
+        for offset in [0, 16] {
+            let ll = format!("define float @main(ptr addrspace({space}) %slot) {{\nentry:\n %typed = load float, ptr addrspace({space}) %slot\n %view = getelementptr i8, ptr addrspace({space}) %slot, i64 {offset}\n %result = call float @load_bits(ptr addrspace({space}) %view)\n ret float %result\n}}\ndefine float @load_bits(ptr addrspace({space}) %pointer) {{\nentry:\n %bits = load i32, ptr addrspace({space}) %pointer\n %value = bitcast i32 %bits to float\n ret float %value\n}}\n");
+            let mut module = parsed(&ll);
+            let stats = module.inline_ordinary_leaf_helpers();
+            assert_eq!(stats.splices, 1, "addrspace={space}");
+            assert!(call_names(function(&module, "main")).is_empty());
+            assert!(module
+                .raw_buffer_params
+                .contains(&("main".into(), "%slot".into())));
+            let proxy = inline_bindings(function(&module, "main"))[0]
+                .result
+                .clone()
+                .unwrap();
+            assert!(module.raw_buffer_params.contains(&("main".into(), proxy)));
+            assert_eq!(
+                inline_bindings(function(&module, "main"))[0].operands[0]
+                    .as_typed_value()
+                    .unwrap()
+                    .value,
+                LlValue::Local("%view".into())
+            );
+            assert!(function(&module, "main").carrier_insts().any(|i| i
+                .load()
+                .as_ref()
+                .is_some_and(|load| load.result_ty == LlType::Int(32))));
+        }
+    }
+}
