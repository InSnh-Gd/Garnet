+/// Parse the stable AIR shape token shared by every gather family. The fixed MSL 2.1 text defines
+/// gather for 2D, 2D-array, cube and cube-array textures; it defines no 3D gather overload.
+fn gather_shape(name: &str, operation: &str) -> Result<(Dim, bool), String> {
+    let shape = intrinsic_texture_shape(name)
+        .ok_or_else(|| format!("{operation} has no recognized texture shape: {name}"))?;
+    match shape {
+        (Dim::Dim2D, _) | (Dim::DimCube, _) => Ok(shape),
+        (dim, _) => Err(format!(
+            "{operation} does not support {dim:?} texture gather"
+        )),
+    }
+}
