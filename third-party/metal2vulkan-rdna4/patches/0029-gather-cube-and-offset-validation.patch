+    };
+    let ty =
+        value_result_type(ctx, offset).ok_or("air.gather_texture offset has no result type")?;
+    if integer_shape(ctx, ty) != Some((32, 2)) {
+        return Err(
+            "air.gather_texture offset must be a two-component 32-bit integer vector".into(),
+        );
+    }
+    let (constant, dynamic) = gather_const_or_dynamic_offset(ctx, offset)?;
+    if let Some(value) = constant {
+        if value.iter().any(|component| !(-8..=7).contains(component)) {
+            return Err(format!(
+                "air.gather_texture offset {value:?} is outside the MSL range [-8, 7]"
+            ));
+        }
+    }
+    Ok((constant, dynamic))
+}
