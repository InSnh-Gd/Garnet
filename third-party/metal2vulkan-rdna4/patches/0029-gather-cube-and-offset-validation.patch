+/// OpImageGather's Component operand must be a 32-bit integer constant in `[0, 3]`. AIR's i32
+/// component operand is normally already a literal; canonicalize it to uint so every emitted form
+/// has the scalar integer type SPIR-V requires.
+fn gather_component(ctx: &mut Ctx, component: Word) -> Result<Word, String> {
+    let ty = value_result_type(ctx, component)
+        .ok_or("air.gather_texture component has no result type")?;
+    if integer_shape(ctx, ty) != Some((32, 1)) {
+        return Err("air.gather_texture component must be a 32-bit integer scalar".into());
+    }
+    let value = const_i32_scalar(ctx, component)
+        .or_else(|| {
+            const_inst(ctx, component)
+                .filter(|inst| inst.class.opcode == Op::ConstantNull)
+                .map(|_| 0)
+        })
+        .ok_or("air.gather_texture component must be a constant")?;
+    if !(0..4).contains(&value) {
+        return Err(format!(
+            "air.gather_texture component {value} is out of range 0..3"
+        ));
+    }
+    Ok(ctx.const_uint(value as u32))
+}
