+//! Cube and cube-array gather ABI and lowering.
+//!
+//! These declarations mirror the operand order emitted by Metal's AIR:
+//!
+//! - color: `(texture, sampler, float3 coord, [layer,] component, flags)`
+//! - depth: `(texture, sampler, i32 control, float3 coord, [layer,] flags)`
+//! - Dref: `(texture, sampler, i32 control, float3 coord, [layer,] compare, flags)`
+
+use metal2vulkan::passes::Stage;
+use metal2vulkan::{disassemble, translate_sanitized_native};
+use std::path::PathBuf;
+
+const NORMALIZED_SAMPLER: u64 = 34_901_797_601_020_416;
+const COMPARE_NEVER: u64 = 34_901_797_601_017_929;
+const COMPARE_ALWAYS: u64 = 34_901_797_600_952_393;
+
+#[derive(Clone, Copy)]
+enum Gather {
+    Color,
+    ColorArray,
+    Integer,
+    Depth,
+    DepthArray,
+    Dref,
+    DrefArray,
+}
+
+impl Gather {
+    fn arrayed(self) -> bool {
+        matches!(self, Self::ColorArray | Self::DepthArray | Self::DrefArray)
+    }
+
+    fn depth(self) -> bool {
+        matches!(
+            self,
+            Self::Depth | Self::DepthArray | Self::Dref | Self::DrefArray
+        )
+    }
+}
+
+fn scratch(label: &str) -> PathBuf {
+    let directory = std::env::temp_dir().join(format!(
+        "metal2vulkan_gather_cube_{}_{}",
+        std::process::id(),
+        label
+    ));
+    std::fs::create_dir_all(&directory).expect("create scratch directory");
+    directory
+}
+
+fn translate(source: &str, label: &str) -> Result<String, String> {
+    let directory = scratch(label);
+    let result = translate_sanitized_native(source, Stage::Kernel, &directory);
+    let _ = std::fs::remove_dir_all(directory);
+    result.and_then(|spirv| disassemble(&spirv))
+}
+
+fn gather_source(
+    gather: Gather,
+    sampler_word: u64,
+    component: &str,
+    component_expression: &str,
+) -> String {
+    let (intrinsic, texture_type, result_type, out_type, call_tail, declaration) = match gather {
+        Gather::Color => (
+            "air.gather_texture_cube.v4f32",
+            "texturecube<float, sample>",
+            "{ <4 x float>, i8 }",
+            "float4*",
+            format!("<3 x float> <float 1.0, float 0.0, float 0.0>, i32 {component}, i32 0"),
+            "<3 x float>, i32, i32".to_string(),
+        ),
+        Gather::ColorArray => (
+            "air.gather_texture_cube_array.v4f32",
+            "texturecube_array<float, sample>",
+            "{ <4 x float>, i8 }",
+            "float4*",
+            format!("<3 x float> <float 1.0, float 0.0, float 0.0>, i32 1, i32 {component}, i32 0"),
+            "<3 x float>, i32, i32, i32".to_string(),
+        ),
+        Gather::Integer => (
+            "air.gather_texture_cube.u.v4i32",
+            "texturecube<uint, sample>",
+            "{ <4 x i32>, i8 }",
+            "int4*",
+            format!("<3 x float> <float 1.0, float 0.0, float 0.0>, i32 {component}, i32 0"),
+            "<3 x float>, i32, i32".to_string(),
+        ),
+        Gather::Depth => (
+            "air.gather_depth_cube.v4f32",
+            "depthcube<float, sample>",
+            "{ <4 x float>, i8 }",
+            "float4*",
+            "<3 x float> <float 1.0, float 0.0, float 0.0>, i32 0".to_string(),
+            "<3 x float>, i32".to_string(),
+        ),
+        Gather::DepthArray => (
+            "air.gather_depth_cube_array.v4f32",
+            "depthcube_array<float, sample>",
+            "{ <4 x float>, i8 }",
+            "float4*",
+            "<3 x float> <float 1.0, float 0.0, float 0.0>, i32 1, i32 0".to_string(),
+            "<3 x float>, i32, i32".to_string(),
+        ),
+        Gather::Dref => (
+            "air.gather_compare_depth_cube.f32",
+            "depthcube<float, sample>",
+            "{ <4 x float>, i8 }",
+            "float4*",
+            "<3 x float> <float 1.0, float 0.0, float 0.0>, float 5.000000e-01, i32 0".to_string(),
+            "<3 x float>, float, i32".to_string(),
+        ),
+        Gather::DrefArray => (
+            "air.gather_compare_depth_cube_array.f32",
+            "depthcube_array<float, sample>",
+            "{ <4 x float>, i8 }",
+            "float4*",
+            "<3 x float> <float 1.0, float 0.0, float 0.0>, i32 1, float 5.000000e-01, i32 0"
+                .to_string(),
+            "<3 x float>, i32, float, i32".to_string(),
+        ),
+    };
+    let control = if gather.depth() { ", i32 1" } else { "" };
+    let stored_type = if matches!(gather, Gather::Integer) {
+        "<4 x i32>"
+    } else {
+        "<4 x float>"
+    };
+    format!(
+        r#"
+target triple = "spirv-unknown-vulkan1.2"
+
+@__air_sampler_state = internal addrspace(2) constant [2 x i64] [i64 {sampler_word}, i64 0], align 8
+
+define void @k(ptr addrspace(1) %tex, ptr addrspace(1) %out) {{
+entry:
+{component_expression}  %gather = tail call {result_type} @{intrinsic}(ptr addrspace(1) %tex, ptr addrspace(2) @__air_sampler_state{control}, {call_tail})
+  %color = extractvalue {result_type} %gather, 0
+  store {stored_type} %color, ptr addrspace(1) %out, align 16
+  ret void
+}}
+
+declare {result_type} @{intrinsic}(ptr addrspace(1), ptr addrspace(2), {declaration})
+
+!air.kernel = !{{!0}}
+!air.sampler_states = !{{!5}}
+!0 = !{{ptr @k, !1, !2}}
+!1 = !{{}}
+!2 = !{{!3, !4}}
+!3 = !{{i32 0, !"air.texture", !"air.location_index", i32 0, i32 1, !"air.sample", !"air.arg_type_name", !"{texture_type}", !"air.arg_name", !"tex"}}
+!4 = !{{i32 1, !"air.buffer", !"air.location_index", i32 0, i32 1, !"air.read_write", !"air.address_space", i32 1, !"air.arg_type_size", i32 16, !"air.arg_type_align_size", i32 16, !"air.arg_type_name", !"{out_type}", !"air.arg_name", !"out"}}
+!5 = !{{!"air.sampler_state", ptr addrspace(2) @__air_sampler_state}}
+"#
+    )
+}
+
+fn gather_line<'a>(assembly: &'a str, opcode: &str) -> &'a str {
+    let mut matches = assembly.lines().filter(|line| line.contains(opcode));
+    let line = matches
+        .next()
+        .unwrap_or_else(|| panic!("missing {opcode}:\n{assembly}"));
+    assert!(
+        matches.next().is_none(),
+        "more than one {opcode}:\n{assembly}"
+    );
+    line
+}
+
+fn assert_image(assembly: &str, expected: &str) {
+    assert!(
+        assembly
+            .lines()
+            .any(|line| line.contains("OpTypeImage") && line.contains(expected)),
+        "missing image type {expected}:\n{assembly}"
+    );
+}
+
+fn assert_no_gather_image_operands(line: &str) {
+    assert!(!line.contains("ImageOperands"), "{line}");
+    for forbidden in ["Bias", "Lod", "Grad", "Offset"] {
+        assert!(
+            !line.contains(forbidden),
+            "gather unexpectedly carries {forbidden}: {line}"
+        );
+    }
+}
+
+fn vector_type_id(assembly: &str, lanes: u32) -> &str {
+    assembly
+        .lines()
+        .find(|line| {
+            line.contains("OpTypeVector")
+                && line
+                    .split_whitespace()
+                    .last()
+                    .is_some_and(|last| last == lanes.to_string())
+        })
+        .and_then(|line| line.split_whitespace().next())
+        .unwrap_or_else(|| panic!("missing {lanes}-component float vector type:\n{assembly}"))
+}
+
+fn definition<'a>(assembly: &'a str, id: &str) -> &'a str {
+    assembly
+        .lines()
+        .find(|line| line.split_whitespace().next() == Some(id))
+        .unwrap_or_else(|| panic!("missing definition for {id}:\n{assembly}"))
+}
+
+fn has_integer_constant(assembly: &str, value: &str) -> bool {
+    assembly.lines().any(|line| {
+        let words: Vec<_> = line.split_whitespace().collect();
+        if words.get(2) != Some(&"OpConstant") || words.last() != Some(&value) {
+            return false;
+        }
+        let Some(type_id) = words.get(3) else {
+            return false;
+        };
+        definition(assembly, type_id).contains("OpTypeInt")
+    })
+}
+
+fn assert_layer_coordinate(assembly: &str) {
+    let vec4 = vector_type_id(assembly, 4);
+    assert!(
+        assembly.lines().any(|line| {
+            let words: Vec<_> = line.split_whitespace().collect();
+            words.get(2) == Some(&"OpCompositeConstruct") && words.get(3) == Some(&vec4)
+        }),
+        "cube-array gather did not build a four-component coordinate:\n{assembly}"
+    );
+    assert!(
+        assembly.contains("OpConvertUToF"),
+        "cube-array layer was not converted to float:\n{assembly}"
+    );
+}
+
+#[test]
+fn color_cube_gather_uses_cube_image_and_no_offset_or_lod_operands() {
+    let source = gather_source(Gather::Color, NORMALIZED_SAMPLER, "2", "");
+    let assembly =
+        translate(&source, "color_cube").expect("color cube gather translates and validates");
+    let gather = gather_line(&assembly, "OpImageGather");
+    assert_no_gather_image_operands(gather);
+    assert_image(&assembly, "Cube 0 0 0 1");
+    assert!(!assembly.contains("OpConvertUToF"), "{assembly}");
+    assert!(has_integer_constant(&assembly, "2"), "{assembly}");
+}
+
+#[test]
+fn color_cube_array_gather_appends_layer_to_vec3_direction() {
+    let source = gather_source(Gather::ColorArray, NORMALIZED_SAMPLER, "1", "");
+    let assembly =
+        translate(&source, "color_cube_array").expect("color cube-array gather translates");
+    let gather = gather_line(&assembly, "OpImageGather");
+    assert_no_gather_image_operands(gather);
+    assert_image(&assembly, "Cube 0 1 0 1");
+    assert_layer_coordinate(&assembly);
+}
+
+#[test]
+fn integer_cube_gather_keeps_the_uint_image_and_result_type() {
+    let source = gather_source(Gather::Integer, NORMALIZED_SAMPLER, "3", "");
+    let assembly = translate(&source, "integer_cube").expect("integer cube gather translates");
+    let gather = gather_line(&assembly, "OpImageGather");
+    assert_no_gather_image_operands(gather);
+    assert_image(&assembly, "Cube 0 0 0 1");
+    let words: Vec<_> = gather.split_whitespace().collect();
+    let result_ty = words.get(3).expect("gather result type");
+    let result_def: Vec<_> = definition(&assembly, result_ty)
+        .split_whitespace()
+        .collect();
+    assert_eq!(result_def.get(2), Some(&"OpTypeVector"), "{assembly}");
+    let vector_elem = result_def.get(3).expect("gather result element type");
+    assert!(
+        definition(&assembly, vector_elem).contains("OpTypeInt 32 0"),
+        "{assembly}"
+    );
+    let image = assembly
+        .lines()
+        .find(|line| line.contains("OpTypeImage") && line.contains("Cube 0 0 0 1"))
+        .expect("cube image type");
+    let image_words: Vec<_> = image.split_whitespace().collect();
+    assert_eq!(image_words.get(3), Some(vector_elem), "{assembly}");
+    assert!(!assembly.contains("OpImageFetch"), "{assembly}");
+}
+
+#[test]
+fn depth_cube_and_cube_array_gather_use_depth_images_without_operands() {
+    for (gather, expected_image, label) in [
+        (Gather::Depth, "Cube 1 0 0 1", "depth_cube"),
+        (Gather::DepthArray, "Cube 1 1 0 1", "depth_cube_array"),
+    ] {
+        let source = gather_source(gather, NORMALIZED_SAMPLER, "0", "");
+        let assembly = translate(&source, label).unwrap_or_else(|error| panic!("{label}: {error}"));
+        let gather_instruction = gather_line(&assembly, "OpImageGather");
+        assert_no_gather_image_operands(gather_instruction);
+        assert_image(&assembly, expected_image);
+        assert!(!assembly.contains("OpImageDrefGather"), "{assembly}");
+        if gather.arrayed() {
+            assert_layer_coordinate(&assembly);
+        }
+    }
+}
+
+#[test]
+fn compare_cube_and_cube_array_gather_use_dref_for_never_and_always() {
+    for (gather, compare, label) in [
+        (Gather::Dref, COMPARE_NEVER, "dref_cube_never"),
+        (Gather::Dref, COMPARE_ALWAYS, "dref_cube_always"),
+        (Gather::DrefArray, COMPARE_NEVER, "dref_cube_array_never"),
+        (Gather::DrefArray, COMPARE_ALWAYS, "dref_cube_array_always"),
+    ] {
+        let source = gather_source(gather, compare, "0", "");
+        let assembly = translate(&source, label).unwrap_or_else(|error| panic!("{label}: {error}"));
+        let dref = gather_line(&assembly, "OpImageDrefGather");
+        assert_no_gather_image_operands(dref);
+        assert_image(
+            &assembly,
+            if gather.arrayed() {
+                "Cube 1 1 0 1"
+            } else {
+                "Cube 1 0 0 1"
+            },
+        );
+        assert!(!assembly.contains("OpImageGather "), "{assembly}");
+        if gather.arrayed() {
+            assert_layer_coordinate(&assembly);
+        }
+    }
+}
+
+#[test]
+fn ordinary_cube_gather_rejects_dynamic_and_out_of_range_components() {
