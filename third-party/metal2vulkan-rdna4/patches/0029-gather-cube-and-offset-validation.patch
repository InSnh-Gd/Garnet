+/// Verify that a recovered image can be used by the gather operation named by the AIR symbol.
+/// This is deliberately independent of the fixture name: shape, depth class and sampled access
+/// are properties of the actual `OpTypeImage` and the stable intrinsic family.
+fn validate_gather_image(
+    ctx: &Ctx,
+    image_ty: Word,
+    dim: Dim,
+    arrayed: bool,
+    depth_image: bool,
+    component: crate::passes::ImageComp,
+) -> Result<u32, String> {
+    let def = type_def_of(ctx, image_ty).ok_or("air.gather_texture image type is undefined")?;
+    if def.class.opcode != Op::TypeImage {
+        return Err("air.gather_texture operand is not an image".into());
+    }
+    let actual_dim = match def.operands.get(1) {
+        Some(Operand::Dim(value)) => *value,
+        _ => return Err("air.gather_texture image type has no dimension".into()),
+    };
+    let actual_depth = matches!(def.operands.get(2), Some(Operand::LiteralBit32(1)));
+    let actual_arrayed = matches!(def.operands.get(3), Some(Operand::LiteralBit32(1)));
+    let multisampled = matches!(def.operands.get(4), Some(Operand::LiteralBit32(1)));
+    let sampled = match def.operands.get(5) {
+        Some(Operand::LiteralBit32(value)) => *value,
+        _ => return Err("air.gather_texture image type has no Sampled operand".into()),
+    };
+    if actual_dim != dim || actual_arrayed != arrayed {
+        return Err(format!(
+            "air.gather_texture intrinsic shape {dim:?}/arrayed={arrayed} does not match image \
+             type {actual_dim:?}/arrayed={actual_arrayed}"
+        ));
+    }
+    if actual_depth != depth_image {
+        return Err(format!(
+            "air.gather_texture {} requires a {} image",
+            if depth_image { "depth" } else { "color" },
+            if depth_image { "depth" } else { "color" }
+        ));
+    }
+    if multisampled {
+        return Err("air.gather_texture does not support multisampled images".into());
+    }
+    if depth_image && component != crate::passes::ImageComp::Float {
+        return Err("air.gather_depth requires a float depth image".into());
+    }
+    Ok(sampled)
+}
