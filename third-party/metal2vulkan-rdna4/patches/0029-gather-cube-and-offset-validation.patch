+/// Validate a 2D gather offset against the MSL range and SPIR-V operand form.
+///
+/// A constant offset lowers to `ConstOffset`, which is core SPIR-V and does not require
+/// `ImageGatherExtended`. A runtime offset is folded into the coordinate by
+/// [`apply_dynamic_sample_offset`] instead of emitting a feature-gated `Offset` operand. Cube
+/// gather overloads have no offset at all.
+fn validated_gather_offset(
+    ctx: &Ctx,
+    offset: Option<Word>,
+) -> Result<(Option<[i32; 2]>, Option<Word>), String> {
+    let Some(offset) = offset else {
