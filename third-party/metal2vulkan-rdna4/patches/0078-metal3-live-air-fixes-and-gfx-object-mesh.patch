+pub(crate) fn parse_return_type_text(prefix: &str) -> Result<String, String> {
+    let mut toks = split_top_level_whitespace(prefix);
+    if toks
+        .last()
+        .is_some_and(|tok| tok.starts_with('(') && tok.ends_with(')'))
+    {
+        toks.pop();
+    }
+    for i in (0..toks.len()).rev() {
+        let candidate = toks[i..].join(" ");
+        if parse_type(&candidate).is_ok() {
+            return Ok(candidate);
+        }
+    }
+    Err(format!(
+        "native emitter: could not parse function return type from `{}`",
+        prefix.trim()
+    ))
+}
