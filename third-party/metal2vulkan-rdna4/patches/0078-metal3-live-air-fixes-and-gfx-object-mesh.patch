+fn scalar_to_u32_bits(
+    ctx: &mut Ctx,
+    defs: &HashMap<Word, Instruction>,
+    cfg: &mut CfgBuilder,
+    ty: Word,
+    val: Word,
+) -> Option<(u32, Word)> {
+    let uint_ty = ctx.ty_uint();
+    let def = defs.get(&ty)?;
+    match def.class.opcode {
+        Op::TypeBool => {
+            let c1 = ctx.const_uint(1);
+            let c0 = ctx.const_uint(0);
+            let u = ctx.module.fresh_id();
+            cfg.push(Instruction::new(
+                Op::Select,
+                Some(uint_ty),
+                Some(u),
+                vec![Operand::IdRef(val), Operand::IdRef(c1), Operand::IdRef(c0)],
+            ));
+            Some((8, u))
+        }
+        Op::TypeInt => {
+            let bits = match def.operands.first() {
+                Some(Operand::LiteralBit32(b)) => *b,
+                _ => 32,
+            };
+            match bits {
+                8 | 16 => {
+                    let u = ctx.module.fresh_id();
+                    cfg.push(Instruction::new(
+                        Op::UConvert,
+                        Some(uint_ty),
+                        Some(u),
+                        vec![Operand::IdRef(val)],
+                    ));
+                    Some((bits, u))
+                }
+                32 => {
+                    let u = if ty == uint_ty {
+                        val
+                    } else {
+                        let b = ctx.module.fresh_id();
+                        cfg.push(Instruction::new(
+                            Op::Bitcast,
+                            Some(uint_ty),
+                            Some(b),
+                            vec![Operand::IdRef(val)],
+                        ));
+                        b
+                    };
+                    Some((32, u))
+                }
+                _ => None,
+            }
+        }
+        Op::TypeFloat => {
+            let bits = match def.operands.first() {
+                Some(Operand::LiteralBit32(b)) => *b,
+                _ => 32,
+            };
+            match bits {
+                16 => {
+                    let u16_ty = ctx.ty_air_scalar(AirScalar::UShort);
+                    let raw16 = ctx.module.fresh_id();
+                    cfg.push(Instruction::new(
+                        Op::Bitcast,
+                        Some(u16_ty),
+                        Some(raw16),
+                        vec![Operand::IdRef(val)],
+                    ));
+                    let u = ctx.module.fresh_id();
+                    cfg.push(Instruction::new(
+                        Op::UConvert,
+                        Some(uint_ty),
+                        Some(u),
+                        vec![Operand::IdRef(raw16)],
+                    ));
+                    Some((16, u))
+                }
+                32 => {
+                    let b = ctx.module.fresh_id();
+                    cfg.push(Instruction::new(
+                        Op::Bitcast,
+                        Some(uint_ty),
+                        Some(b),
+                        vec![Operand::IdRef(val)],
+                    ));
+                    Some((32, b))
+                }
+                _ => None,
+            }
+        }
+        _ => None,
+    }
+}
+
+fn u32_bits_to_scalar(
+    ctx: &mut Ctx,
+    defs: &HashMap<Word, Instruction>,
+    cfg: &mut CfgBuilder,
+    ty: Word,
+    raw_u32: Word,
+) -> Option<Word> {
+    let uint_ty = ctx.ty_uint();
+    let def = defs.get(&ty)?;
+    match def.class.opcode {
+        Op::TypeBool => {
+            let bool_ty = ctx.ty_bool();
+            let c1 = ctx.const_uint(1);
+            let c0 = ctx.const_uint(0);
+            let bit = ctx.module.fresh_id();
+            cfg.push(Instruction::new(
+                Op::BitwiseAnd,
+                Some(uint_ty),
+                Some(bit),
+                vec![Operand::IdRef(raw_u32), Operand::IdRef(c1)],
+            ));
+            let b = ctx.module.fresh_id();
+            cfg.push(Instruction::new(
+                Op::INotEqual,
+                Some(bool_ty),
+                Some(b),
+                vec![Operand::IdRef(bit), Operand::IdRef(c0)],
+            ));
+            Some(b)
+        }
+        Op::TypeInt => {
+            let bits = match def.operands.first() {
+                Some(Operand::LiteralBit32(b)) => *b,
+                _ => 32,
+            };
+            let signed = matches!(def.operands.get(1), Some(Operand::LiteralBit32(1)));
+            match bits {
+                8 => {
+                    let u8_ty = ctx.ty_air_scalar(AirScalar::UChar);
+                    let u8v = ctx.module.fresh_id();
+                    cfg.push(Instruction::new(
+                        Op::UConvert,
+                        Some(u8_ty),
+                        Some(u8v),
+                        vec![Operand::IdRef(raw_u32)],
+                    ));
+                    if signed || u8_ty != ty {
+                        let s = ctx.module.fresh_id();
+                        cfg.push(Instruction::new(
+                            Op::Bitcast,
+                            Some(ty),
+                            Some(s),
+                            vec![Operand::IdRef(u8v)],
+                        ));
+                        Some(s)
+                    } else {
+                        Some(u8v)
+                    }
+                }
+                16 => {
+                    let u16_ty = ctx.ty_air_scalar(AirScalar::UShort);
+                    let u16v = ctx.module.fresh_id();
+                    cfg.push(Instruction::new(
+                        Op::UConvert,
+                        Some(u16_ty),
+                        Some(u16v),
+                        vec![Operand::IdRef(raw_u32)],
+                    ));
+                    if signed || u16_ty != ty {
+                        let s = ctx.module.fresh_id();
+                        cfg.push(Instruction::new(
+                            Op::Bitcast,
+                            Some(ty),
+                            Some(s),
+                            vec![Operand::IdRef(u16v)],
+                        ));
+                        Some(s)
+                    } else {
+                        Some(u16v)
+                    }
+                }
+                32 => {
+                    if ty == uint_ty {
+                        Some(raw_u32)
+                    } else {
+                        let b = ctx.module.fresh_id();
+                        cfg.push(Instruction::new(
+                            Op::Bitcast,
+                            Some(ty),
+                            Some(b),
+                            vec![Operand::IdRef(raw_u32)],
+                        ));
+                        Some(b)
+                    }
+                }
+                _ => None,
+            }
+        }
+        Op::TypeFloat => {
+            let bits = match def.operands.first() {
+                Some(Operand::LiteralBit32(b)) => *b,
+                _ => 32,
+            };
+            match bits {
+                16 => {
+                    let u16_ty = ctx.ty_air_scalar(AirScalar::UShort);
+                    let u16v = ctx.module.fresh_id();
+                    cfg.push(Instruction::new(
+                        Op::UConvert,
+                        Some(u16_ty),
+                        Some(u16v),
+                        vec![Operand::IdRef(raw_u32)],
+                    ));
+                    let f = ctx.module.fresh_id();
+                    cfg.push(Instruction::new(
+                        Op::Bitcast,
+                        Some(ty),
+                        Some(f),
+                        vec![Operand::IdRef(u16v)],
+                    ));
+                    Some(f)
+                }
+                32 => {
+                    let f = ctx.module.fresh_id();
+                    cfg.push(Instruction::new(
+                        Op::Bitcast,
+                        Some(ty),
+                        Some(f),
+                        vec![Operand::IdRef(raw_u32)],
+                    ));
+                    Some(f)
+                }
+                _ => None,
+            }
+        }
+        _ => None,
+    }
+}
+
+fn copy_subword_or_word_scalar(
+    ctx: &mut Ctx,
+    defs: &HashMap<Word, Instruction>,
+    cfg: &mut CfgBuilder,
+    dir: PayloadCopyDir,
+    wg_var: Word,
+    indices: &[Word],
+    ty: Word,
+    byte_off: Word,
+    ssbo_var: Word,
+    base_word: Word,
+) -> Result<(), String> {
+    let uint_ty = ctx.ty_uint();
+    let c2 = ctx.const_uint(2);
+    let c3 = ctx.const_uint(3);
+    let word_off = ctx.module.fresh_id();
+    cfg.push(Instruction::new(
+        Op::ShiftRightLogical,
+        Some(uint_ty),
+        Some(word_off),
+        vec![Operand::IdRef(byte_off), Operand::IdRef(c2)],
+    ));
+    let word_idx = ctx.module.fresh_id();
+    cfg.push(Instruction::new(
+        Op::IAdd,
+        Some(uint_ty),
+        Some(word_idx),
+        vec![Operand::IdRef(base_word), Operand::IdRef(word_off)],
+    ));
+    let def = defs
+        .get(&ty)
+        .ok_or_else(|| format!("emulated payload: missing type def {ty}"))?;
+    let is_64 = matches!(def.class.opcode, Op::TypeInt | Op::TypeFloat)
+        && def.operands.first() == Some(&Operand::LiteralBit32(64));
+    let wg_ptr = wg_access_ptr(ctx, cfg, wg_var, indices, ty);
+    if is_64 {
+        let u64_ty = ctx.ty_ulong();
+        let c1 = ctx.const_uint(1);
+        let c32_64 = ctx.const_int_of(u64_ty, 32);
+        let word_idx_hi = ctx.module.fresh_id();
+        cfg.push(Instruction::new(
+            Op::IAdd,
+            Some(uint_ty),
+            Some(word_idx_hi),
+            vec![Operand::IdRef(word_idx), Operand::IdRef(c1)],
+        ));
+        match dir {
+            PayloadCopyDir::WorkgroupToSsbo => {
+                let raw = ctx.module.fresh_id();
+                cfg.push(Instruction::new(
+                    Op::Load,
+                    Some(ty),
+                    Some(raw),
+                    vec![Operand::IdRef(wg_ptr)],
+                ));
+                let v64 = if ty == u64_ty {
+                    raw
+                } else {
+                    let b = ctx.module.fresh_id();
+                    cfg.push(Instruction::new(
+                        Op::Bitcast,
+                        Some(u64_ty),
+                        Some(b),
+                        vec![Operand::IdRef(raw)],
+                    ));
+                    b
+                };
+                let lo = ctx.module.fresh_id();
+                cfg.push(Instruction::new(
+                    Op::UConvert,
+                    Some(uint_ty),
+                    Some(lo),
+                    vec![Operand::IdRef(v64)],
+                ));
+                let shifted = ctx.module.fresh_id();
+                cfg.push(Instruction::new(
+                    Op::ShiftRightLogical,
+                    Some(u64_ty),
+                    Some(shifted),
+                    vec![Operand::IdRef(v64), Operand::IdRef(c32_64)],
+                ));
+                let hi = ctx.module.fresh_id();
+                cfg.push(Instruction::new(
+                    Op::UConvert,
+                    Some(uint_ty),
+                    Some(hi),
+                    vec![Operand::IdRef(shifted)],
+                ));
+                ssbo_u32_store(ctx, cfg, ssbo_var, word_idx, lo);
+                ssbo_u32_store(ctx, cfg, ssbo_var, word_idx_hi, hi);
+            }
+            PayloadCopyDir::SsboToWorkgroup => {
+                let lo = ssbo_u32_load(ctx, cfg, ssbo_var, word_idx);
+                let hi = ssbo_u32_load(ctx, cfg, ssbo_var, word_idx_hi);
+                let lo64 = ctx.module.fresh_id();
+                cfg.push(Instruction::new(
+                    Op::UConvert,
+                    Some(u64_ty),
+                    Some(lo64),
+                    vec![Operand::IdRef(lo)],
+                ));
+                let hi64_low = ctx.module.fresh_id();
+                cfg.push(Instruction::new(
+                    Op::UConvert,
+                    Some(u64_ty),
+                    Some(hi64_low),
+                    vec![Operand::IdRef(hi)],
+                ));
+                let hi64 = ctx.module.fresh_id();
+                cfg.push(Instruction::new(
+                    Op::ShiftLeftLogical,
+                    Some(u64_ty),
+                    Some(hi64),
+                    vec![Operand::IdRef(hi64_low), Operand::IdRef(c32_64)],
+                ));
+                let v64 = ctx.module.fresh_id();
+                cfg.push(Instruction::new(
+                    Op::BitwiseOr,
+                    Some(u64_ty),
+                    Some(v64),
+                    vec![Operand::IdRef(lo64), Operand::IdRef(hi64)],
+                ));
+                let final_val = if ty == u64_ty {
+                    v64
+                } else {
+                    let b = ctx.module.fresh_id();
+                    cfg.push(Instruction::new(
+                        Op::Bitcast,
+                        Some(ty),
+                        Some(b),
+                        vec![Operand::IdRef(v64)],
+                    ));
+                    b
+                };
+                cfg.push(Instruction::new(
+                    Op::Store,
+                    None,
+                    None,
+                    vec![Operand::IdRef(wg_ptr), Operand::IdRef(final_val)],
+                ));
+            }
+        }
+        return Ok(());
+    }
+
+    match dir {
+        PayloadCopyDir::WorkgroupToSsbo => {
+            let loaded = ctx.module.fresh_id();
+            cfg.push(Instruction::new(
+                Op::Load,
+                Some(ty),
+                Some(loaded),
+                vec![Operand::IdRef(wg_ptr)],
+            ));
+            let (bits, uval) = scalar_to_u32_bits(ctx, defs, cfg, ty, loaded)
+                .ok_or_else(|| format!("emulated payload: unsupported scalar leaf type {ty}"))?;
+            if bits == 32 {
+                ssbo_u32_store(ctx, cfg, ssbo_var, word_idx, uval);
+            } else {
+                let mask = ctx.const_uint(if bits == 8 { 0xff } else { 0xffff });
+                let sub = ctx.module.fresh_id();
+                cfg.push(Instruction::new(
+                    Op::BitwiseAnd,
+                    Some(uint_ty),
+                    Some(sub),
+                    vec![Operand::IdRef(byte_off), Operand::IdRef(c3)],
+                ));
+                let shift = ctx.module.fresh_id();
+                cfg.push(Instruction::new(
+                    Op::ShiftLeftLogical,
+                    Some(uint_ty),
+                    Some(shift),
+                    vec![Operand::IdRef(sub), Operand::IdRef(c3)],
+                ));
+                let old_word = ssbo_u32_load(ctx, cfg, ssbo_var, word_idx);
+                let shifted_mask = ctx.module.fresh_id();
+                cfg.push(Instruction::new(
+                    Op::ShiftLeftLogical,
+                    Some(uint_ty),
+                    Some(shifted_mask),
+                    vec![Operand::IdRef(mask), Operand::IdRef(shift)],
+                ));
+                let inv_mask = ctx.module.fresh_id();
+                cfg.push(Instruction::new(
+                    Op::Not,
+                    Some(uint_ty),
+                    Some(inv_mask),
+                    vec![Operand::IdRef(shifted_mask)],
+                ));
+                let cleared = ctx.module.fresh_id();
+                cfg.push(Instruction::new(
+                    Op::BitwiseAnd,
+                    Some(uint_ty),
+                    Some(cleared),
+                    vec![Operand::IdRef(old_word), Operand::IdRef(inv_mask)],
+                ));
+                let masked_val = ctx.module.fresh_id();
+                cfg.push(Instruction::new(
+                    Op::BitwiseAnd,
+                    Some(uint_ty),
+                    Some(masked_val),
+                    vec![Operand::IdRef(uval), Operand::IdRef(mask)],
+                ));
+                let placed = ctx.module.fresh_id();
+                cfg.push(Instruction::new(
+                    Op::ShiftLeftLogical,
+                    Some(uint_ty),
+                    Some(placed),
+                    vec![Operand::IdRef(masked_val), Operand::IdRef(shift)],
+                ));
+                let merged = ctx.module.fresh_id();
+                cfg.push(Instruction::new(
+                    Op::BitwiseOr,
+                    Some(uint_ty),
+                    Some(merged),
+                    vec![Operand::IdRef(cleared), Operand::IdRef(placed)],
+                ));
+                ssbo_u32_store(ctx, cfg, ssbo_var, word_idx, merged);
+            }
+        }
+        PayloadCopyDir::SsboToWorkgroup => {
+            let loaded_word = ssbo_u32_load(ctx, cfg, ssbo_var, word_idx);
+            let bits = match def.class.opcode {
+                Op::TypeBool => 8,
+                Op::TypeInt | Op::TypeFloat => match def.operands.first() {
+                    Some(Operand::LiteralBit32(b)) => *b,
+                    _ => 32,
+                },
+                _ => 32,
+            };
+            let raw = if bits == 32 {
+                loaded_word
+            } else {
+                let sub = ctx.module.fresh_id();
+                cfg.push(Instruction::new(
+                    Op::BitwiseAnd,
+                    Some(uint_ty),
+                    Some(sub),
+                    vec![Operand::IdRef(byte_off), Operand::IdRef(c3)],
+                ));
+                let shift = ctx.module.fresh_id();
+                cfg.push(Instruction::new(
+                    Op::ShiftLeftLogical,
+                    Some(uint_ty),
+                    Some(shift),
+                    vec![Operand::IdRef(sub), Operand::IdRef(c3)],
+                ));
+                let shifted = ctx.module.fresh_id();
+                cfg.push(Instruction::new(
+                    Op::ShiftRightLogical,
+                    Some(uint_ty),
+                    Some(shifted),
+                    vec![Operand::IdRef(loaded_word), Operand::IdRef(shift)],
+                ));
+                shifted
+            };
+            let val = u32_bits_to_scalar(ctx, defs, cfg, ty, raw)
+                .ok_or_else(|| format!("emulated payload: unsupported scalar leaf type {ty}"))?;
+            cfg.push(Instruction::new(
+                Op::Store,
+                None,
+                None,
+                vec![Operand::IdRef(wg_ptr), Operand::IdRef(val)],
+            ));
+        }
+    }
+    Ok(())
+}
+
+fn type_has_parallel_array(
+    ctx: &Ctx,
+    defs: &HashMap<Word, Instruction>,
+    ty: Word,
+    field_offset: u32,
+) -> bool {
+    let Some(def) = defs.get(&ty) else {
+        return false;
+    };
+    match def.class.opcode {
+        Op::TypeArray => {
+            let Some(Operand::IdRef(elem)) = def.operands.first() else {
+                return false;
+            };
+            let len = def
+                .operands
+                .get(1)
+                .and_then(|o| match o {
+                    Operand::IdRef(c) => extract_const_u32(defs, *c),
+                    _ => None,
+                })
+                .unwrap_or(0);
+            if len <= 1 {
+                return len == 1 && type_has_parallel_array(ctx, defs, *elem, field_offset);
+            }
+            let (elem_sz, elem_al) = crate::passes::stage_input::layout_ty_size_align(ctx, *elem, defs);
+            let stride = crate::passes::stage_input::round_up(elem_sz, elem_al);
+            let elem_def = defs.get(elem);
+            let elem_is_u8 = elem_def.is_some_and(|d| {
+                d.class.opcode == Op::TypeInt
+                    && d.operands.first() == Some(&Operand::LiteralBit32(8))
+            });
+            let elem_is_16 = elem_def.is_some_and(|d| {
+                matches!(d.class.opcode, Op::TypeInt | Op::TypeFloat)
+                    && d.operands.first() == Some(&Operand::LiteralBit32(16))
+            });
+            field_offset % 4 == 0
+                && ((elem_is_u8 && len >= 4)
+                    || (elem_is_16 && len >= 2)
+                    || (stride >= 4 && stride % 4 == 0))
+        }
+        Op::TypeStruct => {
+            let rule = crate::layout::SpirvLayout::air_offsets(
+                &ctx.air_struct_offsets,
+                ctx.air_data_layout.as_ref(),
+            );
+            (0..def.operands.len()).any(|mi| {
+                crate::layout::spirv_struct_member(ty, mi, defs, rule).is_some_and(
+                    |(off, fty)| type_has_parallel_array(ctx, defs, fty, field_offset + off),
+                )
+            })
+        }
+        _ => false,
+    }
+}
+
+fn emit_lane0_guard<F>(
+    ctx: &mut Ctx,
+    cfg: &mut CfgBuilder,
+    lid: Word,
+    body_fn: F,
+) -> Result<(), String>
+where
+    F: FnOnce(&mut Ctx, &mut CfgBuilder) -> Result<(), String>,
+{
+    let bool_ty = ctx.ty_bool();
+    let c0 = ctx.const_uint(0);
+    let is0 = ctx.module.fresh_id();
+    cfg.push(Instruction::new(
+        Op::IEqual,
+        Some(bool_ty),
+        Some(is0),
+        vec![Operand::IdRef(lid), Operand::IdRef(c0)],
+    ));
+    let then_lbl = ctx.module.fresh_id();
+    let merge_lbl = ctx.module.fresh_id();
+    cfg.push(Instruction::new(
+        Op::SelectionMerge,
+        None,
+        None,
+        vec![
+            Operand::IdRef(merge_lbl),
+            Operand::SelectionControl(spirv::SelectionControl::NONE),
+        ],
+    ));
+    cfg.terminate_and_start(
+        Instruction::new(
+            Op::BranchConditional,
+            None,
+            None,
+            vec![
+                Operand::IdRef(is0),
+                Operand::IdRef(then_lbl),
+                Operand::IdRef(merge_lbl),
+            ],
+        ),
+        then_lbl,
+    );
+    body_fn(ctx, cfg)?;
+    cfg.terminate_and_start(
+        Instruction::new(Op::Branch, None, None, vec![Operand::IdRef(merge_lbl)]),
+        merge_lbl,
+    );
+    Ok(())
+}
+
+fn emit_u32_for_loop<F>(
+    ctx: &mut Ctx,
+    cfg: &mut CfgBuilder,
+    start: Word,
+    limit: Word,
+    step: Word,
+    body_fn: F,
+) -> Result<(), String>
+where
+    F: FnOnce(&mut Ctx, &mut CfgBuilder, Word) -> Result<(), String>,
+{
+    let uint_ty = ctx.ty_uint();
+    let bool_ty = ctx.ty_bool();
+    let pre_lbl = cfg.cur_label;
+    let hdr_lbl = ctx.module.fresh_id();
+    let body_lbl = ctx.module.fresh_id();
+    let cont_lbl = ctx.module.fresh_id();
+    let after_lbl = ctx.module.fresh_id();
+    let i_phi = ctx.module.fresh_id();
+    let i_next = ctx.module.fresh_id();
+    let cond = ctx.module.fresh_id();
+
+    cfg.terminate_and_start(
+        Instruction::new(Op::Branch, None, None, vec![Operand::IdRef(hdr_lbl)]),
+        hdr_lbl,
+    );
+    cfg.push(Instruction::new(
+        Op::Phi,
+        Some(uint_ty),
+        Some(i_phi),
+        vec![
+            Operand::IdRef(start),
+            Operand::IdRef(pre_lbl),
+            Operand::IdRef(i_next),
+            Operand::IdRef(cont_lbl),
+        ],
+    ));
+    cfg.push(Instruction::new(
+        Op::ULessThan,
+        Some(bool_ty),
+        Some(cond),
+        vec![Operand::IdRef(i_phi), Operand::IdRef(limit)],
+    ));
+    cfg.push(Instruction::new(
+        Op::LoopMerge,
+        None,
+        None,
+        vec![
+            Operand::IdRef(after_lbl),
+            Operand::IdRef(cont_lbl),
+            Operand::LoopControl(spirv::LoopControl::NONE),
+        ],
+    ));
+    cfg.terminate_and_start(
+        Instruction::new(
+            Op::BranchConditional,
+            None,
+            None,
+            vec![
+                Operand::IdRef(cond),
+                Operand::IdRef(body_lbl),
+                Operand::IdRef(after_lbl),
+            ],
+        ),
+        body_lbl,
+    );
+    body_fn(ctx, cfg, i_phi)?;
+    cfg.terminate_and_start(
+        Instruction::new(Op::Branch, None, None, vec![Operand::IdRef(cont_lbl)]),
+        cont_lbl,
+    );
+    cfg.push(Instruction::new(
+        Op::IAdd,
+        Some(uint_ty),
+        Some(i_next),
+        vec![Operand::IdRef(i_phi), Operand::IdRef(step)],
+    ));
+    cfg.terminate_and_start(
+        Instruction::new(Op::Branch, None, None, vec![Operand::IdRef(hdr_lbl)]),
+        after_lbl,
+    );
+    Ok(())
+}
+
+#[allow(clippy::too_many_arguments)]
+fn emit_payload_copy_at(
+    ctx: &mut Ctx,
+    defs: &HashMap<Word, Instruction>,
+    cfg: &mut CfgBuilder,
+    dir: PayloadCopyDir,
+    wg_var: Word,
+    indices: &mut Vec<Word>,
+    ty: Word,
+    byte_off: Word,
+    const_byte_off: Option<u32>,
+    ssbo_var: Word,
+    base_word: Word,
+    lid: Word,
+    local_total: u32,
+    in_lane_scope: bool,
+) -> Result<(), String> {
+    let uint_ty = ctx.ty_uint();
+    let c0 = ctx.const_uint(0);
+    let c1 = ctx.const_uint(1);
+    let c2 = ctx.const_uint(2);
+    let def = defs
+        .get(&ty)
+        .ok_or_else(|| format!("emulated payload: missing type def {ty}"))?
+        .clone();
+
+    match def.class.opcode {
+        Op::TypeArray => {
+            let Some(&Operand::IdRef(elem_ty)) = def.operands.first() else {
+                return Err("emulated payload: malformed OpTypeArray".into());
+            };
+            let len = def
+                .operands
+                .get(1)
+                .and_then(|o| match o {
+                    Operand::IdRef(c) => extract_const_u32(defs, *c),
+                    _ => None,
+                })
+                .unwrap_or(0);
+            if len == 0 {
+                return Ok(());
+            }
+            if len == 1 {
+                indices.push(c0);
+                let res = emit_payload_copy_at(
+                    ctx,
+                    defs,
+                    cfg,
+                    dir,
+                    wg_var,
+                    indices,
+                    elem_ty,
+                    byte_off,
+                    const_byte_off,
+                    ssbo_var,
+                    base_word,
+                    lid,
+                    local_total,
+                    in_lane_scope,
+                );
+                indices.pop();
+                return res;
+            }
+            let (elem_sz, elem_al) =
+                crate::passes::stage_input::layout_ty_size_align(ctx, elem_ty, defs);
+            let elem_stride = crate::passes::stage_input::round_up(elem_sz, elem_al).max(1);
+            let elem_def = defs.get(&elem_ty);
+            let elem_is_u8 = elem_def.is_some_and(|d| {
+                d.class.opcode == Op::TypeInt && d.operands.first() == Some(&Operand::LiteralBit32(8))
+            });
+            let elem_is_16 = elem_def.is_some_and(|d| {
+                matches!(d.class.opcode, Op::TypeInt | Op::TypeFloat)
+                    && d.operands.first() == Some(&Operand::LiteralBit32(16))
+            });
+            let aligned4 = const_byte_off.is_some_and(|o| o % 4 == 0);
+
+            if elem_is_u8 && aligned4 && len >= 4 {
+                let n_words = len / 4;
+                let base_off_words = ctx.module.fresh_id();
+                cfg.push(Instruction::new(
+                    Op::ShiftRightLogical,
+                    Some(uint_ty),
+                    Some(base_off_words),
+                    vec![Operand::IdRef(byte_off), Operand::IdRef(c2)],
+                ));
+                let loop_start = if in_lane_scope { c0 } else { lid };
+                let loop_step = if in_lane_scope {
+                    c1
+                } else {
+                    ctx.const_uint(local_total)
+                };
+                let limit = ctx.const_uint(n_words);
+                let c4 = ctx.const_uint(4);
+                let c8 = ctx.const_uint(8);
+                let c16 = ctx.const_uint(16);
+                let c24 = ctx.const_uint(24);
+                emit_u32_for_loop(ctx, cfg, loop_start, limit, loop_step, |ctx, cfg, w| {
+                    let word_idx_0 = ctx.module.fresh_id();
+                    cfg.push(Instruction::new(
+                        Op::IAdd,
+                        Some(uint_ty),
+                        Some(word_idx_0),
+                        vec![Operand::IdRef(base_word), Operand::IdRef(base_off_words)],
+                    ));
+                    let word_idx = ctx.module.fresh_id();
+                    cfg.push(Instruction::new(
+                        Op::IAdd,
+                        Some(uint_ty),
+                        Some(word_idx),
+                        vec![Operand::IdRef(word_idx_0), Operand::IdRef(w)],
+                    ));
+                    let elem_base = ctx.module.fresh_id();
+                    cfg.push(Instruction::new(
+                        Op::IMul,
+                        Some(uint_ty),
+                        Some(elem_base),
+                        vec![Operand::IdRef(w), Operand::IdRef(c4)],
+                    ));
+                    match dir {
+                        PayloadCopyDir::WorkgroupToSsbo => {
+                            let mut acc = c0;
+                            for (lane, sh) in [c0, c8, c16, c24].into_iter().enumerate() {
+                                let idx_lane = if lane == 0 {
+                                    elem_base
+                                } else {
+                                    let cl = ctx.const_uint(lane as u32);
+                                    let id = ctx.module.fresh_id();
+                                    cfg.push(Instruction::new(
+                                        Op::IAdd,
+                                        Some(uint_ty),
+                                        Some(id),
+                                        vec![Operand::IdRef(elem_base), Operand::IdRef(cl)],
+                                    ));
+                                    id
+                                };
+                                indices.push(idx_lane);
+                                let ptr = wg_access_ptr(ctx, cfg, wg_var, indices, elem_ty);
+                                indices.pop();
+                                let b = ctx.module.fresh_id();
+                                cfg.push(Instruction::new(
+                                    Op::Load,
+                                    Some(elem_ty),
+                                    Some(b),
+                                    vec![Operand::IdRef(ptr)],
+                                ));
+                                let u = ctx.module.fresh_id();
+                                cfg.push(Instruction::new(
+                                    Op::UConvert,
+                                    Some(uint_ty),
+                                    Some(u),
+                                    vec![Operand::IdRef(b)],
+                                ));
+                                let part = if lane == 0 {
+                                    u
+                                } else {
+                                    let s = ctx.module.fresh_id();
+                                    cfg.push(Instruction::new(
+                                        Op::ShiftLeftLogical,
+                                        Some(uint_ty),
+                                        Some(s),
+                                        vec![Operand::IdRef(u), Operand::IdRef(sh)],
+                                    ));
+                                    s
+                                };
+                                acc = if lane == 0 {
+                                    part
+                                } else {
+                                    let o = ctx.module.fresh_id();
+                                    cfg.push(Instruction::new(
+                                        Op::BitwiseOr,
+                                        Some(uint_ty),
+                                        Some(o),
+                                        vec![Operand::IdRef(acc), Operand::IdRef(part)],
+                                    ));
+                                    o
+                                };
+                            }
+                            ssbo_u32_store(ctx, cfg, ssbo_var, word_idx, acc);
+                        }
+                        PayloadCopyDir::SsboToWorkgroup => {
+                            let word = ssbo_u32_load(ctx, cfg, ssbo_var, word_idx);
+                            for (lane, sh) in [c0, c8, c16, c24].into_iter().enumerate() {
+                                let shifted = if lane == 0 {
+                                    word
+                                } else {
+                                    let s = ctx.module.fresh_id();
+                                    cfg.push(Instruction::new(
+                                        Op::ShiftRightLogical,
+                                        Some(uint_ty),
+                                        Some(s),
+                                        vec![Operand::IdRef(word), Operand::IdRef(sh)],
+                                    ));
+                                    s
+                                };
+                                let bv = u32_bits_to_scalar(ctx, defs, cfg, elem_ty, shifted)
+                                    .ok_or_else(|| "emulated payload: u8 unpack failed".to_string())?;
+                                let idx_lane = if lane == 0 {
+                                    elem_base
+                                } else {
+                                    let cl = ctx.const_uint(lane as u32);
+                                    let id = ctx.module.fresh_id();
+                                    cfg.push(Instruction::new(
+                                        Op::IAdd,
+                                        Some(uint_ty),
+                                        Some(id),
+                                        vec![Operand::IdRef(elem_base), Operand::IdRef(cl)],
+                                    ));
+                                    id
+                                };
+                                indices.push(idx_lane);
+                                let ptr = wg_access_ptr(ctx, cfg, wg_var, indices, elem_ty);
+                                indices.pop();
+                                cfg.push(Instruction::new(
+                                    Op::Store,
+                                    None,
+                                    None,
+                                    vec![Operand::IdRef(ptr), Operand::IdRef(bv)],
+                                ));
+                            }
+                        }
+                    }
+                    Ok(())
+                })?;
+                if len % 4 != 0 {
+                    let emit_tail = |ctx: &mut Ctx, cfg: &mut CfgBuilder, indices: &mut Vec<Word>| -> Result<(), String> {
+                        for k in (n_words * 4)..len {
+                            let ck = ctx.const_uint(k);
+                            let off_k = ctx.module.fresh_id();
+                            cfg.push(Instruction::new(
+                                Op::IAdd,
+                                Some(uint_ty),
+                                Some(off_k),
+                                vec![Operand::IdRef(byte_off), Operand::IdRef(ck)],
+                            ));
+                            indices.push(ck);
+                            let r = copy_subword_or_word_scalar(
+                                ctx, defs, cfg, dir, wg_var, indices, elem_ty, off_k, ssbo_var, base_word,
+                            );
+                            indices.pop();
+                            r?;
+                        }
+                        Ok(())
+                    };
+                    if in_lane_scope {
+                        emit_tail(ctx, cfg, indices)?;
+                    } else {
+                        emit_lane0_guard(ctx, cfg, lid, |ctx, cfg| emit_tail(ctx, cfg, indices))?;
+                    }
+                }
+                return Ok(());
+            }
+
+            if elem_is_16 && aligned4 && len >= 2 {
+                let n_words = len / 2;
+                let base_off_words = ctx.module.fresh_id();
+                cfg.push(Instruction::new(
+                    Op::ShiftRightLogical,
+                    Some(uint_ty),
+                    Some(base_off_words),
+                    vec![Operand::IdRef(byte_off), Operand::IdRef(c2)],
+                ));
+                let loop_start = if in_lane_scope { c0 } else { lid };
+                let loop_step = if in_lane_scope {
+                    c1
+                } else {
+                    ctx.const_uint(local_total)
+                };
+                let limit = ctx.const_uint(n_words);
+                let c16 = ctx.const_uint(16);
+                emit_u32_for_loop(ctx, cfg, loop_start, limit, loop_step, |ctx, cfg, w| {
+                    let word_idx_0 = ctx.module.fresh_id();
+                    cfg.push(Instruction::new(
+                        Op::IAdd,
+                        Some(uint_ty),
+                        Some(word_idx_0),
+                        vec![Operand::IdRef(base_word), Operand::IdRef(base_off_words)],
+                    ));
+                    let word_idx = ctx.module.fresh_id();
+                    cfg.push(Instruction::new(
+                        Op::IAdd,
+                        Some(uint_ty),
+                        Some(word_idx),
+                        vec![Operand::IdRef(word_idx_0), Operand::IdRef(w)],
+                    ));
+                    let elem0 = ctx.module.fresh_id();
+                    cfg.push(Instruction::new(
+                        Op::IMul,
+                        Some(uint_ty),
+                        Some(elem0),
+                        vec![Operand::IdRef(w), Operand::IdRef(c2)],
+                    ));
+                    let elem1 = ctx.module.fresh_id();
+                    cfg.push(Instruction::new(
+                        Op::IAdd,
+                        Some(uint_ty),
+                        Some(elem1),
+                        vec![Operand::IdRef(elem0), Operand::IdRef(c1)],
+                    ));
+                    match dir {
+                        PayloadCopyDir::WorkgroupToSsbo => {
+                            indices.push(elem0);
+                            let p0 = wg_access_ptr(ctx, cfg, wg_var, indices, elem_ty);
+                            indices.pop();
+                            let v0 = ctx.module.fresh_id();
+                            cfg.push(Instruction::new(
+                                Op::Load,
+                                Some(elem_ty),
+                                Some(v0),
+                                vec![Operand::IdRef(p0)],
+                            ));
+                            let (_, u0) = scalar_to_u32_bits(ctx, defs, cfg, elem_ty, v0)
+                                .ok_or_else(|| "emulated payload: 16-bit pack failed".to_string())?;
+                            indices.push(elem1);
+                            let p1 = wg_access_ptr(ctx, cfg, wg_var, indices, elem_ty);
+                            indices.pop();
+                            let v1 = ctx.module.fresh_id();
+                            cfg.push(Instruction::new(
+                                Op::Load,
+                                Some(elem_ty),
+                                Some(v1),
+                                vec![Operand::IdRef(p1)],
+                            ));
+                            let (_, u1) = scalar_to_u32_bits(ctx, defs, cfg, elem_ty, v1)
+                                .ok_or_else(|| "emulated payload: 16-bit pack failed".to_string())?;
+                            let hi = ctx.module.fresh_id();
+                            cfg.push(Instruction::new(
+                                Op::ShiftLeftLogical,
+                                Some(uint_ty),
+                                Some(hi),
+                                vec![Operand::IdRef(u1), Operand::IdRef(c16)],
+                            ));
+                            let packed = ctx.module.fresh_id();
+                            cfg.push(Instruction::new(
+                                Op::BitwiseOr,
+                                Some(uint_ty),
+                                Some(packed),
+                                vec![Operand::IdRef(u0), Operand::IdRef(hi)],
+                            ));
+                            ssbo_u32_store(ctx, cfg, ssbo_var, word_idx, packed);
+                        }
+                        PayloadCopyDir::SsboToWorkgroup => {
+                            let word = ssbo_u32_load(ctx, cfg, ssbo_var, word_idx);
+                            let hi = ctx.module.fresh_id();
+                            cfg.push(Instruction::new(
+                                Op::ShiftRightLogical,
+                                Some(uint_ty),
+                                Some(hi),
+                                vec![Operand::IdRef(word), Operand::IdRef(c16)],
+                            ));
+                            let v0 = u32_bits_to_scalar(ctx, defs, cfg, elem_ty, word)
+                                .ok_or_else(|| "emulated payload: 16-bit unpack failed".to_string())?;
+                            let v1 = u32_bits_to_scalar(ctx, defs, cfg, elem_ty, hi)
+                                .ok_or_else(|| "emulated payload: 16-bit unpack failed".to_string())?;
+                            indices.push(elem0);
+                            let p0 = wg_access_ptr(ctx, cfg, wg_var, indices, elem_ty);
+                            indices.pop();
+                            cfg.push(Instruction::new(
+                                Op::Store,
+                                None,
+                                None,
+                                vec![Operand::IdRef(p0), Operand::IdRef(v0)],
+                            ));
+                            indices.push(elem1);
+                            let p1 = wg_access_ptr(ctx, cfg, wg_var, indices, elem_ty);
+                            indices.pop();
+                            cfg.push(Instruction::new(
+                                Op::Store,
+                                None,
+                                None,
+                                vec![Operand::IdRef(p1), Operand::IdRef(v1)],
+                            ));
+                        }
+                    }
+                    Ok(())
+                })?;
+                if len % 2 != 0 {
+                    let last = len - 1;
+                    let emit_tail = |ctx: &mut Ctx, cfg: &mut CfgBuilder, indices: &mut Vec<Word>| -> Result<(), String> {
+                        let cl = ctx.const_uint(last);
+                        let c_off = ctx.const_uint(last * 2);
+                        let off_k = ctx.module.fresh_id();
+                        cfg.push(Instruction::new(
+                            Op::IAdd,
+                            Some(uint_ty),
+                            Some(off_k),
+                            vec![Operand::IdRef(byte_off), Operand::IdRef(c_off)],
+                        ));
+                        indices.push(cl);
+                        let r = copy_subword_or_word_scalar(
+                            ctx, defs, cfg, dir, wg_var, indices, elem_ty, off_k, ssbo_var, base_word,
+                        );
+                        indices.pop();
+                        r
+                    };
+                    if in_lane_scope {
+                        emit_tail(ctx, cfg, indices)?;
+                    } else {
+                        emit_lane0_guard(ctx, cfg, lid, |ctx, cfg| emit_tail(ctx, cfg, indices))?;
+                    }
+                }
+                return Ok(());
+            }
+
+            // General array: parallel across workgroup only when element stride is a multiple of 4
+            // bytes at a 4-byte-aligned offset so distinct lanes never share an SSBO u32 word.
+            let can_parallelize =
+                !in_lane_scope && elem_stride >= 4 && elem_stride % 4 == 0 && aligned4;
+            let emit_loop = |ctx: &mut Ctx, cfg: &mut CfgBuilder, indices: &mut Vec<Word>, parallel: bool| -> Result<(), String> {
+                let loop_start = if parallel { lid } else { c0 };
+                let loop_step = if parallel {
+                    ctx.const_uint(local_total)
+                } else {
+                    c1
+                };
+                let limit = ctx.const_uint(len);
+                let c_stride = ctx.const_uint(elem_stride);
+                emit_u32_for_loop(ctx, cfg, loop_start, limit, loop_step, |ctx, cfg, i| {
+                    let delta = ctx.module.fresh_id();
+                    cfg.push(Instruction::new(
+                        Op::IMul,
+                        Some(uint_ty),
+                        Some(delta),
+                        vec![Operand::IdRef(i), Operand::IdRef(c_stride)],
+                    ));
+                    let elem_off = ctx.module.fresh_id();
+                    cfg.push(Instruction::new(
+                        Op::IAdd,
+                        Some(uint_ty),
+                        Some(elem_off),
+                        vec![Operand::IdRef(byte_off), Operand::IdRef(delta)],
+                    ));
+                    indices.push(i);
+                    let r = emit_payload_copy_at(
+                        ctx,
+                        defs,
+                        cfg,
+                        dir,
+                        wg_var,
+                        indices,
+                        elem_ty,
+                        elem_off,
+                        None,
+                        ssbo_var,
+                        base_word,
+                        lid,
+                        local_total,
+                        true,
+                    );
+                    indices.pop();
+                    r
+                })
+            };
+            if can_parallelize {
+                emit_loop(ctx, cfg, indices, true)
+            } else if in_lane_scope {
+                emit_loop(ctx, cfg, indices, false)
+            } else {
+                emit_lane0_guard(ctx, cfg, lid, |ctx, cfg| {
+                    emit_loop(ctx, cfg, indices, false)
+                })
+            }
+        }
+        Op::TypeStruct => {
+            let rule = crate::layout::SpirvLayout::air_offsets(
+                &ctx.air_struct_offsets,
+                ctx.air_data_layout.as_ref(),
+            );
+            let mut fields = Vec::with_capacity(def.operands.len());
+            for mi in 0..def.operands.len() {
+                if let Some((off, fty)) = crate::layout::spirv_struct_member(ty, mi, defs, rule) {
+                    fields.push((mi as u32, off, fty));
+                }
+            }
+            if in_lane_scope {
+                for (mi, off, fty) in fields {
+                    let f_off = if off == 0 {
+                        byte_off
+                    } else {
+                        let c_off = ctx.const_uint(off);
+                        let id = ctx.module.fresh_id();
+                        cfg.push(Instruction::new(
+                            Op::IAdd,
+                            Some(uint_ty),
+                            Some(id),
+                            vec![Operand::IdRef(byte_off), Operand::IdRef(c_off)],
+                        ));
+                        id
+                    };
+                    indices.push(ctx.const_uint(mi));
+                    let r = emit_payload_copy_at(
+                        ctx,
+                        defs,
+                        cfg,
+                        dir,
+                        wg_var,
+                        indices,
+                        fty,
+                        f_off,
+                        const_byte_off.map(|b| b + off),
+                        ssbo_var,
+                        base_word,
+                        lid,
+                        local_total,
+                        true,
+                    );
+                    indices.pop();
+                    r?;
+                }
+                return Ok(());
+            }
+            let base_const = const_byte_off.unwrap_or(0);
+            let mut lane0_fields = Vec::new();
+            let mut parallel_fields = Vec::new();
+            for (mi, off, fty) in fields {
+                if type_has_parallel_array(ctx, defs, fty, base_const + off) {
+                    parallel_fields.push((mi, off, fty));
+                } else {
+                    lane0_fields.push((mi, off, fty));
+                }
+            }
+            if !lane0_fields.is_empty() {
+                emit_lane0_guard(ctx, cfg, lid, |ctx, cfg| {
+                    for (mi, off, fty) in lane0_fields {
+                        let f_off = if off == 0 {
+                            byte_off
+                        } else {
+                            let c_off = ctx.const_uint(off);
+                            let id = ctx.module.fresh_id();
+                            cfg.push(Instruction::new(
+                                Op::IAdd,
+                                Some(uint_ty),
+                                Some(id),
+                                vec![Operand::IdRef(byte_off), Operand::IdRef(c_off)],
+                            ));
+                            id
+                        };
+                        indices.push(ctx.const_uint(mi));
+                        let r = emit_payload_copy_at(
+                            ctx,
+                            defs,
+                            cfg,
+                            dir,
+                            wg_var,
+                            indices,
+                            fty,
+                            f_off,
+                            const_byte_off.map(|b| b + off),
+                            ssbo_var,
+                            base_word,
+                            lid,
+                            local_total,
+                            true,
+                        );
+                        indices.pop();
+                        r?;
+                    }
+                    Ok(())
+                })?;
+            }
+            for (mi, off, fty) in parallel_fields {
+                let f_off = if off == 0 {
+                    byte_off
+                } else {
+                    let c_off = ctx.const_uint(off);
+                    let id = ctx.module.fresh_id();
+                    cfg.push(Instruction::new(
+                        Op::IAdd,
+                        Some(uint_ty),
+                        Some(id),
+                        vec![Operand::IdRef(byte_off), Operand::IdRef(c_off)],
+                    ));
+                    id
+                };
+                indices.push(ctx.const_uint(mi));
+                let r = emit_payload_copy_at(
+                    ctx,
+                    defs,
+                    cfg,
+                    dir,
+                    wg_var,
+                    indices,
+                    fty,
+                    f_off,
+                    const_byte_off.map(|b| b + off),
+                    ssbo_var,
+                    base_word,
+                    lid,
+                    local_total,
+                    false,
+                );
+                indices.pop();
+                r?;
+            }
+            Ok(())
+        }
+        Op::TypeVector => {
+            let Some(&Operand::IdRef(comp_ty)) = def.operands.first() else {
+                return Err("emulated payload: malformed OpTypeVector".into());
+            };
+            let lanes = match def.operands.get(1) {
+                Some(Operand::LiteralBit32(n)) => *n,
+                _ => return Err("emulated payload: malformed vector lane count".into()),
+            };
+            let (comp_sz, _) =
+                crate::passes::stage_input::layout_ty_size_align(ctx, comp_ty, defs);
+            let do_vec = |ctx: &mut Ctx, cfg: &mut CfgBuilder, indices: &mut Vec<Word>| -> Result<(), String> {
+                for lane in 0..lanes {
+                    let c_lane = ctx.const_uint(lane);
+                    let lane_off = if lane == 0 {
+                        byte_off
+                    } else {
+                        let c_delta = ctx.const_uint(lane * comp_sz);
+                        let id = ctx.module.fresh_id();
+                        cfg.push(Instruction::new(
+                            Op::IAdd,
+                            Some(uint_ty),
+                            Some(id),
+                            vec![Operand::IdRef(byte_off), Operand::IdRef(c_delta)],
+                        ));
+                        id
+                    };
+                    indices.push(c_lane);
+                    let r = copy_subword_or_word_scalar(
+                        ctx, defs, cfg, dir, wg_var, indices, comp_ty, lane_off, ssbo_var, base_word,
+                    );
+                    indices.pop();
+                    r?;
+                }
+                Ok(())
+            };
+            if in_lane_scope {
+                do_vec(ctx, cfg, indices)
+            } else {
+                emit_lane0_guard(ctx, cfg, lid, |ctx, cfg| do_vec(ctx, cfg, indices))
+            }
+        }
+        _ => {
+            if in_lane_scope {
+                copy_subword_or_word_scalar(
+                    ctx, defs, cfg, dir, wg_var, indices, ty, byte_off, ssbo_var, base_word,
+                )
+            } else {
+                emit_lane0_guard(ctx, cfg, lid, |ctx, cfg| {
+                    copy_subword_or_word_scalar(
+                        ctx, defs, cfg, dir, wg_var, indices, ty, byte_off, ssbo_var, base_word,
+                    )
+                })
+            }
+        }
+    }
+}
+
+fn find_variable_pointee_type(ctx: &Ctx, var: Word) -> Option<Word> {
+    let ptr_ty = ctx
+        .module
+        .types_global_values
+        .iter()
+        .chain(ctx.new_globals.iter())
+        .find(|i| i.result_id == Some(var) && i.class.opcode == Op::Variable)?
+        .result_type?;
+    let ptr_def = ctx
+        .module
+        .types_global_values
+        .iter()
+        .chain(ctx.new_globals.iter())
+        .find(|i| i.result_id == Some(ptr_ty) && i.class.opcode == Op::TypePointer)?;
+    match ptr_def.operands.get(1) {
+        Some(Operand::IdRef(pt)) => Some(*pt),
+        _ => None,
+    }
+}
+
+/// Finalize GFX-ring emulated Object+Mesh stages after Workgroup passes and zero-initialization:
+/// - `Stage::Object`: replaces each `OpReturn` with a barrier, `ogid` calculation from
+///   `WorkgroupId` + binding 673 (`grid_params`), parallel `Workgroup -> SSBO` copy to binding
+///   674 (`payload`), barrier, and lane-0 write of `grid_var[0..2]` to binding 675 (`indirect`).
+/// - `Stage::Mesh` (only when `task_payload_var` is present): splices a prologue after entry
+///   Workgroup zero-init reading `BuiltIn DrawIndex` + binding 673 (`payload_stride_bytes`),
+///   copying binding 674 (`payload`) -> `Workgroup` payload in parallel, and synchronizing via a
+///   Workgroup barrier before any mesh shader instruction reads the payload.
+pub(in crate::passes) fn finalize_emulated_object_mesh_stage(
+    ctx: &mut Ctx,
+    entry_idx: usize,
+    stage: &Stage,
+) -> Result<(), String> {
+    match stage {
+        Stage::Object => finalize_emulated_object_stage(ctx, entry_idx),
+        Stage::Mesh => finalize_emulated_mesh_stage(ctx, entry_idx),
+        _ => Ok(()),
+    }
+}
+
+fn finalize_emulated_object_stage(ctx: &mut Ctx, entry_idx: usize) -> Result<(), String> {
+    let Some(grid_var) = ctx.task_mesh_grid_var else {
+        return Err("emulated object stage missing workgroup mesh grid variable".into());
+    };
+    let uint_ty = ctx.ty_uint();
+    let v3u_ty = ctx.ty_vec_uint(3);
+    let wg_u32_ptr_ty = ctx.ty_ptr(StorageClass::Workgroup, uint_ty);
+    let grid_params_var = make_emulated_grid_params_ssbo(ctx)?;
+    let indirect_var = make_emulated_u32_ssbo(
+        ctx,
+        crate::reflect::MESH_EMULATED_INDIRECT_BINDING,
+        false,
+    )?;
+    let payload_info = if let Some(wg_payload_var) = ctx.task_payload_var {
+        let pointee = find_variable_pointee_type(ctx, wg_payload_var)
+            .ok_or_else(|| "emulated object payload variable has no pointee type".to_string())?;
+        let payload_ssbo_var = make_emulated_u32_ssbo(
+            ctx,
+            crate::reflect::MESH_EMULATED_PAYLOAD_BINDING,
+            false,
+        )?;
+        Some((wg_payload_var, pointee, payload_ssbo_var))
+    } else {
+        None
+    };
+    let wg_id_var = ensure_input_builtin_var(ctx, BuiltIn::WorkgroupId, v3u_ty);
+    let lid_var = ensure_input_builtin_var(ctx, BuiltIn::LocalInvocationIndex, uint_ty);
+    let (defs, _) = collect_defs_and_value_types(ctx, entry_idx);
+    let local_total = ctx.kernel_local_size[0]
+        .saturating_mul(ctx.kernel_local_size[1])
+        .saturating_mul(ctx.kernel_local_size[2])
+        .max(1);
+
+    let return_blocks: Vec<usize> = ctx.module.functions[entry_idx]
+        .blocks
+        .iter()
+        .enumerate()
+        .filter_map(|(bi, blk)| {
+            blk.instructions
+                .iter()
+                .any(|i| i.class.opcode == Op::Return)
+                .then_some(bi)
+        })
+        .collect();
+
+    let c0 = ctx.const_uint(0);
+    let c1 = ctx.const_uint(1);
+    let c2 = ctx.const_uint(2);
+    let c3 = ctx.const_uint(3);
+
+    for bi in return_blocks.into_iter().rev() {
+        let Some(orig_label) = ctx.module.functions[entry_idx].blocks[bi]
+            .label
+            .as_ref()
+            .and_then(|l| l.result_id)
+        else {
+            continue;
+        };
+        let Some(ret_pos) = ctx.module.functions[entry_idx].blocks[bi]
+            .instructions
+            .iter()
+            .position(|i| i.class.opcode == Op::Return)
+        else {
+            continue;
+        };
+        let prefix = ctx.module.functions[entry_idx].blocks[bi].instructions[..ret_pos].to_vec();
+        let mut cfg = CfgBuilder::new(orig_label, prefix);
+
+        // Ensure all object-workgroup stores to payload and grid_var complete before reading.
+        emit_workgroup_barrier(ctx, &mut cfg.cur_insts);
+
+        let wg_vec = ctx.module.fresh_id();
+        cfg.push(Instruction::new(
+            Op::Load,
+            Some(v3u_ty),
+            Some(wg_vec),
+            vec![Operand::IdRef(wg_id_var)],
+        ));
+        let wg_x = ctx.module.fresh_id();
+        cfg.push(Instruction::new(
+            Op::CompositeExtract,
+            Some(uint_ty),
+            Some(wg_x),
+            vec![Operand::IdRef(wg_vec), Operand::LiteralBit32(0)],
+        ));
+        let wg_y = ctx.module.fresh_id();
+        cfg.push(Instruction::new(
+            Op::CompositeExtract,
+            Some(uint_ty),
+            Some(wg_y),
+            vec![Operand::IdRef(wg_vec), Operand::LiteralBit32(1)],
+        ));
+        let wg_z = ctx.module.fresh_id();
+        cfg.push(Instruction::new(
+            Op::CompositeExtract,
+            Some(uint_ty),
+            Some(wg_z),
+            vec![Operand::IdRef(wg_vec), Operand::LiteralBit32(2)],
+        ));
+        let grid_x = grid_params_load_field(ctx, &mut cfg, grid_params_var, 0);
+        let grid_y = grid_params_load_field(ctx, &mut cfg, grid_params_var, 1);
+        let grid_xy = ctx.module.fresh_id();
+        cfg.push(Instruction::new(
+            Op::IMul,
+            Some(uint_ty),
+            Some(grid_xy),
+            vec![Operand::IdRef(grid_x), Operand::IdRef(grid_y)],
+        ));
+        let z_term = ctx.module.fresh_id();
+        cfg.push(Instruction::new(
+            Op::IMul,
+            Some(uint_ty),
+            Some(z_term),
+            vec![Operand::IdRef(wg_z), Operand::IdRef(grid_xy)],
+        ));
+        let y_term = ctx.module.fresh_id();
+        cfg.push(Instruction::new(
+            Op::IMul,
+            Some(uint_ty),
+            Some(y_term),
+            vec![Operand::IdRef(wg_y), Operand::IdRef(grid_x)],
+        ));
+        let z_plus_y = ctx.module.fresh_id();
+        cfg.push(Instruction::new(
+            Op::IAdd,
+            Some(uint_ty),
+            Some(z_plus_y),
+            vec![Operand::IdRef(z_term), Operand::IdRef(y_term)],
+        ));
+        let ogid = ctx.module.fresh_id();
+        cfg.push(Instruction::new(
+            Op::IAdd,
+            Some(uint_ty),
+            Some(ogid),
+            vec![Operand::IdRef(z_plus_y), Operand::IdRef(wg_x)],
+        ));
+        let lid = ctx.module.fresh_id();
+        cfg.push(Instruction::new(
+            Op::Load,
+            Some(uint_ty),
+            Some(lid),
+            vec![Operand::IdRef(lid_var)],
+        ));
+
+        if let Some((wg_payload_var, payload_pointee, payload_ssbo_var)) = payload_info {
+            let stride_bytes = grid_params_load_field(ctx, &mut cfg, grid_params_var, 3);
+            let stride_words = ctx.module.fresh_id();
+            cfg.push(Instruction::new(
+                Op::ShiftRightLogical,
+                Some(uint_ty),
+                Some(stride_words),
+                vec![Operand::IdRef(stride_bytes), Operand::IdRef(c2)],
+            ));
+            let base_word = ctx.module.fresh_id();
+            cfg.push(Instruction::new(
+                Op::IMul,
+                Some(uint_ty),
+                Some(base_word),
+                vec![Operand::IdRef(ogid), Operand::IdRef(stride_words)],
+            ));
+            let mut indices = Vec::new();
+            emit_payload_copy_at(
+                ctx,
+                &defs,
+                &mut cfg,
+                PayloadCopyDir::WorkgroupToSsbo,
+                wg_payload_var,
+                &mut indices,
+                payload_pointee,
+                c0,
+                Some(0),
+                payload_ssbo_var,
+                base_word,
+                lid,
+                local_total,
+                false,
+            )?;
+            let wg_scope = ctx.const_uint(Scope::Workgroup as u32);
+            let sem = ctx.const_uint(
+                (MemorySemantics::ACQUIRE_RELEASE
+                    | MemorySemantics::WORKGROUP_MEMORY
+                    | MemorySemantics::UNIFORM_MEMORY)
+                    .bits(),
+            );
+            cfg.push(Instruction::new(
+                Op::ControlBarrier,
+                None,
+                None,
+                vec![
+                    Operand::IdScope(wg_scope),
+                    Operand::IdScope(wg_scope),
+                    Operand::IdMemorySemantics(sem),
+                ],
+            ));
+        }
+
+        emit_lane0_guard(ctx, &mut cfg, lid, |ctx, cfg| {
+            let ind_base = ctx.module.fresh_id();
+            cfg.push(Instruction::new(
+                Op::IMul,
+                Some(uint_ty),
+                Some(ind_base),
+                vec![Operand::IdRef(ogid), Operand::IdRef(c3)],
+            ));
+            for (lane, idx_const) in [c0, c1, c2].into_iter().enumerate() {
+                let p = ctx.module.fresh_id();
+                cfg.push(Instruction::new(
+                    Op::AccessChain,
+                    Some(wg_u32_ptr_ty),
+                    Some(p),
+                    vec![Operand::IdRef(grid_var), Operand::IdRef(idx_const)],
+                ));
+                let dim = ctx.module.fresh_id();
+                cfg.push(Instruction::new(
+                    Op::Load,
+                    Some(uint_ty),
+                    Some(dim),
+                    vec![Operand::IdRef(p)],
+                ));
+                let dst_idx = if lane == 0 {
+                    ind_base
+                } else {
+                    let id = ctx.module.fresh_id();
+                    cfg.push(Instruction::new(
+                        Op::IAdd,
+                        Some(uint_ty),
+                        Some(id),
+                        vec![Operand::IdRef(ind_base), Operand::IdRef(idx_const)],
+                    ));
+                    id
+                };
+                ssbo_u32_store(ctx, cfg, indirect_var, dst_idx, dim);
+            }
+            Ok(())
+        })?;
+        cfg.push(Instruction::new(Op::Return, None, None, vec![]));
+
+        let new_blocks = cfg.finish();
+        ctx.module.functions[entry_idx]
+            .blocks
+            .splice(bi..=bi, new_blocks);
+    }
+    Ok(())
+}
