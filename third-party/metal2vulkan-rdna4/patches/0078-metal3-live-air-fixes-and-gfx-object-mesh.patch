+
+        let mesh_payload_sampler = r#"
+%struct.Payload = type { [16 x i32] }
+%struct._texture_2d_t = type opaque
+%struct._sampler_t = type opaque
+
+define void @mesh_samp_payload(ptr addrspace(6) %payload, ptr addrspace(1) %out_mesh, ptr addrspace(1) %tex, ptr addrspace(2) %samp) {
