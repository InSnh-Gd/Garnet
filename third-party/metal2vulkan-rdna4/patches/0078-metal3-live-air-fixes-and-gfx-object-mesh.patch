+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum InterpolateAtMode {
+    Center,
+    Centroid,
+    Sample,
+    Offset,
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct InterpolateAtIntrinsic {
+    pub mode: InterpolateAtMode,
+    pub no_perspective: bool,
+}
+
+/// Parse all Apple AIR pull-model interpolation intrinsic naming variants:
+/// - `air.interpolate_{center,centroid,sample,offset}_{no_perspective,perspective}.*`
+/// - `air.interpolate_{center,centroid,sample,offset}.*`
+/// - `air.interpolate_at_{center,centroid,sample,offset}[_{no_perspective,perspective}|.{no_perspective,perspective}].*`
+pub fn parse_interpolate_at_intrinsic(name: &str) -> Option<InterpolateAtIntrinsic> {
+    let rest = name
+        .strip_prefix("air.interpolate_at_")
+        .or_else(|| name.strip_prefix("air.interpolate_"))?;
+    let (mode, tail) = if let Some(t) = rest.strip_prefix("center") {
+        (InterpolateAtMode::Center, t)
+    } else if let Some(t) = rest.strip_prefix("centroid") {
+        (InterpolateAtMode::Centroid, t)
+    } else if let Some(t) = rest.strip_prefix("sample") {
+        (InterpolateAtMode::Sample, t)
+    } else if let Some(t) = rest.strip_prefix("offset") {
+        (InterpolateAtMode::Offset, t)
+    } else {
+        return None;
+    };
+    let (no_perspective, after_persp) = if let Some(t) = tail.strip_prefix("_no_perspective") {
+        (true, t)
+    } else if let Some(t) = tail.strip_prefix("_perspective") {
+        (false, t)
+    } else if let Some(t) = tail.strip_prefix(".no_perspective") {
+        (true, t)
+    } else if let Some(t) = tail.strip_prefix(".perspective") {
+        (false, t)
+    } else {
+        (
+            tail.contains(".no_perspective") || tail.contains("_no_perspective"),
+            tail,
+        )
+    };
+    if after_persp.is_empty() || after_persp.starts_with('.') {
+        Some(InterpolateAtIntrinsic {
+            mode,
+            no_perspective,
+        })
+    } else {
+        None
+    }
+}
+
 pub fn is_interpolate_at_intrinsic(name: &str) -> bool {
-    any_typed(
