+    fn has_binding(m: &crate::spirv_module::Module, binding: u32) -> bool {
+        m.annotations.iter().any(|i| {
+            i.class.opcode == Op::Decorate
+                && i.operands.get(1) == Some(&Operand::Decoration(Decoration::Binding))
+                && i.operands.get(2) == Some(&Operand::LiteralBit32(binding))
+        })
+    }
