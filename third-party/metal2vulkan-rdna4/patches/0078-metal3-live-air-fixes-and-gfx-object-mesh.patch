+    #[test]
+    fn emulated_mesh_array_first_payload_preserves_phi_seeded_by_local_invocation_index() {
+        let ll = r#"
+%struct.Payload16K = type { [4096 x i32] }
+
+define void @mesh_arr_first(ptr addrspace(7) %payload, ptr addrspace(1) %out_mesh, i32 %tid) {
+entry:
+  %is0 = icmp eq i32 %tid, 0
+  br i1 %is0, label %emit, label %done
+
+emit:
+  call void @air.set_mesh_primitive_count(ptr addrspace(1) %out_mesh, i32 1)
+  %p0 = getelementptr inbounds %struct.Payload16K, ptr addrspace(7) %payload, i32 0, i32 0, i32 0
+  %p31 = getelementptr inbounds %struct.Payload16K, ptr addrspace(7) %payload, i32 0, i32 0, i32 31
+  %plast = getelementptr inbounds %struct.Payload16K, ptr addrspace(7) %payload, i32 0, i32 0, i32 4095
+  %w0 = load i32, ptr addrspace(7) %p0, align 4
+  %w31 = load i32, ptr addrspace(7) %p31, align 4
+  %wl = load i32, ptr addrspace(7) %plast, align 4
+  %s0 = add i32 %w0, %w31
+  %s1 = add i32 %s0, %wl
+  %sf = sitofp i32 %s1 to float
+  %pos = insertelement <4 x float> <float 0.0, float 0.0, float 0.0, float 1.0>, float %sf, i32 0
+  call void @air.set_mesh_vertex_position(ptr addrspace(1) %out_mesh, i32 0, <4 x float> %pos)
+  call void @air.set_mesh_vertex_position(ptr addrspace(1) %out_mesh, i32 1, <4 x float> <float 1.0, float 0.0, float 0.0, float 1.0>)
+  call void @air.set_mesh_vertex_position(ptr addrspace(1) %out_mesh, i32 2, <4 x float> <float 0.0, float 1.0, float 0.0, float 1.0>)
+  call void @air.set_mesh_index(ptr addrspace(1) %out_mesh, i32 0, i32 0)
+  call void @air.set_mesh_index(ptr addrspace(1) %out_mesh, i32 1, i32 1)
+  call void @air.set_mesh_index(ptr addrspace(1) %out_mesh, i32 2, i32 2)
+  br label %done
+
+done:
+  ret void
+}
+declare void @air.set_mesh_primitive_count(ptr addrspace(1), i32)
+declare void @air.set_mesh_vertex_position(ptr addrspace(1), i32, <4 x float>)
+declare void @air.set_mesh_index(ptr addrspace(1), i32, i32)
+!air.mesh = !{!0}
+!0 = !{ptr @mesh_arr_first, !1, !2, !7}
+!1 = !{!6}
+!2 = !{!3, !4, !5}
+!3 = !{i32 0, !"air.payload", !"air.arg_type_size", i32 16384, !"air.arg_type_name", !"Payload16K"}
+!4 = !{i32 1, !"air.mesh", !"air.arg_type_name", !"mesh<V, void, 3, 1, topology::triangle>"}
+!5 = !{i32 2, !"air.thread_index_in_threadgroup"}
+!6 = !{i32 0, !"air.position"}
+!7 = !{!"air.mesh_topology", !"triangle", !"air.max_vertices", i32 3, !"air.max_primitives", i32 1}
+"#;
+        let (module, refl) = translate_emulated(ll, Stage::Mesh, [32, 1, 1]);
+        assert!(refl.mesh.as_ref().is_some_and(|m| m.emulated_payload));
+        let lid_var = module
+            .annotations
+            .iter()
+            .find_map(|a| {
+                (a.class.opcode == Op::Decorate
+                    && a.operands.get(1) == Some(&Operand::Decoration(Decoration::BuiltIn))
+                    && a.operands.get(2) == Some(&Operand::BuiltIn(BuiltIn::LocalInvocationIndex)))
+                .then(|| match a.operands.first() {
+                    Some(Operand::IdRef(id)) => *id,
+                    _ => 0,
+                })
+            })
+            .expect("BuiltIn LocalInvocationIndex variable");
+        let entry = &module.functions[0];
+        let mut preds: std::collections::HashMap<u32, std::collections::HashSet<u32>> =
+            std::collections::HashMap::new();
+        let mut lid_loads: std::collections::HashMap<u32, u32> = std::collections::HashMap::new();
+        for blk in &entry.blocks {
+            let lbl = blk.label.as_ref().and_then(|l| l.result_id).unwrap();
+            for inst in &blk.instructions {
+                if inst.class.opcode == Op::Load
+                    && inst.operands.first() == Some(&Operand::IdRef(lid_var))
+                {
+                    if let Some(res) = inst.result_id {
+                        lid_loads.insert(res, lbl);
+                    }
+                }
+            }
+            if let Some(term) = blk.instructions.last() {
+                match term.class.opcode {
+                    Op::Branch => {
+                        if let Some(&Operand::IdRef(dst)) = term.operands.first() {
+                            preds.entry(dst).or_default().insert(lbl);
+                        }
+                    }
+                    Op::BranchConditional => {
+                        for idx in [1, 2] {
+                            if let Some(&Operand::IdRef(dst)) = term.operands.get(idx) {
+                                preds.entry(dst).or_default().insert(lbl);
+                            }
+                        }
+                    }
+                    Op::Switch => {
+                        if let Some(&Operand::IdRef(def)) = term.operands.get(1) {
+                            preds.entry(def).or_default().insert(lbl);
+                        }
+                        for pair in term.operands.iter().skip(2).collect::<Vec<_>>().chunks_exact(2)
+                        {
+                            if let Operand::IdRef(dst) = pair[1] {
+                                preds.entry(*dst).or_default().insert(lbl);
+                            }
+                        }
+                    }
+                    _ => {}
+                }
+            }
+        }
+        let mut saw_lid_seeded_phi = false;
+        for blk in &entry.blocks {
+            let lbl = blk.label.as_ref().and_then(|l| l.result_id).unwrap();
+            let blk_preds = preds.get(&lbl);
+            for inst in &blk.instructions {
+                if inst.class.opcode == Op::Phi {
+                    for pair in inst.operands.chunks_exact(2) {
+                        let (Operand::IdRef(val), Operand::IdRef(pred_lbl)) = (&pair[0], &pair[1])
+                        else {
+                            panic!("malformed OpPhi operands");
+                        };
+                        assert!(
+                            blk_preds.is_some_and(|p| p.contains(pred_lbl)),
+                            "OpPhi in block {lbl} references non-predecessor {pred_lbl}"
+                        );
+                        if lid_loads.get(val) == Some(pred_lbl) {
+                            saw_lid_seeded_phi = true;
+                        }
+                    }
+                }
+            }
+        }
+        assert!(
+            saw_lid_seeded_phi,
+            "array-first emulated Mesh payload loop must keep an OpPhi seeded by LocalInvocationIndex from its real preheader"
+        );
+    }
+
+    #[test]
+    fn emulated_object_and_mesh_binding_674_collision_and_payloadless_dynamic_sampler() {
+        let obj_payload_sampler = r#"
+%struct.Payload = type { [16 x i32] }
