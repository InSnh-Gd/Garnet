+fn make_emulated_grid_params_ssbo(ctx: &mut Ctx) -> Result<Word, String> {
+    check_emulated_binding_free(ctx, crate::reflect::MESH_EMULATED_GRID_PARAMS_BINDING)?;
+    let uint_ty = ctx.ty_uint();
+    let struct_ty = ctx.module.fresh_id();
+    ctx.new_globals.push(type_inst(
+        Op::TypeStruct,
+        struct_ty,
+        vec![
+            Operand::IdRef(uint_ty),
+            Operand::IdRef(uint_ty),
+            Operand::IdRef(uint_ty),
+            Operand::IdRef(uint_ty),
+        ],
+    ));
+    decorate_with(&mut ctx.module, struct_ty, Decoration::Block);
+    for m in 0u32..4 {
+        ctx.module.annotations.push(Instruction::new(
+            Op::MemberDecorate,
+            None,
+            None,
+            vec![
+                Operand::IdRef(struct_ty),
+                Operand::LiteralBit32(m),
+                Operand::Decoration(Decoration::Offset),
+                Operand::LiteralBit32(m * 4),
+            ],
+        ));
+    }
+    let ptr_ty = ctx.ty_ptr(StorageClass::StorageBuffer, struct_ty);
+    let var = ctx.module.fresh_id();
+    ctx.new_globals.push(Instruction::new(
+        Op::Variable,
+        Some(ptr_ty),
+        Some(var),
+        vec![Operand::StorageClass(StorageClass::StorageBuffer)],
+    ));
+    super::decorate_binding(
+        &mut ctx.module,
+        var,
+        ctx.descriptor_layout.set,
+        crate::reflect::MESH_EMULATED_GRID_PARAMS_BINDING,
+    );
+    decorate_with(&mut ctx.module, var, Decoration::NonWritable);
+    ctx.interface_buffer_var(var);
+    ctx.bound_buffer_vars.insert(var);
+    Ok(var)
+}
+
+fn make_emulated_u32_ssbo(ctx: &mut Ctx, binding: u32, non_writable: bool) -> Result<Word, String> {
+    check_emulated_binding_free(ctx, binding)?;
+    let uint_ty = ctx.ty_uint();
+    let rt_arr = ctx.module.fresh_id();
+    ctx.new_globals.push(type_inst(
+        Op::TypeRuntimeArray,
+        rt_arr,
+        vec![Operand::IdRef(uint_ty)],
+    ));
+    ctx.module.annotations.push(Instruction::new(
+        Op::Decorate,
+        None,
+        None,
+        vec![
+            Operand::IdRef(rt_arr),
+            Operand::Decoration(Decoration::ArrayStride),
+            Operand::LiteralBit32(4),
+        ],
+    ));
+    let struct_ty = ctx.module.fresh_id();
+    ctx.new_globals
+        .push(type_inst(Op::TypeStruct, struct_ty, vec![Operand::IdRef(rt_arr)]));
+    decorate_with(&mut ctx.module, struct_ty, Decoration::Block);
+    ctx.module.annotations.push(Instruction::new(
+        Op::MemberDecorate,
+        None,
+        None,
+        vec![
+            Operand::IdRef(struct_ty),
+            Operand::LiteralBit32(0),
+            Operand::Decoration(Decoration::Offset),
+            Operand::LiteralBit32(0),
+        ],
+    ));
+    let ptr_ty = ctx.ty_ptr(StorageClass::StorageBuffer, struct_ty);
+    let var = ctx.module.fresh_id();
+    ctx.new_globals.push(Instruction::new(
+        Op::Variable,
+        Some(ptr_ty),
+        Some(var),
+        vec![Operand::StorageClass(StorageClass::StorageBuffer)],
+    ));
+    super::decorate_binding(
+        &mut ctx.module,
+        var,
+        ctx.descriptor_layout.set,
+        binding,
+    );
+    if non_writable {
+        decorate_with(&mut ctx.module, var, Decoration::NonWritable);
+    }
+    ctx.interface_buffer_var(var);
+    ctx.bound_buffer_vars.insert(var);
+    Ok(var)
+}
