+fn finalize_emulated_mesh_stage(ctx: &mut Ctx, entry_idx: usize) -> Result<(), String> {
+    let Some(wg_payload_var) = ctx.task_payload_var else {
+        // Mesh-only stage without payload: keep 100% pure hardware MeshEXT with no 673..675 bindings.
+        return Ok(());
+    };
+    let payload_pointee = find_variable_pointee_type(ctx, wg_payload_var)
+        .ok_or_else(|| "emulated mesh payload variable has no pointee type".to_string())?;
+    let uint_ty = ctx.ty_uint();
+    let sint_ty = ctx.ty_sint();
+    let grid_params_var = make_emulated_grid_params_ssbo(ctx)?;
+    let payload_ssbo_var = make_emulated_u32_ssbo(
+        ctx,
+        crate::reflect::MESH_EMULATED_PAYLOAD_BINDING,
+        true,
+    )?;
+    let draw_id_var = ensure_input_builtin_var(ctx, BuiltIn::DrawIndex, sint_ty);
+    let lid_var = ensure_input_builtin_var(ctx, BuiltIn::LocalInvocationIndex, uint_ty);
+    let (defs, _) = collect_defs_and_value_types(ctx, entry_idx);
+    let local_total = ctx.kernel_local_size[0]
+        .saturating_mul(ctx.kernel_local_size[1])
+        .saturating_mul(ctx.kernel_local_size[2])
+        .max(1);
+
+    let Some(orig_label) = ctx.module.functions[entry_idx]
+        .blocks
+        .first()
+        .and_then(|b| b.label.as_ref())
+        .and_then(|l| l.result_id)
+    else {
+        return Ok(());
+    };
+    let old_insts = ctx.module.functions[entry_idx].blocks[0].instructions.clone();
+    // Split right after leading OpVariables + zero_initialize_workgroup_memory's stores & barrier.
+    let wg_vars: HashSet<Word> = ctx
+        .module
+        .types_global_values
+        .iter()
+        .chain(ctx.new_globals.iter())
+        .filter(|i| {
+            i.class.opcode == Op::Variable
+                && i.operands.first() == Some(&Operand::StorageClass(StorageClass::Workgroup))
+        })
+        .filter_map(|i| i.result_id)
+        .collect();
+    let first_non_var = old_insts
+        .iter()
+        .position(|i| i.class.opcode != Op::Variable)
+        .unwrap_or(old_insts.len());
+    let mut split_at = first_non_var;
+    {
+        let mut cursor = first_non_var;
+        while cursor < old_insts.len()
+            && old_insts[cursor].class.opcode == Op::Store
+            && matches!(
+                old_insts[cursor].operands.first(),
+                Some(Operand::IdRef(dst)) if wg_vars.contains(dst)
+            )
+        {
+            cursor += 1;
+        }
+        if cursor > first_non_var
+            && cursor < old_insts.len()
+            && old_insts[cursor].class.opcode == Op::ControlBarrier
+        {
+            split_at = cursor + 1;
+        }
+    }
+
+    let prefix = old_insts[..split_at].to_vec();
+    let suffix = old_insts[split_at..].to_vec();
+    let c0 = ctx.const_uint(0);
+    let c2 = ctx.const_uint(2);
+
+    let mut cfg = CfgBuilder::new(orig_label, prefix);
+    let draw_id_s = ctx.module.fresh_id();
+    cfg.push(Instruction::new(
+        Op::Load,
+        Some(sint_ty),
+        Some(draw_id_s),
+        vec![Operand::IdRef(draw_id_var)],
+    ));
+    let draw_id = ctx.module.fresh_id();
+    cfg.push(Instruction::new(
+        Op::Bitcast,
+        Some(uint_ty),
+        Some(draw_id),
+        vec![Operand::IdRef(draw_id_s)],
+    ));
+    let stride_bytes = grid_params_load_field(ctx, &mut cfg, grid_params_var, 3);
+    let stride_words = ctx.module.fresh_id();
+    cfg.push(Instruction::new(
+        Op::ShiftRightLogical,
+        Some(uint_ty),
+        Some(stride_words),
+        vec![Operand::IdRef(stride_bytes), Operand::IdRef(c2)],
+    ));
+    let base_word = ctx.module.fresh_id();
+    cfg.push(Instruction::new(
+        Op::IMul,
+        Some(uint_ty),
+        Some(base_word),
+        vec![Operand::IdRef(draw_id), Operand::IdRef(stride_words)],
+    ));
+    let lid = ctx.module.fresh_id();
+    cfg.push(Instruction::new(
+        Op::Load,
+        Some(uint_ty),
+        Some(lid),
+        vec![Operand::IdRef(lid_var)],
+    ));
+    let mut indices = Vec::new();
+    emit_payload_copy_at(
+        ctx,
+        &defs,
+        &mut cfg,
+        PayloadCopyDir::SsboToWorkgroup,
+        wg_payload_var,
+        &mut indices,
+        payload_pointee,
+        c0,
+        Some(0),
+        payload_ssbo_var,
+        base_word,
+        lid,
+        local_total,
+        false,
+    )?;
+    emit_workgroup_barrier(ctx, &mut cfg.cur_insts);
+    let tail_label = cfg.cur_label;
+    cfg.cur_insts.extend(suffix);
+    let new_blocks = cfg.finish();
+    let new_block_count = new_blocks.len();
+
+    ctx.module.functions[entry_idx]
+        .blocks
+        .splice(0..=0, new_blocks);
+    // Remap any OpPhi predecessor in original successor blocks referencing block 0's original
+    // label to the split tail label (never rewrite OpPhis inside the newly spliced prologue blocks!).
+    if tail_label != orig_label {
+        for blk in &mut ctx.module.functions[entry_idx].blocks[new_block_count..] {
+            for inst in &mut blk.instructions {
+                if inst.class.opcode == Op::Phi {
+                    for pair in inst.operands.chunks_exact_mut(2) {
+                        if pair[1] == Operand::IdRef(orig_label) {
+                            pair[1] = Operand::IdRef(tail_label);
+                        }
+                    }
+                }
+            }
+        }
+    }
+    Ok(())
+}
