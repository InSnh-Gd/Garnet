+    let toks = split_top_level_whitespace(s.trim());
+    if toks.len() < 2 {
+        return Err(format!(
+            "linked indirect-call argument has no typed value: {s}"
+        ));
+    }
+    for i in (1..toks.len()).rev() {
+        let candidate = toks[..i].join(" ");
+        if parse_type(&candidate).is_ok() {
+            return Ok(candidate);
+        }
+    }
+    Err(format!("linked indirect-call argument has no type: {s}"))
