+fn wg_access_ptr(
+    ctx: &mut Ctx,
+    cfg: &mut CfgBuilder,
+    wg_var: Word,
+    indices: &[Word],
+    leaf_ty: Word,
+) -> Word {
+    if indices.is_empty() {
+        return wg_var;
+    }
+    let ptr_ty = ctx.ty_ptr(StorageClass::Workgroup, leaf_ty);
+    let ptr = ctx.module.fresh_id();
+    let mut ops = Vec::with_capacity(indices.len() + 1);
+    ops.push(Operand::IdRef(wg_var));
+    for &idx in indices {
+        ops.push(Operand::IdRef(idx));
+    }
+    cfg.push(Instruction::new(
+        Op::AccessChain,
+        Some(ptr_ty),
+        Some(ptr),
+        ops,
+    ));
+    ptr
+}
