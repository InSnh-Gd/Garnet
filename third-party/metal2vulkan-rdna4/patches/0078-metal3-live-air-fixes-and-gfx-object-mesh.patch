+fn check_emulated_binding_free(ctx: &Ctx, binding: u32) -> Result<(), String> {
+    let target_set = ctx.descriptor_layout.set;
+    let mut sets = HashMap::new();
+    let mut bindings = HashMap::new();
+    for ann in &ctx.module.annotations {
+        if ann.class.opcode != Op::Decorate {
+            continue;
+        }
+        match ann.operands.as_slice() {
+            [Operand::IdRef(id), Operand::Decoration(Decoration::DescriptorSet), Operand::LiteralBit32(s)] =>
+            {
+                sets.insert(*id, *s);
+            }
+            [Operand::IdRef(id), Operand::Decoration(Decoration::Binding), Operand::LiteralBit32(b)] =>
+            {
+                bindings.insert(*id, *b);
+            }
+            _ => {}
+        }
+    }
+    let live_vars: HashSet<Word> = ctx
+        .module
+        .types_global_values
+        .iter()
+        .chain(ctx.new_globals.iter())
+        .filter(|i| i.class.opcode == Op::Variable)
+        .filter_map(|i| i.result_id)
+        .collect();
+    if live_vars
+        .into_iter()
+        .any(|id| sets.get(&id) == Some(&target_set) && bindings.get(&id) == Some(&binding))
+    {
+        return Err(format!(
+            "emulated Object/Mesh reserved binding (set {target_set}, binding {binding}) collides with an existing stage resource binding"
+        ));
+    }
+    Ok(())
+}
