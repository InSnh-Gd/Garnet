+struct CfgBuilder {
+    blocks: Vec<Block>,
+    cur_label: Word,
+    cur_insts: Vec<Instruction>,
+}
+
+impl CfgBuilder {
+    fn new(start_label: Word, initial_insts: Vec<Instruction>) -> Self {
+        Self {
+            blocks: Vec::new(),
+            cur_label: start_label,
+            cur_insts: initial_insts,
+        }
+    }
+
+    fn push(&mut self, inst: Instruction) {
+        self.cur_insts.push(inst);
+    }
+
+    fn terminate_and_start(&mut self, term: Instruction, next_label: Word) {
+        self.cur_insts.push(term);
+        let insts = std::mem::take(&mut self.cur_insts);
+        let label = self.cur_label;
+        self.blocks.push(Block {
+            label: Some(Instruction::new(Op::Label, None, Some(label), vec![])),
+            instructions: insts,
+        });
+        self.cur_label = next_label;
+    }
+
+    fn finish(mut self) -> Vec<Block> {
+        let insts = std::mem::take(&mut self.cur_insts);
+        self.blocks.push(Block {
+            label: Some(Instruction::new(
+                Op::Label,
+                None,
+                Some(self.cur_label),
+                vec![],
+            )),
+            instructions: insts,
+        });
+        self.blocks
+    }
+}
