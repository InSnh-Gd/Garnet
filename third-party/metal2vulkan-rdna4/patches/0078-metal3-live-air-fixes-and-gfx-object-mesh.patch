+fn ensure_input_builtin_var(ctx: &mut Ctx, builtin: BuiltIn, ty: Word) -> Word {
+    let want_ptr = ctx.ty_ptr(StorageClass::Input, ty);
+    let existing = ctx.module.annotations.iter().find_map(|ann| {
+        if ann.class.opcode == Op::Decorate
+            && ann.operands.get(1) == Some(&Operand::Decoration(Decoration::BuiltIn))
+            && ann.operands.get(2) == Some(&Operand::BuiltIn(builtin))
+        {
+            if let Some(&Operand::IdRef(id)) = ann.operands.first() {
+                let matches_var = ctx
+                    .module
+                    .types_global_values
+                    .iter()
+                    .chain(ctx.new_globals.iter())
+                    .any(|g| {
+                        g.result_id == Some(id)
+                            && g.class.opcode == Op::Variable
+                            && g.result_type == Some(want_ptr)
+                            && g.operands.first() == Some(&Operand::StorageClass(StorageClass::Input))
+                    });
+                if matches_var {
+                    return Some(id);
+                }
+            }
+        }
+        None
+    });
+    if let Some(var) = existing {
+        return var;
+    }
+    let var = ctx.module.fresh_id();
+    ctx.new_globals.push(Instruction::new(
+        Op::Variable,
+        Some(want_ptr),
+        Some(var),
+        vec![Operand::StorageClass(StorageClass::Input)],
+    ));
+    decorate_builtin(&mut ctx.module, var, builtin);
+    ctx.interface.push(var);
+    var
+}
