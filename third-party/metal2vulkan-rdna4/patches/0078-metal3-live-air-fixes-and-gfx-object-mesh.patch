+fn ssbo_u32_load(ctx: &mut Ctx, cfg: &mut CfgBuilder, ssbo_var: Word, word_idx: Word) -> Word {
+    let uint_ty = ctx.ty_uint();
+    let sb_u32_ptr = ctx.ty_ptr(StorageClass::StorageBuffer, uint_ty);
+    let c0 = ctx.const_uint(0);
+    let ptr = ctx.module.fresh_id();
+    cfg.push(Instruction::new(
+        Op::AccessChain,
+        Some(sb_u32_ptr),
+        Some(ptr),
+        vec![
+            Operand::IdRef(ssbo_var),
+            Operand::IdRef(c0),
+            Operand::IdRef(word_idx),
+        ],
+    ));
+    let val = ctx.module.fresh_id();
+    cfg.push(Instruction::new(
+        Op::Load,
+        Some(uint_ty),
+        Some(val),
+        vec![Operand::IdRef(ptr)],
+    ));
+    val
+}
