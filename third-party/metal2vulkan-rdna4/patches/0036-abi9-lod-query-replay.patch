+use super::*;
+
+// Typed and raw views of the same declared buffer share its source readonly provenance.
+pub(super) fn readonly_aliases(module: &Module, addresses: &[Word]) -> Vec<Word> {
+    let mut sets = HashMap::new();
+    let mut bindings = HashMap::new();
+    for instruction in &module.annotations {
+        match instruction.operands.as_slice() {
+            [Operand::IdRef(id), Operand::Decoration(Decoration::DescriptorSet), Operand::LiteralBit32(set)] =>
+            {
+                sets.insert(*id, *set);
+            }
+            [Operand::IdRef(id), Operand::Decoration(Decoration::Binding), Operand::LiteralBit32(binding)] =>
+            {
+                bindings.insert(*id, *binding);
+            }
+            _ => {}
+        }
+    }
+    let coordinates = addresses
+        .iter()
+        .filter_map(|id| Some((*sets.get(id)?, *bindings.get(id)?)))
+        .collect::<HashSet<_>>();
+    let mut aliases = addresses.to_vec();
+    aliases.extend(module.types_global_values.iter().filter_map(|instruction| {
+        if instruction.class.opcode != Op::Variable
+            || !matches!(
+                instruction.operands.first(),
+                Some(Operand::StorageClass(
+                    StorageClass::StorageBuffer | StorageClass::Uniform
+                ))
+            )
+        {
+            return None;
+        }
+        let id = instruction.result_id?;
+        coordinates
+            .contains(&(*sets.get(&id)?, *bindings.get(&id)?))
+            .then_some(id)
+    }));
+    aliases.sort_unstable();
+    aliases.dedup();
+    aliases
+}
