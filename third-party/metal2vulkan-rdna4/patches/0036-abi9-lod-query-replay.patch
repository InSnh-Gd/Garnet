+//! Quad-safe replay for the existing fragment `calculate_*_lod_texture_2d` extension.
+//!
+//! `OpImageQueryLod` has implicit derivatives. When the image or sampler descriptor is selected by
+//! a divergent value inside a quad, Vulkan has no defined per-lane descriptor tuple to query. The
+//! quad path broadcasts only the descriptor *indices* (never opaque handles), reloads a uniform
+//! tuple for each quad source lane, and selects a result by comparing the lane's original tuple
+//! with those broadcast tuples. It therefore does not depend on how Vulkan maps a quad to subgroup
+//! lanes. The enumeration path performs the same query for every bounded tuple in uniform control
+//! flow.
+
+use super::fragment_control::{analyze, analyze_entry, ControlStatus, FragmentControl};
+use super::gpu_arguments::{load_word, raw_buffer, ARGUMENT_RESOURCE_TABLE_BINDING};
+use super::*;
+
+use spirv::{Capability, Decoration, Dim, LoopControl, Op, Scope, StorageClass};
+use std::collections::{HashMap, HashSet};
+
+const QUERY_TABLE_BINDING: u32 = 673;
+const QUAD_LANES: usize = 4;
+
+#[derive(Clone, Copy)]
+struct DescriptorOperand {
+    original: Word,
+    token_index: Word,
+    pointer_type: Word,
+    array: Word,
+    element_type: Word,
+}
+
+struct QueryRewrite {
+    image: Option<DescriptorOperand>,
+    sampler: Option<DescriptorOperand>,
+    shape: SampledDescriptorShape,
+}
+
+#[derive(Clone, Copy)]
+struct SafeImageIndex {
+    index: Word,
+    valid: Word,
+}
+
+pub(in crate::passes) fn lower_argument_lod_queries(
+    ctx: &mut Ctx,
+    entry_idx: usize,
+) -> Result<(), String> {
+    // Entry points are synthesized after these lowering passes, so the selected stage in `Ctx` is
+    // authoritative here rather than the not-yet-emitted `OpEntryPoint` list.
+    if ctx.stage != Stage::Fragment {
+        return Ok(());
+    }
+
+    let table = resource_variable(&ctx.module, 0, ARGUMENT_RESOURCE_TABLE_BINDING);
+    let mut query_table = resource_variable(&ctx.module, 0, QUERY_TABLE_BINDING);
+    let mut capabilities = HashSet::new();
+    let mut sites = ctx
+        .module
+        .functions
+        .iter()
+        .enumerate()
+        .flat_map(|(function, definition)| {
+            definition
+                .blocks
+                .iter()
+                .enumerate()
+                .flat_map(move |(block, definition)| {
+                    definition
+                        .instructions
+                        .iter()
+                        .enumerate()
+                        .filter(|(_, instruction)| instruction.class.opcode == Op::ImageQueryLod)
+                        .map(move |(instruction, _)| (function, block, instruction))
+                })
+        })
+        .collect::<Vec<_>>();
+    if sites.is_empty() {
+        return Ok(());
+    }
+    // AIR lowering creates constants and immutable token-table roots needed by the shared proof.
+    ctx.module.types_global_values.append(&mut ctx.new_globals);
+    super::fragment_control::record_readonly_aliases(ctx);
+    let control = analyze_fragment_control(ctx, entry_idx)?;
+    // Enumeration and quad replay insert instructions before the query. Rewriting from the end
+    // keeps every as-yet-unprocessed site at the index reported by the original analysis.
+    sites.sort_unstable_by(|left, right| right.cmp(left));
+    for (function_index, block_index, query_index) in sites {
+        let function_id = ctx.module.functions[function_index]
+            .def
+            .as_ref()
+            .and_then(|definition| definition.result_id)
+            .ok_or_else(|| format!("fragment function #{function_index} has no result id"))?;
+        if ctx.module.functions[function_index].blocks[block_index].instructions[query_index]
+            .class
+            .opcode
+            != Op::ImageQueryLod
+        {
+            return Err("fragment LOD query moved during another query rewrite".into());
+        }
+        let status = control.status(function_index, block_index);
+        if status == ControlStatus::NotReachable {
+            continue;
+        }
+        if status != ControlStatus::Uniform {
+            return Err(format!(
+                "fragment LOD query in function %{function_id} block #{block_index} is not in \
+                 derivative-uniform control flow ({status:?})"
+            ));
+        }
+        let rewrite = query_rewrite(ctx, function_index, block_index, query_index)?;
+        if rewrite.image.is_none() && rewrite.sampler.is_none() {
+            normalize_uniform_query(ctx, function_index, block_index, query_index, &rewrite)?;
+            continue;
+        }
+        let uniformly_selected = [rewrite.image, rewrite.sampler]
+            .into_iter()
+            .flatten()
+            .all(|operand| control.value_is_uniform(function_index, operand.token_index));
+        if uniformly_selected {
+            normalize_uniform_query(ctx, function_index, block_index, query_index, &rewrite)?;
+            continue;
+        }
+        let replay = QueryRewrite {
+            image: rewrite
+                .image
+                .filter(|operand| !control.value_is_uniform(function_index, operand.token_index)),
+            sampler: rewrite
+                .sampler
+                .filter(|operand| !control.value_is_uniform(function_index, operand.token_index)),
+            shape: rewrite.shape,
+        };
+        if ctx.argument_table_version < 8 {
+            return Err("indirect fragment LOD replay requires ABI 8 typed shape rows".into());
+        }
+        let table = table.ok_or_else(|| {
+            "indirect fragment LOD query has no GPU argument resource table".to_string()
+        })?;
+        if query_table.is_none() {
+            let synthesized = raw_buffer(ctx, QUERY_TABLE_BINDING);
+            ctx.interface_buffer_var(synthesized);
+            query_table = Some(synthesized);
+        }
+        let query_table = query_table.expect("query table synthesized above");
+
+        match ctx.query_lod_replay {
+            QueryLodReplay::UniformOnly => {
+                return Err(
+                    "fragment LOD query selects its descriptor from nonuniform GPU argument \
+                     data; choose a quad-broadcast or enumeration backend"
+                        .into(),
+                );
+            }
+            QueryLodReplay::QuadBroadcast => {
+                rewrite_quad_query(
+                    ctx,
+                    function_index,
+                    block_index,
+                    query_index,
+                    &replay,
+                    table,
+                    query_table,
+                )?;
+                capabilities.insert(Capability::GroupNonUniform);
+                capabilities.insert(Capability::GroupNonUniformQuad);
+            }
+            QueryLodReplay::DescriptorEnumeration => {
+                rewrite_query_as_enumeration(
+                    ctx,
+                    function_index,
+                    block_index,
+                    query_index,
+                    &replay,
+                    table,
+                    query_table,
+                )?;
+            }
+        }
+    }
+    for capability in capabilities {
+        ctx.add_capability(capability);
+    }
+    Ok(())
+}
+
