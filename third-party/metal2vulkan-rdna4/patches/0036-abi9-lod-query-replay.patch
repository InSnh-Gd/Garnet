+    let image_count = bounded_count(ctx, &mut prefix, uint, image_count, maximum_images);
+    let sampler_count = load_count(ctx, &mut prefix, table, word_pointer, uint, zero, 5);
+    let sampler_count = bounded_count(ctx, &mut prefix, uint, sampler_count, maximum_samplers);
+    let base = dimension_base(
