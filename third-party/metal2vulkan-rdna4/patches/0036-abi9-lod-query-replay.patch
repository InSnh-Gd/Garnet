+pub(super) fn pixel_coordinate_to_normalized_2d(
+    ctx: &mut Ctx,
+    body: &mut Vec<Instruction>,
+    image: Word,
+    coord: Word,
+    lod: Word,
+) -> Result<Word, String> {
+    let defs = definitions(ctx);
+    let coord_type = type_from_value_or_alias(coord, &defs)
+        .ok_or("fragment LOD query coordinate has no type")?;
+    let float_type = ctx.ty_float();
+    let vector_float_type = ctx.ty_vecf(2);
+    if coord_type != vector_float_type {
+        return Err("fragment LOD query pixel coordinate is not a two-component float".into());
+    }
+    let size_type = ctx.ty_vec_uint(2);
+    let size = crate::passes::resources::gpu_arguments::value(
+        ctx,
+        body,
+        Op::ImageQuerySizeLod,
+        size_type,
+        vec![Operand::IdRef(image), Operand::IdRef(lod)],
+    );
+    let uint = ctx.ty_uint();
+    let mut components = Vec::with_capacity(2);
+    for component in 0..2 {
+        let extent = crate::passes::resources::gpu_arguments::value(
+            ctx,
+            body,
+            Op::CompositeExtract,
+            uint,
+            vec![Operand::IdRef(size), Operand::LiteralBit32(component)],
+        );
+        let extent_float = crate::passes::resources::gpu_arguments::value(
+            ctx,
+            body,
+            Op::ConvertUToF,
+            float_type,
+            vec![Operand::IdRef(extent)],
+        );
+        let coordinate = crate::passes::resources::gpu_arguments::value(
+            ctx,
+            body,
+            Op::CompositeExtract,
+            float_type,
+            vec![Operand::IdRef(coord), Operand::LiteralBit32(component)],
+        );
+        let normalized = crate::passes::resources::gpu_arguments::value(
+            ctx,
+            body,
+            Op::FDiv,
+            float_type,
+            vec![Operand::IdRef(coordinate), Operand::IdRef(extent_float)],
+        );
+        components.push(Operand::IdRef(normalized));
+    }
+    Ok(crate::passes::resources::gpu_arguments::value(
+        ctx,
+        body,
+        Op::CompositeConstruct,
+        vector_float_type,
+        components,
+    ))
+}
