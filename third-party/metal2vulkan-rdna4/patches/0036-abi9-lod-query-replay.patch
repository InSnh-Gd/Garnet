+pub(super) fn rewrite_query_as_enumeration(
+    ctx: &mut Ctx,
+    function_index: usize,
+    block_index: usize,
+    query_index: usize,
+    rewrite: &QueryRewrite,
+    table: Word,
+    query_table: Word,
+) -> Result<(), String> {
+    let block = ctx.module.functions[function_index].blocks[block_index].clone();
+    if block
+        .instructions
+        .iter()
+        .any(|instruction| instruction.class.opcode == Op::LoopMerge)
+    {
+        return Err("descriptor enumeration cannot split a structured loop-header block".into());
+    }
+    let original = block.instructions[query_index].clone();
+    let Some(Operand::IdRef(sampled)) = original.operands.first() else {
+        return Err("fragment LOD query has no sampled image".into());
+    };
+    let Some(Operand::IdRef(coord)) = original.operands.get(1) else {
+        return Err("fragment LOD query has no coordinate".into());
+    };
+    let defs = definitions(ctx);
+    let sampled_type = defs
+        .get(sampled)
+        .and_then(|definition| definition.result_type)
+        .ok_or("fragment LOD query sampled image has no type")?;
+    let sampled_definition = defs
+        .get(sampled)
+        .ok_or("fragment LOD query sampled image is undefined")?;
+    let [Operand::IdRef(original_image), Operand::IdRef(original_sampler)] =
+        sampled_definition.operands.as_slice()
+    else {
+        return Err("fragment LOD query sampled image has invalid operands".into());
+    };
+    let result_type = original
+        .result_type
+        .ok_or("fragment LOD query has no result type")?;
+    let result_id = original
+        .result_id
+        .ok_or("fragment LOD query has no result id")?;
+    let uint = ctx.ty_uint();
+    let bool_type = ctx.ty_bool();
+    let word_pointer = ctx.ty_ptr(StorageClass::StorageBuffer, uint);
+    let zero = ctx.const_uint(0);
+    let one = ctx.const_uint(1);
+    let original_label = block
+        .label
+        .as_ref()
+        .and_then(|label| label.result_id)
+        .ok_or("fragment LOD query block has no label")?;
+    let mut prefix = block.instructions[..query_index].to_vec();
+    let tail = block.instructions[query_index + 1..].to_vec();
+    let table_words = crate::passes::resources::gpu_arguments::value(
+        ctx,
+        &mut prefix,
+        Op::ArrayLength,
+        uint,
