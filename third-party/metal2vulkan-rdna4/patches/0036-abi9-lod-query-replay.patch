+        return Err("fragment LOD query sampled image has invalid operands".into());
+    };
+    let result_type = original
+        .result_type
+        .ok_or("fragment LOD query has no result type")?;
+    let result_id = original
+        .result_id
+        .ok_or("fragment LOD query has no result id")?;
+    let uint = ctx.ty_uint();
+    let bool_type = ctx.ty_bool();
+    let word_pointer = ctx.ty_ptr(StorageClass::StorageBuffer, uint);
+    let zero = ctx.const_uint(0);
+    let mut prefix = Vec::new();
+    let table_words = crate::passes::resources::gpu_arguments::value(
