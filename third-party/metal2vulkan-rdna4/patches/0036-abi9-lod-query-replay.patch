+    let sampled_definition = defs
+        .get(sampled)
+        .ok_or("fragment LOD query sampled image is undefined")?;
+    let [Operand::IdRef(original_image), Operand::IdRef(original_sampler)] =
+        sampled_definition.operands.as_slice()
