+pub(super) fn safe_image_index(
+    ctx: &mut Ctx,
+    body: &mut Vec<Instruction>,
+    query_table: Word,
+    pointer: Word,
+    uint: Word,
+    bool_type: Word,
+    zero: Word,
+    base: Word,
+    image_count: Word,
+    image_index: Word,
+    shape: SampledDescriptorShape,
+) -> Result<SafeImageIndex, String> {
+    let clamped = clamp_index(ctx, body, uint, bool_type, image_index, image_count, zero);
+    let eight = ctx.const_uint(8);
+    let row = crate::passes::resources::gpu_arguments::value(
+        ctx,
+        body,
+        Op::IMul,
+        uint,
+        vec![Operand::IdRef(clamped), Operand::IdRef(eight)],
+    );
+    let row = crate::passes::resources::gpu_arguments::value(
+        ctx,
+        body,
+        Op::IAdd,
+        uint,
+        vec![Operand::IdRef(base), Operand::IdRef(row)],
+    );
+    let six = ctx.const_uint(6);
+    let seven = ctx.const_uint(7);
+    let shape_at = crate::passes::resources::gpu_arguments::value(
+        ctx,
+        body,
+        Op::IAdd,
+        uint,
+        vec![Operand::IdRef(row), Operand::IdRef(six)],
+    );
+    let flags_at = crate::passes::resources::gpu_arguments::value(
+        ctx,
+        body,
+        Op::IAdd,
+        uint,
+        vec![Operand::IdRef(row), Operand::IdRef(seven)],
+    );
+    let stored_shape = load_word(ctx, body, query_table, pointer, uint, zero, shape_at);
+    let stored_flags = load_word(ctx, body, query_table, pointer, uint, zero, flags_at);
+    let tag = ctx.const_uint(shape_tag(shape)?);
+    let shape_ok = crate::passes::resources::gpu_arguments::value(
+        ctx,
+        body,
+        Op::IEqual,
+        bool_type,
+        vec![Operand::IdRef(stored_shape), Operand::IdRef(tag)],
+    );
+    let expected_ms = ctx.const_uint(u32::from(shape.multisampled));
+    let ms_ok = crate::passes::resources::gpu_arguments::value(
+        ctx,
+        body,
+        Op::IEqual,
+        bool_type,
+        vec![Operand::IdRef(stored_flags), Operand::IdRef(expected_ms)],
+    );
+    let valid = crate::passes::resources::gpu_arguments::value(
+        ctx,
+        body,
+        Op::LogicalAnd,
+        bool_type,
+        vec![Operand::IdRef(shape_ok), Operand::IdRef(ms_ok)],
+    );
+    let nonzero = crate::passes::resources::gpu_arguments::value(
+        ctx,
+        body,
+        Op::INotEqual,
+        bool_type,
+        vec![Operand::IdRef(clamped), Operand::IdRef(zero)],
+    );
+    let valid = crate::passes::resources::gpu_arguments::value(
+        ctx,
+        body,
+        Op::LogicalAnd,
+        bool_type,
+        vec![Operand::IdRef(valid), Operand::IdRef(nonzero)],
+    );
+    let dummy = if ctx.argument_table_version == 9 {
+        ctx.null_descriptor_index(
+            ImageShape {
+                dim: shape.dim,
+                arrayed: shape.arrayed,
+                depth: shape.depth,
+                comp: shape.comp,
+                multisampled: shape.multisampled,
+                access: ImageAccess::Sampled,
+            },
+            Some(
+                resource_variable(&ctx.module, 0, ARGUMENT_RESOURCE_TABLE_BINDING)
+                    .ok_or("query replay lost the token table")?,
+            ),
+            body,
+        )?
+    } else {
+        crate::passes::resources::gpu_arguments::value(
+            ctx,
+            body,
+            Op::IAdd,
+            uint,
+            vec![Operand::IdRef(image_count), Operand::IdRef(tag)],
+        )
+    };
+    let index = crate::passes::resources::gpu_arguments::value(
+        ctx,
+        body,
+        Op::Select,
+        uint,
+        vec![
+            Operand::IdRef(valid),
+            Operand::IdRef(clamped),
+            Operand::IdRef(dummy),
+        ],
+    );
+    Ok(SafeImageIndex { index, valid })
+}
