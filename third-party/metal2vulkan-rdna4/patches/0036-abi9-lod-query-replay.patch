+    repoint_phi_predecessor(
+        &mut ctx.module.functions[function_index],
+        original_label,
+        outer_merge,
+    );
+    ctx.module.functions[function_index]
+        .blocks
+        .splice(block_index + 1..block_index + 1, inserted);
+    Ok(())
+}
+
+pub(super) fn repoint_phi_predecessor(function: &mut Function, old: Word, new: Word) {
+    for block in &mut function.blocks {
+        for instruction in &mut block.instructions {
+            if instruction.class.opcode != Op::Phi {
+                continue;
+            }
+            for pair in instruction.operands.chunks_exact_mut(2) {
+                if pair.get(1) == Some(&Operand::IdRef(old)) {
+                    pair[1] = Operand::IdRef(new);
+                }
+            }
+        }
+    }
+}
