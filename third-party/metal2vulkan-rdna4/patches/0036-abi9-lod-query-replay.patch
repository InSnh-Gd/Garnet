+pub(super) fn normalize_uniform_query(
+    ctx: &mut Ctx,
+    function_index: usize,
+    block_index: usize,
+    query_index: usize,
+    rewrite: &QueryRewrite,
+) -> Result<(), String> {
+    if !ctx.normalized_sampler_coordinates {
+        return Ok(());
+    }
+    let original =
+        ctx.module.functions[function_index].blocks[block_index].instructions[query_index].clone();
+    let Some(Operand::IdRef(sampled)) = original.operands.first() else {
+        return Err("fragment LOD query has no sampled image".into());
+    };
+    let Some(Operand::IdRef(coord)) = original.operands.get(1) else {
+        return Err("fragment LOD query has no coordinate".into());
+    };
+    let defs = definitions(ctx);
+    let sampled_definition = defs
+        .get(sampled)
+        .filter(|instruction| instruction.class.opcode == Op::SampledImage)
+        .ok_or("fragment LOD query operand is not an OpSampledImage")?;
+    let [Operand::IdRef(image), Operand::IdRef(sampler)] = sampled_definition.operands.as_slice()
+    else {
+        return Err("fragment LOD query sampled image has invalid operands".into());
+    };
+    let mut prefix = Vec::new();
+    let zero = ctx.const_uint(0);
+    let normalized = crate::passes::air_calls::normalize_sampler_coordinate(
+        ctx,
+        *sampler,
+        *image,
+        rewrite.shape.dim,
+        rewrite.shape.arrayed,
+        *coord,
+        zero,
+        &mut prefix,
+    )?;
+    if normalized == *coord {
+        return Ok(());
+    }
+    let mut replacement = original;
+    replacement.operands[1] = Operand::IdRef(normalized);
+    prefix.push(replacement);
+    let instructions = &mut ctx.module.functions[function_index].blocks[block_index].instructions;
+    instructions.splice(query_index..=query_index, prefix);
