+use super::*;
+
+pub(super) fn result_is_uniform(
+    call: &Instruction,
+    caller_uniform: &HashSet<Word>,
+    caller_pointers: &HashSet<Word>,
+    module: &Module,
+    callees: &[Word],
+) -> bool {
+    let Some(Operand::IdRef(callee)) = call.operands.first() else {
+        return false;
+    };
+    if callees.contains(callee) {
+        return false;
+    }
+    let Some(function) = module.functions.iter().find(|function| {
+        function
+            .def
+            .as_ref()
+            .and_then(|definition| definition.result_id)
+            == Some(*callee)
+    }) else {
+        return false;
+    };
+    let arguments = &call.operands[1..];
+    if function.blocks.is_empty() || arguments.len() != function.parameters.len() {
+        return false;
+    }
+    let mut parameters = Vec::new();
+    let mut pointers = Vec::new();
+    for (parameter, argument) in function.parameters.iter().zip(arguments) {
+        let (Some(parameter), Operand::IdRef(argument)) = (parameter.result_id, argument) else {
+            return false;
+        };
+        if !caller_uniform.contains(argument) {
+            return false;
+        }
+        parameters.push(parameter);
+        if caller_pointers.contains(argument) {
+            pointers.push(parameter);
+        }
+    }
+    // A result proof may not hide side effects or invocation-dependent control in a helper.
+    if function
+        .blocks
+        .iter()
+        .flat_map(|block| &block.instructions)
+        .any(|instruction| {
+            !is_uniform_preserving_operation(instruction.class.opcode)
+                && !matches!(
+                    instruction.class.opcode,
+                    Op::Load
+                        | Op::CopyObject
+                        | Op::AccessChain
+                        | Op::InBoundsAccessChain
+                        | Op::PtrAccessChain
+                        | Op::Phi
+                        | Op::FunctionCall
+                        | Op::Branch
+                        | Op::BranchConditional
+                        | Op::Switch
+                        | Op::SelectionMerge
+                        | Op::LoopMerge
+                        | Op::ReturnValue
+                        | Op::Return
+                )
+        })
+    {
+        return false;
+    }
+    let labels = function
+        .blocks
+        .iter()
+        .filter_map(|block| block.label.as_ref()?.result_id)
+        .collect();
+    let mut next_callees = callees.to_vec();
+    next_callees.push(*callee);
+    let uniform = uniform_values(
+        function,
+        &parameters,
+        &pointers,
+        module,
+        &labels,
+        &next_callees,
+    );
+    let mut returned = false;
+    for instruction in function.blocks.iter().flat_map(|block| &block.instructions) {
+        let condition = match instruction.class.opcode {
+            Op::BranchConditional | Op::Switch => instruction.operands.first(),
+            Op::ReturnValue => {
+                returned = true;
+                instruction.operands.first()
+            }
+            _ => None,
+        };
+        if let Some(operand) = condition {
+            if !matches!(operand, Operand::IdRef(id) if uniform.contains(id)) {
+                return false;
+            }
+        }
+    }
+    returned
+}
