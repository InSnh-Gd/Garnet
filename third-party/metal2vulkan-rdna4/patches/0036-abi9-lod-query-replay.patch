+use super::*;
+
+pub(super) fn analyze_fragment_control(
+    ctx: &Ctx,
+    entry_idx: usize,
+) -> Result<FragmentControl, String> {
+    if ctx.module.entry_points.iter().any(|entry| {
+        entry.operands.first() == Some(&Operand::ExecutionModel(spirv::ExecutionModel::Fragment))
+    }) {
+        analyze(ctx)
+    } else {
+        analyze_entry(ctx, entry_idx)
+    }
+}
+
+pub(super) fn resource_variable(module: &Module, set: u32, binding: u32) -> Option<Word> {
+    let mut sets = HashMap::new();
+    let mut bindings = HashMap::new();
+    for annotation in &module.annotations {
+        match annotation.operands.as_slice() {
+            [Operand::IdRef(id), Operand::Decoration(Decoration::DescriptorSet), Operand::LiteralBit32(value)] =>
+            {
+                sets.insert(*id, *value);
+            }
+            [Operand::IdRef(id), Operand::Decoration(Decoration::Binding), Operand::LiteralBit32(value)] =>
+            {
+                bindings.insert(*id, *value);
+            }
+            _ => {}
+        }
+    }
+    bindings
+        .into_iter()
+        .find_map(|(id, value)| (value == binding && sets.get(&id) == Some(&set)).then_some(id))
+}
+
+pub(super) fn query_rewrite(
+    ctx: &Ctx,
+    function_index: usize,
+    block_index: usize,
+    query_index: usize,
+) -> Result<QueryRewrite, String> {
+    let instruction =
+        &ctx.module.functions[function_index].blocks[block_index].instructions[query_index];
+    let Some(Operand::IdRef(sampled)) = instruction.operands.first() else {
+        return Err("fragment LOD query has no sampled image".into());
+    };
+    let defs = definitions(ctx);
+    let sampled_definition = defs
+        .get(sampled)
+        .filter(|definition| definition.class.opcode == Op::SampledImage)
+        .ok_or("fragment LOD query operand is not an OpSampledImage")?;
+    let [Operand::IdRef(image), Operand::IdRef(sampler)] = sampled_definition.operands.as_slice()
+    else {
+        return Err("fragment LOD query sampled image has invalid operands".into());
+    };
+    let image_access = descriptor_operand(ctx, *image, 0, true, &defs)?;
+    let sampler_access = descriptor_operand(ctx, *sampler, 2, false, &defs)?;
+    // Selected direct handles can retain a temporary pointer type until opaque cleanup.
+    let derived_shape = sampled_image_shape(ctx, *sampled, &defs)?;
+    let shape = if let Some(access) = image_access {
+        let access = ctx
+            .sampled_descriptor_accesses
+            .get(&access.original)
+            .ok_or("GPU argument LOD image has no descriptor access fact")?;
+        match access.shape {
+            Some(mapped) if mapped != derived_shape => {
+                return Err(
+                    "GPU argument LOD image shape fact disagrees with the loaded image type".into(),
+                )
+            }
+            Some(mapped) => mapped,
+            None => derived_shape,
+        }
+    } else {
+        derived_shape
+    };
+    if shape.dim != Dim::Dim2D || shape.arrayed {
+        return Err("fragment LOD query requires a non-array 2D image".into());
+    }
+    if shape.storage {
+        return Err("fragment LOD query image is a storage image".into());
+    }
+    if shape.multisampled {
+        return Err("fragment LOD query does not support a multisampled image".into());
+    }
+    Ok(QueryRewrite {
+        image: image_access,
+        sampler: sampler_access,
+        shape,
+    })
+}
+
+pub(super) fn descriptor_operand(
+    ctx: &Ctx,
+    value: Word,
+    category: u32,
+    image: bool,
+    defs: &HashMap<Word, Instruction>,
+) -> Result<Option<DescriptorOperand>, String> {
+    let access = descriptor_access(ctx, value, &mut HashSet::new());
+    let Some((loaded, access)) = access else {
+        return Ok(None);
+    };
+    if access.category != category {
+        return Err(format!(
+            "GPU argument LOD descriptor category {} does not match expected {category}",
+            access.category
+        ));
+    }
+    let load = defs
+        .get(&loaded)
+        .filter(|instruction| instruction.class.opcode == Op::Load)
+        .ok_or("GPU argument LOD descriptor access does not name a load")?;
+    let Some(Operand::IdRef(pointer)) = load.operands.first() else {
+        return Err("GPU argument LOD descriptor load has no pointer".into());
+    };
+    let element_type = load
+        .result_type
+        .ok_or("GPU argument LOD descriptor load has no element type")?;
+    let pointer_definition = defs
+        .get(pointer)
+        .filter(|instruction| {
+            matches!(
+                instruction.class.opcode,
+                Op::AccessChain | Op::InBoundsAccessChain
+            )
+        })
+        .ok_or("GPU argument LOD descriptor load is not from an access chain")?;
+    let pointer_type = pointer_definition
+        .result_type
+        .ok_or("GPU argument LOD descriptor access chain has no pointer type")?;
+    let Some(Operand::IdRef(array)) = pointer_definition.operands.first() else {
+        return Err("GPU argument LOD descriptor access chain has no array".into());
+    };
+    if image {
+        let shape = image_shape_from_type(ctx, element_type, defs)?;
+        if let Some(mapped) = access.shape {
+            if mapped != shape {
+                return Err(
+                    "GPU argument LOD image shape fact disagrees with the descriptor array type"
+                        .into(),
+                );
+            }
+        }
+    } else if !defs
+        .get(&element_type)
+        .is_some_and(|instruction| instruction.class.opcode == Op::TypeSampler)
+    {
+        return Err("GPU argument LOD sampler does not load an OpTypeSampler".into());
+    }
+    Ok(Some(DescriptorOperand {
+        original: loaded,
+        token_index: access.physical_index,
+        pointer_type,
+        array: *array,
+        element_type,
+    }))
+}
+
+pub(super) fn descriptor_access(
+    ctx: &Ctx,
+    value: Word,
+    seen: &mut HashSet<Word>,
+) -> Option<(Word, SampledDescriptorAccess)> {
+    if !seen.insert(value) {
+        return None;
+    }
+    if let Some(access) = ctx.sampled_descriptor_accesses.get(&value).copied() {
+        return Some((value, access));
+    }
+    let defs = definitions(ctx);
+    let definition = defs.get(&value)?;
+    if !matches!(definition.class.opcode, Op::CopyObject | Op::Bitcast) {
+        return None;
+    }
+    let Operand::IdRef(source) = definition.operands.first()? else {
+        return None;
+    };
+    descriptor_access(ctx, *source, seen)
+}
+
+pub(super) fn definitions(ctx: &Ctx) -> HashMap<Word, Instruction> {
+    ctx.module
+        .all_inst_iter()
+        .chain(ctx.new_globals.iter())
+        .filter_map(|instruction| Some((instruction.result_id?, instruction.clone())))
+        .collect()
+}
+
+pub(super) fn sampled_image_shape(
+    ctx: &Ctx,
+    image: Word,
+    defs: &HashMap<Word, Instruction>,
+) -> Result<SampledDescriptorShape, String> {
+    let image_type = type_from_value_or_alias(image, defs)
+        .ok_or("fragment LOD query image has no SPIR-V type")?;
+    image_shape_from_type(ctx, image_type, defs)
+}
+
+pub(super) fn image_shape_from_type(
+    _ctx: &Ctx,
+    ty: Word,
+    defs: &HashMap<Word, Instruction>,
+) -> Result<SampledDescriptorShape, String> {
+    let definition = defs
+        .get(&ty)
+        .ok_or("fragment LOD query image type is undefined")?;
+    match definition.class.opcode {
+        Op::TypePointer => {
+            let Some(Operand::IdRef(pointee)) = definition.operands.get(1) else {
+                return Err("fragment LOD query image pointer has no pointee".into());
+            };
+            image_shape_from_type(_ctx, *pointee, defs)
+        }
+        Op::TypeSampledImage => {
+            let Some(Operand::IdRef(image)) = definition.operands.first() else {
+                return Err("fragment LOD query sampled-image type has no image type".into());
+            };
+            image_shape_from_type(_ctx, *image, defs)
+        }
+        Op::TypeImage => {
+            let dim = match definition.operands.get(1) {
+                Some(Operand::Dim(dim)) => *dim,
+                _ => return Err("fragment LOD query image type has no dimension".into()),
+            };
+            let depth = match definition.operands.get(2) {
+                Some(Operand::LiteralBit32(0)) => false,
+                Some(Operand::LiteralBit32(1)) => true,
+                Some(Operand::LiteralBit32(2)) => {
+                    return Err(
+                        "fragment LOD query image has unknown depth semantics in its SPIR-V type"
+                            .into(),
+                    )
+                }
+                _ => return Err("fragment LOD query image type has invalid depth semantics".into()),
+            };
+            let arrayed = match definition.operands.get(3) {
+                Some(Operand::LiteralBit32(0)) => false,
+                Some(Operand::LiteralBit32(1)) => true,
+                _ => return Err("fragment LOD query image type has invalid arrayed state".into()),
+            };
+            let multisampled = match definition.operands.get(4) {
+                Some(Operand::LiteralBit32(0)) => false,
+                Some(Operand::LiteralBit32(1)) => true,
+                _ => {
+                    return Err(
+                        "fragment LOD query image type has invalid multisampled state".into(),
+                    )
+                }
+            };
+            let sampled = match definition.operands.get(5) {
+                Some(Operand::LiteralBit32(0)) => 0,
+                Some(Operand::LiteralBit32(1)) => 1,
+                Some(Operand::LiteralBit32(2)) => 2,
+                _ => return Err("fragment LOD query image type has invalid sampled state".into()),
+            };
+            let Some(Operand::IdRef(component_type)) = definition.operands.first() else {
+                return Err("fragment LOD query image type has no component type".into());
+            };
+            let component = defs
+                .get(component_type)
+                .ok_or("fragment LOD query image component type is undefined")?;
+            let comp = match component.class.opcode {
+                Op::TypeFloat => ImageComp::Float,
+                Op::TypeInt if component.operands.get(1) == Some(&Operand::LiteralBit32(0)) => {
+                    ImageComp::Uint
+                }
+                Op::TypeInt if component.operands.get(1) == Some(&Operand::LiteralBit32(1)) => {
+                    ImageComp::Sint
+                }
+                _ => return Err("fragment LOD query image component is not float/uint/sint".into()),
+            };
+            Ok(SampledDescriptorShape {
+                dim,
+                arrayed,
+                depth,
+                comp,
+                storage: sampled == 2,
+                multisampled,
+            })
+        }
+        _ => Err("fragment LOD query image value does not have an image type".into()),
+    }
+}
+
+pub(super) fn type_from_value_or_alias(
+    value: Word,
+    defs: &HashMap<Word, Instruction>,
+) -> Option<Word> {
+    let definition = defs.get(&value)?;
+    if let Some(ty) = definition.result_type {
+        return Some(ty);
+    }
+    if matches!(definition.class.opcode, Op::CopyObject | Op::Bitcast) {
+        if let Some(Operand::IdRef(source)) = definition.operands.first() {
+            return type_from_value_or_alias(*source, defs);
+        }
+    }
+    None
+}
+
+pub(super) fn shape_tag(shape: SampledDescriptorShape) -> Result<u32, String> {
+    let dim = match shape.dim {
+        Dim::Dim1D => 0,
+        Dim::Dim2D => 1,
+        Dim::Dim3D => 2,
+        Dim::DimCube => 3,
+        other => {
+            return Err(format!(
+                "fragment LOD query image dimension {other:?} has no ABI 8 shape tag"
+            ))
+        }
+    };
+    let component = match shape.comp {
+        ImageComp::Float => 0,
+        ImageComp::Uint => 1,
+        ImageComp::Sint => 2,
+    };
+    Ok(dim * 2 + u32::from(shape.arrayed) + 8 * u32::from(shape.depth) + 16 * component)
+}
