+                 \x20 %ic_t = extractelement <4 x float> %ic_res, i64 1\n\
+                 \x20 %ic_u = extractelement <4 x float> %ic_res, i64 2\n\
+                 \x20 %ic_s = extractelement <4 x float> %ic_res, i64 3\n\
