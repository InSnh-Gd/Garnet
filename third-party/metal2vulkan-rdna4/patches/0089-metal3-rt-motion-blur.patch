+    cff: &str,
+    cp: &str,
+    cg: &str,
+    cu: &str,
+    ci: &str,
+    cui: &str,
+    cro: &str,
+    crd: &str,
+    br_target: &str,
+) -> String {
+    let mut s = format!(
+        "{blk_label}:\n\
+         \x20 %{pfx}_0 = insertvalue {rty} poison, i1 {more}, 0\n\
+         \x20 %{pfx}_1 = insertvalue {rty} %{pfx}_0, i32 {in_act}, 1\n\
+         \x20 %{pfx}_2 = insertvalue {rty} %{pfx}_1, i32 {in_cw}, 2\n\
+         \x20 %{pfx}_3 = insertvalue {rty} %{pfx}_2, i32 {in_cull}, 3\n\
+         \x20 %{pfx}_4 = insertvalue {rty} %{pfx}_3, i64 {in_cslot}, 4\n\
+         \x20 %{pfx}_5 = insertvalue {rty} %{pfx}_4, i32 {ck}, 5\n\
+         \x20 %{pfx}_6 = insertvalue {rty} %{pfx}_5, float {ct}, 6\n\
+         \x20 %{pfx}_7 = insertvalue {rty} %{pfx}_6, <2 x float> {cb}, 7\n\
+         \x20 %{pfx}_8 = insertvalue {rty} %{pfx}_7, i32 {cff}, 8\n\
+         \x20 %{pfx}_9 = insertvalue {rty} %{pfx}_8, i32 {cp}, 9\n\
+         \x20 %{pfx}_10 = insertvalue {rty} %{pfx}_9, i32 {cg}, 10\n\
+         \x20 %{pfx}_11 = insertvalue {rty} %{pfx}_10, float {cu}, 11\n\
+         \x20 %{pfx}_12 = insertvalue {rty} %{pfx}_11, i32 {ci}, 12\n\
+         \x20 %{pfx}_13 = insertvalue {rty} %{pfx}_12, i32 {cui}, 13\n\
+         \x20 %{pfx}_14 = insertvalue {rty} %{pfx}_13, <3 x float> {cro}, 14\n\
+         \x20 %{pfx}_15 = insertvalue {rty} %{pfx}_14, <3 x float> {crd}, 15\n"
+    );
+    let mut last_idx = 15;
+    if has_world {
+        for c in 0..4 {
+            let cur = 16 + c;
+            s.push_str(&format!(
+                "  %{pfx}_{cur} = insertvalue {rty} %{pfx}_{last_idx}, <3 x float> zeroinitializer, {cur}\n"
+            ));
+            last_idx = cur;
+        }
+        for c in 0..4 {
+            let cur = 20 + c;
+            s.push_str(&format!(
+                "  %{pfx}_{cur} = insertvalue {rty} %{pfx}_{last_idx}, <3 x float> zeroinitializer, {cur}\n"
+            ));
+            last_idx = cur;
+        }
+    }
+    s.push_str(&format!(
+        "  %{pfx}_fin = insertvalue {rty} %{pfx}_{last_idx}, i1 {more}, 0\n\
+         \x20 br label %{br_target}\n\n"
+    ));
+    s
+}
