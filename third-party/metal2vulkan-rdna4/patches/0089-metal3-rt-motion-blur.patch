+//! Motion blur LLVM IR runtime helpers and proceed/trace builders for `SPV_KHR_ray_query`.
+//!
+//! Lowering for Metal 3 `primitive_motion` and `instance_motion` queries (`GARNETX_CAP_RT_MOTION_BLUR`):
+//! - Time evaluation & border mode (`Clamp` / `Vanish`) matching `garnet_rt_motion.h`
+//! - `TLAS_MOTION` (`RDNA4RT_PRIM_KIND_TLAS_MOTION == 2`) keyframe interpolation (4x3 matrix lerp
+//!   and 64B `MTLComponentTransform` SRT + quaternion slerp) + exact 3x3 inversion
+//! - Motion triangle keyframe lerp + Möller-Trumbore + Metal winding/culling
+//! - Motion AABB keyframe lerp + slab test
+//! - Structured dual-slot (`outer` + `inner`) traversal for `instance_motion` TLAS proxies
+
+/// Emit scalar BDA motion-blur helper functions into `out` (deduplicated once per module).
+/// All computed BDA integers use `%__m2v.rq.prim_data.*` names and `motion_*` function names are
+/// allowlisted as `trusted_ro_bda` in `core_inst.rs` / `ir/mod.rs`.
+pub(super) fn append_motion_rt_support(out: &mut String, need_inst_motion: bool) {
+    super::ray_query_air::append_blas_slot_lookup_support_pub(out);
+    let decls: &[&str] = if need_inst_motion {
+        &[
+            "declare float @air.sqrt.f32(float)",
+            "declare float @llvm.fabs.f32(float)",
+            "declare float @air.fast_acos.f32(float)",
+            "declare float @air.fast_sin.f32(float)",
+            "declare float @air.fast_cos.f32(float)",
+        ]
+    } else {
+        &[
+            "declare float @air.sqrt.f32(float)",
+            "declare float @llvm.fabs.f32(float)",
+        ]
+    };
+    for decl in decls {
+        let prefix = decl.split('(').next().unwrap_or(decl);
+        if !out.contains(&format!("{prefix}(")) {
+            out.push_str(decl);
+            out.push('\n');
+        }
+    }
+
+    if !out.contains("define internal <4 x float> @__m2v.rq.query.motion_eval_time(") {
+        out.push_str(
+            "\ndefine internal <4 x float> @__m2v.rq.query.motion_eval_time(float %t, float %t0, float %t1, i32 %sb, i32 %eb, i32 %nkf) {\n\
+             entry:\n\
+             \x20 %nkf_ok = icmp ugt i32 %nkf, 0\n\
+             \x20 %rng_ok = fcmp ole float %t0, %t1\n\
+             \x20 %lt_start = fcmp olt float %t, %t0\n\
+             \x20 %gt_end = fcmp ogt float %t, %t1\n\
+             \x20 %sb_van = icmp eq i32 %sb, 1\n\
+             \x20 %eb_van = icmp eq i32 %eb, 1\n\
+             \x20 %van0 = and i1 %lt_start, %sb_van\n\
+             \x20 %van1 = and i1 %gt_end, %eb_van\n\
+             \x20 %van = or i1 %van0, %van1\n\
+             \x20 %not_van = xor i1 %van, true\n\
+             \x20 %ok0 = and i1 %nkf_ok, %rng_ok\n\
+             \x20 %active = and i1 %ok0, %not_van\n\
+             \x20 %c0 = select i1 %lt_start, float %t0, float %t\n\
+             \x20 %clamped = select i1 %gt_end, float %t1, float %c0\n\
+             \x20 %multi = icmp ugt i32 %nkf, 1\n\
+             \x20 %span = fsub float %t1, %t0\n\
+             \x20 %span_pos = fcmp ogt float %span, 0.000000e+00\n\
+             \x20 %has_interp = and i1 %multi, %span_pos\n\
+             \x20 %safe_span = select i1 %span_pos, float %span, float 1.000000e+00\n\
+             \x20 %num = fsub float %clamped, %t0\n\
+             \x20 %u_raw = fdiv float %num, %safe_span\n\
+             \x20 %u_lo = fcmp olt float %u_raw, 0.000000e+00\n\
+             \x20 %u0 = select i1 %u_lo, float 0.000000e+00, float %u_raw\n\
+             \x20 %u_hi = fcmp ogt float %u0, 1.000000e+00\n\
+             \x20 %u = select i1 %u_hi, float 1.000000e+00, float %u0\n\
+             \x20 %last = sub i32 %nkf, 1\n\
+             \x20 %last_f = uitofp i32 %last to float\n\
+             \x20 %scaled = fmul float %u, %last_f\n\
+             \x20 %at_end = fcmp oge float %scaled, %last_f\n\
+             \x20 %k_floor = fptoui float %scaled to i32\n\
+             \x20 %k0_i = select i1 %at_end, i32 %last, i32 %k_floor\n\
+             \x20 %k0_p1 = add i32 %k0_i, 1\n\
+             \x20 %k1_i = select i1 %at_end, i32 %last, i32 %k0_p1\n\
+             \x20 %k0_f = uitofp i32 %k0_i to float\n\
+             \x20 %al_diff = fsub float %scaled, %k0_f\n\
+             \x20 %al_i = select i1 %at_end, float 0.000000e+00, float %al_diff\n\
+             \x20 %k0_use = select i1 %has_interp, i32 %k0_i, i32 0\n\
+             \x20 %k1_use = select i1 %has_interp, i32 %k1_i, i32 0\n\
+             \x20 %al_use = select i1 %has_interp, float %al_i, float 0.000000e+00\n\
+             \x20 %act_f = select i1 %active, float 1.000000e+00, float 0.000000e+00\n\
+             \x20 %k0_bits = bitcast i32 %k0_use to float\n\
+             \x20 %k1_bits = bitcast i32 %k1_use to float\n\
+             \x20 %v0 = insertelement <4 x float> poison, float %act_f, i64 0\n\
+             \x20 %v1 = insertelement <4 x float> %v0, float %k0_bits, i64 1\n\
+             \x20 %v2 = insertelement <4 x float> %v1, float %k1_bits, i64 2\n\
+             \x20 %v3 = insertelement <4 x float> %v2, float %al_use, i64 3\n\
+             \x20 ret <4 x float> %v3\n\
+             }\n",
+        );
+    }
+
+    if !out.contains("define internal i64 @__m2v.rq.query.motion_find_slot(") {
+        out.push_str(
+            "\ndefine internal i64 @__m2v.rq.query.motion_find_slot(i64 %bda) {\n\
+             entry:\n\
+             \x20 %tbl_bda = call i64 @__m2v.rq.prim_table_bda()\n\
+             \x20 %mask = call i32 @__m2v.rq.prim_table_mask()\n\
+             \x20 %bda_ok = icmp ugt i64 %bda, 1\n\
+             \x20 %tbl_ok = icmp ne i64 %tbl_bda, 0\n\
+             \x20 %both = and i1 %bda_ok, %tbl_ok\n\
+             \x20 br i1 %both, label %probe, label %exit\n\
+             probe:\n\
+             \x20 %s = call i64 @__m2v.rq.query.probe_prim_slot(i64 %tbl_bda, i32 %mask, i64 %bda)\n\
+             \x20 br label %exit\n\
+             exit:\n\
+             \x20 %res = phi i64 [ %s, %probe ], [ 0, %entry ]\n\
+             \x20 ret i64 %res\n\
+             }\n",
+        );
+    }
+
+    if !out.contains("define internal i64 @__m2v.rq.query.motion_check_blas_hdr(") {
+        out.push_str(
+            "\ndefine internal i64 @__m2v.rq.query.motion_check_blas_hdr(i64 %blas_slot, i32 %geom_id) {\n\
+             entry:\n\
+             \x20 %slot_ok = icmp ne i64 %blas_slot, 0\n\
+             \x20 br i1 %slot_ok, label %read_slot, label %exit\n\
+             \n\
+             read_slot:\n\
+             \x20 %__m2v.rq.prim_data.m_p8 = add i64 %blas_slot, 8\n\
+             \x20 %pay_p = inttoptr i64 %__m2v.rq.prim_data.m_p8 to ptr addrspace(1)\n\
+             \x20 %pay = load i64, ptr addrspace(1) %pay_p, align 8\n\
+             \x20 %__m2v.rq.prim_data.m_p16 = add i64 %blas_slot, 16\n\
+             \x20 %cnt_p = inttoptr i64 %__m2v.rq.prim_data.m_p16 to ptr addrspace(1)\n\
+             \x20 %cnt = load i32, ptr addrspace(1) %cnt_p, align 4\n\
+             \x20 %__m2v.rq.prim_data.m_p24 = add i64 %blas_slot, 24\n\
+             \x20 %ref_p = inttoptr i64 %__m2v.rq.prim_data.m_p24 to ptr addrspace(1)\n\
+             \x20 %aux_off = load i32, ptr addrspace(1) %ref_p, align 4\n\
+             \x20 %__m2v.rq.prim_data.m_p28 = add i64 %blas_slot, 28\n\
+             \x20 %knd_p = inttoptr i64 %__m2v.rq.prim_data.m_p28 to ptr addrspace(1)\n\
+             \x20 %knd = load i32, ptr addrspace(1) %knd_p, align 4\n\
+             \x20 %is_blas = icmp eq i32 %knd, 0\n\
+             \x20 %pay_ok = icmp ne i64 %pay, 0\n\
+             \x20 %aux_ok = icmp ne i32 %aux_off, 0\n\
+             \x20 %g_ok = icmp ult i32 %geom_id, %cnt\n\
+             \x20 %o0 = and i1 %is_blas, %pay_ok\n\
+             \x20 %o1 = and i1 %aux_ok, %g_ok\n\
+             \x20 %hdr_in = and i1 %o0, %o1\n\
+             \x20 br i1 %hdr_in, label %read_hdr, label %slot_done\n\
+             \n\
+             read_hdr:\n\
+             \x20 %aux64 = zext i32 %aux_off to i64\n\
+             \x20 %g64 = zext i32 %geom_id to i64\n\
+             \x20 %goff = mul i64 %g64, 48\n\
+             \x20 %base = add i64 %pay, %aux64\n\
+             \x20 %__m2v.rq.prim_data.mhdr = add i64 %base, %goff\n\
+             \x20 %mag_p = inttoptr i64 %__m2v.rq.prim_data.mhdr to ptr addrspace(1)\n\
+             \x20 %mag = load i32, ptr addrspace(1) %mag_p, align 4\n\
+             \x20 %__m2v.rq.prim_data.mh_kf = add i64 %__m2v.rq.prim_data.mhdr, 8\n\
+             \x20 %kf_p = inttoptr i64 %__m2v.rq.prim_data.mh_kf to ptr addrspace(1)\n\
+             \x20 %nkf = load i32, ptr addrspace(1) %kf_p, align 4\n\
+             \x20 %__m2v.rq.prim_data.mh_pc = add i64 %__m2v.rq.prim_data.mhdr, 12\n\
+             \x20 %pc_p = inttoptr i64 %__m2v.rq.prim_data.mh_pc to ptr addrspace(1)\n\
+             \x20 %pc = load i32, ptr addrspace(1) %pc_p, align 4\n\
+             \x20 %__m2v.rq.prim_data.mh_do = add i64 %__m2v.rq.prim_data.mhdr, 32\n\
+             \x20 %do_p = inttoptr i64 %__m2v.rq.prim_data.mh_do to ptr addrspace(1)\n\
+             \x20 %doff = load i64, ptr addrspace(1) %do_p, align 8\n\
+             \x20 %mag_ok = icmp eq i32 %mag, 1381256519\n\
+             \x20 %kf_ok = icmp uge i32 %nkf, 2\n\
+             \x20 %pc_ok = icmp ne i32 %pc, 0\n\
+             \x20 %do_ok = icmp ne i64 %doff, 0\n\
+             \x20 %k0 = and i1 %mag_ok, %kf_ok\n\
+             \x20 %k1 = and i1 %pc_ok, %do_ok\n\
+             \x20 %all_ok = and i1 %k0, %k1\n\
+             \x20 %hdr_res = select i1 %all_ok, i64 %__m2v.rq.prim_data.mhdr, i64 0\n\
+             \x20 br label %slot_done\n\
+             \n\
+             slot_done:\n\
+             \x20 %s_res = phi i64 [ %hdr_res, %read_hdr ], [ 0, %read_slot ]\n\
+             \x20 br label %exit\n\
+             \n\
+             exit:\n\
+             \x20 %res = phi i64 [ %s_res, %slot_done ], [ 0, %entry ]\n\
+             \x20 ret i64 %res\n\
+             }\n",
+        );
+    }
+
+    append_motion_tri_helper(out);
+    append_motion_aabb_helper(out);
+    if need_inst_motion {
+        append_motion_tlas_helpers(out);
+    }
+}
+
+fn append_motion_tri_helper(out: &mut String) {
+    if out.contains("define internal <4 x float> @__m2v.rq.query.motion_tri_intersect(") {
+        return;
+    }
+    let mut s = String::from(
+        "\ndefine internal <4 x float> @__m2v.rq.query.motion_tri_intersect(i64 %blas_slot, i64 %mhdr, i32 %prim_id, float %time, <3 x float> %ro, <3 x float> %rd, float %tmin, float %tmax, i1 %cw, i32 %cull_mode) {\n\
+         entry:\n\
+         \x20 %b_ok = icmp ne i64 %blas_slot, 0\n\
+         \x20 %h_ok = icmp ne i64 %mhdr, 0\n\
+         \x20 %t_ok = fcmp oge float %tmax, %tmin\n\
+         \x20 %e0 = and i1 %b_ok, %h_ok\n\
+         \x20 %e_ok = and i1 %e0, %t_ok\n\
+         \x20 br i1 %e_ok, label %read_hdr, label %exit\n\
+         \n\
+         read_hdr:\n\
+         \x20 %__m2v.rq.prim_data.mt_p8 = add i64 %blas_slot, 8\n\
+         \x20 %pay_p = inttoptr i64 %__m2v.rq.prim_data.mt_p8 to ptr addrspace(1)\n\
+         \x20 %pay = load i64, ptr addrspace(1) %pay_p, align 8\n\
+         \x20 %__m2v.rq.prim_data.mt_kf = add i64 %mhdr, 8\n\
+         \x20 %nkf_p = inttoptr i64 %__m2v.rq.prim_data.mt_kf to ptr addrspace(1)\n\
+         \x20 %nkf = load i32, ptr addrspace(1) %nkf_p, align 4\n\
+         \x20 %__m2v.rq.prim_data.mt_pc = add i64 %mhdr, 12\n\
+         \x20 %pc_p = inttoptr i64 %__m2v.rq.prim_data.mt_pc to ptr addrspace(1)\n\
+         \x20 %pc = load i32, ptr addrspace(1) %pc_p, align 4\n\
+         \x20 %__m2v.rq.prim_data.mt_sb = add i64 %mhdr, 16\n\
+         \x20 %sb_p = inttoptr i64 %__m2v.rq.prim_data.mt_sb to ptr addrspace(1)\n\
+         \x20 %sb = load i32, ptr addrspace(1) %sb_p, align 4\n\
+         \x20 %__m2v.rq.prim_data.mt_eb = add i64 %mhdr, 20\n\
+         \x20 %eb_p = inttoptr i64 %__m2v.rq.prim_data.mt_eb to ptr addrspace(1)\n\
+         \x20 %eb = load i32, ptr addrspace(1) %eb_p, align 4\n\
+         \x20 %__m2v.rq.prim_data.mt_t0 = add i64 %mhdr, 24\n\
+         \x20 %t0_p = inttoptr i64 %__m2v.rq.prim_data.mt_t0 to ptr addrspace(1)\n\
+         \x20 %t0 = load float, ptr addrspace(1) %t0_p, align 4\n\
+         \x20 %__m2v.rq.prim_data.mt_t1 = add i64 %mhdr, 28\n\
+         \x20 %t1_p = inttoptr i64 %__m2v.rq.prim_data.mt_t1 to ptr addrspace(1)\n\
+         \x20 %t1 = load float, ptr addrspace(1) %t1_p, align 4\n\
+         \x20 %__m2v.rq.prim_data.mt_do = add i64 %mhdr, 32\n\
+         \x20 %do_p = inttoptr i64 %__m2v.rq.prim_data.mt_do to ptr addrspace(1)\n\
+         \x20 %doff = load i64, ptr addrspace(1) %do_p, align 8\n\
+         \x20 %__m2v.rq.prim_data.mt_ps = add i64 %mhdr, 40\n\
+         \x20 %ps_p = inttoptr i64 %__m2v.rq.prim_data.mt_ps to ptr addrspace(1)\n\
+         \x20 %pstr = load i32, ptr addrspace(1) %ps_p, align 4\n\
+         \x20 %in_b = icmp ult i32 %prim_id, %pc\n\
+         \x20 %pay_ok = icmp ne i64 %pay, 0\n\
+         \x20 %do_ok = icmp ne i64 %doff, 0\n\
+         \x20 %m0 = and i1 %in_b, %pay_ok\n\
+         \x20 %m1 = and i1 %m0, %do_ok\n\
+         \x20 %te = call <4 x float> @__m2v.rq.query.motion_eval_time(float %time, float %t0, float %t1, i32 %sb, i32 %eb, i32 %nkf)\n\
+         \x20 %act_f = extractelement <4 x float> %te, i64 0\n\
+         \x20 %act = fcmp ogt float %act_f, 5.000000e-01\n\
+         \x20 %k0_f = extractelement <4 x float> %te, i64 1\n\
+         \x20 %k1_f = extractelement <4 x float> %te, i64 2\n\
+         \x20 %alpha = extractelement <4 x float> %te, i64 3\n\
+         \x20 %k0 = bitcast float %k0_f to i32\n\
+         \x20 %k1 = bitcast float %k1_f to i32\n\
+         \x20 %go = and i1 %m1, %act\n\
+         \x20 br i1 %go, label %test_tri, label %hdr_done\n\
+         \n\
+         test_tri:\n\
+         \x20 %p64 = zext i32 %prim_id to i64\n\
+         \x20 %nkf64 = zext i32 %nkf to i64\n\
+         \x20 %base_idx = mul i64 %p64, %nkf64\n\
+         \x20 %k0_64 = zext i32 %k0 to i64\n\
+         \x20 %k1_64 = zext i32 %k1 to i64\n\
+         \x20 %i0 = add i64 %base_idx, %k0_64\n\
+         \x20 %i1 = add i64 %base_idx, %k1_64\n\
+         \x20 %ps64 = zext i32 %pstr to i64\n\
+         \x20 %off0 = mul i64 %i0, %ps64\n\
+         \x20 %off1 = mul i64 %i1, %ps64\n\
+         \x20 %data_base = add i64 %pay, %doff\n\
+         \x20 %__m2v.rq.prim_data.tri0 = add i64 %data_base, %off0\n\
+         \x20 %__m2v.rq.prim_data.tri1 = add i64 %data_base, %off1\n",
+    );
+    // Load and interpolate all 9 floats of v0, v1, v2 (0..32 bytes).
+    for i in 0..9u32 {
+        let b = i * 4;
+        s.push_str(&format!(
+            "  %__m2v.rq.prim_data.t0_{i} = add i64 %__m2v.rq.prim_data.tri0, {b}\n\
+             \x20 %__m2v.rq.prim_data.t1_{i} = add i64 %__m2v.rq.prim_data.tri1, {b}\n\
+             \x20 %p0_{i} = inttoptr i64 %__m2v.rq.prim_data.t0_{i} to ptr addrspace(1)\n\
+             \x20 %p1_{i} = inttoptr i64 %__m2v.rq.prim_data.t1_{i} to ptr addrspace(1)\n\
+             \x20 %a_{i} = load float, ptr addrspace(1) %p0_{i}, align 4\n\
+             \x20 %b_{i} = load float, ptr addrspace(1) %p1_{i}, align 4\n\
+             \x20 %d_{i} = fsub float %b_{i}, %a_{i}\n\
+             \x20 %m_{i} = fmul float %d_{i}, %alpha\n\
+             \x20 %v_{i} = fadd float %a_{i}, %m_{i}\n"
+        ));
