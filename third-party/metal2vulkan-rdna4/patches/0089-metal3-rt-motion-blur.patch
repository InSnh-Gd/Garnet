+             \x20 %c_1_3 = fadd float %c_1_3p, %cv_14\n\
+             \x20 %c_2_3p0 = fmul float %r20, %cv_6\n\
+             \x20 %c_2_3p1 = fmul float %r21, %cv_7\n\
+             \x20 %c_2_3p2 = fmul float %r22, %cv_8\n\
+             \x20 %c_2_301 = fadd float %c_2_3p0, %c_2_3p1\n\
+             \x20 %c_2_3p = fadd float %c_2_301, %c_2_3p2\n\
+             \x20 %c_2_3 = fadd float %c_2_3p, %cv_15\n\
+             \x20 br label %xf_merge\n\
+             \n\
+             xf_merge:\n",
+        );
+        for rw in 0..3u32 {
+            for cl in 0..4u32 {
+                s.push_str(&format!(
+                    "  %w_{rw}_{cl} = phi float [ %m_{rw}_{cl}, %xf_mat ], [ %c_{rw}_{cl}, %xf_comp ]\n"
+                ));
+            }
+        }
+        // Invert 3x3 linear block w_0..2_0..2, store w2o & o2w columns, transform (w_ro, w_rd).
+        s.push_str(
+            "  %c00a = fmul float %w_1_1, %w_2_2\n\
+             \x20 %c00b = fmul float %w_1_2, %w_2_1\n\
+             \x20 %c00 = fsub float %c00a, %c00b\n\
+             \x20 %c01a = fmul float %w_1_2, %w_2_0\n\
+             \x20 %c01b = fmul float %w_1_0, %w_2_2\n\
+             \x20 %c01 = fsub float %c01a, %c01b\n\
+             \x20 %c02a = fmul float %w_1_0, %w_2_1\n\
+             \x20 %c02b = fmul float %w_1_1, %w_2_0\n\
+             \x20 %c02 = fsub float %c02a, %c02b\n\
+             \x20 %d0 = fmul float %w_0_0, %c00\n\
+             \x20 %d1 = fmul float %w_0_1, %c01\n\
+             \x20 %d2 = fmul float %w_0_2, %c02\n\
+             \x20 %d01 = fadd float %d0, %d1\n\
+             \x20 %det = fadd float %d01, %d2\n\
+             \x20 %adet = call float @llvm.fabs.f32(float %det)\n\
+             \x20 %det_ok = fcmp ogt float %adet, 1.000000e-12\n\
+             \x20 %sdet = select i1 %det_ok, float %det, float 1.000000e+00\n\
+             \x20 %idet = fdiv float 1.000000e+00, %sdet\n\
+             \x20 %i_0_0 = fmul float %c00, %idet\n\
+             \x20 %i01a = fmul float %w_0_2, %w_2_1\n\
+             \x20 %i01b = fmul float %w_0_1, %w_2_2\n\
+             \x20 %i01n = fsub float %i01a, %i01b\n\
+             \x20 %i_0_1 = fmul float %i01n, %idet\n\
+             \x20 %i02a = fmul float %w_0_1, %w_1_2\n\
+             \x20 %i02b = fmul float %w_0_2, %w_1_1\n\
+             \x20 %i02n = fsub float %i02a, %i02b\n\
+             \x20 %i_0_2 = fmul float %i02n, %idet\n\
+             \x20 %i_1_0 = fmul float %c01, %idet\n\
+             \x20 %i11a = fmul float %w_0_0, %w_2_2\n\
+             \x20 %i11b = fmul float %w_0_2, %w_2_0\n\
+             \x20 %i11n = fsub float %i11a, %i11b\n\
+             \x20 %i_1_1 = fmul float %i11n, %idet\n\
+             \x20 %i12a = fmul float %w_0_2, %w_1_0\n\
+             \x20 %i12b = fmul float %w_0_0, %w_1_2\n\
+             \x20 %i12n = fsub float %i12a, %i12b\n\
+             \x20 %i_1_2 = fmul float %i12n, %idet\n\
+             \x20 %i_2_0 = fmul float %c02, %idet\n\
+             \x20 %i21a = fmul float %w_0_1, %w_2_0\n\
+             \x20 %i21b = fmul float %w_0_0, %w_2_1\n\
+             \x20 %i21n = fsub float %i21a, %i21b\n\
+             \x20 %i_2_1 = fmul float %i21n, %idet\n\
+             \x20 %i22a = fmul float %w_0_0, %w_1_1\n\
+             \x20 %i22b = fmul float %w_0_1, %w_1_0\n\
+             \x20 %i22n = fsub float %i22a, %i22b\n\
+             \x20 %i_2_2 = fmul float %i22n, %idet\n",
+        );
+        for rw in 0..3u32 {
+            s.push_str(&format!(
+                "  %it{rw}_0 = fmul float %i_{rw}_0, %w_0_3\n\
+                 \x20 %it{rw}_1 = fmul float %i_{rw}_1, %w_1_3\n\
+                 \x20 %it{rw}_2 = fmul float %i_{rw}_2, %w_2_3\n\
+                 \x20 %it{rw}_01 = fadd float %it{rw}_0, %it{rw}_1\n\
+                 \x20 %it{rw}_s = fadd float %it{rw}_01, %it{rw}_2\n\
+                 \x20 %i_{rw}_3 = fsub float -0.000000e+00, %it{rw}_s\n"
+            ));
+        }
+        s.push_str(
+            "  %wrx = extractelement <3 x float> %w_ro, i64 0\n\
+             \x20 %wry = extractelement <3 x float> %w_ro, i64 1\n\
+             \x20 %wrz = extractelement <3 x float> %w_ro, i64 2\n\
+             \x20 %wdx = extractelement <3 x float> %w_rd, i64 0\n\
+             \x20 %wdy = extractelement <3 x float> %w_rd, i64 1\n\
+             \x20 %wdz = extractelement <3 x float> %w_rd, i64 2\n",
+        );
+        for (rw, c) in [(0, "x"), (1, "y"), (2, "z")] {
+            s.push_str(&format!(
+                "  %oro_{c}0 = fmul float %i_{rw}_0, %wrx\n\
+                 \x20 %oro_{c}1 = fmul float %i_{rw}_1, %wry\n\
+                 \x20 %oro_{c}2 = fmul float %i_{rw}_2, %wrz\n\
+                 \x20 %oro_{c}01 = fadd float %oro_{c}0, %oro_{c}1\n\
+                 \x20 %oro_{c}012 = fadd float %oro_{c}01, %oro_{c}2\n\
+                 \x20 %oro_{c} = fadd float %oro_{c}012, %i_{rw}_3\n\
+                 \x20 %ord_{c}0 = fmul float %i_{rw}_0, %wdx\n\
+                 \x20 %ord_{c}1 = fmul float %i_{rw}_1, %wdy\n\
+                 \x20 %ord_{c}2 = fmul float %i_{rw}_2, %wdz\n\
+                 \x20 %ord_{c}01 = fadd float %ord_{c}0, %ord_{c}1\n\
+                 \x20 %ord_{c} = fadd float %ord_{c}01, %ord_{c}2\n"
+            ));
+        }
+        s.push_str(&format!(
+            "  %orv0 = insertelement <3 x float> poison, float %oro_x, i64 0\n\
+             \x20 %orv1 = insertelement <3 x float> %orv0, float %oro_y, i64 1\n\
+             \x20 %orv = insertelement <3 x float> %orv1, float %oro_z, i64 2\n\
+             \x20 %odv0 = insertelement <3 x float> poison, float %ord_x, i64 0\n\
+             \x20 %odv1 = insertelement <3 x float> %odv0, float %ord_y, i64 1\n\
+             \x20 %odv = insertelement <3 x float> %odv1, float %ord_z, i64 2\n",
+        ));
+        for cl in 0..4u32 {
+            s.push_str(&format!(
+                "  %o2wc{cl}_0 = insertelement <3 x float> poison, float %w_0_{cl}, i64 0\n\
+                 \x20 %o2wc{cl}_1 = insertelement <3 x float> %o2wc{cl}_0, float %w_1_{cl}, i64 1\n\
+                 \x20 %o2wc{cl} = insertelement <3 x float> %o2wc{cl}_1, float %w_2_{cl}, i64 2\n\
+                 \x20 %w2oc{cl}_0 = insertelement <3 x float> poison, float %i_0_{cl}, i64 0\n\
+                 \x20 %w2oc{cl}_1 = insertelement <3 x float> %w2oc{cl}_0, float %i_1_{cl}, i64 1\n\
+                 \x20 %w2oc{cl} = insertelement <3 x float> %w2oc{cl}_1, float %i_2_{cl}, i64 2\n"
+            ));
+        }
+        s.push_str(&format!(
+            "  %ret_bda = select i1 %det_ok, i64 %blas_bda, i64 0\n\
+             \x20 %st_0 = insertvalue {xform_ret_ty} poison, i64 %ret_bda, 0\n\
+             \x20 %st_1 = insertvalue {xform_ret_ty} %st_0, <3 x float> %orv, 1\n\
+             \x20 %st_2 = insertvalue {xform_ret_ty} %st_1, <3 x float> %odv, 2\n\
+             \x20 %st_3 = insertvalue {xform_ret_ty} %st_2, i32 %opts, 3\n\
+             \x20 %st_4 = insertvalue {xform_ret_ty} %st_3, i32 %ift_off, 4\n\
+             \x20 %st_5 = insertvalue {xform_ret_ty} %st_4, i32 %uid, 5\n\
+             \x20 %st_6 = insertvalue {xform_ret_ty} %st_5, <3 x float> %w2oc0, 6\n\
+             \x20 %st_7 = insertvalue {xform_ret_ty} %st_6, <3 x float> %w2oc1, 7\n\
+             \x20 %st_8 = insertvalue {xform_ret_ty} %st_7, <3 x float> %w2oc2, 8\n\
+             \x20 %st_9 = insertvalue {xform_ret_ty} %st_8, <3 x float> %w2oc3, 9\n\
+             \x20 %st_10 = insertvalue {xform_ret_ty} %st_9, <3 x float> %o2wc0, 10\n\
+             \x20 %st_11 = insertvalue {xform_ret_ty} %st_10, <3 x float> %o2wc1, 11\n\
+             \x20 %st_12 = insertvalue {xform_ret_ty} %st_11, <3 x float> %o2wc2, 12\n\
+             \x20 %st_13 = insertvalue {xform_ret_ty} %st_12, <3 x float> %o2wc3, 13\n\
+             \x20 br label %hdr_done\n\
+             \n\
+             hdr_done:\n\
+             \x20 %h_res = phi {xform_ret_ty} [ %st_13, %xf_merge ], [ zeroinitializer, %read_hdr ]\n\
+             \x20 br label %slot_done\n\
+             \n\
+             slot_done:\n\
+             \x20 %s_res = phi {xform_ret_ty} [ %h_res, %hdr_done ], [ zeroinitializer, %read_slot ]\n\
+             \x20 br label %exit\n\
+             \n\
+             exit:\n\
+             \x20 %res = phi {xform_ret_ty} [ %s_res, %slot_done ], [ zeroinitializer, %entry ]\n\
+             \x20 ret {xform_ret_ty} %res\n\
+             }}\n",
+        ));
+        out.push_str(&s);
+    }
+}
