 use spirv::{Capability, Decoration, Op, Scope, SelectionControl, StorageClass, Word};
 use std::collections::{HashMap, HashSet};
 use std::path::PathBuf;
+
+fn forwarded_loaded_values(
+    module: &crate::spirv_module::Module,
+    seeds: HashSet<Word>,
+) -> HashSet<Word> {
+    let mut values = seeds;
+    loop {
+        let before = values.len();
+        for instruction in module.all_inst_iter() {
+            let sources = match instruction.class.opcode {
+                Op::CopyObject => instruction.operands.first().into_iter().collect::<Vec<_>>(),
+                Op::Phi => instruction.operands.iter().step_by(2).collect::<Vec<_>>(),
+                _ => continue,
+            };
+            if sources
+                .iter()
+                .any(|operand| matches!(operand, Operand::IdRef(id) if values.contains(id)))
+            {
+                if let Some(id) = instruction.result_id {
+                    values.insert(id);
+                }
+            }
+        }
+        if values.len() == before {
+            return values;
+        }
+    }
+}
 
