+use crate::spirv_module::{load_bytes, Operand};
+use spirv::Op;
+use std::collections::HashMap;
+
+trait RegistryId {
+    fn registry_id(&self) -> u32;
+}
+impl RegistryId for Operand {
+    fn registry_id(&self) -> u32 {
+        match self {
+            Self::IdRef(id) => *id,
+            _ => panic!("expected an id: {self:?}"),
+        }
+    }
+}
+
+// Interpret the generated registry helper so boundary tests exercise its actual SPIR-V branches.
+fn execute_guard(bytes: &[u8], table: &[u64], arguments: [u64; 3]) -> bool {
+    let module = load_bytes(bytes).unwrap();
+    let call = module
+        .functions
+        .iter()
+        .flat_map(|function| &function.blocks)
+        .flat_map(|block| &block.instructions)
+        .find(|instruction| instruction.class.opcode == Op::FunctionCall)
+        .unwrap();
+    let function_id = call.operands[0].registry_id();
+    let function = module
+        .functions
+        .iter()
+        .find(|function| function.def.as_ref().unwrap().result_id == Some(function_id))
+        .unwrap();
+    let mut values = HashMap::new();
+    for instruction in &module.types_global_values {
+        let value = match instruction.class.opcode {
+            Op::Constant => match instruction.operands[0] {
+                Operand::LiteralBit32(value) => u64::from(value),
+                Operand::LiteralBit64(value) => value,
+                _ => panic!("unexpected constant {instruction:?}"),
+            },
+            Op::ConstantTrue => 1,
+            Op::ConstantFalse => 0,
+            _ => continue,
+        };
+        values.insert(instruction.result_id.unwrap(), value);
+    }
+    for (parameter, value) in function.parameters.iter().zip(arguments) {
+        values.insert(parameter.result_id.unwrap(), value);
+    }
+    let mut current = function.blocks[0]
+        .label
+        .as_ref()
+        .unwrap()
+        .result_id
+        .unwrap();
+    let mut previous = 0;
+    for _ in 0..4096 {
+        let block = function
+            .blocks
+            .iter()
+            .find(|block| block.label.as_ref().unwrap().result_id == Some(current))
+            .unwrap();
+        for instruction in &block.instructions {
+            let id = |index: usize| instruction.operands[index].registry_id();
+            let read = |index: usize| values[&id(index)];
+            let value = match instruction.class.opcode {
+                Op::ArrayLength => table.len() as u64,
+                Op::AccessChain => read(2),
+                Op::Load => table[read(0) as usize],
+                Op::Bitcast | Op::CopyObject | Op::UConvert => read(0),
+                Op::CompositeExtract => match instruction.operands[1] {
+                    Operand::LiteralBit32(component) => (read(0) >> (32 * component)) & 0xffff_ffff,
+                    _ => panic!("unexpected registry vector extraction"),
+                },
+                Op::CompositeConstruct => (read(0) & 0xffff_ffff) | (read(1) << 32),
+                Op::IAdd => read(0).wrapping_add(read(1)),
+                Op::ISub => read(0).wrapping_sub(read(1)),
+                Op::IMul => read(0).wrapping_mul(read(1)),
+                Op::UDiv => read(0) / read(1),
+                Op::IEqual => u64::from(read(0) == read(1)),
+                Op::INotEqual => u64::from(read(0) != read(1)),
+                Op::UGreaterThanEqual => u64::from(read(0) >= read(1)),
+                Op::ULessThanEqual => u64::from(read(0) <= read(1)),
+                Op::ULessThan => u64::from(read(0) < read(1)),
+                Op::BitwiseAnd => read(0) & read(1),
+                Op::ShiftRightLogical => read(0) >> read(1),
+                Op::ShiftLeftLogical => read(0) << read(1),
+                Op::BitwiseOr => read(0) | read(1),
+                Op::LogicalAnd => u64::from(read(0) != 0 && read(1) != 0),
+                Op::LogicalOr => u64::from(read(0) != 0 || read(1) != 0),
+                Op::LogicalNot => u64::from(read(0) == 0),
+                Op::Select => {
+                    if read(0) != 0 {
+                        read(1)
+                    } else {
+                        read(2)
+                    }
+                }
+                Op::Phi => {
+                    let pair = instruction
+                        .operands
+                        .chunks_exact(2)
+                        .find(|pair| pair[1].registry_id() == previous)
+                        .unwrap();
+                    values[&pair[0].registry_id()]
+                }
+                Op::SelectionMerge | Op::LoopMerge => continue,
+                Op::Branch | Op::BranchConditional => {
+                    let target = if instruction.class.opcode == Op::Branch {
+                        id(0)
+                    } else if read(0) != 0 {
+                        id(1)
+                    } else {
+                        id(2)
+                    };
+                    previous = current;
+                    current = target;
+                    break;
+                }
+                Op::ReturnValue => return read(0) != 0,
+                _ => panic!("unmodeled registry instruction {instruction:?}"),
+            };
+            if let Some(result) = instruction.result_id {
+                values.insert(result, value);
+            }
+        }
+    }
+    panic!("registry failed to terminate within the test's row bound");
+}
+
+#[test]
+fn emitted_registry_checks_complete_ranges_permissions_and_malformed_headers() {
+    let source = r#"
+define void @consume(ptr addrspace(2) %args, ptr addrspace(1) %out) {
+entry:
+  %child = load ptr addrspace(1), ptr addrspace(2) %args, align 8
+  %value = load i32, ptr addrspace(1) %child, align 4
+  store i32 %value, ptr addrspace(1) %out, align 4
+  ret void
+}
+!air.kernel = !{!0}
+!0 = !{ptr @consume, !1, !2}
+!1 = !{}
+!2 = !{!3, !4}
+!3 = !{i32 0, !"air.buffer", !"air.location_index", i32 3, i32 1, !"air.read", !"air.address_space", i32 2, !"air.arg_type_name", !"uint*"}
+!4 = !{i32 1, !"air.buffer", !"air.location_index", i32 0, i32 1, !"air.write", !"air.address_space", i32 1, !"air.arg_type_name", !"uint"}
+"#;
+    let bytes = crate::translate_sanitized_native(
+        source,
+        crate::passes::Stage::Kernel,
+        &std::env::temp_dir(),
+    )
+    .unwrap();
+    let base = 0x18_0000_0000;
+    let mut table = vec![0; 100 + 257 * 3];
+    let extent = (table.len() * 8) as u64;
+    table[96..100].copy_from_slice(&[257, 24, extent, 0]);
+    let last = 100 + 256 * 3;
+    table[last..].copy_from_slice(&[base, 64, 1]);
+    for (address, size, access, expected) in [
+        (base, 4, 1, true),
+        (base + 60, 4, 1, true),
+        (base + 61, 4, 1, false),
+        (base - 1, 4, 1, false),
+        (base, 65, 1, false),
+        (base, 4, 2, false),
+        (base, 4, 3, false),
+        (base & 0xffff_ffff, 4, 1, false),
+        (0, 4, 1, false),
+        (u64::MAX - 1, 4, 1, false),
+    ] {
+        assert_eq!(
+            execute_guard(&bytes, &table, [address, size, access]),
+            expected,
+            "address={address:x} size={size} access={access}"
+        );
+    }
+    table[last + 2] = 3;
+    assert!(execute_guard(&bytes, &table, [base, 64, 3]));
+    table[last] = u64::MAX - 1;
+    assert!(!execute_guard(&bytes, &table, [u64::MAX - 1, 4, 1]));
+    table[last] = base;
+    for (word, malformed) in [(96, u64::MAX), (96, 258), (97, 16), (98, 800), (99, 1)] {
+        let valid = table[word];
+        table[word] = malformed;
+        assert!(
+            !execute_guard(&bytes, &table, [base, 4, 1]),
+            "header word {word}"
+        );
+        table[word] = valid;
+    }
+    assert!(!execute_guard(&bytes, &table[..99], [base, 4, 1]));
+}
