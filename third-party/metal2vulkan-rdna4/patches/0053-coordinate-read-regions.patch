+#[test]
+fn linear_regions_stop_at_joins_conditionals_cycles_and_ordered_prefixes() {
+    let original = source("", "float");
+    for prefix in [
+        "call void @side_effect()",
+        "fence seq_cst",
+        "store volatile i32 7, ptr addrspace(1) %output",
+    ] {
+        let text = source(prefix, "float")
+            .replace(" %p =", " br label %read\nread:\n %p =")
+            .replace("[ %sample, %arm ]", "[ %sample, %read ]");
+        assert_eq!(rewritten(&text).len(), 4, "{prefix}");
+    }
+    let conditional = original
+        .replace(
+            "arm:\n",
+            "arm:\n br i1 %condition, label %read, label %exit\nread:\n",
+        )
+        .replace(
+            "[ %sample, %arm ], [ 0.0, %entry ]",
+            "[ %sample, %read ], [ 0.0, %entry ], [ 0.0, %arm ]",
+        );
+    let blocks = rewritten(&conditional);
+    // The nested condition may plan its own read, but the outer selection must not do so.
+    assert_eq!(
+        named(&blocks, "%entry").terminator,
+        TirTerminator::BrCond {
+            cond: "%condition".into(),
+            t: "%arm".into(),
+            f: "%exit".into()
+        }
+    );
+    let joined = original
+        .replace("label %arm, label %exit", "label %arm, label %other")
+        .replace(
+            "arm:\n",
+            "other:\n br label %read\narm:\n br label %read\nread:\n",
+        )
+        .replace("[ %sample, %arm ], [ 0.0, %entry ]", "[ %sample, %read ]");
+    assert_eq!(rewritten(&joined).len(), 5);
+    let cycle = original
+        .replace(
+            "arm:\n",
+            "arm:\n br label %cycle\ncycle:\n br label %arm\nunreachable_sample:\n",
+        )
+        .replace("[ %sample, %arm ]", "[ %sample, %unreachable_sample ]");
+    assert_eq!(rewritten(&cycle).len(), 5);
+}
