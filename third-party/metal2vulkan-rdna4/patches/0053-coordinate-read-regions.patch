 #[test]
+fn linear_coordinate_region_preserves_cross_block_memory_order_and_source_edges() {
+    let text = source(
+        "%before = load i32, ptr addrspace(2) %buffer, align 4\n \
+         store i32 %before, ptr addrspace(1) %output, align 4\n \
+         br label %read\nread:\n %offset = add i64 %index, 8\n \
+         br label %sample_block\nsample_block:",
+        "float",
+    )
+    .replace("%buffer, i64 8", "%buffer, i64 %offset")
+    .replace("[ %sample, %arm ]", "[ %sample, %sample_block ]");
+    let blocks = rewritten(&text);
+    assert_eq!(blocks.len(), 7);
+    let TirTerminator::BrCond { t, f, .. } = &named(&blocks, "%entry").terminator else {
+        panic!()
+    };
+    let guard = named(&blocks, t);
+    assert_eq!(
+        guard
+            .insts
+            .iter()
+            .map(|i| i.opcode.clone())
+            .collect::<Vec<_>>(),
+        [
+            TirOpcode::Load,
+            TirOpcode::Store,
+            TirOpcode::Add,
+            TirOpcode::GetElementPtr,
+            TirOpcode::Load
+        ]
+    );
+    assert_eq!(named(&blocks, f).insts.len(), 2);
+    assert_eq!(
+        named(&blocks, "%arm").terminator,
+        TirTerminator::Br("%read".into())
+    );
+    assert_eq!(
+        named(&blocks, "%read").terminator,
+        TirTerminator::Br("%sample_block".into())
+    );
+    for name in ["%arm", "%read", "%sample_block"] {
+        assert!(!named(&blocks, name)
+            .insts
+            .iter()
+            .any(|i| i.load().is_some() || i.store().is_some()));
+    }
+    assert!(named(&blocks, "%exit").insts[0]
+        .phi_incoming()
+        .as_ref()
+        .unwrap()
+        .1
+        .iter()
+        .any(|(_, pred)| pred == "%sample_block"));
+    let parsed = LlModule::parse_with_stage_meta(&text, None, Some("main")).unwrap();
+    let mut repeated = blocks.clone();
+    reconverge(&parsed, &parsed.functions[0], &mut repeated);
+    assert_eq!(
+        repeated.iter().map(BodyBlock::lines).collect::<Vec<_>>(),
+        blocks.iter().map(BodyBlock::lines).collect::<Vec<_>>()
+    );
+}
