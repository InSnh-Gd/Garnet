+fn emit_clamped_set_mesh_outputs(
+    ctx: &mut Ctx,
+    vc_var: Word,
+    pc_var: Word,
+    max_v: u32,
+    max_p: u32,
+    out: &mut Vec<Instruction>,
+) {
+    let uint_ty = ctx.ty_uint();
+    let bool_ty = ctx.ty_bool();
+    let wg_u32_ptr = ctx.ty_ptr(StorageClass::Workgroup, uint_ty);
+    emit_workgroup_barrier(ctx, out);
+    let raw_vc = ctx.module.fresh_id();
+    out.push(Instruction::new(
+        Op::Load,
+        Some(uint_ty),
+        Some(raw_vc),
+        vec![Operand::IdRef(vc_var)],
+    ));
+    let raw_pc = ctx.module.fresh_id();
+    out.push(Instruction::new(
+        Op::Load,
+        Some(uint_ty),
+        Some(raw_pc),
+        vec![Operand::IdRef(pc_var)],
+    ));
+    let c_max_v = ctx.const_uint(max_v);
+    let c_max_p = ctx.const_uint(max_p);
+    let vc_in = ctx.module.fresh_id();
+    out.push(Instruction::new(
+        Op::ULessThanEqual,
+        Some(bool_ty),
+        Some(vc_in),
+        vec![Operand::IdRef(raw_vc), Operand::IdRef(c_max_v)],
+    ));
+    let vc = ctx.module.fresh_id();
+    out.push(Instruction::new(
+        Op::Select,
+        Some(uint_ty),
+        Some(vc),
+        vec![Operand::IdRef(vc_in), Operand::IdRef(raw_vc), Operand::IdRef(c_max_v)],
+    ));
+    let pc_in = ctx.module.fresh_id();
+    out.push(Instruction::new(
+        Op::ULessThanEqual,
+        Some(bool_ty),
+        Some(pc_in),
+        vec![Operand::IdRef(raw_pc), Operand::IdRef(c_max_p)],
+    ));
+    let pc = ctx.module.fresh_id();
+    out.push(Instruction::new(
+        Op::Select,
+        Some(uint_ty),
+        Some(pc),
+        vec![Operand::IdRef(pc_in), Operand::IdRef(raw_pc), Operand::IdRef(c_max_p)],
+    ));
+    let _ = wg_u32_ptr;
+    out.push(Instruction::new(
+        Op::SetMeshOutputsEXT,
+        None,
+        None,
+        vec![Operand::IdRef(vc), Operand::IdRef(pc)],
+    ));
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+enum SetOutputsPlacement {
+    /// No count call present -> emit `OpSetMeshOutputsEXT 0 0` at entry.
+    ZeroAtEntry,
+    /// Count call(s) appear unconditionally in block 0 before any output write -> emit
+    /// barrier + `OpSetMeshOutputsEXT` immediately after the last count call in block 0.
+    AfterBlock0Index(usize),
+    /// Count call(s) appear in a pre-write selection arm whose merge block dominates all writes
+    /// -> emit barrier + `OpSetMeshOutputsEXT` at the start of that merge block (after Phis).
+    StartOfBlock(usize),
+    /// General fallback when count is set after some mesh output write -> emit
+    /// `OpSetMeshOutputsEXT max_v max_p` at entry and cull `[pc .. max_p)` via `CullPrimitiveEXT`.
+    MaxAtEntryCullAtExit,
+}
+
+fn plan_set_mesh_outputs(
+    func: &Function,
+    names: &HashMap<Word, String>,
+) -> SetOutputsPlacement {
+    let mut count_sites: Vec<(usize, usize)> = Vec::new();
+    let mut write_sites: Vec<(usize, usize)> = Vec::new();
+    for (bi, blk) in func.blocks.iter().enumerate() {
+        for (ii, inst) in blk.instructions.iter().enumerate() {
+            if inst.class.opcode != Op::FunctionCall {
+                continue;
+            }
+            let Some(Operand::IdRef(callee)) = inst.operands.first() else {
+                continue;
+            };
+            let Some(name) = names.get(callee) else {
+                continue;
+            };
+            if is_mesh_count_setter(name) {
+                count_sites.push((bi, ii));
+            } else if is_mesh_output_setter(name) {
+                write_sites.push((bi, ii));
+            }
+        }
+    }
+    if count_sites.is_empty() {
+        return SetOutputsPlacement::ZeroAtEntry;
+    }
+    // Subcase A: all count sites are in block 0 and strictly precede all writes in block 0.
+    if count_sites.iter().all(|&(bi, _)| bi == 0) {
+        let last_count_ii = count_sites.iter().map(|&(_, ii)| ii).max().unwrap_or(0);
+        let write_before = write_sites
+            .iter()
+            .any(|&(bi, ii)| bi == 0 && ii < last_count_ii);
+        if !write_before {
+            return SetOutputsPlacement::AfterBlock0Index(last_count_ii);
+        }
+    }
+    // Subcase B: block 0 has an OpSelectionMerge %merge_label before any write, count calls live
+    // only in blocks strictly before merge_bi, and all writes live in merge_bi or later blocks.
+    let label_to_bi: HashMap<Word, usize> = func
+        .blocks
+        .iter()
+        .enumerate()
+        .filter_map(|(bi, blk)| Some((blk.label.as_ref()?.result_id?, bi)))
+        .collect();
+    if let Some(b0) = func.blocks.first() {
+        let write_in_b0 = write_sites.iter().any(|&(bi, _)| bi == 0);
+        if !write_in_b0 {
+            if let Some(merge_label) = b0.instructions.iter().find_map(|inst| {
+                (inst.class.opcode == Op::SelectionMerge).then(|| match inst.operands.first() {
+                    Some(Operand::IdRef(l)) => Some(*l),
+                    _ => None,
+                })?
+            }) {
+                if let Some(&merge_bi) = label_to_bi.get(&merge_label) {
+                    let all_counts_before = count_sites.iter().all(|&(bi, _)| bi < merge_bi);
+                    let all_writes_from_merge = write_sites.iter().all(|&(bi, _)| bi >= merge_bi);
+                    if all_counts_before && all_writes_from_merge {
+                        return SetOutputsPlacement::StartOfBlock(merge_bi);
+                    }
+                }
+            }
+        }
+    }
+    SetOutputsPlacement::MaxAtEntryCullAtExit
+}
+
+fn lower_mesh_stage(
+    ctx: &mut Ctx,
+    entry_idx: usize,
+    kern: Option<&KernMeta>,
+) -> Result<(), String> {
+    let meta = kern
+        .and_then(|k| k.mesh_meta.clone())
+        .unwrap_or_default();
+    let names = air_names(&ctx.module);
+    let (defs, val_tys) = collect_defs_and_value_types(ctx, entry_idx);
+
+    let has_point_size = meta
+        .vertex_outputs
+        .iter()
+        .any(|m| m.kind == MeshOutputKind::PointSize)
+        || ctx.module.functions[entry_idx]
+            .blocks
+            .iter()
+            .flat_map(|b| b.instructions.iter())
+            .any(|inst| {
+                inst.class.opcode == Op::FunctionCall
+                    && inst.operands.first().is_some_and(|op| match op {
+                        Operand::IdRef(c) => names.get(c).is_some_and(|n| {
+                            n.starts_with("air.set_mesh_point_size")
+                                || n.starts_with("air.set_mesh_vertex_point_size")
+                        }),
+                        _ => false,
+                    })
+            });
+
+    let placement = plan_set_mesh_outputs(&ctx.module.functions[entry_idx], &names);
+    let mut outputs = MeshOutputs::new(ctx, &meta, has_point_size);
+
+    let uint_ty = ctx.ty_uint();
+    let wg_u32_ptr = ctx.ty_ptr(StorageClass::Workgroup, uint_ty);
+    let vc_var = ctx.module.fresh_id();
+    let pc_var = ctx.module.fresh_id();
+    if placement != SetOutputsPlacement::ZeroAtEntry {
+        for var in [vc_var, pc_var] {
+            ctx.new_globals.push(Instruction::new(
+                Op::Variable,
+                Some(wg_u32_ptr),
+                Some(var),
+                vec![Operand::StorageClass(StorageClass::Workgroup)],
+            ));
+            ctx.interface_buffer_var(var);
+        }
+    }
+
+    let c_max_v = ctx.const_uint(meta.max_vertices);
+    let c_max_p = ctx.const_uint(meta.max_primitives);
+    let c0 = ctx.const_uint(0);
+    let mut explicit_cull_written = false;
+
+    let mut late_cull_return_blocks: Vec<usize> = Vec::new();
+    for bi in 0..ctx.module.functions[entry_idx].blocks.len() {
+        let old = ctx.module.functions[entry_idx].blocks[bi]
+            .instructions
+            .clone();
+        let mut rewritten = Vec::with_capacity(old.len() + 16);
+
+        // Placement: ZeroAtEntry or MaxAtEntryCullAtExit emits OpSetMeshOutputsEXT after OpVariables in block 0.
+        let mut entry_emitted = false;
+        let mut start_of_block_emitted = false;
+
+        for (ii, inst) in old.into_iter().enumerate() {
+            if bi == 0 && !entry_emitted && inst.class.opcode != Op::Variable {
+                entry_emitted = true;
+                match placement {
+                    SetOutputsPlacement::ZeroAtEntry => {
+                        rewritten.push(Instruction::new(
+                            Op::SetMeshOutputsEXT,
+                            None,
+                            None,
+                            vec![Operand::IdRef(c0), Operand::IdRef(c0)],
+                        ));
+                    }
+                    SetOutputsPlacement::MaxAtEntryCullAtExit => {
+                        rewritten.push(Instruction::new(
+                            Op::SetMeshOutputsEXT,
+                            None,
+                            None,
+                            vec![Operand::IdRef(c_max_v), Operand::IdRef(c_max_p)],
+                        ));
+                        let _ = outputs.ensure_cull_var(ctx);
+                    }
+                    _ => {}
+                }
+            }
+            if placement == SetOutputsPlacement::StartOfBlock(bi)
+                && !start_of_block_emitted
+                && inst.class.opcode != Op::Phi
+                && inst.class.opcode != Op::Variable
+            {
+                start_of_block_emitted = true;
+                emit_clamped_set_mesh_outputs(
+                    ctx,
+                    vc_var,
+                    pc_var,
+                    meta.max_vertices,
+                    meta.max_primitives,
+                    &mut rewritten,
+                );
+            }
+
+            if inst.class.opcode == Op::FunctionCall {
+                if let Some(Operand::IdRef(callee)) = inst.operands.first() {
+                    if let Some(name) = names.get(callee) {
+                        if crate::air_intrinsics::is_object_mesh_intrinsic(name) {
+                            let raw_args: Vec<Word> = inst
+                                .operands
+                                .iter()
+                                .skip(1)
+                                .filter_map(|o| match o {
+                                    Operand::IdRef(id) => Some(*id),
+                                    _ => None,
+                                })
+                                .collect();
+                            let args = strip_optional_handle_arg(&raw_args, &defs, &val_tys);
+                            if is_mesh_count_setter(name) {
+                                if name == "air.set_mesh_outputs"
+                                    || name.starts_with("air.set_mesh_outputs.")
+                                {
+                                    if args.len() >= 2 {
+                                        let vc = coerce_to_uint(
+                                            ctx,
+                                            &defs,
+                                            &val_tys,
+                                            args[0],
+                                            &mut rewritten,
+                                        );
+                                        let pc = coerce_to_uint(
+                                            ctx,
+                                            &defs,
+                                            &val_tys,
+                                            args[1],
+                                            &mut rewritten,
+                                        );
+                                        rewritten.push(Instruction::new(
+                                            Op::Store,
+                                            None,
+                                            None,
+                                            vec![Operand::IdRef(vc_var), Operand::IdRef(vc)],
+                                        ));
+                                        rewritten.push(Instruction::new(
+                                            Op::Store,
+                                            None,
+                                            None,
+                                            vec![Operand::IdRef(pc_var), Operand::IdRef(pc)],
+                                        ));
+                                    }
+                                } else if let Some(&pc_raw) = args.first() {
+                                    let pc = coerce_to_uint(
+                                        ctx,
+                                        &defs,
+                                        &val_tys,
+                                        pc_raw,
+                                        &mut rewritten,
+                                    );
+                                    rewritten.push(Instruction::new(
+                                        Op::Store,
+                                        None,
+                                        None,
+                                        vec![Operand::IdRef(vc_var), Operand::IdRef(c_max_v)],
+                                    ));
+                                    rewritten.push(Instruction::new(
+                                        Op::Store,
+                                        None,
+                                        None,
+                                        vec![Operand::IdRef(pc_var), Operand::IdRef(pc)],
+                                    ));
+                                }
+                                if placement == SetOutputsPlacement::AfterBlock0Index(ii) && bi == 0
+                                {
+                                    emit_clamped_set_mesh_outputs(
+                                        ctx,
+                                        vc_var,
+                                        pc_var,
+                                        meta.max_vertices,
+                                        meta.max_primitives,
+                                        &mut rewritten,
+                                    );
+                                }
+                                continue;
+                            }
+
+                            lower_mesh_output_call(
+                                ctx,
+                                name,
+                                args,
+                                &defs,
+                                &val_tys,
+                                &meta,
+                                &mut outputs,
+                                &mut explicit_cull_written,
+                                &mut rewritten,
+                            )?;
+                            continue;
+                        }
+                    }
+                }
+            }
+
+            if inst.class.opcode == Op::Return
+                && placement == SetOutputsPlacement::MaxAtEntryCullAtExit
+            {
+                late_cull_return_blocks.push(bi);
+            }
+            rewritten.push(inst);
+        }
+        ctx.module.functions[entry_idx].blocks[bi].instructions = rewritten;
+    }
+
+    if !late_cull_return_blocks.is_empty() {
+        inject_late_primitive_cull_loops(
+            ctx,
+            entry_idx,
+            &late_cull_return_blocks,
+            pc_var,
+            &mut outputs,
+            explicit_cull_written,
+        );
+    }
+    Ok(())
+}
+
+/// Replace each `OpReturn` in `return_blocks` with a structured write-only loop that culls every
+/// primitive `p >= pc` (and initializes `CullPrimitiveEXT[p] = false` for `p < pc` when the shader
+/// did not explicitly write `CullPrimitiveEXT`), never loading from write-only `MeshEXT` Outputs.
+fn inject_late_primitive_cull_loops(
+    ctx: &mut Ctx,
+    entry_idx: usize,
+    return_blocks: &[usize],
+    pc_var: Word,
+    outputs: &mut MeshOutputs,
+    explicit_cull_written: bool,
+) {
+    let uint_ty = ctx.ty_uint();
+    let bool_ty = ctx.ty_bool();
+    let cull_var = outputs.ensure_cull_var(ctx);
+    let out_bool_ptr = ctx.ty_ptr(StorageClass::Output, bool_ty);
+    let out_idx_ptr = ctx.ty_ptr(StorageClass::Output, outputs.prim_indices_elem_ty);
+    let zero_idx_val = ctx.const_null(outputs.prim_indices_elem_ty);
+    let bool_ty = ctx.ty_bool();
+    let c_true = ctx.const_bool_of(bool_ty, true);
+    let c_false = ctx.const_bool_of(bool_ty, false);
+    let c_max_p = ctx.const_uint(outputs.max_primitives);
+    let total = ctx.kernel_local_size[0]
+        .saturating_mul(ctx.kernel_local_size[1])
+        .saturating_mul(ctx.kernel_local_size[2])
+        .max(1);
+    let c_total = ctx.const_uint(total);
+
+    let existing_lid_var = ctx.module.annotations.iter().find_map(|ann| {
+        if ann.class.opcode == Op::Decorate
+            && ann.operands.get(1) == Some(&Operand::Decoration(Decoration::BuiltIn))
+            && ann.operands.get(2) == Some(&Operand::BuiltIn(BuiltIn::LocalInvocationIndex))
+        {
+            match ann.operands.first() {
+                Some(Operand::IdRef(id)) => Some(*id),
+                _ => None,
+            }
+        } else {
+            None
+        }
+    });
+    let lid_var = if let Some(var) = existing_lid_var {
+        var
+    } else {
+        let lid_ptr_ty = ctx.ty_ptr(StorageClass::Input, uint_ty);
+        let var = ctx.module.fresh_id();
+        ctx.new_globals.push(Instruction::new(
+            Op::Variable,
+            Some(lid_ptr_ty),
+            Some(var),
+            vec![Operand::StorageClass(StorageClass::Input)],
+        ));
+        decorate_builtin(&mut ctx.module, var, BuiltIn::LocalInvocationIndex);
+        ctx.interface.push(var);
+        var
+    };
+
+    // Process in reverse block order so splicing new blocks preserves earlier block indices.
+    for &bi in return_blocks.iter().rev() {
+        let Some(pre_label) = ctx.module.functions[entry_idx].blocks[bi]
+            .label
+            .as_ref()
+            .and_then(|l| l.result_id)
+        else {
+            continue;
+        };
+        let ret_pos = ctx.module.functions[entry_idx].blocks[bi]
+            .instructions
+            .iter()
+            .position(|i| i.class.opcode == Op::Return);
+        let Some(ret_pos) = ret_pos else { continue };
+
+        let hdr_lbl = ctx.module.fresh_id();
+        let body_lbl = ctx.module.fresh_id();
+        let cull_lbl = ctx.module.fresh_id();
+        let keep_lbl = (!explicit_cull_written).then(|| ctx.module.fresh_id());
+        let merge_lbl = ctx.module.fresh_id();
+        let cont_lbl = ctx.module.fresh_id();
+        let after_lbl = ctx.module.fresh_id();
+
+        let mut pre_tail = Vec::new();
+        emit_workgroup_barrier(ctx, &mut pre_tail);
+        let pc = ctx.module.fresh_id();
+        pre_tail.push(Instruction::new(
+            Op::Load,
+            Some(uint_ty),
+            Some(pc),
+            vec![Operand::IdRef(pc_var)],
+        ));
+        let lid = ctx.module.fresh_id();
+        pre_tail.push(Instruction::new(
+            Op::Load,
+            Some(uint_ty),
+            Some(lid),
+            vec![Operand::IdRef(lid_var)],
+        ));
+        pre_tail.push(Instruction::new(
+            Op::Branch,
+            None,
+            None,
+            vec![Operand::IdRef(hdr_lbl)],
+        ));
+        ctx.module.functions[entry_idx].blocks[bi]
+            .instructions
+            .splice(ret_pos..=ret_pos, pre_tail);
+
+        let p_phi = ctx.module.fresh_id();
+        let p_next = ctx.module.fresh_id();
+        let in_bounds = ctx.module.fresh_id();
+        let hdr_block = Block {
+            label: Some(Instruction::new(Op::Label, None, Some(hdr_lbl), vec![])),
+            instructions: vec![
+                Instruction::new(
+                    Op::Phi,
+                    Some(uint_ty),
+                    Some(p_phi),
+                    vec![
+                        Operand::IdRef(lid),
+                        Operand::IdRef(pre_label),
+                        Operand::IdRef(p_next),
+                        Operand::IdRef(cont_lbl),
+                    ],
+                ),
+                Instruction::new(
+                    Op::ULessThan,
+                    Some(bool_ty),
+                    Some(in_bounds),
+                    vec![Operand::IdRef(p_phi), Operand::IdRef(c_max_p)],
+                ),
+                Instruction::new(
+                    Op::LoopMerge,
+                    None,
+                    None,
+                    vec![
+                        Operand::IdRef(after_lbl),
+                        Operand::IdRef(cont_lbl),
+                        Operand::LoopControl(spirv::LoopControl::NONE),
+                    ],
+                ),
+                Instruction::new(
+                    Op::BranchConditional,
+                    None,
+                    None,
+                    vec![
+                        Operand::IdRef(in_bounds),
+                        Operand::IdRef(body_lbl),
+                        Operand::IdRef(after_lbl),
+                    ],
+                ),
+            ],
+        };
+
+        let past_pc = ctx.module.fresh_id();
+        let false_target = keep_lbl.unwrap_or(merge_lbl);
+        let body_insts = vec![
+            Instruction::new(
+                Op::UGreaterThanEqual,
+                Some(bool_ty),
+                Some(past_pc),
+                vec![Operand::IdRef(p_phi), Operand::IdRef(pc)],
+            ),
+            Instruction::new(
+                Op::SelectionMerge,
+                None,
+                None,
+                vec![
+                    Operand::IdRef(merge_lbl),
+                    Operand::SelectionControl(spirv::SelectionControl::NONE),
+                ],
+            ),
+            Instruction::new(
+                Op::BranchConditional,
+                None,
+                None,
+                vec![
+                    Operand::IdRef(past_pc),
+                    Operand::IdRef(cull_lbl),
+                    Operand::IdRef(false_target),
+                ],
+            ),
+        ];
+        let body_block = Block {
+            label: Some(Instruction::new(Op::Label, None, Some(body_lbl), vec![])),
+            instructions: body_insts,
+        };
+
+        let cp = ctx.module.fresh_id();
+        let ip = ctx.module.fresh_id();
+        let cull_block = Block {
+            label: Some(Instruction::new(Op::Label, None, Some(cull_lbl), vec![])),
+            instructions: vec![
+                Instruction::new(
+                    Op::AccessChain,
+                    Some(out_bool_ptr),
+                    Some(cp),
+                    vec![Operand::IdRef(cull_var), Operand::IdRef(p_phi)],
+                ),
+                Instruction::new(
+                    Op::Store,
+                    None,
+                    None,
+                    vec![Operand::IdRef(cp), Operand::IdRef(c_true)],
+                ),
+                Instruction::new(
+                    Op::AccessChain,
+                    Some(out_idx_ptr),
+                    Some(ip),
+                    vec![Operand::IdRef(outputs.prim_indices_var), Operand::IdRef(p_phi)],
+                ),
+                Instruction::new(
+                    Op::Store,
+                    None,
+                    None,
+                    vec![Operand::IdRef(ip), Operand::IdRef(zero_idx_val)],
+                ),
+                Instruction::new(Op::Branch, None, None, vec![Operand::IdRef(merge_lbl)]),
+            ],
+        };
+
+        let keep_block = keep_lbl.map(|kl| {
+            let kcp = ctx.module.fresh_id();
+            Block {
+                label: Some(Instruction::new(Op::Label, None, Some(kl), vec![])),
+                instructions: vec![
+                    Instruction::new(
+                        Op::AccessChain,
+                        Some(out_bool_ptr),
+                        Some(kcp),
+                        vec![Operand::IdRef(cull_var), Operand::IdRef(p_phi)],
+                    ),
+                    Instruction::new(
+                        Op::Store,
+                        None,
+                        None,
+                        vec![Operand::IdRef(kcp), Operand::IdRef(c_false)],
+                    ),
+                    Instruction::new(Op::Branch, None, None, vec![Operand::IdRef(merge_lbl)]),
+                ],
+            }
+        });
+
+        let merge_block = Block {
+            label: Some(Instruction::new(Op::Label, None, Some(merge_lbl), vec![])),
+            instructions: vec![Instruction::new(
+                Op::Branch,
+                None,
+                None,
+                vec![Operand::IdRef(cont_lbl)],
+            )],
+        };
+
+        let cont_block = Block {
+            label: Some(Instruction::new(Op::Label, None, Some(cont_lbl), vec![])),
+            instructions: vec![
+                Instruction::new(
+                    Op::IAdd,
+                    Some(uint_ty),
+                    Some(p_next),
+                    vec![Operand::IdRef(p_phi), Operand::IdRef(c_total)],
+                ),
+                Instruction::new(Op::Branch, None, None, vec![Operand::IdRef(hdr_lbl)]),
+            ],
+        };
+
+        let after_block = Block {
+            label: Some(Instruction::new(Op::Label, None, Some(after_lbl), vec![])),
+            instructions: vec![Instruction::new(Op::Return, None, None, vec![])],
+        };
+
+        let mut new_blocks = vec![hdr_block, body_block, cull_block];
+        if let Some(kb) = keep_block {
+            new_blocks.push(kb);
+        }
+        new_blocks.extend([merge_block, cont_block, after_block]);
+        ctx.module.functions[entry_idx]
+            .blocks
+            .splice((bi + 1)..(bi + 1), new_blocks);
+    }
+}
+
+fn lower_mesh_output_call(
+    ctx: &mut Ctx,
+    name: &str,
+    args: &[Word],
+    defs: &HashMap<Word, Instruction>,
+    val_tys: &HashMap<Word, Word>,
+    meta: &MeshStageMeta,
+    outputs: &mut MeshOutputs,
+    explicit_cull_written: &mut bool,
+    out: &mut Vec<Instruction>,
+) -> Result<(), String> {
+    if name == "air.set_mesh_index" || name.starts_with("air.set_mesh_index.") {
+        if args.len() < 2 {
+            return Err(format!("{name} expects at least 2 operands"));
+        }
+        let flat_idx = coerce_to_uint(ctx, defs, val_tys, args[0], out);
+        let vidx = coerce_to_uint(ctx, defs, val_tys, args[1], out);
+        outputs.store_flat_index(ctx, flat_idx, vidx, out);
+        return Ok(());
+    }
+    if name == "air.set_mesh_primitive_indices"
+        || name.starts_with("air.set_mesh_primitive_indices.")
+    {
+        if args.len() < 2 {
+            return Err(format!("{name} expects at least 2 operands"));
+        }
+        let pidx = coerce_to_uint(ctx, defs, val_tys, args[0], out);
+        let val = args[1];
+        let src_ty = val_tys
+            .get(&val)
+            .copied()
+            .unwrap_or(outputs.prim_indices_elem_ty);
+        let coerced = coerce_store_value(ctx, defs, val, src_ty, outputs.prim_indices_elem_ty, out);
+        let ptr_ty = ctx.ty_ptr(StorageClass::Output, outputs.prim_indices_elem_ty);
+        let p = ctx.module.fresh_id();
+        out.push(Instruction::new(
+            Op::AccessChain,
+            Some(ptr_ty),
+            Some(p),
+            vec![
+                Operand::IdRef(outputs.prim_indices_var),
+                Operand::IdRef(pidx),
+            ],
+        ));
+        out.push(Instruction::new(
+            Op::Store,
+            None,
+            None,
+            vec![Operand::IdRef(p), Operand::IdRef(coerced)],
+        ));
+        return Ok(());
+    }
+    if name == "air.set_mesh_position"
+        || name.starts_with("air.set_mesh_position.")
+        || name == "air.set_mesh_vertex_position"
+        || name.starts_with("air.set_mesh_vertex_position.")
+    {
+        if args.len() < 2 {
+            return Err(format!("{name} expects at least 2 operands"));
+        }
+        let vidx = coerce_to_uint(ctx, defs, val_tys, args[0], out);
+        outputs.store_position(ctx, vidx, args[1], out);
+        return Ok(());
+    }
+    if name == "air.set_mesh_point_size"
+        || name.starts_with("air.set_mesh_point_size.")
+        || name == "air.set_mesh_vertex_point_size"
+        || name.starts_with("air.set_mesh_vertex_point_size.")
+    {
+        if args.len() < 2 {
+            return Err(format!("{name} expects at least 2 operands"));
+        }
+        let vidx = coerce_to_uint(ctx, defs, val_tys, args[0], out);
+        outputs.store_point_size(ctx, vidx, args[1], out);
+        return Ok(());
+    }
+    if name == "air.set_mesh_primitive_culled"
+        || name.starts_with("air.set_mesh_primitive_culled.")
