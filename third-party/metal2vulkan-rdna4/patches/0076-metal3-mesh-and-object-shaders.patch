+//! Metal 3 Object (`TaskEXT`) and Mesh (`MeshEXT`) shader lowering pass.
+//!
+//! Lowers residual `air.set_mesh_*` / `air.mesh_grid_properties.*` intrinsics into valid
+//! SPIR-V 1.4+ `SPV_EXT_mesh_shader` instructions:
+//! - `Stage::Object`: stages `set_threadgroups_per_grid` into a `Workgroup` `[3 x uint]` grid,
+//!   synchronizes with `OpControlBarrier(Workgroup)` at exit, and terminates with uniform
+//!   `OpEmitMeshTasksEXT %gx %gy %gz [%payload]`.
+//! - `Stage::Mesh`: synthesizes `gl_MeshPerVertexEXT` (`Block` struct array),
+//!   `Primitive{Point,Line,Triangle}IndicesEXT`, per-vertex `Location` output arrays,
+//!   `PerPrimitiveEXT` per-primitive `Location` and built-in (`CullPrimitiveEXT`, `Layer`,
+//!   `ViewportIndex`, `PrimitiveId`) output arrays, and uniform `OpSetMeshOutputsEXT`.
+
+use super::*;
+use crate::meta::{MeshOutputKind, MeshStageMeta, MeshTopology};
+use crate::passes::stage_input::{
+    decorate_builtin, decorate_flat, decorate_location, decorate_with,
+};
+
+fn is_object_grid_setter(name: &str) -> bool {
+    name == "air.set_mesh_properties"
+        || name.starts_with("air.set_mesh_properties.")
+        || name == "air.set_threadgroups_per_grid"
+        || name.starts_with("air.set_threadgroups_per_grid.")
+        || name == "air.mesh_grid_properties.set_threadgroups_per_grid"
+        || name.starts_with("air.mesh_grid_properties.set_threadgroups_per_grid.")
+}
+
+fn is_mesh_count_setter(name: &str) -> bool {
+    name == "air.set_mesh_primitive_count"
+        || name.starts_with("air.set_mesh_primitive_count.")
+        || name == "air.mesh.set_primitive_count"
+        || name.starts_with("air.mesh.set_primitive_count.")
+        || name == "air.set_mesh_outputs"
+        || name.starts_with("air.set_mesh_outputs.")
+}
+
+fn is_mesh_output_setter(name: &str) -> bool {
+    crate::air_intrinsics::is_object_mesh_intrinsic(name)
+        && !is_object_grid_setter(name)
+        && !is_mesh_count_setter(name)
+}
+
+fn is_pointer_type(defs: &HashMap<Word, Instruction>, ty: Word) -> bool {
+    defs.get(&ty)
+        .is_some_and(|inst| inst.class.opcode == Op::TypePointer)
+}
+
+fn collect_defs_and_value_types(
+    ctx: &Ctx,
+    entry_idx: usize,
+) -> (HashMap<Word, Instruction>, HashMap<Word, Word>) {
+    let mut defs = HashMap::new();
+    let mut val_tys = HashMap::new();
+    for inst in ctx
+        .module
+        .types_global_values
+        .iter()
+        .chain(ctx.new_globals.iter())
+    {
+        if let Some(id) = inst.result_id {
+            defs.insert(id, inst.clone());
+            if let Some(ty) = inst.result_type {
+                val_tys.insert(id, ty);
+            }
+        }
+    }
+    if let Some(func) = ctx.module.functions.get(entry_idx) {
+        for p in &func.parameters {
+            if let (Some(id), Some(ty)) = (p.result_id, p.result_type) {
+                val_tys.insert(id, ty);
+            }
+        }
+        for blk in &func.blocks {
+            for inst in &blk.instructions {
+                if let (Some(id), Some(ty)) = (inst.result_id, inst.result_type) {
+                    val_tys.insert(id, ty);
+                }
+            }
+        }
+    }
+    (defs, val_tys)
+}
+
+fn coerce_to_uint(
+    ctx: &mut Ctx,
+    defs: &HashMap<Word, Instruction>,
+    val_tys: &HashMap<Word, Word>,
+    val: Word,
+    out: &mut Vec<Instruction>,
+) -> Word {
+    let uint_ty = ctx.ty_uint();
+    let Some(&ty) = val_tys.get(&val) else {
+        return val;
+    };
+    if ty == uint_ty {
+        return val;
+    }
+    if let Some(def) = defs.get(&ty) {
+        if def.class.opcode == Op::TypeInt {
+            let bits = match def.operands.first() {
+                Some(Operand::LiteralBit32(b)) => *b,
+                _ => 32,
+            };
+            let res = ctx.module.fresh_id();
+            let op = if bits == 32 { Op::Bitcast } else { Op::UConvert };
+            out.push(Instruction::new(
+                op,
+                Some(uint_ty),
+                Some(res),
+                vec![Operand::IdRef(val)],
+            ));
+            return res;
+        }
+        if def.class.opcode == Op::TypeBool {
+            let res = ctx.module.fresh_id();
+            let one = ctx.const_uint(1);
+            let zero = ctx.const_uint(0);
+            out.push(Instruction::new(
+                Op::Select,
+                Some(uint_ty),
+                Some(res),
+                vec![Operand::IdRef(val), Operand::IdRef(one), Operand::IdRef(zero)],
+            ));
+            return res;
+        }
+    }
+    val
+}
+
+fn coerce_to_sint(
+    ctx: &mut Ctx,
+    defs: &HashMap<Word, Instruction>,
+    val_tys: &HashMap<Word, Word>,
+    val: Word,
+    out: &mut Vec<Instruction>,
+) -> Word {
+    let sint_ty = ctx.ty_sint();
+    let Some(&ty) = val_tys.get(&val) else {
+        return val;
+    };
+    if ty == sint_ty {
+        return val;
+    }
+    if let Some(def) = defs.get(&ty) {
+        if def.class.opcode == Op::TypeInt {
+            let bits = match def.operands.first() {
+                Some(Operand::LiteralBit32(b)) => *b,
+                _ => 32,
+            };
+            let res = ctx.module.fresh_id();
+            let op = if bits == 32 { Op::Bitcast } else { Op::SConvert };
+            out.push(Instruction::new(
+                op,
+                Some(sint_ty),
+                Some(res),
+                vec![Operand::IdRef(val)],
+            ));
+            return res;
+        }
+    }
+    val
+}
+
+fn coerce_to_bool(
+    ctx: &mut Ctx,
+    defs: &HashMap<Word, Instruction>,
+    val_tys: &HashMap<Word, Word>,
+    val: Word,
+    out: &mut Vec<Instruction>,
+) -> Word {
+    let bool_ty = ctx.ty_bool();
+    let Some(&ty) = val_tys.get(&val) else {
+        return val;
+    };
+    if ty == bool_ty {
+        return val;
+    }
+    if defs
+        .get(&ty)
+        .is_some_and(|def| def.class.opcode == Op::TypeInt)
+    {
+        let zero = ctx.const_int_of(ty, 0);
+        let res = ctx.module.fresh_id();
+        out.push(Instruction::new(
+            Op::INotEqual,
+            Some(bool_ty),
+            Some(res),
+            vec![Operand::IdRef(val), Operand::IdRef(zero)],
+        ));
+        return res;
+    }
+    val
+}
+
+fn coerce_store_value(
+    ctx: &mut Ctx,
+    defs: &HashMap<Word, Instruction>,
+    val: Word,
+    src_ty: Word,
+    dst_ty: Word,
+    out: &mut Vec<Instruction>,
+) -> Word {
+    if src_ty == dst_ty {
+        return val;
+    }
+    let src_is_bool = defs
+        .get(&src_ty)
+        .is_some_and(|d| d.class.opcode == Op::TypeBool);
+    let dst_is_uint = dst_ty == ctx.ty_uint();
+    if src_is_bool && dst_is_uint {
+        let res = ctx.module.fresh_id();
+        let one = ctx.const_uint(1);
+        let zero = ctx.const_uint(0);
+        out.push(Instruction::new(
+            Op::Select,
+            Some(dst_ty),
+            Some(res),
+            vec![Operand::IdRef(val), Operand::IdRef(one), Operand::IdRef(zero)],
+        ));
+        return res;
+    }
+    let res = ctx.module.fresh_id();
+    out.push(Instruction::new(
+        Op::Bitcast,
+        Some(dst_ty),
+        Some(res),
+        vec![Operand::IdRef(val)],
+    ));
+    res
+}
+
+fn emit_workgroup_barrier(ctx: &mut Ctx, out: &mut Vec<Instruction>) {
+    let wg_scope = ctx.const_uint(Scope::Workgroup as u32);
+    let sem = ctx.const_uint(
+        (MemorySemantics::ACQUIRE_RELEASE | MemorySemantics::WORKGROUP_MEMORY).bits(),
+    );
+    out.push(Instruction::new(
+        Op::ControlBarrier,
+        None,
+        None,
+        vec![
+            Operand::IdScope(wg_scope),
+            Operand::IdScope(wg_scope),
+            Operand::IdMemorySemantics(sem),
+        ],
+    ));
+}
+
+fn extract_const_u32(defs: &HashMap<Word, Instruction>, id: Word) -> Option<u32> {
+    let def = defs.get(&id)?;
+    if def.class.opcode == Op::Constant {
+        match def.operands.first() {
+            Some(Operand::LiteralBit32(v)) => Some(*v),
+            _ => None,
+        }
+    } else if def.class.opcode == Op::ConstantNull {
+        Some(0)
+    } else {
+        None
+    }
+}
+
+fn strip_optional_handle_arg<'a>(
+    args: &'a [Word],
+    defs: &HashMap<Word, Instruction>,
+    val_tys: &HashMap<Word, Word>,
+) -> &'a [Word] {
+    if let Some(&first) = args.first() {
+        if val_tys
+            .get(&first)
+            .is_some_and(|&ty| is_pointer_type(defs, ty))
+        {
+            return &args[1..];
+        }
+    }
+    args
+}
+
+/// Entry point called from `passes::transform_with_options_and_sidecar` for `Stage::Object` and
+/// `Stage::Mesh`.
+pub(in crate::passes) fn lower_object_mesh_stage(
+    ctx: &mut Ctx,
+    entry_idx: usize,
+    stage: &Stage,
+    kern: Option<&KernMeta>,
+) -> Result<(), String> {
+    match stage {
+        Stage::Object => lower_object_stage(ctx, entry_idx),
+        Stage::Mesh => lower_mesh_stage(ctx, entry_idx, kern),
+        _ => Ok(()),
+    }
+}
+
+fn lower_object_stage(ctx: &mut Ctx, entry_idx: usize) -> Result<(), String> {
+    let names = air_names(&ctx.module);
+    let (defs, val_tys) = collect_defs_and_value_types(ctx, entry_idx);
+
+    let uint_ty = ctx.ty_uint();
+    let arr3_ty = ctx.ty_array(uint_ty, 3);
+    let wg_arr_ptr_ty = ctx.ty_ptr(StorageClass::Workgroup, arr3_ty);
+    let wg_u32_ptr_ty = ctx.ty_ptr(StorageClass::Workgroup, uint_ty);
+    let grid_var = ctx.module.fresh_id();
+    ctx.new_globals.push(Instruction::new(
+        Op::Variable,
+        Some(wg_arr_ptr_ty),
+        Some(grid_var),
+        vec![Operand::StorageClass(StorageClass::Workgroup)],
+    ));
+    ctx.interface_buffer_var(grid_var);
+    ctx.task_mesh_grid_var = Some(grid_var);
+
+    let c0 = ctx.const_uint(0);
+    let c1 = ctx.const_uint(1);
+    let c2 = ctx.const_uint(2);
+
+    for bi in 0..ctx.module.functions[entry_idx].blocks.len() {
+        let old = ctx.module.functions[entry_idx].blocks[bi]
+            .instructions
+            .clone();
+        let mut rewritten = Vec::with_capacity(old.len() + 8);
+        for inst in old {
+            if inst.class.opcode == Op::FunctionCall {
+                if let Some(Operand::IdRef(callee)) = inst.operands.first() {
+                    if let Some(name) = names.get(callee) {
+                        if is_object_grid_setter(name) {
+                            let raw_args: Vec<Word> = inst
+                                .operands
+                                .iter()
+                                .skip(1)
+                                .filter_map(|o| match o {
+                                    Operand::IdRef(id) => Some(*id),
+                                    _ => None,
+                                })
+                                .collect();
+                            let args = strip_optional_handle_arg(&raw_args, &defs, &val_tys);
+                            let (gx, gy, gz) = match args {
+                                [vec_id] => {
+                                    let vty = val_tys.get(vec_id).copied();
+                                    let vec_def = vty.and_then(|t| defs.get(&t));
+                                    if let Some(def) = vec_def.filter(|d| d.class.opcode == Op::TypeVector) {
+                                        let elem_ty = match def.operands.first() {
+                                            Some(Operand::IdRef(e)) => *e,
+                                            _ => uint_ty,
+                                        };
+                                        let lanes = match def.operands.get(1) {
+                                            Some(Operand::LiteralBit32(n)) => *n,
+                                            _ => 3,
+                                        };
+                                        let mut comps = [c1, c1, c1];
+                                        for lane in 0..lanes.min(3) {
+                                            let ex = ctx.module.fresh_id();
+                                            rewritten.push(Instruction::new(
+                                                Op::CompositeExtract,
+                                                Some(elem_ty),
+                                                Some(ex),
+                                                vec![
+                                                    Operand::IdRef(*vec_id),
+                                                    Operand::LiteralBit32(lane),
+                                                ],
+                                            ));
+                                            let mut tmp_tys = val_tys.clone();
+                                            tmp_tys.insert(ex, elem_ty);
+                                            comps[lane as usize] =
+                                                coerce_to_uint(ctx, &defs, &tmp_tys, ex, &mut rewritten);
+                                        }
+                                        (comps[0], comps[1], comps[2])
+                                    } else {
+                                        let x = coerce_to_uint(ctx, &defs, &val_tys, *vec_id, &mut rewritten);
+                                        (x, c1, c1)
+                                    }
+                                }
+                                [x, y] => {
+                                    let gx = coerce_to_uint(ctx, &defs, &val_tys, *x, &mut rewritten);
+                                    let gy = coerce_to_uint(ctx, &defs, &val_tys, *y, &mut rewritten);
+                                    (gx, gy, c1)
+                                }
+                                [x, y, z, ..] => {
+                                    let gx = coerce_to_uint(ctx, &defs, &val_tys, *x, &mut rewritten);
+                                    let gy = coerce_to_uint(ctx, &defs, &val_tys, *y, &mut rewritten);
+                                    let gz = coerce_to_uint(ctx, &defs, &val_tys, *z, &mut rewritten);
+                                    (gx, gy, gz)
+                                }
+                                [] => (c0, c0, c0),
+                            };
+                            for (idx_const, val) in [(c0, gx), (c1, gy), (c2, gz)] {
+                                let p = ctx.module.fresh_id();
+                                rewritten.push(Instruction::new(
+                                    Op::AccessChain,
+                                    Some(wg_u32_ptr_ty),
+                                    Some(p),
+                                    vec![Operand::IdRef(grid_var), Operand::IdRef(idx_const)],
+                                ));
+                                rewritten.push(Instruction::new(
+                                    Op::Store,
+                                    None,
+                                    None,
+                                    vec![Operand::IdRef(p), Operand::IdRef(val)],
+                                ));
+                            }
+                            continue;
+                        }
+                    }
+                }
+            }
+            if inst.class.opcode == Op::Return {
+                emit_workgroup_barrier(ctx, &mut rewritten);
+                let mut loaded = [c0; 3];
+                for (i, idx_const) in [c0, c1, c2].into_iter().enumerate() {
+                    let p = ctx.module.fresh_id();
+                    rewritten.push(Instruction::new(
+                        Op::AccessChain,
+                        Some(wg_u32_ptr_ty),
+                        Some(p),
+                        vec![Operand::IdRef(grid_var), Operand::IdRef(idx_const)],
+                    ));
+                    let v = ctx.module.fresh_id();
+                    rewritten.push(Instruction::new(
+                        Op::Load,
+                        Some(uint_ty),
+                        Some(v),
+                        vec![Operand::IdRef(p)],
+                    ));
+                    loaded[i] = v;
+                }
+                let mut ops = vec![
+                    Operand::IdRef(loaded[0]),
+                    Operand::IdRef(loaded[1]),
+                    Operand::IdRef(loaded[2]),
+                ];
+                if let Some(payload_var) = ctx.task_payload_var {
+                    ops.push(Operand::IdRef(payload_var));
+                }
+                rewritten.push(Instruction::new(Op::EmitMeshTasksEXT, None, None, ops));
+                continue;
+            }
+            rewritten.push(inst);
+        }
+        ctx.module.functions[entry_idx].blocks[bi].instructions = rewritten;
+    }
+    Ok(())
+}
+
+struct MeshOutputs {
+    topology: MeshTopology,
+    max_vertices: u32,
+    max_primitives: u32,
+    per_vertex_var: Word,
+    has_point_size: bool,
+    prim_indices_var: Word,
+    prim_indices_elem_ty: Word,
+    cull_var: Option<Word>,
+    layer_var: Option<Word>,
+    viewport_var: Option<Word>,
+    prim_id_var: Option<Word>,
+    vertex_loc_vars: HashMap<u32, (Word, Word)>,    // loc -> (var, elem_ty)
+    primitive_loc_vars: HashMap<u32, (Word, Word)>, // loc -> (var, elem_ty)
+}
+
+impl MeshOutputs {
+    fn new(ctx: &mut Ctx, meta: &MeshStageMeta, has_point_size: bool) -> Self {
+        let v4f = ctx.ty_vecf(4);
+        let float_ty = ctx.ty_float();
+        let uint_ty = ctx.ty_uint();
+
+        // `gl_MeshPerVertexEXT` Block struct array: `{ Position, [PointSize] }`.
+        let per_vert_struct = ctx.module.fresh_id();
+        let mut members = vec![Operand::IdRef(v4f)];
+        if has_point_size {
+            members.push(Operand::IdRef(float_ty));
+        }
+        ctx.new_globals
+            .push(type_inst(Op::TypeStruct, per_vert_struct, members));
+        ctx.module.annotations.push(Instruction::new(
+            Op::Decorate,
+            None,
+            None,
+            vec![
+                Operand::IdRef(per_vert_struct),
+                Operand::Decoration(Decoration::Block),
+            ],
+        ));
+        ctx.module.annotations.push(Instruction::new(
+            Op::MemberDecorate,
+            None,
+            None,
+            vec![
+                Operand::IdRef(per_vert_struct),
+                Operand::LiteralBit32(0),
+                Operand::Decoration(Decoration::BuiltIn),
+                Operand::BuiltIn(BuiltIn::Position),
+            ],
+        ));
+        if has_point_size {
+            ctx.module.annotations.push(Instruction::new(
+                Op::MemberDecorate,
+                None,
+                None,
+                vec![
+                    Operand::IdRef(per_vert_struct),
+                    Operand::LiteralBit32(1),
+                    Operand::Decoration(Decoration::BuiltIn),
+                    Operand::BuiltIn(BuiltIn::PointSize),
+                ],
+            ));
+        }
+        let per_vert_arr = ctx.ty_array(per_vert_struct, meta.max_vertices);
+        let per_vert_ptr = ctx.ty_ptr(StorageClass::Output, per_vert_arr);
+        let per_vertex_var = ctx.module.fresh_id();
+        ctx.new_globals.push(Instruction::new(
+            Op::Variable,
+            Some(per_vert_ptr),
+            Some(per_vertex_var),
+            vec![Operand::StorageClass(StorageClass::Output)],
+        ));
+        ctx.interface.push(per_vertex_var);
+
+        let (prim_indices_elem_ty, indices_builtin) = match meta.topology {
+            MeshTopology::Point => (uint_ty, BuiltIn::PrimitivePointIndicesEXT),
+            MeshTopology::Line => (ctx.ty_vec_uint(2), BuiltIn::PrimitiveLineIndicesEXT),
+            MeshTopology::Triangle => (ctx.ty_vec_uint(3), BuiltIn::PrimitiveTriangleIndicesEXT),
+        };
+        let indices_arr = ctx.ty_array(prim_indices_elem_ty, meta.max_primitives);
+        let indices_ptr = ctx.ty_ptr(StorageClass::Output, indices_arr);
+        let prim_indices_var = ctx.module.fresh_id();
+        ctx.new_globals.push(Instruction::new(
+            Op::Variable,
+            Some(indices_ptr),
+            Some(prim_indices_var),
+            vec![Operand::StorageClass(StorageClass::Output)],
+        ));
+        decorate_builtin(&mut ctx.module, prim_indices_var, indices_builtin);
+        ctx.interface.push(prim_indices_var);
+
+        Self {
+            topology: meta.topology,
+            max_vertices: meta.max_vertices,
+            max_primitives: meta.max_primitives,
+            per_vertex_var,
+            has_point_size,
+            prim_indices_var,
+            prim_indices_elem_ty,
+            cull_var: None,
+            layer_var: None,
+            viewport_var: None,
+            prim_id_var: None,
+            vertex_loc_vars: HashMap::new(),
+            primitive_loc_vars: HashMap::new(),
+        }
+    }
+
+    fn ensure_cull_var(&mut self, ctx: &mut Ctx) -> Word {
+        if let Some(v) = self.cull_var {
+            return v;
+        }
+        let bool_ty = ctx.ty_bool();
+        let arr_ty = ctx.ty_array(bool_ty, self.max_primitives);
+        let ptr_ty = ctx.ty_ptr(StorageClass::Output, arr_ty);
+        let var = ctx.module.fresh_id();
+        ctx.new_globals.push(Instruction::new(
+            Op::Variable,
+            Some(ptr_ty),
+            Some(var),
+            vec![Operand::StorageClass(StorageClass::Output)],
+        ));
+        decorate_with(&mut ctx.module, var, Decoration::PerPrimitiveEXT);
+        decorate_builtin(&mut ctx.module, var, BuiltIn::CullPrimitiveEXT);
+        ctx.interface.push(var);
+        self.cull_var = Some(var);
+        var
+    }
+
+    fn ensure_layer_var(&mut self, ctx: &mut Ctx) -> Word {
+        if let Some(v) = self.layer_var {
+            return v;
+        }
+        let sint_ty = ctx.ty_sint();
+        let arr_ty = ctx.ty_array(sint_ty, self.max_primitives);
+        let ptr_ty = ctx.ty_ptr(StorageClass::Output, arr_ty);
+        let var = ctx.module.fresh_id();
+        ctx.new_globals.push(Instruction::new(
+            Op::Variable,
+            Some(ptr_ty),
+            Some(var),
+            vec![Operand::StorageClass(StorageClass::Output)],
+        ));
+        decorate_with(&mut ctx.module, var, Decoration::PerPrimitiveEXT);
+        decorate_builtin(&mut ctx.module, var, BuiltIn::Layer);
+        ctx.interface.push(var);
+        self.layer_var = Some(var);
+        var
+    }
+
+    fn ensure_viewport_var(&mut self, ctx: &mut Ctx) -> Word {
+        if let Some(v) = self.viewport_var {
+            return v;
+        }
+        let sint_ty = ctx.ty_sint();
+        let arr_ty = ctx.ty_array(sint_ty, self.max_primitives);
+        let ptr_ty = ctx.ty_ptr(StorageClass::Output, arr_ty);
+        let var = ctx.module.fresh_id();
+        ctx.new_globals.push(Instruction::new(
+            Op::Variable,
+            Some(ptr_ty),
+            Some(var),
+            vec![Operand::StorageClass(StorageClass::Output)],
+        ));
+        decorate_with(&mut ctx.module, var, Decoration::PerPrimitiveEXT);
+        decorate_builtin(&mut ctx.module, var, BuiltIn::ViewportIndex);
+        ctx.interface.push(var);
+        self.viewport_var = Some(var);
+        var
+    }
+
+    fn ensure_prim_id_var(&mut self, ctx: &mut Ctx) -> Word {
+        if let Some(v) = self.prim_id_var {
+            return v;
+        }
+        let uint_ty = ctx.ty_uint();
+        let arr_ty = ctx.ty_array(uint_ty, self.max_primitives);
+        let ptr_ty = ctx.ty_ptr(StorageClass::Output, arr_ty);
+        let var = ctx.module.fresh_id();
+        ctx.new_globals.push(Instruction::new(
+            Op::Variable,
+            Some(ptr_ty),
+            Some(var),
+            vec![Operand::StorageClass(StorageClass::Output)],
+        ));
+        decorate_with(&mut ctx.module, var, Decoration::PerPrimitiveEXT);
+        decorate_builtin(&mut ctx.module, var, BuiltIn::PrimitiveId);
+        ctx.interface.push(var);
+        self.prim_id_var = Some(var);
+        var
