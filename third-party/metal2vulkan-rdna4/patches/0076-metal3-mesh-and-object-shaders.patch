+/// Parse `mesh<VertexOut, PrimOut, MaxV, MaxP, topology::triangle>` parameter type names.
+fn parse_mesh_type_name(name: &str) -> (Option<u32>, Option<u32>, Option<MeshTopology>) {
+    let Some(start) = name.find('<') else {
+        return (None, None, None);
+    };
+    let Some(end) = name.rfind('>') else {
+        return (None, None, None);
+    };
+    let inner = &name[start + 1..end];
+    let parts = split_top_level_commas(inner);
+    let mut nums = Vec::new();
+    let mut topo = None;
+    for part in parts {
+        let p = part.trim();
+        if let Ok(v) = p.parse::<u32>() {
+            nums.push(v);
+        } else if let Some(t) = parse_mesh_topology_str(p) {
+            topo = Some(t);
+        }
+    }
+    (nums.first().copied(), nums.get(1).copied(), topo)
+}
