+    #[test]
+    fn object_stage_16kib_payload_and_emit_mesh_tasks() {
+        let ll = r#"
+%struct.Payload = type { <4 x float>, [4092 x i32] }
+
+define void @obj_main(ptr addrspace(6) %payload, ptr addrspace(1) %mgp, i32 %tid) {
+entry:
+  %is0 = icmp eq i32 %tid, 0
+  br i1 %is0, label %do_emit, label %done
+
+do_emit:
+  %p0 = getelementptr inbounds %struct.Payload, ptr addrspace(6) %payload, i32 0, i32 0
+  store <4 x float> <float 0.25, float -0.25, float 0.0, float 1.0>, ptr addrspace(6) %p0
+  %p_last = getelementptr inbounds %struct.Payload, ptr addrspace(6) %payload, i32 0, i32 1, i32 4091
+  store i32 42, ptr addrspace(6) %p_last
+  call void @air.set_mesh_properties(ptr addrspace(1) %mgp, <3 x i32> <i32 2, i32 1, i32 1>)
+  br label %done
+
+done:
+  ret void
+}
+
+declare void @air.set_mesh_properties(ptr addrspace(1), <3 x i32>)
+
+!air.object = !{!0}
+!0 = !{ptr @obj_main, !1, !2, !6}
+!1 = !{}
+!2 = !{!3, !4, !5}
+!3 = !{i32 0, !"air.payload", !"air.arg_type_size", i32 16384, !"air.arg_type_name", !"Payload"}
+!4 = !{i32 1, !"air.mesh_grid_properties"}
+!5 = !{i32 2, !"air.thread_index_in_threadgroup"}
+!6 = !{!"air.max_total_threadgroups_per_mesh_grid", i32 64}
+"#;
+        let (module, refl) = translate_unvalidated(ll, Stage::Object, [32, 1, 1]);
+        assert!(has_capability(&module, Capability::MeshShadingEXT));
+        assert!(has_extension(&module, "SPV_EXT_mesh_shader"));
+        assert!(module
+            .entry_points
+            .iter()
+            .any(|e| e.operands.first() == Some(&Operand::ExecutionModel(ExecutionModel::TaskEXT))));
+        assert!(has_exec_mode(&module, ExecutionMode::LocalSize, Some(32)));
+        let payload_var = module
+            .types_global_values
+            .iter()
+            .find(|i| {
+                i.class.opcode == Op::Variable
+                    && i.operands.first()
+                        == Some(&Operand::StorageClass(StorageClass::TaskPayloadWorkgroupEXT))
+            })
+            .expect("TaskPayloadWorkgroupEXT variable");
+        let emit_inst = module
+            .all_inst_iter()
+            .find(|i| i.class.opcode == Op::EmitMeshTasksEXT)
+            .expect("OpEmitMeshTasksEXT terminator");
+        assert_eq!(
+            emit_inst.operands.get(3),
+            Some(&Operand::IdRef(payload_var.result_id.unwrap())),
