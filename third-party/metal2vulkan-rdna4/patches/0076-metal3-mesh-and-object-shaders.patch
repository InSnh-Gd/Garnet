+
+    fn ensure_vertex_loc_var(
+        &mut self,
+        ctx: &mut Ctx,
+        defs: &HashMap<Word, Instruction>,
+        loc: u32,
+        src_ty: Word,
+        meta: &MeshStageMeta,
+    ) -> (Word, Word) {
+        if let Some(&entry) = self.vertex_loc_vars.get(&loc) {
+            return entry;
+        }
+        let elem_ty = if defs
+            .get(&src_ty)
+            .is_some_and(|d| d.class.opcode == Op::TypeBool)
+        {
+            ctx.ty_uint()
+        } else {
+            src_ty
+        };
+        let arr_ty = ctx.ty_array(elem_ty, self.max_vertices);
+        let ptr_ty = ctx.ty_ptr(StorageClass::Output, arr_ty);
+        let var = ctx.module.fresh_id();
+        ctx.new_globals.push(Instruction::new(
+            Op::Variable,
+            Some(ptr_ty),
+            Some(var),
+            vec![Operand::StorageClass(StorageClass::Output)],
+        ));
+        decorate_location(&mut ctx.module, var, loc);
+        if let Some(member) = meta
+            .vertex_outputs
+            .iter()
+            .find(|m| m.kind == MeshOutputKind::VertexVarying(loc))
+        {
+            if member.interpolation.flat {
+                decorate_flat(&mut ctx.module, var);
+            }
+            if member.interpolation.no_perspective {
+                decorate_with(&mut ctx.module, var, Decoration::NoPerspective);
+            }
+        }
+        ctx.interface.push(var);
+        self.vertex_loc_vars.insert(loc, (var, elem_ty));
+        (var, elem_ty)
+    }
+
+    fn ensure_primitive_loc_var(
+        &mut self,
+        ctx: &mut Ctx,
+        defs: &HashMap<Word, Instruction>,
+        loc: u32,
+        src_ty: Word,
+    ) -> (Word, Word) {
+        if let Some(&entry) = self.primitive_loc_vars.get(&loc) {
+            return entry;
+        }
+        let elem_ty = if defs
+            .get(&src_ty)
+            .is_some_and(|d| d.class.opcode == Op::TypeBool)
+        {
+            ctx.ty_uint()
+        } else {
+            src_ty
+        };
+        let arr_ty = ctx.ty_array(elem_ty, self.max_primitives);
+        let ptr_ty = ctx.ty_ptr(StorageClass::Output, arr_ty);
+        let var = ctx.module.fresh_id();
+        ctx.new_globals.push(Instruction::new(
+            Op::Variable,
+            Some(ptr_ty),
+            Some(var),
+            vec![Operand::StorageClass(StorageClass::Output)],
+        ));
+        decorate_with(&mut ctx.module, var, Decoration::PerPrimitiveEXT);
+        decorate_location(&mut ctx.module, var, loc);
+        ctx.interface.push(var);
+        self.primitive_loc_vars.insert(loc, (var, elem_ty));
+        (var, elem_ty)
+    }
+
+    fn store_position(
+        &self,
+        ctx: &mut Ctx,
+        vidx: Word,
+        pos_val: Word,
+        out: &mut Vec<Instruction>,
+    ) {
+        let v4f = ctx.ty_vecf(4);
+        let ptr_ty = ctx.ty_ptr(StorageClass::Output, v4f);
+        let c0 = ctx.const_uint(0);
+        let p = ctx.module.fresh_id();
+        out.push(Instruction::new(
+            Op::AccessChain,
+            Some(ptr_ty),
+            Some(p),
+            vec![
+                Operand::IdRef(self.per_vertex_var),
+                Operand::IdRef(vidx),
+                Operand::IdRef(c0),
+            ],
+        ));
+        out.push(Instruction::new(
+            Op::Store,
+            None,
+            None,
+            vec![Operand::IdRef(p), Operand::IdRef(pos_val)],
+        ));
+    }
+
+    fn store_point_size(
+        &self,
+        ctx: &mut Ctx,
+        vidx: Word,
+        psize_val: Word,
+        out: &mut Vec<Instruction>,
+    ) {
+        if !self.has_point_size {
+            return;
+        }
+        let float_ty = ctx.ty_float();
+        let ptr_ty = ctx.ty_ptr(StorageClass::Output, float_ty);
+        let c1 = ctx.const_uint(1);
+        let p = ctx.module.fresh_id();
+        out.push(Instruction::new(
+            Op::AccessChain,
+            Some(ptr_ty),
+            Some(p),
+            vec![
+                Operand::IdRef(self.per_vertex_var),
+                Operand::IdRef(vidx),
+                Operand::IdRef(c1),
+            ],
+        ));
+        out.push(Instruction::new(
+            Op::Store,
+            None,
+            None,
+            vec![Operand::IdRef(p), Operand::IdRef(psize_val)],
+        ));
+    }
+
+    fn store_flat_index(
+        &self,
+        ctx: &mut Ctx,
+        flat_idx: Word,
+        vidx: Word,
+        out: &mut Vec<Instruction>,
+    ) {
+        let uint_ty = ctx.ty_uint();
+        let out_u32_ptr = ctx.ty_ptr(StorageClass::Output, uint_ty);
+        match self.topology {
+            MeshTopology::Point => {
+                let p = ctx.module.fresh_id();
+                out.push(Instruction::new(
+                    Op::AccessChain,
+                    Some(out_u32_ptr),
+                    Some(p),
+                    vec![Operand::IdRef(self.prim_indices_var), Operand::IdRef(flat_idx)],
+                ));
+                out.push(Instruction::new(
+                    Op::Store,
+                    None,
+                    None,
+                    vec![Operand::IdRef(p), Operand::IdRef(vidx)],
+                ));
+            }
+            MeshTopology::Line | MeshTopology::Triangle => {
+                let stride = ctx.const_uint(self.topology.vertices_per_primitive());
+                let prim_idx = ctx.module.fresh_id();
+                out.push(Instruction::new(
+                    Op::UDiv,
+                    Some(uint_ty),
+                    Some(prim_idx),
+                    vec![Operand::IdRef(flat_idx), Operand::IdRef(stride)],
+                ));
+                let corner = ctx.module.fresh_id();
+                out.push(Instruction::new(
+                    Op::UMod,
+                    Some(uint_ty),
+                    Some(corner),
+                    vec![Operand::IdRef(flat_idx), Operand::IdRef(stride)],
+                ));
+                let p = ctx.module.fresh_id();
+                out.push(Instruction::new(
+                    Op::AccessChain,
+                    Some(out_u32_ptr),
+                    Some(p),
+                    vec![
+                        Operand::IdRef(self.prim_indices_var),
+                        Operand::IdRef(prim_idx),
+                        Operand::IdRef(corner),
+                    ],
+                ));
+                out.push(Instruction::new(
+                    Op::Store,
+                    None,
+                    None,
+                    vec![Operand::IdRef(p), Operand::IdRef(vidx)],
+                ));
+            }
+        }
+    }
+}
