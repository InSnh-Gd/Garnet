+    use std::path::Path;
+
+    fn translate_unvalidated(
+        ll: &str,
+        stage: Stage,
+        local_size: [u32; 3],
+    ) -> (crate::spirv_module::Module, crate::reflect::ShaderReflection) {
+        let mut opts = TransformOptions::default();
+        opts.kernel_local_size = local_size;
+        let (bytes, refl) = crate::translate_sanitized_native_reflected_unvalidated(
+            ll,
+            stage,
+            Path::new(""),
+            opts,
+            None,
+        )
+        .expect("translate mesh/object shader");
+        let module = load_bytes(&bytes).expect("parse emitted SPIR-V");
+        (module, refl)
+    }
+
+    fn has_capability(m: &crate::spirv_module::Module, cap: Capability) -> bool {
+        m.capabilities
+            .iter()
+            .any(|i| i.operands.first() == Some(&Operand::Capability(cap)))
+    }
+
+    fn has_extension(m: &crate::spirv_module::Module, ext: &str) -> bool {
+        m.extensions
+            .iter()
+            .any(|i| i.operands.first() == Some(&Operand::LiteralString(ext.to_string())))
+    }
+
+    fn has_exec_mode(m: &crate::spirv_module::Module, mode: ExecutionMode, lit: Option<u32>) -> bool {
+        m.execution_modes.iter().any(|i| {
+            i.operands.get(1) == Some(&Operand::ExecutionMode(mode))
+                && lit.map_or(true, |v| i.operands.get(2) == Some(&Operand::LiteralBit32(v)))
+        })
+    }
+
+    fn has_builtin(m: &crate::spirv_module::Module, b: BuiltIn) -> bool {
+        m.annotations.iter().any(|i| match i.class.opcode {
+            Op::Decorate => {
+                i.operands.get(1) == Some(&Operand::Decoration(Decoration::BuiltIn))
+                    && i.operands.get(2) == Some(&Operand::BuiltIn(b))
+            }
+            Op::MemberDecorate => {
+                i.operands.get(2) == Some(&Operand::Decoration(Decoration::BuiltIn))
+                    && i.operands.get(3) == Some(&Operand::BuiltIn(b))
+            }
+            _ => false,
+        })
+    }
+
+    fn assert_no_output_loads(m: &crate::spirv_module::Module) {
+        let mut ptr_sc = std::collections::HashMap::new();
+        for inst in &m.types_global_values {
+            if inst.class.opcode == Op::TypePointer {
+                if let (Some(id), Some(Operand::StorageClass(sc))) =
+                    (inst.result_id, inst.operands.first())
+                {
+                    ptr_sc.insert(id, *sc);
+                }
+            }
+        }
+        let mut val_sc = std::collections::HashMap::new();
+        for inst in m.all_inst_iter() {
+            if let (Some(id), Some(rty)) = (inst.result_id, inst.result_type) {
+                if let Some(&sc) = ptr_sc.get(&rty) {
+                    val_sc.insert(id, sc);
+                }
+            }
+        }
+        for inst in m.all_inst_iter() {
+            if inst.class.opcode == Op::Load {
+                if let Some(Operand::IdRef(ptr)) = inst.operands.first() {
+                    assert_ne!(
+                        val_sc.get(ptr),
+                        Some(&StorageClass::Output),
+                        "MeshEXT Output variables are write-only; found illegal OpLoad on {ptr}"
+                    );
+                }
+            }
+        }
+    }
