+                let eff_lanes = if *lanes == 3 { 4 } else { *lanes };
+                scalar.byte_size().saturating_mul(eff_lanes)
+            }
+            Self::PackedVec { scalar, lanes } => scalar.byte_size().saturating_mul(*lanes),
+            Self::Array { elem, len } => elem.byte_size().saturating_mul(*len),
+            Self::Matrix { scalar, cols, rows } => {
+                let col_lanes = if *rows == 3 { 4 } else { *rows };
+                scalar
+                    .byte_size()
+                    .saturating_mul(col_lanes)
+                    .saturating_mul(*cols)
+            }
+            Self::Struct(members) => members
+                .iter()
+                .map(|m| m.offset.saturating_add(m.ty.byte_size()))
+                .max()
+                .unwrap_or(0),
+            Self::Opaque { size } => *size,
+        }
+    }
+}
+
+impl AirScalar {
+    pub fn byte_size(self) -> u32 {
+        match self {
+            Self::Float | Self::UInt | Self::SInt => 4,
+            Self::Half | Self::UShort | Self::SShort => 2,
+            Self::ULong | Self::SLong => 8,
+            Self::UChar | Self::Bool => 1,
+        }
+    }
+}
