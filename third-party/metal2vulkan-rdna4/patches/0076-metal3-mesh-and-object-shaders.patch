+fn parse_mesh_topology_str(s: &str) -> Option<MeshTopology> {
+    let lower = s.trim().to_ascii_lowercase();
+    let lower = lower.strip_prefix("topology::").unwrap_or(&lower);
+    let lower = lower.strip_prefix("metal::topology::").unwrap_or(lower);
+    match lower {
+        "point" | "points" => Some(MeshTopology::Point),
+        "line" | "lines" => Some(MeshTopology::Line),
+        "triangle" | "triangles" => Some(MeshTopology::Triangle),
+        _ => None,
+    }
+}
