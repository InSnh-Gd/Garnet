diff --git a/tests/depth_null_predicates.rs b/tests/depth_null_predicates.rs
new file mode 100644
--- /dev/null
+++ b/tests/depth_null_predicates.rs
@@ -0,0 +1,84 @@
+use metal2vulkan::passes::{Stage, TransformOptions};
+
+#[test]
+fn direct_and_dynamic_depth_null_predicates_share_texture_lowering() {
+    for shape in ["2d", "2d_array", "2d_ms", "cube", "cube_array"] {
+        for indirect in [false, true] {
+            let args = if indirect {
+                "ptr addrspace(2) %args"
+            } else {
+                "ptr addrspace(1) %image"
+            };
+            let load = if indirect {
+                "  %slot = getelementptr %Root, ptr addrspace(2) %args, i64 0, i32 0, i32 %choose\n  %bits = load i64, ptr addrspace(2) %slot, align 8\n  %image = inttoptr i64 %bits to ptr addrspace(1)\n"
+            } else {
+                ""
+            };
+            let binding = if indirect {
+                "!3 = !{i32 0, !\"air.indirect_buffer\", !\"air.location_index\", i32 3, i32 1, !\"air.read\", !\"air.address_space\", i32 2, !\"air.arg_type_name\", !\"Root\"}".to_owned()
+            } else {
+                format!("!3 = !{{i32 0, !\"air.texture\", !\"air.location_index\", i32 0, i32 1, !\"air.read\", !\"air.arg_type_name\", !\"depth{shape}<float>\"}}")
+            };
+            let source = format!(
+                r#"target triple = "air64-apple-macosx"
+%Root = type {{ [2 x ptr addrspace(1)] }}
+define void @entry({args}, ptr addrspace(1) %out, i32 %choose) {{
+entry:
+{load}  %missing = call i1 @air.is_null_depth_{shape}(ptr addrspace(1) %image)
+  %word = zext i1 %missing to i32
+  store i32 %word, ptr addrspace(1) %out
+  ret void
+}}
+declare i1 @air.is_null_depth_{shape}(ptr addrspace(1))
+!air.kernel = !{{!0}}
+!0 = !{{ptr @entry, !1, !2}}
+!1 = !{{}}
+!2 = !{{!3, !4, !5}}
+{binding}
+!4 = !{{i32 1, !"air.buffer", !"air.location_index", i32 0, i32 1, !"air.read_write", !"air.address_space", i32 1, !"air.arg_type_name", !"uint"}}
+!5 = !{{i32 2, !"air.thread_position_in_grid", !"air.arg_type_name", !"uint"}}
+"#
+            );
+            let (spv, reflection) = metal2vulkan::translate_sanitized_native_reflected_unvalidated(
+                &source,
+                Stage::Kernel,
+                &std::env::temp_dir(),
+                TransformOptions::default(),
+                None,
+            )
+            .unwrap_or_else(|error| panic!("shape={shape} indirect={indirect}: {error}"));
+            reflection.validate_descriptor_abi().unwrap();
+            let dir = std::env::temp_dir().join(format!(
+                "depth-null-{}-{shape}-{indirect}",
+                std::process::id()
+            ));
+            std::fs::create_dir_all(&dir).unwrap();
+            let path = dir.join("shader.spv");
+            std::fs::write(&path, spv).unwrap();
+            let output = std::process::Command::new("spirv-val")
+                .args(["--target-env", "vulkan1.2"])
+                .arg(&path)
+                .output()
+                .unwrap();
+            assert!(
+                output.status.success(),
+                "{}",
+                String::from_utf8_lossy(&output.stderr)
+            );
+            let dis = std::process::Command::new("spirv-dis")
+                .arg(&path)
+                .output()
+                .unwrap();
+            let dis = String::from_utf8(dis.stdout).unwrap();
+            assert!(!dis.contains("air.is_null_depth"), "{dis}");
+            assert!(
+                !dis.contains("OpImageRead") && !dis.contains("OpImageFetch"),
+                "{dis}"
+            );
+            if indirect {
+                assert!(dis.contains("OpIEqual"), "{dis}");
+            }
+            std::fs::remove_dir_all(dir).unwrap();
+        }
+    }
+}
