+// SPDX-License-Identifier: LGPL-3.0-or-later
+//! Materializes constant-indexed loads from direct `array<sampler, N>` entry parameters.
+//!
+//! Direct Metal sampler arrays arrive in AIR as `byval([N x ptr addrspace(2)])` parameters, where
+//! each slot maps to an independent `OpTypeSampler` `UniformConstant` descriptor at consecutive
+//! bindings starting from the parameter's base Metal sampler index.
+//!
+//! The native emitter records fixed-index element loads from these parameters in
+//! `emit_sidecar.local_pointer_field_loads`. This pass replaces each valid in-bounds constant
+//! element load with an `OpLoad` from the corresponding descriptor variable, attaches any runtime
+//! sampler specialization / coordinate-flag provenance for that slot, and retires now-dead pointer
+//! projections rooted at the sampler-array parameter.
+
+use std::collections::{HashMap, HashSet};
+
+use spirv::{Op, Word};
+
+use crate::passes::SamplerCoordinateSource;
+use crate::reflect::RuntimeSamplerState;
+use crate::spirv_module::{Instruction, Operand};
+
+use super::super::Ctx;
+use super::retire_dead_pointer_projections;
+
+/// Decode a constant element slot from a recorded GEP path on `[N x ptr addrspace(2)]`.
+fn constant_sampler_slot(indices: &[u32]) -> Option<u32> {
+    match indices {
+        &[slot] | &[slot, 0] => Some(slot),
+        _ => None,
+    }
+}
+
+/// Resolve each eligible local pointer-field load rooted at a direct sampler array into
+/// `(descriptor_var, metal_sampler_index)`.
+fn collect_sampler_slot_rewrites(ctx: &Ctx) -> HashMap<Word, (Word, u32)> {
+    let mut resolved = HashMap::new();
+    for load_fact in &ctx.emit_sidecar.local_pointer_field_loads {
+        let Some((base_metal_index, slot_vars)) = ctx.sampler_array_vars.get(&load_fact.root)
+        else {
+            continue;
+        };
+        let Some(slot_idx) = constant_sampler_slot(&load_fact.indices) else {
+            continue;
+        };
+        if let Some(&slot_var) = slot_vars.get(slot_idx as usize) {
+            resolved.insert(load_fact.id, (slot_var, base_metal_index + slot_idx));
+        }
+    }
+    resolved
+}
+
+pub(crate) fn materialize_sampler_array_loads(ctx: &mut Ctx, entry_idx: usize) {
+    if ctx.sampler_array_vars.is_empty() {
+        return;
+    }
+
+    let mut slot_rewrites = collect_sampler_slot_rewrites(ctx);
+    if slot_rewrites.is_empty() {
+        return;
+    }
+
+    let sampler_ty = ctx.ty_sampler();
+    let materialized_ids: HashSet<Word> = slot_rewrites.keys().copied().collect();
+
+    for (&result_id, &(_, metal_slot)) in &slot_rewrites {
+        if let Some(runtime_state) = ctx
+            .runtime_sampler_states
+            .get(metal_slot as usize)
+            .copied()
+            .flatten()
+        {
+            ctx.sampler_states
+                .insert(result_id, RuntimeSamplerState::lowering_state(runtime_state));
+            ctx.specialized_runtime_sampler_values.insert(result_id);
+        }
+        if ctx.normalized_sampler_coordinates {
+            ctx.sampler_coordinate_sources
+                .insert(result_id, SamplerCoordinateSource::RuntimeWord(metal_slot));
+        }
+    }
+
+    let entry_fn = &mut ctx.module.functions[entry_idx];
+    for block in &mut entry_fn.blocks {
+        for inst in &mut block.instructions {
+            let Some(result_id) = inst.result_id else {
+                continue;
+            };
+            if let Some((slot_var, _)) = slot_rewrites.remove(&result_id) {
+                *inst = Instruction::new(
+                    Op::Load,
+                    Some(sampler_ty),
+                    Some(result_id),
+                    vec![Operand::IdRef(slot_var)],
+                );
+            }
+        }
+    }
+
+    ctx.emit_sidecar
+        .local_pointer_field_loads
+        .retain(|fact| !materialized_ids.contains(&fact.id));
+
+    let array_roots: Vec<Word> = ctx.sampler_array_vars.keys().copied().collect();
+    retire_dead_pointer_projections(ctx, entry_idx, array_roots);
+}
