+fn push_direct_sampler_bindings(
+    bindings: &mut Vec<ResourceBinding>,
+    base_slot: u32,
+    param_index: u32,
+    count: u32,
+) {
+    let fits = count > 0
+        && base_slot
+            .checked_add(count)
+            .is_some_and(|end| end <= SAMPLER_ARGUMENT_COUNT);
+    if !fits {
+        let mut rejected = sampler_binding(base_slot, Some(param_index));
+        rejected.descriptor = None;
+        bindings.push(rejected);
+        return;
+    }
+    for offset in 0..count {
+        bindings.push(sampler_binding(base_slot + offset, Some(param_index)));
+    }
+}
