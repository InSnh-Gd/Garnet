+        // Sorted deterministically by symbol name: op_add=1, op_mul=2, shade_blue=3, shade_red=4
+        assert_eq!(info.handles[0].handle_id, 1);
+        assert_eq!(info.handles[0].symbol, "op_add");
+        assert_eq!(info.handles[1].handle_id, 2);
+        assert_eq!(info.handles[1].symbol, "op_mul");
+        assert!(!comp_spec.contains("unreachable"), "must have safe default:\n{comp_spec}");
+        assert!(comp_spec.contains("i32 1, label %case_1"), "{comp_spec}");
+        assert!(comp_spec.contains("i32 2, label %case_2"), "{comp_spec}");
+        assert!(!comp_spec.contains("label %case_3"), "incompatible signature must be excluded:\n{comp_spec}");
+
+        let (comp_spv, comp_refl) = crate::translate_sanitized_native_reflected_unvalidated(
+            &comp_spec,
