+            output = stripped_output;
+            output.push('\n');
+            append_dependency_module(&mut output, &trimmed_dep)?;
+        }
+    }
+
+    let info = RuntimeVisibleFunctionTableInfo {
+        abi_version: 1,
+        header_words: 1,
+        tables,
+        handles: handle_info,
+    };
+    Ok((output, Some(info)))
+}
