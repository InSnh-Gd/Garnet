+fn normalized_function_blocks(module_ll: &str) -> HashMap<String, String> {
+    let mut blocks = HashMap::new();
+    let mut current: Option<(String, Vec<String>)> = None;
+    for line in module_ll.lines() {
+        let trimmed = line.trim();
+        if current.is_none() {
+            if let Some(global) = definition_global(trimmed) {
+                if trimmed.ends_with('}') {
+                    blocks.insert(global, trimmed.to_string());
+                } else {
+                    current = Some((global, vec![trimmed.to_string()]));
+                }
+            }
+            continue;
+        }
+        if let Some((global, mut lines)) = current.take() {
+            if !trimmed.is_empty() {
+                lines.push(trimmed.to_string());
+            }
+            if trimmed == "}" {
+                blocks.insert(global, lines.join("\n"));
+            } else {
+                current = Some((global, lines));
+            }
+        }
+    }
+    blocks
+}
+
+fn strip_matching_defined_functions(
+    output_ll: &str,
+    dependency_ll: &str,
+) -> Result<String, String> {
+    let existing = normalized_function_blocks(output_ll);
+    let dep_blocks = normalized_function_blocks(dependency_ll);
+    let mut skip_globals = HashSet::<String>::new();
+    for (global, dep_body) in &dep_blocks {
+        let header = dep_body.lines().next().unwrap_or("");
+        let at = header.find(global.as_str()).unwrap_or(0);
+        let is_local = header[..at]
+            .split_whitespace()
+            .any(|tok| matches!(tok, "internal" | "private"));
+        if is_local {
+            continue;
+        }
+        if let Some(existing_body) = existing.get(global) {
+            if existing_body != dep_body {
+                return Err(format!(
+                    "runtime visible function {global} conflicts with existing definition in entry module"
+                ));
+            }
+            skip_globals.insert(global.clone());
+        }
+    }
+    if skip_globals.is_empty() {
+        return Ok(dependency_ll.to_string());
+    }
+    let mut filtered = String::with_capacity(dependency_ll.len());
+    let mut skipping = false;
+    for line in dependency_ll.lines() {
+        let trimmed = line.trim();
+        if !skipping {
+            if let Some(global) = definition_global(trimmed) {
+                if skip_globals.contains(&global) {
+                    if !trimmed.ends_with('}') {
+                        skipping = true;
+                    }
+                    continue;
+                }
+            }
+            filtered.push_str(line);
+            filtered.push('\n');
+        } else if trimmed == "}" {
+            skipping = false;
+        }
+    }
+    Ok(filtered)
+}
