+    #[test]
+    fn runtime_vft_rejects_unmatched_indirect_call_signature() {
+        let entry = r#"
+define void @main(ptr addrspace(1) %out, ptr addrspace(1) %table) {
+entry:
+  %fp = call ptr @air.get_function_pointer_visible_function_table(ptr addrspace(1) %table, i32 0)
+  %v = call i32 %fp(i32 1, i32 2)
+  store i32 %v, ptr addrspace(1) %out, align 4
+  ret void
+}
+declare ptr @air.get_function_pointer_visible_function_table(ptr addrspace(1), i32)
+!air.kernel = !{!0}
+!0 = !{ptr @main, !1, !2}
+!1 = !{}
+!2 = !{!3, !4}
+!3 = !{i32 0, !"air.buffer", !"air.location_index", i32 0, i32 1, !"air.write", !"air.arg_type_name", !"uint"}
+!4 = !{i32 1, !"air.visible_function_table", !"air.location_index", i32 1, i32 1, !"air.read", !"air.arg_type_name", !"visible_function_table"}
+"#;
+        let linkage = LinkedFunctionLinkage {
+            runtime_visible_functions: vec![LinkedFunctionReference {
+                symbol: "only_float".into(),
+                module_ll: "define float @only_float(float %x) {\n  ret float %x\n}\n".into(),
+            }],
+            ..Default::default()
+        };
+        let err = crate::specialize_linked_module_with_vft(
+            entry,
+            crate::passes::Stage::Kernel,
+            &linkage,
+        )
+        .unwrap_err();
+        assert!(err.contains("no matching linked visible function"), "{err}");
+    }
+
+    #[test]
+    fn runtime_vft_supports_select_helper_threading_is_null_and_void_buffer_callbacks() {
+        let entry = r#"
+define void @main(ptr addrspace(1) %out, ptr addrspace(1) %table, i32 %tid) {
+entry:
+  %tbl_null = call i1 @air.is_null_visible_function_table(ptr addrspace(1) %table)
+  %fp0 = call ptr @air.get_function_pointer_visible_function_table(ptr addrspace(1) %table, i32 0)
+  %fp1 = call ptr @air.get_function_pointer_visible_function_table(ptr addrspace(1) %table, i32 1)
+  %sel = select i1 %tbl_null, ptr %fp0, ptr %fp1
+  call void @invoke_writer(ptr %sel, ptr addrspace(1) %out, i32 %tid)
+  ret void
+}
+define internal void @invoke_writer(ptr %cb, ptr addrspace(1) %dst, i32 %idx) {
+entry:
+  call void %cb(ptr addrspace(1) %dst, i32 %idx)
+  ret void
+}
+declare i1 @air.is_null_visible_function_table(ptr addrspace(1))
+declare ptr @air.get_function_pointer_visible_function_table(ptr addrspace(1), i32)
+!air.kernel = !{!0}
+!0 = !{ptr @main, !1, !2}
+!1 = !{}
+!2 = !{!3, !4, !5}
+!3 = !{i32 0, !"air.buffer", !"air.location_index", i32 0, i32 1, !"air.write", !"air.address_space", i32 1, !"air.arg_type_size", i32 4, !"air.arg_type_align_size", i32 4, !"air.arg_type_name", !"uint"}
+!4 = !{i32 1, !"air.visible_function_table", !"air.location_index", i32 1, i32 1, !"air.read", !"air.arg_type_name", !"visible_function_table"}
+!5 = !{i32 2, !"air.thread_position_in_grid", !"air.arg_type_name", !"uint"}
+"#;
+        let linkage = LinkedFunctionLinkage {
+            runtime_visible_functions: vec![
+                LinkedFunctionReference {
+                    symbol: "write_a".into(),
+                    module_ll: "define void @write_a(ptr addrspace(1) %dst, i32 %idx) {\nentry:\n  %z = zext i32 %idx to i64\n  %p = getelementptr inbounds i32, ptr addrspace(1) %dst, i64 %z\n  store i32 111, ptr addrspace(1) %p, align 4\n  ret void\n}\n".into(),
+                },
+                LinkedFunctionReference {
+                    symbol: "write_b".into(),
+                    module_ll: "define void @write_b(ptr addrspace(1) %dst, i32 %idx) {\nentry:\n  %z = zext i32 %idx to i64\n  %p = getelementptr inbounds i32, ptr addrspace(1) %dst, i64 %z\n  store i32 222, ptr addrspace(1) %p, align 4\n  ret void\n}\n".into(),
+                },
+            ],
+            ..Default::default()
+        };
+        let (spec, info) = crate::specialize_linked_module_with_vft(
+            entry,
+            crate::passes::Stage::Kernel,
+            &linkage,
+        )
+        .expect("specialize helper-threaded VFT");
+        assert_eq!(info.unwrap().handles.len(), 2);
+        let (spv, _) = crate::translate_sanitized_native_reflected_unvalidated(
+            &spec,
+            crate::passes::Stage::Kernel,
+            std::path::Path::new(""),
+            crate::passes::TransformOptions::default(),
+            None,
+        )
+        .expect("translate helper-threaded VFT");
+        let asm = crate::disassemble(&spv).unwrap();
+        assert!(asm.contains("OpSwitch"), "{asm}");
+        assert!(!asm.contains("OpUnreachable"), "{asm}");
+    }
+
+    #[test]
+    fn runtime_vft_supports_same_library_visible_functions_and_rejects_conflicts() {
+        let same_lib_entry = r#"
+define i32 @vis_inc(i32 %x) {
+entry:
+  %y = add i32 %x, 1
+  ret i32 %y
+}
+define i32 @vis_dbl(i32 %x) {
+entry:
+  %y = mul i32 %x, 2
+  ret i32 %y
+}
+define void @main(ptr addrspace(1) %out, ptr addrspace(1) %table, i32 %tid) {
+entry:
+  %fp = call ptr @air.get_function_pointer_visible_function_table(ptr addrspace(1) %table, i32 %tid)
+  %v = call i32 %fp(i32 %tid)
+  store i32 %v, ptr addrspace(1) %out, align 4
+  ret void
+}
+declare ptr @air.get_function_pointer_visible_function_table(ptr addrspace(1), i32)
+!air.kernel = !{!0}
+!0 = !{ptr @main, !1, !2}
+!1 = !{}
+!2 = !{!3, !4, !5}
+!3 = !{i32 0, !"air.buffer", !"air.location_index", i32 0, i32 1, !"air.write", !"air.arg_type_name", !"uint"}
+!4 = !{i32 1, !"air.visible_function_table", !"air.location_index", i32 1, i32 1, !"air.read", !"air.arg_type_name", !"visible_function_table"}
+!5 = !{i32 2, !"air.thread_position_in_grid", !"air.arg_type_name", !"uint"}
+"#;
+        // Case 1: whole single-MTLLibrary passed for every visible function.
+        let whole_linkage = LinkedFunctionLinkage {
+            runtime_visible_functions: vec![
+                LinkedFunctionReference {
+                    symbol: "vis_inc".into(),
+                    module_ll: same_lib_entry.into(),
+                },
+                LinkedFunctionReference {
+                    symbol: "vis_dbl".into(),
+                    module_ll: same_lib_entry.into(),
+                },
+            ],
+            ..Default::default()
+        };
+        let (spec_whole, info_whole) = crate::specialize_linked_module_with_vft(
+            same_lib_entry,
+            crate::passes::Stage::Kernel,
+            &whole_linkage,
+        )
+        .expect("whole single-MTLLibrary VFT");
+        assert_eq!(info_whole.unwrap().handles.len(), 2);
+        let (spv_whole, _) = crate::translate_sanitized_native_reflected_unvalidated(
+            &spec_whole,
+            crate::passes::Stage::Kernel,
+            std::path::Path::new(""),
+            crate::passes::TransformOptions::default(),
+            None,
+        )
+        .expect("translate whole-library VFT");
+        assert!(crate::disassemble(&spv_whole).unwrap().contains("OpSwitch"));
+
+        // Case 2: split single-function module matching entry definition + external new function.
+        let split_inc = "define i32 @vis_inc(i32 %x) {\nentry:\n  %y = add i32 %x, 1\n  ret i32 %y\n}\n";
+        let ext_add5 = "define i32 @vis_add5(i32 %x) {\nentry:\n  %y = add i32 %x, 5\n  ret i32 %y\n}\n";
+        let split_linkage = LinkedFunctionLinkage {
+            runtime_visible_functions: vec![
+                LinkedFunctionReference {
+                    symbol: "vis_inc".into(),
+                    module_ll: split_inc.into(),
+                },
+                LinkedFunctionReference {
+                    symbol: "vis_add5".into(),
+                    module_ll: ext_add5.into(),
+                },
+            ],
+            ..Default::default()
+        };
+        let (spec_split, info_split) = crate::specialize_linked_module_with_vft(
+            same_lib_entry,
+            crate::passes::Stage::Kernel,
+            &split_linkage,
+        )
+        .expect("split same-library + external VFT");
+        assert_eq!(info_split.unwrap().handles.len(), 2);
+        let (spv_split, _) = crate::translate_sanitized_native_reflected_unvalidated(
+            &spec_split,
+            crate::passes::Stage::Kernel,
+            std::path::Path::new(""),
+            crate::passes::TransformOptions::default(),
+            None,
+        )
+        .expect("translate split same-library VFT");
+        assert!(crate::disassemble(&spv_split).unwrap().contains("OpSwitch"));
+
+        // Case 3: conflicting body for same-named visible function must be refused.
+        let conflicting_inc =
+            "define i32 @vis_inc(i32 %x) {\nentry:\n  %y = add i32 %x, 99\n  ret i32 %y\n}\n";
+        let conflict_linkage = LinkedFunctionLinkage {
+            runtime_visible_functions: vec![LinkedFunctionReference {
+                symbol: "vis_inc".into(),
+                module_ll: conflicting_inc.into(),
+            }],
+            ..Default::default()
+        };
+        let err = crate::specialize_linked_module_with_vft(
+            same_lib_entry,
+            crate::passes::Stage::Kernel,
+            &conflict_linkage,
+        )
+        .unwrap_err();
+        assert!(err.contains("conflicts") && err.contains("vis_inc"), "{err}");
+    }
