+        };
+        let disp_global = llvm_global(&disp_name)?;
+        output.push_str(leading);
+        output.push_str(&trimmed[..callee_start]);
+        output.push_str(&disp_global);
+        output.push('(');
+        output.push_str("i32 ");
+        output.push_str(&handle_val);
+        if trimmed.as_bytes().get(callee_end + 1) != Some(&b')') {
+            output.push_str(", ");
+        }
+        output.push_str(&trimmed[callee_end + 1..]);
+        output.push('\n');
+    }
+
+    for dispatcher in dispatchers {
+        output.push('\n');
+        output.push_str(&runtime_vft_dispatcher_definition(
