+fn discover_visible_function_table_bindings(
+    entry_ll: &str,
+    stage: crate::passes::Stage,
+) -> Vec<RuntimeVisibleFunctionTableBinding> {
+    let mut bindings: Vec<RuntimeVisibleFunctionTableBinding> = match stage {
+        crate::passes::Stage::Kernel => crate::meta::parse_air_kernel_meta(entry_ll)
+            .map(|m| {
+                m.roles
+                    .into_iter()
+                    .filter_map(|(param_index, role)| match role {
+                        crate::meta::KernRole::VisibleFunctionTable(metal_index) => {
+                            Some(RuntimeVisibleFunctionTableBinding {
+                                param_index,
+                                metal_index,
+                            })
+                        }
+                        _ => None,
+                    })
+                    .collect()
+            })
+            .unwrap_or_default(),
+        crate::passes::Stage::Vertex => crate::meta::parse_air_vertex_meta(entry_ll)
+            .map(|m| {
+                m.roles
+                    .into_iter()
+                    .filter_map(|(param_index, role)| match role {
+                        crate::meta::VertRole::VisibleFunctionTable(metal_index) => {
+                            Some(RuntimeVisibleFunctionTableBinding {
+                                param_index,
+                                metal_index,
+                            })
+                        }
+                        _ => None,
+                    })
+                    .collect()
+            })
+            .unwrap_or_default(),
+        crate::passes::Stage::Fragment => crate::meta::parse_air_fragment_meta(entry_ll)
+            .map(|m| {
+                m.roles
+                    .into_iter()
+                    .filter_map(|(param_index, role)| match role {
+                        crate::meta::FragRole::VisibleFunctionTable(metal_index) => {
+                            Some(RuntimeVisibleFunctionTableBinding {
+                                param_index,
+                                metal_index,
