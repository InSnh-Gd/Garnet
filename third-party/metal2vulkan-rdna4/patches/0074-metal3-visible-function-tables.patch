+/// Lower runtime `MTLVisibleFunctionTable` parameters and indirect function-pointer calls across
+/// compute, vertex, and fragment stages into runtime table-buffer handle loads plus bounded
+/// `OpSwitch` dispatchers with safe zero/no-op out-of-bounds and null-slot handling.
+///
+/// Activated when `linkage.visible_tables` is empty and either `linkage.runtime_visible_functions`
+/// is non-empty or `linkage.runtime_visible_tables` is true. Returns `(rewritten_ll, Some(info))`
+/// when any visible function table parameter or runtime visible function lookup was lowered, or
+/// `(entry_ll, None)` when the stage has no visible function tables.
+pub fn specialize_runtime_visible_function_tables(
+    entry_ll: &str,
+    stage: crate::passes::Stage,
+    entry_name: &str,
+    linkage: &LinkedFunctionLinkage,
+) -> Result<(String, Option<RuntimeVisibleFunctionTableInfo>), String> {
+    if !linkage.visible_tables.is_empty()
+        || (linkage.runtime_visible_functions.is_empty() && !linkage.runtime_visible_tables)
+    {
+        return Ok((entry_ll.to_string(), None));
+    }
+    let tables = discover_visible_function_table_bindings(entry_ll, stage);
+    if tables.is_empty()
+        && !entry_ll.contains("@air.get_function_pointer_visible_function_table(")
+        && !entry_ll.contains("@air.get_size_visible_function_table(")
+        && !entry_ll.contains("@air.is_null_visible_function_table(")
+    {
+        return Ok((entry_ll.to_string(), None));
+    }
+    validate_linkage(linkage)?;
+
+    // Build deterministic 1-based handle table sorted by symbol name (0 is reserved for null).
+    let mut pool_map = std::collections::BTreeMap::<String, String>::new();
+    for reference in &linkage.runtime_visible_functions {
+        if !module_defines(&reference.module_ll, &reference.symbol) {
+            return Err(format!(
+                "runtime visible function {:?} is not defined by its linked module",
+                reference.symbol
+            ));
+        }
+        if let Some(prev) = pool_map.get(&reference.symbol) {
+            if prev != &reference.module_ll {
+                return Err(format!(
+                    "runtime visible function {:?} is defined by multiple distinct modules",
+                    reference.symbol
+                ));
+            }
+        } else {
+            pool_map.insert(reference.symbol.clone(), reference.module_ll.clone());
+        }
+    }
+    let mut pool_entries = Vec::<LinkedFunction>::with_capacity(pool_map.len());
+    let mut handle_info = Vec::<RuntimeVisibleFunctionHandle>::with_capacity(pool_map.len());
+    let mut symbol_to_handle = HashMap::<String, u32>::with_capacity(pool_map.len());
+    for (ordinal, (symbol, module_ll)) in pool_map.into_iter().enumerate() {
+        let handle_id = u32::try_from(ordinal + 1)
+            .map_err(|_| "runtime visible function count exceeded u32::MAX".to_string())?;
+        symbol_to_handle.insert(symbol.clone(), handle_id);
+        handle_info.push(RuntimeVisibleFunctionHandle {
+            handle_id,
+            symbol: symbol.clone(),
+        });
+        pool_entries.push(LinkedFunction {
+            index: handle_id,
+            symbol,
+            module_ll,
+        });
+    }
+
+    let signatures = function_signatures(entry_ll)?;
+    let entry_blocks = normalized_function_blocks(entry_ll);
+    let entry_global = llvm_global(entry_name)?;
+    let entry_sig = signatures.get(&entry_global).ok_or_else(|| {
+        format!("runtime visible function-table entry function {entry_name:?} is not defined")
+    })?;
+    let mut table_params = HashSet::<(String, usize)>::new();
+    let mut table_param_indices = HashSet::<u32>::new();
+    for binding in &tables {
+        if (binding.param_index as usize) >= entry_sig.parameters.len() {
+            return Err(format!(
+                "visible function table parameter {} exceeds entry {:?} arity {}",
+                binding.param_index,
+                entry_name,
+                entry_sig.parameters.len()
+            ));
+        }
+        table_params.insert((entry_global.clone(), binding.param_index as usize));
+        table_param_indices.insert(binding.param_index);
+    }
+
+    let mut ptr_params = HashSet::<(String, usize)>::new();
+    propagate_runtime_vft_flow(entry_ll, &signatures, &mut table_params, &mut ptr_params)?;
+
+    struct RuntimeDispatcher<'a> {
+        name: String,
+        entries: Vec<&'a LinkedFunction>,
+        return_type: String,
+        argument_types: Vec<String>,
+    }
+
+    let mut output = String::with_capacity(entry_ll.len() + 1024);
+    let mut linked_modules = Vec::<&str>::new();
+    let mut linked_module_set = HashSet::<&str>::new();
+    let mut dispatchers = Vec::<RuntimeDispatcher<'_>>::new();
+    let mut dispatcher_names = HashMap::<String, String>::new();
+    let mut temp_counter = 0usize;
+    let mut current_function = None::<String>;
+    let mut current_tables = HashSet::<String>::new();
+    // Map tracked function-pointer SSA -> runtime i32 handle SSA (or literal like "0"/"1").
+    let mut ptr_handles = HashMap::<String, String>::new();
+    let mut sentinel_integers = HashSet::<String>::new();
+
+    for raw_line in entry_ll.lines() {
+        let mut line = raw_line.to_string();
+        let trimmed_start = line.trim_start();
+        if current_function.is_none()
+            && trimmed_start.starts_with('!')
+            && trimmed_start.contains(" = !{")
+            && trimmed_start.contains("!\"air.visible_function_table\"")
+        {
+            if let Some(rewritten_md) =
+                rewrite_vft_metadata_line(&line, &table_param_indices)
+            {
+                output.push_str(&rewritten_md);
+                output.push('\n');
+                continue;
+            }
+        }
+        if let Some(global) = definition_global(trimmed_start) {
+            let closes_inline = trimmed_start.ends_with('}');
+            current_function = Some(global.clone());
+            current_tables.clear();
+            ptr_handles.clear();
+            sentinel_integers.clear();
+            let sig = signatures
+                .get(&global)
+                .ok_or_else(|| format!("missing parsed signature for {global}"))?;
+            for (ordinal, param) in sig.parameters.iter().enumerate() {
+                if table_params.contains(&(global.clone(), ordinal)) {
+                    current_tables.insert(param.clone());
+                }
+                if ptr_params.contains(&(global.clone(), ordinal)) {
+                    ptr_handles.insert(
+                        param.clone(),
+                        runtime_ptr_handle_param(ordinal, sig),
+                    );
+                }
+            }
+            line = append_runtime_ptr_handle_params(&line, &global, &signatures, &ptr_params)?;
+            output.push_str(&line);
+            output.push('\n');
+            if closes_inline {
+                current_function = None;
+            }
+            continue;
+        }
+        if trimmed_start == "}" {
+            output.push_str(&line);
+            output.push('\n');
+            current_function = None;
+            current_tables.clear();
+            ptr_handles.clear();
+            sentinel_integers.clear();
+            continue;
+        }
+        let Some(current_global) = current_function.as_deref() else {
+            // Drop declarations for visible-function-table intrinsics we lower away.
+            if let Some((decl_glob, _)) = declaration_global(trimmed_start) {
+                if matches!(
+                    decl_glob,
+                    "@air.get_function_pointer_visible_function_table"
+                        | "@air.get_size_visible_function_table"
+                        | "@air.is_null_visible_function_table"
+                ) {
+                    continue;
+                }
+            }
+            output.push_str(&line);
+            output.push('\n');
+            continue;
+        };
+
+        // Thread runtime i32 handle arguments into internal helpers that take tracked ptr params.
+        if let Some(rewritten_call) = append_runtime_ptr_handle_args(
+            &line,
+            current_global,
+            &signatures,
+            &ptr_params,
+            &ptr_handles,
+        )? {
+            output.push_str(&rewritten_call);
+            output.push('\n');
+            continue;
+        }
+
+        let trimmed = line.trim_start();
+        let leading = &line[..line.len() - trimmed.len()];
+        if let Some((result, instruction)) = trimmed.split_once(" = ") {
+            let result = result.trim();
+            if instruction.contains("@air.get_function_pointer_visible_function_table(") {
+                let arguments = call_arguments(instruction)?;
+                if arguments.len() < 2 {
+                    return Err(format!(
+                        "visible function-table lookup has {} arguments: {trimmed}",
+                        arguments.len()
+                    ));
+                }
+                let table_val = value_operand(arguments[0]);
+                if current_tables.contains(table_val) {
+                    if !arguments[1].trim_start().starts_with("i32 ") {
+                        return Err(format!(
+                            "runtime visible function-table lookup has non-i32 slot operand {:?}",
+                            arguments[1]
+                        ));
+                    }
+                    let slot_val = value_operand(arguments[1]);
+                    let id = temp_counter;
+                    temp_counter += 1;
+                    let sz = format!("%m2v.vft.sz.{id}");
+                    let ok = format!("%m2v.vft.ok.{id}");
+                    let i1 = format!("%m2v.vft.i1.{id}");
+                    let ix = format!("%m2v.vft.ix.{id}");
+                    let z = format!("%m2v.vft.z.{id}");
+                    let ptr_el = format!("%m2v.vft.p.{id}");
+                    let raw = format!("%m2v.vft.raw.{id}");
+                    let hdl = format!("%m2v.vft.hdl.{id}");
+                    // Safe bounds-checked handle load: word[0] = slot_count, word[1 + slot] = handle.
+                    // When out-of-bounds or slot_count == 0, index clamps to 0 (always in-bounds) and
+                    // select forces handle = 0 (null -> safe default).
+                    writeln!(output, "{leading}{sz} = load i32, ptr addrspace(1) {table_val}, align 4").unwrap();
+                    writeln!(output, "{leading}{ok} = icmp ult i32 {slot_val}, {sz}").unwrap();
+                    writeln!(output, "{leading}{i1} = add i32 {slot_val}, 1").unwrap();
+                    writeln!(output, "{leading}{ix} = select i1 {ok}, i32 {i1}, i32 0").unwrap();
+                    writeln!(output, "{leading}{z} = zext i32 {ix} to i64").unwrap();
+                    writeln!(output, "{leading}{ptr_el} = getelementptr inbounds i32, ptr addrspace(1) {table_val}, i64 {z}").unwrap();
+                    writeln!(output, "{leading}{raw} = load i32, ptr addrspace(1) {ptr_el}, align 4").unwrap();
+                    writeln!(output, "{leading}{hdl} = select i1 {ok}, i32 {raw}, i32 0").unwrap();
+                    writeln!(output, "{leading}{result} = inttoptr i64 0 to ptr").unwrap();
+                    ptr_handles.insert(result.to_string(), hdl);
+                    continue;
+                }
+            } else if instruction.contains("@air.get_size_visible_function_table(") {
+                let arguments = call_arguments(instruction)?;
+                if let Some(table_val) = arguments
+                    .first()
+                    .map(|a| value_operand(a))
+                    .filter(|v| current_tables.contains(*v))
+                {
+                    writeln!(
+                        output,
+                        "{leading}{result} = load i32, ptr addrspace(1) {table_val}, align 4"
+                    )
+                    .unwrap();
+                    continue;
+                }
+            } else if instruction.contains("@air.is_null_visible_function_table(") {
+                let arguments = call_arguments(instruction)?;
+                if let Some(table_val) = arguments
+                    .first()
+                    .map(|a| value_operand(a))
+                    .filter(|v| current_tables.contains(*v))
+                {
+                    let id = temp_counter;
+                    temp_counter += 1;
+                    let sz = format!("%m2v.vft.nsz.{id}");
+                    writeln!(
+                        output,
+                        "{leading}{sz} = load i32, ptr addrspace(1) {table_val}, align 4"
+                    )
+                    .unwrap();
+                    writeln!(output, "{leading}{result} = icmp eq i32 {sz}, 0").unwrap();
+                    continue;
+                }
+            } else if let Some((pointer_value, equal_to_null)) =
+                null_pointer_comparison(instruction)
+            {
+                if let Some(hdl) = ptr_handles.get(pointer_value) {
+                    let pred = if equal_to_null { "eq" } else { "ne" };
+                    writeln!(output, "{leading}{result} = icmp {pred} i32 {hdl}, 0").unwrap();
+                    continue;
+                }
+            } else if instruction.starts_with("ptrtoint ") {
+                if let Some(source) = cast_source_value(instruction) {
+                    if ptr_handles.contains_key(source) {
+                        sentinel_integers.insert(result.to_string());
+                    }
+                }
+            } else if instruction.starts_with("trunc ") {
+                if let Some(source) = cast_source_value(instruction) {
+                    if sentinel_integers.contains(source) {
+                        sentinel_integers.insert(result.to_string());
+                    }
+                }
+            } else if let Some((integer, equal_to_sentinel)) =
+                opaque_sentinel_comparison(instruction)
+            {
+                if sentinel_integers.contains(integer) {
+                    writeln!(
+                        output,
+                        "{leading}{result} = or i1 false, {}",
+                        !equal_to_sentinel
+                    )
+                    .unwrap();
+                    continue;
+                }
+            } else if instruction.starts_with("bitcast ")
+                || instruction.starts_with("addrspacecast ")
+            {
+                if let Some(source) = cast_source_value(instruction) {
+                    if let Some(hdl) = ptr_handles.get(source).cloned() {
+                        ptr_handles.insert(result.to_string(), hdl);
+                    }
+                }
+            } else if instruction.starts_with("select ") {
+                if let Some((hdl_name, hdl_line)) = rewrite_runtime_vft_select(
+                    instruction,
+                    &ptr_handles,
+                    &symbol_to_handle,
+                    &mut temp_counter,
+                ) {
+                    writeln!(output, "{leading}{hdl_line}").unwrap();
+                    ptr_handles.insert(result.to_string(), hdl_name);
+                }
+            } else if instruction.starts_with("phi ") {
+                if let Some((hdl_name, hdl_line)) = rewrite_runtime_vft_phi(
+                    instruction,
+                    &ptr_handles,
+                    &symbol_to_handle,
+                    &mut temp_counter,
+                ) {
+                    writeln!(output, "{leading}{hdl_line}").unwrap();
+                    ptr_handles.insert(result.to_string(), hdl_name);
+                }
+            }
+        }
+
+        let Some((callee_start, callee_end, callee)) = indirect_call_callee(trimmed) else {
+            output.push_str(&line);
+            output.push('\n');
+            continue;
+        };
+        let Some(handle_val) = ptr_handles.get(callee).cloned() else {
+            output.push_str(&line);
+            output.push('\n');
+            continue;
+        };
+        let call = indirect_call_shape(trimmed, callee_start, callee_end)?;
+        let key = format!("{}|{}", call.return_type, call.argument_types.join(","));
+        let disp_name = if let Some(existing) = dispatcher_names.get(&key) {
+            existing.clone()
+        } else {
+            let name = format!("metal2vulkan.vft.dispatch.{}", dispatchers.len());
+            let mut entries = Vec::new();
+            for function in &pool_entries {
+                if linked_function_matches_call(function, &call)? {
+                    entries.push(function);
+                }
+            }
+            if entries.is_empty() {
+                return Err(format!(
+                    "runtime visible function table indirect call ({}) -> {} has no matching linked visible function",
+                    call.argument_types.join(", "),
+                    call.return_type
+                ));
+            }
+            for function in &entries {
+                let fn_global = llvm_global(&function.symbol)?;
+                if let Some(entry_body) = entry_blocks.get(&fn_global) {
+                    let mod_blocks = normalized_function_blocks(&function.module_ll);
+                    if let Some(mod_body) = mod_blocks.get(&fn_global) {
+                        if mod_body != entry_body {
+                            return Err(format!(
+                                "runtime visible function {:?} conflicts with existing definition in entry module",
