+fn rewrite_vft_metadata_line(
+    line: &str,
+    table_param_indices: &HashSet<u32>,
+) -> Option<String> {
+    let open = line.find("!{")?;
+    let close = line.rfind('}')?;
+    if close <= open + 2 {
+        return None;
+    }
+    let body = &line[open + 2..close];
+    let first_field = body.split(',').next()?.trim();
+    let param_idx: u32 = first_field.strip_prefix("i32 ")?.trim().parse().ok()?;
+    if !table_param_indices.contains(&param_idx) {
+        return None;
+    }
+    let mut new_body = body
+        .replace("!\"air.visible_function_table\"", "!\"air.buffer\"")
+        .replace("!\"visible_function_table\"", "!\"uint\"");
+    if !new_body.contains("!\"air.read\"")
+        && !new_body.contains("!\"air.write\"")
+        && !new_body.contains("!\"air.read_write\"")
+    {
+        new_body.push_str(", !\"air.read\"");
+    }
+    if !new_body.contains("!\"air.address_space\"") {
+        new_body.push_str(", !\"air.address_space\", i32 1");
+    }
+    if !new_body.contains("!\"air.arg_type_size\"") {
+        new_body.push_str(", !\"air.arg_type_size\", i32 4");
+    }
+    if !new_body.contains("!\"air.arg_type_align_size\"") {
+        new_body.push_str(", !\"air.arg_type_align_size\", i32 4");
+    }
+    if !new_body.contains("!\"air.arg_type_name\"") {
+        new_body.push_str(", !\"air.arg_type_name\", !\"uint\"");
+    }
+    Some(format!("{}{}{}", &line[..open + 2], new_body, &line[close..]))
+}
+
+fn propagate_runtime_vft_flow(
+    ll: &str,
+    signatures: &HashMap<String, FunctionSignature>,
+    table_params: &mut HashSet<(String, usize)>,
+    ptr_params: &mut HashSet<(String, usize)>,
+) -> Result<(), String> {
+    loop {
+        let mut changed = false;
+        let mut current = None::<String>;
+        let mut tables = HashSet::<String>::new();
+        let mut pointers = HashSet::<String>::new();
+        for line in ll.lines() {
+            let trimmed = line.trim_start();
+            if let Some(global) = definition_global(trimmed) {
+                current = Some(global.clone());
+                tables.clear();
+                pointers.clear();
+                let sig = signatures
+                    .get(&global)
+                    .ok_or_else(|| format!("missing parsed signature for {global}"))?;
+                for (ordinal, param) in sig.parameters.iter().enumerate() {
+                    if table_params.contains(&(global.clone(), ordinal)) {
+                        tables.insert(param.clone());
+                    }
+                    if ptr_params.contains(&(global.clone(), ordinal)) {
+                        pointers.insert(param.clone());
+                    }
+                }
+                continue;
+            }
+            if trimmed == "}" {
+                current = None;
+                continue;
+            }
+            if current.is_none() {
+                continue;
+            }
+            if let Some((result, instruction)) = trimmed.split_once(" = ") {
+                let result = result.trim();
+                if instruction.contains("@air.get_function_pointer_visible_function_table(") {
+                    let arguments = call_arguments(instruction)?;
+                    if arguments
+                        .first()
+                        .is_some_and(|a| tables.contains(value_operand(a)))
+                    {
+                        pointers.insert(result.to_string());
+                    }
+                } else if instruction.starts_with("bitcast ")
+                    || instruction.starts_with("addrspacecast ")
+                {
+                    if let Some(source) = cast_source_value(instruction) {
+                        if pointers.contains(source) {
+                            pointers.insert(result.to_string());
+                        }
+                    }
+                } else if instruction.starts_with("phi ") || instruction.starts_with("select ") {
+                    if pointers.iter().any(|p| contains_llvm_value(instruction, p)) {
+                        pointers.insert(result.to_string());
+                    }
+                }
+            }
+            let Some((callee, _, _, arguments)) = named_call(trimmed) else {
+                continue;
+            };
+            let Some(callee_sig) = signatures.get(callee) else {
+                continue;
+            };
+            for (ordinal, argument) in arguments
+                .iter()
+                .take(callee_sig.parameters.len())
+                .enumerate()
+            {
+                let value = value_operand(argument);
+                if tables.contains(value)
+                    && table_params.insert((callee.to_string(), ordinal))
+                {
+                    changed = true;
+                }
+                if pointers.contains(value)
+                    && ptr_params.insert((callee.to_string(), ordinal))
+                {
+                    changed = true;
+                }
+            }
+        }
+        if !changed {
+            return Ok(());
+        }
+    }
+}
+
+fn runtime_ptr_handle_param(ordinal: usize, signature: &FunctionSignature) -> String {
+    let base = format!("%m2v.vft.param{ordinal}.hdl");
+    if !signature.parameters.contains(&base) {
+        return base;
+    }
+    for suffix in 1usize.. {
+        let candidate = format!("{base}.{suffix}");
+        if !signature.parameters.contains(&candidate) {
+            return candidate;
+        }
+    }
+    unreachable!()
+}
+
+fn runtime_ptr_param_ordinals(
+    ptr_params: &HashSet<(String, usize)>,
+    global: &str,
+) -> Vec<usize> {
+    let mut ordinals: Vec<usize> = ptr_params
+        .iter()
+        .filter_map(|(f, o)| (f == global).then_some(*o))
+        .collect();
+    ordinals.sort_unstable();
+    ordinals
+}
+
+fn append_runtime_ptr_handle_params(
+    line: &str,
+    global: &str,
+    signatures: &HashMap<String, FunctionSignature>,
+    ptr_params: &HashSet<(String, usize)>,
+) -> Result<String, String> {
+    let ordinals = runtime_ptr_param_ordinals(ptr_params, global);
+    if ordinals.is_empty() {
+        return Ok(line.to_string());
+    }
+    let sig = signatures
+        .get(global)
+        .ok_or_else(|| format!("missing parsed signature for {global}"))?;
+    let at = line
+        .find(global)
+        .ok_or_else(|| format!("definition line does not contain {global}"))?;
+    let open = line[at + global.len()..]
+        .find('(')
+        .map(|o| o + at + global.len())
+        .ok_or_else(|| format!("definition {global} has no parameter list"))?;
+    let close = matching_paren(line, open)
+        .ok_or_else(|| format!("multiline definition parameters for {global} are unsupported"))?;
+    let additions = ordinals
+        .into_iter()
+        .map(|o| format!("i32 {}", runtime_ptr_handle_param(o, sig)))
+        .collect::<Vec<_>>()
+        .join(", ");
+    let sep = if line[open + 1..close].trim().is_empty() {
+        ""
+    } else {
+        ", "
+    };
+    Ok(format!(
+        "{}{}{}{}",
+        &line[..close],
+        sep,
+        additions,
+        &line[close..]
+    ))
+}
+
+fn append_runtime_ptr_handle_args(
+    line: &str,
+    caller: &str,
+    signatures: &HashMap<String, FunctionSignature>,
+    ptr_params: &HashSet<(String, usize)>,
+    ptr_handles: &HashMap<String, String>,
+) -> Result<Option<String>, String> {
+    let Some((callee, open, close, arguments)) = named_call(line) else {
+        return Ok(None);
+    };
+    let ordinals = runtime_ptr_param_ordinals(ptr_params, callee);
+    if ordinals.is_empty() || !signatures.contains_key(callee) {
+        return Ok(None);
+    }
+    let mut additions = Vec::new();
+    for ordinal in ordinals {
+        let arg = arguments.get(ordinal).ok_or_else(|| {
+            format!("call from {caller} to {callee} omits runtime VFT pointer param {ordinal}")
+        })?;
+        let val = value_operand(arg);
+        let hdl = if val == "null" {
+            "0".to_string()
+        } else {
+            ptr_handles.get(val).cloned().ok_or_else(|| {
+                format!("call from {caller} to {callee} passes untraced VFT pointer param {ordinal}: {val}")
+            })?
+        };
+        additions.push(format!("i32 {hdl}"));
+    }
+    let sep = if line[open + 1..close].trim().is_empty() {
+        ""
+    } else {
+        ", "
+    };
+    Ok(Some(format!(
+        "{}{}{}{}",
+        &line[..close],
+        sep,
+        additions.join(", "),
+        &line[close..]
+    )))
+}
+
+fn resolve_ptr_handle_operand(
+    val: &str,
+    ptr_handles: &HashMap<String, String>,
+    symbol_to_handle: &HashMap<String, u32>,
+) -> Option<(String, bool)> {
+    if let Some(hdl) = ptr_handles.get(val) {
+        return Some((hdl.clone(), true));
+    }
+    if val == "null" {
+        return Some(("0".to_string(), false));
+    }
+    if val.starts_with('@') {
+        if let Ok(sym) = decode_llvm_global(val) {
+            if let Some(&id) = symbol_to_handle.get(&sym) {
+                return Some((id.to_string(), true));
+            }
+        }
+    }
+    None
+}
+
+fn rewrite_runtime_vft_select(
+    instruction: &str,
+    ptr_handles: &HashMap<String, String>,
+    symbol_to_handle: &HashMap<String, u32>,
+    counter: &mut usize,
+) -> Option<(String, String)> {
+    let rest = instruction.strip_prefix("select ")?;
+    let parts = split_top_level(rest, ',');
+    if parts.len() != 3 {
+        return None;
+    }
+    let (ht, t_tracked) =
+        resolve_ptr_handle_operand(value_operand(parts[1]), ptr_handles, symbol_to_handle)?;
+    let (hf, f_tracked) =
+        resolve_ptr_handle_operand(value_operand(parts[2]), ptr_handles, symbol_to_handle)?;
+    if !t_tracked && !f_tracked {
+        return None;
+    }
+    let id = *counter;
+    *counter += 1;
+    let hdl = format!("%m2v.vft.sel.{id}");
+    let line = format!("{hdl} = select {}, i32 {ht}, i32 {hf}", parts[0].trim());
+    Some((hdl, line))
+}
+
+fn rewrite_runtime_vft_phi(
+    instruction: &str,
+    ptr_handles: &HashMap<String, String>,
+    symbol_to_handle: &HashMap<String, u32>,
+    counter: &mut usize,
+) -> Option<(String, String)> {
+    let first_bracket = instruction.find('[')?;
+    let arms = split_top_level(&instruction[first_bracket..], ',');
+    let mut new_arms = Vec::with_capacity(arms.len());
+    let mut any_tracked = false;
+    for arm in arms {
+        let arm = arm.trim().strip_prefix('[')?.strip_suffix(']')?.trim();
+        let (val_part, label_part) = arm.split_once(',')?;
+        let (h, tracked) =
+            resolve_ptr_handle_operand(val_part.trim(), ptr_handles, symbol_to_handle)?;
+        any_tracked |= tracked;
+        new_arms.push(format!("[ {h}, {} ]", label_part.trim()));
+    }
+    if !any_tracked {
+        return None;
+    }
+    let id = *counter;
+    *counter += 1;
+    let hdl = format!("%m2v.vft.phi.{id}");
+    let line = format!("{hdl} = phi i32 {}", new_arms.join(", "));
+    Some((hdl, line))
+}
