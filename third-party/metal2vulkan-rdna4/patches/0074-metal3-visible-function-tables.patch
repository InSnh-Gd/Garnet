+fn llvm_zero_literal(ty: &str) -> &'static str {
+    let ty = ty.trim();
+    if ty == "i1" {
+        "false"
+    } else if ty.starts_with('i') && ty[1..].bytes().all(|b| b.is_ascii_digit()) {
+        "0"
+    } else if matches!(ty, "half" | "bfloat" | "float" | "double") {
+        "0.0"
+    } else if ty == "ptr" || ty.starts_with("ptr ") {
+        "null"
+    } else {
+        "zeroinitializer"
+    }
+}
