+        assert!(comp_asm.contains("OpSwitch"), "{comp_asm}");
+        assert!(!comp_asm.contains("OpUnreachable"), "{comp_asm}");
+        assert!(
+            comp_refl.bindings.iter().any(|b| b.metal_index == 1 && b.descriptor.is_some()),
+            "VFT buffer must be bound at metal_index 1: {comp_refl:?}"
+        );
+
+        // Fragment stage with runtime VFT
+        let frag_entry = r#"
+define <4 x float> @fs_vft(<4 x float> %col, ptr addrspace(1) %table, ptr addrspace(1) %slot_buf) {
+entry:
+  %slot = load i32, ptr addrspace(1) %slot_buf, align 4
+  %fp = call ptr @air.get_function_pointer_visible_function_table(ptr addrspace(1) %table, i32 %slot)
+  %out = call <4 x float> %fp(<4 x float> %col)
+  ret <4 x float> %out
+}
+declare ptr @air.get_function_pointer_visible_function_table(ptr addrspace(1), i32)
+!air.fragment = !{!0}
+!0 = !{ptr @fs_vft, !1, !2}
+!1 = !{!3}
+!2 = !{!4, !5, !6}
+!3 = !{!"air.render_target", i32 0, i32 0, !"air.arg_type_name", !"float4"}
+!4 = !{i32 0, !"air.fragment_input", !"col", !"air.perspective", !"air.arg_type_name", !"float4"}
+!5 = !{i32 1, !"air.visible_function_table", !"air.location_index", i32 0, i32 1, !"air.read", !"air.arg_type_name", !"visible_function_table"}
+!6 = !{i32 2, !"air.buffer", !"air.location_index", i32 1, i32 1, !"air.read", !"air.address_space", i32 1, !"air.arg_type_size", i32 4, !"air.arg_type_align_size", i32 4, !"air.arg_type_name", !"uint"}
+"#;
+        let (frag_spec, frag_vft) = crate::specialize_linked_module_with_vft(
+            frag_entry,
+            crate::passes::Stage::Fragment,
+            &linkage,
+        )
+        .expect("specialize fragment runtime VFT");
+        assert_eq!(frag_vft.unwrap().tables[0].metal_index, 0);
+        let (frag_spv, _) = crate::translate_sanitized_native_reflected_unvalidated(
+            &frag_spec,
+            crate::passes::Stage::Fragment,
+            std::path::Path::new(""),
+            crate::passes::TransformOptions::default(),
+            None,
+        )
+        .expect("translate fragment runtime VFT");
+        let frag_asm = crate::disassemble(&frag_spv).unwrap();
+        assert!(frag_asm.contains("OpEntryPoint Fragment"), "{frag_asm}");
+        assert!(frag_asm.contains("OpSwitch"), "{frag_asm}");
+        assert!(!frag_asm.contains("OpUnreachable"), "{frag_asm}");
+
+        // Vertex stage with runtime VFT
+        let vert_entry = r#"
+define <4 x float> @vs_vft(<4 x float> %pos, ptr addrspace(1) %table) {
+entry:
+  %fp = call ptr @air.get_function_pointer_visible_function_table(ptr addrspace(1) %table, i32 0)
+  %out = call <4 x float> %fp(<4 x float> %pos)
+  ret <4 x float> %out
+}
+declare ptr @air.get_function_pointer_visible_function_table(ptr addrspace(1), i32)
+!air.vertex = !{!0}
+!0 = !{ptr @vs_vft, !1, !2}
+!1 = !{!3}
+!2 = !{!4, !5}
+!3 = !{!"air.position", !"air.arg_type_name", !"float4"}
+!4 = !{i32 0, !"air.vertex_input", !"air.location_index", i32 0, i32 1, !"air.arg_type_name", !"float4"}
+!5 = !{i32 1, !"air.visible_function_table", !"air.location_index", i32 0, i32 1, !"air.read", !"air.arg_type_name", !"visible_function_table"}
+"#;
+        let (vert_spec, _) = crate::specialize_linked_module_with_vft(
+            vert_entry,
+            crate::passes::Stage::Vertex,
+            &linkage,
+        )
+        .expect("specialize vertex runtime VFT");
+        let (vert_spv, _) = crate::translate_sanitized_native_reflected_unvalidated(
+            &vert_spec,
+            crate::passes::Stage::Vertex,
+            std::path::Path::new(""),
+            crate::passes::TransformOptions::default(),
+            None,
+        )
+        .expect("translate vertex runtime VFT");
+        let vert_asm = crate::disassemble(&vert_spv).unwrap();
+        assert!(vert_asm.contains("OpEntryPoint Vertex"), "{vert_asm}");
+        assert!(vert_asm.contains("OpSwitch"), "{vert_asm}");
+    }
