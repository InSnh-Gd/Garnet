+#[test]
+fn native_metal3_atomic_float_all_ops_lower_cleanly() {
+    // Part A: native FloatPtr path (add, sub, load, store, xchg)
+    let ll_native = r#"
+target triple = "spirv-unknown-vulkan1.2"
+define void @k_f32_native(ptr addrspace(1) %buf, i32 %tid) {
+entry:
+  %idx = zext i32 %tid to i64
+  %slot = getelementptr inbounds float, ptr addrspace(1) %buf, i64 %idx
+  %a = call float @air.atomic.global.add.f32(ptr addrspace(1) %slot, float 1.5, i32 0, i32 2, i1 false)
+  %s = call float @air.atomic.global.sub.f32(ptr addrspace(1) %slot, float 0.5, i32 0, i32 2, i1 false)
+  %l = call float @air.atomic.global.load.f32(ptr addrspace(1) %slot, i32 0, i32 2, i1 false)
+  %sum = fadd float %a, %s
+  %x = call float @air.atomic.global.xchg.f32(ptr addrspace(1) %slot, float %sum, i32 0, i32 2, i1 false)
+  %final = fadd float %x, %l
+  call void @air.atomic.global.store.f32(ptr addrspace(1) %slot, float %final, i32 0, i32 2, i1 false)
+  ret void
+}
+declare float @air.atomic.global.add.f32(ptr addrspace(1), float, i32, i32, i1)
+declare float @air.atomic.global.sub.f32(ptr addrspace(1), float, i32, i32, i1)
+declare float @air.atomic.global.load.f32(ptr addrspace(1), i32, i32, i1)
+declare float @air.atomic.global.xchg.f32(ptr addrspace(1), float, i32, i32, i1)
+declare void @air.atomic.global.store.f32(ptr addrspace(1), float, i32, i32, i1)
+!air.kernel = !{!0}
+!0 = !{ptr @k_f32_native, !1, !2}
+!1 = !{}
+!2 = !{!3, !4}
+!3 = !{i32 0, !"air.buffer", !"air.location_index", i32 0, i32 1, !"air.read_write", !"air.address_space", i32 1, !"air.arg_type_size", i32 4, !"air.arg_type_align_size", i32 4, !"air.arg_type_name", !"float", !"air.arg_name", !"buf"}
+!4 = !{i32 1, !"air.thread_position_in_grid", !"air.arg_type_name", !"uint", !"air.arg_name", !"tid"}
+"#;
+    let (spv_native, _) = crate::translate_sanitized_native_reflected_unvalidated(
+        ll_native,
+        Stage::Kernel,
+        std::path::Path::new(""),
+        crate::passes::TransformOptions::default(),
+        None,
+    )
+    .expect("native atomic<float> should translate");
+    let asm_native = disassemble(&spv_native).expect("disassemble native f32");
+    assert!(asm_native.contains("OpCapability AtomicFloat32AddEXT"), "{asm_native}");
+    assert!(
+        asm_native.contains("OpExtension \"SPV_EXT_shader_atomic_float_add\""),
+        "{asm_native}"
+    );
+    assert!(asm_native.contains("OpAtomicFAddEXT"), "{asm_native}");
+    assert!(asm_native.contains("OpAtomicLoad"), "{asm_native}");
+    assert!(asm_native.contains("OpAtomicExchange"), "{asm_native}");
+    assert!(asm_native.contains("OpAtomicStore"), "{asm_native}");
+
+    // Part B: CAS path (min, max, cmpxchg.weak + add/sub sharing the same buffer + Workgroup global)
+    let ll_cas = r#"
+target triple = "spirv-unknown-vulkan1.2"
+@tg_f = internal addrspace(3) global float undef, align 4
+define void @k_f32_cas(ptr addrspace(1) %buf, i32 %tid) {
+entry:
+  %exp = alloca float, align 4
+  store float 2.0, ptr %exp, align 4
+  %idx = zext i32 %tid to i64
+  %slot = getelementptr inbounds float, ptr addrspace(1) %buf, i64 %idx
+  %mn = call float @air.atomic.global.min.f.f32(ptr addrspace(1) %slot, float 3.0, i32 0, i32 2, i1 false)
+  %mx = call float @air.atomic.global.max.f.f32(ptr addrspace(1) %slot, float %mn, i32 0, i32 2, i1 false)
+  %ok = call i1 @air.atomic.global.cmpxchg.weak.f32(ptr addrspace(1) %slot, ptr %exp, float %mx, i32 0, i32 0, i32 2, i1 false)
+  %lmn = call float @air.atomic.local.min.f.f32(ptr addrspace(3) @tg_f, float %mx, i32 0, i32 1, i1 false)
+  %add = call float @air.atomic.global.add.f32(ptr addrspace(1) %slot, float %lmn, i32 0, i32 2, i1 false)
+  %sel = select i1 %ok, float %add, float %lmn
+  call void @air.atomic.global.store.f32(ptr addrspace(1) %slot, float %sel, i32 0, i32 2, i1 false)
+  ret void
+}
+declare float @air.atomic.global.min.f.f32(ptr addrspace(1), float, i32, i32, i1)
+declare float @air.atomic.global.max.f.f32(ptr addrspace(1), float, i32, i32, i1)
+declare i1 @air.atomic.global.cmpxchg.weak.f32(ptr addrspace(1), ptr, float, i32, i32, i32, i1)
+declare float @air.atomic.local.min.f.f32(ptr addrspace(3), float, i32, i32, i1)
+declare float @air.atomic.global.add.f32(ptr addrspace(1), float, i32, i32, i1)
+declare void @air.atomic.global.store.f32(ptr addrspace(1), float, i32, i32, i1)
+!air.kernel = !{!0}
+!0 = !{ptr @k_f32_cas, !1, !2}
+!1 = !{}
+!2 = !{!3, !4}
+!3 = !{i32 0, !"air.buffer", !"air.location_index", i32 0, i32 1, !"air.read_write", !"air.address_space", i32 1, !"air.arg_type_size", i32 4, !"air.arg_type_align_size", i32 4, !"air.arg_type_name", !"float", !"air.arg_name", !"buf"}
+!4 = !{i32 1, !"air.thread_position_in_grid", !"air.arg_type_name", !"uint", !"air.arg_name", !"tid"}
+"#;
+    let (spv_cas, _) = crate::translate_sanitized_native_reflected_unvalidated(
+        ll_cas,
+        Stage::Kernel,
+        std::path::Path::new(""),
+        crate::passes::TransformOptions::default(),
+        None,
+    )
+    .expect("CAS atomic<float> should translate");
+    let asm_cas = disassemble(&spv_cas).expect("disassemble cas f32");
+    assert!(asm_cas.contains("OpLoopMerge"), "{asm_cas}");
+    assert!(asm_cas.contains("OpAtomicCompareExchange"), "{asm_cas}");
+    assert!(asm_cas.contains("NMin"), "{asm_cas}");
+    assert!(asm_cas.contains("NMax"), "{asm_cas}");
+    assert!(!asm_cas.contains("AtomicFloat32MinMaxEXT"), "{asm_cas}");
+}
