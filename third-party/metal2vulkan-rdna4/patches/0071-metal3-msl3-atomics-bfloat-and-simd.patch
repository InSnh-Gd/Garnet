+    }
+    let n = bfloat_storage_lanes(ctx, rty)
+        .ok_or_else(|| format!("{name} expects scalar or v2..v4 u16 bfloat storage result"))?;
+    let f32_ty = ty_f32_shaped(ctx, n);
+    let mut out = Vec::new();
+    let mut widened_args = Vec::with_capacity(args.len());
+    for arg in args {
+        let arg_ty = value_result_type(ctx, *arg)
+            .ok_or_else(|| format!("{name} has an operand with no result type"))?;
+        if bfloat_storage_lanes(ctx, arg_ty) != Some(n) {
+            return Err(format!(
+                "{name} expects matching u16 bfloat storage operands"
+            ));
+        }
+        widened_args.push(widen_bf16_to_f32(ctx, &mut out, *arg, n));
+    }
+    let ext = ctx.glsl();
+    let f32_res = ctx.module.fresh_id();
+    if name.contains("saturate") && widened_args.len() == 1 {
+        let clamp = nan_aware_if_precise(name, GLSLstd450::FClamp);
+        let zero = ctx.const_float(0.0);
+        let one = ctx.const_float(1.0);
+        let (lo, hi) = clamp_edges(ctx, f32_ty, zero, one);
+        out.push(Instruction::new(
+            Op::ExtInst,
+            Some(f32_ty),
+            Some(f32_res),
+            vec![
