+                Operand::LiteralExtInstInteger(clamp as u32),
+                Operand::IdRef(widened_args[0]),
+                Operand::IdRef(lo),
+                Operand::IdRef(hi),
+            ],
+        ));
+    } else if let Some(glsl_op) = glsl_extinst(name) {
+        let mut ops = vec![
+            Operand::IdRef(ext),
+            Operand::LiteralExtInstInteger(glsl_op as u32),
+        ];
+        for a in widened_args {
+            ops.push(Operand::IdRef(a));
+        }
+        out.push(Instruction::new(
+            Op::ExtInst,
+            Some(f32_ty),
+            Some(f32_res),
+            ops,
+        ));
+    } else {
+        return Err(format!("unhandled bfloat math intrinsic: {name}"));
+    }
+    narrow_f32_to_bf16(ctx, &mut out, f32_res, n, rty, res);
     Ok(out)
 }
 
