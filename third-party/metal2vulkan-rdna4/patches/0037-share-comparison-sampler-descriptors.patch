+#[test]
+fn repeated_comparison_uses_share_one_descriptor_per_sampler() {
+    for ordinary in [false, true] {
+        let input = source(SamplerSource::Direct, ordinary, true).replace(
+            "  %comparison_value = extractvalue { float, i8 } %comparison, 0",
+            r#"  %first = extractvalue { float, i8 } %comparison, 0
+  %second = call { float, i8 } @air.sample_compare_depth_2d.f32(ptr addrspace(1) %depth, ptr addrspace(2) %sampler, i32 1, <2 x float> <float 0.75, float 0.25>, float 0.25, i1 true, <2 x i32> zeroinitializer, i1 true, float 0.0, float 0.0, i32 0)
+  %next = extractvalue { float, i8 } %second, 0
+  %comparison_value = fadd float %first, %next"#,
+        );
+        let (_, reflection, assembly) = translate("repeated-comparison", &input);
+        assert_eq!(
+            assembly
+                .lines()
+                .filter(|line| line.ends_with(" Binding 736"))
+                .count(),
+            1,
+            "each sampler representation has one descriptor: {assembly}"
+        );
+        let sampler = sampler(&reflection);
+        let comparison = sampler
+            .comparison_descriptor
+            .unwrap_or(sampler.descriptor.unwrap());
+        assert_eq!(comparison.binding, 736);
+        assert_eq!(assembly.matches("OpImageSampleDrefExplicitLod").count(), 2);
+    }
 }
 
