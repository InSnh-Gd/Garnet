 use super::*;
 use std::collections::HashMap;
+
+pub(in crate::passes) fn record_source_sample_coordinate(
+    ctx: &mut Ctx,
+    instructions: &[Instruction],
+    sample: Word,
+    coordinate: Word,
+) {
+    if ctx.normalized_sampler_coordinates
+        && instructions.iter().rev().any(|instruction| {
+            instruction.result_id == Some(sample)
+                && matches!(
+                    instruction.class.opcode,
+                    Op::ImageSampleImplicitLod | Op::ImageSampleDrefImplicitLod
+                )
+        })
+    {
+        ctx.emit_sidecar
+            .source_sample_coordinates
+            .push(crate::SourceSampleCoordinate { sample, coordinate });
+    }
+}
 
