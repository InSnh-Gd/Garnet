+use metal2vulkan::passes::{Stage, TransformOptions};
+
+fn source(component: &str, multisampled: bool, access: u32) -> String {
+    let suffix = if multisampled { "_ms" } else { "" };
+    let (scalar, unsigned) = match component {
+        "float" => ("float", ""),
+        "uint" => ("i32", ".u"),
+        _ => ("i32", ".s"),
+    };
+    let ty = if scalar == "float" { "v4f32" } else { "v4i32" };
+    let coords = if multisampled {
+        "i32 2"
+    } else {
+        "<2 x i32> zeroinitializer, i32 0"
+    };
+    let coord_types = if multisampled {
+        "i32"
+    } else {
+        "<2 x i32>, i32"
+    };
+    format!(
+        r#"target triple = "air64-apple-macosx"
+%Root = type {{ [2 x ptr addrspace(1)] }}
+define void @guarded(ptr addrspace(2) %args, ptr addrspace(1) %out, i32 %choose) {{
+entry:
+  %index = zext i32 %choose to i64
+  %slot = getelementptr %Root, ptr addrspace(2) %args, i64 0, i32 0, i64 %index
+  %bits = load i64, ptr addrspace(2) %slot, align 8
+  %image = inttoptr i64 %bits to ptr addrspace(1)
+  %missing = call i1 @air.is_null_texture_2d{suffix}(ptr addrspace(1) %image)
+  br i1 %missing, label %done, label %read
+read:
+  %sample = call {{ <4 x {scalar}>, i8 }} @air.read_texture_2d{suffix}{unsigned}.{ty}(ptr addrspace(1) %image, ptr addrspace(2) null, <2 x i32> <i32 2, i32 1>, {coords}, i32 {access})
+  %value = extractvalue {{ <4 x {scalar}>, i8 }} %sample, 0
+  store <4 x {scalar}> %value, ptr addrspace(1) %out, align 16
+  br label %done
+done:
+  ret void
+}}
+declare i1 @air.is_null_texture_2d{suffix}(ptr addrspace(1))
+declare {{ <4 x {scalar}>, i8 }} @air.read_texture_2d{suffix}{unsigned}.{ty}(ptr addrspace(1), ptr addrspace(2), <2 x i32>, {coord_types}, i32)
+!air.kernel = !{{!0}}
+!0 = !{{ptr @guarded, !1, !2}}
+!1 = !{{}}
+!2 = !{{!3, !4, !5}}
+!3 = !{{i32 0, !"air.indirect_buffer", !"air.location_index", i32 3, i32 1, !"air.read", !"air.address_space", i32 2, !"air.arg_type_name", !"Root"}}
+!4 = !{{i32 1, !"air.buffer", !"air.location_index", i32 0, i32 1, !"air.read_write", !"air.address_space", i32 1, !"air.arg_type_name", !"uint"}}
+!5 = !{{i32 2, !"air.thread_position_in_grid", !"air.arg_type_name", !"uint"}}
+"#
+    )
+}
+
+#[test]
+fn guarded_sample_access_reads_use_sampled_images() {
+    for component in ["float", "uint", "int"] {
+        for ms in [false, true] {
+            for access in [0, 1] {
+                let text = source(component, ms, access);
+                let (spv, reflection) =
+                    metal2vulkan::translate_sanitized_native_reflected_unvalidated(
+                        &text,
+                        Stage::Kernel,
+                        &std::env::temp_dir(),
+                        TransformOptions::default(),
+                        None,
+                    )
+                    .unwrap_or_else(|error| {
+                        panic!("component={component} ms={ms} access={access}: {error}")
+                    });
+                reflection.validate_descriptor_abi().unwrap();
+                let dir = std::env::temp_dir().join(format!(
+                    "graph-read-{}-{component}-{ms}-{access}",
+                    std::process::id()
+                ));
+                std::fs::create_dir_all(&dir).unwrap();
+                let path = dir.join("shader.spv");
+                std::fs::write(&path, spv).unwrap();
+                let status = std::process::Command::new("spirv-val")
+                    .args(["--target-env", "vulkan1.2"])
+                    .arg(&path)
+                    .output()
+                    .unwrap();
+                assert!(
+                    status.status.success(),
+                    "{}",
+                    String::from_utf8_lossy(&status.stderr)
+                );
+                let dis = std::process::Command::new("spirv-dis")
+                    .arg(&path)
+                    .output()
+                    .unwrap();
+                assert!(dis.status.success());
+                let dis = String::from_utf8(dis.stdout).unwrap();
+                assert!(dis.contains("OpImageFetch"), "{dis}");
+                assert!(!dis.contains("OpImageRead"), "{dis}");
+                assert!(dis.contains(if ms { "Sample " } else { "Lod " }), "{dis}");
+                std::fs::remove_dir_all(dir).unwrap();
+            }
+        }
+    }
+}
+
+#[test]
+fn guarded_reads_still_reject_invalid_access_classes() {
+    for (ms, access) in [(false, 2), (false, 4), (true, 3)] {
+        let error = metal2vulkan::translate_sanitized_native_reflected_unvalidated(
+            &source("float", ms, access),
+            Stage::Kernel,
+            &std::env::temp_dir(),
+            TransformOptions::default(),
+            None,
+        )
+        .unwrap_err();
+        assert!(
+            error.contains(if access == 3 {
+                "multisampled storage"
+            } else {
+                "invalid GPU argument image access"
+            }),
+            "{error}"
+        );
+    }
+}
