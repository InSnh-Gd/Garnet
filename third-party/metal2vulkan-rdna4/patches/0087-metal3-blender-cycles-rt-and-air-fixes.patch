+        );
+        assert!(lowered.contains("switch i32 %__m2v_st_idx_0, label %__m2v_st_c0_0 ["));
+        assert!(lowered.contains("@__air_sampler_state,"));
+        assert!(lowered.contains("@__air_sampler_state.1,"));
+        assert!(lowered.contains("%res = phi { <4 x float>, i8 } [ %__m2v_st_r0_0, %__m2v_st_c0_0 ], [ %__m2v_st_r0_1, %__m2v_st_c0_1 ]"));
+        assert!(
+            lowered.contains("[ %col, %__m2v_st_m0 ]"),
+            "downstream phi must update predecessor label:\n{lowered}"
+        );
