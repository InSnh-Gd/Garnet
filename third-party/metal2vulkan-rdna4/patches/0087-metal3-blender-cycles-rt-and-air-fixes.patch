+//! Pre-parse AIR text pass: lower polymorphic placement-new storage pool fields
+//! (a fixed `[N x %Elem]` array field inside a local-only owner struct whose elements are bitcast
+//! to multiple incompatible struct layouts and/or self-referenced via stored internal pointers, such
+//! as Blender Cycles' `ShaderData.closure[64]` holding `ShaderClosure` / `*Bsdf` / `*Bssrdf` /
+//! `*Fresnel*` and `MicrofacetBsdf.fresnel`) into integer byte offsets addressing a thread-private
+//! `[K x i32]` scratch pool (`StorageClass::Private`).
+//!
+//! Floor-safe by construction:
+//! - Modules without a polymorphic `[N x %Elem]` struct array field borrow their input with zero
+//!   allocations.
+//! - Uses strict inter-procedural per-SSA dataflow so unrelated stack allocations sharing an
+//!   LLVM-deduplicated struct name (e.g. `alloca %FresnelF82Tint` used as `differential3`) are
+//!   never touched.
+//! - If any pool-derived value escapes to an unsupported operation, non-pool pointer store,
+//!   external call, or conflicting call argument, the pass aborts cleanly and returns the original
+//!   module untouched.
+
+use std::borrow::Cow;
+use std::collections::{HashMap, HashSet};
+
+use super::ir::{round_up_u64, LlType};
+use super::parse::parse_type;
+use crate::layout::{memcpy_size_align, AirDataLayout};
+
+const POOL_GLOBAL: &str = "@__m2v_storage_pool_0";
+/// Reserve the first 16 bytes so byte offset `0` unambiguously represents `null` while keeping
+/// every allocated slice 16-byte aligned.
+const POOL_NULL_GUARD_BYTES: u64 = 16;
+
+pub(super) fn lower_polymorphic_storage_pools(san_ll: &str) -> Cow<'_, str> {
+    if !san_ll.contains(" x %") {
+        return Cow::Borrowed(san_ll);
+    }
+    match rewrite_module(san_ll) {
+        Some(rewritten) => Cow::Owned(rewritten),
+        None => Cow::Borrowed(san_ll),
+    }
+}
+
+pub(super) fn lower_polymorphic_storage_pools_owned(san_ll: String) -> String {
+    if !san_ll.contains(" x %") {
+        return san_ll;
+    }
+    rewrite_module(&san_ll).unwrap_or(san_ll)
+}
+
+#[derive(Clone)]
+struct PoolSpec {
+    owner_struct: String,
+    owner_typedef_line: usize,
+    field_idx: usize,
+    elem_struct: String,
+    array_len: u32,
+    slice_bytes: u64,
+}
+
+struct ParsedFunc {
+    name: String,
+    header_line: usize,
+    body_start: usize,
+    body_end: usize,
+    params: Vec<(String, Option<String>)>, // (raw param text, optional %name)
+}
+
+struct MixedSelectInfo {
+    cond: String,
+    val_ty: String,
+    true_val: String,
+    false_val: String,
+    true_is_pool: bool,
+    false_is_pool: bool,
+}
+
+fn rewrite_module(ll: &str) -> Option<String> {
+    let data_layout = AirDataLayout::from_ir(ll).ok().flatten();
+    let lines: Vec<&str> = ll.lines().collect();
+    let (named_types, typedef_lines, last_typedef_line) = parse_named_types_with_lines(&lines);
+    if named_types.is_empty() {
+        return None;
+    }
+    let funcs = parse_functions(&lines);
+    if funcs.is_empty() {
+        return None;
+    }
+    let defined_fn_names: HashSet<&str> = funcs.iter().map(|f| f.name.as_str()).collect();
+    let opaque_ptrs = is_opaque_pointer_module(&lines);
+    let resolve = |ty: &LlType| -> LlType { resolve_type(ty, &named_types, 0) };
+
+    let (spec, pool_vals, pool_params) = detect_pool_spec(
+        ll,
+        &lines,
+        &funcs,
+        &defined_fn_names,
+        opaque_ptrs,
+        &named_types,
+        &typedef_lines,
+        &resolve,
+        data_layout.as_ref(),
+    )?;
+
+    // Locate every `alloca <owner_struct>` in the module and assign a unique non-zero 16B-aligned
+    // byte slice base in the thread-private pool.
+    let mut owner_allocas: HashMap<usize, Vec<(usize, String, u64)>> = HashMap::new();
+    let mut next_base = POOL_NULL_GUARD_BYTES;
+    for (fi, func) in funcs.iter().enumerate() {
+        for li in func.body_start..func.body_end {
+            if let Some((lhs, ty)) = parse_alloca_line(lines[li]) {
+                if ty == spec.owner_struct {
+                    owner_allocas
+                        .entry(fi)
+                        .or_default()
+                        .push((li, lhs.to_string(), next_base));
+                    next_base = next_base.checked_add(spec.slice_bytes)?;
+                }
+            }
+        }
+    }
+    if owner_allocas.is_empty() {
+        return None;
+    }
+    if next_base % 4 != 0 {
+        return None;
+    }
+    let pool_words = u32::try_from(next_base / 4).ok()?;
+    if pool_words == 0 {
+        return None;
+    }
+    if pool_vals.is_empty() {
+        return None;
+    }
+
+    let owner_ptr_ty = if opaque_ptrs {
+        "ptr".to_string()
+    } else {
+        format!("{}*", spec.owner_struct)
+    };
+    let i32_ptr_ty = if opaque_ptrs { "ptr" } else { "i32*" };
+
+    // Rewrite every function and validate every use of every pool value (abort cleanly if any
+    // instruction cannot be lowered soundly).
+    let mut func_rewrites: Vec<(usize, String, Vec<(usize, Vec<String>)>)> = Vec::new();
+    let mut fresh_counter = 0usize;
+
+    for (fi, func) in funcs.iter().enumerate() {
+        let mut new_header = lines[func.header_line].to_string();
+        let fn_has_pool_param = (0..func.params.len())
+            .any(|pi| pool_params.contains(&(func.name.clone(), pi)));
+        if fn_has_pool_param {
+            new_header = rewrite_define_header(lines[func.header_line], &func.name, &pool_params)?;
+        }
+
+        let mut line_edits: HashMap<usize, Vec<String>> = HashMap::new();
+        let mut mixed_selects: HashMap<String, MixedSelectInfo> = HashMap::new();
+
+        // Pre-scan mixed pool/non-pool pointer selects (e.g. `select i1 %c, <3 x float>* %sd_field, <3 x float>* %closure_field`
+        // or opaque `select i1 %c, ptr %sd_field, ptr %closure_field`).
+        // When every use of such a select is a plain `load`, replay the select in the value domain
+        // (loading from the pool on the pool arm and from memory on the non-pool arm).
+        for li in func.body_start..func.body_end {
+            let s = lines[li].trim();
+            let Some(sel) = parse_select_line(s) else {
+                continue;
+            };
+            if !is_ptr_type_str(sel.true_ty) || pool_vals.contains(&(fi, sel.lhs.to_string())) {
+                continue;
+            }
+            let t_pool = pool_vals.contains(&(fi, sel.true_val.to_string()));
+            let f_pool = pool_vals.contains(&(fi, sel.false_val.to_string()));
+            if t_pool == f_pool {
+                continue;
+            }
+            let expected_val_ty: Option<&str> = if sel.true_ty.trim() == "ptr" {
+                None
+            } else {
+                Some(sel.true_ty.strip_suffix('*')?.trim())
+            };
+            // Verify every use of `sel.lhs` in this function is `load <val_ty>, <ptr> %sel.lhs`.
+            let mut inferred_val_ty: Option<String> = expected_val_ty.map(str::to_string);
+            let mut has_load = false;
+            for uli in func.body_start..func.body_end {
+                if uli == li {
+                    continue;
+                }
+                let us = lines[uli].trim();
+                let urhs = us.split_once(" = ").map(|(_, r)| r).unwrap_or(us);
+                if !mentions_ssa_name(urhs, sel.lhs) {
+                    continue;
+                }
+                let Some(load) = parse_load_line(us) else {
+                    return None;
+                };
+                if load.ptr_val != sel.lhs {
+                    return None;
+                }
+                match &inferred_val_ty {
+                    Some(existing) if existing != load.val_ty => return None,
+                    None => inferred_val_ty = Some(load.val_ty.to_string()),
+                    _ => {}
+                }
+                has_load = true;
+            }
+            let Some(val_ty) = inferred_val_ty else {
+                return None;
+            };
+            if !has_load {
+                return None;
+            }
+            mixed_selects.insert(
+                sel.lhs.to_string(),
+                MixedSelectInfo {
+                    cond: sel.cond.to_string(),
+                    val_ty,
+                    true_val: sel.true_val.to_string(),
+                    false_val: sel.false_val.to_string(),
+                    true_is_pool: t_pool,
+                    false_is_pool: f_pool,
+                },
+            );
+            line_edits.insert(li, Vec::new());
+        }
+
+        // Initialize field `spec.field_idx` right after the entry block's static `alloca`s.
+        if let Some(allocas) = owner_allocas.get(&fi) {
+            let mut insert_after: Option<usize> = None;
+            let mut in_entry = false;
+            for li in func.body_start..func.body_end {
+                let t = lines[li].trim();
+                if t.is_empty() || t.starts_with(';') {
+                    continue;
+                }
+                if !in_entry {
+                    if t.ends_with(':') {
+                        in_entry = true;
+                        continue;
+                    }
+                    in_entry = true;
+                }
+                if t.contains(" = alloca ") {
+                    insert_after = Some(li);
+                } else {
+                    break;
+                }
+            }
+            for &(alloca_li, ref alloca_name, base_bytes) in allocas {
+                let anchor = insert_after
+                    .filter(|&last_a| last_a >= alloca_li)
+                    .unwrap_or(alloca_li);
+                let indent = leading_indent(lines[anchor]);
+                let init_id = fresh_counter;
+                fresh_counter += 1;
+                let entry = line_edits
+                    .entry(anchor)
+                    .or_insert_with(|| vec![lines[anchor].to_string()]);
+                entry.push(format!(
+                    "{indent}%__m2v.pool.init.{init_id} = getelementptr inbounds {owner}, {owner_ptr_ty} {alloca_name}, i64 0, i32 {fidx}",
+                    owner = spec.owner_struct,
+                    fidx = spec.field_idx
+                ));
+                entry.push(format!(
+                    "{indent}store i32 {base_bytes}, {i32_ptr_ty} %__m2v.pool.init.{init_id}, align 4"
+                ));
+            }
+        }
+
+        for li in func.body_start..func.body_end {
+            let line = lines[li];
+            let s = line.trim();
+            if s.is_empty() || s.starts_with(';') || s.ends_with(':') {
+                continue;
+            }
+            let indent = leading_indent(line);
+
+            if line_edits.contains_key(&li) {
+                continue;
+            }
+
+            if let Some(load) = parse_load_line(s) {
+                if let Some(ms) = mixed_selects.get(load.ptr_val) {
+                    let mut emitted = Vec::new();
+                    let tv_name = fresh_name("mst", &mut fresh_counter);
+                    let fv_name = fresh_name("msf", &mut fresh_counter);
+                    let arm_ptr_ty = if opaque_ptrs {
+                        "ptr".to_string()
+                    } else {
+                        format!("{}*", ms.val_ty)
+                    };
+                    if ms.true_is_pool {
+                        emit_pool_load(
+                            &mut emitted,
+                            indent,
+                            &tv_name,
+                            &ms.val_ty,
+                            &ms.true_val,
+                            pool_words,
+                            opaque_ptrs,
+                            &resolve,
+                            &mut fresh_counter,
+                        )?;
+                    } else {
+                        emitted.push(format!(
+                            "{indent}{tv_name} = load {ty}, {arm_ptr_ty} {ptr}, align 4",
+                            ty = ms.val_ty,
+                            ptr = ms.true_val
+                        ));
+                    }
+                    if ms.false_is_pool {
+                        emit_pool_load(
+                            &mut emitted,
+                            indent,
+                            &fv_name,
+                            &ms.val_ty,
+                            &ms.false_val,
+                            pool_words,
+                            opaque_ptrs,
+                            &resolve,
+                            &mut fresh_counter,
+                        )?;
+                    } else {
+                        emitted.push(format!(
+                            "{indent}{fv_name} = load {ty}, {arm_ptr_ty} {ptr}, align 4",
+                            ty = ms.val_ty,
+                            ptr = ms.false_val
+                        ));
+                    }
+                    emitted.push(format!(
+                        "{indent}{} = select i1 {}, {ty} {tv_name}, {ty} {fv_name}",
+                        load.lhs,
+                        ms.cond,
+                        ty = ms.val_ty
+                    ));
+                    line_edits.insert(li, emitted);
+                    continue;
+                }
+            }
+
+            // Check if this line is a seed GEP.
+            if let Some(gep) = parse_gep_line(s) {
+                if is_owner_pool_seed_gep(&gep, &spec) {
+                    let mut emitted = Vec::new();
+                    let id = fresh_counter;
+                    fresh_counter += 1;
+                    let base_ptr = format!("%__m2v.pbase.{id}");
+                    let base_off = format!("%__m2v.poff.{id}");
+                    emitted.push(format!(
+                        "{indent}{base_ptr} = getelementptr inbounds {owner}, {owner_ptr_ty} {sd}, i64 0, i32 {fidx}",
+                        owner = spec.owner_struct,
+                        sd = gep.base_val,
+                        fidx = spec.field_idx
+                    ));
+                    emitted.push(format!(
+                        "{indent}{base_off} = load i32, {i32_ptr_ty} {base_ptr}, align 4"
+                    ));
+                    let field_array_ty = LlType::Array(
+                        Box::new(LlType::Named(spec.elem_struct.clone())),
+                        spec.array_len,
+                    );
+                    emit_gep_byte_offset(
+                        &mut emitted,
+                        indent,
+                        gep.lhs,
+                        &base_off,
+                        &field_array_ty,
+                        &gep.indices[2..],
+                        false,
+                        &resolve,
+                        data_layout.as_ref(),
+                        &mut fresh_counter,
+                    )?;
+                    line_edits.insert(li, emitted);
+                    continue;
+                }
+            }
+
+            // Check if any call targets a function with `pool_params` (even if passing `null`).
+            let call_info = parse_call_line(line);
+            let call_has_pool_param = call_info.as_ref().is_some_and(|c| {
+                (0..c.args.len()).any(|ai| pool_params.contains(&(c.callee.to_string(), ai)))
+            });
+
+            // Check if RHS references any pool value.
+            let rhs_part = s.split_once(" = ").map(|(_, r)| r).unwrap_or(s);
+            let rhs_uses_pool = mentions_any_pool_val(rhs_part, fi, &pool_vals);
+
+            if !rhs_uses_pool && !call_has_pool_param {
+                continue;
+            }
+
+            if let Some((lhs, src_ty, src_val, dst_ty)) = parse_bitcast_line(s) {
+                if !is_ptr_type_str(src_ty)
+                    || !is_ptr_type_str(dst_ty)
+                    || !pool_vals.contains(&(fi, src_val.to_string()))
+                {
+                    return None;
+                }
+                line_edits.insert(li, vec![format!("{indent}{lhs} = add i32 {src_val}, 0")]);
+                continue;
+            }
+
+            if let Some(gep) = parse_gep_line(s) {
+                if !pool_vals.contains(&(fi, gep.base_val.to_string())) {
+                    return None;
+                }
+                let src_ty = parse_type(gep.src_ty).ok()?;
+                let mut emitted = Vec::new();
+                emit_gep_byte_offset(
+                    &mut emitted,
+                    indent,
+                    gep.lhs,
+                    gep.base_val,
+                    &src_ty,
+                    &gep.indices,
+                    true,
+                    &resolve,
+                    data_layout.as_ref(),
+                    &mut fresh_counter,
+                )?;
+                line_edits.insert(li, emitted);
+                continue;
+            }
+
+            if let Some(phi) = parse_phi_line(s) {
+                let mut arms = Vec::with_capacity(phi.incomings.len());
+                for (val, blk) in &phi.incomings {
+                    let mapped = map_pool_operand(val, fi, &pool_vals)?;
+                    arms.push(format!("[ {mapped}, {blk} ]"));
+                }
+                line_edits.insert(
+                    li,
+                    vec![format!("{indent}{} = phi i32 {}", phi.lhs, arms.join(", "))],
+                );
+                continue;
+            }
+
+            if let Some(sel) = parse_select_line(s) {
+                let tv = map_pool_operand(sel.true_val, fi, &pool_vals)?;
+                let fv = map_pool_operand(sel.false_val, fi, &pool_vals)?;
+                line_edits.insert(
+                    li,
+                    vec![format!(
+                        "{indent}{} = select i1 {}, i32 {tv}, i32 {fv}",
+                        sel.lhs, sel.cond
+                    )],
+                );
+                continue;
+            }
+
+            if let Some(icmp) = parse_icmp_line(s) {
+                if icmp.pred != "eq" && icmp.pred != "ne" {
+                    return None;
+                }
+                let a = map_pool_operand(icmp.lhs_val, fi, &pool_vals)?;
+                let b = map_pool_operand(icmp.rhs_val, fi, &pool_vals)?;
+                line_edits.insert(
+                    li,
+                    vec![format!(
+                        "{indent}{} = icmp {} i32 {a}, {b}",
+                        icmp.lhs, icmp.pred
+                    )],
+                );
+                continue;
+            }
+
+            if let Some(load) = parse_load_line(s) {
+                if !pool_vals.contains(&(fi, load.ptr_val.to_string())) {
+                    return None;
+                }
+                let mut emitted = Vec::new();
+                emit_pool_load(
+                    &mut emitted,
+                    indent,
+                    load.lhs,
+                    load.val_ty,
+                    load.ptr_val,
+                    pool_words,
+                    opaque_ptrs,
+                    &resolve,
+                    &mut fresh_counter,
+                )?;
+                line_edits.insert(li, emitted);
+                continue;
+            }
+
+            if let Some(store) = parse_store_line(s) {
+                if !pool_vals.contains(&(fi, store.ptr_val.to_string())) {
+                    // Pool pointer escaping into non-pool memory -> abort safely.
+                    return None;
+                }
+                let mut emitted = Vec::new();
+                emit_pool_store(
+                    &mut emitted,
+                    indent,
+                    store.val_ty,
+                    store.val,
+                    store.ptr_val,
+                    pool_words,
+                    opaque_ptrs,
+                    fi,
+                    &pool_vals,
+                    &resolve,
+                    &mut fresh_counter,
+                )?;
+                line_edits.insert(li, emitted);
+                continue;
+            }
+
+            if let Some(call) = call_info {
+                if !s.contains(" = ") {
+                    if let Some(emitted) = try_emit_pool_memcpy(
+                        indent,
+                        &call,
+                        pool_words,
+                        opaque_ptrs,
+                        fi,
+                        &pool_vals,
+                        &mut fresh_counter,
+                    ) {
+                        line_edits.insert(li, emitted);
+                        continue;
+                    }
+                }
+                if !defined_fn_names.contains(call.callee) {
+                    return None;
+                }
+                let rewritten_call =
+                    rewrite_call_line(line, &call, fi, &pool_vals, &pool_params)?;
+                line_edits.insert(li, vec![rewritten_call]);
+                continue;
+            }
+
+            // Any other instruction referencing a pool value (e.g. `ret`, `ptrtoint`, etc.) ->
+            // abort cleanly.
+            return None;
+        }
+
+        let mut sorted_edits: Vec<(usize, Vec<String>)> = line_edits.into_iter().collect();
+        sorted_edits.sort_by_key(|(li, _)| *li);
+        func_rewrites.push((func.header_line, new_header, sorted_edits));
+    }
+
+    // Apply all edits to the module lines.
+    let mut replaced_owner_typedef =
+        rewrite_struct_typedef(lines[spec.owner_typedef_line], spec.field_idx)?;
+    // Keep exact line text.
+    let _ = &mut replaced_owner_typedef;
+
+    let mut line_map: HashMap<usize, Vec<String>> = HashMap::new();
+    line_map.insert(spec.owner_typedef_line, vec![replaced_owner_typedef]);
+    for (header_li, new_header, edits) in func_rewrites {
+        if new_header != lines[header_li] {
+            line_map.insert(header_li, vec![new_header]);
+        }
+        for (li, repl) in edits {
+            line_map.insert(li, repl);
+        }
+    }
+
+    let pool_decl = format!(
+        "{POOL_GLOBAL} = internal global [{pool_words} x i32] zeroinitializer, align 16"
+    );
+
+    let mut out = String::with_capacity(ll.len() + ll.len() / 5 + 1024);
+    for (li, line) in lines.iter().enumerate() {
+        if let Some(repl) = line_map.get(&li) {
+            for r in repl {
+                out.push_str(r);
+                out.push('\n');
+            }
+        } else {
+            out.push_str(line);
+            out.push('\n');
+        }
+        if li == last_typedef_line {
+            out.push_str(&pool_decl);
+            out.push('\n');
+        }
+    }
+    Some(out)
+}
+
+fn is_opaque_pointer_module(lines: &[&str]) -> bool {
+    lines.iter().any(|l| {
+        let t = l.trim();
+        t.contains(", ptr ")
+            || t.contains("= bitcast ptr ")
+            || t.contains("= load ptr,")
+            || t.starts_with("store ptr ")
+    })
+}
+
+fn propagate_pool_values(
+    lines: &[&str],
+    funcs: &[ParsedFunc],
+    defined_fn_names: &HashSet<&str>,
+    spec: &PoolSpec,
+) -> (HashSet<(usize, String)>, HashSet<(String, usize)>) {
+    let mut pool_vals: HashSet<(usize, String)> = HashSet::new();
+    let mut pool_params: HashSet<(String, usize)> = HashSet::new();
+
+    // Seed: any `getelementptr [inbounds] <owner_struct>, (<owner_struct>*|ptr) %sd, 0, <field_idx>[, ...]`
+    for (fi, func) in funcs.iter().enumerate() {
+        for li in func.body_start..func.body_end {
+            if let Some(gep) = parse_gep_line(lines[li]) {
+                if is_owner_pool_seed_gep(&gep, spec) {
+                    pool_vals.insert((fi, gep.lhs.to_string()));
+                }
+            }
+        }
+    }
+    if pool_vals.is_empty() {
+        return (pool_vals, pool_params);
+    }
+
+    for _ in 0..64 {
+        let before = (pool_vals.len(), pool_params.len());
+        for (fi, func) in funcs.iter().enumerate() {
+            for (pi, (_, pname)) in func.params.iter().enumerate() {
+                if pool_params.contains(&(func.name.clone(), pi)) {
+                    if let Some(name) = pname {
+                        pool_vals.insert((fi, name.clone()));
+                    }
+                }
+            }
+            for li in func.body_start..func.body_end {
+                let s = lines[li].trim();
+                if let Some((lhs, src_ty, src_val, dst_ty)) = parse_bitcast_line(s) {
+                    if is_ptr_type_str(src_ty)
+                        && is_ptr_type_str(dst_ty)
+                        && pool_vals.contains(&(fi, src_val.to_string()))
+                    {
+                        pool_vals.insert((fi, lhs.to_string()));
+                    }
+                } else if let Some(gep) = parse_gep_line(s) {
+                    if pool_vals.contains(&(fi, gep.base_val.to_string())) {
+                        pool_vals.insert((fi, gep.lhs.to_string()));
+                    }
+                } else if let Some(phi) = parse_phi_line(s) {
+                    if is_ptr_type_str(phi.ty)
+                        && phi
+                            .incomings
+                            .iter()
+                            .any(|(v, _)| pool_vals.contains(&(fi, (*v).to_string())))
+                    {
+                        pool_vals.insert((fi, phi.lhs.to_string()));
+                    }
+                } else if let Some(sel) = parse_select_line(s) {
+                    if is_ptr_type_str(sel.true_ty) {
+                        let t_pool = pool_vals.contains(&(fi, sel.true_val.to_string()));
+                        let f_pool = pool_vals.contains(&(fi, sel.false_val.to_string()));
+                        let t_trivial = matches!(sel.true_val, "null" | "undef" | "poison");
+                        let f_trivial = matches!(sel.false_val, "null" | "undef" | "poison");
+                        if (t_pool && (f_pool || f_trivial)) || (f_pool && (t_pool || t_trivial)) {
+                            pool_vals.insert((fi, sel.lhs.to_string()));
+                        }
+                    }
+                } else if let Some(load) = parse_load_line(s) {
+                    if pool_vals.contains(&(fi, load.ptr_val.to_string()))
+                        && is_local_ptr_type_str(load.val_ty)
+                    {
+                        pool_vals.insert((fi, load.lhs.to_string()));
+                    }
+                } else if let Some(call) = parse_call_line(s) {
+                    if defined_fn_names.contains(call.callee) {
+                        for (ai, arg) in call.args.iter().enumerate() {
+                            if let Some((_, val)) = split_typed_operand(arg) {
+                                if pool_vals.contains(&(fi, val.to_string())) {
+                                    pool_params.insert((call.callee.to_string(), ai));
+                                }
+                            }
+                        }
+                    }
+                }
+            }
+        }
+        if (pool_vals.len(), pool_params.len()) == before {
+            break;
+        }
+    }
+
+    (pool_vals, pool_params)
+}
+
+#[allow(clippy::too_many_arguments, clippy::type_complexity)]
+fn detect_pool_spec(
+    ll: &str,
+    lines: &[&str],
+    funcs: &[ParsedFunc],
+    defined_fn_names: &HashSet<&str>,
+    opaque_ptrs: bool,
+    named_types: &HashMap<String, LlType>,
+    typedef_lines: &HashMap<String, usize>,
+    resolve: &impl Fn(&LlType) -> LlType,
+    data_layout: Option<&AirDataLayout>,
+) -> Option<(PoolSpec, HashSet<(usize, String)>, HashSet<(String, usize)>)> {
+    // Collect typed-pointer bitcasts `%Src*` -> `%Dst*` (`Src != Dst`).
+    let mut polymorphic_elem_types: HashSet<String> = HashSet::new();
+    for line in lines {
+        let s = line.trim();
+        if !s.contains(" = bitcast ") {
+            continue;
+        }
+        let Some((_, src_ty, _, dst_ty)) = parse_bitcast_line(s) else {
+            continue;
+        };
+        let Some(src_base) = src_ty.strip_suffix('*') else {
+            continue;
+        };
+        let Some(dst_base) = dst_ty.strip_suffix('*') else {
+            continue;
+        };
+        if src_base.starts_with('%')
+            && !src_base.contains(' ')
+            && dst_base != src_base
+            && dst_base.starts_with('%')
+            && !dst_base.contains(' ')
+        {
+            polymorphic_elem_types.insert(src_base.to_string());
+        }
+    }
+    if polymorphic_elem_types.is_empty() && !opaque_ptrs {
+        return None;
+    }
+
+    // Sort candidate owner structs deterministically by name.
+    let mut owner_names: Vec<&String> = named_types.keys().collect();
+    owner_names.sort();
+
+    for owner in owner_names {
+        let Some(LlType::Struct(fields)) = named_types.get(owner) else {
+            continue;
+        };
+        let Some(&td_line) = typedef_lines.get(owner) else {
+            continue;
+        };
+        // Skip packed structs (`<{ ... }>`).
+        if lines[td_line].contains("<{") {
+            continue;
+        }
+        // Require that `owner` only lives in local allocas (never addrspace(1|2|3)).
+        let as_pat = format!("{owner} addrspace(");
+        let opaque_as_pat = format!(" {owner}, ptr addrspace(");
+        if ll.contains(&as_pat) || ll.contains(&opaque_as_pat) {
+            continue;
+        }
+        let alloca_pat = format!("= alloca {owner}");
+        if !ll.contains(&alloca_pat) {
+            continue;
+        }
+        for (fi, field) in fields.iter().enumerate() {
+            let LlType::Array(elem, len) = field else {
+                continue;
+            };
+            if *len < 2 {
+                continue;
+            }
+            let LlType::Named(elem_name) = elem.as_ref() else {
+                continue;
+            };
+            let typed_poly = polymorphic_elem_types.contains(elem_name);
+            if !typed_poly && !opaque_ptrs {
+                continue;
+            }
+            // Confirm `elem_name` is a struct and compute its exact byte stride.
+            if !matches!(resolve(elem), LlType::Struct(_)) {
+                continue;
+            }
+            let Some((esz, ealign)) = memcpy_size_align(elem, resolve, data_layout) else {
+                continue;
+            };
+            let elem_stride = round_up_u64(esz, ealign);
+            if elem_stride == 0 || elem_stride % 4 != 0 {
+                continue;
+            }
+            let raw_slice = elem_stride.checked_mul(u64::from(*len))?;
+            let slice_bytes = round_up_u64(raw_slice, 16);
+            let spec = PoolSpec {
+                owner_struct: owner.clone(),
+                owner_typedef_line: td_line,
+                field_idx: fi,
+                elem_struct: elem_name.clone(),
+                array_len: *len,
+                slice_bytes,
+            };
+            let (pool_vals, pool_params) =
+                propagate_pool_values(lines, funcs, defined_fn_names, &spec);
+            if pool_vals.is_empty() {
+                continue;
+            }
+            if !typed_poly {
+                // In opaque-pointer IR, confirm polymorphism by checking that at least one
+                // pool-derived pointer is indexed via `getelementptr` as a DIFFERENT named struct
+                // type (e.g. `ShaderClosure` -> `MicrofacetBsdf` / `SheenBsdf` / `Fresnel*`).
+                let mut reinterpreted_as_other_struct = false;
+                'check_poly: for (fidx, func) in funcs.iter().enumerate() {
+                    for li in func.body_start..func.body_end {
+                        if let Some(gep) = parse_gep_line(lines[li]) {
+                            if pool_vals.contains(&(fidx, gep.base_val.to_string()))
+                                && gep.src_ty.starts_with('%')
+                                && gep.src_ty != elem_name.as_str()
+                                && named_types
+                                    .get(gep.src_ty)
+                                    .is_some_and(|t| matches!(resolve(t), LlType::Struct(_)))
+                            {
+                                reinterpreted_as_other_struct = true;
+                                break 'check_poly;
+                            }
+                        }
+                    }
+                }
+                if !reinterpreted_as_other_struct {
+                    continue;
+                }
+            }
+            return Some((spec, pool_vals, pool_params));
+        }
+    }
+    None
+}
+
+fn parse_named_types_with_lines(
+    lines: &[&str],
+) -> (HashMap<String, LlType>, HashMap<String, usize>, usize) {
+    let mut map = HashMap::new();
+    let mut td_lines = HashMap::new();
+    let mut last_line = 0usize;
+    for (idx, line) in lines.iter().enumerate() {
+        let trimmed = line.trim();
+        if !trimmed.starts_with('%') {
+            continue;
+        }
+        let Some((lhs, rhs)) = trimmed.split_once(" = type ") else {
+            continue;
+        };
+        let name = lhs.trim();
+        let rhs = rhs.trim();
+        if rhs == "opaque" {
+            continue;
+        }
+        if let Ok(ty) = parse_type(rhs) {
+            map.insert(name.to_string(), ty);
+            td_lines.insert(name.to_string(), idx);
+            last_line = idx;
+        }
+    }
+    (map, td_lines, last_line)
+}
+
+fn resolve_type(ty: &LlType, named: &HashMap<String, LlType>, depth: usize) -> LlType {
+    if depth > 32 {
+        return ty.clone();
+    }
+    match ty {
+        LlType::Int(1) => LlType::Bool,
+        LlType::Named(name) => named
+            .get(name)
+            .map(|inner| resolve_type(inner, named, depth + 1))
+            .unwrap_or_else(|| ty.clone()),
+        LlType::Vector(elem, 1) => resolve_type(elem, named, depth + 1),
+        LlType::Vector(elem, lanes) => {
+            LlType::Vector(Box::new(resolve_type(elem, named, depth + 1)), *lanes)
+        }
+        LlType::Array(elem, len) => {
+            LlType::Array(Box::new(resolve_type(elem, named, depth + 1)), *len)
+        }
+        LlType::Struct(fields) => LlType::Struct(
+            fields
+                .iter()
+                .map(|f| resolve_type(f, named, depth + 1))
+                .collect(),
+        ),
+        _ => ty.clone(),
+    }
+}
+
+fn parse_functions(lines: &[&str]) -> Vec<ParsedFunc> {
+    let mut funcs = Vec::new();
+    let mut i = 0usize;
+    while i < lines.len() {
+        let trimmed = lines[i].trim_start();
+        if !trimmed.starts_with("define ") || !trimmed.trim_end().ends_with('{') {
+            i += 1;
+            continue;
+        }
+        let body_start = i + 1;
+        let mut body_end = body_start;
+        while body_end < lines.len() && lines[body_end].trim() != "}" {
+            body_end += 1;
+        }
+        if body_end >= lines.len() {
+            break;
+        }
+        if let Some((name, raw_params)) = parse_at_paren_list(lines[i]) {
+            let params = raw_params
+                .into_iter()
+                .map(|p| {
+                    let pname = p
+                        .split_whitespace()
+                        .last()
+                        .filter(|tok| tok.starts_with('%'))
+                        .map(|s| s.to_string());
+                    (p.to_string(), pname)
+                })
+                .collect();
+            funcs.push(ParsedFunc {
+                name: name.to_string(),
+                header_line: i,
+                body_start,
+                body_end,
+                params,
+            });
+        }
+        i = body_end + 1;
+    }
+    funcs
+}
+
+fn parse_at_paren_list(line: &str) -> Option<(&str, Vec<&str>)> {
+    let at = line.find('@')?;
+    let lp = line[at..].find('(')? + at;
+    let name = line[at + 1..lp].trim();
+    let rp = find_matching_paren(line, lp)?;
+    let inner = &line[lp + 1..rp];
+    Some((name, split_top_level(inner, ',')))
+}
+
+fn find_matching_paren(s: &str, open_idx: usize) -> Option<usize> {
+    let bytes = s.as_bytes();
+    let mut depth = 0usize;
+    let mut in_quote = false;
+    for (idx, &b) in bytes.iter().enumerate().skip(open_idx) {
+        if b == b'"' {
+            in_quote = !in_quote;
+        } else if !in_quote {
+            if b == b'(' {
+                depth += 1;
+            } else if b == b')' {
+                depth -= 1;
+                if depth == 0 {
+                    return Some(idx);
+                }
+            }
+        }
+    }
+    None
+}
+
+fn split_top_level(s: &str, sep: char) -> Vec<&str> {
+    let mut out = Vec::new();
+    let mut start = 0usize;
+    let mut depth = 0usize;
+    let mut in_quote = false;
+    for (idx, ch) in s.char_indices() {
+        if ch == '"' {
+            in_quote = !in_quote;
+        } else if !in_quote {
+            match ch {
+                '(' | '[' | '{' | '<' => depth += 1,
+                ')' | ']' | '}' | '>' => depth = depth.saturating_sub(1),
+                c if c == sep && depth == 0 => {
+                    let piece = s[start..idx].trim();
+                    if !piece.is_empty() {
+                        out.push(piece);
+                    }
+                    start = idx + ch.len_utf8();
+                }
+                _ => {}
+            }
+        }
+    }
+    let tail = s[start..].trim();
+    if !tail.is_empty() {
+        out.push(tail);
+    }
+    out
+}
+
+fn leading_indent(line: &str) -> &str {
+    &line[..line.len() - line.trim_start().len()]
+}
+
+fn is_ptr_type_str(ty: &str) -> bool {
+    let t = ty.trim();
+    t.ends_with('*') || t == "ptr" || t.starts_with("ptr addrspace(")
+}
+
+fn is_local_ptr_type_str(ty: &str) -> bool {
+    let t = ty.trim();
+    t == "ptr" || (t.ends_with('*') && !t.contains("addrspace("))
+}
+
+fn parse_alloca_line(line: &str) -> Option<(&str, &str)> {
+    let trimmed = line.trim();
+    let (lhs, rhs) = trimmed.split_once(" = alloca ")?;
+    let lhs = lhs.trim();
+    if !lhs.starts_with('%') {
+        return None;
+    }
+    let ty = rhs.split(',').next()?.trim();
+    Some((lhs, ty))
+}
+
+fn parse_bitcast_line(line: &str) -> Option<(&str, &str, &str, &str)> {
+    let trimmed = line.trim();
+    let (lhs, rhs) = trimmed.split_once(" = bitcast ")?;
+    let lhs = lhs.trim();
+    if !lhs.starts_with('%') {
+        return None;
+    }
+    let (src_part, dst_part) = rhs.split_once(" to ")?;
+    let dst_ty = dst_part.split(',').next()?.trim();
+    let (src_ty, src_val) = split_typed_operand(src_part.trim())?;
+    Some((lhs, src_ty, src_val, dst_ty))
+}
+
+struct GepLine<'a> {
+    lhs: &'a str,
+    src_ty: &'a str,
+    base_val: &'a str,
+    indices: Vec<(&'a str, &'a str)>,
+}
+
+fn parse_gep_line(line: &str) -> Option<GepLine<'_>> {
+    let trimmed = line.trim();
+    let (lhs, rhs) = trimmed.split_once(" = getelementptr ")?;
+    let lhs = lhs.trim();
+    if !lhs.starts_with('%') {
+        return None;
+    }
+    let rhs = rhs.strip_prefix("inbounds ").unwrap_or(rhs).trim();
+    let parts = split_top_level(rhs, ',');
+    if parts.len() < 3 {
+        return None;
+    }
+    let src_ty = parts[0];
+    let (_, base_val) = split_typed_operand(parts[1])?;
+    let mut indices = Vec::with_capacity(parts.len() - 2);
+    for &p in &parts[2..] {
+        if p.starts_with('!') {
+            break;
+        }
+        let (ity, ival) = split_typed_operand(p)?;
+        indices.push((ity, ival));
+    }
+    if indices.is_empty() {
+        return None;
+    }
+    Some(GepLine {
+        lhs,
+        src_ty,
+        base_val,
+        indices,
+    })
+}
+
+fn is_owner_pool_seed_gep(gep: &GepLine<'_>, spec: &PoolSpec) -> bool {
+    if gep.src_ty != spec.owner_struct || gep.indices.len() < 2 {
+        return false;
+    }
+    let Ok(idx0) = gep.indices[0].1.parse::<i64>() else {
+        return false;
+    };
+    let Ok(idx1) = gep.indices[1].1.parse::<usize>() else {
+        return false;
+    };
+    idx0 == 0 && idx1 == spec.field_idx
+}
+
+struct PhiLine<'a> {
+    lhs: &'a str,
+    ty: &'a str,
+    incomings: Vec<(&'a str, &'a str)>,
+}
+
+fn parse_phi_line(line: &str) -> Option<PhiLine<'_>> {
+    let trimmed = line.trim();
+    let (lhs, rhs) = trimmed.split_once(" = phi ")?;
+    let lhs = lhs.trim();
+    if !lhs.starts_with('%') {
+        return None;
+    }
+    // Strip optional fast-math flags before type (not expected on pointer phis, but safe).
+    let bracket = rhs.find('[')?;
+    let ty = rhs[..bracket].trim();
+    let mut incomings = Vec::new();
+    let mut rest = &rhs[bracket..];
+    while let Some(open) = rest.find('[') {
+        let close = rest[open + 1..].find(']')? + open + 1;
+        let inner = &rest[open + 1..close];
+        let (val, blk) = inner.split_once(',')?;
+        incomings.push((val.trim(), blk.trim()));
+        rest = &rest[close + 1..];
+    }
+    if incomings.is_empty() {
+        return None;
+    }
+    Some(PhiLine { lhs, ty, incomings })
+}
+
+struct SelectLine<'a> {
+    lhs: &'a str,
+    cond: &'a str,
+    true_ty: &'a str,
+    true_val: &'a str,
+    false_val: &'a str,
+}
+
+fn parse_select_line(line: &str) -> Option<SelectLine<'_>> {
+    let trimmed = line.trim();
+    let (lhs, rhs) = trimmed.split_once(" = select ")?;
+    let lhs = lhs.trim();
+    if !lhs.starts_with('%') {
+        return None;
+    }
+    let parts = split_top_level(rhs, ',');
+    if parts.len() < 3 {
+        return None;
+    }
+    // Strip optional fast-math flags before `i1 <cond>`.
+    let cond_part = parts[0];
+    let i1_pos = cond_part.find("i1 ")?;
+    let cond = cond_part[i1_pos + 3..].trim();
+    let (true_ty, true_val) = split_typed_operand(parts[1])?;
+    let (_, false_val) = split_typed_operand(parts[2])?;
+    Some(SelectLine {
+        lhs,
+        cond,
+        true_ty,
+        true_val,
+        false_val,
+    })
+}
+
+struct IcmpLine<'a> {
+    lhs: &'a str,
+    pred: &'a str,
+    lhs_val: &'a str,
+    rhs_val: &'a str,
+}
+
+fn parse_icmp_line(line: &str) -> Option<IcmpLine<'_>> {
+    let trimmed = line.trim();
+    let (lhs, rhs) = trimmed.split_once(" = icmp ")?;
+    let lhs = lhs.trim();
+    if !lhs.starts_with('%') {
+        return None;
+    }
+    let (pred, rest) = rhs.split_once(char::is_whitespace)?;
+    let parts = split_top_level(rest.trim(), ',');
+    if parts.len() < 2 {
+        return None;
+    }
+    let (_, lhs_val) = split_typed_operand(parts[0])?;
+    let rhs_val = parts[1].trim();
+    Some(IcmpLine {
+        lhs,
+        pred,
+        lhs_val,
+        rhs_val,
+    })
+}
+
+struct LoadLine<'a> {
+    lhs: &'a str,
+    val_ty: &'a str,
+    ptr_val: &'a str,
+}
+
+fn parse_load_line(line: &str) -> Option<LoadLine<'_>> {
+    let trimmed = line.trim();
+    let (lhs, rhs) = trimmed.split_once(" = load ")?;
+    let lhs = lhs.trim();
+    if !lhs.starts_with('%') {
+        return None;
+    }
+    let rhs = rhs.strip_prefix("volatile ").unwrap_or(rhs).trim();
+    let parts = split_top_level(rhs, ',');
+    if parts.len() < 2 {
+        return None;
+    }
+    let val_ty = parts[0].trim();
+    let (_, ptr_val) = split_typed_operand(parts[1])?;
+    Some(LoadLine {
+        lhs,
+        val_ty,
+        ptr_val,
+    })
+}
+
+struct StoreLine<'a> {
+    val_ty: &'a str,
+    val: &'a str,
+    ptr_val: &'a str,
+}
+
+fn parse_store_line(line: &str) -> Option<StoreLine<'_>> {
+    let trimmed = line.trim();
+    let rhs = trimmed.strip_prefix("store ")?;
+    let rhs = rhs.strip_prefix("volatile ").unwrap_or(rhs).trim();
+    let parts = split_top_level(rhs, ',');
+    if parts.len() < 2 {
+        return None;
+    }
+    let (val_ty, val) = split_typed_value(parts[0])?;
+    let (_, ptr_val) = split_typed_operand(parts[1])?;
+    Some(StoreLine {
+        val_ty,
+        val,
+        ptr_val,
+    })
+}
+
+struct CallLine<'a> {
+    callee: &'a str,
+    lp_idx: usize,
+    rp_idx: usize,
+    args: Vec<&'a str>,
+}
+
+fn parse_call_line(line: &str) -> Option<CallLine<'_>> {
+    let trimmed = line.trim();
+    let rhs = trimmed.split_once(" = ").map(|(_, r)| r).unwrap_or(trimmed);
+    if !(rhs.starts_with("call ")
+        || rhs.starts_with("tail call ")
+        || rhs.starts_with("musttail call "))
+    {
+        return None;
+    }
+    let at = line.find('@')?;
+    let lp_idx = line[at..].find('(')? + at;
+    let callee = line[at + 1..lp_idx].trim();
+    let rp_idx = find_matching_paren(line, lp_idx)?;
+    let args = split_top_level(&line[lp_idx + 1..rp_idx], ',');
+    Some(CallLine {
+        callee,
+        lp_idx,
+        rp_idx,
+        args,
+    })
+}
+
+/// Split `<type> [attrs...] <value>` where `<value>` is a single token (SSA `%name`, `null`,
+/// `undef`, `poison`, integer/float constant).
+fn split_typed_operand(s: &str) -> Option<(&str, &str)> {
+    let s = s.trim();
+    let ws = s.rfind(char::is_whitespace)?;
+    let val = s[ws + 1..].trim();
+    let ty = s[..ws].trim();
+    if ty.is_empty() || val.is_empty() {
+        return None;
+    }
+    Some((ty, val))
+}
+
+/// Split `<type> <value>` allowing vector literals like `<3 x float> <float 1.0, float 1.0, float 1.0>`.
+fn split_typed_value(s: &str) -> Option<(&str, &str)> {
+    let s = s.trim();
+    if s.starts_with('<') {
+        // Find end of vector type `<N x elem>`.
+        let mut depth = 0usize;
+        let mut type_end = None;
+        for (i, ch) in s.char_indices() {
+            if ch == '<' {
+                depth += 1;
+            } else if ch == '>' {
+                depth -= 1;
+                if depth == 0 {
+                    type_end = Some(i + 1);
+                    break;
+                }
+            }
+        }
+        let end = type_end?;
+        // Include any trailing `*` if pointer-to-vector.
+        let rest = &s[end..];
+        let ptr_stars = rest.bytes().take_while(|&b| b == b'*').count();
+        let ty = &s[..end + ptr_stars];
+        let val = s[end + ptr_stars..].trim();
+        if !val.is_empty() {
+            return Some((ty, val));
+        }
+    }
+    split_typed_operand(s)
+}
+
+fn mentions_ssa_name(text: &str, needle: &str) -> bool {
+    let bytes = text.as_bytes();
+    let mut i = 0usize;
+    while i < bytes.len() {
+        if bytes[i] == b'%' {
+            let start = i;
+            i += 1;
+            if i < bytes.len() && bytes[i] == b'"' {
+                i += 1;
+                while i < bytes.len() && bytes[i] != b'"' {
+                    i += 1;
+                }
+                if i < bytes.len() {
+                    i += 1;
+                }
+                continue;
+            }
+            while i < bytes.len()
+                && (bytes[i].is_ascii_alphanumeric()
+                    || matches!(bytes[i], b'_' | b'.' | b'$' | b'-'))
+            {
+                i += 1;
+            }
+            if &text[start..i] == needle {
+                return true;
+            }
+        } else {
+            i += 1;
+        }
+    }
+    false
+}
+
+fn mentions_any_pool_val(text: &str, fi: usize, pool_vals: &HashSet<(usize, String)>) -> bool {
+    let bytes = text.as_bytes();
+    let mut i = 0usize;
+    while i < bytes.len() {
+        if bytes[i] == b'%' {
+            let start = i;
+            i += 1;
+            if i < bytes.len() && bytes[i] == b'"' {
+                // Skip quoted type names like `%"struct.Foo"`.
+                i += 1;
+                while i < bytes.len() && bytes[i] != b'"' {
+                    i += 1;
+                }
+                if i < bytes.len() {
+                    i += 1;
+                }
+                continue;
+            }
+            while i < bytes.len()
+                && (bytes[i].is_ascii_alphanumeric()
+                    || matches!(bytes[i], b'_' | b'.' | b'$' | b'-'))
+            {
+                i += 1;
+            }
+            if i > start + 1 {
+                let tok = &text[start..i];
+                if pool_vals.contains(&(fi, tok.to_string())) {
+                    return true;
+                }
+            }
+        } else {
+            i += 1;
+        }
+    }
+    false
+}
+
+fn map_pool_operand(
+    val: &str,
+    fi: usize,
+    pool_vals: &HashSet<(usize, String)>,
+) -> Option<String> {
+    match val {
+        "null" => Some("0".to_string()),
+        "undef" => Some("undef".to_string()),
+        "poison" => Some("poison".to_string()),
+        other if pool_vals.contains(&(fi, other.to_string())) => Some(other.to_string()),
+        _ => None,
+    }
+}
+
+#[allow(clippy::too_many_arguments)]
+fn emit_gep_byte_offset(
+    emitted: &mut Vec<String>,
+    indent: &str,
+    lhs: &str,
+    base_off: &str,
+    src_ty: &LlType,
+    indices: &[(&str, &str)],
+    first_is_ptr_stride: bool,
+    resolve: &impl Fn(&LlType) -> LlType,
+    data_layout: Option<&AirDataLayout>,
+    fresh: &mut usize,
+) -> Option<()> {
+    let mut const_off: i64 = 0;
+    let mut dyn_terms: Vec<(String, String, i64)> = Vec::new(); // (idx_ty, idx_val, stride)
+    let mut cur_ty = resolve(src_ty);
+
+    for (pos, &(idx_ty, idx_val)) in indices.iter().enumerate() {
+        if pos == 0 && first_is_ptr_stride {
+            let (sz, align) = memcpy_size_align(&cur_ty, resolve, data_layout)?;
+            let stride = i64::try_from(round_up_u64(sz, align)).ok()?;
+            if let Ok(c) = idx_val.parse::<i64>() {
+                const_off = const_off.checked_add(c.checked_mul(stride)?)?;
+            } else {
+                dyn_terms.push((idx_ty.to_string(), idx_val.to_string(), stride));
+            }
+            continue;
+        }
+        match &cur_ty {
+            LlType::Struct(fields) => {
+                let fi = idx_val.parse::<usize>().ok()?;
+                if fi >= fields.len() {
+                    return None;
+                }
+                let mut off = 0u64;
+                for (k, field) in fields.iter().enumerate() {
+                    let (sz, align) = memcpy_size_align(field, resolve, data_layout)?;
+                    off = round_up_u64(off, align);
+                    if k == fi {
+                        const_off = const_off.checked_add(i64::try_from(off).ok()?)?;
+                        cur_ty = resolve(field);
+                        break;
+                    }
+                    off = off.checked_add(sz)?;
+                }
+            }
+            LlType::Array(elem, _) => {
+                let (sz, align) = memcpy_size_align(elem, resolve, data_layout)?;
+                let stride = i64::try_from(round_up_u64(sz, align)).ok()?;
+                if let Ok(c) = idx_val.parse::<i64>() {
+                    const_off = const_off.checked_add(c.checked_mul(stride)?)?;
+                } else {
+                    dyn_terms.push((idx_ty.to_string(), idx_val.to_string(), stride));
+                }
+                cur_ty = resolve(elem);
+            }
+            LlType::Vector(elem, _) => {
+                let (sz, _) = memcpy_size_align(elem, resolve, data_layout)?;
+                let stride = i64::try_from(sz).ok()?;
+                if let Ok(c) = idx_val.parse::<i64>() {
+                    const_off = const_off.checked_add(c.checked_mul(stride)?)?;
+                } else {
+                    dyn_terms.push((idx_ty.to_string(), idx_val.to_string(), stride));
+                }
+                cur_ty = resolve(elem);
+            }
+            _ => return None,
+        }
+    }
+
+    let mut acc = base_off.to_string();
+    let total_steps = dyn_terms.len() + usize::from(const_off != 0);
+    if total_steps == 0 {
+        emitted.push(format!("{indent}{lhs} = add i32 {acc}, 0"));
+        return Some(());
+    }
+
+    let mut step = 0usize;
+    for (idx_ty, idx_val, stride) in dyn_terms {
+        step += 1;
+        let idx32 = match idx_ty.as_str() {
+            "i32" => idx_val,
+            "i64" => {
+                let id = *fresh;
+                *fresh += 1;
+                let tmp = format!("%__m2v.pt.{id}");
+                emitted.push(format!("{indent}{tmp} = trunc i64 {idx_val} to i32"));
+                tmp
+            }
+            _ => return None,
+        };
+        let scaled = if stride == 1 {
+            idx32
+        } else {
+            let id = *fresh;
+            *fresh += 1;
+            let tmp = format!("%__m2v.pm.{id}");
+            emitted.push(format!("{indent}{tmp} = mul i32 {idx32}, {stride}"));
+            tmp
+        };
+        let dst = if step == total_steps {
+            lhs.to_string()
+        } else {
+            let id = *fresh;
+            *fresh += 1;
+            format!("%__m2v.pa.{id}")
+        };
+        emitted.push(format!("{indent}{dst} = add i32 {acc}, {scaled}"));
+        acc = dst;
+    }
+
+    if const_off != 0 {
+        emitted.push(format!("{indent}{lhs} = add i32 {acc}, {const_off}"));
+    }
+    Some(())
+}
+
+#[allow(clippy::too_many_arguments)]
+fn emit_pool_load(
+    emitted: &mut Vec<String>,
+    indent: &str,
+    lhs: &str,
+    val_ty_str: &str,
+    ptr_off: &str,
+    pool_words: u32,
+    opaque_ptrs: bool,
+    resolve: &impl Fn(&LlType) -> LlType,
+    fresh: &mut usize,
+) -> Option<()> {
+    let i32_ptr_ty = if opaque_ptrs { "ptr" } else { "i32*" };
+    let w0 = {
+        let id = *fresh;
+        *fresh += 1;
+        let name = format!("%__m2v.pw.{id}");
+        emitted.push(format!("{indent}{name} = lshr i32 {ptr_off}, 2"));
+        name
+    };
+    if is_local_ptr_type_str(val_ty_str) {
+        let sp = fresh_gep_pool(emitted, indent, &w0, 0, pool_words, opaque_ptrs, fresh);
+        emitted.push(format!("{indent}{lhs} = load i32, {i32_ptr_ty} {sp}, align 4"));
+        return Some(());
+    }
+    let val_ty = resolve(&parse_type(val_ty_str).ok()?);
+    match val_ty {
+        LlType::Int(32) => {
+            let sp = fresh_gep_pool(emitted, indent, &w0, 0, pool_words, opaque_ptrs, fresh);
+            emitted.push(format!("{indent}{lhs} = load i32, {i32_ptr_ty} {sp}, align 4"));
+            Some(())
+        }
+        LlType::Float => {
+            let sp = fresh_gep_pool(emitted, indent, &w0, 0, pool_words, opaque_ptrs, fresh);
+            let raw = fresh_name("pl", fresh);
+            emitted.push(format!("{indent}{raw} = load i32, {i32_ptr_ty} {sp}, align 4"));
+            emitted.push(format!("{indent}{lhs} = bitcast i32 {raw} to float"));
+            Some(())
+        }
+        LlType::Int(64) => {
+            let sp0 = fresh_gep_pool(emitted, indent, &w0, 0, pool_words, opaque_ptrs, fresh);
+            let sp1 = fresh_gep_pool(emitted, indent, &w0, 1, pool_words, opaque_ptrs, fresh);
+            let lo32 = fresh_name("plo", fresh);
+            let hi32 = fresh_name("phi", fresh);
+            let lo64 = fresh_name("plo64", fresh);
+            let hi64 = fresh_name("phi64", fresh);
+            let hish = fresh_name("phish", fresh);
+            emitted.push(format!("{indent}{lo32} = load i32, {i32_ptr_ty} {sp0}, align 4"));
+            emitted.push(format!("{indent}{hi32} = load i32, {i32_ptr_ty} {sp1}, align 4"));
+            emitted.push(format!("{indent}{lo64} = zext i32 {lo32} to i64"));
+            emitted.push(format!("{indent}{hi64} = zext i32 {hi32} to i64"));
+            emitted.push(format!("{indent}{hish} = shl i64 {hi64}, 32"));
+            emitted.push(format!("{indent}{lhs} = or i64 {lo64}, {hish}"));
+            Some(())
+        }
+        LlType::Vector(elem, lanes) if matches!(*elem, LlType::Float | LlType::Int(32)) => {
+            let is_float = *elem == LlType::Float;
+            let elem_str = if is_float { "float" } else { "i32" };
+            let vec_str = format!("<{lanes} x {elem_str}>");
+            let mut vec_acc = "undef".to_string();
+            for lane in 0..lanes {
+                let sp = fresh_gep_pool(emitted, indent, &w0, lane, pool_words, opaque_ptrs, fresh);
+                let raw = fresh_name("pvl", fresh);
+                emitted.push(format!("{indent}{raw} = load i32, {i32_ptr_ty} {sp}, align 4"));
+                let lane_val = if is_float {
+                    let f = fresh_name("pvf", fresh);
+                    emitted.push(format!("{indent}{f} = bitcast i32 {raw} to float"));
+                    f
+                } else {
+                    raw
+                };
+                let dst = if lane + 1 == lanes {
+                    lhs.to_string()
+                } else {
+                    fresh_name("pvi", fresh)
+                };
+                emitted.push(format!(
+                    "{indent}{dst} = insertelement {vec_str} {vec_acc}, {elem_str} {lane_val}, i32 {lane}"
+                ));
+                vec_acc = dst;
+            }
+            Some(())
+        }
+        _ => None,
+    }
+}
+
+#[allow(clippy::too_many_arguments)]
+fn emit_pool_store(
+    emitted: &mut Vec<String>,
+    indent: &str,
+    val_ty_str: &str,
+    val: &str,
+    ptr_off: &str,
+    pool_words: u32,
+    opaque_ptrs: bool,
+    fi: usize,
+    pool_vals: &HashSet<(usize, String)>,
+    resolve: &impl Fn(&LlType) -> LlType,
+    fresh: &mut usize,
+) -> Option<()> {
+    let i32_ptr_ty = if opaque_ptrs { "ptr" } else { "i32*" };
+    let w0 = {
+        let id = *fresh;
+        *fresh += 1;
+        let name = format!("%__m2v.pw.{id}");
+        emitted.push(format!("{indent}{name} = lshr i32 {ptr_off}, 2"));
+        name
+    };
+    if is_local_ptr_type_str(val_ty_str) {
+        let mapped = map_pool_operand(val, fi, pool_vals)?;
+        let sp = fresh_gep_pool(emitted, indent, &w0, 0, pool_words, opaque_ptrs, fresh);
+        emitted.push(format!("{indent}store i32 {mapped}, {i32_ptr_ty} {sp}, align 4"));
+        return Some(());
+    }
+    let val_ty = resolve(&parse_type(val_ty_str).ok()?);
+    match val_ty {
+        LlType::Int(32) => {
+            let sp = fresh_gep_pool(emitted, indent, &w0, 0, pool_words, opaque_ptrs, fresh);
+            emitted.push(format!("{indent}store i32 {val}, {i32_ptr_ty} {sp}, align 4"));
+            Some(())
+        }
+        LlType::Float => {
+            let bits = float_val_as_i32_operand(emitted, indent, val, fresh)?;
+            let sp = fresh_gep_pool(emitted, indent, &w0, 0, pool_words, opaque_ptrs, fresh);
+            emitted.push(format!("{indent}store i32 {bits}, {i32_ptr_ty} {sp}, align 4"));
+            Some(())
+        }
+        LlType::Int(64) => {
+            let lo = fresh_name("pslo", fresh);
+            let sh = fresh_name("pssh", fresh);
+            let hi = fresh_name("pshi", fresh);
+            emitted.push(format!("{indent}{lo} = trunc i64 {val} to i32"));
+            emitted.push(format!("{indent}{sh} = lshr i64 {val}, 32"));
+            emitted.push(format!("{indent}{hi} = trunc i64 {sh} to i32"));
+            let sp0 = fresh_gep_pool(emitted, indent, &w0, 0, pool_words, opaque_ptrs, fresh);
+            let sp1 = fresh_gep_pool(emitted, indent, &w0, 1, pool_words, opaque_ptrs, fresh);
+            emitted.push(format!("{indent}store i32 {lo}, {i32_ptr_ty} {sp0}, align 4"));
+            emitted.push(format!("{indent}store i32 {hi}, {i32_ptr_ty} {sp1}, align 4"));
+            Some(())
+        }
+        LlType::Vector(elem, lanes) if matches!(*elem, LlType::Float | LlType::Int(32)) => {
+            let is_float = *elem == LlType::Float;
+            let elem_str = if is_float { "float" } else { "i32" };
+            let vec_str = format!("<{lanes} x {elem_str}>");
+            if val == "zeroinitializer" {
+                for lane in 0..lanes {
+                    let sp =
+                        fresh_gep_pool(emitted, indent, &w0, lane, pool_words, opaque_ptrs, fresh);
+                    emitted.push(format!("{indent}store i32 0, {i32_ptr_ty} {sp}, align 4"));
+                }
+                return Some(());
+            }
+            if val == "undef" || val == "poison" {
+                for lane in 0..lanes {
+                    let sp =
+                        fresh_gep_pool(emitted, indent, &w0, lane, pool_words, opaque_ptrs, fresh);
+                    emitted.push(format!("{indent}store i32 {val}, {i32_ptr_ty} {sp}, align 4"));
+                }
+                return Some(());
+            }
+            if let Some(inner) = val.strip_prefix('<').and_then(|s| s.strip_suffix('>')) {
+                let elems = split_top_level(inner, ',');
+                if elems.len() != lanes as usize {
+                    return None;
+                }
+                for (lane, elem_spec) in elems.into_iter().enumerate() {
+                    let (_, elem_val) = split_typed_operand(elem_spec)?;
+                    let word_val = if is_float {
+                        float_val_as_i32_operand(emitted, indent, elem_val, fresh)?
+                    } else {
+                        elem_val.to_string()
+                    };
+                    let sp = fresh_gep_pool(
+                        emitted,
+                        indent,
+                        &w0,
+                        lane as u32,
+                        pool_words,
+                        opaque_ptrs,
+                        fresh,
+                    );
+                    emitted.push(format!(
+                        "{indent}store i32 {word_val}, {i32_ptr_ty} {sp}, align 4"
+                    ));
+                }
+                return Some(());
+            }
+            for lane in 0..lanes {
+                let ext = fresh_name("pve", fresh);
+                emitted.push(format!(
+                    "{indent}{ext} = extractelement {vec_str} {val}, i32 {lane}"
+                ));
+                let word_val = if is_float {
+                    let b = fresh_name("pvb", fresh);
+                    emitted.push(format!("{indent}{b} = bitcast float {ext} to i32"));
+                    b
+                } else {
+                    ext
+                };
+                let sp = fresh_gep_pool(emitted, indent, &w0, lane, pool_words, opaque_ptrs, fresh);
+                emitted.push(format!(
+                    "{indent}store i32 {word_val}, {i32_ptr_ty} {sp}, align 4"
+                ));
+            }
+            Some(())
+        }
+        _ => None,
+    }
+}
+
+fn float_val_as_i32_operand(
+    emitted: &mut Vec<String>,
+    indent: &str,
+    val: &str,
+    fresh: &mut usize,
+) -> Option<String> {
+    if val.starts_with('%') {
+        let b = fresh_name("pfb", fresh);
+        emitted.push(format!("{indent}{b} = bitcast float {val} to i32"));
+        return Some(b);
+    }
+    if val == "undef" || val == "poison" {
+        return Some(val.to_string());
+    }
+    let f = parse_llvm_f32_literal(val)?;
+    Some((f.to_bits() as i32).to_string())
+}
+
+fn parse_llvm_f32_literal(lit: &str) -> Option<f32> {
+    if let Some(hex) = lit.strip_prefix("0x").or_else(|| lit.strip_prefix("0X")) {
+        let bits = u64::from_str_radix(hex, 16).ok()?;
+        return Some(f64::from_bits(bits) as f32);
+    }
+    lit.parse::<f64>().ok().map(|v| v as f32)
+}
+
+fn fresh_name(prefix: &str, fresh: &mut usize) -> String {
+    let id = *fresh;
+    *fresh += 1;
+    format!("%__m2v.{prefix}.{id}")
+}
+
+fn fresh_gep_pool(
+    emitted: &mut Vec<String>,
+    indent: &str,
+    w0: &str,
+    lane: u32,
+    pool_words: u32,
+    opaque_ptrs: bool,
+    fresh: &mut usize,
+) -> String {
+    let idx = if lane == 0 {
+        w0.to_string()
+    } else {
+        let a = fresh_name("pwi", fresh);
+        emitted.push(format!("{indent}{a} = add i32 {w0}, {lane}"));
+        a
+    };
+    let sp = fresh_name("psp", fresh);
+    let pool_ptr_ty = if opaque_ptrs {
+        "ptr".to_string()
+    } else {
+        format!("[{pool_words} x i32]*")
+    };
+    emitted.push(format!(
+        "{indent}{sp} = getelementptr inbounds [{pool_words} x i32], {pool_ptr_ty} {POOL_GLOBAL}, i32 0, i32 {idx}"
+    ));
+    sp
+}
+
+fn rewrite_struct_typedef(line: &str, field_idx: usize) -> Option<String> {
+    let open = line.find('{')?;
+    let close = line.rfind('}')?;
+    let fields = split_top_level(&line[open + 1..close], ',');
+    if field_idx >= fields.len() {
+        return None;
+    }
+    let mut new_fields: Vec<&str> = fields;
+    new_fields[field_idx] = "i32";
+    Some(format!(
+        "{}{{ {} }}{}",
+        &line[..open],
+        new_fields.join(", "),
+        &line[close + 1..]
+    ))
+}
+
+fn rewrite_define_header(
+    line: &str,
+    fn_name: &str,
+    pool_params: &HashSet<(String, usize)>,
+) -> Option<String> {
+    let at = line.find('@')?;
+    let lp = line[at..].find('(')? + at;
+    let rp = find_matching_paren(line, lp)?;
+    let raw_params = split_top_level(&line[lp + 1..rp], ',');
+    let mut out_params = Vec::with_capacity(raw_params.len());
+    for (pi, p) in raw_params.into_iter().enumerate() {
+        if pool_params.contains(&(fn_name.to_string(), pi)) {
+            let pname = p.split_whitespace().last()?;
+            if !pname.starts_with('%') {
+                return None;
+            }
+            out_params.push(format!("i32 {pname}"));
+        } else {
+            out_params.push(p.to_string());
+        }
+    }
+    Some(format!(
+        "{}({}){}",
+        &line[..lp],
+        out_params.join(", "),
+        &line[rp + 1..]
+    ))
+}
+
+fn arg_has_subword_align(ty_and_attrs: &str) -> bool {
+    let mut tokens = ty_and_attrs.split_whitespace();
+    while let Some(tok) = tokens.next() {
+        if tok == "align" {
+            if let Some(next) = tokens.next() {
+                if let Ok(a) = next.parse::<u64>() {
+                    if a < 4 {
+                        return true;
+                    }
+                }
+            }
+        }
+    }
+    false
+}
+
+fn try_emit_pool_memcpy(
+    indent: &str,
+    call: &CallLine<'_>,
+    pool_words: u32,
+    opaque_ptrs: bool,
+    fi: usize,
+    pool_vals: &HashSet<(usize, String)>,
+    fresh: &mut usize,
+) -> Option<Vec<String>> {
+    if !call.callee.starts_with("llvm.memcpy.") || call.args.len() != 4 {
+        return None;
+    }
+    let (dst_ty, dst_val) = split_typed_operand(call.args[0])?;
+    let (src_ty, src_val) = split_typed_operand(call.args[1])?;
+    let (_, len_str) = split_typed_operand(call.args[2])?;
+    let (_, vol_str) = split_typed_operand(call.args[3])?;
+    if !matches!(vol_str, "false" | "0") {
+        return None;
+    }
+    if dst_ty.contains("addrspace(") || src_ty.contains("addrspace(") {
+        return None;
+    }
+    if arg_has_subword_align(dst_ty) || arg_has_subword_align(src_ty) {
+        return None;
+    }
+    if !pool_vals.contains(&(fi, dst_val.to_string()))
+        || !pool_vals.contains(&(fi, src_val.to_string()))
+    {
+        return None;
+    }
+    let byte_len = len_str.parse::<u64>().ok()?;
+    if byte_len % 4 != 0 || byte_len > 1024 {
+        return None;
+    }
+    let words = u32::try_from(byte_len / 4).ok()?;
+    let mut emitted = Vec::new();
+    if words == 0 {
+        return Some(emitted);
+    }
+    let i32_ptr_ty = if opaque_ptrs { "ptr" } else { "i32*" };
+    let dst_w0 = fresh_name("pmcdw", fresh);
+    let src_w0 = fresh_name("pmcsw", fresh);
+    emitted.push(format!("{indent}{dst_w0} = lshr i32 {dst_val}, 2"));
+    emitted.push(format!("{indent}{src_w0} = lshr i32 {src_val}, 2"));
+    for lane in 0..words {
+        let src_ptr =
+            fresh_gep_pool(&mut emitted, indent, &src_w0, lane, pool_words, opaque_ptrs, fresh);
+        let val = fresh_name("pmcv", fresh);
+        emitted.push(format!("{indent}{val} = load i32, {i32_ptr_ty} {src_ptr}, align 4"));
+        let dst_ptr =
+            fresh_gep_pool(&mut emitted, indent, &dst_w0, lane, pool_words, opaque_ptrs, fresh);
+        emitted.push(format!("{indent}store i32 {val}, {i32_ptr_ty} {dst_ptr}, align 4"));
+    }
+    Some(emitted)
+}
+
+fn rewrite_call_line(
+    line: &str,
+    call: &CallLine<'_>,
+    fi: usize,
+    pool_vals: &HashSet<(usize, String)>,
+    pool_params: &HashSet<(String, usize)>,
+) -> Option<String> {
+    let mut out_args = Vec::with_capacity(call.args.len());
+    for (ai, arg) in call.args.iter().enumerate() {
+        if pool_params.contains(&(call.callee.to_string(), ai)) {
+            let (_, val) = split_typed_operand(arg)?;
+            let mapped = map_pool_operand(val, fi, pool_vals)?;
+            out_args.push(format!("i32 {mapped}"));
+        } else {
+            out_args.push((*arg).to_string());
+        }
+    }
+    Some(format!(
+        "{}({}){}",
+        &line[..call.lp_idx],
+        out_args.join(", "),
+        &line[call.rp_idx + 1..]
+    ))
+}
