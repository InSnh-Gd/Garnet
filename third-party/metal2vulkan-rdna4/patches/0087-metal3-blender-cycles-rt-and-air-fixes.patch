+  %gep = getelementptr inbounds [2 x ptr addrspace(2)], ptr addrspace(2) @samplers, i64 0, i64 1
+  %smp = load ptr addrspace(2), ptr addrspace(2) %gep, align 8
+  %res = tail call { <4 x float>, i8 } @air.sample_texture_2d.v4f32(ptr addrspace(1) %tex, ptr addrspace(2) %smp, <2 x float> zeroinitializer)
