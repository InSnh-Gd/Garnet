+  %smp = load %"struct.metal::_sampler_t" addrspace(2)*, %"struct.metal::_sampler_t" addrspace(2)* addrspace(2)* %gep, align 8
+  %res = tail call { <4 x float>, i8 } @air.sample_texture_2d.v4f32(i8 addrspace(1)* %tex, %"struct.metal::_sampler_t" addrspace(2)* %smp, <2 x float> zeroinitializer)
