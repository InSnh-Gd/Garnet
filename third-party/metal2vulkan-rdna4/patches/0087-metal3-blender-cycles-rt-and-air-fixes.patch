+@__air_sampler_state = internal addrspace(2) constant [2 x i64] [i64 1, i64 0], align 8
+@__air_sampler_state.1 = internal addrspace(2) constant [2 x i64] [i64 2, i64 0], align 8
+@_ZL14metal_samplers = internal unnamed_addr addrspace(2) constant %"struct.metal::array" { [2 x %"struct.metal::sampler"] [%"struct.metal::sampler" { ptr addrspace(2) @__air_sampler_state }, %"struct.metal::sampler" { ptr addrspace(2) @__air_sampler_state.1 }] }, align 8
+
