+#[cfg(test)]
+mod lookup_cse_tests {
+    use super::*;
+    use crate::spirv_module::{Block, Function, Module};
+
+    #[test]
+    fn deduplicate_pure_lookup_calls_hoists_switch_arms_and_reuses_dominators() {
+        let mut ctx = Ctx::new(Module::new());
+        let void = ctx.ty_void();
+        let uint = ctx.ty_uint();
+        let fn_ty = ctx.get_or_create(Op::TypeFunction, None, vec![Operand::IdRef(void)]);
+        let table = raw_buffer(&mut ctx, ARGUMENT_RESOURCE_TABLE_BINDING);
+        let lookup = lookup_function(&mut ctx, table);
+
+        let entry_fn = ctx.module.fresh_id();
+        let b_hdr = ctx.module.fresh_id();
+        let b_arm0 = ctx.module.fresh_id();
+        let b_arm1 = ctx.module.fresh_id();
+        let b_arm2 = ctx.module.fresh_id();
+        let b_merge = ctx.module.fresh_id();
+
+        let sel = ctx.const_uint(1);
+        let lo_a = ctx.const_uint(11);
+        let hi_a = ctx.const_uint(22);
+        let lo_b = ctx.const_uint(33);
+        let hi_b = ctx.const_uint(44);
+        let cat0 = ctx.const_uint(0);
+
+        let call_a0 = ctx.module.fresh_id();
+        let call_a1 = ctx.module.fresh_id();
+        let call_a2 = ctx.module.fresh_id();
+        let call_a_after = ctx.module.fresh_id();
+        let call_b = ctx.module.fresh_id();
+        let sum0 = ctx.module.fresh_id();
+        let sum1 = ctx.module.fresh_id();
+        let sum2 = ctx.module.fresh_id();
+        let merged = ctx.module.fresh_id();
+        let final_sum = ctx.module.fresh_id();
+
+        let make_call = |res, lo, hi, cat| {
+            Instruction::new(
+                Op::FunctionCall,
+                Some(uint),
+                Some(res),
+                vec![
+                    Operand::IdRef(lookup),
+                    Operand::IdRef(lo),
+                    Operand::IdRef(hi),
+                    Operand::IdRef(cat),
+                ],
+            )
+        };
+        let br = |lbl| Instruction::new(Op::Branch, None, None, vec![Operand::IdRef(lbl)]);
+        let blk = |lbl, instructions| Block {
+            label: Some(Instruction::new(Op::Label, None, Some(lbl), vec![])),
+            instructions,
+        };
+
+        let entry_idx = ctx.module.functions.len();
+        ctx.module.functions.push(Function {
+            def: Some(Instruction::new(
+                Op::Function,
+                Some(void),
+                Some(entry_fn),
+                vec![
+                    Operand::FunctionControl(FunctionControl::NONE),
+                    Operand::IdRef(fn_ty),
+                ],
+            )),
+            end: Some(Instruction::new(Op::FunctionEnd, None, None, vec![])),
+            parameters: vec![],
+            blocks: vec![
+                blk(
+                    b_hdr,
+                    vec![
+                        Instruction::new(
+                            Op::SelectionMerge,
+                            None,
+                            None,
+                            vec![
+                                Operand::IdRef(b_merge),
+                                Operand::SelectionControl(spirv::SelectionControl::NONE),
+                            ],
+                        ),
+                        Instruction::new(
+                            Op::Switch,
+                            None,
+                            None,
+                            vec![
+                                Operand::IdRef(sel),
+                                Operand::IdRef(b_arm0),
+                                Operand::LiteralBit32(1),
+                                Operand::IdRef(b_arm1),
+                                Operand::LiteralBit32(2),
+                                Operand::IdRef(b_arm2),
+                            ],
+                        ),
+                    ],
+                ),
+                blk(
+                    b_arm0,
+                    vec![
+                        make_call(call_a0, lo_a, hi_a, cat0),
+                        make_call(call_b, lo_b, hi_b, cat0),
+                        Instruction::new(
+                            Op::IAdd,
+                            Some(uint),
+                            Some(sum0),
+                            vec![Operand::IdRef(call_a0), Operand::IdRef(call_b)],
+                        ),
+                        br(b_merge),
+                    ],
+                ),
+                blk(
+                    b_arm1,
+                    vec![
+                        make_call(call_a1, lo_a, hi_a, cat0),
+                        Instruction::new(
+                            Op::CopyObject,
+                            Some(uint),
+                            Some(sum1),
+                            vec![Operand::IdRef(call_a1)],
+                        ),
+                        br(b_merge),
+                    ],
+                ),
+                blk(
+                    b_arm2,
+                    vec![
+                        make_call(call_a2, lo_a, hi_a, cat0),
+                        Instruction::new(
+                            Op::CopyObject,
+                            Some(uint),
+                            Some(sum2),
+                            vec![Operand::IdRef(call_a2)],
+                        ),
+                        br(b_merge),
+                    ],
+                ),
+                blk(
+                    b_merge,
+                    vec![
+                        Instruction::new(
+                            Op::Phi,
+                            Some(uint),
+                            Some(merged),
+                            vec![
+                                Operand::IdRef(sum0),
+                                Operand::IdRef(b_arm0),
+                                Operand::IdRef(sum1),
+                                Operand::IdRef(b_arm1),
+                                Operand::IdRef(sum2),
+                                Operand::IdRef(b_arm2),
+                            ],
+                        ),
+                        make_call(call_a_after, lo_a, hi_a, cat0),
+                        Instruction::new(
+                            Op::IAdd,
+                            Some(uint),
+                            Some(final_sum),
+                            vec![Operand::IdRef(merged), Operand::IdRef(call_a_after)],
+                        ),
+                        Instruction::new(Op::Return, None, None, vec![]),
+                    ],
+                ),
+            ],
+        });
+
+        let fake_load = ctx.module.fresh_id();
+        ctx.sampled_descriptor_accesses.insert(
+            fake_load,
+            SampledDescriptorAccess {
+                category: 0,
+                token_index: call_a1,
+                physical_index: call_a1,
+                shape: None,
+            },
+        );
+
+        deduplicate_pure_lookup_calls(&mut ctx, entry_idx, lookup);
+
+        let entry = &ctx.module.functions[entry_idx];
+        let calls_for = |lo, hi| -> Vec<(usize, Word)> {
+            entry
+                .blocks
+                .iter()
+                .enumerate()
+                .flat_map(|(bi, b)| {
+                    b.instructions.iter().filter_map(move |inst| {
+                        (inst.class.opcode == Op::FunctionCall
+                            && inst.operands.as_slice()
+                                == [
+                                    Operand::IdRef(lookup),
+                                    Operand::IdRef(lo),
+                                    Operand::IdRef(hi),
+                                    Operand::IdRef(cat0),
+                                ])
+                        .then(|| (bi, inst.result_id.unwrap()))
+                    })
+                })
+                .collect()
+        };
+        let a_calls = calls_for(lo_a, hi_a);
+        assert_eq!(a_calls.len(), 1, "4 duplicate (lo_a, hi_a) calls must collapse to 1: {a_calls:?}");
+        assert_eq!(a_calls[0].0, 0, "hoisted call must land in switch header block 0");
+        let hoisted_id = a_calls[0].1;
+        // Must be placed before OpSelectionMerge (len - 2) in block 0.
+        let hdr_insts = &entry.blocks[0].instructions;
+        assert_eq!(hdr_insts[hdr_insts.len() - 2].class.opcode, Op::SelectionMerge);
+        assert_eq!(hdr_insts[hdr_insts.len() - 1].class.opcode, Op::Switch);
+        assert_eq!(hdr_insts[hdr_insts.len() - 3].result_id, Some(hoisted_id));
+        // Distinct (lo_b, hi_b) call must remain untouched in arm 0 (block 1).
+        let b_calls = calls_for(lo_b, hi_b);
+        assert_eq!(b_calls, vec![(1, call_b)]);
+        // Sampled descriptor access side-table must point to the canonical hoisted id.
+        let access = ctx.sampled_descriptor_accesses[&fake_load];
+        assert_eq!(access.token_index, hoisted_id);
+        assert_eq!(access.physical_index, hoisted_id);
+    }
+}
