+//! Pre-emit AIR lowering for constant `addrspace(2)` static sampler lookup tables
+//! (e.g. `constant metal::array<metal::sampler, 8> metal_samplers = { ... };`).
+//!
+//! Logical Vulkan SPIR-V and `metal2vulkan`'s image lowering require every `@air.sample_*` /
+//! `@air.gather_*` / `@air.calculate_*_lod*` call to reference a concrete static
+//! `@__air_sampler_state*` global rather than a dynamically loaded `ptr addrspace(2)` from a
+//! constant aggregate. Lowering constant sampler tables directly in AIR text keeps every
+//! `@__air_sampler_state*` global and its `!air.sampler_state` metadata intact, replaces constant
+//! lookups by direct global substitution, and replaces dynamic lookups at each `@air.*` consumer
+//! with an inline structured `switch` over `0..N` merging the call result through a single `phi`.
+//!
+//! Floor-safe by construction: borrows the input unchanged whenever the module has no constant
+//! `addrspace(2)` aggregate of `@__air_sampler_state*` globals, and leaves any table untouched if
+//! any use escapes outside direct `@air.*` calls.
+
+use std::borrow::Cow;
+use std::collections::{HashMap, HashSet};
+
+const MAX_STATIC_SAMPLER_TABLE_LEN: usize = 32;
+
+#[derive(Clone, Debug)]
+struct StaticSamplerTable {
+    global_name: String,
+    entries: Vec<String>,
+    /// Index position within a `getelementptr` index list that selects the array element
+    /// (1 for `[N x sampler]`, 2 for `{ [N x sampler] }`, etc.).
+    array_index_pos: usize,
+}
+
+pub(crate) fn lower_static_sampler_tables(san_ll: &str) -> Cow<'_, str> {
+    if !san_ll.contains("@__air_sampler_state") {
+        return Cow::Borrowed(san_ll);
+    }
+
+    let mut tables: HashMap<String, StaticSamplerTable> = HashMap::new();
+    let mut table_def_lines: HashMap<String, usize> = HashMap::new();
+
+    let lines: Vec<&str> = san_ll.lines().collect();
+    let mut in_func = false;
+    for (idx, line) in lines.iter().enumerate() {
+        let trimmed = line.trim_start();
+        if !in_func && trimmed.starts_with("define ") {
+            if !trimmed.ends_with('}') {
+                in_func = true;
+            }
+            continue;
+        }
+        if in_func {
+            if trimmed == "}" {
+                in_func = false;
+            }
+            continue;
+        }
+        if let Some(table) = parse_static_sampler_table_global(trimmed) {
+            table_def_lines.insert(table.global_name.clone(), idx);
+            tables.insert(table.global_name.clone(), table);
+        }
+    }
+
+    if tables.is_empty() {
+        return Cow::Borrowed(san_ll);
+    }
+
+    // Track which table globals have any remaining reference anywhere outside lowered functions.
+    let mut unlowered_tables: HashSet<String> = HashSet::new();
+    let mut lowered_any = false;
+    let mut fresh_counter = next_fresh_counter(san_ll);
+    let mut out_lines: Vec<String> = Vec::with_capacity(lines.len() + 256);
+
+    let mut i = 0usize;
+    while i < lines.len() {
+        let line = lines[i];
+        let trimmed = line.trim_start();
+        if trimmed.starts_with("define ") {
+            let start = i;
+            if trimmed.ends_with('}') {
+                for g in tables.keys() {
+                    if contains_llvm_ident(line, g) {
+                        unlowered_tables.insert(g.clone());
+                    }
+                }
+                out_lines.push(line.to_string());
+                i += 1;
+                continue;
+            }
+            i += 1;
+            while i < lines.len() && lines[i].trim() != "}" {
+                i += 1;
+            }
+            let end = if i < lines.len() { i } else { lines.len() - 1 };
+            let func_slice = &lines[start..=end];
+            let (rewritten, changed, still_used) =
+                rewrite_function(func_slice, &tables, &mut fresh_counter);
+            lowered_any |= changed;
+            unlowered_tables.extend(still_used);
+            out_lines.extend(rewritten);
+            i = end + 1;
+            continue;
+        }
+
+        // Check non-function lines (excluding each table's own definition) for escaping refs.
+        for g in tables.keys() {
+            if table_def_lines.get(g) != Some(&i) && contains_llvm_ident(line, g) {
+                unlowered_tables.insert(g.clone());
+            }
+        }
+        out_lines.push(line.to_string());
+        i += 1;
+    }
+
+    if !lowered_any {
+        return Cow::Borrowed(san_ll);
+    }
+
+    // Remove global definitions for tables that have zero remaining references.
+    let dead_globals: HashSet<String> = tables
+        .keys()
+        .filter(|g| !unlowered_tables.contains(*g))
+        .cloned()
+        .collect();
+    if !dead_globals.is_empty() {
+        out_lines.retain(|line| {
+            let trimmed = line.trim_start();
+            if !trimmed.starts_with('@') {
+                return true;
+            }
+            let Some((lhs, _)) = trimmed.split_once(" = ") else {
+                return true;
+            };
+            !dead_globals.contains(lhs.trim())
+        });
+    }
+
+    let mut text = out_lines.join("\n");
+    if san_ll.ends_with('\n') {
+        text.push('\n');
+    }
+    Cow::Owned(text)
+}
+
+pub(crate) fn lower_static_sampler_tables_owned(san_ll: String) -> String {
+    match lower_static_sampler_tables(&san_ll) {
+        Cow::Borrowed(_) => san_ll,
+        Cow::Owned(lowered) => lowered,
+    }
+}
+
+fn next_fresh_counter(san_ll: &str) -> usize {
+    let mut n = 0usize;
+    while san_ll.contains(&format!("__m2v_st_c{n}_")) || san_ll.contains(&format!("__m2v_st_m{n}")) {
+        n += 1;
+    }
+    n
+}
+
+fn is_ident_char(b: u8) -> bool {
+    b.is_ascii_alphanumeric() || matches!(b, b'_' | b'.' | b'-' | b'$')
+}
+
+fn contains_llvm_ident(haystack: &str, ident: &str) -> bool {
+    let bytes = haystack.as_bytes();
+    let mut offset = 0usize;
+    while let Some(rel) = haystack[offset..].find(ident) {
+        let pos = offset + rel;
+        let end = pos + ident.len();
+        let before_ok = pos == 0 || !is_ident_char(bytes[pos - 1]);
+        let after_ok = end == bytes.len() || !is_ident_char(bytes[end]);
+        if before_ok && after_ok {
+            return true;
+        }
+        offset = pos + 1;
+    }
+    false
+}
+
+fn replace_llvm_ident(haystack: &str, ident: &str, replacement: &str) -> String {
+    let bytes = haystack.as_bytes();
+    let mut out = String::with_capacity(haystack.len() + 32);
+    let mut cursor = 0usize;
+    let mut search = 0usize;
+    while let Some(rel) = haystack[search..].find(ident) {
+        let pos = search + rel;
+        let end = pos + ident.len();
+        let before_ok = pos == 0 || !is_ident_char(bytes[pos - 1]);
+        let after_ok = end == bytes.len() || !is_ident_char(bytes[end]);
+        if before_ok && after_ok {
+            out.push_str(&haystack[cursor..pos]);
+            out.push_str(replacement);
+            cursor = end;
+            search = end;
+        } else {
+            search = pos + 1;
+        }
+    }
+    out.push_str(&haystack[cursor..]);
+    out
+}
+
+fn split_top_level(s: &str, delim: char) -> Vec<&str> {
+    let mut out = Vec::new();
+    let mut start = 0usize;
+    let mut paren = 0i32;
+    let mut bracket = 0i32;
+    let mut brace = 0i32;
+    let mut angle = 0i32;
+    let mut in_quotes = false;
+    let mut escaped = false;
+    for (idx, ch) in s.char_indices() {
+        if in_quotes {
+            if escaped {
+                escaped = false;
+            } else if ch == '\\' {
+                escaped = true;
+            } else if ch == '"' {
+                in_quotes = false;
+            }
+            continue;
+        }
+        match ch {
+            '"' => in_quotes = true,
+            '(' => paren += 1,
+            ')' => paren -= 1,
+            '[' => bracket += 1,
+            ']' => bracket -= 1,
+            '{' => brace += 1,
+            '}' => brace -= 1,
+            '<' => angle += 1,
+            '>' => angle -= 1,
+            c if c == delim && paren == 0 && bracket == 0 && brace == 0 && angle == 0 => {
+                out.push(s[start..idx].trim());
+                start = idx + c.len_utf8();
+            }
+            _ => {}
+        }
+    }
+    let tail = s[start..].trim();
+    if !tail.is_empty() || !out.is_empty() {
+        out.push(tail);
+    }
+    out
+}
+
+fn find_matching_delim(s: &str, open_idx: usize, open: char, close: char) -> Option<usize> {
+    let mut depth = 0i32;
+    let mut in_quotes = false;
+    let mut escaped = false;
+    for (rel, ch) in s[open_idx..].char_indices() {
+        if in_quotes {
+            if escaped {
+                escaped = false;
+            } else if ch == '\\' {
+                escaped = true;
+            } else if ch == '"' {
+                in_quotes = false;
+            }
+            continue;
+        }
+        if ch == '"' {
+            in_quotes = true;
+        } else if ch == open {
+            depth += 1;
+        } else if ch == close {
+            depth -= 1;
+            if depth == 0 {
+                return Some(open_idx + rel);
+            }
+        }
+    }
+    None
+}
+
+fn parse_static_sampler_table_global(trimmed: &str) -> Option<StaticSamplerTable> {
+    if !trimmed.starts_with('@') || trimmed.starts_with("@__air_sampler_state") {
+        return None;
+    }
+    if !trimmed.contains("addrspace(2)")
+        || !trimmed.contains(" constant ")
+        || !trimmed.contains("@__air_sampler_state")
+    {
+        return None;
+    }
+    let (lhs, rhs) = trimmed.split_once(" = ")?;
+    let global_name = lhs.trim();
+    if !global_name.starts_with('@') || global_name.contains(char::is_whitespace) {
+        return None;
+    }
+    let const_pos = rhs.find(" constant ")?;
+    let mut init = rhs[const_pos + " constant ".len()..].trim();
+    // Strip trailing `, align N`, `, section ...`, metadata, etc.
+    if let Some(last_brace_or_bracket) = init.rfind(['}', ']']) {
+        init = &init[..=last_brace_or_bracket];
+    }
+
+    // Unwrap optional single-field struct wrappers around the array initializer.
+    let mut outer_struct_depth = 0usize;
+    let array_body = loop {
+        let open_brace = find_top_level_char(init, '{');
+        let open_bracket = find_top_level_char(init, '[');
+        match (open_brace, open_bracket) {
+            (Some(b), None) => {
+                let close = find_matching_delim(init, b, '{', '}')?;
+                let inner = init[b + 1..close].trim();
+                let fields = split_top_level(inner, ',');
+                if fields.len() != 1 {
+                    return None;
+                }
+                outer_struct_depth += 1;
+                init = fields[0];
+            }
+            (Some(b), Some(k)) if b < k => {
+                let close = find_matching_delim(init, b, '{', '}')?;
+                let inner = init[b + 1..close].trim();
+                let fields = split_top_level(inner, ',');
+                if fields.len() != 1 {
+                    return None;
+                }
+                outer_struct_depth += 1;
+                init = fields[0];
+            }
+            (_, Some(k)) => {
+                // `init` starts with `[N x ElemType] [ elem0, elem1, ... ]`.
+                let ty_close = find_matching_delim(init, k, '[', ']')?;
+                let rest = init[ty_close + 1..].trim();
+                if !rest.starts_with('[') {
+                    return None;
+                }
+                let body_close = find_matching_delim(rest, 0, '[', ']')?;
+                break rest[1..body_close].trim();
+            }
+            (None, None) => return None,
+        }
+    };
+
+    let elem_strs = split_top_level(array_body, ',');
+    if elem_strs.is_empty() || elem_strs.len() > MAX_STATIC_SAMPLER_TABLE_LEN {
+        return None;
+    }
+
+    let mut entries = Vec::with_capacity(elem_strs.len());
+    for elem in elem_strs {
+        let sampler_sym = extract_single_sampler_global(elem)?;
+        entries.push(sampler_sym);
+    }
+
+    Some(StaticSamplerTable {
+        global_name: global_name.to_string(),
+        entries,
+        array_index_pos: 1 + outer_struct_depth,
+    })
+}
+
+fn find_top_level_char(s: &str, target: char) -> Option<usize> {
+    let mut in_quotes = false;
+    let mut escaped = false;
+    for (idx, ch) in s.char_indices() {
+        if in_quotes {
+            if escaped {
+                escaped = false;
+            } else if ch == '\\' {
+                escaped = true;
+            } else if ch == '"' {
+                in_quotes = false;
+            }
+            continue;
+        }
+        if ch == '"' {
+            in_quotes = true;
+        } else if ch == target {
+            return Some(idx);
+        }
+    }
+    None
+}
+
+/// Extract the exact `@__air_sampler_state*` symbol from an array element initializer (which may
+/// be wrapped in single-field struct literals and/or a `bitcast (... to ...)` constant expression).
+fn extract_single_sampler_global(mut expr: &str) -> Option<String> {
+    loop {
+        expr = expr.trim();
+        if let Some(b) = find_top_level_char(expr, '{') {
+            let close = find_matching_delim(expr, b, '{', '}')?;
+            if !expr[close + 1..].trim().is_empty() {
+                return None;
+            }
+            let fields = split_top_level(expr[b + 1..close].trim(), ',');
+            if fields.len() != 1 {
+                return None;
+            }
+            expr = fields[0];
+            continue;
+        }
+        break;
+    }
+
+    // Find every `@...` token in the leaf expression; must be exactly one `@__air_sampler_state*`.
+    let mut found: Option<String> = None;
+    let bytes = expr.as_bytes();
+    let mut idx = 0usize;
+    while idx < bytes.len() {
+        if bytes[idx] == b'@' {
+            let start = idx;
+            idx += 1;
+            while idx < bytes.len() && is_ident_char(bytes[idx]) {
+                idx += 1;
+            }
+            let sym = &expr[start..idx];
+            if !sym.starts_with("@__air_sampler_state") || found.is_some() {
+                return None;
+            }
+            found = Some(sym.to_string());
+        } else {
+            idx += 1;
+        }
+    }
+    found
+}
+
+#[derive(Clone, Debug)]
+struct GepLookup {
+    table: String,
+    idx_ty: String,
+    idx_val: String,
+    line_idx: usize,
+}
+
+#[derive(Clone, Debug)]
+struct SamplerLoad {
+    table: String,
+    idx_ty: String,
+    idx_val: String,
+    gep_var: String,
+    line_idx: usize,
+}
+
+fn parse_table_gep(
+    line: &str,
+    line_idx: usize,
+    tables: &HashMap<String, StaticSamplerTable>,
+) -> Option<(String, GepLookup)> {
+    let trimmed = line.trim();
+    let (lhs, rhs) = trimmed.split_once(" = ")?;
+    let lhs = lhs.trim();
+    if !lhs.starts_with('%') {
+        return None;
+    }
+    let rest = rhs.trim().strip_prefix("getelementptr ")?;
+    // Strip trailing metadata annotations (`!dbg !1`, etc.) outside delimiters.
+    let parts = split_top_level(rest, ',');
+    // parts[0] = `[inbounds] <src_ty>`, parts[1] = `<ptr_ty> @G`, parts[2..] = indices / metadata.
+    if parts.len() < 3 {
+        return None;
+    }
+    let base_part = parts[1].trim();
+    let base_sym = base_part.split_whitespace().last()?;
+    let table = tables.get(base_sym)?;
+
+    let mut indices: Vec<(&str, &str)> = Vec::new();
+    for p in &parts[2..] {
+        let p = p.trim();
+        if p.starts_with('!') {
+            break;
+        }
+        let mut it = p.split_whitespace();
+        let ty = it.next()?;
+        let val = it.next()?;
+        if !ty.starts_with('i') || it.next().is_some() {
+            return None;
+        }
+        indices.push((ty, val));
+    }
+    if indices.len() <= table.array_index_pos {
+        return None;
+    }
+    // Every index other than `table.array_index_pos` must be constant 0.
+    for (pos, &(_, val)) in indices.iter().enumerate() {
+        if pos != table.array_index_pos && val != "0" {
+            return None;
+        }
+    }
+    let (idx_ty, idx_val) = indices[table.array_index_pos];
+    Some((
+        lhs.to_string(),
+        GepLookup {
+            table: table.global_name.clone(),
+            idx_ty: idx_ty.to_string(),
+            idx_val: idx_val.to_string(),
+            line_idx,
+        },
+    ))
+}
+
+fn parse_sampler_load(
+    line: &str,
+    line_idx: usize,
+    geps: &HashMap<String, GepLookup>,
+) -> Option<(String, SamplerLoad)> {
+    let trimmed = line.trim();
+    let (lhs, rhs) = trimmed.split_once(" = ")?;
+    let lhs = lhs.trim();
+    if !lhs.starts_with('%') {
+        return None;
+    }
+    let rest = rhs.trim().strip_prefix("load ")?;
+    let parts = split_top_level(rest, ',');
+    if parts.len() < 2 {
+        return None;
+    }
+    let ptr_part = parts[1].trim();
+    let ptr_var = ptr_part.split_whitespace().last()?;
+    let gep = geps.get(ptr_var)?;
+    Some((
+        lhs.to_string(),
+        SamplerLoad {
+            table: gep.table.clone(),
+            idx_ty: gep.idx_ty.clone(),
+            idx_val: gep.idx_val.clone(),
+            gep_var: ptr_var.to_string(),
+            line_idx,
+        },
+    ))
+}
+
+struct ParsedAirCall<'a> {
+    lhs: Option<&'a str>,
+    ret_ty: &'a str,
+}
+
+fn parse_air_call_line(line: &str) -> Option<ParsedAirCall<'_>> {
+    let trimmed = line.trim();
+    let (lhs, rhs) = if let Some((l, r)) = trimmed.split_once(" = ") {
+        let l = l.trim();
+        if !l.starts_with('%') {
+            return None;
+        }
+        (Some(l), r.trim())
+    } else {
+        (None, trimmed)
+    };
+    let after_call = rhs
+        .strip_prefix("tail call ")
+        .or_else(|| rhs.strip_prefix("musttail call "))
+        .or_else(|| rhs.strip_prefix("notail call "))
+        .or_else(|| rhs.strip_prefix("call "))?;
+    let air_pos = after_call.find("@air.")?;
+    let before_callee = after_call[..air_pos].trim();
+    // Strip optional fast-math / calling-conv / return attributes preceding the return type.
+    let mut ret_ty = before_callee;
+    loop {
+        let stripped = [
+            "fast ",
+            "nnan ",
+            "ninf ",
+            "nsz ",
+            "arcp ",
+            "contract ",
+            "afn ",
+            "reassoc ",
+            "noundef ",
+            "zeroext ",
+            "signext ",
+            "inreg ",
+            "spir_func ",
+            "fastcc ",
+            "ccc ",
+        ]
+        .iter()
+        .find_map(|kw| ret_ty.strip_prefix(kw));
+        if let Some(next) = stripped {
+            ret_ty = next.trim_start();
+        } else {
+            break;
+        }
+    }
+    if ret_ty.is_empty() {
+        return None;
+    }
+    // Verify call has argument parentheses right after `@air.<name>`.
+    let after_at = &after_call[air_pos..];
+    let open = after_at.find('(')?;
+    let _close = find_matching_delim(after_at, open, '(', ')')?;
+    Some(ParsedAirCall { lhs, ret_ty })
+}
+
+fn block_label_name(line: &str) -> Option<&str> {
+    if line.starts_with(char::is_whitespace) {
+        return None;
+    }
+    let trimmed = line.trim_end();
+    if trimmed.is_empty() || trimmed.starts_with(';') || trimmed.starts_with("define ") || trimmed == "}" {
+        return None;
+    }
+    // Strip trailing `; preds = ...` comment.
+    let before_comment = trimmed.split(';').next()?.trim_end();
+    let label = before_comment.strip_suffix(':')?;
+    if label.is_empty() || label.contains(char::is_whitespace) {
+        return None;
+    }
+    Some(label)
+}
+
+fn rewrite_function(
+    func_lines: &[&str],
+    tables: &HashMap<String, StaticSamplerTable>,
+    fresh_counter: &mut usize,
+) -> (Vec<String>, bool, HashSet<String>) {
+    let mut touched_tables: HashSet<String> = HashSet::new();
+    for line in func_lines {
+        for g in tables.keys() {
+            if contains_llvm_ident(line, g) {
+                touched_tables.insert(g.clone());
+            }
+        }
+    }
+    if touched_tables.is_empty() {
+        return (
+            func_lines.iter().map(|s| (*s).to_string()).collect(),
+            false,
+            HashSet::new(),
+        );
+    }
+
+    let mut geps: HashMap<String, GepLookup> = HashMap::new();
+    let mut loads: HashMap<String, SamplerLoad> = HashMap::new();
+    for (idx, line) in func_lines.iter().enumerate() {
+        if let Some((var, lookup)) = parse_table_gep(line, idx, tables) {
+            geps.insert(var, lookup);
+        }
+    }
+    for (idx, line) in func_lines.iter().enumerate() {
+        if let Some((var, load)) = parse_sampler_load(line, idx, &geps) {
+            loads.insert(var, load);
+        }
+    }
+
+    // Verify safety per table: every use of `@G`, `%gep`, and `%smp` in this function must be
+    // accounted for by recognized GEP -> load -> `@air.*` call sites.
+    let mut blocked_tables: HashSet<String> = HashSet::new();
+    for g in &touched_tables {
+        let gep_lines_for_g: HashSet<usize> = geps
+            .values()
+            .filter(|gl| &gl.table == g)
+            .map(|gl| gl.line_idx)
+            .collect();
+        if gep_lines_for_g.is_empty() {
+            blocked_tables.insert(g.clone());
+            continue;
+        }
+        for (idx, line) in func_lines.iter().enumerate() {
+            if !gep_lines_for_g.contains(&idx) && contains_llvm_ident(line, g) {
+                blocked_tables.insert(g.clone());
+                break;
+            }
+        }
+    }
+    for (gep_var, gl) in &geps {
+        if blocked_tables.contains(&gl.table) {
+            continue;
+        }
+        let load_lines_for_gep: HashSet<usize> = loads
+            .values()
+            .filter(|ld| &ld.gep_var == gep_var)
+            .map(|ld| ld.line_idx)
+            .collect();
+        for (idx, line) in func_lines.iter().enumerate() {
+            if idx != gl.line_idx
+                && !load_lines_for_gep.contains(&idx)
+                && contains_llvm_ident(line, gep_var)
+            {
+                blocked_tables.insert(gl.table.clone());
+                break;
+            }
+        }
+    }
+    for (smp_var, ld) in &loads {
+        if blocked_tables.contains(&ld.table) {
+            continue;
+        }
+        for (idx, line) in func_lines.iter().enumerate() {
+            if idx != ld.line_idx && contains_llvm_ident(line, smp_var) {
+                if parse_air_call_line(line).is_none() {
+                    blocked_tables.insert(ld.table.clone());
+                    break;
+                }
+            }
+        }
+    }
+
+    let lowerable_tables: HashSet<String> = touched_tables
+        .difference(&blocked_tables)
+        .cloned()
+        .collect();
+    if lowerable_tables.is_empty() {
+        return (
+            func_lines.iter().map(|s| (*s).to_string()).collect(),
+            false,
+            touched_tables,
+        );
+    }
+
+    let dead_lines: HashSet<usize> = geps
+        .values()
+        .filter(|g| lowerable_tables.contains(&g.table))
+        .map(|g| g.line_idx)
+        .chain(
+            loads
+                .values()
+                .filter(|l| lowerable_tables.contains(&l.table))
+                .map(|l| l.line_idx),
+        )
+        .collect();
+    let active_loads: HashMap<&str, &SamplerLoad> = loads
+        .iter()
+        .filter(|(_, l)| lowerable_tables.contains(&l.table))
+        .map(|(k, v)| (k.as_str(), v))
+        .collect();
+
+    let mut out: Vec<String> = Vec::with_capacity(func_lines.len() + 64);
+    let mut current_orig_label: Option<String> = None;
+    let mut split_tail_labels: HashMap<String, String> = HashMap::new();
+
+    for (idx, &line) in func_lines.iter().enumerate() {
+        if dead_lines.contains(&idx) {
+            continue;
+        }
+        if let Some(lbl) = block_label_name(line) {
+            current_orig_label = Some(lbl.to_string());
+            out.push(line.to_string());
+            continue;
+        }
+
+        // Check whether this line is an `@air.*` call consuming an active static sampler load.
+        let matching_load = active_loads
+            .iter()
+            .find(|(&smp_var, _)| contains_llvm_ident(line, smp_var))
+            .map(|(&smp_var, &ld)| (smp_var, ld));
+
+        let Some((smp_var, ld)) = matching_load else {
+            out.push(line.to_string());
+            continue;
+        };
+        let Some(call) = parse_air_call_line(line) else {
+            out.push(line.to_string());
+            continue;
+        };
+        let table = &tables[&ld.table];
+
+        // Constant index: substitute the static sampler directly without splitting the block.
+        if let Ok(const_idx) = ld.idx_val.parse::<usize>() {
+            let entry = &table.entries[const_idx.min(table.entries.len() - 1)];
+            out.push(replace_llvm_ident(line, smp_var, entry));
+            continue;
+        }
+        if table.entries.len() == 1 {
+            out.push(replace_llvm_ident(line, smp_var, &table.entries[0]));
+            continue;
+        }
+
+        // Dynamic index: split the basic block inline around this `@air.*` call using a
+        // structured `switch i32` over `0..N` (defaulting to entry 0).
+        let k = *fresh_counter;
+        *fresh_counter += 1;
+        let indent = &line[..line.len() - line.trim_start().len()];
+
+        let idx32 = match ld.idx_ty.as_str() {
+            "i32" => ld.idx_val.clone(),
+            "i64" => {
+                let tmp = format!("%__m2v_st_idx_{k}");
+                out.push(format!("{indent}{tmp} = trunc i64 {} to i32", ld.idx_val));
+                tmp
+            }
+            "i16" | "i8" | "i1" => {
+                let tmp = format!("%__m2v_st_idx_{k}");
+                out.push(format!(
+                    "{indent}{tmp} = zext {} {} to i32",
+                    ld.idx_ty, ld.idx_val
+                ));
+                tmp
+            }
+            other => {
+                let tmp = format!("%__m2v_st_idx_{k}");
+                out.push(format!(
+                    "{indent}{tmp} = trunc {other} {} to i32",
+                    ld.idx_val
+                ));
+                tmp
+            }
+        };
+
+        let merge_label = format!("__m2v_st_m{k}");
+        out.push(format!(
+            "{indent}switch i32 {idx32}, label %__m2v_st_c{k}_0 ["
+        ));
+        for case_i in 1..table.entries.len() {
+            out.push(format!("{indent}  i32 {case_i}, label %__m2v_st_c{k}_{case_i}"));
+        }
+        out.push(format!("{indent}]"));
+
+        let mut phi_arms: Vec<String> = Vec::with_capacity(table.entries.len());
+        for (case_i, entry) in table.entries.iter().enumerate() {
+            let case_label = format!("__m2v_st_c{k}_{case_i}");
+            out.push(format!("{case_label}:"));
+            let mut case_call = replace_llvm_ident(line, smp_var, entry);
+            if let Some(orig_lhs) = call.lhs {
+                let case_res = format!("%__m2v_st_r{k}_{case_i}");
+                if let Some((_, rhs)) = case_call.split_once(" = ") {
+                    case_call = format!("{indent}{case_res} = {rhs}");
+                } else {
+                    case_call = replace_llvm_ident(&case_call, orig_lhs, &case_res);
+                }
+                phi_arms.push(format!("[ {case_res}, %{case_label} ]"));
+            }
+            out.push(case_call);
+            out.push(format!("{indent}br label %{merge_label}"));
+        }
+
+        out.push(format!("{merge_label}:"));
+        if let Some(orig_lhs) = call.lhs {
+            if call.ret_ty != "void" {
+                out.push(format!(
+                    "{indent}{orig_lhs} = phi {} {}",
+                    call.ret_ty,
+                    phi_arms.join(", ")
+                ));
+            }
+        }
+        if let Some(orig_lbl) = &current_orig_label {
+            split_tail_labels.insert(orig_lbl.clone(), merge_label);
+        }
+    }
+
+    // Update any downstream `phi` instructions in this function whose predecessor block was split.
+    if !split_tail_labels.is_empty() {
+        for line in &mut out {
+            let trimmed = line.trim_start();
+            let Some((_, rhs)) = trimmed.split_once(" = ") else {
+                continue;
+            };
+            if !rhs.starts_with("phi ") {
+                continue;
+            }
+            for (orig_lbl, new_lbl) in &split_tail_labels {
+                let old_ref = format!("%{orig_lbl}");
+                let new_ref = format!("%{new_lbl}");
+                *line = rewrite_phi_pred_label(line, &old_ref, &new_ref);
+            }
+        }
+    }
+
+    (out, true, blocked_tables)
+}
+
+/// Replace predecessor label references `, %old_lbl ]` (never value operands before `,`) in an
+/// LLVM `phi` line.
+fn rewrite_phi_pred_label(line: &str, old_ref: &str, new_ref: &str) -> String {
+    let mut out = String::with_capacity(line.len() + 16);
+    let mut rest = line;
+    while let Some(open) = rest.find('[') {
+        let Some(close_rel) = rest[open..].find(']') else {
+            break;
+        };
+        let close = open + close_rel;
+        out.push_str(&rest[..open + 1]);
+        let arm = &rest[open + 1..close];
+        if let Some(comma) = arm.rfind(',') {
+            out.push_str(&arm[..comma + 1]);
+            let pred_part = &arm[comma + 1..];
+            if pred_part.trim() == old_ref {
+                out.push(' ');
+                out.push_str(new_ref);
+                out.push(' ');
+            } else {
+                out.push_str(pred_part);
+            }
+        } else {
+            out.push_str(arm);
+        }
+        out.push(']');
+        rest = &rest[close + 1..];
+    }
+    out.push_str(rest);
+    out
+}
+
+#[cfg(test)]
