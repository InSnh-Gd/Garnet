+@_ZL14metal_samplers = internal unnamed_addr addrspace(2) constant %"struct.metal::array" { [2 x %struct.sampler] [%struct.sampler { %"struct.metal::_sampler_t" addrspace(2)* bitcast ([2 x i64] addrspace(2)* @__air_sampler_state to %"struct.metal::_sampler_t" addrspace(2)*) }, %struct.sampler { %"struct.metal::_sampler_t" addrspace(2)* bitcast ([2 x i64] addrspace(2)* @__air_sampler_state.1 to %"struct.metal::_sampler_t" addrspace(2)*) }] }, align 8
+
