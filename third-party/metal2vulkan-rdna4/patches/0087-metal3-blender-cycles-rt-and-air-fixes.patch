+@__air_sampler_state.1 = internal addrspace(2) constant [2 x i64] [i64 2, i64 0], align 8
+@samplers = internal addrspace(2) constant [2 x ptr addrspace(2)] [ptr addrspace(2) @__air_sampler_state, ptr addrspace(2) @__air_sampler_state.1], align 8
+
