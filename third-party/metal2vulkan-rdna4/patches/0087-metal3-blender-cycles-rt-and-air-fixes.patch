+        for (ii, inst) in block.instructions.iter().enumerate() {
+            if let Some(res) = inst.result_id {
+                def_pos.insert(res, (bi, ii));
+                if inst.class.opcode == Op::CopyObject {
+                    if let [Operand::IdRef(src)] = inst.operands.as_slice() {
+                        copy_src.insert(res, *src);
+                    }
+                }
+            }
+        }
+    }
