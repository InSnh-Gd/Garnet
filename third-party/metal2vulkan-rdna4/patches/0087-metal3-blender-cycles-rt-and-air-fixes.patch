diff --git a/src/native/storage_alias_alloca.rs b/src/native/storage_alias_alloca.rs
new file mode 100644
index 0000000..fca91b5
--- /dev/null
+++ b/src/native/storage_alias_alloca.rs
@@ -0,0 +1,1354 @@
+//! Pre-parse AIR text pass: promote local byte-array storage wrapper allocas (`{ [N x i8] }`) that
+//! alias a single concrete target struct via `bitcast` (for example Blender Cycles'
+//! `ShaderDataTinyStorage` / `ShaderDataCausticsStorage` -> `ShaderData`) to the target struct
+//! type directly, rewriting constant byte-offset GEPs + pointer bitcasts into typed struct GEPs.
+//!
+//! Floor-safe by construction: when a module has no single-field `[N x i8]` wrapper struct, the
+//! pass borrows its input with zero allocations. For any candidate `alloca`, if even a single use
+//! cannot be proven to map cleanly onto a field of the unique target struct (or `llvm.lifetime.*`),
+//! that `alloca` is left completely untouched.
+
+use std::borrow::Cow;
+use std::collections::{HashMap, HashSet};
+
+use super::ir::LlType;
+use super::parse::parse_type;
+use crate::layout::{memcpy_size_align, AirDataLayout};
+
+pub(super) fn promote_storage_alias_allocas(san_ll: &str) -> Cow<'_, str> {
+    if !san_ll.contains(" x i8] }") {
+        return Cow::Borrowed(san_ll);
+    }
+    match rewrite_module(san_ll) {
+        Some(rewritten) => Cow::Owned(rewritten),
+        None => Cow::Borrowed(san_ll),
+    }
+}
+
+pub(super) fn promote_storage_alias_allocas_owned(san_ll: String) -> String {
+    if !san_ll.contains(" x i8] }") {
+        return san_ll;
+    }
+    rewrite_module(&san_ll).unwrap_or(san_ll)
+}
+
+fn rewrite_module(ll: &str) -> Option<String> {
+    let data_layout = AirDataLayout::from_ir(ll).ok().flatten();
+    let named_types = parse_named_types(ll);
+    if named_types.is_empty() {
+        return None;
+    }
+    let resolve = |ty: &LlType| -> LlType { resolve_type(ty, &named_types, 0) };
+
+    let mut byte_boxes: HashMap<String, u64> = HashMap::new();
+    for (name, ty) in &named_types {
+        if let LlType::Struct(fields) = resolve(ty) {
+            if let [LlType::Array(elem, len)] = fields.as_slice() {
+                if **elem == LlType::Int(8) && *len > 0 {
+                    byte_boxes.insert(name.clone(), u64::from(*len));
+                }
+            }
+        }
+    }
+    if byte_boxes.is_empty() {
+        return None;
+    }
+
+    let lines: Vec<&str> = ll.lines().collect();
+    let param_struct_uses = collect_param_struct_uses(&lines, &named_types, &resolve);
+    let mut out_lines: Vec<Option<String>> = lines.iter().map(|s| Some((*s).to_string())).collect();
+    let mut any_changed = false;
+    let mut field_maps: HashMap<(String, u64), HashMap<(u64, LlType), Vec<(bool, u64)>>> =
+        HashMap::new();
+
+    let mut i = 0usize;
+    while i < lines.len() {
+        let trimmed = lines[i].trim_start();
+        if !trimmed.starts_with("define ") || !trimmed.trim_end().ends_with('{') {
+            i += 1;
+            continue;
+        }
+        let body_start = i + 1;
+        let mut body_end = body_start;
+        while body_end < lines.len() && lines[body_end].trim() != "}" {
+            body_end += 1;
+        }
+        if body_end >= lines.len() {
+            break;
+        }
+
+        // Find candidate byte-box allocas in this function body.
+        let mut candidates: Vec<(usize, String, String, u64)> = Vec::new();
+        for (rel, line) in lines[body_start..body_end].iter().enumerate() {
+            if let Some((lhs, box_ty)) = parse_alloca_line(line) {
+                if let Some(&box_size) = byte_boxes.get(box_ty) {
+                    candidates.push((body_start + rel, lhs.to_string(), box_ty.to_string(), box_size));
+                }
+            }
+        }
+
+        for (alloca_idx, alloca_name, box_ty, box_size) in candidates {
+            if let Some(plan) = plan_alloca_promotion(
+                &lines,
+                body_start,
+                body_end,
+                alloca_idx,
+                &alloca_name,
+                &box_ty,
+                box_size,
+                &named_types,
+                &resolve,
+                data_layout.as_ref(),
+                &param_struct_uses,
+                &mut field_maps,
+            ) {
+                for (line_idx, replacement) in plan {
+                    out_lines[line_idx] = replacement;
+                }
+                any_changed = true;
+            }
+        }
+
+        i = body_end + 1;
+    }
+
+    if !any_changed {
+        return None;
+    }
+    let mut out = String::with_capacity(ll.len() + 256);
+    for line in out_lines.into_iter().flatten() {
+        out.push_str(&line);
+        out.push('\n');
+    }
+    Some(out)
+}
+
+fn parse_named_types(ll: &str) -> HashMap<String, LlType> {
+    let mut map = HashMap::new();
+    for line in ll.lines() {
+        let trimmed = line.trim();
+        if !trimmed.starts_with('%') {
+            continue;
+        }
+        let Some((lhs, rhs)) = trimmed.split_once(" = type ") else {
+            continue;
+        };
+        let name = lhs.trim();
+        let rhs = rhs.trim();
+        if rhs == "opaque" {
+            continue;
+        }
+        if let Ok(ty) = parse_type(rhs) {
+            map.insert(name.to_string(), ty);
+        }
+    }
+    map
+}
+
+fn resolve_type(ty: &LlType, named: &HashMap<String, LlType>, depth: usize) -> LlType {
+    if depth > 32 {
+        return ty.clone();
+    }
+    match ty {
+        LlType::Int(1) => LlType::Bool,
+        LlType::Named(name) => named
+            .get(name)
+            .map(|inner| resolve_type(inner, named, depth + 1))
+            .unwrap_or_else(|| ty.clone()),
+        LlType::Vector(elem, 1) => resolve_type(elem, named, depth + 1),
+        LlType::Vector(elem, lanes) => {
+            LlType::Vector(Box::new(resolve_type(elem, named, depth + 1)), *lanes)
+        }
+        LlType::Array(elem, len) => {
+            LlType::Array(Box::new(resolve_type(elem, named, depth + 1)), *len)
+        }
+        LlType::Struct(fields) => LlType::Struct(
+            fields
+                .iter()
+                .map(|f| resolve_type(f, named, depth + 1))
+                .collect(),
+        ),
+        _ => ty.clone(),
+    }
+}
+
+fn collect_field_paths(
+    ty: &LlType,
+    base_off: u64,
+    max_bytes: u64,
+    path: &[(bool, u64)],
+    resolve: &impl Fn(&LlType) -> LlType,
+    data_layout: Option<&AirDataLayout>,
+    out: &mut HashMap<(u64, LlType), Vec<(bool, u64)>>,
+) {
+    let resolved = resolve(ty);
+    out.entry((base_off, resolved.clone()))
+        .or_insert_with(|| path.to_vec());
+    match resolved {
+        LlType::Struct(fields) => {
+            let mut off = base_off;
+            for (fi, field) in fields.iter().enumerate() {
+                let Some((sz, align)) = memcpy_size_align(field, resolve, data_layout) else {
+                    break;
+                };
+                off = super::ir::round_up_u64(off, align);
+                if off >= max_bytes {
+                    break;
+                }
+                let mut child = path.to_vec();
+                child.push((true, fi as u64));
+                collect_field_paths(field, off, max_bytes, &child, resolve, data_layout, out);
+                off = off.saturating_add(sz);
+            }
+        }
+        LlType::Array(elem, len) => {
+            if let Some((sz, align)) = memcpy_size_align(&elem, resolve, data_layout) {
+                let stride = super::ir::round_up_u64(sz, align);
+                if stride > 0 {
+                    for idx in 0..u64::from(len) {
+                        let elem_off = base_off.saturating_add(idx.saturating_mul(stride));
+                        if elem_off >= max_bytes {
+                            break;
+                        }
+                        let mut child = path.to_vec();
+                        child.push((false, idx));
+                        collect_field_paths(
+                            &elem,
+                            elem_off,
+                            max_bytes,
+                            &child,
+                            resolve,
+                            data_layout,
+                            out,
+                        );
+                    }
+                }
+            }
+        }
+        _ => {}
+    }
+}
+
+fn parse_alloca_line(line: &str) -> Option<(&str, &str)> {
+    let trimmed = line.trim();
+    let (lhs, rhs) = trimmed.split_once(" = alloca ")?;
+    let lhs = lhs.trim();
+    if !lhs.starts_with('%') {
+        return None;
+    }
+    let ty = rhs.split(',').next()?.trim();
+    if !ty.starts_with('%') {
+        return None;
+    }
+    Some((lhs, ty))
+}
+
+fn is_local_name_char(b: u8) -> bool {
+    b.is_ascii_alphanumeric() || matches!(b, b'_' | b'.' | b'$' | b'-')
+}
+
+fn line_mentions_local(line: &str, local: &str) -> bool {
+    let bytes = line.as_bytes();
+    let mut off = 0usize;
+    while let Some(rel) = line[off..].find(local) {
+        let pos = off + rel;
+        let end = pos + local.len();
+        let before_ok = pos == 0 || !is_local_name_char(bytes[pos - 1]);
+        let after_ok = end == bytes.len() || !is_local_name_char(bytes[end]);
+        if before_ok && after_ok {
+            return true;
+        }
+        off = pos + 1;
+    }
+    false
+}
+
+/// Parse `<lhs> = bitcast <src_ty> <src_val> to <dst_ty>` (stripping any trailing metadata/comments).
+fn parse_bitcast_line(line: &str) -> Option<(&str, &str, &str, &str)> {
+    let trimmed = line.trim();
+    let (lhs, rhs) = trimmed.split_once(" = bitcast ")?;
+    let rhs = rhs.split(';').next().unwrap_or(rhs).trim();
+    let (src_part, dst_part) = rhs.rsplit_once(" to ")?;
+    let dst_ty = dst_part.split(',').next().unwrap_or(dst_part).trim();
+    let src_trim = src_part.trim();
+    let ws = src_trim.rfind(char::is_whitespace)?;
+    let src_ty = src_trim[..ws].trim();
+    let src_val = src_trim[ws..].trim();
+    Some((lhs.trim(), src_ty, src_val, dst_ty))
+}
+
+/// Parse `<lhs> = getelementptr [inbounds] <box_ty>, (<box_ty>*|ptr) <base>, i64/i32 0, i32 0, i64/i32 <off>`.
+/// Returns `(lhs, byte_off, is_opaque)`.
+fn parse_byte_box_gep(line: &str, box_ty: &str, base: &str) -> Option<(String, u64, bool)> {
+    let trimmed = line.trim();
+    let (lhs, mut rhs) = trimmed.split_once(" = getelementptr ")?;
+    if let Some(rest) = rhs.strip_prefix("inbounds ") {
+        rhs = rest;
+    }
+    let rhs = rhs.split(';').next().unwrap_or(rhs).trim();
+    // Strip trailing metadata `, !...` if present.
+    let parts: Vec<&str> = split_top_level_commas(rhs);
+    let non_md: Vec<&str> = parts
+        .into_iter()
+        .map(str::trim)
+        .take_while(|p| !p.starts_with('!'))
+        .collect();
+    if non_md.len() != 5 {
+        return None;
+    }
+    if non_md[0] != box_ty {
+        return None;
+    }
+    let typed_ptr = format!("{box_ty}* {base}");
+    let opaque_ptr = format!("ptr {base}");
+    let is_opaque = if non_md[1] == typed_ptr {
+        false
+    } else if non_md[1] == opaque_ptr {
+        true
+    } else {
+        return None;
+    };
+    if parse_const_int_operand(non_md[2]) != Some(0) {
+        return None;
+    }
+    if parse_const_int_operand(non_md[3]) != Some(0) {
+        return None;
+    }
+    let byte_off = parse_const_int_operand(non_md[4])?;
+    Some((lhs.trim().to_string(), byte_off, is_opaque))
+}
+
+fn find_matching_paren(s: &str, open_idx: usize) -> Option<usize> {
+    let bytes = s.as_bytes();
+    let mut depth = 0usize;
+    let mut in_quote = false;
+    for (idx, &b) in bytes.iter().enumerate().skip(open_idx) {
+        if b == b'"' {
+            in_quote = !in_quote;
+        } else if !in_quote {
+            if b == b'(' {
+                depth += 1;
+            } else if b == b')' {
+                depth -= 1;
+                if depth == 0 {
+                    return Some(idx);
+                }
+            }
+        }
+    }
+    None
+}
+
+fn parse_call_callee_and_args(line: &str) -> Option<(&str, Vec<&str>)> {
+    let trimmed = line.trim();
+    let rhs = trimmed.split_once(" = ").map(|(_, r)| r).unwrap_or(trimmed);
+    if !(rhs.starts_with("call ")
+        || rhs.starts_with("tail call ")
+        || rhs.starts_with("musttail call ")
+        || rhs.starts_with("notail call "))
+    {
+        return None;
+    }
+    let at = rhs.find('@')?;
+    let lp = rhs[at..].find('(')? + at;
+    let callee = rhs[at + 1..lp].trim();
+    let rp = find_matching_paren(rhs, lp)?;
+    let args = split_top_level_commas(&rhs[lp + 1..rp])
+        .into_iter()
+        .map(str::trim)
+        .filter(|a| !a.is_empty())
+        .collect();
+    Some((callee, args))
+}
+
+fn parse_gep_src_and_base(line: &str) -> Option<(&str, &str)> {
+    let trimmed = line.trim();
+    let (_, mut rhs) = trimmed.split_once(" = getelementptr ")?;
+    if let Some(rest) = rhs.strip_prefix("inbounds ") {
+        rhs = rest;
+    }
+    let rhs = rhs.split(';').next().unwrap_or(rhs).trim();
+    let parts = split_top_level_commas(rhs);
+    if parts.len() < 3 {
+        return None;
+    }
+    let src_ty = parts[0].trim();
+    let base_val = parts[1].trim().split_whitespace().last()?;
+    Some((src_ty, base_val))
+}
+
+/// For opaque-pointer IR, infer which named struct types each internal function parameter `(fn, pi)`
+/// is indexed as via `getelementptr [inbounds] %StructName, ptr %p, ...` (transitively across
+/// internal calls).
+fn collect_param_struct_uses(
+    lines: &[&str],
+    named_types: &HashMap<String, LlType>,
+    resolve: &impl Fn(&LlType) -> LlType,
+) -> HashMap<(String, usize), HashSet<String>> {
+    struct FnBody {
+        name: String,
+        params: Vec<Option<String>>,
+        body_start: usize,
+        body_end: usize,
+    }
+    let mut funcs = Vec::new();
+    let mut i = 0usize;
+    while i < lines.len() {
+        let trimmed = lines[i].trim_start();
+        if !trimmed.starts_with("define ") || !trimmed.trim_end().ends_with('{') {
+            i += 1;
+            continue;
+        }
+        let body_start = i + 1;
+        let mut body_end = body_start;
+        while body_end < lines.len() && lines[body_end].trim() != "}" {
+            body_end += 1;
+        }
+        if body_end >= lines.len() {
+            break;
+        }
+        if let Some(at) = trimmed.find('@') {
+            if let Some(lp_rel) = trimmed[at..].find('(') {
+                let lp = at + lp_rel;
+                if let Some(rp) = find_matching_paren(trimmed, lp) {
+                    let name = trimmed[at + 1..lp].trim().to_string();
+                    let params = split_top_level_commas(&trimmed[lp + 1..rp])
+                        .into_iter()
+                        .map(|p| {
+                            let tok = p.trim().split_whitespace().last()?;
+                            tok.starts_with('%').then(|| tok.to_string())
+                        })
+                        .collect();
+                    funcs.push(FnBody {
+                        name,
+                        params,
+                        body_start,
+                        body_end,
+                    });
+                }
+            }
+        }
+        i = body_end + 1;
+    }
+
+    let is_nonempty_struct = |name: &str| -> bool {
+        name.starts_with('%')
+            && named_types
+                .get(name)
+                .is_some_and(|t| matches!(resolve(t), LlType::Struct(ref fs) if !fs.is_empty()))
+    };
+
+    let mut direct_uses: HashMap<(String, usize), HashSet<String>> = HashMap::new();
+    let mut call_edges: Vec<(String, usize, String, usize)> = Vec::new();
+
+    for f in &funcs {
+        // Track alias sets for each parameter within `f` (only direct `bitcast ptr %a to ptr`).
+        let mut alias_to_param: HashMap<String, usize> = HashMap::new();
+        for (pi, pname) in f.params.iter().enumerate() {
+            if let Some(name) = pname {
+                alias_to_param.insert(name.clone(), pi);
+            }
+        }
+        for li in f.body_start..f.body_end {
+            let line = lines[li];
+            if let Some((lhs, src_ty, src_val, dst_ty)) = parse_bitcast_line(line) {
+                if src_ty == "ptr" && dst_ty == "ptr" {
+                    if let Some(&pi) = alias_to_param.get(src_val) {
+                        alias_to_param.insert(lhs.to_string(), pi);
+                    }
+                }
+            } else if let Some((src_ty, base_val)) = parse_gep_src_and_base(line) {
+                if is_nonempty_struct(src_ty) {
+                    if let Some(&pi) = alias_to_param.get(base_val) {
+                        direct_uses
+                            .entry((f.name.clone(), pi))
+                            .or_default()
+                            .insert(src_ty.to_string());
+                    }
+                }
+            } else if let Some((callee, args)) = parse_call_callee_and_args(line) {
+                for (ai, arg) in args.iter().enumerate() {
+                    if let Some(tok) = arg.split_whitespace().last() {
+                        if let Some(&pi) = alias_to_param.get(tok) {
+                            call_edges.push((f.name.clone(), pi, callee.to_string(), ai));
+                        }
+                    }
+                }
+            }
+        }
+    }
+
+    for _ in 0..8 {
+        let mut changed = false;
+        for (caller, pi, callee, ai) in &call_edges {
+            if let Some(callee_structs) = direct_uses.get(&(callee.clone(), *ai)).cloned() {
+                let entry = direct_uses.entry((caller.clone(), *pi)).or_default();
+                for s in callee_structs {
+                    if entry.insert(s) {
+                        changed = true;
+                    }
+                }
+            }
+        }
+        if !changed {
+            break;
+        }
+    }
+    direct_uses
+}
+
+/// Extract `(value_type, is_plain_load)` from a `load <T>, ptr %var` or `store <T> <val>, ptr %var`
+/// line that directly accesses `%var` as its pointer operand.
+fn parse_opaque_mem_access<'a>(line: &'a str, ptr_var: &str) -> Option<(&'a str, bool)> {
+    let trimmed = line.trim();
+    if let Some((_, rhs)) = trimmed.split_once(" = load ") {
+        let is_volatile = rhs.starts_with("volatile ");
+        let rhs = rhs.strip_prefix("volatile ").unwrap_or(rhs).trim();
+        let parts = split_top_level_commas(rhs);
+        if parts.len() >= 2 && parts[1].trim().split_whitespace().last() == Some(ptr_var) {
+            return Some((parts[0].trim(), !is_volatile));
+        }
+        return None;
+    }
+    if let Some(rhs) = trimmed.strip_prefix("store ") {
+        let rhs = rhs.strip_prefix("volatile ").unwrap_or(rhs).trim();
+        let parts = split_top_level_commas(rhs);
+        if parts.len() >= 2 && parts[1].trim().split_whitespace().last() == Some(ptr_var) {
+            let val_part = parts[0].trim();
+            if val_part.starts_with('<') {
+                let mut depth = 0usize;
+                for (i, ch) in val_part.char_indices() {
+                    if ch == '<' {
+                        depth += 1;
+                    } else if ch == '>' {
+                        depth -= 1;
+                        if depth == 0 {
+                            return Some((val_part[..=i].trim(), false));
+                        }
+                    }
+                }
+                return None;
+            }
+            let ws = val_part.rfind(char::is_whitespace)?;
+            return Some((val_part[..ws].trim(), false));
+        }
+    }
+    None
+}
+
+/// Extract the LHS register name of a non-volatile `load <T>, ptr %ptr_var, ...` line.
+fn parse_plain_load_lhs<'a>(line: &'a str, ptr_var: &str) -> Option<&'a str> {
+    let trimmed = line.trim();
+    let (lhs, rhs) = trimmed.split_once(" = load ")?;
+    if rhs.starts_with("volatile ") {
+        return None;
+    }
+    let parts = split_top_level_commas(rhs.trim());
+    if parts.len() >= 2 && parts[1].trim().split_whitespace().last() == Some(ptr_var) {
+        let lhs = lhs.trim();
+        if lhs.starts_with('%') {
+            return Some(lhs);
+        }
+    }
+    None
+}
+
+/// Extract the accessed value type string from a `load <T>, ptr %var` or `store <T> <val>, ptr %var`
+/// line that directly accesses `%var` as its pointer operand.
+fn parse_opaque_mem_access_ty<'a>(line: &'a str, ptr_var: &str) -> Option<&'a str> {
+    parse_opaque_mem_access(line, ptr_var).map(|(ty, _)| ty)
+}
+
+/// Parse `<lhs> = select <cond_ty> <cond>, ptr <tval>, ptr <fval>` when `ptr_var` is one of the
+/// selected pointer operands.
+fn parse_opaque_ptr_select_lhs<'a>(line: &'a str, ptr_var: &str) -> Option<&'a str> {
+    let trimmed = line.trim();
+    let (lhs, rhs) = trimmed.split_once(" = select ")?;
+    let rhs = rhs.split(';').next().unwrap_or(rhs).trim();
+    let parts = split_top_level_commas(rhs);
+    if parts.len() < 3 {
+        return None;
+    }
+    let t_part = parts[1].trim();
+    let f_part = parts[2].trim();
+    if !t_part.starts_with("ptr ") || !f_part.starts_with("ptr ") {
+        return None;
+    }
+    let t_val = t_part.split_whitespace().last()?;
+    let f_val = f_part.split_whitespace().last()?;
+    if t_val == ptr_var || f_val == ptr_var {
+        let lhs = lhs.trim();
+        if lhs.starts_with('%') {
+            return Some(lhs);
+        }
+    }
+    None
+}
+
+/// Infer the target struct field path at `byte_off` for an opaque sub-pointer (`ptr_var`) from its
+/// uses (loads, stores, struct GEPs, calls to internal helpers with known struct parameter uses,
+/// and transitive opaque `bitcast ptr to ptr` / `select ..., ptr, ptr` aliases).
+///
+/// When all non-lifetime uses are direct plain `<3 x T>` loads and `(byte_off, <3 x T>)` does not
+/// match a field directly, also accepts a `<4 x T>` field at `byte_off` and returns the widened
+/// `<4 x T>` type string along with the load line indices to rewrite into `load <4 x T>` +
+/// `shufflevector`.
+#[allow(clippy::too_many_arguments)]
+fn resolve_opaque_subptr_field<'a>(
+    lines: &[&str],
+    body_start: usize,
+    body_end: usize,
+    uses: &[usize],
+    ptr_var: &str,
+    byte_off: u64,
+    param_struct_uses: &HashMap<(String, usize), HashSet<String>>,
+    resolve: &impl Fn(&LlType) -> LlType,
+    field_map: &'a HashMap<(u64, LlType), Vec<(bool, u64)>>,
+) -> Option<(&'a [(bool, u64)], Option<(String, Vec<usize>)>)> {
+    let mut inferred_tys: HashSet<String> = HashSet::new();
+    let mut all_plain_loads = true;
+    let mut load_lines: Vec<usize> = Vec::new();
+    let mut visited: HashSet<String> = HashSet::from([ptr_var.to_string()]);
+    let mut worklist: Vec<(String, Vec<usize>, bool)> =
+        vec![(ptr_var.to_string(), uses.to_vec(), true)];
+
+    while let Some((cur_var, cur_uses, is_root)) = worklist.pop() {
+        for cu in cur_uses {
+            let cline = lines[cu];
+            if is_lifetime_call(cline) {
+                continue;
+            }
+            if let Some((vty, is_plain_load)) = parse_opaque_mem_access(cline, &cur_var) {
+                inferred_tys.insert(vty.to_string());
+                if is_root && is_plain_load {
+                    load_lines.push(cu);
+                } else {
+                    all_plain_loads = false;
+                }
+                continue;
+            }
+            if let Some((gep_ty, base)) = parse_gep_src_and_base(cline) {
+                if base == cur_var {
+                    inferred_tys.insert(gep_ty.to_string());
+                    all_plain_loads = false;
+                    continue;
+                }
+            }
+            if let Some((callee, args)) = parse_call_callee_and_args(cline) {
+                let mut matched = false;
+                for (ai, arg) in args.iter().enumerate() {
+                    if arg.split_whitespace().last() == Some(cur_var.as_str()) {
+                        matched = true;
+                        let structs = param_struct_uses.get(&(callee.to_string(), ai))?;
+                        if structs.is_empty() {
+                            return None;
+                        }
+                        for s in structs {
+                            inferred_tys.insert(s.clone());
+                        }
+                    }
+                }
+                if matched {
+                    all_plain_loads = false;
+                    continue;
+                }
+            }
+            if let Some((alias_lhs, src_ty, src_val, dst_ty)) = parse_bitcast_line(cline) {
+                if src_ty == "ptr" && dst_ty == "ptr" && src_val == cur_var {
+                    all_plain_loads = false;
+                    if visited.insert(alias_lhs.to_string()) {
+                        let next_uses: Vec<usize> = (body_start..body_end)
+                            .filter(|&nu| nu != cu && line_mentions_local(lines[nu], alias_lhs))
+                            .collect();
+                        if next_uses.is_empty() {
+                            return None;
+                        }
+                        worklist.push((alias_lhs.to_string(), next_uses, false));
+                    }
+                    continue;
+                }
+            }
+            if let Some(sel_lhs) = parse_opaque_ptr_select_lhs(cline, &cur_var) {
+                all_plain_loads = false;
+                if visited.insert(sel_lhs.to_string()) {
+                    let next_uses: Vec<usize> = (body_start..body_end)
+                        .filter(|&nu| nu != cu && line_mentions_local(lines[nu], sel_lhs))
+                        .collect();
+                    if next_uses.is_empty() {
+                        return None;
+                    }
+                    worklist.push((sel_lhs.to_string(), next_uses, false));
+                }
+                continue;
+            }
+            return None;
+        }
+    }
+    if inferred_tys.len() != 1 {
+        return None;
+    }
+    let vty_str = inferred_tys.into_iter().next()?;
+    let field_ty = resolve(&parse_type(&vty_str).ok()?);
+    if let Some(path) = field_map.get(&(byte_off, field_ty.clone())) {
+        return Some((path.as_slice(), None));
+    }
+    if all_plain_loads && !load_lines.is_empty() {
+        if let LlType::Vector(elem, 3) = field_ty {
+            if let Some(path) = field_map.get(&(byte_off, LlType::Vector(elem, 4))) {
+                let inner = vty_str.trim().strip_prefix("<3 x ")?.strip_suffix('>')?.trim();
+                let wide_ty = format!("<4 x {inner}>");
+                for &cu in &load_lines {
+                    parse_plain_load_lhs(lines[cu], ptr_var)?;
+                }
+                return Some((path.as_slice(), Some((wide_ty, load_lines))));
+            }
+        }
+    }
+    None
+}
+
+fn push_vec3_prefix_load_edits(
+    lines: &[&str],
+    ptr_var: &str,
+    wide_ty: &str,
+    load_lines: &[usize],
+    edits: &mut Vec<(usize, Option<String>)>,
+) -> Option<()> {
+    for &cu in load_lines {
+        let cline = lines[cu];
+        let load_lhs = parse_plain_load_lhs(cline, ptr_var)?;
+        let lindent = &cline[..cline.len() - cline.trim_start().len()];
+        let tmp = format!("%__m2v.saa.v4.{cu}");
+        edits.push((
+            cu,
+            Some(format!(
+                "{lindent}{tmp} = load {wide_ty}, ptr {ptr_var}, align 16\n{lindent}{load_lhs} = shufflevector {wide_ty} {tmp}, {wide_ty} poison, <3 x i32> <i32 0, i32 1, i32 2>"
+            )),
+        ));
+    }
+    Some(())
+}
+
+fn parse_const_int_operand(op: &str) -> Option<u64> {
+    let mut toks = op.split_whitespace();
+    let ty = toks.next()?;
+    if !matches!(ty, "i32" | "i64") {
+        return None;
+    }
+    let val = toks.next()?;
+    if toks.next().is_some() {
+        return None;
+    }
+    val.parse::<u64>().ok()
+}
+
+fn split_top_level_commas(s: &str) -> Vec<&str> {
+    let mut out = Vec::new();
+    let mut depth = 0usize;
+    let mut in_quotes = false;
+    let mut start = 0usize;
+    for (i, b) in s.bytes().enumerate() {
+        match b {
+            b'"' => in_quotes = !in_quotes,
+            b'(' | b'<' | b'{' | b'[' if !in_quotes => depth += 1,
+            b')' | b'>' | b'}' | b']' if !in_quotes => depth = depth.saturating_sub(1),
+            b',' if !in_quotes && depth == 0 => {
+                out.push(&s[start..i]);
+                start = i + 1;
+            }
+            _ => {}
+        }
+    }
+    out.push(&s[start..]);
+    out
+}
+
+fn is_lifetime_call(line: &str) -> bool {
+    let trimmed = line.trim();
+    trimmed.contains("@llvm.lifetime.start") || trimmed.contains("@llvm.lifetime.end")
+}
+
+fn format_gep_path(path: &[(bool, u64)]) -> String {
+    let mut s = String::new();
+    for &(is_struct, idx) in path {
+        if is_struct {
+            s.push_str(&format!(", i32 {idx}"));
+        } else {
+            s.push_str(&format!(", i64 {idx}"));
+        }
+    }
+    s
+}
+
+#[allow(clippy::too_many_arguments)]
+fn plan_alloca_promotion(
+    lines: &[&str],
+    body_start: usize,
+    body_end: usize,
+    alloca_idx: usize,
+    alloca_name: &str,
+    box_ty: &str,
+    box_size: u64,
+    named_types: &HashMap<String, LlType>,
+    resolve: &impl Fn(&LlType) -> LlType,
+    data_layout: Option<&AirDataLayout>,
+    param_struct_uses: &HashMap<(String, usize), HashSet<String>>,
+    field_maps: &mut HashMap<(String, u64), HashMap<(u64, LlType), Vec<(bool, u64)>>>,
+) -> Option<Vec<(usize, Option<String>)>> {
+    let box_ptr_ty = format!("{box_ty}*");
+    let use_indices: Vec<usize> = (body_start..body_end)
+        .filter(|&idx| idx != alloca_idx && line_mentions_local(lines[idx], alloca_name))
+        .collect();
+    if use_indices.is_empty() {
+        return None;
+    }
+
+    // Step 1: discover the unique target named struct this byte-box alloca aliases.
+    // - Typed-pointer IR: `bitcast %Box* %alloca to %Target*`
+    // - Opaque-pointer IR: `bitcast ptr %alloca to ptr` (or `%alloca` directly) used in
+    //   `getelementptr %Target, ptr ...` or passed to a helper param indexed as `%Target`.
+    let mut target_structs: HashSet<String> = HashSet::new();
+    let mut opaque_aliases: Vec<String> = vec![alloca_name.to_string()];
+    for &idx in &use_indices {
+        if let Some((lhs, src_ty, src_val, dst_ty)) = parse_bitcast_line(lines[idx]) {
+            if src_ty == box_ptr_ty && src_val == alloca_name {
+                if let Some(pointee) = dst_ty.strip_suffix('*') {
+                    let pointee = pointee.trim();
+                    if pointee != box_ty && pointee.starts_with('%') {
+                        if let Some(ty) = named_types.get(pointee) {
+                            if matches!(resolve(ty), LlType::Struct(ref fields) if !fields.is_empty())
+                            {
+                                target_structs.insert(pointee.to_string());
+                            }
+                        }
+                    }
+                }
+            } else if src_ty == "ptr" && dst_ty == "ptr" && src_val == alloca_name {
+                opaque_aliases.push(lhs.to_string());
+            }
+        }
+    }
+    if target_structs.is_empty() {
+        for li in body_start..body_end {
+            let line = lines[li];
+            if let Some((src_ty, base_val)) = parse_gep_src_and_base(line) {
+                if src_ty != box_ty
+                    && src_ty.starts_with('%')
+                    && opaque_aliases.iter().any(|a| a == base_val)
+                    && named_types
+                        .get(src_ty)
+                        .is_some_and(|t| matches!(resolve(t), LlType::Struct(ref f) if !f.is_empty()))
+                {
+                    target_structs.insert(src_ty.to_string());
+                }
+            } else if let Some((callee, args)) = parse_call_callee_and_args(line) {
+                for (ai, arg) in args.iter().enumerate() {
+                    if let Some(tok) = arg.split_whitespace().last() {
+                        if opaque_aliases.iter().any(|a| a == tok) {
+                            if let Some(structs) = param_struct_uses.get(&(callee.to_string(), ai)) {
+                                for s in structs {
+                                    if s != box_ty {
+                                        target_structs.insert(s.clone());
+                                    }
+                                }
+                            }
+                        }
+                    }
+                }
+            }
+        }
+    }
+    if target_structs.len() != 1 {
+        return None;
+    }
+    let target_struct = target_structs.into_iter().next()?;
+    let target_ll_ty = named_types.get(&target_struct)?;
+    let (target_size, _) = memcpy_size_align(target_ll_ty, resolve, data_layout)?;
+    if target_size < box_size {
+        return None;
+    }
+
+    let field_map = field_maps
+        .entry((target_struct.clone(), box_size))
+        .or_insert_with(|| {
+            let mut m = HashMap::new();
+            collect_field_paths(target_ll_ty, 0, box_size, &[], resolve, data_layout, &mut m);
+            m
+        });
+
+    let mut edits: Vec<(usize, Option<String>)> = Vec::new();
+    let alloca_line = lines[alloca_idx];
+    let rewritten_alloca = alloca_line.replacen(
+        &format!("= alloca {box_ty}"),
+        &format!("= alloca {target_struct}"),
+        1,
+    );
+    edits.push((alloca_idx, Some(rewritten_alloca)));
+
+    // Step 2: verify and plan rewrites for every single use of `alloca_name`.
+    for &idx in &use_indices {
+        let line = lines[idx];
+        let indent = &line[..line.len() - line.trim_start().len()];
+
+        if let Some((lhs, src_ty, src_val, dst_ty)) = parse_bitcast_line(line) {
+            if src_val != alloca_name {
+                return None;
+            }
+            if src_ty == "ptr" && dst_ty == "ptr" {
+                let alias_uses: Vec<usize> = (body_start..body_end)
+                    .filter(|&u| u != idx && line_mentions_local(lines[u], lhs))
+                    .collect();
+                if alias_uses.iter().all(|&u| is_lifetime_call(lines[u])) {
+                    // Pure lifetime alias; valid unchanged under `alloca {target_struct}`.
+                    continue;
+                }
+                let mut mem_tys: HashSet<String> = HashSet::new();
+                let mut all_mem = !alias_uses.is_empty();
+                for &u in &alias_uses {
+                    if let Some(vty) = parse_opaque_mem_access_ty(lines[u], lhs) {
+                        mem_tys.insert(vty.to_string());
+                    } else {
+                        all_mem = false;
+                        break;
+                    }
+                }
+                if all_mem && mem_tys.len() == 1 {
+                    let vty_str = mem_tys.into_iter().next()?;
+                    let field_ty = resolve(&parse_type(&vty_str).ok()?);
+                    let path = field_map.get(&(0, field_ty))?;
+                    let gep_tail = format_gep_path(path);
+                    edits.push((
+                        idx,
+                        Some(format!(
+                            "{indent}{lhs} = getelementptr inbounds {target_struct}, ptr {alloca_name}, i64 0{gep_tail}"
+                        )),
+                    ));
+                    continue;
+                }
+                // Whole-struct alias: verify every use is lifetime, GEP on `target_struct`, or
+                // call to a helper whose matching param uses `target_struct` (never another struct).
+                let whole_ok = alias_uses.iter().all(|&u| {
+                    let uline = lines[u];
+                    if is_lifetime_call(uline) {
+                        return true;
+                    }
+                    if let Some((gep_ty, base)) = parse_gep_src_and_base(uline) {
+                        return base == lhs && gep_ty == target_struct;
+                    }
+                    if let Some((callee, args)) = parse_call_callee_and_args(uline) {
+                        let mut matched = false;
+                        for (ai, arg) in args.iter().enumerate() {
+                            if arg.split_whitespace().last() == Some(lhs) {
+                                matched = true;
+                                let Some(structs) =
+                                    param_struct_uses.get(&(callee.to_string(), ai))
+                                else {
+                                    return false;
+                                };
+                                if !structs.iter().all(|s| s == &target_struct) {
+                                    return false;
+                                }
+                            }
+                        }
+                        return matched;
+                    }
+                    false
+                });
+                if !whole_ok {
+                    return None;
+                }
+                edits.push((
+                    idx,
+                    Some(format!(
+                        "{indent}{lhs} = getelementptr inbounds {target_struct}, ptr {alloca_name}, i64 0"
+                    )),
+                ));
+                continue;
+            }
+            if src_ty != box_ptr_ty {
+                return None;
+            }
+            let dst_pointee_str = dst_ty.strip_suffix('*')?.trim();
+            if dst_pointee_str == target_struct {
+                edits.push((
+                    idx,
+                    Some(format!(
+                        "{indent}{lhs} = getelementptr inbounds {target_struct}, {target_struct}* {alloca_name}, i64 0"
+                    )),
+                ));
+                continue;
+            }
+            if dst_pointee_str == "i8" {
+                let ptr_uses_only_lifetime = (body_start..body_end)
+                    .filter(|&u| u != idx && line_mentions_local(lines[u], lhs))
+                    .all(|u| is_lifetime_call(lines[u]));
+                if ptr_uses_only_lifetime {
+                    edits.push((
+                        idx,
+                        Some(format!(
+                            "{indent}{lhs} = bitcast {target_struct}* {alloca_name} to i8*"
+                        )),
+                    ));
+                    continue;
+                }
+            }
+            let field_ty = resolve(&parse_type(dst_pointee_str).ok()?);
+            let path = field_map.get(&(0, field_ty))?;
+            let gep_tail = format_gep_path(path);
+            edits.push((
+                idx,
+                Some(format!(
+                    "{indent}{lhs} = getelementptr inbounds {target_struct}, {target_struct}* {alloca_name}, i64 0{gep_tail}"
+                )),
+            ));
+            continue;
+        }
+
+        if let Some((gep_lhs, byte_off, is_opaque)) = parse_byte_box_gep(line, box_ty, alloca_name) {
+            let gep_uses: Vec<usize> = (body_start..body_end)
+                .filter(|&u| u != idx && line_mentions_local(lines[u], &gep_lhs))
+                .collect();
+            let mut has_lifetime = false;
+            let mut direct_uses: Vec<usize> = Vec::new();
+            for &u in &gep_uses {
+                let uline = lines[u];
+                if is_lifetime_call(uline) {
+                    has_lifetime = true;
+                    continue;
+                }
+                if is_opaque {
+                    if let Some((cast_lhs, cast_src_ty, cast_src_val, cast_dst_ty)) =
+                        parse_bitcast_line(uline)
+                    {
+                        if cast_src_ty != "ptr" || cast_dst_ty != "ptr" || cast_src_val != gep_lhs {
+                            return None;
+                        }
+                        let cast_uses: Vec<usize> = (body_start..body_end)
+                            .filter(|&cu| cu != u && line_mentions_local(lines[cu], cast_lhs))
+                            .collect();
+                        if cast_uses.is_empty() {
+                            return None;
+                        }
+                        let (path, vec3_prefix) = resolve_opaque_subptr_field(
+                            lines,
+                            body_start,
+                            body_end,
+                            &cast_uses,
+                            cast_lhs,
+                            byte_off,
+                            param_struct_uses,
+                            resolve,
+                            field_map,
+                        )?;
+                        let uindent = &uline[..uline.len() - uline.trim_start().len()];
+                        let gep_tail = format_gep_path(path);
+                        edits.push((
+                            u,
+                            Some(format!(
+                                "{uindent}{cast_lhs} = getelementptr inbounds {target_struct}, ptr {alloca_name}, i64 0{gep_tail}"
+                            )),
+                        ));
+                        if let Some((wide_ty, load_lines)) = vec3_prefix {
+                            push_vec3_prefix_load_edits(
+                                lines,
+                                cast_lhs,
+                                &wide_ty,
+                                &load_lines,
+                                &mut edits,
+                            )?;
+                        }
+                        continue;
+                    }
+                    direct_uses.push(u);
+                    continue;
+                }
+                let Some((cast_lhs, cast_src_ty, cast_src_val, cast_dst_ty)) =
+                    parse_bitcast_line(uline)
+                else {
+                    return None;
+                };
+                if cast_src_ty != "i8*" || cast_src_val != gep_lhs {
+                    return None;
+                }
+                let dst_pointee_str = cast_dst_ty.strip_suffix('*')?.trim();
+                let field_ty = resolve(&parse_type(dst_pointee_str).ok()?);
+                let path = field_map.get(&(byte_off, field_ty))?;
+                let uindent = &uline[..uline.len() - uline.trim_start().len()];
+                let gep_tail = format_gep_path(path);
+                edits.push((
+                    u,
+                    Some(format!(
+                        "{uindent}{cast_lhs} = getelementptr inbounds {target_struct}, {target_struct}* {alloca_name}, i64 0{gep_tail}"
+                    )),
+                ));
+            }
+            if !direct_uses.is_empty() {
+                if has_lifetime {
+                    return None;
+                }
+                let (path, vec3_prefix) = resolve_opaque_subptr_field(
+                    lines,
+                    body_start,
+                    body_end,
+                    &direct_uses,
+                    &gep_lhs,
+                    byte_off,
+                    param_struct_uses,
+                    resolve,
+                    field_map,
+                )?;
+                let gep_tail = format_gep_path(path);
+                edits.push((
+                    idx,
+                    Some(format!(
+                        "{indent}{gep_lhs} = getelementptr inbounds {target_struct}, ptr {alloca_name}, i64 0{gep_tail}"
+                    )),
+                ));
+                if let Some((wide_ty, load_lines)) = vec3_prefix {
+                    push_vec3_prefix_load_edits(
+                        lines,
+                        &gep_lhs,
+                        &wide_ty,
+                        &load_lines,
+                        &mut edits,
+                    )?;
+                }
+            } else if has_lifetime {
+                if byte_off != 0 {
+                    return None;
+                }
+                let repl = if is_opaque {
+                    format!("{indent}{gep_lhs} = bitcast ptr {alloca_name} to ptr")
+                } else {
+                    format!("{indent}{gep_lhs} = bitcast {target_struct}* {alloca_name} to i8*")
+                };
+                edits.push((idx, Some(repl)));
+            } else {
+                edits.push((idx, None));
+            }
+            continue;
+        }
+
+        if is_lifetime_call(line) {
+            continue;
+        }
+        if let Some((gep_ty, base)) = parse_gep_src_and_base(line) {
+            if base == alloca_name && gep_ty == target_struct {
+                continue;
+            }
+        }
+        if let Some((callee, args)) = parse_call_callee_and_args(line) {
+            let mut matched = false;
+            let mut ok = true;
+            for (ai, arg) in args.iter().enumerate() {
+                if arg.split_whitespace().last() == Some(alloca_name) {
+                    matched = true;
+                    let Some(structs) = param_struct_uses.get(&(callee.to_string(), ai)) else {
+                        ok = false;
+                        break;
+                    };
+                    if !structs.iter().all(|s| s == &target_struct) {
+                        ok = false;
+                        break;
+                    }
+                }
+            }
+            if matched && ok {
+                continue;
+            }
+        }
+
+        // Unrecognized use of the byte-box alloca -> bail out safely.
+        return None;
+    }
+
+    Some(edits)
+}
+
