+/// Inline internal helpers that compare a pointer parameter against another non-null pointer
+/// (`icmp eq`/`ne T* %a, %param`). Logical SPIR-V cannot compare two Function-storage pointers
+/// across a call boundary; moving the helper body into its caller exposes the caller's GEP
+/// provenance so `emit_provenance_pointer_icmp` lowers the comparison to element-index equality.
+pub(super) fn inline_pointer_icmp_param_consumers(san_ll: &str) -> std::borrow::Cow<'_, str> {
+    if !san_ll.contains("icmp eq ") && !san_ll.contains("icmp ne ") {
+        return std::borrow::Cow::Borrowed(san_ll);
+    }
+    let Some(items) = parse_items(san_ll) else {
+        return std::borrow::Cow::Borrowed(san_ll);
+    };
+    let mut param_icmp_callees: HashMap<String, Vec<usize>> = HashMap::new();
+    for item in &items {
+        let Item::Func(function) = item else {
+            continue;
+        };
+        let Some(sig) = parse_def_header(&function.header) else {
+            continue;
+        };
+        if !sig.internal || sig.params.is_empty() {
+            continue;
+        }
+        let mut compared_indices = Vec::new();
+        for line in &function.body {
+            let trimmed = line.trim();
+            let Some((_, rhs)) = trimmed.split_once(" = ") else {
+                continue;
+            };
+            let rest = if let Some(r) = rhs.strip_prefix("icmp eq ") {
+                r
+            } else if let Some(r) = rhs.strip_prefix("icmp ne ") {
+                r
+            } else {
+                continue;
+            };
+            let Some((lhs_part, rhs_part)) = rest.split_once(',') else {
+                continue;
+            };
+            let lhs_trim = lhs_part.trim();
+            let Some(ws) = lhs_trim.rfind(char::is_whitespace) else {
+                continue;
+            };
+            let ty_str = lhs_trim[..ws].trim();
+            if !(ty_str.ends_with('*') || ty_str == "ptr" || ty_str.starts_with("ptr addrspace("))
+            {
+                continue;
+            }
+            let lhs_val = lhs_trim[ws..].trim();
+            let rhs_val = rhs_part.split(',').next().unwrap_or(rhs_part).trim();
+            if matches!(lhs_val, "null" | "undef" | "poison")
+                || matches!(rhs_val, "null" | "undef" | "poison")
+            {
+                continue;
+            }
+            for (pi, pname) in sig.params.iter().enumerate() {
+                if (lhs_val == pname || rhs_val == pname) && !compared_indices.contains(&pi) {
+                    compared_indices.push(pi);
+                }
+            }
+        }
+        if !compared_indices.is_empty() {
+            param_icmp_callees.insert(sig.name, compared_indices);
+        }
+    }
+    if param_icmp_callees.is_empty() {
+        return std::borrow::Cow::Borrowed(san_ll);
+    }
+    let mut selected_sites: Vec<(String, String)> = Vec::new();
+    for item in &items {
+        let Item::Func(function) = item else {
+            continue;
+        };
+        for line in &function.body {
+            let Some(call) = parse_call(line) else {
+                continue;
+            };
+            let Some(indices) = param_icmp_callees.get(&call.callee) else {
+                continue;
+            };
+            for &pi in indices {
+                if let Some(arg) = call.args.get(pi) {
+                    let pair = (arg.clone(), call.callee.clone());
+                    if !selected_sites.contains(&pair) {
+                        selected_sites.push(pair);
+                    }
+                }
+            }
+        }
+    }
+    if selected_sites.is_empty() {
+        return std::borrow::Cow::Borrowed(san_ll);
+    }
+    let mut source = san_ll.to_string();
+    let mut changed = false;
+    for (arg, callee) in selected_sites {
+        let targets = HashSet::from([callee]);
+        if let Some(inlined) = try_inline(&source, Some((&targets, arg.as_str(), None)), false) {
+            if inlined != source {
+                changed = true;
+                source = inlined;
+            }
+        }
+    }
+    if changed {
+        std::borrow::Cow::Owned(source)
+    } else {
+        std::borrow::Cow::Borrowed(san_ll)
+    }
+}
+
+pub(super) fn inline_pointer_icmp_param_consumers_owned(san_ll: String) -> String {
+    match inline_pointer_icmp_param_consumers(&san_ll) {
+        std::borrow::Cow::Borrowed(_) => san_ll,
+        std::borrow::Cow::Owned(rewritten) => rewritten,
+    }
+}
