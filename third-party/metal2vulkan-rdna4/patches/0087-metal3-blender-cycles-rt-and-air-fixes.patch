+        let mut lca = sites[0].0;
+        for &(bi, _, _) in &sites[1..] {
+            while !dom.dominates(lca, bi) {
+                let Some(parent) = dom.immediate_dominator(lca) else {
+                    break;
+                };
+                lca = parent;
+            }
+        }
+        if !sites.iter().all(|&(bi, _, _)| dom.dominates(lca, bi)) {
+            continue;
+        }
+        let args_dominate_lca = [lo, hi, cat].into_iter().all(|arg| {
+            def_pos
+                .get(&arg)
+                .is_none_or(|&(db, _)| dom.dominates(db, lca))
+        });
+        if !args_dominate_lca {
+            continue;
+        }
+
+        if let Some(&(_, _, dom_id)) = sites
+            .iter()
+            .filter(|&&(bi, _, _)| bi == lca)
+            .min_by_key(|&&(_, ii, _)| ii)
+        {
+            for &(_, _, id) in sites {
+                if id != dom_id {
+                    remove_ids.insert(id);
+                    replace.insert(id, dom_id);
+                }
+            }
+            continue;
+        }
+
+        let lca_insts = &ctx.module.functions[func_idx].blocks[lca].instructions;
+        if lca_insts.is_empty() {
+            continue;
+        }
+        let term_idx = if lca_insts.len() >= 2
+            && matches!(
+                lca_insts[lca_insts.len() - 2].class.opcode,
+                Op::SelectionMerge | Op::LoopMerge
+            ) {
+            lca_insts.len() - 2
+        } else {
+            lca_insts.len() - 1
+        };
+        let mut min_idx = lca_insts
+            .iter()
+            .take_while(|inst| matches!(inst.class.opcode, Op::Phi | Op::Variable))
+            .count();
+        for arg in [lo, hi, cat] {
+            if let Some(&(db, di)) = def_pos.get(&arg) {
+                if db == lca {
+                    min_idx = min_idx.max(di + 1);
+                }
+            }
+        }
+        if min_idx > term_idx {
+            continue;
+        }
+
+        let canonical = ctx.module.fresh_id();
+        hoists.entry(lca).or_default().push(Instruction::new(
+            Op::FunctionCall,
+            Some(uint),
+            Some(canonical),
+            vec![
+                Operand::IdRef(lookup),
+                Operand::IdRef(lo),
+                Operand::IdRef(hi),
+                Operand::IdRef(cat),
+            ],
+        ));
+        for &(_, _, id) in sites {
+            remove_ids.insert(id);
+            replace.insert(id, canonical);
+        }
+    }
+
+    if replace.is_empty() {
+        return;
+    }
+
+    for (bi, block) in ctx.module.functions[func_idx].blocks.iter_mut().enumerate() {
+        block
+            .instructions
+            .retain(|inst| !inst.result_id.is_some_and(|id| remove_ids.contains(&id)));
+        if let Some(inserted) = hoists.remove(&bi) {
+            let len = block.instructions.len();
+            let term_idx = if len >= 2
+                && matches!(
+                    block.instructions[len - 2].class.opcode,
+                    Op::SelectionMerge | Op::LoopMerge
+                ) {
+                len - 2
+            } else {
+                len.saturating_sub(1)
+            };
+            block
+                .instructions
+                .splice(term_idx..term_idx, inserted);
+        }
+        for inst in &mut block.instructions {
+            for operand in &mut inst.operands {
+                if let Operand::IdRef(id) = operand {
+                    if let Some(&new_id) = replace.get(id) {
+                        *id = new_id;
+                    }
+                }
+            }
+        }
+    }
+
+    for access in ctx.sampled_descriptor_accesses.values_mut() {
+        if let Some(&new_id) = replace.get(&access.token_index) {
+            access.token_index = new_id;
+        }
+        if let Some(&new_id) = replace.get(&access.physical_index) {
+            access.physical_index = new_id;
+        }
+    }
+}
