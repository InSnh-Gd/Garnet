+fn llvm_ptr_addrspace(ty: &str) -> Option<u32> {
+    let t = ty.trim();
+    if t == "ptr" {
+        return Some(0);
+    }
+    if let Some(rest) = t.strip_prefix("ptr addrspace(") {
+        return rest.strip_suffix(')')?.trim().parse::<u32>().ok();
+    }
+    if let Some(before_star) = t.strip_suffix('*') {
+        let b = before_star.trim_end();
+        if let Some(pos) = b.rfind("addrspace(") {
+            let after = &b[pos + "addrspace(".len()..];
+            if let Some(end) = after.find(')') {
+                if after[end + 1..].trim().is_empty() {
+                    return after[..end].trim().parse::<u32>().ok();
+                }
+            }
+        }
+        return Some(0);
+    }
+    None
+}
