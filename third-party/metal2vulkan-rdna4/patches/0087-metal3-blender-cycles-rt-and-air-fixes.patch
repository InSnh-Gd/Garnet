+/// Deduplicate and hoist calls to the pure, read-only binding-672 `lookup` helper inside one
+/// function when multiple sites invoke it with identical `(low_key, high_key, category)` SSA
+/// arguments (for example, all 8 arms of a `static_sampler_table` `OpSwitch` sampling the same
+/// runtime texture token).
+///
+/// For each repeated `(lo, hi, cat)` key in reachable blocks:
+/// - If an existing call already resides in the lowest common dominator (`lca`) of all sites,
+///   every other duplicate reuses that dominating result directly.
+/// - Otherwise, if `(lo, hi, cat)` all dominate `lca`, one call is hoisted to `lca` immediately
+///   before its merge/terminator instruction and every duplicate reuses the hoisted result.
+///
+/// `lookup_function` reads only the immutable `NonWritable` binding-672 table (whose dummy row 0
+/// is always valid) and terminates cleanly for any `(u32, u32)` key, so hoisting is 100%
+/// semantics-preserving and eliminates redundant 6-BB binary-search loops prior to RADV inlining.
+pub(super) fn deduplicate_pure_lookup_calls(ctx: &mut Ctx, func_idx: usize, lookup: Word) {
+    let blocks = &ctx.module.functions[func_idx].blocks;
+    if blocks.is_empty() {
+        return;
+    }
+    let dom = crate::passes::spirv_cfg::BlockDominance::of(blocks);
+
+    // Map local SSA definitions to (block_index, inst_index) and chase simple `OpCopyObject`
+    // chains whose source is defined in a dominating position.
+    let mut def_pos: HashMap<Word, (usize, usize)> = HashMap::new();
+    let mut copy_src: HashMap<Word, Word> = HashMap::new();
