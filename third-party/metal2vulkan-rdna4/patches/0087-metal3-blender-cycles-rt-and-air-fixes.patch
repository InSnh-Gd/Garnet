+
+/// Loop-free one-shot validator for the `RegistryV3` header (`table[96..100]`) used when a shader
+/// has too many distinct BDA guard sites (`> REGISTRY_LOOP_GUARD_LIMIT`) for RADV/ACO to inline
+/// the per-access linear scan loop without quadratic `aco::spill` memory blowup.
+///
+/// Called once in the entry block so malformed/empty registry headers still fail closed while each
+/// leaf access checks `header_ok && address != 0 && size <= u64::MAX - address` inline with zero
+/// loops and zero extra basic blocks.
+pub(super) fn registry_header_valid_function(ctx: &mut Ctx, table: Word, vector: Word) -> Word {
+    use super::gpu_arguments::value;
+    let uint = ctx.ty_uint();
+    let ulong = ctx.ty_ulong();
+    let boolean = ctx.ty_bool();
+    let pointer = ctx.ty_ptr(StorageClass::StorageBuffer, vector);
+    let zero = ctx.const_uint(0);
+    let hundred = ctx.const_uint(100);
+    let three = ctx.const_uint(3);
+    let zero64 = ctx.const_int_of(ulong, 0);
+    let eight64 = ctx.const_int_of(ulong, 8);
+    let twenty_four = ctx.const_int_of(ulong, 24);
+    let denied = ctx.const_bool_of(boolean, false);
+    let function_type = ctx.get_or_create(Op::TypeFunction, None, vec![Operand::IdRef(boolean)]);
+    let function = ctx.module.fresh_id();
+    let entry = ctx.module.fresh_id();
+    let header = ctx.module.fresh_id();
+    let reject_short = ctx.module.fresh_id();
+    let inst = |op, operands| Instruction::new(op, None, None, operands);
+    let conditional = |condition, yes, no| {
+        inst(
+            Op::BranchConditional,
+            vec![
+                Operand::IdRef(condition),
+                Operand::IdRef(yes),
+                Operand::IdRef(no),
+            ],
+        )
+    };
+    let selection = |label| {
+        inst(
+            Op::SelectionMerge,
+            vec![
+                Operand::IdRef(label),
+                Operand::SelectionControl(spirv::SelectionControl::NONE),
+            ],
+        )
+    };
+    let returned = |id| inst(Op::ReturnValue, vec![Operand::IdRef(id)]);
+    let binary = |ctx: &mut Ctx, block: &mut Vec<Instruction>, op, ty, a, b| {
+        value(
+            ctx,
+            block,
+            op,
+            ty,
+            vec![Operand::IdRef(a), Operand::IdRef(b)],
+        )
+    };
+    let load = |ctx: &mut Ctx, block: &mut Vec<Instruction>, at| {
+        let p = value(
+            ctx,
+            block,
+            Op::AccessChain,
+            pointer,
+            vec![
+                Operand::IdRef(table),
+                Operand::IdRef(zero),
+                Operand::IdRef(at),
+            ],
+        );
+        let words = value(ctx, block, Op::Load, vector, vec![Operand::IdRef(p)]);
+        value(ctx, block, Op::Bitcast, ulong, vec![Operand::IdRef(words)])
+    };
+    let mut first = vec![];
+    let words = value(
+        ctx,
+        &mut first,
+        Op::ArrayLength,
+        uint,
+        vec![Operand::IdRef(table), Operand::LiteralBit32(0)],
+    );
+    let enough = binary(
+        ctx,
+        &mut first,
+        Op::UGreaterThanEqual,
+        boolean,
+        words,
+        hundred,
+    );
+    first.extend([selection(header), conditional(enough, header, reject_short)]);
+    let mut checks = vec![];
+    let mut fields = vec![];
+    for offset in 96..100 {
+        let at = ctx.const_uint(offset);
+        fields.push(load(ctx, &mut checks, at));
+    }
+    let count = fields[0];
+    let nonempty = binary(ctx, &mut checks, Op::INotEqual, boolean, count, zero64);
+    let stride_ok = binary(
+        ctx,
+        &mut checks,
+        Op::IEqual,
+        boolean,
+        fields[1],
+        twenty_four,
+    );
+    let reserved_ok = binary(ctx, &mut checks, Op::IEqual, boolean, fields[3], zero64);
+    let words64 = value(
+        ctx,
+        &mut checks,
+        Op::UConvert,
+        ulong,
+        vec![Operand::IdRef(words)],
+    );
+    let bytes = binary(ctx, &mut checks, Op::IMul, ulong, words64, eight64);
+    let bytes_ok = binary(ctx, &mut checks, Op::IEqual, boolean, fields[2], bytes);
+    let row_words = binary(ctx, &mut checks, Op::ISub, uint, words, hundred);
+    let capacity = binary(ctx, &mut checks, Op::UDiv, uint, row_words, three);
+    let capacity64 = value(
+        ctx,
+        &mut checks,
+        Op::UConvert,
+        ulong,
+        vec![Operand::IdRef(capacity)],
+    );
+    let count_ok = binary(
+        ctx,
+        &mut checks,
+        Op::ULessThanEqual,
+        boolean,
+        count,
+        capacity64,
+    );
+    let rows_bytes = binary(ctx, &mut checks, Op::IMul, ulong, count, twenty_four);
+    let prefix = ctx.const_int_of(ulong, 800);
+    let expected_bytes = binary(ctx, &mut checks, Op::IAdd, ulong, rows_bytes, prefix);
+    let exact = binary(ctx, &mut checks, Op::IEqual, boolean, expected_bytes, bytes);
+    let mut valid = nonempty;
+    for check in [stride_ok, reserved_ok, bytes_ok, count_ok, exact] {
+        valid = binary(ctx, &mut checks, Op::LogicalAnd, boolean, valid, check);
+    }
+    checks.push(returned(valid));
+    let block = |label, instructions| Block {
+        label: Some(Instruction::new(Op::Label, None, Some(label), vec![])),
+        instructions,
+    };
+    ctx.module.functions.push(Function {
+        def: Some(Instruction::new(
+            Op::Function,
+            Some(boolean),
+            Some(function),
+            vec![
+                Operand::FunctionControl(spirv::FunctionControl::NONE),
+                Operand::IdRef(function_type),
+            ],
+        )),
+        end: Some(inst(Op::FunctionEnd, vec![])),
+        parameters: vec![],
+        blocks: vec![
+            block(entry, first),
+            block(reject_short, vec![returned(denied)]),
+            block(header, checks),
+        ],
+    });
+    function
+}
