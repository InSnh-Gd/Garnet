+fn lower_interpolate_at(
+    ctx: &mut Ctx,
+    name: &str,
+    res: Option<Word>,
+    rty: Option<Word>,
+    args: &[Word],
+) -> Result<Vec<Instruction>, String> {
+    let res = res.ok_or_else(|| format!("{name} has no result"))?;
+    let rty = rty.ok_or_else(|| format!("{name} has no result type"))?;
+    if args.is_empty() {
+        return Err(format!("{name} expects at least 1 operand"));
+    }
+    // Unwrap OpCopyObject chains to recover the Input OpVariable.
+    let mut var = args[0];
+    while let Some(inst) = value_inst(ctx, var) {
+        if inst.class.opcode == Op::CopyObject {
+            if let Some(Operand::IdRef(src)) = inst.operands.first() {
+                var = *src;
+                continue;
+            }
+        }
+        break;
+    }
+    let var_inst = ctx
+        .new_globals
+        .iter()
+        .chain(ctx.module.types_global_values.iter())
+        .find(|i| i.result_id == Some(var) && i.class.opcode == Op::Variable)
+        .cloned()
+        .ok_or_else(|| format!("{name}: interpolant operand {var} is not an Input variable"))?;
+    if var_inst.operands.first() != Some(&Operand::StorageClass(StorageClass::Input)) {
+        return Err(format!("{name}: interpolant variable {var} is not in Input storage class"));
+    }
+    let ptr_ty = var_inst
+        .result_type
+        .ok_or_else(|| format!("{name}: interpolant variable {var} has no pointer type"))?;
+    let var_ty = match type_def_of(ctx, ptr_ty) {
+        Some(def) if def.class.opcode == Op::TypePointer => match def.operands.get(1) {
+            Some(Operand::IdRef(pt)) => *pt,
+            _ => return Err(format!("{name}: malformed Input pointer type")),
+        },
+        _ => return Err(format!("{name}: interpolant pointer type missing")),
+    };
+    let is_valid_ret = is_f32_scalar_or_vector(ctx, rty) || is_half_scalar_or_vector(ctx, rty);
+    if !is_valid_ret || vector_len(ctx, rty) != vector_len(ctx, var_ty) {
+        return Err(format!("{name}: result type does not match interpolant variable shape"));
+    }
+    if name.contains(".no_perspective") {
+        let already = ctx.module.annotations.iter().any(|a| {
+            a.class.opcode == Op::Decorate
+                && a.operands.as_slice()
+                    == [
+                        Operand::IdRef(var),
+                        Operand::Decoration(Decoration::NoPerspective),
+                    ]
+        });
+        if !already {
+            ctx.module.annotations.push(Instruction::new(
+                Op::Decorate,
+                None,
+                None,
+                vec![
+                    Operand::IdRef(var),
+                    Operand::Decoration(Decoration::NoPerspective),
+                ],
+            ));
+        }
+    }
+
+    let mut out = Vec::new();
+    let eval_id = if rty == var_ty {
+        res
+    } else {
+        ctx.module.fresh_id()
+    };
+    if name == "air.interpolate_at_center" || name.starts_with("air.interpolate_at_center.") {
+        if args.len() != 1 {
+            return Err(format!("{name} expects 1 operand"));
+        }
+        out.push(Instruction::new(
+            Op::Load,
+            Some(var_ty),
+            Some(eval_id),
+            vec![Operand::IdRef(var)],
+        ));
+    } else if name == "air.interpolate_at_centroid"
+        || name.starts_with("air.interpolate_at_centroid.")
+    {
+        if args.len() != 1 {
+            return Err(format!("{name} expects 1 operand"));
+        }
+        let glsl = ctx.glsl();
+        out.push(Instruction::new(
+            Op::ExtInst,
+            Some(var_ty),
+            Some(eval_id),
+            vec![
+                Operand::IdRef(glsl),
+                Operand::LiteralExtInstInteger(GLSLstd450::InterpolateAtCentroid as u32),
+                Operand::IdRef(var),
+            ],
+        ));
+    } else if name == "air.interpolate_at_sample" || name.starts_with("air.interpolate_at_sample.")
+    {
+        if args.len() != 2 {
+            return Err(format!("{name} expects 2 operands"));
+        }
+        let sample_ty = value_result_type(ctx, args[1])
+            .ok_or_else(|| format!("{name}: sample operand has no type"))?;
+        let width = int_scalar_width(ctx, sample_ty)
+            .ok_or_else(|| format!("{name}: sample operand must be a scalar integer"))?;
+        let sample_id = if width == 32 {
+            args[1]
+        } else {
+            let uint = ctx.ty_uint();
+            let converted = ctx.module.fresh_id();
+            out.push(Instruction::new(
+                Op::UConvert,
+                Some(uint),
+                Some(converted),
+                vec![Operand::IdRef(args[1])],
+            ));
+            converted
+        };
+        let glsl = ctx.glsl();
+        out.push(Instruction::new(
+            Op::ExtInst,
+            Some(var_ty),
+            Some(eval_id),
+            vec![
+                Operand::IdRef(glsl),
+                Operand::LiteralExtInstInteger(GLSLstd450::InterpolateAtSample as u32),
+                Operand::IdRef(var),
+                Operand::IdRef(sample_id),
+            ],
+        ));
+    } else if name == "air.interpolate_at_offset" || name.starts_with("air.interpolate_at_offset.")
+    {
+        if args.len() != 2 {
+            return Err(format!("{name} expects 2 operands"));
+        }
+        let v2f32 = ctx.ty_vecf(2);
+        let off_ty = value_result_type(ctx, args[1])
+            .ok_or_else(|| format!("{name}: offset operand has no type"))?;
+        let off_f32 = if off_ty == v2f32 {
+            args[1]
+        } else if is_half_scalar_or_vector(ctx, off_ty) && vector_len(ctx, off_ty) == 2 {
+            let converted = ctx.module.fresh_id();
+            out.push(Instruction::new(
+                Op::FConvert,
+                Some(v2f32),
+                Some(converted),
+                vec![Operand::IdRef(args[1])],
+            ));
+            converted
+        } else {
+            return Err(format!("{name}: offset operand must be float2 or half2"));
+        };
+        // Metal interpolate_at_offset uses [0, 1) from pixel top-left; SPIR-V InterpolateAtOffset
+        // uses [-0.5, +0.5) from pixel center.
+        let half_c = ctx.const_float(0.5);
+        let half2 = splat(ctx, v2f32, half_c, 2);
+        let vk_off = ctx.module.fresh_id();
+        out.push(Instruction::new(
+            Op::FSub,
+            Some(v2f32),
+            Some(vk_off),
+            vec![Operand::IdRef(off_f32), Operand::IdRef(half2)],
+        ));
+        let glsl = ctx.glsl();
+        out.push(Instruction::new(
+            Op::ExtInst,
+            Some(var_ty),
+            Some(eval_id),
+            vec![
+                Operand::IdRef(glsl),
+                Operand::LiteralExtInstInteger(GLSLstd450::InterpolateAtOffset as u32),
+                Operand::IdRef(var),
+                Operand::IdRef(vk_off),
+            ],
+        ));
+    } else {
+        return Err(format!("unhandled pull-model interpolation intrinsic: {name}"));
+    }
+
+    if eval_id != res {
+        out.push(Instruction::new(
+            Op::FConvert,
+            Some(rty),
+            Some(res),
+            vec![Operand::IdRef(eval_id)],
+        ));
+    }
+    Ok(out)
+}
