+fn pull_model_interpolant_call_type(ctx: &Ctx, entry_idx: usize, pid: Word) -> Option<Word> {
+    let names = air_names(&ctx.module);
+    let mut aliases = HashSet::from([pid]);
+    let mut changed = true;
+    while changed {
+        changed = false;
+        for block in &ctx.module.functions[entry_idx].blocks {
+            for inst in &block.instructions {
+                if inst.class.opcode == Op::CopyObject {
+                    if let (Some(res), Some(Operand::IdRef(src))) =
+                        (inst.result_id, inst.operands.first())
+                    {
+                        if aliases.contains(src) && aliases.insert(res) {
+                            changed = true;
+                        }
+                    }
+                }
+            }
+        }
+    }
+    for block in &ctx.module.functions[entry_idx].blocks {
+        for inst in &block.instructions {
+            if inst.class.opcode != Op::FunctionCall {
+                continue;
+            }
+            let Some(Operand::IdRef(callee)) = inst.operands.first() else {
+                continue;
+            };
+            if !names
+                .get(callee)
+                .is_some_and(|name| crate::air_intrinsics::is_interpolate_at_intrinsic(name))
+            {
+                continue;
+            }
+            if matches!(inst.operands.get(1), Some(Operand::IdRef(arg0)) if aliases.contains(arg0))
+            {
+                if let Some(rty) = inst.result_type {
+                    return Some(rty);
+                }
+            }
+        }
+    }
+    None
+}
+
+fn pull_model_f32_type(ctx: &mut Ctx, defs: &HashMap<Word, Instruction>, ty: Word) -> Option<Word> {
+    let (comp, lanes) = scalar_or_vector_component(defs, ty)?;
+    let def = defs.get(&comp)?;
+    if def.class.opcode != Op::TypeFloat {
+        return None;
+    }
+    let width = match def.operands.first() {
+        Some(Operand::LiteralBit32(w)) => *w,
+        _ => return None,
+    };
+    if !matches!(width, 16 | 32) {
+        return None;
+    }
+    Some(match lanes {
+        None => ctx.ty_float(),
+        Some(n @ 2..=4) => ctx.ty_vecf(n),
+        _ => return None,
+    })
+}
+
+fn pull_model_interface_type(
+    ctx: &mut Ctx,
+    defs: &HashMap<Word, Instruction>,
+    call_ret_ty: Option<Word>,
+    param_ty: Word,
+    air_type_name: Option<&str>,
+) -> Result<Word, String> {
+    if let Some(rty) = call_ret_ty {
+        return pull_model_f32_type(ctx, defs, rty)
+            .ok_or_else(|| "pull-model interpolant must evaluate to a float/half scalar or vector".into());
+    }
+    if let Some(ty) = pull_model_f32_type(ctx, defs, param_ty) {
+        return Ok(ty);
+    }
+    if let Some(raw) = air_type_name {
+        let inner = raw
+            .trim()
+            .strip_prefix("interpolant<")
+            .and_then(|s| s.split(',').next())
+            .unwrap_or(raw)
+            .trim();
+        let ty = match inner {
+            "float" | "half" => Some(ctx.ty_float()),
+            "float2" | "half2" => Some(ctx.ty_vecf(2)),
+            "float3" | "half3" => Some(ctx.ty_vecf(3)),
+            "float4" | "half4" => Some(ctx.ty_vecf(4)),
+            _ => None,
+        };
+        if let Some(ty) = ty {
+            return Ok(ty);
+        }
+    }
+    Ok(ctx.ty_float())
+}
