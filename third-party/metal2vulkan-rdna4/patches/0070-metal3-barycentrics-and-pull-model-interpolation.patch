+#[test]
+fn native_fragment_barycentric_and_pull_model_interpolation_lower_cleanly() {
+    let bary_ll = r#"
+target triple = "spirv-unknown-vulkan1.2"
+define <4 x float> @f(<3 x float> %bc_persp, <3 x float> %bc_nopersp) {
+entry:
+  %sum = fadd <3 x float> %bc_persp, %bc_nopersp
+  %x = extractelement <3 x float> %sum, i32 0
+  %y = extractelement <3 x float> %sum, i32 1
+  %z = extractelement <3 x float> %sum, i32 2
+  %v0 = insertelement <4 x float> undef, float %x, i32 0
+  %v1 = insertelement <4 x float> %v0, float %y, i32 1
+  %v2 = insertelement <4 x float> %v1, float %z, i32 2
+  %v3 = insertelement <4 x float> %v2, float 1.0, i32 3
+  ret <4 x float> %v3
+}
+
+!air.fragment = !{!0}
+!0 = !{ptr @f, !1, !2}
+!1 = !{!3}
+!2 = !{!4, !5}
+!3 = !{!"air.render_target", i32 0, i32 0, !"air.arg_type_name", !"float4"}
+!4 = !{i32 0, !"air.barycentric_coord", !"air.center", !"air.perspective", !"air.arg_type_name", !"float3"}
+!5 = !{i32 1, !"air.barycentric_coord", !"air.center", !"air.no_perspective", !"air.arg_type_name", !"float3"}
+"#;
+    let tmp = std::env::temp_dir().join(format!(
+        "metal2vulkan_native_bary_pull_{}",
+        std::process::id()
+    ));
+    let _ = std::fs::create_dir_all(&tmp);
+    let (bary_spv, _) = crate::translate_sanitized_native_reflected_unvalidated(
+        bary_ll,
+        Stage::Fragment,
+        &tmp,
+        crate::passes::TransformOptions::default(),
+        None,
+    )
+    .expect("barycentric");
+    let bary_asm = disassemble(&bary_spv).expect("disassemble bary");
+    assert!(bary_asm.contains("OpCapability FragmentBarycentricKHR"), "{bary_asm}");
+    assert!(
+        bary_asm.contains("OpExtension \"SPV_KHR_fragment_shader_barycentric\""),
+        "{bary_asm}"
+    );
+    assert!(bary_asm.contains("BuiltIn BaryCoordKHR"), "{bary_asm}");
+    assert!(bary_asm.contains("BuiltIn BaryCoordNoPerspKHR"), "{bary_asm}");
+
+    let pull_ll = r#"
+target triple = "spirv-unknown-vulkan1.2"
+define <4 x float> @f(ptr addrspace(1) %uv_p, ptr addrspace(1) %uv_np, i32 %sid) {
+entry:
+  %c = tail call <2 x float> @air.interpolate_at_center.v2f32(ptr addrspace(1) %uv_p)
+  %cen = tail call <2 x float> @air.interpolate_at_centroid.v2f32(ptr addrspace(1) %uv_p)
+  %smp = tail call <2 x float> @air.interpolate_at_sample.v2f32(ptr addrspace(1) %uv_p, i32 %sid)
+  %off = tail call <2 x half> @air.interpolate_at_offset.v2f16(ptr addrspace(1) %uv_np, <2 x float> <float 0.25, float 0.75>)
+  %off32 = fpext <2 x half> %off to <2 x float>
+  %a = fadd <2 x float> %c, %cen
+  %b = fadd <2 x float> %smp, %off32
+  %x = extractelement <2 x float> %a, i32 0
+  %y = extractelement <2 x float> %a, i32 1
+  %z = extractelement <2 x float> %b, i32 0
+  %w = extractelement <2 x float> %b, i32 1
+  %v0 = insertelement <4 x float> undef, float %x, i32 0
+  %v1 = insertelement <4 x float> %v0, float %y, i32 1
+  %v2 = insertelement <4 x float> %v1, float %z, i32 2
+  %v3 = insertelement <4 x float> %v2, float %w, i32 3
+  ret <4 x float> %v3
+}
+
+declare <2 x float> @air.interpolate_at_center.v2f32(ptr addrspace(1))
+declare <2 x float> @air.interpolate_at_centroid.v2f32(ptr addrspace(1))
+declare <2 x float> @air.interpolate_at_sample.v2f32(ptr addrspace(1), i32)
+declare <2 x half> @air.interpolate_at_offset.v2f16(ptr addrspace(1), <2 x float>)
+
+!air.fragment = !{!0}
+!0 = !{ptr @f, !1, !2}
+!1 = !{!3}
+!2 = !{!4, !5, !6}
+!3 = !{!"air.render_target", i32 0, i32 0, !"air.arg_type_name", !"float4"}
+!4 = !{i32 0, !"air.fragment_input", !"user(uv0)", !"air.pull_mode", !"air.perspective", !"air.arg_type_name", !"float2"}
+!5 = !{i32 1, !"air.interpolant", !"user(uv1)", !"air.no_perspective", !"air.arg_type_name", !"half2"}
+!6 = !{i32 2, !"air.sample_id", !"air.arg_type_name", !"uint"}
+"#;
+    let (pull_spv, _) = crate::translate_sanitized_native_reflected_unvalidated(
+        pull_ll,
+        Stage::Fragment,
+        &tmp,
+        crate::passes::TransformOptions::default(),
+        None,
+    )
+    .expect("pull-model");
+    let pull_asm = disassemble(&pull_spv).expect("disassemble pull");
+    assert!(pull_asm.contains("OpCapability InterpolationFunction"), "{pull_asm}");
+    assert!(pull_asm.contains("NoPerspective"), "{pull_asm}");
+    assert!(pull_asm.contains("InterpolateAtCentroid"), "{pull_asm}");
+    assert!(pull_asm.contains("InterpolateAtSample"), "{pull_asm}");
+    assert!(pull_asm.contains("InterpolateAtOffset"), "{pull_asm}");
+    assert!(pull_asm.contains("OpFSub"), "{pull_asm}");
+    assert!(!pull_asm.contains("OpFunctionCall"), "{pull_asm}");
+    let _ = std::fs::remove_dir_all(&tmp);
+}
