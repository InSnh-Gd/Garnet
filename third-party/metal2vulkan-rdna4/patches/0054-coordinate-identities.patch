 #[test]
+fn single_predecessor_address_identities_are_resolved_before_region_planning() {
+    let text = source("", "float")
+        .replace("arm:\n", "arm:\n %offset = add i64 %index, 8\n br label %read\nread:\n %forward = phi i64 [ %offset, %arm ]\n %base = phi ptr addrspace(2) [ %buffer, %arm ]\n")
+        .replace("%buffer, i64 8", "%base, i64 %forward")
+        .replace("[ %sample, %arm ]", "[ %sample, %read ]");
+    let blocks = rewritten(&text);
+    assert_eq!(blocks.len(), 6);
+    let TirTerminator::BrCond { t, .. } = &named(&blocks, "%entry").terminator else {
+        panic!()
+    };
+    assert_eq!(
+        named(&blocks, t)
+            .insts
+            .iter()
+            .filter(|i| i.load().is_some())
+            .count(),
+        1
+    );
+    assert!(!blocks
+        .iter()
+        .flat_map(|b| &b.typed.as_ref().unwrap().insts)
+        .any(|i| matches!(i.result.as_deref(), Some("%base" | "%forward"))));
+}
