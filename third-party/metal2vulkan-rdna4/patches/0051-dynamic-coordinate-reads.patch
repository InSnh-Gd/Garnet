+#[test]
+fn loaded_runtime_indices_move_with_the_read_but_unproven_address_roots_do_not() {
+    let text = source(
+        "%index_ptr = getelementptr i8, ptr addrspace(2) %buffer, i64 0\n \
+         %loaded_index = load i64, ptr addrspace(2) %index_ptr, align 8\n \
+         %offset = shl i64 %loaded_index, 2",
+        "float",
+    )
+    .replace("%buffer, i64 8", "%buffer, i64 %offset");
+    let blocks = rewritten(&text);
+    assert_eq!(blocks.len(), 5);
+    let TirTerminator::BrCond { t, f, .. } = &blocks[0].typed.as_ref().unwrap().terminator else {
+        panic!()
+    };
+    assert_eq!(
+        named(&blocks, t)
+            .insts
+            .iter()
+            .filter(|i| i.load().is_some())
+            .count(),
+        2
+    );
+    assert_eq!(named(&blocks, f).insts.len(), 2);
+    assert!(!named(&blocks, "%arm")
+        .insts
+        .iter()
+        .any(|i| i.load().is_some()));
+    for prefix in [
+        "%raw = ptrtoint ptr addrspace(2) %buffer to i64\n %p = inttoptr i64 %raw to ptr addrspace(2)",
+        "%p = load ptr addrspace(2), ptr addrspace(2) %buffer, align 8",
+    ] {
+        let text = source("", "float").replace(
+            "%p = getelementptr i8, ptr addrspace(2) %buffer, i64 8", prefix);
+        assert_eq!(rewritten(&text).len(), 3, "{prefix}");
+    }
 }
 
