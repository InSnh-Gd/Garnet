+#[test]
+fn dynamic_addresses_keep_local_integer_dependencies_inside_the_original_guard() {
+    let text = source(
+        "%step = mul i64 %index, 4\n %offset = add i64 %step, 8",
+        "float",
+    )
+    .replace("%buffer, i64 8", "%buffer, i64 %offset");
+    let blocks = rewritten(&text);
+    assert_eq!(blocks.len(), 5);
+    let TirTerminator::BrCond { t, .. } = &blocks[0].typed.as_ref().unwrap().terminator else {
+        panic!()
+    };
+    let guard = named(&blocks, t);
+    assert_eq!(
+        guard
+            .insts
+            .iter()
+            .map(|i| i.opcode.clone())
+            .collect::<Vec<_>>(),
+        [
+            TirOpcode::Mul,
+            TirOpcode::Add,
+            TirOpcode::GetElementPtr,
+            TirOpcode::Load
+        ]
+    );
+    let defs = guard
+        .insts
+        .iter()
+        .filter_map(|i| i.result.as_deref())
+        .collect::<HashSet<_>>();
+    for instruction in &guard.insts {
+        instruction.visit_uses(|name| {
+            assert!(
+                defs.contains(name) || name == "%index" || name == "%buffer",
+                "{name}"
+            )
+        });
+    }
+}
