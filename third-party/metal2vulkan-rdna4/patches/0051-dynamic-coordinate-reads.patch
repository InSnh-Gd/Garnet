+
+fn read_dependencies(
+    parsed: &LlModule,
+    function: &LlFunction,
+    instruction: &TirInst,
+    local: &HashSet<&str>,
+    definitions: &HashMap<&str, &TirInst>,
+) -> Option<HashSet<String>> {
+    let mut pending = vec![instruction.result.clone()?];
+    let mut copied = HashSet::new();
+    while let Some(name) = pending.pop() {
+        if !local.contains(name.as_str()) || !copied.insert(name.clone()) {
+            continue;
+        }
+        let dependency = definitions.get(name.as_str())?;
+        if !readable_prefix(dependency) {
+            return None;
+        }
+        if dependency.load().is_some() {
+            super::constant_reads::entry_read_path(parsed, function, definitions, dependency)?;
+        }
+        dependency.visit_uses(|name| pending.push(name.to_string()));
+    }
+    Some(copied)
 }
 
