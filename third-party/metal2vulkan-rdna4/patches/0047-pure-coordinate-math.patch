+%flat = OpLoad %float %flat_input
+%bound = OpExtInst %float %glsl Fma %flat %float_1 %float_2
+OpBranch %header
+%header = OpLabel
+%iteration = OpPhi %float %float_0 %entry %next %continue
+%again = OpFOrdLessThan %bool %iteration %bound
+OpLoopMerge %merge %continue None
+OpBranchConditional %again %body %merge
+%body = OpLabel
+%sampled = OpLoad %sampled_type %sampled_var
+%color = OpImageSampleImplicitLod %v4float %sampled %coord
+OpBranch %continue
+%continue = OpLabel
+%next = OpFAdd %float %iteration %float_1
+OpBranch %header
+%merge = OpLabel
