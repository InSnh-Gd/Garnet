@@ -0,0 +1,47 @@
+//! Shared value-only GLSL arithmetic semantics for uniformity and coordinate speculation.
+
+use super::*;
+use spirv::GlslStd450Op;
+
+pub(super) fn imports(module: &Module) -> HashSet<Word> {
+    module
+        .ext_inst_imports
+        .iter()
+        .filter_map(|import| {
+            (import.class.opcode == Op::ExtInstImport
+                && matches!(import.operands.as_slice(), [Operand::LiteralString(name)]
+                if name == "GLSL.std.450"))
+            .then_some(import.result_id)
+            .flatten()
+        })
+        .collect()
+}
+
+pub(super) fn arguments<'a>(
+    instruction: &'a Instruction,
+    imports: &HashSet<Word>,
+) -> Option<&'a [Operand]> {
+    if instruction.class.opcode != Op::ExtInst {
+        return None;
+    }
+    let [Operand::IdRef(set), Operand::LiteralExtInstInteger(opcode), arguments @ ..] =
+        instruction.operands.as_slice()
+    else {
+        return None;
+    };
+    if !imports.contains(set) {
+        return None;
+    }
+    let opcode = GlslStd450Op::from_u32(*opcode)?;
+    // Pointer-output operations write memory; interpolation depends on invocation state.
+    (!matches!(
+        opcode,
+        GlslStd450Op::Modf
+            | GlslStd450Op::Frexp
+            | GlslStd450Op::IMix
+            | GlslStd450Op::InterpolateAtCentroid
+            | GlslStd450Op::InterpolateAtSample
+            | GlslStd450Op::InterpolateAtOffset
+    ))
+    .then_some(arguments)
+}
