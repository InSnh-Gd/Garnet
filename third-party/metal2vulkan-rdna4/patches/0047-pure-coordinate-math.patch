+use super::*;
+
+#[test]
+fn every_fragment_entry_is_lowered_without_changing_other_stage_or_dead_functions() {
+    let preamble = PREAMBLE
+        .replace(
+            "OpExecutionMode %main OriginUpperLeft",
+            "OpEntryPoint Fragment %other \"other\" %flat_input %position %sampled_var %table\n\
+             OpEntryPoint Vertex %vertex \"vertex\" %sampled_var %table\n\
+             OpEntryPoint GLCompute %compute \"compute\" %sampled_var %table\n\
+             OpExecutionMode %main OriginUpperLeft\n\
+             OpExecutionMode %other OriginUpperLeft\n\
+             OpExecutionMode %compute LocalSize 1 1 1",
+        )
+        .replace(
+            "%void = OpTypeVoid",
+            "OpDecorate %other_sampled NonUniform\n\
+             OpName %other \"other_fragment\"\n\
+             OpName %other_entry \"other_entry\"\n\
+             OpName %sample_arm \"sample_arm\"\n\
+             OpName %vertex \"vertex\"\n\
+             OpName %compute \"compute\"\n\
+             OpName %dead \"dead\"\n\
+             %void = OpTypeVoid",
+        );
+    let source = format!(
+        "{preamble}
+%main = OpFunction %void None %fn
+%entry = OpLabel
+%sampled = OpLoad %sampled_type %sampled_var
+%color = OpImageSampleImplicitLod %v4float %sampled %coord
+OpReturn
+OpFunctionEnd
+%other = OpFunction %void None %fn
+%other_entry = OpLabel
+%pos = OpLoad %v4float %position
+%x = OpCompositeExtract %float %pos 0
+%condition = OpFOrdGreaterThan %bool %x %float_0
+OpSelectionMerge %sample_arm None
+OpBranchConditional %condition %discard %sample_arm
+%discard = OpLabel
+OpKill
+%sample_arm = OpLabel
+%other_sampled = OpLoad %sampled_type %sampled_var
+%other_color = OpImageSampleImplicitLod %v4float %other_sampled %coord
+OpReturn
+OpFunctionEnd
+%vertex = OpFunction %void None %fn
+%vertex_entry = OpLabel
+%vertex_sampled = OpLoad %sampled_type %sampled_var
+%vertex_color = OpImageSampleExplicitLod %v4float %vertex_sampled %coord Lod %float_0
+OpReturn
+OpFunctionEnd
+%compute = OpFunction %void None %fn
+%compute_entry = OpLabel
+%compute_sampled = OpLoad %sampled_type %sampled_var
+%compute_color = OpImageSampleExplicitLod %v4float %compute_sampled %coord Lod %float_0
+OpReturn
+OpFunctionEnd
+%dead = OpFunction %void None %fn
+%dead_entry = OpLabel
+%dead_sampled = OpLoad %sampled_type %sampled_var
+%dead_color = OpImageSampleImplicitLod %v4float %dead_sampled %coord
+OpReturn
+OpFunctionEnd
+"
+    );
+    let module = assemble(&source).expect("SPIR-V assembler is required");
+    validate(&module);
+    let untouched = ["vertex", "compute", "dead"].map(|name| {
+        let id = named_id(&module, name);
+        (
+            id,
+            module.functions[function_index(&module, id)]
+                .all_inst_iter()
+                .cloned()
+                .collect::<Vec<_>>(),
+        )
+    });
+    let lowered = run(module, &[]).unwrap();
+    validate(&lowered);
+    for (id, original) in untouched {
+        assert!(
+            lowered.functions[function_index(&lowered, id)]
+                .all_inst_iter()
+                .eq(original.iter()),
+            "non-fragment or unreachable function %{id} changed"
+        );
+    }
+    for (entry, label) in [("entry", "entry_block"), ("other_fragment", "other_entry")] {
+        let function = named_id(&lowered, entry);
+        assert_eq!(
+            has_derivatives(&lowered, function, named_id(&lowered, label)),
+            (true, true)
+        );
+    }
+    let other = named_id(&lowered, "other_fragment");
+    assert_eq!(
+        has_derivatives(&lowered, other, named_id(&lowered, "sample_arm")),
+        (false, false)
+    );
+}
