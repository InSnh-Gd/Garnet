+fn a_uniform_math_loop_bound_keeps_derivatives_in_each_loop_instance() {
+    let preamble = PREAMBLE.replace(
+        "OpMemoryModel",
+        "%glsl = OpExtInstImport \"GLSL.std.450\"\nOpMemoryModel",
+    );
+    let source = format!(
+        "{preamble}
+OpName %body \"sample_body\"
+%float_1 = OpConstant %float 1
