+#[test]
+fn pointer_output_math_is_not_speculated_as_coordinate_arithmetic() {
+    for (opcode, output_type) in [("Modf", "%float"), ("Frexp", "%uint")] {
+        let source = branch_source(&format!(
+            "%fraction = OpExtInst %float %glsl {opcode} %x %integral\n\
+             %local_coord = OpCompositeConstruct %v2float %fraction %fraction"
+        ))
+        .replace(
+            "OpMemoryModel",
+            "%glsl = OpExtInstImport \"GLSL.std.450\"\nOpMemoryModel",
+        )
+        .replace(
+            "%input_float = OpTypePointer",
+            &format!(
+                "%out_ptr = OpTypePointer Function {output_type}\n%input_float = OpTypePointer"
+            ),
+        )
+        .replace(
+            "%entry = OpLabel",
+            "%entry = OpLabel\n%integral = OpVariable %out_ptr Function",
+        );
+        let module = assemble(&source).expect("SPIR-V assembler is required");
+        validate(&module);
+        let error = run(module, &[]).unwrap_err();
+        assert!(
+            error.contains("cannot safely recompute") && error.contains("ExtInst"),
+            "{opcode}: {error}"
+        );
+    }
+}
