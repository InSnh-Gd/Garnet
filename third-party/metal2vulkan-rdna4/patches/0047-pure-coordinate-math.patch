 #[test]
+fn branch_local_fma_coordinate_is_recomputed_without_moving_the_sample() {
+    let source = branch_source(
+        "%local_pos = OpLoad %v4float %position
+%xy = OpVectorShuffle %v2float %local_pos %local_pos 1 0
+%local_coord = OpExtInst %v2float %glsl Fma %xy %xy %coord",
+    )
+    .replace(
+        "OpMemoryModel",
+        "%glsl = OpExtInstImport \"GLSL.std.450\"\nOpMemoryModel",
+    );
+    let module = assemble(&source).expect("SPIR-V assembler is required");
+    let main = named_id(&module, "entry");
+    let local = named_id(&module, "local_coordinate");
+    let lowered = run(module, &[]).unwrap();
+    validate(&lowered);
+    let definition = &lowered.functions[function_index(&lowered, main)];
+    assert!(definition.blocks[0]
+        .instructions
+        .iter()
+        .any(|i| i.class.opcode == Op::ExtInst));
+    assert_eq!(
+        has_derivatives(&lowered, main, named_id(&lowered, "entry_block")),
+        (true, true)
+    );
+    let arm = block_index(&lowered, main, named_id(&lowered, "sample_arm"));
+    assert!(definition.blocks[arm].instructions.iter().any(|i| {
+        i.class.opcode == Op::ImageSampleExplicitLod
+            && i.operands.get(1) == Some(&Operand::IdRef(local))
+    }));
+}
