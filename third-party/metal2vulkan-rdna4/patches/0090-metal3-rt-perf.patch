+fn slot_cache_entry(instanced: bool, root: &str, name: &str) -> String {
+    if instanced {
+        "  %last_inst = alloca i32, align 4\n  %last_slot = alloca i64, align 8\n  store i32 0, ptr %last_inst, align 4\n  store i64 1, ptr %last_slot, align 8\n".to_string()
+    } else {
+        format!("  %{name} = call i64 @__m2v.rq.query.lookup_blas_slot(i64 {root}, i32 0, i32 0)\n")
+    }
+}
+
+fn slot_cache_lookup(instanced: bool, root: &str, instance: &str, name: &str) -> String {
+    if !instanced { return String::new(); }
+    format!("  %previous_inst = load i32, ptr %last_inst, align 4\n  %previous_slot = load i64, ptr %last_slot, align 8\n  %valid_slot = icmp ne i64 %previous_slot, 1\n  %same_inst = icmp eq i32 %previous_inst, {instance}\n  %reuse = and i1 %valid_slot, %same_inst\n  br i1 %reuse, label %slot_ready, label %resolve_slot\n\nresolve_slot:\n  %resolved = call i64 @__m2v.rq.query.lookup_blas_slot(i64 {root}, i32 1, i32 {instance})\n  store i64 %resolved, ptr %last_slot, align 8\n  store i32 {instance}, ptr %last_inst, align 4\n  br label %slot_ready\n\nslot_ready:\n  %{name} = load i64, ptr %last_slot, align 8\n")
+}
