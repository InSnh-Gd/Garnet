+    fn emit_icb_u32_value(
+        &mut self,
+        tv: &TypedValue,
+        instructions: &mut Vec<Instruction>,
+    ) -> Result<Word, String> {
+        let raw = self.value_id_in(&tv.value, &tv.ty, instructions)?;
+        match self.resolve_type(&tv.ty)? {
+            LlType::Int(32) => Ok(raw),
+            LlType::Int(_) => {
+                let u32_ty = self.type_id(&LlType::Int(32))?;
+                let conv = self.fresh();
+                instructions.push(Self::inst(
+                    Op::UConvert,
+                    Some(u32_ty),
+                    Some(conv),
+                    vec![Operand::IdRef(raw)],
+                ));
+                Ok(conv)
+            }
+            other => Err(format!(
+                "native emitter: compute ICB integer operand has non-integer type {other:?}"
+            )),
+        }
+    }
+
+    fn emit_icb_u32x3_pair(
+        &mut self,
+        args: &[TypedValue],
+        callee: &str,
+        instructions: &mut Vec<Instruction>,
+    ) -> Result<([Word; 3], [Word; 3]), String> {
+        let extract_vec3 = |this: &mut Self,
+                            tv: &TypedValue,
+                            instructions: &mut Vec<Instruction>|
+         -> Result<[Word; 3], String> {
+            let resolved = this.resolve_type(&tv.ty)?;
+            let LlType::Vector(elem, 3) = resolved else {
+                return Err(format!(
+                    "native emitter: {callee} expected 3-lane integer vector, got {resolved:?}"
+                ));
+            };
+            let elem = this.resolve_type(&elem)?;
+            let LlType::Int(bits) = elem else {
+                return Err(format!(
+                    "native emitter: {callee} expected integer vector element, got {elem:?}"
+                ));
+            };
+            let vec_val = this.value_id_in(&tv.value, &tv.ty, instructions)?;
+            let elem_ty = this.type_id(&elem)?;
+            let u32_ty = this.type_id(&LlType::Int(32))?;
+            let mut lanes = [0u32; 3];
+            for i in 0..3u32 {
+                let lane = this.fresh();
+                instructions.push(Self::inst(
+                    Op::CompositeExtract,
+                    Some(elem_ty),
+                    Some(lane),
+                    vec![Operand::IdRef(vec_val), Operand::LiteralBit32(i)],
+                ));
+                lanes[i as usize] = if bits == 32 {
+                    lane
+                } else {
+                    let conv = this.fresh();
+                    instructions.push(Self::inst(
+                        Op::UConvert,
+                        Some(u32_ty),
+                        Some(conv),
+                        vec![Operand::IdRef(lane)],
+                    ));
+                    conv
+                };
+            }
+            Ok(lanes)
+        };
+        match args.len() {
+            4 => Ok((
+                extract_vec3(self, &args[2], instructions)?,
+                extract_vec3(self, &args[3], instructions)?,
+            )),
+            8 => Ok((
+                [
+                    self.emit_icb_u32_value(&args[2], instructions)?,
+                    self.emit_icb_u32_value(&args[3], instructions)?,
+                    self.emit_icb_u32_value(&args[4], instructions)?,
+                ],
+                [
+                    self.emit_icb_u32_value(&args[5], instructions)?,
+                    self.emit_icb_u32_value(&args[6], instructions)?,
+                    self.emit_icb_u32_value(&args[7], instructions)?,
+                ],
+            )),
+            n => Err(format!(
+                "native emitter: {callee} expects 4 (vec3) or 8 (scalar) operands, got {n}"
+            )),
+        }
+    }
