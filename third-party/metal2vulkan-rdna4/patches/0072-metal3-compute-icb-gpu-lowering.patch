+#[test]
+fn native_metal3_compute_icb_encoding_lowers_cleanly() {
+    let ll = r#"
+target triple = "spirv-unknown-vulkan1.2"
+%struct.ArgBuf = type { ptr addrspace(1), ptr addrspace(1), ptr addrspace(1) }
+define void @encode_compute_icb(ptr addrspace(1) %args, i32 %tid) {
+entry:
+  %icb_ptr = getelementptr inbounds %struct.ArgBuf, ptr addrspace(1) %args, i64 0, i32 0
+  %icb = load ptr addrspace(1), ptr addrspace(1) %icb_ptr, align 8
+  %pso_ptr = getelementptr inbounds %struct.ArgBuf, ptr addrspace(1) %args, i64 0, i32 1
+  %pso = load ptr addrspace(1), ptr addrspace(1) %pso_ptr, align 8
+  %buf_ptr = getelementptr inbounds %struct.ArgBuf, ptr addrspace(1) %args, i64 0, i32 2
+  %buf = load ptr addrspace(1), ptr addrspace(1) %buf_ptr, align 8
+  call void @air.reset_compute_command(ptr addrspace(1) %icb, i32 %tid)
+  call void @air.set_pipeline_state_compute_command(ptr addrspace(1) %icb, i32 %tid, ptr addrspace(1) %pso)
+  call void @air.set_kernel_buffer_compute_command.p1i8(ptr addrspace(1) %icb, i32 %tid, ptr addrspace(1) %buf, i32 0)
+  call void @air.set_threadgroup_memory_length_compute_command(ptr addrspace(1) %icb, i32 %tid, i32 256, i32 1)
+  call void @air.set_barrier_compute_command(ptr addrspace(1) %icb, i32 %tid)
+  call void @air.concurrent_dispatch_threadgroups_compute_command(ptr addrspace(1) %icb, i32 %tid, <3 x i32> <i32 4, i32 1, i32 1>, <3 x i32> <i32 64, i32 1, i32 1>)
+  %next = add i32 %tid, 1
+  call void @air.copy_compute_command(ptr addrspace(1) %icb, i32 %next, ptr addrspace(1) %icb, i32 %tid)
+  call void @air.clear_barrier_compute_command(ptr addrspace(1) %icb, i32 %next)
+  call void @air.concurrent_dispatch_threads_compute_command(ptr addrspace(1) %icb, i32 %next, i32 256, i32 1, i32 1, i32 64, i32 1, i32 1)
+  ret void
+}
+declare void @air.reset_compute_command(ptr addrspace(1), i32)
+declare void @air.copy_compute_command(ptr addrspace(1), i32, ptr addrspace(1), i32)
+declare void @air.set_pipeline_state_compute_command(ptr addrspace(1), i32, ptr addrspace(1))
+declare void @air.set_kernel_buffer_compute_command.p1i8(ptr addrspace(1), i32, ptr addrspace(1), i32)
+declare void @air.set_threadgroup_memory_length_compute_command(ptr addrspace(1), i32, i32, i32)
+declare void @air.set_barrier_compute_command(ptr addrspace(1), i32)
+declare void @air.clear_barrier_compute_command(ptr addrspace(1), i32)
+declare void @air.concurrent_dispatch_threadgroups_compute_command(ptr addrspace(1), i32, <3 x i32>, <3 x i32>)
+declare void @air.concurrent_dispatch_threads_compute_command(ptr addrspace(1), i32, i32, i32, i32, i32, i32, i32)
+!air.kernel = !{!0}
+!0 = !{ptr @encode_compute_icb, !1, !2}
+!1 = !{}
+!2 = !{!3, !4}
+!3 = !{i32 0, !"air.buffer", !"air.location_index", i32 0, i32 1, !"air.read", !"air.address_space", i32 1, !"air.arg_type_size", i32 24, !"air.arg_type_align_size", i32 8, !"air.arg_type_name", !"ArgBuf", !"air.arg_name", !"args"}
+!4 = !{i32 1, !"air.thread_position_in_grid", !"air.arg_type_name", !"uint", !"air.arg_name", !"tid"}
+"#;
+    let (spv, _) = crate::translate_sanitized_native_reflected_unvalidated(
+        ll,
+        Stage::Kernel,
+        std::path::Path::new(""),
+        crate::passes::TransformOptions::default(),
+        None,
+    )
+    .expect("compute ICB GPU encoder should translate cleanly");
+    let asm = disassemble(&spv).expect("disassemble compute icb");
+    assert!(asm.contains("PhysicalStorageBuffer64"), "{asm}");
+    assert!(asm.contains("OpConvertUToPtr"), "{asm}");
+    assert!(!asm.contains("_compute_command"), "{asm}");
+}
