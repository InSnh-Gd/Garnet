diff --git a/src/passes/resources/null_sampling.rs b/src/passes/resources/null_sampling.rs
new file mode 100644
--- /dev/null
+++ b/src/passes/resources/null_sampling.rs
@@ -0,0 +1,228 @@
+//! Shape-correct null images preserve sampling control flow and implicit derivatives.
+
+use super::*;
+use spirv::Decoration;
+
+pub(in crate::passes) fn protect_argument_sampling(ctx: &mut Ctx) -> Result<(), String> {
+    let defs = ctx
+        .module
+        .all_inst_iter()
+        .chain(ctx.new_globals.iter())
+        .filter_map(|inst| inst.result_id.map(|id| (id, inst.clone())))
+        .collect::<HashMap<_, _>>();
+    let mut sets = HashMap::new();
+    let mut bindings = HashMap::new();
+    for inst in &ctx.module.annotations {
+        match inst.operands.as_slice() {
+            [Operand::IdRef(id), Operand::Decoration(Decoration::DescriptorSet), Operand::LiteralBit32(set)] =>
+            {
+                sets.insert(*id, *set);
+            }
+            [Operand::IdRef(id), Operand::Decoration(Decoration::Binding), Operand::LiteralBit32(binding)] =>
+            {
+                bindings.insert(*id, *binding);
+            }
+            _ => {}
+        }
+    }
+    let Some(table) = bindings
+        .iter()
+        .find_map(|(&id, &binding)| (binding == 672 && sets.get(&id) == Some(&0)).then_some(id))
+    else {
+        return Ok(());
+    };
+    let mut arrays = HashMap::new();
+    for (&id, &set) in &sets {
+        if set != 2 || bindings.get(&id) != Some(&0) {
+            continue;
+        }
+        let image = defs
+            .get(&id)
+            .and_then(|var| var.result_type)
+            .and_then(|ty| defs.get(&ty))
+            .and_then(|ptr| ptr.operands.get(1))
+            .and_then(|op| match op {
+                Operand::IdRef(id) => defs.get(id),
+                _ => None,
+            })
+            .filter(|array| array.class.opcode == Op::TypeRuntimeArray)
+            .and_then(|array| array.operands.first())
+            .and_then(|op| match op {
+                Operand::IdRef(id) => defs.get(id),
+                _ => None,
+            });
+        let Some(image) = image else { continue };
+        let [Operand::IdRef(sampled), Operand::Dim(dim), Operand::LiteralBit32(depth), Operand::LiteralBit32(arrayed), Operand::LiteralBit32(0), Operand::LiteralBit32(1), ..] =
+            image.operands.as_slice()
+        else {
+            continue;
+        };
+        if *dim as u32 > 3 || *depth > 1 || *arrayed > 1 {
+            continue;
+        }
+        if !defs.get(sampled).is_some_and(|ty| {
+            ty.class.opcode == Op::TypeFloat && ty.operands == [Operand::LiteralBit32(32)]
+        }) {
+            continue;
+        }
+        arrays.insert(id, (*dim as u32 * 2 + arrayed) + 8 * depth);
+    }
+    if arrays.is_empty() {
+        return Ok(());
+    }
+    let mut pointers = HashMap::new();
+    let mut images = HashMap::new();
+    loop {
+        let before = (pointers.len(), images.len());
+        for (&id, inst) in &defs {
+            match (inst.class.opcode, inst.operands.as_slice()) {
+                (
+                    Op::AccessChain | Op::InBoundsAccessChain,
+                    [Operand::IdRef(array), Operand::IdRef(index)],
+                ) if arrays.contains_key(array) => {
+                    pointers.insert(id, *index);
+                }
+                (Op::Load, [Operand::IdRef(pointer)]) => {
+                    if let Some(&index) = pointers.get(pointer) {
+                        images.insert(id, index);
+                    }
+                }
+                (
+                    Op::CopyObject | Op::Bitcast | Op::Image | Op::SampledImage,
+                    [Operand::IdRef(source), ..],
+                ) => {
+                    if let Some(&index) = images.get(source) {
+                        images.insert(id, index);
+                    }
+                }
+                _ => {}
+            }
+        }
+        if before == (pointers.len(), images.len()) {
+            break;
+        }
+    }
+    let uint = ctx.ty_uint();
+    let boolean = ctx.ty_bool();
+    let zero = ctx.const_uint(0);
+    let one = ctx.const_uint(1);
+    let word_pointer = ctx.ty_ptr(StorageClass::StorageBuffer, uint);
+    for function in 0..ctx.module.functions.len() {
+        for block in 0..ctx.module.functions[function].blocks.len() {
+            let old = ctx.module.functions[function].blocks[block]
+                .instructions
+                .clone();
+            let mut body = Vec::with_capacity(old.len());
+            for mut inst in old {
+                if matches!(inst.class.opcode, Op::AccessChain | Op::InBoundsAccessChain) {
+                    if let [Operand::IdRef(array), Operand::IdRef(index)] = inst.operands.as_slice()
+                    {
+                        if let Some(&shape) = arrays.get(array) {
+                            let index = *index;
+                            let count = super::gpu_arguments::load_word(
+                                ctx,
+                                &mut body,
+                                table,
+                                word_pointer,
+                                uint,
+                                zero,
+                                one,
+                            );
+                            let shape = ctx.const_uint(shape);
+                            let tail = super::gpu_arguments::value(
+                                ctx,
+                                &mut body,
+                                Op::IAdd,
+                                uint,
+                                vec![Operand::IdRef(count), Operand::IdRef(shape)],
+                            );
+                            let null = super::gpu_arguments::value(
+                                ctx,
+                                &mut body,
+                                Op::IEqual,
+                                boolean,
+                                vec![Operand::IdRef(index), Operand::IdRef(zero)],
+                            );
+                            let selected = super::gpu_arguments::value(
+                                ctx,
+                                &mut body,
+                                Op::Select,
+                                uint,
+                                vec![
+                                    Operand::IdRef(null),
+                                    Operand::IdRef(tail),
+                                    Operand::IdRef(index),
+                                ],
+                            );
+                            inst.operands[1] = Operand::IdRef(selected);
+                        }
+                    }
+                }
+                let sampling = matches!(
+                    inst.class.opcode,
+                    Op::ImageSampleImplicitLod
+                        | Op::ImageSampleExplicitLod
+                        | Op::ImageSampleDrefImplicitLod
+                        | Op::ImageSampleDrefExplicitLod
+                        | Op::ImageSampleProjImplicitLod
+                        | Op::ImageSampleProjExplicitLod
+                        | Op::ImageSampleProjDrefImplicitLod
+                        | Op::ImageSampleProjDrefExplicitLod
+                        | Op::ImageGather
+                        | Op::ImageDrefGather
+                        | Op::ImageQueryLod
+                );
+                let source = inst.operands.first().and_then(|op| match op {
+                    Operand::IdRef(id) => images.get(id).copied(),
+                    _ => None,
+                });
+                if sampling {
+                    if let (Some(index), Some(result), Some(ty)) =
+                        (source, inst.result_id, inst.result_type)
+                    {
+                        let mut null = super::gpu_arguments::value(
+                            ctx,
+                            &mut body,
+                            Op::IEqual,
+                            boolean,
+                            vec![Operand::IdRef(index), Operand::IdRef(zero)],
+                        );
+                        if let Some(def) = defs
+                            .get(&ty)
+                            .filter(|def| def.class.opcode == Op::TypeVector)
+                        {
+                            if let [_, Operand::LiteralBit32(count)] = def.operands.as_slice() {
+                                let bools = ctx.ty_vec_bool(*count);
+                                null = super::gpu_arguments::value(
+                                    ctx,
+                                    &mut body,
+                                    Op::CompositeConstruct,
+                                    bools,
+                                    vec![Operand::IdRef(null); *count as usize],
+                                );
+                            }
+                        }
+                        let actual = ctx.module.fresh_id();
+                        inst.result_id = Some(actual);
+                        body.push(inst);
+                        let zero_result = ctx.const_null(ty);
+                        body.push(Instruction::new(
+                            Op::Select,
+                            Some(ty),
+                            Some(result),
+                            vec![
+                                Operand::IdRef(null),
+                                Operand::IdRef(zero_result),
+                                Operand::IdRef(actual),
+                            ],
+                        ));
+                        continue;
+                    }
+                }
+                body.push(inst);
+            }
+            ctx.module.functions[function].blocks[block].instructions = body;
+        }
+    }
+    Ok(())
+}
