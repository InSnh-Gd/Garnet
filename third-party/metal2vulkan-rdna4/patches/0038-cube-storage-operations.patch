diff --git a/tests/cube_array_storage_write.rs b/tests/cube_array_storage_write.rs
new file mode 100644
index 0000000..3e0c648
--- /dev/null
+++ b/tests/cube_array_storage_write.rs
@@ -0,0 +1,57 @@
+// SPDX-License-Identifier: LGPL-3.0-or-later
+//! Storage writes to Metal `texturecube` and `texturecube_array` images.
+
+use metal2vulkan::{disassemble, passes::Stage, tools};
+
+#[test]
+fn cube_array_storage_write_packs_slice_and_face_and_enforces_zero_lod() {
+    let ir = r#"
+target triple = "spirv-unknown-vulkan1.2"
+define void @write_cube_arr(ptr addrspace(1) %out_cube, <3 x i32> %gid) {
+entry:
+  %gx = extractelement <3 x i32> %gid, i64 0
+  %gy = extractelement <3 x i32> %gid, i64 1
+  %gz = extractelement <3 x i32> %gid, i64 2
+  %xy0 = insertelement <2 x i32> poison, i32 %gx, i64 0
+  %xy = insertelement <2 x i32> %xy0, i32 %gy, i64 1
+  %face = urem i32 %gz, 6
+  %slice = udiv i32 %gz, 6
+  %texel = insertelement <4 x float> <float 1.0, float 0.5, float 0.0, float 1.0>, float 0.25, i64 2
+  tail call void @air.write_texture_cube_array.v4f32(ptr addrspace(1) %out_cube, <2 x i32> %xy, i32 %face, i32 %slice, <4 x float> %texel, i32 0, i32 2)
+  ret void
+}
+
+declare void @air.write_texture_cube_array.v4f32(ptr addrspace(1), <2 x i32>, i32, i32, <4 x float>, i32, i32)
+
+!air.kernel = !{!0}
+!0 = !{ptr @write_cube_arr, !1, !2}
+!1 = !{}
+!2 = !{!3, !4}
+!3 = !{i32 0, !"air.texture", !"air.location_index", i32 0, i32 1, !"air.write", !"air.arg_type_name", !"texturecube_array<float, write>", !"air.arg_name", !"out_cube"}
+!4 = !{i32 1, !"air.thread_position_in_grid", !"air.arg_type_name", !"uint3", !"air.arg_name", !"gid"}
+"#;
+    let dir = std::env::temp_dir().join(format!("m2v_cube_arr_write_{}", std::process::id()));
+    let _ = std::fs::create_dir_all(&dir);
+    let spv = metal2vulkan::translate_sanitized_native(ir, Stage::Kernel, &dir)
+        .expect("cube-array write at LOD 0 must translate");
+    let asm = disassemble(&spv).expect("disassemble");
+    assert!(asm.contains("OpCapability ImageCubeArray"), "{asm}");
+    assert!(asm.contains("Cube 0 1 0 2 R32f"), "{asm}");
+    assert!(asm.contains("OpIMul"), "{asm}");
+    assert!(asm.contains("OpIAdd"), "{asm}");
+    assert!(asm.contains("OpCompositeConstruct"), "{asm}");
+    assert!(asm.contains("OpImageWrite"), "{asm}");
+    assert!(asm.contains("Binding 480"), "{asm}");
+    if std::process::Command::new("spirv-val")
+        .arg("--version")
+        .output()
+        .is_ok()
+    {
+        tools::spirv_val_bytes(&spv, &dir).expect("spirv-val");
+    }
+    let bad_lod = ir.replace("%texel, i32 0, i32 2)", "%texel, i32 2, i32 2)");
+    let err = metal2vulkan::translate_sanitized_native(&bad_lod, Stage::Kernel, &dir)
+        .expect_err("nonzero LOD storage cube-array write must be rejected");
+    assert!(err.contains("requires zero LOD"), "{err}");
+    std::fs::remove_dir_all(dir).unwrap();
+}
