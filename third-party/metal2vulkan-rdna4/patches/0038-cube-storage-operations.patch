+/// Pack separate Metal cube-array `(face, slice)` indices into SPIR-V's linear layer index
+/// `slice * 6 + face` for `DimCube` arrayed storage image reads and writes.
+pub(in crate::passes) fn combine_cube_array_layer(
+    ctx: &mut Ctx,
+    face: Word,
+    slice: Word,
+    out: &mut Vec<Instruction>,
+    what: &str,
+) -> Result<Word, String> {
+    let face_u32 = coerce_image_coord32(ctx, face, out, what)?;
+    let slice_u32 = coerce_image_coord32(ctx, slice, out, what)?;
+    let u32_ty = ctx.ty_uint();
+    let faces_per_cube = ctx.const_uint(6);
+    let cube_base = ctx.module.fresh_id();
+    out.push(Instruction::new(
+        Op::IMul,
+        Some(u32_ty),
+        Some(cube_base),
+        vec![Operand::IdRef(slice_u32), Operand::IdRef(faces_per_cube)],
+    ));
+    let layer_id = ctx.module.fresh_id();
+    out.push(Instruction::new(
+        Op::IAdd,
+        Some(u32_ty),
+        Some(layer_id),
+        vec![Operand::IdRef(cube_base), Operand::IdRef(face_u32)],
+    ));
+    Ok(layer_id)
+}
