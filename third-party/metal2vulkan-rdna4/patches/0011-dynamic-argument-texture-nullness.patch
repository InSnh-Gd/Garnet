+                    Op::BitwiseOr,
+                    uint,
+                    vec![Operand::IdRef(low), Operand::IdRef(high)],
+                );
+                body.push(Instruction::new(
+                    Op::IEqual,
+                    inst.result_type,
+                    inst.result_id,
+                    vec![Operand::IdRef(words), Operand::IdRef(zero)],
+                ));
+            } else {
+                body.push(inst);
+            }
+        }
