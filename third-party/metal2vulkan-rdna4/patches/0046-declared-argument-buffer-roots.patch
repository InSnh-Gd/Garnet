diff --git a/src/reflect/tests.rs b/src/reflect/tests.rs
--- a/src/reflect/tests.rs
+++ b/src/reflect/tests.rs
@@ -7,6 +7,47 @@
 use super::*;
 
 #[test]
+fn declared_argument_roots_are_explicit_sorted_and_stage_independent() {
+    let mut fragment = FragMeta::default();
+    fragment.roles.push((0, FragRole::Buffer(3)));
+    fragment.roles.push((1, FragRole::Buffer(0)));
+    fragment.argument_buffer_params = vec![0];
+    let mut vertex = VertMeta::default();
+    vertex.roles.push((0, VertRole::Buffer(3)));
+    vertex.roles.push((1, VertRole::Buffer(0)));
+    vertex.argument_buffer_params = vec![0];
+    let mut kernel = KernMeta::default();
+    kernel.roles.push((0, KernRole::Buffer(3)));
+    kernel.roles.push((1, KernRole::Buffer(0)));
+    kernel.argument_buffer_params = vec![0];
+    for mut reflection in [
+        ShaderReflection::from_fragment(&fragment, Some("f")),
+        ShaderReflection::from_vertex(&vertex, Some("v")),
+        ShaderReflection::from_kernel(&kernel, Some("k"), [1, 1, 1]),
+    ] {
+        assert_eq!(reflection.argument_buffer_roots, vec![3]);
+        assert!(reflection.argument_buffer_fields.is_empty());
+        assert!(reflection.validate_descriptor_abi().is_ok());
+        for invalid in [vec![3, 3], vec![32], vec![7], vec![3, 0]] {
+            reflection.argument_buffer_roots = invalid;
+            assert!(reflection.validate_descriptor_abi().is_err());
+        }
+        reflection.argument_buffer_roots = vec![3];
+        reflection.reflection_version = 65;
+        assert!(reflection.validate_descriptor_abi().is_err());
+    }
+    kernel.argument_buffer_params = vec![0, 1];
+    assert_eq!(
+        ShaderReflection::from_kernel(&kernel, None, [1, 1, 1]).argument_buffer_roots,
+        vec![0, 3]
+    );
+    kernel.argument_buffer_params.clear();
+    assert!(ShaderReflection::from_kernel(&kernel, None, [1, 1, 1])
+        .argument_buffer_roots
+        .is_empty());
+}
