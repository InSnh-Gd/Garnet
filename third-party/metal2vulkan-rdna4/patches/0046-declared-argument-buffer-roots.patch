+fn declared_argument_buffer_roots(params: &[u32], bindings: &[ResourceBinding]) -> Vec<u32> {
+    let mut roots = bindings
+        .iter()
+        .filter(|binding| {
+            binding.kind == ResourceKind::Buffer
+                && binding
+                    .param_index
+                    .is_some_and(|param| params.contains(&param))
+        })
+        .map(|binding| binding.metal_index)
+        .collect::<Vec<_>>();
+    roots.sort_unstable();
+    roots.dedup();
+    roots
+}
