+//! Cube-array AIR reads put LOD after both face and slice, including storage reads.
+
+use metal2vulkan::{disassemble, passes::Stage};
+
+const SOURCE: &str = r#"target triple = "spirv-unknown-vulkan1.2"
+define void @k(ptr addrspace(1) %image, ptr addrspace(1) %out, i32 %index) {
+entry:
+  %slice = and i32 %index, 1
+  %read = call { <4 x float>, i8 } @air.read_texture_cube_array.v4f32(ptr addrspace(1) %image, <2 x i32> <i32 2, i32 1>, i32 3, i32 %slice, i32 0, i32 1)
+  %texel = extractvalue { <4 x float>, i8 } %read, 0
+  store <4 x float> %texel, ptr addrspace(1) %out, align 16
+  call void @air.write_texture_cube_array.v4f32(ptr addrspace(1) %image, <2 x i32> <i32 2, i32 1>, i32 3, i32 %slice, <4 x float> %texel, i32 0, i32 2)
+  ret void
+}
+declare { <4 x float>, i8 } @air.read_texture_cube_array.v4f32(ptr addrspace(1), <2 x i32>, i32, i32, i32, i32)
+declare void @air.write_texture_cube_array.v4f32(ptr addrspace(1), <2 x i32>, i32, i32, <4 x float>, i32, i32)
+!air.kernel = !{!0}
+!0 = !{ptr @k, !1, !2}
+!1 = !{}
+!2 = !{!3, !4, !5}
+!3 = !{i32 0, !"air.texture", !"air.location_index", i32 0, i32 1, !"air.read_write", !"air.arg_type_name", !"texturecube_array<float, read_write>"}
+!4 = !{i32 1, !"air.buffer", !"air.location_index", i32 0, i32 1, !"air.write", !"air.address_space", i32 1, !"air.arg_type_name", !"float4*"}
+!5 = !{i32 2, !"air.thread_position_in_grid", !"air.arg_type_name", !"uint"}
+"#;
+
+#[test]
+fn cube_array_storage_read_keeps_runtime_slice_and_rejects_nonzero_lod() {
+    let directory = std::env::temp_dir().join(format!("cube-storage-read-{}", std::process::id()));
+    std::fs::create_dir_all(&directory).unwrap();
+    let bytes = metal2vulkan::translate_sanitized_native(SOURCE, Stage::Kernel, &directory)
+        .expect("storage cube-array read at mip zero must preserve a runtime slice");
+    let text = disassemble(&bytes).unwrap();
+    assert!(text.contains("OpImageRead"), "{text}");
+    assert!(text.contains("Cube 0 1 0 2 R32f"), "{text}");
+    assert!(text.contains("OpIMul"), "cube-array slice needs six faces");
+    metal2vulkan::tools::spirv_val_bytes(&bytes, &directory).unwrap();
+    let nonzero = SOURCE.replace("i32 %slice, i32 0, i32 1)", "i32 %slice, i32 1, i32 1)");
+    let error = metal2vulkan::translate_sanitized_native(&nonzero, Stage::Kernel, &directory)
+        .expect_err("macOS storage reads require constant mip zero");
+    assert!(
+        error.contains("storage image read requires zero LOD"),
+        "{error}"
+    );
+    std::fs::remove_dir_all(directory).unwrap();
+}
