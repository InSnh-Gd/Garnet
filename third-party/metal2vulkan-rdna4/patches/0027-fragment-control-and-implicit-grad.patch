+//! Fragment-entry reachability and derivative-group control-flow facts.
+//!
+//! The Vulkan 1.2 baseline used by this translator does not enable `QuadDerivativesKHR`, so a
+//! fragment derivative's group is the primitive scope instance. An explicit derivative must execute
+//! in control flow uniform within that group. This analysis is deliberately separate from
+//! `BlockDominance`: dominance answers whether a value is available, not whether every invocation
+//! in a derivative group executes the same dynamic instruction.
+//!
+//! A predecessor meet is not sufficient here. SPIR-V explicitly allows divergent control flow to
+//! reconverge at a structured merge, so a block whose incoming edges have mixed path histories can
+//! still execute uniformly after the merge. The analysis below instead computes control dependence
+//! on each conditional/switch through the post-dominator tree of the executable CFG.
+
+use super::*;
+use spirv::ExecutionModel;
+use std::collections::{BTreeSet, VecDeque};
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(in crate::passes) enum ControlStatus {
+    NotReachable,
+    Uniform,
+    NonUniform,
+    PartialDemote,
+}
+
+#[derive(Default)]
+pub(in crate::passes) struct FragmentControl {
+    functions: HashMap<usize, FunctionControl>,
+    entry_context: HashMap<usize, bool>,
+}
+
+struct FunctionControl {
+    /// Indexed by the function's original `Block` position.
+    status: Vec<ControlStatus>,
+    calls: Vec<CallSite>,
+}
+
+#[derive(Clone, Copy)]
+struct CallSite {
+    block: usize,
+    callee: usize,
+}
+
+impl FragmentControl {
+    pub(in crate::passes) fn status(&self, function: usize, block: usize) -> ControlStatus {
+        self.functions
+            .get(&function)
+            .and_then(|control| control.status.get(block))
+            .copied()
+            .map(|status| {
+                if status == ControlStatus::Uniform
+                    && !self.entry_context.get(&function).copied().unwrap_or(false)
+                {
+                    ControlStatus::NonUniform
+                } else {
+                    status
+                }
+            })
+            .unwrap_or(ControlStatus::NotReachable)
+    }
+}
+
+/// Specialize residual bodied helper calls at each fragment entry's calls path before AIR lowering.
+///
+/// A single helper body has one CFG but can be reached from both uniform and nonuniform call sites.
+/// Leaving it shared cannot represent that distinction: the helper's blocks would have to be both
+/// uniform and nonuniform. Splice a clone at every resolvable callsite first, so a later
+/// `air.is_uniform` assertion is recorded against the exact caller value and derivative analysis
+/// sees the guard that actually reaches each clone. AIR declarations remain bodyless and are left
+/// for `lower_air_calls`.
+pub(in crate::passes) fn prepare_fragment_control(
+    ctx: &mut Ctx,
+    entry_idx: usize,
+) -> Result<(), String> {
+    if ctx.stage != Stage::Fragment {
+        return Ok(());
+    }
+    let entry_ids = ctx
+        .module
+        .entry_points
+        .iter()
+        .filter(|entry| {
+            entry.operands.first() == Some(&Operand::ExecutionModel(ExecutionModel::Fragment))
+        })
+        .filter_map(|entry| match entry.operands.get(1) {
+            Some(Operand::IdRef(id)) => Some(*id),
+            _ => None,
+        })
+        .collect::<BTreeSet<_>>();
+    let declared_entry_functions = entry_ids
+        .iter()
+        .map(|entry_id| {
+            ctx.module
+                .functions
+                .iter()
+                .position(|function| {
+                    function
+                        .def
+                        .as_ref()
+                        .and_then(|definition| definition.result_id)
+                        == Some(*entry_id)
+                })
+                .ok_or_else(|| {
+                    format!(
+                        "fragment OpEntryPoint names function %{entry_id}, but no owned function \
+                         definition has that result id"
+                    )
+                })
+        })
+        .collect::<Result<Vec<_>, _>>()?;
+    let entry_id = ctx.module.functions[entry_idx]
+        .def
+        .as_ref()
+        .and_then(|definition| definition.result_id)
+        .ok_or_else(|| format!("selected fragment entry function #{entry_idx} has no result id"))?;
+    let mut entry_functions = vec![entry_idx];
+    entry_functions.extend(
+        declared_entry_functions
+            .into_iter()
+            .filter(|&declared| declared != entry_idx),
+    );
+    entry_functions.sort_unstable();
+    entry_functions.dedup();
+    let selected = ctx
+        .module
+        .functions
+        .iter()
+        .filter(|function| !function.blocks.is_empty())
+        .filter_map(|function| function.def.as_ref()?.result_id)
+        .filter(|function| *function != entry_id && !entry_ids.contains(function))
+        .collect::<HashSet<_>>();
+    if selected.is_empty() {
+        return Ok(());
+    }
+
+    let mut splices = 0usize;
+    for entry in entry_functions {
+        let stats = crate::passes::emitted_inline::inline_selected_helpers(ctx, entry, &selected)?;
+        splices = splices.saturating_add(stats.splices);
+    }
+    if splices != 0 {
+        ctx.module.types_global_values.append(&mut ctx.new_globals);
+    }
+    Ok(())
+}
+
+/// Analyze every declared fragment entry independently, following only executable terminator edges.
+///
+/// This compatibility entry is for modules whose `OpEntryPoint` instructions already exist, such as
+/// the cached SPIR-V post-pass. Pre-finalize lowering passes must use [`analyze_entry`], because
+/// native finalization has not synthesized `OpEntryPoint` yet and `entry_idx` is authoritative.
+pub(in crate::passes) fn analyze(ctx: &Ctx) -> Result<FragmentControl, String> {
+    let fragment_entries = ctx
+        .module
+        .entry_points
+        .iter()
+        .filter(|entry| {
+            entry.operands.first() == Some(&Operand::ExecutionModel(ExecutionModel::Fragment))
+        })
+        .filter_map(|entry| match entry.operands.get(1) {
+            Some(Operand::IdRef(id)) => Some(*id),
+            _ => None,
+        })
+        .collect::<BTreeSet<_>>();
+    if fragment_entries.is_empty() {
+        return Ok(FragmentControl::default());
+    }
+
+    let functions_by_id = ctx
+        .module
+        .functions
+        .iter()
+        .enumerate()
+        .filter_map(|(index, function)| Some((function.def.as_ref()?.result_id?, index)))
+        .collect::<HashMap<_, _>>();
+    let entry_functions = fragment_entries
+        .iter()
+        .map(|entry_id| {
+            functions_by_id.get(entry_id).copied().ok_or_else(|| {
+                format!(
+                    "fragment OpEntryPoint names function %{entry_id}, but no owned function \
+                     definition has that result id"
+                )
+            })
+        })
+        .collect::<Result<BTreeSet<_>, _>>()?;
+    if ctx.stage == Stage::Fragment && entry_functions.len() == 1 {
+        return analyze_entry(ctx, *entry_functions.first().unwrap());
+    }
+    analyze_roots(ctx, entry_functions)
+}
+
+/// Analyze the selected fragment entry before `OpEntryPoint` finalization.
+///
+/// The native pipeline chooses the entry by body/name before the module has any `OpEntryPoint`
+/// instructions. Treating that module list as the source of truth here would return an empty
+/// `FragmentControl` and make every real block appear unreachable.
+pub(in crate::passes) fn analyze_entry(
+    ctx: &Ctx,
+    entry_idx: usize,
+) -> Result<FragmentControl, String> {
+    if ctx.stage != Stage::Fragment {
+        return Err("selected-entry fragment control analysis requires the fragment stage".into());
+    }
+    let function = ctx.module.functions.get(entry_idx).ok_or_else(|| {
+        format!("selected fragment entry function #{entry_idx} is outside the module")
+    })?;
+    if function.blocks.is_empty() {
+        return Err(format!(
+            "selected fragment entry function #{entry_idx} has no executable block"
+        ));
+    }
+    analyze_roots(ctx, BTreeSet::from([entry_idx]))
+}
+
+/// Analyze one or more executable roots, following only executable terminator edges.
+///
+/// Bodied helpers left in the graph inherit the conjunction of every reachable call-site context;
+/// `prepare_fragment_control` specializes mixed call sites first. Any remaining bodyless call is
+/// rejected because an unresolved AIR call has no executable CFG whose control condition this
+/// analysis can inspect.
+fn analyze_roots(ctx: &Ctx, entry_functions: BTreeSet<usize>) -> Result<FragmentControl, String> {
+    let mut facts_by_function: HashMap<Word, Vec<Word>> = HashMap::new();
+    for fact in &ctx.emit_sidecar.uniform_value_facts {
+        facts_by_function
+            .entry(fact.function)
+            .or_default()
+            .push(fact.value);
+    }
+
+    // Discover the executable function closure from all selected roots. A callee remains
+    // context-sensitive only at the granularity of "every reachable call site executes in a
+    // uniform context"; a helper called from both uniform and nonuniform sites is therefore not
+    // claimed uniform. Call-site cloning is required before that can be relaxed.
+    let mut reachable_functions = entry_functions.clone();
+    let mut work = entry_functions.iter().copied().collect::<VecDeque<_>>();
+    while let Some(function_index) = work.pop_front() {
+        let function = &ctx.module.functions[function_index];
+        let function_id = function
+            .def
+            .as_ref()
+            .and_then(|definition| definition.result_id);
+        let Some(function_id) = function_id else {
+            return Err(format!(
+                "reachable function #{function_index} has no result id"
+            ));
+        };
+        let local = analyze_function(
+            function,
+            function_id,
+            facts_by_function
+                .get(&function_id)
+                .map(Vec::as_slice)
+                .unwrap_or(&[]),
+            &ctx.module,
+            &HashSet::new(),
+        )?;
+        for call in &local.calls {
+            let callee_id = ctx.module.functions[call.callee]
+                .def
+                .as_ref()
+                .and_then(|definition| definition.result_id)
+                .ok_or_else(|| format!("reachable callee #{function_index} has no result id"))?;
+            if ctx.module.functions[call.callee].blocks.is_empty() {
+                return Err(format!(
+                    "fragment entry function %{function_id} reaches a call to bodyless function \
+                     %{callee_id}; unresolved AIR calls must be lowered before derivative analysis"
+                ));
+            }
+            if reachable_functions.insert(call.callee) {
+                work.push_back(call.callee);
+            }
+        }
+    }
+
+    let initial = reachable_functions
+        .iter()
+        .map(|&function_index| {
+            let function = &ctx.module.functions[function_index];
+            let function_id = function
+                .def
+                .as_ref()
+                .and_then(|definition| definition.result_id)
+                .ok_or_else(|| format!("reachable function #{function_index} has no result id"))?;
+            let control = analyze_function(
+                function,
+                function_id,
+                facts_by_function
+                    .get(&function_id)
+                    .map(Vec::as_slice)
+                    .unwrap_or(&[]),
+                &ctx.module,
+                &HashSet::new(),
+            )?;
+            Ok((function_index, control))
+        })
+        .collect::<Result<HashMap<_, _>, String>>()?;
+
+    // A callee that can terminate only some group invocations makes every caller continuation
+    // partial. Exit effects in a provably uniform block act on every invocation that reaches the
+    // call, so they cannot split the group and do not taint the caller continuation.
+    let function_ids = ctx
+        .module
+        .functions
+        .iter()
+        .enumerate()
+        .filter_map(|(index, function)| Some((index, function.def.as_ref()?.result_id?)))
+        .collect::<HashMap<_, _>>();
+    let mut effectful = HashSet::new();
+    for (&function_index, control) in &initial {
+        if function_has_local_exit_effect(&ctx.module.functions[function_index], &control.status) {
+            effectful.insert(function_ids[&function_index]);
+        }
+    }
+    loop {
+        let before = effectful.len();
+        for (&function_index, control) in &initial {
+            if control.calls.iter().any(|call| {
+                function_ids
+                    .get(&call.callee)
+                    .is_some_and(|callee| effectful.contains(callee))
+            }) {
+                effectful.insert(function_ids[&function_index]);
+            }
+        }
+        if effectful.len() == before {
+            break;
+        }
+    }
+
+    let mut controls = HashMap::new();
+    let mut calls = Vec::new();
+    for &function_index in &reachable_functions {
+        let function = &ctx.module.functions[function_index];
+        let function_id = function_ids[&function_index];
+        let control = analyze_function(
+            function,
+            function_id,
+            facts_by_function
+                .get(&function_id)
+                .map(Vec::as_slice)
+                .unwrap_or(&[]),
+            &ctx.module,
+            &effectful,
+        )?;
+        calls.extend(control.calls.iter().map(|call| (function_index, *call)));
+        controls.insert(function_index, control);
+    }
+
+    let mut entry_context = reachable_functions
+        .iter()
+        .map(|&function| (function, true))
+        .collect::<HashMap<_, _>>();
+    loop {
+        let mut changed = false;
+        for &(caller, call) in &calls {
+            let uniform_call = entry_context[&caller]
+                && controls[&caller].status[call.block] == ControlStatus::Uniform;
+            if !uniform_call && entry_context[&call.callee] {
+                entry_context.insert(call.callee, false);
+                changed = true;
+            }
+        }
+        if !changed {
+            break;
+        }
+    }
+    Ok(FragmentControl {
+        functions: controls,
+        entry_context,
+    })
+}
+
+fn analyze_function(
+    function: &Function,
+    function_id: Word,
+    asserted_uniform: &[Word],
+    module: &Module,
+    effectful_callees: &HashSet<Word>,
+) -> Result<FunctionControl, String> {
+    if function.blocks.is_empty() {
+        return Err(format!(
+            "fragment entry function %{function_id} has no executable block"
+        ));
+    }
+    let positions = function
+        .blocks
+        .iter()
+        .enumerate()
+        .filter_map(|(index, block)| Some((block.label.as_ref()?.result_id?, index)))
+        .collect::<HashMap<_, _>>();
+    if positions.len() != function.blocks.len() {
+        return Err(format!(
+            "fragment entry function %{function_id} has a block without a label"
+        ));
+    }
+
+    let mut successors = vec![Vec::new(); function.blocks.len()];
+    for (block_index, block) in function.blocks.iter().enumerate() {
+        let terminator = block.instructions.last().ok_or_else(|| {
+            format!(
+                "fragment entry function %{function_id} block {} has no terminator",
+                block
+                    .label
+                    .as_ref()
+                    .and_then(|label| label.result_id)
+                    .map(|id| format!("%{id}"))
+                    .unwrap_or_else(|| format!("#{block_index}"))
+            )
+        })?;
+        if !is_supported_fragment_terminator(terminator.class.opcode) {
+            return Err(format!(
+                "fragment control-flow analysis does not support {:?} terminating block {} in \
+                 function %{function_id}",
+                terminator.class.opcode,
+                block
+                    .label
+                    .as_ref()
+                    .and_then(|label| label.result_id)
+                    .map(|id| format!("%{id}"))
+                    .unwrap_or_else(|| format!("#{block_index}"))
+            ));
+        }
+        let mut targets = crate::spirv_module::block_successors(block)
+            .into_iter()
+            .map(|label| {
+                positions.get(&label).copied().ok_or_else(|| {
+                    format!(
+                        "fragment entry function %{function_id} block {} branches to unknown \
+                         block %{label}",
+                        block
+                            .label
+                            .as_ref()
+                            .and_then(|label| label.result_id)
+                            .map(|id| format!("%{id}"))
+                            .unwrap_or_else(|| format!("#{block_index}"))
+                    )
+                })
+            })
+            .collect::<Result<Vec<_>, _>>()?;
+        targets.sort_unstable();
+        targets.dedup();
+        successors[block_index] = targets;
+    }
+
+    // The crate's single dominator implementation roots at dense index zero. Assign zero to the
+    // executable entry block, then visit only blocks reachable through actual terminator edges.
+    let mut order = Vec::with_capacity(function.blocks.len());
+    let mut dense_position = vec![None; function.blocks.len()];
+    let mut work = VecDeque::from([0usize]);
+    dense_position[0] = Some(0);
+    while let Some(block) = work.pop_front() {
+        order.push(block);
+        for &target in &successors[block] {
+            if dense_position[target].is_none() {
+                dense_position[target] = Some(order.len() + work.len());
+                work.push_back(target);
+            }
+        }
+    }
+    // The provisional numbering above is not stable while the queue drains. Rebuild it from the
+    // completed order so it is exactly the dense index in `successors`.
+    for (dense, &original) in order.iter().enumerate() {
+        dense_position[original] = Some(dense);
+    }
+    let dense_successors = order
+        .iter()
+        .map(|&block| {
+            successors[block]
+                .iter()
+                .filter_map(|target| dense_position[*target])
+                .collect::<Vec<_>>()
+        })
+        .collect::<Vec<_>>();
+
+    let (_, postdominators, _) = reverse_post_dominance(&dense_successors);
+    let mut uniform_phi_predecessors = HashSet::new();
+    let nonuniform = loop {
+        let uniform_values = uniform_values(
+            function,
+            asserted_uniform,
+            module,
+            &uniform_phi_predecessors,
+        );
+        let mut nonuniform = vec![false; order.len()];
+        for (header, &block) in order.iter().enumerate() {
+            let terminator = function.blocks[block].instructions.last().unwrap();
+            let condition = match terminator.class.opcode {
+                Op::BranchConditional => match terminator.operands.first() {
+                    Some(Operand::IdRef(id)) => Some(*id),
+                    _ => {
+                        return Err(format!(
+                            "fragment function %{function_id} has malformed OpBranchConditional"
+                        ))
+                    }
+                },
+                Op::Switch => match terminator.operands.first() {
+                    Some(Operand::IdRef(id)) => Some(*id),
+                    _ => {
+                        return Err(format!(
+                            "fragment function %{function_id} has malformed OpSwitch"
+                        ))
+                    }
+                },
+                _ => None,
+            };
+            let Some(condition) = condition else {
+                continue;
+            };
+            if uniform_values.contains(&condition) || dense_successors[header].len() < 2 {
+                continue;
+            }
+
+            for &successor in &dense_successors[header] {
+                let mut pending = vec![successor];
+                let mut visited = HashSet::new();
+                while let Some(node) = pending.pop() {
+                    if !visited.insert(node) {
+                        continue;
+                    }
+                    // This node is where the paths reconverge. The branch no longer controls it, and
+                    // neither it nor anything after it inherits this branch's divergence.
+                    if crate::dominators::dominates_interval(&postdominators, node + 1, header + 1)
+                    {
+                        continue;
+                    }
+                    nonuniform[node] = true;
+                    pending.extend(dense_successors[node].iter().copied());
+                }
+            }
+        }
+
+        // Different uniform incoming values form a uniform phi only when every incoming edge
+        // executes uniformly. Start without that assumption and grow the proof to a fixed point.
+        let before = uniform_phi_predecessors.len();
+        for (node, &block) in order.iter().enumerate() {
+            if !nonuniform[node] {
+                uniform_phi_predecessors.insert(
+                    function.blocks[block]
+                        .label
+                        .as_ref()
+                        .unwrap()
+                        .result_id
+                        .unwrap(),
+                );
+            }
+        }
+        if uniform_phi_predecessors.len() == before {
+            break nonuniform;
+        }
+    };
+
+    // `OpDemoteToHelperInvocation` is not a flow-control instruction, so the CFG can reconverge even
+    // after some lanes executed discard_fragment. Metal 2.1 leaves every following derivative
+    // undefined in that case. Carry that fact forward independently of the control-dependence mark.
+    let mut partial_demote = vec![false; order.len()];
+    let mut pending = Vec::new();
+    let mut effective_call_blocks = Vec::new();
+    for (node, &block) in order.iter().enumerate() {
+        let local_demote = nonuniform[node]
+            && function.blocks[block]
+                .instructions
+                .iter()
+                .any(|instruction| instruction.class.opcode == Op::DemoteToHelperInvocation);
+        let effective_call = function.blocks[block]
+            .instructions
+            .iter()
+            .any(|instruction| {
+                instruction.class.opcode == Op::FunctionCall
+                    && instruction.operands.first().is_some_and(|operand| {
+                        matches!(operand, Operand::IdRef(callee) if effectful_callees.contains(callee))
+                    })
+            });
+        effective_call_blocks.extend(effective_call.then_some(node));
+        if local_demote || effective_call {
+            pending.extend(dense_successors[node].iter().copied());
+        }
+    }
+    while let Some(node) = pending.pop() {
+        if partial_demote[node] {
+            continue;
+        }
+        partial_demote[node] = true;
+        pending.extend(dense_successors[node].iter().copied());
+    }
+    // The block is a conservative boundary: a sample later in this same block must not be treated
+    // as before the call, and the current block-level representation cannot split at the
+    // instruction.
+    for block in effective_call_blocks {
+        partial_demote[block] = true;
+    }
+
+    let mut status = vec![ControlStatus::NotReachable; function.blocks.len()];
+    for (node, &block) in order.iter().enumerate() {
+        status[block] = if partial_demote[node] {
+            ControlStatus::PartialDemote
+        } else if nonuniform[node] {
+            ControlStatus::NonUniform
+        } else {
+            ControlStatus::Uniform
+        };
+    }
+    let calls = order
+        .iter()
+        .flat_map(|&block| {
+            function.blocks[block]
+                .instructions
+                .iter()
+                .filter_map(move |instruction| {
+                    if instruction.class.opcode != Op::FunctionCall {
+                        return None;
+                    }
+                    let Some(Operand::IdRef(callee)) = instruction.operands.first() else {
+                        return None;
+                    };
+                    let target = module.functions.iter().position(|function| {
+                        function
+                            .def
+                            .as_ref()
+                            .and_then(|definition| definition.result_id)
+                            == Some(*callee)
+                    })?;
+                    Some(CallSite {
+                        block,
+                        callee: target,
+                    })
+                })
+        })
+        .collect();
+    Ok(FunctionControl { status, calls })
+}
+
+fn function_has_local_exit_effect(function: &Function, status: &[ControlStatus]) -> bool {
+    function.blocks.iter().enumerate().any(|(block, value)| {
+        matches!(
+            status
+                .get(block)
+                .copied()
+                .unwrap_or(ControlStatus::NotReachable),
+            ControlStatus::NonUniform | ControlStatus::PartialDemote
+        ) && value.instructions.iter().any(|instruction| {
+            matches!(
+                instruction.class.opcode,
+                Op::DemoteToHelperInvocation | Op::Kill | Op::TerminateInvocation | Op::Unreachable
+            )
+        })
+    })
+}
+
+fn is_supported_fragment_terminator(opcode: Op) -> bool {
+    matches!(
+        opcode,
+        Op::Branch
+            | Op::BranchConditional
+            | Op::Switch
+            | Op::Return
+            | Op::ReturnValue
+            | Op::Kill
+            | Op::TerminateInvocation
+            | Op::Unreachable
+    )
+}
+
+/// Post-dominators of a dense executable CFG, rooted at a synthetic exit.
+///
+/// The crate's dominance implementation always roots at index zero. Reversing the graph and putting
+/// the virtual exit there therefore computes post-dominators with the same CHK implementation used
+/// by the rest of the translator. Dense block `n` has reverse-graph index `n + 1`.
+fn reverse_post_dominance(
+    successors: &[Vec<usize>],
+) -> (Vec<bool>, Vec<Option<(usize, usize)>>, Vec<Option<usize>>) {
+    let mut reverse = vec![Vec::new(); successors.len() + 1];
+    for (source, targets) in successors.iter().enumerate() {
+        for &target in targets {
+            reverse[target + 1].push(source + 1);
+        }
+        if targets.is_empty() {
+            reverse[0].push(source + 1);
+        }
+    }
+    let predecessors = crate::dominators::build_predecessors(&reverse);
+    crate::dominators::dominance(&reverse, &predecessors)
+}
+
+fn uniform_values(
+    function: &Function,
+    asserted_uniform: &[Word],
+    module: &Module,
+    uniform_phi_predecessors: &HashSet<Word>,
+) -> HashSet<Word> {
+    let mut uniform = module
+        .types_global_values
+        .iter()
+        .filter(|instruction| is_uniform_constant(instruction.class.opcode))
+        .filter_map(|instruction| instruction.result_id)
+        .collect::<HashSet<_>>();
+    uniform.extend(asserted_uniform.iter().copied());
+
+    let mut uniform_input_pointers = flat_or_primitive_input_variables(module);
+    loop {
+        let before = uniform.len();
+        let pointers_before = uniform_input_pointers.len();
+        for block in &function.blocks {
+            for instruction in &block.instructions {
+                let Some(result) = instruction.result_id else {
+                    continue;
+                };
+                match instruction.class.opcode {
+                    Op::AccessChain | Op::InBoundsAccessChain | Op::PtrAccessChain => {
+                        let Some(Operand::IdRef(base)) = instruction.operands.first() else {
+                            continue;
+                        };
+                        if uniform_input_pointers.contains(base)
+                            && instruction
+                                .operands
+                                .iter()
+                                .skip(1)
+                                .filter_map(|operand| match operand {
+                                    Operand::IdRef(id) => Some(*id),
+                                    _ => None,
+                                })
+                                .all(|id| uniform.contains(&id))
+                        {
+                            uniform_input_pointers.insert(result);
+                            uniform.insert(result);
+                        }
+                    }
+                    Op::CopyObject | Op::Bitcast => {
+                        if instruction.operands.iter().all(|operand| match operand {
+                            Operand::IdRef(id) => uniform.contains(id),
+                            _ => true,
+                        }) {
+                            uniform.insert(result);
+                        }
+                        if instruction.operands.first().is_some_and(|operand| {
+                            matches!(operand, Operand::IdRef(id) if uniform_input_pointers.contains(id))
+                        }) {
+                            uniform_input_pointers.insert(result);
+                        }
+                    }
+                    Op::Load => {
+                        if instruction.operands.first().is_some_and(|operand| {
+                            matches!(operand, Operand::IdRef(id) if uniform_input_pointers.contains(id))
+                        }) {
+                            uniform.insert(result);
+                        }
+                    }
+                    Op::Phi => {
+                        let sources = instruction
+                            .operands
+                            .chunks_exact(2)
+                            .filter_map(|pair| match pair.first() {
+                                Some(Operand::IdRef(id)) => Some(*id),
+                                _ => None,
+                            })
+                            .collect::<Vec<_>>();
+                        let same_source = sources.first().is_some_and(|first| {
+                            sources.iter().all(|source| source == first)
+                        });
+                        let uniform_edges = instruction.operands.chunks_exact(2).all(|pair| {
+                            matches!(pair.get(1), Some(Operand::IdRef(label))
+                                if uniform_phi_predecessors.contains(label))
+                        });
+                        if !sources.is_empty()
+                            && sources.iter().all(|id| uniform.contains(id))
+                            && (same_source || uniform_edges)
+                        {
+                            uniform.insert(result);
+                        }
+                    }
+                    op if is_uniform_preserving_operation(op)
+                        && instruction
+                            .operands
+                            .iter()
+                            .filter_map(|operand| match operand {
+                                Operand::IdRef(id) => Some(*id),
+                                _ => None,
+                            })
+                            .all(|id| uniform.contains(&id)) =>
+                    {
+                        uniform.insert(result);
+                    }
+                    _ => {}
+                }
+            }
+        }
+        if uniform.len() == before && uniform_input_pointers.len() == pointers_before {
+            break;
+        }
+    }
+    uniform
+}
+
+fn flat_or_primitive_input_variables(module: &Module) -> HashSet<Word> {
+    let mut flat = HashSet::new();
+    let mut primitive_id = HashSet::new();
+    for annotation in &module.annotations {
+        let [Operand::IdRef(id), Operand::Decoration(decoration), rest @ ..] =
+            annotation.operands.as_slice()
+        else {
+            continue;
+        };
+        match (annotation.class.opcode, decoration, rest) {
+            (Op::Decorate, Decoration::Flat, []) => {
+                flat.insert(*id);
+            }
+            (Op::Decorate, Decoration::BuiltIn, [Operand::BuiltIn(BuiltIn::PrimitiveId)]) => {
+                primitive_id.insert(*id);
+            }
+            _ => {}
+        }
+    }
+    let input_variables = module
+        .types_global_values
+        .iter()
+        .filter(|instruction| instruction.class.opcode == Op::Variable)
+        .filter(|instruction| {
+            instruction.operands.first() == Some(&Operand::StorageClass(StorageClass::Input))
+        })
+        .filter_map(|instruction| instruction.result_id)
+        .collect::<HashSet<_>>();
+    flat.intersection(&input_variables)
+        .chain(primitive_id.intersection(&input_variables))
+        .copied()
+        .collect()
+}
+
+fn is_uniform_constant(opcode: Op) -> bool {
+    matches!(
+        opcode,
+        Op::Constant
+            | Op::ConstantTrue
+            | Op::ConstantFalse
+            | Op::ConstantComposite
+            | Op::ConstantNull
+            | Op::ConstantSampler
+            | Op::SpecConstant
+            | Op::SpecConstantComposite
+            | Op::SpecConstantOp
+            | Op::SpecConstantTrue
+            | Op::SpecConstantFalse
+    )
+}
+
