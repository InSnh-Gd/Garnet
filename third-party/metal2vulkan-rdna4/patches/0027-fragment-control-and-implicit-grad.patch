+/// Lower an explicit GPU argument table ABI with an optional cached typed-uniformity proof.
+///
+/// The proof is scoped to the exact serialized module by the wrapper before this entry point. It
+/// seeds only `air.is_uniform` facts; descriptor representation and normalized-sampler coordinate
+/// selection remain controlled by `table_version`.
+pub fn lower_argument_resource_tables_with_table_version_and_uniform_control_proof(
+    bytes: &[u8],
+    fields: &[ArgumentResourceField],
+    table_version: u32,
