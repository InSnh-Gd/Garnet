+    #[test]
+    fn bias_uses_the_table_limit_and_scales_both_signed_operands() {
+        let preamble = PREAMBLE
+            .replace(
+                "OpName %entry \"entry_block\"\n",
+                "OpName %entry \"entry_block\"\nOpName %table \"table\"\n",
+            )
+            .replace(
+                "%float_0 = OpConstant %float 0\n",
+                "%float_0 = OpConstant %float 0\n\
+             %bias_positive = OpConstant %float 2\n\
+             %bias_negative = OpConstant %float -2\n",
+            );
+        let Some(module) = assemble(&format!(
+            "{preamble}
+%main = OpFunction %void None %fn
+%entry = OpLabel
+%sampled = OpLoad %sampled_type %sampled_var
+%positive = OpImageSampleImplicitLod %v4float %sampled %coord Bias %bias_positive
+%negative = OpImageSampleImplicitLod %v4float %sampled %coord Bias %bias_negative
+OpReturn
+OpFunctionEnd
+"
+        )) else {
+            return;
+        };
+        let main = named_id(&module, "entry");
+        let table = named_id(&module, "table");
+        let lowered = run(module, &[]).unwrap();
+        validate(&lowered);
+        let entry = block_index(&lowered, main, named_id(&lowered, "entry_block"));
+        let body = &lowered.functions[function_index(&lowered, main)].blocks[entry].instructions;
+
+        let constant_six = body
+            .iter()
+            .filter(|instruction| instruction.class.opcode == Op::AccessChain)
+            .filter(|instruction| instruction.operands.first() == Some(&Operand::IdRef(table)))
+            .filter_map(|instruction| match instruction.operands.get(2) {
+                Some(Operand::IdRef(index)) => Some(*index),
+                _ => None,
+            })
+            .find(|index| {
+                lowered
+                    .types_global_values
+                    .iter()
+                    .chain(lowered.functions.iter().flat_map(|function| {
+                        function
+                            .parameters
+                            .iter()
+                            .chain(function.blocks.iter().flat_map(|block| &block.instructions))
+                    }))
+                    .any(|instruction| {
+                        instruction.result_id == Some(*index)
+                            && instruction.class.opcode == Op::Constant
+                            && instruction.operands == vec![Operand::LiteralBit32(6)]
+                    })
+            });
+        assert!(
+            constant_six.is_some(),
+            "bias limit must be loaded from table word 6"
+        );
+        assert_eq!(
+            body.iter()
+                .filter(|instruction| instruction.class.opcode == Op::FNegate)
+                .count(),
+            2
+        );
+        for op in [GlslStd450Op::FClamp, GlslStd450Op::Exp2] {
+            assert_eq!(
+                body.iter()
+                    .filter(|instruction| {
+                        instruction.class.opcode == Op::ExtInst
+                            && instruction.operands.get(1)
+                                == Some(&Operand::LiteralExtInstInteger(op as u32))
+                    })
+                    .count(),
+                2,
+                "{op:?} must be emitted for both signed bias operands"
+            );
+        }
+        for instruction in body
+            .iter()
+            .filter(|instruction| instruction.class.opcode == Op::ImageSampleExplicitLod)
+        {
+            let mask = instruction
+                .operands
+                .iter()
+                .find_map(|operand| match operand {
+                    Operand::ImageOperands(mask) => Some(*mask),
+                    _ => None,
+                })
+                .unwrap();
+            assert_eq!(mask, ImageOperands::GRAD);
+        }
+    }
