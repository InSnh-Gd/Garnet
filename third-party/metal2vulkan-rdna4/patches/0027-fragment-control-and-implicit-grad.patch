+    #[test]
+    fn bias_conversion_preserves_non_bias_image_operands_in_wire_order() {
+        let preamble = PREAMBLE
+            .replace(
+                "OpCapability Shader\n",
+                "OpCapability Shader\nOpCapability MinLod\n",
+            )
+            .replace(
+                "OpName %entry \"entry_block\"\n",
+                "OpName %entry \"entry_block\"\nOpName %bias \"bias\"\n\
+                 OpName %offset \"offset\"\nOpName %min_lod \"min_lod\"\n",
+            )
+            .replace(
+                "%float_0 = OpConstant %float 0\n",
+                "%int = OpTypeInt 32 1\n%v2int = OpTypeVector %int 2\n\
+                 %int_0 = OpConstant %int 0\n%offset = OpConstantComposite %v2int %int_0 %int_0\n\
+                 %float_0 = OpConstant %float 0\n%bias = OpConstant %float 2\n\
+                 %min_lod = OpConstant %float 0.5\n",
+            );
+        let Some(module) = assemble(&format!(
+            "{preamble}
+%main = OpFunction %void None %fn
+%entry = OpLabel
+%sampled = OpLoad %sampled_type %sampled_var
+%color = OpImageSampleImplicitLod %v4float %sampled %coord Bias|ConstOffset|MinLod %bias %offset %min_lod
+OpReturn
+OpFunctionEnd
+"
+        )) else {
+            return;
+        };
+        let main = named_id(&module, "entry");
+        let offset = named_id(&module, "offset");
+        let min_lod = named_id(&module, "min_lod");
+        let lowered = run(module, &[]).unwrap();
+        validate(&lowered);
+        let entry = block_index(&lowered, main, named_id(&lowered, "entry_block"));
+        let body = &lowered.functions[function_index(&lowered, main)].blocks[entry].instructions;
+        let sample = body
+            .iter()
+            .find(|instruction| instruction.class.opcode == Op::ImageSampleExplicitLod)
+            .expect("bias sample must become explicit Grad");
+        assert_eq!(
+            sample.operands.iter().find_map(|operand| match operand {
+                Operand::ImageOperands(mask) => Some(*mask),
+                _ => None,
+            }),
+            Some(ImageOperands::GRAD | ImageOperands::CONST_OFFSET | ImageOperands::MIN_LOD)
+        );
+        let tail = sample
+            .operands
+            .iter()
+            .skip_while(|operand| !matches!(operand, Operand::ImageOperands(_)))
+            .skip(1)
+            .collect::<Vec<_>>();
+        assert_eq!(tail.len(), 4);
+        assert!(matches!(tail[0], Operand::IdRef(_)));
+        assert!(matches!(tail[1], Operand::IdRef(_)));
+        assert_eq!(tail[2], &Operand::IdRef(offset));
+        assert_eq!(tail[3], &Operand::IdRef(min_lod));
+    }
