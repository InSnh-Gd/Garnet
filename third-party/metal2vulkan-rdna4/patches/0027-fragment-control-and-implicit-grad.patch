+
+fn uniform_control_sidecar(
+    module: &Module,
+    proof: Option<&UniformControlProof>,
+) -> Result<crate::emit_sidecar::EmitSidecar, String> {
+    let mut sidecar = crate::emit_sidecar::EmitSidecar::default();
+    let Some(proof) = proof else {
+        return Ok(sidecar);
+    };
+
+    let mut actual_entries = module
+        .entry_points
+        .iter()
+        .filter(|entry| {
+            entry.operands.first() == Some(&Operand::ExecutionModel(ExecutionModel::Fragment))
+        })
+        .filter_map(|entry| match entry.operands.as_slice() {
+            [
+                Operand::ExecutionModel(_),
+                Operand::IdRef(function),
+                Operand::LiteralString(name),
+                ..,
+            ] => Some((*function, name.clone())),
+            _ => None,
+        })
+        .collect::<Vec<_>>();
+    actual_entries
+        .sort_by(|left, right| (left.0, left.1.as_str()).cmp(&(right.0, right.1.as_str())));
+    actual_entries.dedup();
+    let mut claimed_entries = proof
+        .entries
+        .iter()
+        .map(|entry| (entry.function, entry.name.clone()))
+        .collect::<Vec<_>>();
+    claimed_entries
+        .sort_by(|left, right| (left.0, left.1.as_str()).cmp(&(right.0, right.1.as_str())));
+    let claimed_len = claimed_entries.len();
+    claimed_entries.dedup();
+    if claimed_entries.len() != claimed_len || claimed_entries != actual_entries {
+        return Err(
+            "uniform control proof does not name this SPIR-V module's fragment entries".into(),
+        );
+    }
+
+    let mut seen = HashSet::new();
+    for UniformControlValue { function, value } in proof.values.iter().copied() {
+        if !seen.insert((function, value)) {
+            return Err(format!(
+                "uniform control proof repeats function %{function} value %{value}"
+            ));
+        }
+        let definition = module
+            .functions
+            .iter()
+            .find(|definition| {
+                definition.def.as_ref().and_then(|def| def.result_id) == Some(function)
+            })
+            .ok_or_else(|| format!("uniform control proof names unknown function %{function}"))?;
+        if !definition
+            .all_inst_iter()
+            .any(|instruction| instruction.result_id == Some(value))
+        {
+            return Err(format!(
+                "uniform control proof names value %{value} outside function %{function}"
+            ));
+        }
+        sidecar
+            .uniform_value_facts
+            .push(crate::emit_sidecar::UniformValueFact { function, value });
+    }
+    Ok(sidecar)
 }
 
