+    fn atomic_rmw_result_id(
+        &mut self,
+        call: &LlCall,
+        result_name: Option<&str>,
+        elem_ty: &LlType,
+    ) -> Result<Word, String> {
+        let ret_ty = self.resolve_type(&call.ret)?;
+        let expected_ret = if result_name.is_some() {
+            elem_ty
+        } else {
+            &LlType::Void
+        };
+        if &ret_ty != expected_ret {
+            return Err(format!(
+                "native emitter: {} returned {ret_ty:?}",
+                call.callee
+            ));
+        }
+        match result_name {
+            Some(name) => self.result_id(name, elem_ty),
+            None => Ok(self.fresh()),
+        }
+    }
