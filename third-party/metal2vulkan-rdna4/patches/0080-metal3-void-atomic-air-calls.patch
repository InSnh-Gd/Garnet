+#[test]
+fn native_metal3_void_atomic_rmw_calls_lower_cleanly() {
+    // 1. Exact Apple air64_v28 `k_u64_minmax` shape: void-returning `air.atomic.global.{min,max}.u.i64`.
+    let u64_minmax = r#"
+target triple = "air64_v28-apple-macosx26.7.0"
+%"struct.metal::_atomic" = type { i64 }
+define void @k_u64_minmax(ptr addrspace(1) nocapture noundef "air-buffer-no-alias" %slots, i32 noundef %gid) {
+entry:
+  %conv = zext i32 %gid to i64
+  %hi = shl nuw nsw i64 %conv, 36
+  %val = or i64 %hi, %conv
+  %p0 = getelementptr inbounds %"struct.metal::_atomic", ptr addrspace(1) %slots, i64 0, i32 0
+  tail call void @air.atomic.global.min.u.i64(ptr addrspace(1) nocapture %p0, i64 %val, i32 0, i32 2, i1 true)
+  %p1 = getelementptr inbounds %"struct.metal::_atomic", ptr addrspace(1) %slots, i64 1, i32 0
+  tail call void @air.atomic.global.max.u.i64(ptr addrspace(1) nocapture %p1, i64 %val, i32 0, i32 2, i1 true)
+  ret void
+}
+declare void @air.atomic.global.min.u.i64(ptr addrspace(1) nocapture, i64, i32, i32, i1)
+declare void @air.atomic.global.max.u.i64(ptr addrspace(1) nocapture, i64, i32, i32, i1)
+!air.kernel = !{!0}
+!0 = !{ptr @k_u64_minmax, !1, !2}
+!1 = !{}
+!2 = !{!3, !5}
+!3 = !{i32 0, !"air.buffer", !"air.location_index", i32 0, i32 1, !"air.read_write", !"air.address_space", i32 1, !"air.struct_type_info", !4, !"air.arg_type_size", i32 8, !"air.arg_type_align_size", i32 8, !"air.arg_type_name", !"metal::_atomic", !"air.arg_name", !"slots"}
+!4 = !{i32 0, i32 8, i32 0, !"ulong", !"__s"}
+!5 = !{i32 1, !"air.thread_position_in_grid", !"air.arg_type_name", !"uint", !"air.arg_name", !"gid"}
+"#;
+    let (spv, _) = crate::translate_sanitized_native_reflected_unvalidated(
+        u64_minmax,
+        Stage::Kernel,
+        std::path::Path::new(""),
+        crate::passes::TransformOptions::default(),
+        None,
+    )
+    .expect("void air.atomic.global.{min,max}.u.i64 should translate");
+    let asm = disassemble(&spv).expect("disassemble u64_minmax");
+    assert!(asm.contains("OpCapability Int64"), "{asm}");
+    assert!(asm.contains("OpCapability Int64Atomics"), "{asm}");
+    assert!(asm.contains("OpAtomicUMin"), "{asm}");
+    assert!(asm.contains("OpAtomicUMax"), "{asm}");
+    assert!(!asm.contains("air.atomic."), "{asm}");
