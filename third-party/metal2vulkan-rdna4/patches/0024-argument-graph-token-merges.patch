+    /// Preserve the typed select/phi structure for opaque resource values. The logical pointer
+    /// placeholder is a valid value for the ordinary emitter but carries no descriptor identity;
+    /// the graph pass uses this fact to propagate the two token words through the same control flow.
+    fn record_opaque_resource_merges(
+        &mut self,
+        tir: &crate::native::tir::TirFunction,
+    ) -> Result<(), String> {
+        let mut facts = Vec::new();
+        let mut zero_payload_recorded = false;
+        let merge_payload_id = |value: &LlValue,
+                                emitter: &mut Self,
+                                zero_payload_recorded: &mut bool|
+         -> Result<Option<Word>, String> {
+            match value {
+                LlValue::Local(name) => Ok(emitter.values.get(name).map(|(id, _)| *id)),
+                LlValue::Zero | LlValue::Undef => {
+                    let zero = emitter.const_uint(0)?;
+                    if !*zero_payload_recorded {
+                        emitter.emit_sidecar.opaque_resource_payloads.push(
+                            crate::emit_sidecar::OpaqueResourcePayload {
+                                id: zero,
+                                low: zero,
+                                high: zero,
+                            },
+                        );
+                        *zero_payload_recorded = true;
+                    }
+                    Ok(Some(zero))
+                }
+                _ => Ok(None),
+            }
+        };
+        let merge_condition_id =
+            |value: &LlValue, emitter: &mut Self| -> Result<Option<Word>, String> {
+                match value {
+                    LlValue::Local(name) => Ok(emitter.values.get(name).map(|(id, _)| *id)),
+                    LlValue::Zero | LlValue::Undef => Ok(Some(emitter.const_bool(false)?)),
+                    LlValue::Bool(value) => Ok(Some(emitter.const_bool(*value)?)),
+                    LlValue::Int(value @ 0..=1) => Ok(Some(emitter.const_bool(*value == 1)?)),
+                    _ => Ok(None),
+                }
+            };
+
+        for block in &tir.blocks {
+            let block_id = self.label_id(&block.label)?;
+            for inst in &block.insts {
+                let Some(result_name) = inst.result.as_ref() else {
+                    continue;
+                };
+                // `TirInst::result_ty` can retain the select's addrspace(0) result while both typed
+                // arms carry the actual addrspace(1|2) resource pointers. The opaque set was derived
+                // from the original typed AIR definitions, so it is the authoritative provenance
+                // gate here.
+                if !self.opaque_resource_pointers.contains(result_name) {
+                    continue;
+                }
+                let Some(result) = self.values.get(result_name).map(|(id, _)| *id) else {
+                    continue;
+                };
+                let kind = match inst.opcode {
+                    TirOpcode::Select => {
+                        let Some(condition) =
+                            inst.operands.first().and_then(TirOperand::as_typed_value)
+                        else {
+                            continue;
+                        };
+                        let Some((true_value, false_value)) = inst.select_arms().as_deref() else {
+                            continue;
+                        };
+                        let Some(condition) = merge_condition_id(&condition.value, self)? else {
+                            continue;
+                        };
+                        let Some(true_value) =
+                            merge_payload_id(&true_value.value, self, &mut zero_payload_recorded)?
+                        else {
+                            continue;
+                        };
+                        let Some(false_value) =
+                            merge_payload_id(&false_value.value, self, &mut zero_payload_recorded)?
+                        else {
+                            continue;
+                        };
+                        crate::emit_sidecar::OpaqueResourceMergeKind::Select {
+                            condition,
+                            true_value,
+                            false_value,
+                        }
+                    }
+                    TirOpcode::Phi => {
