+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+struct PayloadWords {
+    low: Word,
+    high: Word,
+}
+
+#[derive(Clone, Copy, Debug)]
+struct SelectPayload {
+    result: Word,
+    condition: Word,
+    true_value: Word,
+    false_value: Word,
+    words: PayloadWords,
+}
+
+#[derive(Clone, Debug)]
+struct PhiPayload {
+    result: Word,
+    incoming: Vec<(Word, Word)>,
+    words: PayloadWords,
+}
+
+fn word_select(
+    select: &SelectPayload,
+    payloads: &HashMap<Word, PayloadWords>,
+    uint: Word,
+) -> [Instruction; 2] {
+    let true_words = payloads[&select.true_value];
+    let false_words = payloads[&select.false_value];
+    [
+        Instruction::new(
+            Op::Select,
+            Some(uint),
+            Some(select.words.low),
+            vec![
+                Operand::IdRef(select.condition),
+                Operand::IdRef(true_words.low),
+                Operand::IdRef(false_words.low),
+            ],
+        ),
+        Instruction::new(
+            Op::Select,
+            Some(uint),
+            Some(select.words.high),
