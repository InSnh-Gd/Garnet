+                            continue;
+                        };
+                        let mut values = Vec::with_capacity(incoming.len());
+                        for (value, label) in incoming {
+                            let Some(value) =
+                                merge_payload_id(value, self, &mut zero_payload_recorded)?
+                            else {
+                                values.clear();
+                                break;
+                            };
+                            values.push((value, self.label_id(label)?));
+                        }
+                        if values.is_empty() {
+                            continue;
+                        }
+                        crate::emit_sidecar::OpaqueResourceMergeKind::Phi { incoming: values }
+                    }
+                    _ => continue,
+                };
+                facts.push(crate::emit_sidecar::OpaqueResourceMerge {
+                    result,
+                    block: block_id,
+                    kind,
+                });
+            }
+        }
+        self.emit_sidecar.opaque_resource_merges.extend(facts);
         Ok(())
     }
 
