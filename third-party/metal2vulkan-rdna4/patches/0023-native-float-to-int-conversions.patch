+    /// The operand-resolved core of `fptoui`/`fptosi`. The destination is resolved before checking
+    /// shapes so LLVM `i1` (which becomes SPIR-V `OpTypeBool`) cannot reach `OpConvertFToU/S`.
+    pub(in crate::native::emitter) fn emit_float_to_int_convert_resolved(
+        &mut self,
+        op: Op,
+        src: TypedValue,
+        dst_ty: LlType,
+        name: String,
+        instructions: &mut Vec<Instruction>,
+    ) -> Result<(), String> {
+        let src_ty = self.resolve_type(&src.ty)?;
+        let resolved_dst = self.resolve_type(&dst_ty)?;
+        if !int_to_float_convert_supported(&resolved_dst, &src_ty) {
+            return Err(format!(
+                "native emitter: float-to-integer conversion needs matching float-to-integer shapes, got {src_ty:?} to {resolved_dst:?}"
+            ));
+        }
+        let result_type = self.type_id(&dst_ty)?;
+        let result = self.result_id(&name, &dst_ty)?;
+        let src_id = self.value_id_in(&src.value, &src.ty, instructions)?;
+        instructions.push(Self::inst(
+            op,
+            Some(result_type),
+            Some(result),
+            vec![Operand::IdRef(src_id)],
+        ));
+        Ok(())
+    }
