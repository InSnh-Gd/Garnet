+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn rewritten(parameter: &str, body: &str, entry: bool) -> Vec<BodyBlock> {
+        let source = format!("define float @main({parameter} %buffer, i1 %condition, i64 %index) {{\nentry:\n br i1 %condition, label %arm, label %exit\narm:\n {body}\n br label %exit\nexit:\n ret float 0.0\n}}\n");
+        let mut parsed = LlModule::parse(&source).unwrap();
+        if entry {
+            parsed.entry_functions.insert("main".into());
+        }
+        let function = &parsed.functions[0];
+        let mut blocks = function.blocks.clone();
+        hoist(&parsed, function, &mut blocks);
+        blocks
+    }
+
+    fn names(block: &BodyBlock) -> Vec<&str> {
+        block
+            .typed
+            .as_ref()
+            .unwrap()
+            .insts
+            .iter()
+            .filter_map(|i| i.result.as_deref())
+            .collect()
+    }
+
+    #[test]
+    fn bounded_aligned_read_moves_with_shared_pointer_path_once() {
+        let blocks = rewritten(
+            "ptr addrspace(2) readonly align 16 dereferenceable(32)",
+            "%base = getelementptr i8, ptr addrspace(2) %buffer, i64 16\n \
+             %p = getelementptr i8, ptr addrspace(2) %base, i64 12\n \
+             %first = load float, ptr addrspace(2) %p, align 4\n \
+             %second = load float, ptr addrspace(2) %p, align 4",
+            true,
+        );
+        assert_eq!(names(&blocks[0]), ["%base", "%p", "%first", "%second"]);
+        assert!(names(&blocks[1]).is_empty());
+    }
+
+    #[test]
+    fn guards_are_preserved_without_an_unconditional_span_and_alignment() {
+        for parameter in [
+            "ptr addrspace(2) readonly align 4",
+            "ptr addrspace(2) readonly nonnull align 4",
+            "ptr addrspace(2) readonly align 4 dereferenceable_or_null(32)",
+            "ptr addrspace(2) readonly align 4 dereferenceable(31)",
+            "ptr addrspace(2) readonly align 1 dereferenceable(32)",
+            "ptr addrspace(2) align 4 dereferenceable(32)",
+            "ptr addrspace(1) readonly align 4 dereferenceable(32)",
+        ] {
+            let blocks = rewritten(parameter, "%p = getelementptr i8, ptr addrspace(2) %buffer, i64 28\n %value = load float, ptr addrspace(2) %p, align 4", true);
+            assert!(names(&blocks[0]).is_empty(), "{parameter}");
+            assert_eq!(names(&blocks[1]), ["%p", "%value"], "{parameter}");
+        }
+    }
+
+    #[test]
+    fn negative_overflow_dynamic_misaligned_and_ordered_reads_stay_guarded() {
+        for (offset, load) in [
+            ("-4", "float"),
+            ("29", "float"),
+            ("%index", "float"),
+            ("9223372036854775807", "float"),
+            ("28", "volatile float"),
+            ("28", "atomic float"),
+        ] {
+            let body = format!("%p = getelementptr i8, ptr addrspace(2) %buffer, i64 {offset}\n %value = load {load}, ptr addrspace(2) %p, align 4");
+            let blocks = rewritten(
+                "ptr addrspace(2) readonly align 4 dereferenceable(32)",
+                &body,
+                true,
+            );
+            assert!(names(&blocks[0]).is_empty(), "{offset} {load}");
+            assert_eq!(names(&blocks[1]), ["%p", "%value"]);
+        }
+    }
+
+    #[test]
+    fn an_inbounds_path_cannot_leave_the_promised_object_and_reenter_it() {
+        for (first, second) in [(-4, 4), (40, -40)] {
+            let body = format!("%outside = getelementptr inbounds i8, ptr addrspace(2) %buffer, i64 {first}\n %p = getelementptr i8, ptr addrspace(2) %outside, i64 {second}\n %value = load float, ptr addrspace(2) %p, align 4");
+            let blocks = rewritten(
+                "ptr addrspace(2) readonly align 4 dereferenceable(32)",
+                &body,
+                true,
+            );
+            assert!(names(&blocks[0]).is_empty(), "{first} {second}");
+            assert_eq!(names(&blocks[1]), ["%outside", "%p", "%value"]);
+        }
+    }
+
+    #[test]
+    fn helper_attribute_never_establishes_an_entry_promise() {
+        let blocks = rewritten(
+            "ptr addrspace(2) readonly align 4 dereferenceable(32)",
+            "%value = load float, ptr addrspace(2) %buffer, align 4",
+            false,
+        );
+        assert!(names(&blocks[0]).is_empty());
+        assert_eq!(names(&blocks[1]), ["%value"]);
+    }
+}
