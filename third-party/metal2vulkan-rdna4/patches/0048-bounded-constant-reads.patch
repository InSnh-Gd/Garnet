+//! Move only unconditionally accessible constant-buffer reads to their entry invocation.
+//!
+//! LLVM `readonly` alone does not make a guarded access safe. The entry parameter must also
+//! promise `dereferenceable(n)`, and the complete constant-offset load must fit that span.
+//! Moving the source read before interface construction gives direct and cached paths the same
+//! dominating value without teaching derivative placement to speculate arbitrary storage loads.
+
+use super::cfg::BodyBlock;
+use super::ir::{LlFunction, LlModule, LlType, LlValue};
+use super::tir::{TirInst, TirOpcode};
+use std::collections::{HashMap, HashSet};
+
+pub(super) fn hoist(parsed: &LlModule, function: &LlFunction, blocks: &mut [BodyBlock]) {
+    // A helper's dereferenceable promise only holds when called, possibly behind a guard.
+    if !parsed.entry_functions.contains(&function.name) || function.constant_read_spans.is_empty() {
+        return;
+    }
+    let Some(entry) = blocks.first().and_then(|block| block.typed.as_ref()) else {
+        return;
+    };
+    let entry_values = entry
+        .insts
+        .iter()
+        .filter_map(|i| i.result.as_deref())
+        .collect::<HashSet<_>>();
+    let definitions = blocks
+        .iter()
+        .filter_map(|block| block.typed.as_ref())
+        .flat_map(|block| &block.insts)
+        .filter_map(|i| Some((i.result.as_deref()?, i)))
+        .collect::<HashMap<_, _>>();
+    let mut moved = HashSet::new();
+    let mut prologue = Vec::new();
+    for block in blocks
+        .iter()
+        .skip(1)
+        .filter_map(|block| block.typed.as_ref())
+    {
+        for instruction in &block.insts {
+            let Some(path) = read_path(parsed, function, &definitions, instruction) else {
+                continue;
+            };
+            for dependency in path {
+                let name = dependency
+                    .result
+                    .as_deref()
+                    .expect("read path has SSA results");
+                if !entry_values.contains(name) && moved.insert(name.to_string()) {
+                    prologue.push(dependency.clone());
+                }
+            }
+        }
+    }
+    if prologue.is_empty() {
+        return;
+    }
+    for block in blocks.iter_mut().skip(1).filter_map(BodyBlock::typed_mut) {
+        block
+            .insts
+            .retain(|i| i.result.as_ref().is_none_or(|name| !moved.contains(name)));
+    }
+    blocks[0]
+        .typed_mut()
+        .expect("entry checked above")
+        .insts
+        .extend(prologue);
+}
+
+fn read_path<'a>(
+    parsed: &LlModule,
+    function: &LlFunction,
+    definitions: &HashMap<&str, &'a TirInst>,
+    instruction: &'a TirInst,
+) -> Option<Vec<&'a TirInst>> {
+    let load = instruction.load().as_deref()?;
+    let numeric = |ty: &LlType| {
+        matches!(
+            parsed.resolve_known_type(ty),
+            LlType::Int(_) | LlType::Float | LlType::Half | LlType::BFloat
+        )
+    };
+    let ty = parsed.resolve_known_type(&load.result_ty);
+    if load.ordered
+        || !(numeric(&ty) || matches!(&ty, LlType::Vector(element, _) if numeric(element)))
+    {
+        return None;
+    }
+    let (bytes, _) = parsed.native_memcpy_type_size_align(&load.result_ty)?;
+    let LlValue::Local(mut pointer) = load.ptr.value.clone() else {
+        return None;
+    };
+    let mut path = vec![instruction];
+    let mut visited = HashSet::new();
+    while !function.constant_read_spans.contains_key(&pointer) {
+        if !visited.insert(pointer.clone()) {
+            return None;
+        }
+        let definition = *definitions.get(pointer.as_str())?;
+        if let Some(gep) = definition.gep().as_deref() {
+            let LlValue::Local(base) = &gep.base.value else {
+                return None;
+            };
+            pointer = base.clone();
+        } else if let Some((_, base)) = definition.identity_ptr_bitcast() {
+            pointer = base.to_string();
+        } else if definition.opcode == TirOpcode::Metal2VulkanInlineParameter {
+            let argument = definition.operands.first()?.as_typed_value()?;
+            if argument.ty != LlType::Ptr(2) {
+                return None;
+            }
+            let LlValue::Local(base) = argument.value else {
+                return None;
+            };
+            pointer = base;
+        } else {
+            return None;
+        }
+        path.push(definition);
+    }
+    let span = &function.constant_read_spans[&pointer];
+    let mut offset = 0i128;
+    for dependency in path.iter().rev() {
+        if let Some(gep) = dependency.gep().as_deref() {
+            offset =
+                offset.checked_add(super::emit_tiers::constant_gep_byte_offset(parsed, gep)?)?;
+            // An intermediate inbounds pointer can be poison even when the final offset fits.
+            if offset < 0 || offset > i128::from(span.bytes) {
+                return None;
+            }
+        }
+    }
+    let align = load
+        .align
+        .unwrap_or(parsed.native_memcpy_type_size_align(&load.result_ty)?.1);
+    if offset < 0
+        || offset.checked_add(i128::from(bytes))? > i128::from(span.bytes)
+        || align == 0
+        || span.align < align
+        || offset % i128::from(align) != 0
+    {
+        return None;
+    }
+    path.reverse();
+    Some(path)
+}
