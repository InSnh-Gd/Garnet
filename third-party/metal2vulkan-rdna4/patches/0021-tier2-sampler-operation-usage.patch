+/// Give every comparison use of a sampled image the compare-enabled sampler representation.
+///
+/// Ordinary and comparison users of one `OpSampledImage` are split by cloning that instruction.
+/// A comparison-only sampler keeps no ordinary descriptor; its surviving descriptor is already the
+/// comparison binding, which reflection reports as the resource's primary descriptor.
+pub(in crate::passes) fn select_sampler_operation_usage(ctx: &mut Ctx) -> Result<bool, String> {
+    let defs = ctx
+        .module
+        .all_inst_iter()
+        .chain(ctx.new_globals.iter())
+        .filter_map(|instruction| instruction.result_id.map(|id| (id, instruction.clone())))
+        .collect::<HashMap<_, _>>();
+    let variables = descriptor_variables(ctx, &defs)?;
+    let mut samples = HashMap::new();
+    for (function, body) in ctx.module.functions.iter().enumerate() {
+        for (block, instructions) in body.blocks.iter().enumerate() {
+            for (instruction, inst) in instructions.instructions.iter().enumerate() {
+                if inst.class.opcode != Op::SampledImage {
+                    continue;
+                }
+                let (
+                    Some(id),
+                    Some(result_type),
+                    Some(Operand::IdRef(image)),
+                    Some(Operand::IdRef(sampler)),
+                ) = (
+                    inst.result_id,
+                    inst.result_type,
+                    inst.operands.first(),
+                    inst.operands.get(1),
+                )
+                else {
+                    return Err("OpSampledImage has an invalid operand shape".into());
+                };
+                samples.insert(
+                    id,
+                    SampleDefinition {
+                        function,
+                        block,
+                        instruction,
+                        id,
+                        image: *image,
+                        sampler: *sampler,
+                        result_type,
+                    },
+                );
+            }
+        }
+    }
+    if samples.is_empty() {
+        return Ok(false);
+    }
+
+    let mut ordinary = HashSet::new();
+    let mut comparison = HashSet::new();
+    for function in &ctx.module.functions {
+        for inst in function.blocks.iter().flat_map(|block| &block.instructions) {
+            let sampled = match inst.operands.first() {
+                Some(Operand::IdRef(id)) => *id,
+                _ => continue,
+            };
+            if is_comparison_image_operation(inst.class.opcode) {
+                if !samples.contains_key(&sampled) {
+                    return Err(
+                        "comparison sampling consumes an aliased sampled-image value".into(),
+                    );
+                }
+                comparison.insert(sampled);
+            } else if is_ordinary_sampled_image_operation(inst.class.opcode) {
+                ordinary.insert(sampled);
+            }
+        }
+    }
+
+    let mut replacements = HashMap::new();
+    let mut insertions = HashMap::<(usize, usize, usize), Vec<Instruction>>::new();
+    let mut sample_definitions = samples.values().copied().collect::<Vec<_>>();
+    sample_definitions
+        .sort_unstable_by_key(|sample| (sample.function, sample.block, sample.instruction));
+    for sample in sample_definitions {
+        if !comparison.contains(&sample.id) {
+            continue;
+        }
+        let access = resolve_sampler_value(&defs, sample.sampler)?;
+        let mut inserted = Vec::new();
+        let sampler = build_comparison_access(
+            ctx,
+            &defs,
+            &variables,
+            &access,
+            ordinary.is_empty(),
+            &mut inserted,
+        )?;
+        let sampled = ctx.module.fresh_id();
+        inserted.push(Instruction::new(
+            Op::SampledImage,
+            Some(sample.result_type),
+            Some(sampled),
+            vec![Operand::IdRef(sample.image), Operand::IdRef(sampler)],
+        ));
+        replacements.insert(sample.id, sampled);
+        insertions
+            .entry((sample.function, sample.block, sample.instruction))
+            .or_default()
+            .extend(inserted);
+    }
+    if replacements.is_empty() {
+        return Ok(false);
+    }
+
+    for (function, body) in ctx.module.functions.iter_mut().enumerate() {
+        for (block, instructions) in body.blocks.iter_mut().enumerate() {
+            let mut rewritten = Vec::with_capacity(instructions.instructions.len());
+            for (instruction, inst) in instructions.instructions.iter().cloned().enumerate() {
+                rewritten.push(inst);
+                if let Some(extra) = insertions.remove(&(function, block, instruction)) {
+                    rewritten.extend(extra);
+                }
+            }
+            instructions.instructions = rewritten;
+        }
+    }
+    for function in &mut ctx.module.functions {
+        for inst in function
+            .blocks
+            .iter_mut()
+            .flat_map(|block| &mut block.instructions)
+        {
+            if !is_comparison_image_operation(inst.class.opcode) {
+                continue;
+            }
+            let Some(Operand::IdRef(sampled)) = inst.operands.first_mut() else {
+                continue;
+            };
+            if let Some(replacement) = replacements.get(sampled) {
+                *sampled = *replacement;
+            }
+        }
+    }
+    Ok(true)
+}
