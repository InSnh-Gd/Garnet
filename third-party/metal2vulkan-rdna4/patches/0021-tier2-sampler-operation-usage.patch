diff --git a/tests/sampler_operation_usage.rs b/tests/sampler_operation_usage.rs
new file mode 100644
index 0000000..31a6caa
--- /dev/null
+++ b/tests/sampler_operation_usage.rs
@@ -0,0 +1,221 @@
+use metal2vulkan::passes::Stage;
+use metal2vulkan::reflect::{
+    ResourceBinding, ResourceKind, SamplerCompareFunction, ShaderReflection,
+};
+
+const STATIC_NEVER: u64 = 34_901_797_601_017_929;
+const STATIC_ALWAYS: u64 = 34_901_797_600_952_393;
+
+#[derive(Clone, Copy)]
+enum SamplerSource {
+    Direct,
+    Static(u64),
+}
+
+impl SamplerSource {
+    fn operand(self) -> &'static str {
+        match self {
+            Self::Direct => "%sampler",
+            Self::Static(_) => "@__air_sampler_state",
+        }
+    }
+}
+
+fn source(sampler: SamplerSource, ordinary: bool, comparison: bool) -> String {
+    let (static_state, sampler_argument, sampler_metadata) = match sampler {
+        SamplerSource::Direct => (
+            String::new(),
+            ", ptr addrspace(2) %sampler, ",
+            r#"!5 = !{i32 2, !"air.sampler", !"air.location_index", i32 0, i32 1}"#,
+        ),
+        SamplerSource::Static(words) => (
+            format!(
+                "@__air_sampler_state = internal addrspace(2) constant [2 x i64] [i64 {words}, i64 0], align 8\n"
+            ),
+            ", ",
+            "",
+        ),
+    };
+    let (parameter_metadata, out_index, position_index, static_metadata) = match sampler {
+        SamplerSource::Direct => ("!3, !4, !5, !6, !7", 3, 4, ""),
+        SamplerSource::Static(_) => ("!3, !4, !6, !7", 2, 3, "\n!air.sampler_states = !{!8}\n!8 = !{!\"air.sampler_state\", ptr addrspace(2) @__air_sampler_state}"),
+    };
+    let ordinary_ir = if ordinary {
+        format!(
+            r#"  %ordinary = call {{ <4 x float>, i8 }} @air.sample_texture_2d.v4f32(ptr addrspace(1) %color, ptr addrspace(2) {sampler_operand}, <2 x float> <float 0.25, float 0.75>, i1 true, <2 x i32> zeroinitializer, i1 false, float 0.0, float 0.0, i32 0)
+  %ordinary4 = extractvalue {{ <4 x float>, i8 }} %ordinary, 0
+  %ordinary_value = extractelement <4 x float> %ordinary4, i32 0
+"#,
+            sampler_operand = sampler.operand()
+        )
+    } else {
+        String::new()
+    };
+    let comparison_ir = if comparison {
+        format!(
+            r#"  %comparison = call {{ float, i8 }} @air.sample_compare_depth_2d.f32(ptr addrspace(1) %depth, ptr addrspace(2) {sampler_operand}, i32 1, <2 x float> <float 0.25, float 0.75>, float 0.5, i1 true, <2 x i32> zeroinitializer, i1 true, float 0.0, float 0.0, i32 0)
+  %comparison_value = extractvalue {{ float, i8 }} %comparison, 0
+"#,
+            sampler_operand = sampler.operand()
+        )
+    } else {
+        String::new()
+    };
+    let result = match (ordinary, comparison) {
+        (true, true) => "  %result = fadd float %ordinary_value, %comparison_value\n",
+        (true, false) => "  %result = fadd float %ordinary_value, 0.0\n",
+        (false, true) => "  %result = fadd float %comparison_value, 0.0\n",
+        (false, false) => unreachable!(),
+    };
+    format!(
+        r#"target triple = "air64-apple-macosx"
+{static_state}define void @sampler_usage(ptr addrspace(1) %color, ptr addrspace(1) %depth{sampler_argument}ptr addrspace(1) %out, i32 %i) {{
+entry:
+{ordinary_ir}{comparison_ir}{result}  store float %result, ptr addrspace(1) %out, align 4
+  ret void
+}}
+declare {{ <4 x float>, i8 }} @air.sample_texture_2d.v4f32(ptr addrspace(1), ptr addrspace(2), <2 x float>, i1, <2 x i32>, i1, float, float, i32)
+declare {{ float, i8 }} @air.sample_compare_depth_2d.f32(ptr addrspace(1), ptr addrspace(2), i32, <2 x float>, float, i1, <2 x i32>, i1, float, float, i32)
+!air.kernel = !{{!0}}{static_metadata}
+!0 = !{{ptr @sampler_usage, !1, !2}}
+!1 = !{{}}
+!2 = !{{{parameter_metadata}}}
+!3 = !{{i32 0, !"air.texture", !"air.location_index", i32 0, i32 1, !"air.sample", !"air.arg_type_name", !"texture2d<float, sample>"}}
+!4 = !{{i32 1, !"air.texture", !"air.location_index", i32 1, i32 1, !"air.sample", !"air.arg_type_name", !"depth2d<float, sample>"}}
+{sampler_metadata}
+!6 = !{{i32 {out_index}, !"air.buffer", !"air.location_index", i32 0, i32 1, !"air.read_write", !"air.address_space", i32 1, !"air.arg_type_size", i32 4, !"air.arg_type_align_size", i32 4, !"air.arg_type_name", !"float*"}}
+!7 = !{{i32 {position_index}, !"air.thread_position_in_grid", !"air.arg_type_name", !"uint"}}
+"#
+    )
+}
+
+fn translate(label: &str, source: &str) -> (Vec<u8>, ShaderReflection, String) {
+    let directory = std::env::temp_dir().join(format!(
+        "metal2vulkan-sampler-usage-{}-{label}",
+        std::process::id()
+    ));
+    std::fs::create_dir_all(&directory).unwrap();
+    let (spirv, reflection) = metal2vulkan::translate_sanitized_native_reflected_unvalidated(
+        source,
+        Stage::Kernel,
+        &directory,
+        Default::default(),
+        None,
+    )
+    .unwrap_or_else(|error| panic!("{label}: {error}"));
+    reflection
+        .validate_descriptor_abi()
+        .unwrap_or_else(|error| panic!("{label}: {error}"));
+    metal2vulkan::tools::spirv_val_bytes(&spirv, &directory)
+        .unwrap_or_else(|error| panic!("{label}: {error}"));
+    let assembly = metal2vulkan::disassemble(&spirv).unwrap();
+    std::fs::remove_dir_all(directory).unwrap();
+    (spirv, reflection, assembly)
+}
+
+fn sampler(reflection: &ShaderReflection) -> &ResourceBinding {
+    reflection
+        .bindings
+        .iter()
+        .find(|binding| {
+            matches!(
+                binding.kind,
+                ResourceKind::Sampler
+                    | ResourceKind::EmbeddedArgBufferSampler
+                    | ResourceKind::StaticSampler
+            )
+        })
+        .expect("one Metal sampler")
+}
+
+fn assert_binding(assembly: &str, binding: u32, present: bool) {
+    assert_eq!(
+        assembly.contains(&format!("Binding {binding}")),
+        present,
+        "{assembly}"
+    );
+}
+
+#[test]
+fn direct_sampler_mixed_ordinary_and_comparison_keeps_both_representations() {
+    let source = source(SamplerSource::Direct, true, true);
+    let (_, reflection, assembly) = translate("direct-mixed", &source);
+    let sampler = sampler(&reflection);
+    assert_eq!(sampler.descriptor.unwrap().binding, 160);
+    assert_eq!(sampler.comparison_descriptor.unwrap().binding, 160 + 576);
+    assert!(assembly.contains("OpImageSampleExplicitLod"), "{assembly}");
+    assert!(
+        assembly.contains("OpImageSampleDrefExplicitLod"),
+        "{assembly}"
+    );
+    assert_binding(&assembly, 160, true);
+    assert_binding(&assembly, 736, true);
+}
+
+#[test]
+fn direct_comparison_only_sampler_reports_the_comparison_binding_as_primary() {
+    let source = source(SamplerSource::Direct, false, true);
+    let (_, reflection, assembly) = translate("direct-comparison", &source);
+    let sampler = sampler(&reflection);
+    assert_eq!(sampler.descriptor.unwrap().binding, 736);
+    assert!(sampler.comparison_descriptor.is_none());
+    assert!(
+        assembly.contains("OpImageSampleDrefExplicitLod"),
+        "{assembly}"
+    );
+    assert_binding(&assembly, 160, false);
+    assert_binding(&assembly, 736, true);
+}
+
+#[test]
+fn direct_ordinary_only_sampler_keeps_one_representation() {
+    let source = source(SamplerSource::Direct, true, false);
+    let (_, reflection, assembly) = translate("direct-ordinary", &source);
+    let sampler = sampler(&reflection);
+    assert_eq!(sampler.descriptor.unwrap().binding, 160);
+    assert!(sampler.comparison_descriptor.is_none());
+    assert!(assembly.contains("OpImageSampleExplicitLod"), "{assembly}");
+    assert!(
+        !assembly.contains("OpImageSampleDrefExplicitLod"),
+        "{assembly}"
+    );
+    assert_binding(&assembly, 160, true);
+    assert_binding(&assembly, 736, false);
+}
+
+#[test]
+fn constexpr_sampler_mixed_never_and_always_use_the_comparison_representation() {
+    for (compare, label) in [
+        (SamplerCompareFunction::Never, "never"),
+        (SamplerCompareFunction::Always, "always"),
+    ] {
+        let words = match compare {
+            SamplerCompareFunction::Never => STATIC_NEVER,
+            SamplerCompareFunction::Always => STATIC_ALWAYS,
+            _ => unreachable!(),
+        };
+        let source = source(SamplerSource::Static(words), true, true);
+        let (_, reflection, assembly) = translate(&format!("static-{label}"), &source);
+        let sampler = sampler(&reflection);
+        assert_eq!(sampler.static_sampler.unwrap().compare_function, compare);
+        assert_eq!(sampler.descriptor.unwrap().binding, 160);
+        assert_eq!(sampler.comparison_descriptor.unwrap().binding, 736);
+        assert_binding(&assembly, 160, true);
+        assert_binding(&assembly, 736, true);
+    }
+}
+
+#[test]
+fn constexpr_comparison_only_sampler_keeps_only_the_comparison_representation() {
+    let source = source(SamplerSource::Static(STATIC_NEVER), false, true);
+    let (_, reflection, assembly) = translate("static-comparison", &source);
+    let sampler = sampler(&reflection);
+    assert_eq!(
+        sampler.static_sampler.unwrap().compare_function,
+        SamplerCompareFunction::Never
+    );
+    assert_eq!(sampler.descriptor.unwrap().binding, 736);
+    assert!(sampler.comparison_descriptor.is_none());
+    assert_binding(&assembly, 160, false);
+    assert_binding(&assembly, 736, true);
+}
