index 0000000..ba096e0
--- /dev/null
+++ b/src/passes/resources/sampler_usage.rs
@@ -0,0 +1,540 @@
+//! Select the backend sampler representation from each image operation's use.
+//!
+//! Metal has one sampler object whose state includes a comparison function. Vulkan needs two
+//! sampler objects to keep ordinary and comparison sampling independent: one with comparison
+//! disabled, one with it enabled. The same Metal sampler can feed both kinds of operation in one
+//! shader, so the selection happens at each `OpSampledImage`, not once per source argument.
+
+use super::*;
+use spirv::Decoration;
+
+// The first six table words are `(offset, count)` pairs for sampled images, storage images,
+// and samplers. Set 4 stores the comparison representation after the normal sampler tokens.
+const GPU_SAMPLER_TOKEN_COUNT_WORD: u32 = 5;
+
+#[derive(Clone)]
+struct DescriptorVariable {
+    set: u32,
+    binding: u32,
+    pointee: Word,
+}
+
+#[derive(Clone)]
+struct PointerStep {
+    opcode: Op,
+    result_type: Word,
+    operands: Vec<Operand>,
+}
+
+#[derive(Clone)]
+struct ValueStep {
+    opcode: Op,
+    result_type: Word,
+}
+
+#[derive(Clone)]
+struct SamplerAccess {
+    variable: Word,
+    pointer_steps: Vec<PointerStep>,
+    load_type: Word,
+    value_steps: Vec<ValueStep>,
+}
+
+#[derive(Clone, Copy)]
+struct SampleDefinition {
+    function: usize,
+    block: usize,
+    instruction: usize,
+    id: Word,
+    image: Word,
+    sampler: Word,
+    result_type: Word,
+}
+
+fn is_comparison_image_operation(opcode: Op) -> bool {
+    matches!(
+        opcode,
+        Op::ImageSampleDrefImplicitLod
+            | Op::ImageSampleDrefExplicitLod
+            | Op::ImageSampleProjDrefImplicitLod
+            | Op::ImageSampleProjDrefExplicitLod
+            | Op::ImageDrefGather
+            | Op::ImageSparseSampleDrefImplicitLod
+            | Op::ImageSparseSampleDrefExplicitLod
+            | Op::ImageSparseSampleProjDrefImplicitLod
+            | Op::ImageSparseSampleProjDrefExplicitLod
+            | Op::ImageSparseDrefGather
+    )
+}
+
+fn is_ordinary_sampled_image_operation(opcode: Op) -> bool {
+    matches!(
+        opcode,
+        Op::ImageSampleImplicitLod
+            | Op::ImageSampleExplicitLod
+            | Op::ImageSampleProjImplicitLod
+            | Op::ImageSampleProjExplicitLod
+            | Op::ImageGather
+            | Op::ImageQueryLod
+            | Op::ImageSparseSampleImplicitLod
+            | Op::ImageSparseSampleExplicitLod
+            | Op::ImageSparseSampleProjImplicitLod
+            | Op::ImageSparseSampleProjExplicitLod
+            | Op::ImageSparseGather
+    )
+}
+
+fn pointee(defs: &HashMap<Word, Instruction>, pointer: Word) -> Option<Word> {
+    let pointer = defs
+        .get(&pointer)
+        .filter(|instruction| instruction.class.opcode == Op::TypePointer)?;
+    match pointer.operands.get(1) {
+        Some(Operand::IdRef(pointee)) => Some(*pointee),
+        _ => None,
+    }
+}
+
+fn descriptor_variables(
+    ctx: &Ctx,
+    defs: &HashMap<Word, Instruction>,
+) -> Result<HashMap<Word, DescriptorVariable>, String> {
+    let mut sets = HashMap::new();
+    let mut bindings = HashMap::new();
+    for annotation in &ctx.module.annotations {
+        match annotation.operands.as_slice() {
+            [Operand::IdRef(id), Operand::Decoration(Decoration::DescriptorSet), Operand::LiteralBit32(set)] =>
+            {
+                sets.insert(*id, *set);
+            }
+            [Operand::IdRef(id), Operand::Decoration(Decoration::Binding), Operand::LiteralBit32(binding)] =>
+            {
+                bindings.insert(*id, *binding);
+            }
+            _ => {}
+        }
+    }
+    let mut variables = HashMap::new();
+    for instruction in ctx
+        .module
+        .types_global_values
+        .iter()
+        .chain(ctx.new_globals.iter())
+        .filter(|instruction| instruction.class.opcode == Op::Variable)
+    {
+        let Some(variable) = instruction.result_id else {
+            continue;
+        };
+        let (Some(&set), Some(&binding)) = (sets.get(&variable), bindings.get(&variable)) else {
+            continue;
+        };
+        let Some(pointer) = instruction.result_type else {
+            continue;
+        };
+        let Some(pointee) = pointee(defs, pointer) else {
+            continue;
+        };
+        variables.insert(
+            variable,
+            DescriptorVariable {
+                set,
+                binding,
+                pointee,
+            },
+        );
+    }
+    Ok(variables)
+}
+
+fn resolve_pointer(
+    defs: &HashMap<Word, Instruction>,
+    pointer: Word,
+    steps: &mut Vec<PointerStep>,
+) -> Result<Word, String> {
+    let instruction = defs
+        .get(&pointer)
+        .ok_or_else(|| "sampler pointer has no defining instruction".to_string())?;
+    match instruction.class.opcode {
+        Op::Variable => Ok(pointer),
+        Op::AccessChain | Op::InBoundsAccessChain => {
+            let Some(Operand::IdRef(base)) = instruction.operands.first() else {
+                return Err("sampler access chain has no base".into());
+            };
+            let root = resolve_pointer(defs, *base, steps)?;
+            let result_type = instruction
+                .result_type
+                .ok_or_else(|| "sampler access chain has no result type".to_string())?;
+            steps.push(PointerStep {
+                opcode: instruction.class.opcode,
+                result_type,
+                operands: instruction.operands[1..].to_vec(),
+            });
+            Ok(root)
+        }
+        Op::CopyObject | Op::Bitcast => {
+            let Some(Operand::IdRef(base)) = instruction.operands.first() else {
+                return Err("sampler pointer copy has no source".into());
+            };
+            let root = resolve_pointer(defs, *base, steps)?;
+            let result_type = instruction
+                .result_type
+                .ok_or_else(|| "sampler pointer copy has no result type".to_string())?;
+            steps.push(PointerStep {
+                opcode: instruction.class.opcode,
+                result_type,
+                operands: Vec::new(),
+            });
+            Ok(root)
+        }
+        _ => Err(format!(
+            "comparison sampling uses an unsupported sampler pointer projection ({:?})",
+            instruction.class.opcode
+        )),
+    }
+}
+
+fn resolve_sampler_value(
+    defs: &HashMap<Word, Instruction>,
+    sampler: Word,
+) -> Result<SamplerAccess, String> {
+    let instruction = defs
+        .get(&sampler)
+        .ok_or_else(|| "sampler operand has no defining instruction".to_string())?;
+    match instruction.class.opcode {
+        Op::Load => {
+            let Some(Operand::IdRef(pointer)) = instruction.operands.first() else {
+                return Err("sampler load has no pointer".into());
+            };
+            let mut pointer_steps = Vec::new();
+            let variable = resolve_pointer(defs, *pointer, &mut pointer_steps)?;
+            Ok(SamplerAccess {
+                variable,
+                pointer_steps,
+                load_type: instruction
+                    .result_type
+                    .ok_or_else(|| "sampler load has no result type".to_string())?,
+                value_steps: Vec::new(),
+            })
+        }
+        Op::CopyObject | Op::Bitcast => {
+            let Some(Operand::IdRef(source)) = instruction.operands.first() else {
+                return Err("sampler value copy has no source".into());
+            };
+            let mut access = resolve_sampler_value(defs, *source)?;
+            access.value_steps.push(ValueStep {
+                opcode: instruction.class.opcode,
+                result_type: instruction
+                    .result_type
+                    .ok_or_else(|| "sampler value copy has no result type".to_string())?,
+            });
+            Ok(access)
+        }
+        _ => {
+            Err("comparison sampling uses a sampler value that is not a load or direct copy".into())
+        }
+    }
+}
+
+fn comparison_table(variables: &HashMap<Word, DescriptorVariable>) -> Option<Word> {
+    variables.iter().find_map(|(&variable, descriptor)| {
+        (descriptor.set == 0
+            && descriptor.binding == gpu_arguments::ARGUMENT_RESOURCE_TABLE_BINDING)
+            .then_some(variable)
+    })
+}
+
+fn rebind_descriptor_variable(ctx: &mut Ctx, variable: Word, binding: u32) -> Result<(), String> {
+    let mut found = false;
+    for annotation in &mut ctx.module.annotations {
+        if let [Operand::IdRef(id), Operand::Decoration(Decoration::Binding), value] =
+            annotation.operands.as_mut_slice()
+        {
+            if *id == variable {
+                *value = Operand::LiteralBit32(binding);
+                found = true;
+            }
+        }
+    }
+    found
+        .then_some(())
+        .ok_or_else(|| "sampler descriptor has no binding decoration".to_string())
+}
+
+fn build_comparison_access(
+    ctx: &mut Ctx,
+    defs: &HashMap<Word, Instruction>,
+    variables: &HashMap<Word, DescriptorVariable>,
+    access: &SamplerAccess,
+    reuse_ordinary_descriptor: bool,
+    out: &mut Vec<Instruction>,
+) -> Result<Word, String> {
+    let descriptor = variables.get(&access.variable).ok_or_else(|| {
+        "comparison sampling uses a sampler that is not a descriptor variable".to_string()
+    })?;
+    let is_comparison =
+        crate::reflect::COMPARISON_SAMPLER_BINDING_RANGE.contains(descriptor.binding);
+    let is_runtime_array = descriptor.set >= 2
+        && descriptor.binding == 0
+        && defs
+            .get(&descriptor.pointee)
+            .is_some_and(|ty| ty.class.opcode == Op::TypeRuntimeArray)
+        && defs
+            .get(&descriptor.pointee)
+            .and_then(|ty| ty.operands.first())
+            .is_some_and(|operand| {
+                matches!(operand, Operand::IdRef(id)
+                    if defs.get(id).is_some_and(|ty| ty.class.opcode == Op::TypeSampler))
+            });
+
+    let (root, comparison_index) = if is_comparison {
+        (access.variable, None)
+    } else if is_runtime_array {
+        let table = comparison_table(variables)
+            .ok_or_else(|| "GPU sampler array has no argument resource table".to_string())?;
+        let uint = ctx.ty_uint();
+        let word_pointer = ctx.ty_ptr(StorageClass::StorageBuffer, uint);
+        let zero = ctx.const_uint(0);
+        let sampler_count_word = ctx.const_uint(GPU_SAMPLER_TOKEN_COUNT_WORD);
+        let token_count = gpu_arguments::load_word(
+            ctx,
+            out,
+            table,
+            word_pointer,
+            uint,
+            zero,
+            sampler_count_word,
+        );
+        (access.variable, Some(token_count))
+    } else if crate::reflect::SAMPLER_BINDING_RANGE.contains(descriptor.binding) {
+        if descriptor.set != ctx.descriptor_layout.set {
+            return Err(format!(
+                "sampler at set {} does not match the stage descriptor set {}",
+                descriptor.set, ctx.descriptor_layout.set
+            ));
+        }
+        let binding = descriptor
+            .binding
+            .checked_add(crate::reflect::COMPARISON_SAMPLER_BINDING_OFFSET)
+            .ok_or_else(|| "comparison sampler binding overflow".to_string())?;
+        let variable = if reuse_ordinary_descriptor {
+            rebind_descriptor_variable(ctx, access.variable, binding)?;
+            access.variable
+        } else {
+            let existing = variables.iter().find_map(|(&variable, candidate)| {
+                (candidate.set == descriptor.set
+                    && candidate.binding == binding
+                    && candidate.pointee == descriptor.pointee)
+                    .then_some(variable)
+            });
+            match existing {
+                Some(variable) => variable,
+                None => ctx.descriptor_variable(descriptor.pointee, binding),
+            }
+        };
+        (variable, None)
+    } else {
+        return Err(format!(
+            "comparison sampling uses sampler binding {} outside the ordinary and comparison bands",
+            descriptor.binding
+        ));
+    };
+
+    let mut pointer = root;
+    for (index, step) in access.pointer_steps.iter().enumerate() {
