+                ordinary_binding.saturating_add(COMPARISON_SAMPLER_BINDING_OFFSET);
+            let has_ordinary = declared.contains(&(primary.set, ordinary_binding));
+            let has_comparison = declared.contains(&(primary.set, comparison_binding));
+            resource.comparison_descriptor = None;
+            match (has_ordinary, has_comparison) {
+                (true, true) => {
+                    primary.binding = ordinary_binding;
+                    resource.descriptor = Some(primary);
+                    resource.comparison_descriptor = Some(DescriptorLocation {
+                        binding: comparison_binding,
+                        ..primary
+                    });
+                }
+                (false, true) => {
+                    primary.binding = comparison_binding;
+                    resource.descriptor = Some(primary);
+                }
+                (true, false) => {
+                    primary.binding = ordinary_binding;
+                    resource.descriptor = Some(primary);
+                }
+                (false, false) => {}
+            }
+        }
+    }
