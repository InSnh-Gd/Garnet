+/// Resolve direct external symbol declarations (`MTLDynamicLibrary` / `preloadedLibraries` /
+/// `binaryFunctions`) across compute, vertex, and fragment stages, validating every declaration
+/// signature against its provider definition and transitively linking library dependencies.
+pub fn link_dynamic_libraries(
+    entry_ll: &str,
+    linkage: &LinkedFunctionLinkage,
+) -> Result<String, String> {
+    let initial_refs = external_symbol_references(entry_ll)?;
+    if initial_refs.is_empty() {
+        return Ok(entry_ll.to_string());
+    }
+    validate_linkage(linkage)?;
+
+    // Map exported symbol -> (provider_name, module_ll). Track conflicting definitions across libraries.
+    let mut providers = HashMap::<String, (&str, &str)>::new();
+    let mut conflicts = HashMap::<String, (String, String)>::new();
+    for reference in &linkage.visible_references {
+        providers.insert(
+            reference.symbol.clone(),
+            ("linked_function", reference.module_ll.as_str()),
+        );
+    }
+    for library in &linkage.dynamic_libraries {
+        for symbol in exported_symbols(&library.module_ll)? {
+            if let Some(&(prev_name, prev_ll)) = providers.get(&symbol) {
+                if prev_ll != library.module_ll {
+                    conflicts.insert(symbol, (prev_name.to_string(), library.name.clone()));
+                }
+            } else {
+                providers.insert(symbol, (library.name.as_str(), library.module_ll.as_str()));
+            }
+        }
+    }
+
+    let mut output = entry_ll.to_string();
+    let mut defined_symbols: HashSet<String> = function_signatures(&output)?
+        .into_keys()
+        .map(|g| decode_llvm_global(&g))
+        .collect::<Result<HashSet<_>, _>>()?;
+    let mut appended_modules = HashSet::<&str>::new();
+    let mut resolved_globals = HashSet::<String>::new();
+    let mut pending_symbols: Vec<(String, Option<(crate::native::ir::LlType, Vec<crate::native::ir::LlType>)>)> = {
+        let decl_sigs = parse_declaration_signatures(entry_ll)?;
+        initial_refs
+            .into_iter()
+            .map(|sym| {
+                let sig = decl_sigs.get(&sym).cloned();
+                (sym, sig)
+            })
+            .collect()
+    };
+
+    while let Some((symbol, expected_sig)) = pending_symbols.pop() {
+        if let Some((first, second)) = conflicts.get(&symbol) {
+            return Err(format!(
+                "dynamic library symbol {symbol:?} is exported by multiple libraries ({first:?} and {second:?})"
+            ));
+        }
+        if defined_symbols.contains(&symbol) {
+            if let Some((exp_ret, exp_params)) = expected_sig {
+                let (act_ret, act_params) = parse_definition_signature(&output, &symbol)?;
+                if exp_ret != act_ret || exp_params != act_params {
+                    return Err(format_signature_mismatch(
+                        &symbol,
+                        &exp_ret,
+                        &exp_params,
+                        &act_ret,
+                        &act_params,
+                    ));
+                }
+            }
+            resolved_globals.insert(llvm_global(&symbol)?);
+            continue;
+        }
+        let Some(&(_provider_name, provider_ll)) = providers.get(&symbol) else {
+            return Err(format!(
+                "unresolved external dynamic library symbol {symbol:?}"
+            ));
+        };
+        let (act_ret, act_params) = parse_definition_signature(provider_ll, &symbol)?;
+        if let Some((exp_ret, exp_params)) = expected_sig {
+            if exp_ret != act_ret || exp_params != act_params {
+                return Err(format_signature_mismatch(
+                    &symbol,
+                    &exp_ret,
+                    &exp_params,
+                    &act_ret,
+                    &act_params,
+                ));
+            }
+        }
+        resolved_globals.insert(llvm_global(&symbol)?);
+        if appended_modules.insert(provider_ll) {
+            // Resolve any `.MTL_VISIBLE_FN_REF` references inside the dynamic library first.
+            let lib_ll = if provider_ll.contains(".MTL_VISIBLE_FN_REF")
+                || provider_ll.contains("!air.visible_function_references")
+            {
+                specialize_visible_function_references(provider_ll, linkage)?
+            } else {
+                provider_ll.to_string()
+            };
+            let lib_ext = external_symbol_references(&lib_ll)?;
+            let lib_decls = parse_declaration_signatures(&lib_ll)?;
+            for dep_sym in lib_ext {
+                let sig = lib_decls.get(&dep_sym).cloned();
+                pending_symbols.push((dep_sym, sig));
+            }
+            for exported in exported_symbols(&lib_ll)? {
+                defined_symbols.insert(exported);
+            }
+            defined_symbols.insert(symbol);
+            append_dependency_module(&mut output, &lib_ll)?;
+        }
+    }
+
+    if !resolved_globals.is_empty() {
+        output = strip_resolved_declarations(&output, &resolved_globals);
+        output = crate::native::inline_direct_function_pointer_consumers(&output, &resolved_globals);
+    }
+    Ok(output)
+}
