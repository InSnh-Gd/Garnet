+    #[test]
+    fn exported_symbols_lists_non_internal_definitions_and_rejects_duplicates() {
+        let lib = r#"
+define internal i32 @priv_helper(i32 %x) {
+entry:
+  ret i32 %x
+}
+define dso_local i32 @add_bias(i32 %x) {
+entry:
+  %h = call i32 @priv_helper(i32 %x)
+  %y = add i32 %h, 7
+  ret i32 %y
+}
+define <4 x float> @"shade::tint"(<4 x float> %c) {
+entry:
+  ret <4 x float> %c
+}
+"#;
+        assert_eq!(
+            exported_symbols(lib).unwrap(),
+            vec!["add_bias".to_string(), "shade::tint".to_string()]
+        );
+
+        let dup = "define i32 @f(i32 %x) {\n  ret i32 %x\n}\ndefine i32 @f(i32 %x) {\n  ret i32 %x\n}\n";
+        let err = exported_symbols(dup).unwrap_err();
+        assert!(err.contains("duplicate function definition"), "{err}");
+    }
