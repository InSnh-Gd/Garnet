+fn is_compiler_intrinsic_symbol(symbol: &str) -> bool {
+    symbol.starts_with("air.") || symbol.starts_with("llvm.")
+}
+
+fn decode_llvm_global(global: &str) -> Result<String, String> {
+    let raw = global
+        .strip_prefix('@')
+        .ok_or_else(|| format!("malformed LLVM global {global:?}"))?;
+    if let Some(quoted) = raw.strip_prefix('"').and_then(|s| s.strip_suffix('"')) {
+        decode_llvm_string(quoted)
+    } else {
+        Ok(raw.to_string())
+    }
+}
+
+fn declaration_global(line: &str) -> Option<(&str, usize)> {
+    let trimmed = line.trim_start();
+    if !trimmed.starts_with("declare ") {
+        return None;
+    }
+    let at = trimmed.find('@')?;
+    global_token(trimmed, at)
+}
+
+fn parse_declaration_signatures(
+    module: &str,
+) -> Result<HashMap<String, (crate::native::ir::LlType, Vec<crate::native::ir::LlType>)>, String> {
+    let mut sigs = HashMap::new();
+    for line in module.lines() {
+        let trimmed = line.trim_start();
+        if !trimmed.starts_with("declare ") {
+            continue;
+        }
+        let Some((global, open)) = declaration_global(trimmed) else {
+            continue;
+        };
+        let Some(close) = matching_paren(trimmed, open) else {
+            continue;
+        };
+        let symbol = decode_llvm_global(global)?;
+        if is_compiler_intrinsic_symbol(&symbol) {
+            continue;
+        }
+        let at = trimmed.find(global).unwrap_or(0);
+        let ret = crate::native::parse_llvm_return_type(&trimmed["declare".len()..at])?;
+        let params_text = trimmed[open + 1..close].trim();
+        let params = if params_text.is_empty() {
+            Vec::new()
+        } else {
+            split_top_level(params_text, ',')
+                .into_iter()
+                .map(crate::native::parse_llvm_type_prefix)
+                .collect::<Result<Vec<_>, _>>()?
+        };
+        sigs.insert(symbol, (ret, params));
+    }
+    Ok(sigs)
+}
+
+fn parse_definition_signature(
+    module: &str,
+    symbol: &str,
+) -> Result<(crate::native::ir::LlType, Vec<crate::native::ir::LlType>), String> {
+    let global = llvm_global(symbol)?;
+    let mut signature = String::new();
+    let mut collecting = false;
+    for line in module.lines() {
+        let trimmed = line.trim_start();
+        if !collecting && trimmed.starts_with("define ") && trimmed.contains(&format!("{global}("))
+        {
+            collecting = true;
+        }
+        if collecting {
+            signature.push_str(trimmed);
+            signature.push(' ');
+            if trimmed.contains('{') {
+                break;
+            }
+        }
+    }
+    if signature.is_empty() {
+        return Err(format!(
+            "linked module does not define authored function {symbol:?}"
+        ));
+    }
+    let at = signature
+        .find(&global)
+        .ok_or_else(|| format!("linked function {symbol:?} has no global"))?;
+    let open = signature[at + global.len()..]
+        .find('(')
+        .map(|offset| offset + at + global.len())
+        .ok_or_else(|| format!("linked function {symbol:?} has no parameters"))?;
+    let close = matching_paren(&signature, open)
+        .ok_or_else(|| format!("linked function {symbol:?} has unterminated parameters"))?;
+    let ret = crate::native::parse_llvm_return_type(&signature[..at])?;
+    let params = if signature[open + 1..close].trim().is_empty() {
+        Vec::new()
+    } else {
+        split_top_level(&signature[open + 1..close], ',')
+            .into_iter()
+            .map(crate::native::parse_llvm_type_prefix)
+            .collect::<Result<Vec<_>, _>>()?
+    };
+    Ok((ret, params))
+}
+
+fn format_signature_mismatch(
+    symbol: &str,
+    exp_ret: &crate::native::ir::LlType,
+    exp_params: &[crate::native::ir::LlType],
+    act_ret: &crate::native::ir::LlType,
+    act_params: &[crate::native::ir::LlType],
+) -> String {
+    format!(
+        "signature mismatch for linked symbol {symbol:?}: expected ({exp_params:?}) -> {exp_ret:?}, defined ({act_params:?}) -> {act_ret:?}"
+    )
+}
+
+fn strip_resolved_declarations(module: &str, resolved_globals: &HashSet<String>) -> String {
+    let mut out = String::with_capacity(module.len());
+    for line in module.lines() {
+        if let Some((global, _)) = declaration_global(line) {
+            if resolved_globals.contains(global) {
+                continue;
+            }
+        }
+        out.push_str(line);
+        out.push('\n');
+    }
+    out
+}
