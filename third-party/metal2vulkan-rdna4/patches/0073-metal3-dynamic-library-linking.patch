+    #[test]
+    fn dynamic_library_rejects_missing_mismatched_and_conflicting_symbols() {
+        let entry = r#"
+define void @main(ptr addrspace(1) %out) {
+entry:
+  %v = call i32 @ext_op(i32 7)
+  store i32 %v, ptr addrspace(1) %out, align 4
+  ret void
+}
+declare i32 @ext_op(i32) section "air.externally_defined"
+!air.kernel = !{!0}
+!0 = !{ptr @main, !1, !2}
+!1 = !{}
+!2 = !{!3}
+!3 = !{i32 0, !"air.buffer", !"air.location_index", i32 0, i32 1, !"air.write", !"air.arg_type_name", !"uint"}
+"#;
+        // Missing symbol
+        let err = link_dynamic_libraries(entry, &LinkedFunctionLinkage::default()).unwrap_err();
+        assert!(err.contains("unresolved external dynamic library symbol"), "{err}");
+        assert!(err.contains("ext_op"), "{err}");
+
+        // Signature mismatch (return type)
+        let bad_ret = LinkedFunctionLinkage {
+            dynamic_libraries: vec![DynamicLibraryModule {
+                name: "bad.metallib".into(),
+                module_ll: "define float @ext_op(i32 %x) {\n  ret float 1.0\n}\n".into(),
+            }],
+            ..Default::default()
+        };
+        let err = link_dynamic_libraries(entry, &bad_ret).unwrap_err();
+        assert!(err.contains("signature mismatch"), "{err}");
+        assert!(err.contains("ext_op"), "{err}");
+
+        // Signature mismatch (parameter arity/type)
+        let bad_arg = LinkedFunctionLinkage {
+            dynamic_libraries: vec![DynamicLibraryModule {
+                name: "bad.metallib".into(),
+                module_ll: "define i32 @ext_op(i32 %x, i32 %y) {\n  %z = add i32 %x, %y\n  ret i32 %z\n}\n".into(),
+            }],
+            ..Default::default()
+        };
+        let err = link_dynamic_libraries(entry, &bad_arg).unwrap_err();
+        assert!(err.contains("signature mismatch"), "{err}");
+
+        // Signature mismatch on direct visible reference stub
+        let vis_entry = r#"
+define void @main() {
+entry:
+  %v = call i32 @foo.MTL_VISIBLE_FN_REF(i32 1)
+  ret void
+}
+declare i32 @foo.MTL_VISIBLE_FN_REF(i32) section "air.externally_defined"
+!air.visible_function_references = !{!0}
+!0 = !{!"air.visible_function_reference", ptr @foo.MTL_VISIBLE_FN_REF, !"foo"}
+"#;
+        let bad_vis = LinkedFunctionLinkage {
+            visible_references: vec![LinkedFunctionReference {
+                symbol: "foo".into(),
+                module_ll: "define float @foo(float %x) {\n  ret float %x\n}\n".into(),
+            }],
+            ..Default::default()
+        };
+        let err = specialize_visible_function_references(vis_entry, &bad_vis).unwrap_err();
+        assert!(err.contains("signature mismatch"), "{err}");
+
+        // Conflicting exports across two dynamic libraries
+        let conflict = LinkedFunctionLinkage {
+            dynamic_libraries: vec![
+                DynamicLibraryModule {
+                    name: "lib1".into(),
+                    module_ll: "define i32 @ext_op(i32 %x) {\n  %y = add i32 %x, 1\n  ret i32 %y\n}\n".into(),
+                },
+                DynamicLibraryModule {
+                    name: "lib2".into(),
+                    module_ll: "define i32 @ext_op(i32 %x) {\n  %y = add i32 %x, 2\n  ret i32 %y\n}\n".into(),
+                },
+            ],
+            ..Default::default()
+        };
+        let err = link_dynamic_libraries(entry, &conflict).unwrap_err();
+        assert!(err.contains("exported by multiple libraries"), "{err}");
+    }
