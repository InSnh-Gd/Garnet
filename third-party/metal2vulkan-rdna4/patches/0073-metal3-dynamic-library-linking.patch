+/// Enumerate all exported (non-`internal`, non-`private`, non-intrinsic) defined function symbols
+/// in an AIR LLVM-IR module, in deterministic source order.
+pub fn exported_symbols(module_ll: &str) -> Result<Vec<String>, String> {
+    let mut symbols = Vec::new();
+    let mut seen = HashSet::new();
+    let mut signature = String::new();
+    let mut collecting = false;
+    for line in module_ll.lines() {
+        let trimmed = line.trim_start();
+        if !collecting && trimmed.starts_with("define ") {
+            collecting = true;
+            signature.clear();
+        }
+        if collecting {
+            signature.push_str(trimmed);
+            signature.push(' ');
+            if trimmed.contains('{') {
+                collecting = false;
+                let global = definition_global(&signature).ok_or_else(|| {
+                    format!("dynamic library function definition has no global: {signature}")
+                })?;
+                let symbol = decode_llvm_global(&global)?;
+                let at = signature.find(&global).unwrap_or(0);
+                let prefix_tokens: Vec<&str> = signature[..at].split_whitespace().collect();
+                let is_private = prefix_tokens
+                    .iter()
+                    .any(|tok| matches!(*tok, "internal" | "private"));
+                if !seen.insert(symbol.clone()) {
+                    return Err(format!(
+                        "dynamic library module contains duplicate function definition {symbol:?}"
+                    ));
+                }
+                if !is_private && !is_compiler_intrinsic_symbol(&symbol) {
+                    symbols.push(symbol);
+                }
+            }
+        }
+    }
+    if collecting {
+        return Err("dynamic library module has an unterminated function definition header".into());
+    }
+    Ok(symbols)
+}
