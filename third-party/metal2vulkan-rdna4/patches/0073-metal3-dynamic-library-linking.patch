+/// Enumerate external non-intrinsic function symbols declared and referenced in `module_ll`.
+pub fn external_symbol_references(module_ll: &str) -> Result<Vec<String>, String> {
+    let defined: HashSet<String> = function_signatures(module_ll)?
+        .into_keys()
+        .collect();
+    let mut body_text = String::new();
+    let mut in_body = false;
+    let mut declared = Vec::<(String, String)>::new();
+    let mut seen_decl = HashSet::new();
+    for line in module_ll.lines() {
+        let trimmed = line.trim_start();
+        if trimmed.starts_with("define ") {
+            in_body = !trimmed.ends_with('}');
+            continue;
+        }
+        if trimmed == "}" {
+            in_body = false;
+            continue;
+        }
+        if in_body {
+            body_text.push_str(line);
+            body_text.push('\n');
+            continue;
+        }
+        if trimmed.starts_with("declare ") {
+            if let Some((global, _)) = declaration_global(trimmed) {
+                let symbol = decode_llvm_global(global)?;
+                if !defined.contains(global)
+                    && !is_compiler_intrinsic_symbol(&symbol)
+                    && !symbol.ends_with(".MTL_VISIBLE_FN_REF")
+                    && !symbol.ends_with(".MTL_CONTROL_POINT_FN")
+                    && seen_decl.insert(symbol.clone())
+                {
+                    declared.push((global.to_string(), symbol));
+                }
+            }
+        }
+    }
+    let mut referenced = Vec::new();
+    for (global, symbol) in declared {
+        if contains_llvm_value(&body_text, &global) {
+            referenced.push(symbol);
+        }
+    }
+    Ok(referenced)
+}
