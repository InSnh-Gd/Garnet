+        self.module.types_global_values.push(Instruction::new(
+            Op::TypePointer,
+            None,
+            Some(id),
+            vec![Operand::StorageClass(sc), Operand::IdRef(pointee)],
+        ));
+        self.ptrs.insert((sc, pointee), id);
+        id
+    }
