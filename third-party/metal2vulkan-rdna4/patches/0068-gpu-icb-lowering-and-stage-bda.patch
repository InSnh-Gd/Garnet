new file mode 100644
index 0000000..bbf2dbc
--- /dev/null
+++ b/src/passes/icb_stage.rs
@@ -0,0 +1,2989 @@
+//! ICB stage SPIR-V lowering: converts stage StorageBuffer bindings (0..30 / 704..734 and
+//! synthetic buffer-address tables) into PhysicalStorageBuffer64 reads from dynamic SSBO binding
+//! 676 (`rdna4_buffer_table`), and for Vertex stages (`stage_kind == 0`) lowers `BuiltIn
+//! VertexIndex` (including indexed-draw lookup, baseVertex, primitive-restart NaN guard) and all
+//! `Input Location L` variables to BDA fetches from dynamic SSBO binding 677 (`rdna4_icb_vs_params_t`).
+
+use crate::spirv_module::{Block, Function, Instruction, Module, Operand};
+use spirv::{
+    AddressingModel, BuiltIn, Capability, Decoration, FunctionControl, MemoryAccess, MemoryModel,
+    Op, SelectionControl, StorageClass, Word,
+};
+use std::collections::{HashMap, HashSet};
+
+pub const RDNA4_ICB_TABLE_BINDING: u32 = 676;
+pub const RDNA4_ICB_VS_PARAMS_BINDING: u32 = 677;
+pub const RDNA4_ICB_PRIM_LINE_STRIP: u32 = 2;
+pub const RDNA4_ICB_PRIM_TRIANGLE_STRIP: u32 = 4;
+
+#[repr(C)]
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct IcbVertexAttr {
+    pub location: u32,
+    pub buffer_index: u32,
+    pub offset: u32,
+    pub stride: u32,
+    pub vfmt: u8,
+    pub step_func: u8, // 0 = Constant, 1 = PerVertex, 2 = PerInstance
+    pub pad: [u8; 2],
+    pub step_rate: u32,
+}
+
+#[derive(Clone, Copy)]
+enum ScalarKind {
+    U32,
+    S32,
+    F32,
+    F16,
+    U16,
+    S16,
+}
+
+struct SpirvBuilder<'a> {
+    module: &'a mut Module,
+    glsl_ext: Option<Word>,
+    t_void: Option<Word>,
+    t_bool: Option<Word>,
+    t_u32: Option<Word>,
+    t_i32: Option<Word>,
+    t_u64: Option<Word>,
+    t_f32: Option<Word>,
+    t_f16: Option<Word>,
+    t_u16: Option<Word>,
+    t_i16: Option<Word>,
+    t_v2u32: Option<Word>,
+    t_v4f32: Option<Word>,
+    ptrs: HashMap<(StorageClass, Word), Word>,
+    u32_consts: HashMap<u32, Word>,
+    u64_consts: HashMap<u64, Word>,
+    f32_consts: HashMap<u32, Word>,
+    c_false: Option<Word>,
+}
+
+impl<'a> SpirvBuilder<'a> {
+    fn new(module: &'a mut Module) -> Self {
+        let mut s = Self {
+            module,
+            glsl_ext: None,
+            t_void: None,
+            t_bool: None,
+            t_u32: None,
+            t_i32: None,
+            t_u64: None,
+            t_f32: None,
+            t_f16: None,
+            t_u16: None,
+            t_i16: None,
+            t_v2u32: None,
+            t_v4f32: None,
+            ptrs: HashMap::new(),
+            u32_consts: HashMap::new(),
+            u64_consts: HashMap::new(),
+            f32_consts: HashMap::new(),
+            c_false: None,
+        };
+        s.seed_existing();
+        s
+    }
+
+    fn seed_existing(&mut self) {
+        for inst in &self.module.ext_inst_imports {
+            if let (Some(id), [Operand::LiteralString(name)]) =
+                (inst.result_id, inst.operands.as_slice())
+            {
+                if name == "GLSL.std.450" {
+                    self.glsl_ext = Some(id);
+                }
+            }
+        }
+        for inst in &self.module.types_global_values {
+            let Some(id) = inst.result_id else { continue };
+            match inst.class.opcode {
+                Op::TypeVoid => {
+                    self.t_void.get_or_insert(id);
+                }
+                Op::TypeBool => {
+                    self.t_bool.get_or_insert(id);
+                }
+                Op::TypeInt => {
+                    if let [Operand::LiteralBit32(w), Operand::LiteralBit32(sgn)] =
+                        inst.operands.as_slice()
+                    {
+                        match (*w, *sgn) {
+                            (32, 0) => {
+                                self.t_u32.get_or_insert(id);
+                            }
+                            (32, 1) => {
+                                self.t_i32.get_or_insert(id);
+                            }
+                            (64, 0) => {
+                                self.t_u64.get_or_insert(id);
+                            }
+                            (16, 0) => {
+                                self.t_u16.get_or_insert(id);
+                            }
+                            (16, 1) => {
+                                self.t_i16.get_or_insert(id);
+                            }
+                            _ => {}
+                        }
+                    }
+                }
+                Op::TypeFloat => {
+                    if let [Operand::LiteralBit32(w)] = inst.operands.as_slice() {
+                        match *w {
+                            32 => {
+                                self.t_f32.get_or_insert(id);
+                            }
+                            16 => {
+                                self.t_f16.get_or_insert(id);
+                            }
+                            _ => {}
+                        }
+                    }
+                }
+                Op::TypeVector => {
+                    if let [Operand::IdRef(elem), Operand::LiteralBit32(n)] =
+                        inst.operands.as_slice()
+                    {
+                        if Some(*elem) == self.t_u32 && *n == 2 {
+                            self.t_v2u32.get_or_insert(id);
+                        }
+                        if Some(*elem) == self.t_f32 && *n == 4 {
+                            self.t_v4f32.get_or_insert(id);
+                        }
+                    }
+                }
+                Op::TypePointer => {
+                    if let [Operand::StorageClass(sc), Operand::IdRef(pt)] =
+                        inst.operands.as_slice()
+                    {
+                        self.ptrs.entry((*sc, *pt)).or_insert(id);
+                    }
+                }
+                Op::ConstantFalse => {
+                    self.c_false.get_or_insert(id);
+                }
+                Op::Constant => {
+                    if let Some(ty) = inst.result_type {
+                        if Some(ty) == self.t_u32 {
+                            if let [Operand::LiteralBit32(v)] = inst.operands.as_slice() {
+                                self.u32_consts.entry(*v).or_insert(id);
+                            }
+                        } else if Some(ty) == self.t_u64 {
+                            if let [Operand::LiteralBit64(v)] = inst.operands.as_slice() {
+                                self.u64_consts.entry(*v).or_insert(id);
+                            }
+                        } else if Some(ty) == self.t_f32 {
+                            if let [Operand::LiteralBit32(v)] = inst.operands.as_slice() {
+                                self.f32_consts.entry(*v).or_insert(id);
+                            }
+                        }
+                    }
+                }
+                _ => {}
+            }
+        }
+    }
+
+    fn require_capability(&mut self, cap: Capability) {
+        if !self.module.capabilities.iter().any(|i| {
+            matches!(i.operands.as_slice(), [Operand::Capability(c)] if *c == cap)
+        }) {
+            self.module.capabilities.push(Instruction::new(
+                Op::Capability,
+                None,
+                None,
+                vec![Operand::Capability(cap)],
+            ));
+        }
+    }
+
+    fn ensure_glsl(&mut self) -> Word {
+        if let Some(id) = self.glsl_ext {
+            return id;
+        }
+        let id = self.module.fresh_id();
+        self.module.ext_inst_imports.push(Instruction::new(
+            Op::ExtInstImport,
+            None,
+            Some(id),
+            vec![Operand::LiteralString("GLSL.std.450".to_string())],
+        ));
+        self.glsl_ext = Some(id);
+        id
+    }
+
+    fn ty_bool(&mut self) -> Word {
+        if let Some(id) = self.t_bool {
+            return id;
+        }
+        let id = self.module.fresh_id();
+        self.module
+            .types_global_values
+            .push(Instruction::new(Op::TypeBool, None, Some(id), vec![]));
+        self.t_bool = Some(id);
+        id
+    }
+
+    fn ty_u32(&mut self) -> Word {
+        if let Some(id) = self.t_u32 {
+            return id;
+        }
+        let id = self.module.fresh_id();
+        self.module.types_global_values.push(Instruction::new(
+            Op::TypeInt,
+            None,
+            Some(id),
+            vec![Operand::LiteralBit32(32), Operand::LiteralBit32(0)],
+        ));
+        self.t_u32 = Some(id);
+        id
+    }
+
+    fn ty_i32(&mut self) -> Word {
+        if let Some(id) = self.t_i32 {
+            return id;
+        }
+        let id = self.module.fresh_id();
+        self.module.types_global_values.push(Instruction::new(
+            Op::TypeInt,
+            None,
+            Some(id),
+            vec![Operand::LiteralBit32(32), Operand::LiteralBit32(1)],
+        ));
+        self.t_i32 = Some(id);
+        id
+    }
+
+    fn ty_u64(&mut self) -> Word {
+        if let Some(id) = self.t_u64 {
+            return id;
+        }
+        self.require_capability(Capability::Int64);
+        let id = self.module.fresh_id();
+        self.module.types_global_values.push(Instruction::new(
+            Op::TypeInt,
+            None,
+            Some(id),
+            vec![Operand::LiteralBit32(64), Operand::LiteralBit32(0)],
