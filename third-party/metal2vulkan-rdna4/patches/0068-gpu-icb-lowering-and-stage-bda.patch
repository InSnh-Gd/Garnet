+            b.op(out, Op::Load, u32_ty, vec![Operand::IdRef(ac)])
+        };
+        let load_vp_i32 = |b: &mut SpirvBuilder<'_>, out: &mut Vec<Instruction>, m: Word| -> Word {
+            let ac = b.op(
+                out,
+                Op::AccessChain,
+                p_sb_i32,
+                vec![Operand::IdRef(vpv), Operand::IdRef(m)],
+            );
+            b.op(out, Op::Load, i32_ty, vec![Operand::IdRef(ac)])
+        };
+        let load_vp_u64 = |b: &mut SpirvBuilder<'_>, out: &mut Vec<Instruction>, m: Word| -> Word {
+            let ac = b.op(
+                out,
+                Op::AccessChain,
+                p_sb_u64,
+                vec![Operand::IdRef(vpv), Operand::IdRef(m)],
+            );
+            b.op(out, Op::Load, u64_ty, vec![Operand::IdRef(ac)])
+        };
+
+        let raw_vtx_loaded = b.op(
+            &mut prologue,
+            Op::Load,
+            if vtx_is_signed { i32_ty } else { u32_ty },
+            vec![Operand::IdRef(vvar)],
+        );
+        let raw_vid = if vtx_is_signed {
+            b.op(
+                &mut prologue,
+                Op::Bitcast,
+                u32_ty,
+                vec![Operand::IdRef(raw_vtx_loaded)],
+            )
+        } else {
+            raw_vtx_loaded
+        };
+
+        let kind = load_vp_u32(&mut b, &mut prologue, c0_u32);
+        let itype = load_vp_u32(&mut b, &mut prologue, c1_u32);
+        let bvert = load_vp_i32(&mut b, &mut prologue, c2_u32);
+        let prim = load_vp_u32(&mut b, &mut prologue, c3_u32);
+        let ibda = load_vp_u64(&mut b, &mut prologue, c4_u32);
+
+        let is_indexed = b.op(
+            &mut prologue,
+            Op::IEqual,
+            bool_ty,
+            vec![Operand::IdRef(kind), Operand::IdRef(c2_u32)],
+        );
+        let is_u16 = b.op(
+            &mut prologue,
+            Op::IEqual,
+            bool_ty,
+            vec![Operand::IdRef(itype), Operand::IdRef(c0_u32)],
+        );
+        let raw_vid64 = b.op(&mut prologue, Op::UConvert, u64_ty, vec![Operand::IdRef(raw_vid)]);
+        let esize64 = b.op(
+            &mut prologue,
+            Op::Select,
+            u64_ty,
+            vec![
+                Operand::IdRef(is_u16),
+                Operand::IdRef(c2_64),
+                Operand::IdRef(c4_64),
+            ],
+        );
+        let ib_off = b.op(
+            &mut prologue,
+            Op::IMul,
+            u64_ty,
+            vec![Operand::IdRef(raw_vid64), Operand::IdRef(esize64)],
+        );
+        let esize32 = b.op(
+            &mut prologue,
+            Op::Select,
+            u32_ty,
+            vec![
+                Operand::IdRef(is_u16),
+                Operand::IdRef(c2_u32),
+                Operand::IdRef(c4_u32),
+            ],
+        );
+        let raw_idx = b.op(
+            &mut prologue,
+            Op::FunctionCall,
+            u32_ty,
+            vec![
+                Operand::IdRef(l32),
+                Operand::IdRef(ibda),
+                Operand::IdRef(ib_off),
+                Operand::IdRef(esize32),
+            ],
+        );
+        let c_ls = b.const_u32(RDNA4_ICB_PRIM_LINE_STRIP);
+        let c_ts = b.const_u32(RDNA4_ICB_PRIM_TRIANGLE_STRIP);
+        let is_ls = b.op(
+            &mut prologue,
+            Op::IEqual,
+            bool_ty,
+            vec![Operand::IdRef(prim), Operand::IdRef(c_ls)],
+        );
+        let is_ts = b.op(
+            &mut prologue,
+            Op::IEqual,
+            bool_ty,
+            vec![Operand::IdRef(prim), Operand::IdRef(c_ts)],
+        );
+        let is_strip = b.op(
+            &mut prologue,
+            Op::LogicalOr,
+            bool_ty,
+            vec![Operand::IdRef(is_ls), Operand::IdRef(is_ts)],
+        );
+        let sent = b.op(
+            &mut prologue,
+            Op::Select,
+            u32_ty,
+            vec![
+                Operand::IdRef(is_u16),
+                Operand::IdRef(c_ffff),
+                Operand::IdRef(c_ffffffff),
+            ],
+        );
+        let eq_sent = b.op(
+            &mut prologue,
+            Op::IEqual,
+            bool_ty,
+            vec![Operand::IdRef(raw_idx), Operand::IdRef(sent)],
+        );
+        let r0 = b.op(
+            &mut prologue,
+            Op::LogicalAnd,
+            bool_ty,
+            vec![Operand::IdRef(is_indexed), Operand::IdRef(is_strip)],
+        );
+        let is_restart = b.op(
+            &mut prologue,
+            Op::LogicalAnd,
+            bool_ty,
+            vec![Operand::IdRef(r0), Operand::IdRef(eq_sent)],
+        );
+
+        let raw_idx_s = b.op(&mut prologue, Op::Bitcast, i32_ty, vec![Operand::IdRef(raw_idx)]);
+        let sum_s = b.op(
+            &mut prologue,
+            Op::IAdd,
+            i32_ty,
+            vec![Operand::IdRef(raw_idx_s), Operand::IdRef(bvert)],
+        );
+        let sum_u = b.op(&mut prologue, Op::Bitcast, u32_ty, vec![Operand::IdRef(sum_s)]);
+        let vid_idxed = b.op(
+            &mut prologue,
+            Op::Select,
+            u32_ty,
+            vec![
+                Operand::IdRef(is_restart),
+                Operand::IdRef(c0_u32),
+                Operand::IdRef(sum_u),
+            ],
+        );
+        let eff_vid = b.op(
+            &mut prologue,
+            Op::Select,
+            u32_ty,
+            vec![
+                Operand::IdRef(is_indexed),
+                Operand::IdRef(vid_idxed),
+                Operand::IdRef(raw_vid),
+            ],
+        );
+
+        effective_vid_u32 = Some(eff_vid);
+        is_restart_bool = Some(is_restart);
+
+        let inst_vid = if let Some(ivar) = inst_builtin_var {
+            Some(b.op(&mut prologue, Op::Load, u32_ty, vec![Operand::IdRef(ivar)]))
+        } else {
+            None
+        };
+
+        input_loc_vars.sort_by_key(|(_, l, _)| *l);
+        for &(ivar_id, loc, pointee_ty) in &input_loc_vars {
+            let val = if let Some(attr) = vattr_by_loc.get(&loc).copied() {
+                if let (Some(total_bytes), Some((dst_kind, dst_comps))) = (
+                    vfmt_bytes(attr.vfmt),
+                    scalar_kind_of_type(&defs_initial, pointee_ty),
+                ) {
+                    if attr.buffer_index < 32 {
+                        let bidx_c = b.const_u32(attr.buffer_index);
+                        let vb_ac = b.op(
+                            &mut prologue,
+                            Op::AccessChain,
+                            p_sb_u64,
+                            vec![
+                                Operand::IdRef(vpv),
+                                Operand::IdRef(c6_u32),
+                                Operand::IdRef(bidx_c),
+                            ],
+                        );
+                        let vb_bda = b.op(&mut prologue, Op::Load, u64_ty, vec![Operand::IdRef(vb_ac)]);
+                        let elem_idx = match attr.step_func {
+                            0 => c0_u32,
+                            1 => eff_vid,
+                            _ => {
+                                let ii = inst_vid.unwrap_or(c0_u32);
+                                if attr.step_rate > 1 {
+                                    let sr = b.const_u32(attr.step_rate);
+                                    b.op(
+                                        &mut prologue,
+                                        Op::UDiv,
+                                        u32_ty,
+                                        vec![Operand::IdRef(ii), Operand::IdRef(sr)],
+                                    )
+                                } else {
+                                    ii
+                                }
+                            }
+                        };
+                        let elem_idx64 = b.op(
+                            &mut prologue,
+                            Op::UConvert,
+                            u64_ty,
+                            vec![Operand::IdRef(elem_idx)],
+                        );
+                        let stride64 = b.const_u64(u64::from(attr.stride));
+                        let off64 = b.const_u64(u64::from(attr.offset));
+                        let mul = b.op(
+                            &mut prologue,
+                            Op::IMul,
+                            u64_ty,
+                            vec![Operand::IdRef(elem_idx64), Operand::IdRef(stride64)],
+                        );
+                        let attr_off = b.op(
+                            &mut prologue,
+                            Op::IAdd,
+                            u64_ty,
+                            vec![Operand::IdRef(mul), Operand::IdRef(off64)],
+                        );
+                        let nw = total_bytes.div_ceil(4);
+                        let mut words = [c0_u32; 4];
+                        for wi in 0..nw {
+                            let rem = total_bytes - wi * 4;
+                            let chunk = rem.min(4);
+                            let coff = if wi == 0 {
+                                attr_off
+                            } else {
+                                let woff = b.const_u64(u64::from(wi) * 4);
+                                b.op(
+                                    &mut prologue,
+                                    Op::IAdd,
+                                    u64_ty,
+                                    vec![Operand::IdRef(attr_off), Operand::IdRef(woff)],
+                                )
+                            };
+                            words[wi as usize] = call_load32(&mut b, &mut prologue, l32, vb_bda, coff, chunk);
+                        }
+                        let (lanes, src_kind) =
+                            decode_vfmt_lanes(&mut b, &mut prologue, attr.vfmt, &words)?;
+                        convert_lanes_to_type(
+                            &mut b,
+                            &mut prologue,
+                            &lanes,
+                            src_kind,
+                            dst_kind,
+                            dst_comps,
+                        )
+                    } else {
+                        b.zero_of_type(&defs_initial, pointee_ty)
+                    }
+                } else {
+                    b.zero_of_type(&defs_initial, pointee_ty)
+                }
+            } else {
+                b.zero_of_type(&defs_initial, pointee_ty)
+            };
+            lowered_input_vals.insert(ivar_id, (val, pointee_ty));
+        }
+    }
+
+    let lowered_vars_set: HashSet<Word> = input_loc_vars.iter().map(|&(v, _, _)| v).collect();
+    let num_fns = b.module.functions.len();
+    for fi in 0..num_fns {
+        if stage_kind == 0 && fi == num_fns - 1 && fn_load32.is_some() {
+            continue;
+        }
+        let is_entry = fi == entry_idx;
+        let num_blks = b.module.functions[fi].blocks.len();
+        for bi in 0..num_blks {
+            let old_insts = std::mem::take(&mut b.module.functions[fi].blocks[bi].instructions);
+            let mut new_insts = Vec::with_capacity(
+                old_insts.len() + if is_entry && bi == 0 { prologue.len() } else { 0 },
+            );
+            if is_entry && bi == 0 {
+                let var_end = old_insts
+                    .iter()
+                    .take_while(|i| i.class.opcode == Op::Variable)
+                    .count();
+                new_insts.extend(old_insts[..var_end].iter().cloned());
+                new_insts.append(&mut prologue);
+                new_insts.extend(old_insts.into_iter().skip(var_end));
+            } else {
+                new_insts = old_insts;
+            }
+
+            let mut rewritten = Vec::with_capacity(new_insts.len() + 8);
+            for mut inst in new_insts {
+                if existing_is_registry_v3
+                    && inst.result_id.is_some_and(|id| redirect_existing_direct_ac.contains(&id))
+                {
+                    if let Some(Operand::IdRef(base)) = inst.operands.first_mut() {
+                        *base = table_var;
+                    }
+                }
+                if !matches!(inst.class.opcode, Op::Load | Op::Store | Op::ArrayLength) {
+                    for op in &mut inst.operands {
+                        if let Operand::IdRef(r) = op {
+                            if let Some(&prep) = ptr_val_map.get(r) {
+                                *r = prep;
+                            } else if let Some(&(is_undef, rt)) = const_null_or_undef.get(r) {
+                                if let Some(&psb_pt) = psb_ty_map.get(&rt) {
+                                    if matches!(inst.class.opcode, Op::Select | Op::Phi)
+                                        && inst.result_id.is_some_and(|id| psb_origin.contains(&id))
+                                    {
+                                        *r = null_psb_id(&mut b, &mut psb_nulls, psb_pt, is_undef);
+                                    }
+                                }
+                            }
+                        }
+                    }
+                }
+
+                if inst.class.opcode == Op::Load {
+                    if let (Some(res), Some(res_ty), Some(Operand::IdRef(ptr_op))) = (
+                        inst.result_id,
+                        inst.result_type,
+                        inst.operands.first().cloned(),
+                    ) {
+                        if lowered_vars_set.contains(&ptr_op) {
+                            let (loaded_val, _) = lowered_input_vals[&ptr_op];
+                            rewritten.push(Instruction::new(
+                                Op::CopyObject,
+                                Some(res_ty),
+                                Some(res),
+                                vec![Operand::IdRef(loaded_val)],
+                            ));
+                            continue;
+                        }
+                    }
+                }
+
+                if inst.class.opcode == Op::ArrayLength {
+                    if let (
+                        Some(res),
+                        Some(_rt),
+                        [Operand::IdRef(base), Operand::LiteralBit32(member)],
+                    ) = (
+                        inst.result_id,
+                        inst.result_type,
+                        inst.operands.as_slice(),
+                    ) {
+                        if let Some(&(slot, struct_ty)) = replaced_bufs.get(base) {
+                            let len64 = *slot_len_cache.entry(slot).or_insert_with(|| {
+                                lower_existing_psb_table_load(
+                                    &mut b,
+                                    &mut rewritten,
+                                    table_var,
+                                    table_vec2_elem_ptr,
+                                    slot,
+                                    32,
+                                )
+                            });
+                            let m_off = u64::from(
+                                member_offsets
+                                    .get(&(struct_ty, *member))
+                                    .copied()
+                                    .unwrap_or(0),
+                            );
+                            let rt_arr_ty = defs_initial
+                                .get(&struct_ty)
+                                .and_then(|s| s.operands.get(*member as usize))
+                                .and_then(|o| match o {
+                                    Operand::IdRef(id) => Some(*id),
+                                    _ => None,
+                                });
+                            let stride = u64::from(
+                                rt_arr_ty
+                                    .and_then(|a| array_strides.get(&a).copied())
+                                    .unwrap_or(4)
+                                    .max(1),
+                            );
+                            let c_off = b.const_u64(m_off);
+                            let c_str = b.const_u64(stride);
+                            let c_z64 = b.const_u64(0);
+                            let gt = b.op(
+                                &mut rewritten,
+                                Op::UGreaterThan,
+                                bool_ty,
+                                vec![Operand::IdRef(len64), Operand::IdRef(c_off)],
+                            );
+                            let diff = b.op(
+                                &mut rewritten,
+                                Op::ISub,
+                                u64_ty,
+                                vec![Operand::IdRef(len64), Operand::IdRef(c_off)],
+                            );
+                            let clamped = b.op(
+                                &mut rewritten,
+                                Op::Select,
+                                u64_ty,
+                                vec![
+                                    Operand::IdRef(gt),
+                                    Operand::IdRef(diff),
+                                    Operand::IdRef(c_z64),
+                                ],
+                            );
+                            let elems64 = b.op(
+                                &mut rewritten,
+                                Op::UDiv,
+                                u64_ty,
+                                vec![Operand::IdRef(clamped), Operand::IdRef(c_str)],
+                            );
+                            rewritten.push(Instruction::new(
+                                Op::UConvert,
+                                Some(u32_ty),
+                                Some(res),
+                                vec![Operand::IdRef(elems64)],
+                            ));
+                            continue;
+                        }
+                    }
+                }
+
+                if let Some(res) = inst.result_id {
+                    if psb_origin.contains(&res) {
+                        if let Some(rt) = inst.result_type {
+                            if let Some(&new_rt) = psb_ty_map.get(&rt) {
+                                inst.result_type = Some(new_rt);
+                            }
+                        }
+                        psb_values.insert(res);
+                    }
+                }
+
+                match inst.class.opcode {
+                    Op::Load => {
+                        let ptr_op = match inst.operands.first() {
+                            Some(Operand::IdRef(p)) => ptr_val_map.get(p).copied().unwrap_or(*p),
+                            _ => 0,
+                        };
+                        if let Some(Operand::IdRef(p)) = inst.operands.first_mut() {
+                            *p = ptr_op;
+                        }
+                        if psb_values.contains(&ptr_op) {
+                            let res_ty = inst.result_type.unwrap_or(u32_ty);
+                            let extra = inst.operands[1..].to_vec();
+                            inst.operands = make_psb_access_operands(
+                                ptr_op,
+                                None,
+                                &extra,
+                                res_ty,
+                                &defs_initial,
+                            );
+                        }
+                    }
+                    Op::Store => {
+                        let ptr_op = match inst.operands.first() {
+                            Some(Operand::IdRef(p)) => ptr_val_map.get(p).copied().unwrap_or(*p),
+                            _ => 0,
+                        };
+                        let val_op = match inst.operands.get(1) {
+                            Some(Operand::IdRef(v)) => ptr_val_map.get(v).copied().unwrap_or(*v),
+                            _ => 0,
+                        };
+                        if psb_values.contains(&ptr_op) {
+                            let val_ty = all_result_types
+                                .get(&val_op)
+                                .copied()
+                                .unwrap_or(u32_ty);
+                            let extra = inst.operands[2..].to_vec();
+                            inst.operands = make_psb_access_operands(
+                                ptr_op,
+                                Some(val_op),
+                                &extra,
+                                val_ty,
+                                &defs_initial,
+                            );
+                        } else {
+                            if let Some(Operand::IdRef(p)) = inst.operands.first_mut() {
+                                *p = ptr_op;
+                            }
+                            if let Some(Operand::IdRef(v)) = inst.operands.get_mut(1) {
+                                *v = val_op;
+                            }
+                        }
+                    }
+                    _ => {}
+                }
+                rewritten.push(inst);
+            }
+            b.module.functions[fi].blocks[bi].instructions = rewritten;
+        }
+    }
+
+    if stage_kind == 0 {
+        let ep_end = b.module.functions[entry_idx].blocks[0]
+            .instructions
+            .iter()
+            .position(|i| i.result_id == effective_vid_u32)
+            .unwrap_or(0);
+        if let (Some(vvar), Some(ev)) = (vtx_builtin_var, effective_vid_u32) {
+            let mut body_repls: HashMap<Word, Word> = HashMap::new();
+            let nb = b.module.functions[entry_idx].blocks.len();
+            for bi in 0..nb {
+                let start_i = if bi == 0 { ep_end + 1 } else { 0 };
+                let insts = &mut b.module.functions[entry_idx].blocks[bi].instructions;
+                let mut i = 0;
+                while i < insts.len() {
+                    for op in &mut insts[i].operands {
+                        if let Operand::IdRef(r) = op {
+                            if let Some(&rep) = body_repls.get(r) {
+                                *r = rep;
+                            }
+                        }
+                    }
+                    if i >= start_i && insts[i].class.opcode == Op::Load {
+                        if let (Some(res), Some(rt), Some(Operand::IdRef(p))) = (
+                            insts[i].result_id,
+                            insts[i].result_type,
+                            insts[i].operands.first().cloned(),
+                        ) {
+                            if p == vvar {
+                                if rt == i32_ty {
+                                    insts[i] = Instruction::new(
+                                        Op::Bitcast,
+                                        Some(i32_ty),
+                                        Some(res),
+                                        vec![Operand::IdRef(ev)],
+                                    );
+                                } else {
+                                    insts.remove(i);
+                                    body_repls.insert(res, ev);
+                                    continue;
+                                }
+                            }
+                        }
+                    }
+                    i += 1;
+                }
+            }
+        }
+
+        if let (Some(is_restart), Some((pos_var, _pos_ty, pos_member))) =
+            (is_restart_bool, position_var)
+        {
+            let nan_vec = b.module.fresh_id();
+            b.module.types_global_values.push(Instruction::new(
+                Op::ConstantComposite,
+                Some(v4f32_ty),
+                Some(nan_vec),
+                vec![Operand::IdRef(nan_bits); 4],
+            ));
+            let pos_ptr_ty = b.ty_ptr(StorageClass::Output, v4f32_ty);
+            let nb = b.module.functions[entry_idx].blocks.len();
+            for bi in 0..nb {
+                let is_ret = b.module.functions[entry_idx].blocks[bi]
+                    .instructions
+                    .last()
+                    .is_some_and(|i| i.class.opcode == Op::Return);
+                if !is_ret {
+                    continue;
+                }
+                let then_lbl = b.module.fresh_id();
+                let merge_lbl = b.module.fresh_id();
+                let ret_inst = b.module.functions[entry_idx].blocks[bi]
+                    .instructions
+                    .pop()
+                    .unwrap();
+                b.module.functions[entry_idx].blocks[bi]
+                    .instructions
+                    .extend([
+                        Instruction::new(
+                            Op::SelectionMerge,
+                            None,
+                            None,
+                            vec![
+                                Operand::IdRef(merge_lbl),
+                                Operand::SelectionControl(SelectionControl::NONE),
+                            ],
+                        ),
+                        Instruction::new(
+                            Op::BranchConditional,
+                            None,
+                            None,
+                            vec![
+                                Operand::IdRef(is_restart),
+                                Operand::IdRef(then_lbl),
+                                Operand::IdRef(merge_lbl),
+                            ],
+                        ),
+                    ]);
+                let mut then_insts = Vec::new();
+                let target_ptr = if let Some(m) = pos_member {
+                    let mc = b.const_u32(m);
+                    b.op(
+                        &mut then_insts,
+                        Op::AccessChain,
+                        pos_ptr_ty,
+                        vec![Operand::IdRef(pos_var), Operand::IdRef(mc)],
+                    )
+                } else {
+                    pos_var
+                };
+                then_insts.push(Instruction::new(
+                    Op::Store,
+                    None,
+                    None,
+                    vec![Operand::IdRef(target_ptr), Operand::IdRef(nan_vec)],
+                ));
+                then_insts.push(Instruction::new(
+                    Op::Branch,
+                    None,
+                    None,
+                    vec![Operand::IdRef(merge_lbl)],
+                ));
+                b.module.functions[entry_idx].blocks.push(Block {
+                    label: Some(Instruction::new(Op::Label, None, Some(then_lbl), vec![])),
+                    instructions: then_insts,
+                });
+                b.module.functions[entry_idx].blocks.push(Block {
+                    label: Some(Instruction::new(Op::Label, None, Some(merge_lbl), vec![])),
+                    instructions: vec![ret_inst],
+                });
+            }
+        }
+    }
+
+    let mut removed_vars: HashSet<Word> = replaced_bufs.keys().copied().collect();
+    removed_vars.extend(lowered_vars_set);
+
+    b.module
+        .types_global_values
+        .retain(|i| !i.result_id.is_some_and(|id| removed_vars.contains(&id)));
+    b.module.annotations.retain(|i| {
+        !i.operands
+            .first()
+            .is_some_and(|o| matches!(o, Operand::IdRef(id) if removed_vars.contains(id)))
+    });
+    b.module.debug_names.retain(|i| {
+        !i.operands
+            .first()
+            .is_some_and(|o| matches!(o, Operand::IdRef(id) if removed_vars.contains(id)))
+    });
+
+    if let Some(ep) = b.module.entry_points.get_mut(ep_idx) {
+        let mut interface: Vec<Word> = ep.operands[3..]
+            .iter()
+            .filter_map(|o| match o {
+                Operand::IdRef(id) if !removed_vars.contains(id) => Some(*id),
+                _ => None,
+            })
+            .collect();
+        for add in [
+            Some(table_var),
+            vs_params_var,
+            vtx_builtin_var,
+            inst_builtin_var,
+        ]
+        .into_iter()
+        .flatten()
+        {
+            if !interface.contains(&add) {
+                interface.push(add);
+            }
+        }
+        ep.operands.truncate(3);
+        ep.operands
+            .extend(interface.into_iter().map(Operand::IdRef));
+    }
+
+    let words = module.assemble();
+    let mut out_bytes = Vec::with_capacity(words.len() * 4);
+    for w in words {
+        out_bytes.extend_from_slice(&w.to_le_bytes());
+    }
+    let vs_params_binding = if stage_kind == 0 {
+        RDNA4_ICB_VS_PARAMS_BINDING
+    } else {
+        0
+    };
+    Ok((out_bytes, RDNA4_ICB_TABLE_BINDING, vs_params_binding))
+}
