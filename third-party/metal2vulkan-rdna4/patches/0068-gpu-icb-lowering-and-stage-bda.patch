diff --git a/src/native/emitter/ops/icb.rs b/src/native/emitter/ops/icb.rs
new file mode 100644
index 0000000..dc6059f
--- /dev/null
+++ b/src/native/emitter/ops/icb.rs
@@ -0,0 +1,1048 @@
+fn typed(name: &str, stem: &str) -> bool {
+    name == stem || name.strip_prefix(stem).is_some_and(|t| t.starts_with('.'))
+}
+
+use super::*;
+
+const RDNA4_ICB_MAGIC: u32 = 0x4943_4231; // ICB1
+const RDNA4_ICB_HEADER_BYTES: i64 = 64;
+const RDNA4_ICB_SLOT_BYTES: i64 = 640;
+
+const RDNA4_ICB_KIND_DRAW: u32 = 1;
+const RDNA4_ICB_KIND_DRAW_INDEXED: u32 = 2;
+const RDNA4_ICB_KIND_DRAW_PATCHES: u32 = 3;
+const RDNA4_ICB_KIND_DRAW_INDEXED_PATCHES: u32 = 4;
+
+const RDNA4_ICB_FLAG_INHERIT_PIPELINE: u32 = 1 << 0;
+const RDNA4_ICB_FLAG_INHERIT_BUFFERS: u32 = 1 << 1;
+
+const RDNA4_ICB_SLOT_FLAG_PIPELINE_SET: u32 = 1 << 0;
+const RDNA4_ICB_SLOT_FLAG_INVALID: u32 = 1 << 1;
+
+const RDNA4_ICB_CMD_BIT_DRAW: u32 = 1 << 0;
+const RDNA4_ICB_CMD_BIT_DRAW_INDEXED: u32 = 1 << 1;
+const RDNA4_ICB_CMD_BIT_DRAW_PATCHES: u32 = 1 << 2;
+const RDNA4_ICB_CMD_BIT_DRAW_INDEXED_PATCHES: u32 = 1 << 3;
+
+impl Emitter {
+    fn resolve_icb_ptr_u64(
+        &mut self,
+        tv: &TypedValue,
+        instructions: &mut Vec<Instruction>,
+    ) -> Result<Word, String> {
+        match &tv.value {
+            LlValue::Zero | LlValue::Undef => {
+                self.const_signed_int(64, 0)
+            }
+            LlValue::Local(name) => {
+                if let Some(raw) = self.raw_offsets.get(name).cloned() {
+                    if raw.device_addr_base.is_some() {
+                        return self.materialize_device_address(&raw, instructions);
+                    }
+                    if let Some(base) = self.bda_direct_addresses.get(&raw.root).copied() {
+                        let mut with_base = raw;
+                        with_base.device_addr_base = Some(base);
+                        return self.materialize_device_address(&with_base, instructions);
+                    }
+                }
+                if let Some(&(id, _)) = self.values.get(&bda_address_name(name)) {
+                    return Ok(id);
+                }
+                if let Some(&id) = self.bda_direct_addresses.get(name) {
+                    return Ok(id);
+                }
+                if let Some(&(id, LlType::Int(64))) = self.values.get(name) {
+                    return Ok(id);
+                }
+                Err(format!(
+                    "native emitter: render ICB pointer operand %{name} has no device address"
+                ))
+            }
+            LlValue::IntToPtr { source, .. } => self.value_id_in(&source.value, &source.ty, instructions),
+            _ => Err(format!(
+                "native emitter: unsupported render ICB pointer operand {:?}",
+                tv.value
+            )),
+        }
+    }
+
+    fn emit_icb_add_i64(
+        &mut self,
+        base: Word,
+        byte_offset: i64,
+        instructions: &mut Vec<Instruction>,
+    ) -> Result<Word, String> {
+        if byte_offset == 0 {
+            return Ok(base);
+        }
+        let i64_ty = self.type_id(&LlType::Int(64))?;
+        let off = self.const_signed_int(64, byte_offset)?;
+        let res = self.fresh();
+        instructions.push(Self::inst(
+            Op::IAdd,
+            Some(i64_ty),
+            Some(res),
+            vec![Operand::IdRef(base), Operand::IdRef(off)],
+        ));
+        Ok(res)
+    }
+
+    fn emit_icb_load(
+        &mut self,
+        addr: Word,
+        byte_offset: i64,
+        ty: &LlType,
+        align: u32,
+        instructions: &mut Vec<Instruction>,
+    ) -> Result<Word, String> {
+        let addr = self.emit_icb_add_i64(addr, byte_offset, instructions)?;
+        let res_ty = self.type_id(ty)?;
+        let ptr_ty = self.ptr_type_id(StorageClass::PhysicalStorageBuffer, ty)?;
+        let ptr = self.fresh();
+        instructions.push(Self::inst(
+            Op::ConvertUToPtr,
+            Some(ptr_ty),
+            Some(ptr),
+            vec![Operand::IdRef(addr)],
+        ));
+        let val = self.fresh();
+        instructions.push(Self::inst(
+            Op::Load,
+            Some(res_ty),
+            Some(val),
+            vec![
+                Operand::IdRef(ptr),
+                Operand::MemoryAccess(spirv::MemoryAccess::ALIGNED),
+                Operand::LiteralBit32(align),
+            ],
+        ));
+        Ok(val)
+    }
+
+    fn emit_icb_store(
+        &mut self,
+        addr: Word,
+        byte_offset: i64,
+        ty: &LlType,
+        align: u32,
+        value: Word,
+        instructions: &mut Vec<Instruction>,
+    ) -> Result<(), String> {
+        let addr = self.emit_icb_add_i64(addr, byte_offset, instructions)?;
+        let ptr_ty = self.ptr_type_id(StorageClass::PhysicalStorageBuffer, ty)?;
+        let ptr = self.fresh();
+        instructions.push(Self::inst(
+            Op::ConvertUToPtr,
+            Some(ptr_ty),
+            Some(ptr),
+            vec![Operand::IdRef(addr)],
+        ));
+        instructions.push(Self::inst(
+            Op::Store,
+            None,
+            None,
+            vec![
+                Operand::IdRef(ptr),
+                Operand::IdRef(value),
+                Operand::MemoryAccess(spirv::MemoryAccess::ALIGNED),
+                Operand::LiteralBit32(align),
+            ],
+        ));
+        Ok(())
+    }
+
+    fn emit_icb_if(
+        &mut self,
+        cond: Word,
+        instructions: &mut Vec<Instruction>,
+        then_fn: impl FnOnce(&mut Self, &mut Vec<Instruction>) -> Result<(), String>,
+    ) -> Result<(), String> {
+        let then_lbl = self.fresh();
+        let merge_lbl = self.fresh();
+        instructions.push(Self::inst(
+            Op::SelectionMerge,
+            None,
+            None,
+            vec![
+                Operand::IdRef(merge_lbl),
+                Operand::SelectionControl(SelectionControl::NONE),
+            ],
+        ));
+        instructions.push(Self::inst(
+            Op::BranchConditional,
+            None,
+            None,
+            vec![
+                Operand::IdRef(cond),
+                Operand::IdRef(then_lbl),
+                Operand::IdRef(merge_lbl),
+            ],
+        ));
+        instructions.push(Self::inst(Op::Label, None, Some(then_lbl), vec![]));
+        then_fn(self, instructions)?;
+        instructions.push(Self::inst(
+            Op::Branch,
+            None,
+            None,
+            vec![Operand::IdRef(merge_lbl)],
+        ));
+        instructions.push(Self::inst(Op::Label, None, Some(merge_lbl), vec![]));
+        Ok(())
+    }
+
+    fn emit_icb_if_else(
+        &mut self,
+        cond: Word,
+        instructions: &mut Vec<Instruction>,
+        then_fn: impl FnOnce(&mut Self, &mut Vec<Instruction>) -> Result<(), String>,
+        else_fn: impl FnOnce(&mut Self, &mut Vec<Instruction>) -> Result<(), String>,
+    ) -> Result<(), String> {
+        let then_lbl = self.fresh();
+        let else_lbl = self.fresh();
+        let merge_lbl = self.fresh();
+        instructions.push(Self::inst(
+            Op::SelectionMerge,
+            None,
+            None,
+            vec![
+                Operand::IdRef(merge_lbl),
+                Operand::SelectionControl(SelectionControl::NONE),
+            ],
+        ));
+        instructions.push(Self::inst(
+            Op::BranchConditional,
+            None,
+            None,
+            vec![
+                Operand::IdRef(cond),
+                Operand::IdRef(then_lbl),
+                Operand::IdRef(else_lbl),
+            ],
+        ));
+        instructions.push(Self::inst(Op::Label, None, Some(then_lbl), vec![]));
+        then_fn(self, instructions)?;
+        instructions.push(Self::inst(
+            Op::Branch,
+            None,
+            None,
+            vec![Operand::IdRef(merge_lbl)],
+        ));
+        instructions.push(Self::inst(Op::Label, None, Some(else_lbl), vec![]));
+        else_fn(self, instructions)?;
+        instructions.push(Self::inst(
+            Op::Branch,
+            None,
+            None,
+            vec![Operand::IdRef(merge_lbl)],
+        ));
+        instructions.push(Self::inst(Op::Label, None, Some(merge_lbl), vec![]));
+        Ok(())
+    }
+
+    fn emit_icb_mark_invalid(
+        &mut self,
+        slot_addr: Word,
+        instructions: &mut Vec<Instruction>,
+    ) -> Result<(), String> {
+        let u32_ty = self.type_id(&LlType::Int(32))?;
+        let cur = self.emit_icb_load(slot_addr, 12, &LlType::Int(32), 4, instructions)?;
+        let inv = self.const_uint(RDNA4_ICB_SLOT_FLAG_INVALID)?;
+        let next = self.fresh();
+        instructions.push(Self::inst(
+            Op::BitwiseOr,
+            Some(u32_ty),
+            Some(next),
+            vec![Operand::IdRef(cur), Operand::IdRef(inv)],
+        ));
+        self.emit_icb_store(slot_addr, 12, &LlType::Int(32), 4, next, instructions)?;
+        let zero = self.const_uint(0)?;
+        self.emit_icb_store(slot_addr, 0, &LlType::Int(32), 4, zero, instructions)
+    }
+
+    fn emit_icb_slot_addr(
+        &mut self,
+        icb_addr: Word,
+        idx_u32: Word,
+        instructions: &mut Vec<Instruction>,
+    ) -> Result<Word, String> {
+        let i64_ty = self.type_id(&LlType::Int(64))?;
+        let idx64 = self.fresh();
+        instructions.push(Self::inst(
+            Op::UConvert,
+            Some(i64_ty),
+            Some(idx64),
+            vec![Operand::IdRef(idx_u32)],
+        ));
+        let stride = self.const_signed_int(64, RDNA4_ICB_SLOT_BYTES)?;
+        let off = self.fresh();
+        instructions.push(Self::inst(
+            Op::IMul,
+            Some(i64_ty),
+            Some(off),
+            vec![Operand::IdRef(idx64), Operand::IdRef(stride)],
+        ));
+        let hdr_sz = self.const_signed_int(64, RDNA4_ICB_HEADER_BYTES)?;
+        let rel = self.fresh();
+        instructions.push(Self::inst(
+            Op::IAdd,
+            Some(i64_ty),
+            Some(rel),
+            vec![Operand::IdRef(off), Operand::IdRef(hdr_sz)],
+        ));
+        let slot_addr = self.fresh();
+        instructions.push(Self::inst(
+            Op::IAdd,
+            Some(i64_ty),
+            Some(slot_addr),
+            vec![Operand::IdRef(icb_addr), Operand::IdRef(rel)],
+        ));
+        Ok(slot_addr)
+    }
+
+    fn emit_icb_guarded_slot(
+        &mut self,
+        icb_tv: &TypedValue,
+        idx_tv: &TypedValue,
+        instructions: &mut Vec<Instruction>,
+        body: impl FnOnce(&mut Self, Word, Word, &mut Vec<Instruction>) -> Result<(), String>,
+    ) -> Result<(), String> {
+        self.require_capability(Capability::Int64);
+        self.used_device_address = true;
+        let icb_addr = self.resolve_icb_ptr_u64(icb_tv, instructions)?;
+        let idx = self.value_id_in(&idx_tv.value, &idx_tv.ty, instructions)?;
+        let bool_ty = self.type_id(&LlType::Bool)?;
+        let zero64 = self.const_signed_int(64, 0)?;
+        let non_null = self.fresh();
+        instructions.push(Self::inst(
+            Op::INotEqual,
+            Some(bool_ty),
+            Some(non_null),
+            vec![Operand::IdRef(icb_addr), Operand::IdRef(zero64)],
+        ));
+        self.emit_icb_if(non_null, instructions, |this, instructions| {
+            let magic = this.emit_icb_load(icb_addr, 0, &LlType::Int(32), 4, instructions)?;
+            let max_cmd = this.emit_icb_load(icb_addr, 4, &LlType::Int(32), 4, instructions)?;
+            let expected_magic = this.const_uint(RDNA4_ICB_MAGIC)?;
+            let magic_ok = this.fresh();
+            instructions.push(Self::inst(
+                Op::IEqual,
+                Some(bool_ty),
+                Some(magic_ok),
+                vec![Operand::IdRef(magic), Operand::IdRef(expected_magic)],
+            ));
+            let idx_ok = this.fresh();
+            instructions.push(Self::inst(
+                Op::ULessThan,
+                Some(bool_ty),
+                Some(idx_ok),
+                vec![Operand::IdRef(idx), Operand::IdRef(max_cmd)],
+            ));
+            let valid = this.fresh();
+            instructions.push(Self::inst(
+                Op::LogicalAnd,
+                Some(bool_ty),
+                Some(valid),
+                vec![Operand::IdRef(magic_ok), Operand::IdRef(idx_ok)],
+            ));
+            this.emit_icb_if(valid, instructions, |this, instructions| {
+                let slot_addr = this.emit_icb_slot_addr(icb_addr, idx, instructions)?;
+                body(this, icb_addr, slot_addr, instructions)
+            })
+        })
+    }
+
+    fn emit_icb_draw_gate(
+        &mut self,
+        icb_addr: Word,
+        slot_addr: Word,
+        cmd_bit: u32,
+        extra_ok: Option<Word>,
+        instructions: &mut Vec<Instruction>,
+        write_fn: impl FnOnce(&mut Self, &mut Vec<Instruction>) -> Result<(), String>,
+    ) -> Result<(), String> {
+        let bool_ty = self.type_id(&LlType::Bool)?;
+        let u32_ty = self.type_id(&LlType::Int(32))?;
+        let zero = self.const_uint(0)?;
+        let cmd_types = self.emit_icb_load(icb_addr, 8, &LlType::Int(32), 4, instructions)?;
+        let bit_const = self.const_uint(cmd_bit)?;
+        let cmd_masked = self.fresh();
+        instructions.push(Self::inst(
+            Op::BitwiseAnd,
+            Some(u32_ty),
+            Some(cmd_masked),
+            vec![Operand::IdRef(cmd_types), Operand::IdRef(bit_const)],
+        ));
+        let cmd_ok = self.fresh();
+        instructions.push(Self::inst(
+            Op::INotEqual,
+            Some(bool_ty),
+            Some(cmd_ok),
+            vec![Operand::IdRef(cmd_masked), Operand::IdRef(zero)],
+        ));
+
+        let hdr_flags = self.emit_icb_load(icb_addr, 12, &LlType::Int(32), 4, instructions)?;
+        let inh_bit = self.const_uint(RDNA4_ICB_FLAG_INHERIT_PIPELINE)?;
+        let inh_masked = self.fresh();
+        instructions.push(Self::inst(
+            Op::BitwiseAnd,
+            Some(u32_ty),
+            Some(inh_masked),
+            vec![Operand::IdRef(hdr_flags), Operand::IdRef(inh_bit)],
+        ));
+        let inh_on = self.fresh();
+        instructions.push(Self::inst(
+            Op::INotEqual,
+            Some(bool_ty),
+            Some(inh_on),
+            vec![Operand::IdRef(inh_masked), Operand::IdRef(zero)],
+        ));
+        let slot_flags = self.emit_icb_load(slot_addr, 12, &LlType::Int(32), 4, instructions)?;
+        let pso_bit = self.const_uint(RDNA4_ICB_SLOT_FLAG_PIPELINE_SET)?;
+        let pso_masked = self.fresh();
+        instructions.push(Self::inst(
+            Op::BitwiseAnd,
+            Some(u32_ty),
+            Some(pso_masked),
+            vec![Operand::IdRef(slot_flags), Operand::IdRef(pso_bit)],
+        ));
+        let pso_on = self.fresh();
+        instructions.push(Self::inst(
+            Op::INotEqual,
+            Some(bool_ty),
+            Some(pso_on),
+            vec![Operand::IdRef(pso_masked), Operand::IdRef(zero)],
+        ));
+        let pipe_ok = self.fresh();
+        instructions.push(Self::inst(
+            Op::LogicalOr,
+            Some(bool_ty),
+            Some(pipe_ok),
+            vec![Operand::IdRef(inh_on), Operand::IdRef(pso_on)],
+        ));
+        let inv_bit = self.const_uint(RDNA4_ICB_SLOT_FLAG_INVALID)?;
+        let inv_masked = self.fresh();
+        instructions.push(Self::inst(
+            Op::BitwiseAnd,
+            Some(u32_ty),
+            Some(inv_masked),
+            vec![Operand::IdRef(slot_flags), Operand::IdRef(inv_bit)],
+        ));
+        let not_invalid = self.fresh();
+        instructions.push(Self::inst(
+            Op::IEqual,
+            Some(bool_ty),
+            Some(not_invalid),
+            vec![Operand::IdRef(inv_masked), Operand::IdRef(zero)],
+        ));
+
+        let mut ok = self.fresh();
+        instructions.push(Self::inst(
+            Op::LogicalAnd,
+            Some(bool_ty),
+            Some(ok),
+            vec![Operand::IdRef(cmd_ok), Operand::IdRef(pipe_ok)],
+        ));
+        let ok2 = self.fresh();
+        instructions.push(Self::inst(
+            Op::LogicalAnd,
+            Some(bool_ty),
+            Some(ok2),
+            vec![Operand::IdRef(ok), Operand::IdRef(not_invalid)],
+        ));
+        ok = ok2;
+        if let Some(extra) = extra_ok {
+            let ok3 = self.fresh();
+            instructions.push(Self::inst(
+                Op::LogicalAnd,
+                Some(bool_ty),
+                Some(ok3),
+                vec![Operand::IdRef(ok), Operand::IdRef(extra)],
+            ));
+            ok = ok3;
+        }
+        self.emit_icb_if_else(
+            ok,
+            instructions,
+            |this, instructions| write_fn(this, instructions),
+            |this, instructions| this.emit_icb_mark_invalid(slot_addr, instructions),
+        )
+    }
+
+    pub(in crate::native::emitter) fn emit_icb_void_air_call(
+        &mut self,
+        call: &LlCall,
+        instructions: &mut Vec<Instruction>,
+    ) -> Result<(), String> {
+        let callee = call.callee.as_str();
+        if callee == "air.reset_render_command" {
+            if call.args.len() != 2 {
+                return Err(format!("native emitter: {callee} expects 2 operands"));
+            }
+            return self.emit_icb_guarded_slot(
+                &call.args[0],
+                &call.args[1],
+                instructions,
+                |this, _icb_addr, slot_addr, instructions| {
+                    let v4_ty = LlType::Vector(Box::new(LlType::Int(32)), 4);
+                    let z4 = this.const_null(&v4_ty)?;
+                    for chunk in 0..40i64 {
+                        this.emit_icb_store(slot_addr, chunk * 16, &v4_ty, 16, z4, instructions)?;
+                    }
+                    Ok(())
+                },
+            );
+        }
+
+        if callee == "air.copy_render_command" {
+            if call.args.len() != 4 {
+                return Err(format!("native emitter: {callee} expects 4 operands"));
+            }
+            self.require_capability(Capability::Int64);
+            self.used_device_address = true;
+            let dst_addr = self.resolve_icb_ptr_u64(&call.args[0], instructions)?;
+            let dst_idx = self.value_id_in(&call.args[1].value, &call.args[1].ty, instructions)?;
+            let src_addr = self.resolve_icb_ptr_u64(&call.args[2], instructions)?;
+            let src_idx = self.value_id_in(&call.args[3].value, &call.args[3].ty, instructions)?;
+            let bool_ty = self.type_id(&LlType::Bool)?;
+            let zero64 = self.const_signed_int(64, 0)?;
+            let dst_nn = self.fresh();
+            instructions.push(Self::inst(
+                Op::INotEqual,
+                Some(bool_ty),
+                Some(dst_nn),
+                vec![Operand::IdRef(dst_addr), Operand::IdRef(zero64)],
+            ));
+            let src_nn = self.fresh();
+            instructions.push(Self::inst(
+                Op::INotEqual,
+                Some(bool_ty),
+                Some(src_nn),
+                vec![Operand::IdRef(src_addr), Operand::IdRef(zero64)],
+            ));
+            let both_nn = self.fresh();
+            instructions.push(Self::inst(
+                Op::LogicalAnd,
+                Some(bool_ty),
+                Some(both_nn),
+                vec![Operand::IdRef(dst_nn), Operand::IdRef(src_nn)],
+            ));
+            return self.emit_icb_if(both_nn, instructions, |this, instructions| {
+                let d_mag = this.emit_icb_load(dst_addr, 0, &LlType::Int(32), 4, instructions)?;
+                let d_max = this.emit_icb_load(dst_addr, 4, &LlType::Int(32), 4, instructions)?;
+                let s_mag = this.emit_icb_load(src_addr, 0, &LlType::Int(32), 4, instructions)?;
+                let s_max = this.emit_icb_load(src_addr, 4, &LlType::Int(32), 4, instructions)?;
+                let exp_mag = this.const_uint(RDNA4_ICB_MAGIC)?;
+                let d_mok = this.fresh();
+                instructions.push(Self::inst(
+                    Op::IEqual,
+                    Some(bool_ty),
+                    Some(d_mok),
+                    vec![Operand::IdRef(d_mag), Operand::IdRef(exp_mag)],
+                ));
+                let s_mok = this.fresh();
+                instructions.push(Self::inst(
+                    Op::IEqual,
+                    Some(bool_ty),
+                    Some(s_mok),
+                    vec![Operand::IdRef(s_mag), Operand::IdRef(exp_mag)],
+                ));
+                let d_iok = this.fresh();
+                instructions.push(Self::inst(
+                    Op::ULessThan,
+                    Some(bool_ty),
+                    Some(d_iok),
+                    vec![Operand::IdRef(dst_idx), Operand::IdRef(d_max)],
+                ));
+                let s_iok = this.fresh();
+                instructions.push(Self::inst(
+                    Op::ULessThan,
+                    Some(bool_ty),
+                    Some(s_iok),
+                    vec![Operand::IdRef(src_idx), Operand::IdRef(s_max)],
+                ));
+                let mut ok = this.fresh();
+                instructions.push(Self::inst(
+                    Op::LogicalAnd,
+                    Some(bool_ty),
+                    Some(ok),
+                    vec![Operand::IdRef(d_mok), Operand::IdRef(s_mok)],
+                ));
+                for cond in [d_iok, s_iok] {
+                    let nxt = this.fresh();
+                    instructions.push(Self::inst(
+                        Op::LogicalAnd,
+                        Some(bool_ty),
+                        Some(nxt),
+                        vec![Operand::IdRef(ok), Operand::IdRef(cond)],
+                    ));
+                    ok = nxt;
+                }
+                this.emit_icb_if(ok, instructions, |this, instructions| {
+                    let dst_slot = this.emit_icb_slot_addr(dst_addr, dst_idx, instructions)?;
+                    let src_slot = this.emit_icb_slot_addr(src_addr, src_idx, instructions)?;
+                    let v4_ty = LlType::Vector(Box::new(LlType::Int(32)), 4);
+                    for chunk in 0..40i64 {
+                        let v = this.emit_icb_load(src_slot, chunk * 16, &v4_ty, 16, instructions)?;
+                        this.emit_icb_store(dst_slot, chunk * 16, &v4_ty, 16, v, instructions)?;
+                    }
+                    Ok(())
+                })
+            });
+        }
+
+        if callee == "air.set_pipeline_state_render_command" {
+            if call.args.len() != 3 {
+                return Err(format!("native emitter: {callee} expects 3 operands"));
+            }
+            let pso_u64 = self.resolve_icb_ptr_u64(&call.args[2], instructions)?;
+            return self.emit_icb_guarded_slot(
+                &call.args[0],
+                &call.args[1],
+                instructions,
+                |this, icb_addr, slot_addr, instructions| {
+                    let bool_ty = this.type_id(&LlType::Bool)?;
+                    let u32_ty = this.type_id(&LlType::Int(32))?;
+                    let zero = this.const_uint(0)?;
+                    let hdr_flags =
+                        this.emit_icb_load(icb_addr, 12, &LlType::Int(32), 4, instructions)?;
+                    let inh = this.const_uint(RDNA4_ICB_FLAG_INHERIT_PIPELINE)?;
+                    let m = this.fresh();
+                    instructions.push(Self::inst(
+                        Op::BitwiseAnd,
+                        Some(u32_ty),
+                        Some(m),
+                        vec![Operand::IdRef(hdr_flags), Operand::IdRef(inh)],
+                    ));
+                    let can_set = this.fresh();
+                    instructions.push(Self::inst(
+                        Op::IEqual,
+                        Some(bool_ty),
+                        Some(can_set),
+                        vec![Operand::IdRef(m), Operand::IdRef(zero)],
+                    ));
+                    this.emit_icb_if_else(
+                        can_set,
+                        instructions,
+                        |this, instructions| {
+                            this.emit_icb_store(
+                                slot_addr,
+                                16,
+                                &LlType::Int(64),
+                                8,
+                                pso_u64,
+                                instructions,
+                            )?;
+                            let sf =
+                                this.emit_icb_load(slot_addr, 12, &LlType::Int(32), 4, instructions)?;
+                            let pbit = this.const_uint(RDNA4_ICB_SLOT_FLAG_PIPELINE_SET)?;
+                            let nsf = this.fresh();
+                            instructions.push(Self::inst(
+                                Op::BitwiseOr,
+                                Some(u32_ty),
+                                Some(nsf),
+                                vec![Operand::IdRef(sf), Operand::IdRef(pbit)],
+                            ));
+                            this.emit_icb_store(
+                                slot_addr,
+                                12,
+                                &LlType::Int(32),
+                                4,
+                                nsf,
+                                instructions,
+                            )
+                        },
+                        |this, instructions| this.emit_icb_mark_invalid(slot_addr, instructions),
+                    )
+                },
+            );
+        }
+
+        if typed(callee, "air.set_vertex_buffer_render_command")
+            || typed(callee, "air.set_fragment_buffer_render_command")
+        {
+            let is_vert = typed(callee, "air.set_vertex_buffer_render_command");
+            let slot_arg_idx = match call.args.len() {
+                4 => 3,
+                5 => 4,
+                n => {
+                    return Err(format!(
+                        "native emitter: {callee} expects 4 or 5 operands, got {n}"
+                    ));
+                }
+            };
+            let buf_u64 = self.resolve_icb_ptr_u64(&call.args[2], instructions)?;
+            let bind_idx = self.value_id_in(
+                &call.args[slot_arg_idx].value,
+                &call.args[slot_arg_idx].ty,
+                instructions,
+            )?;
+            let max_hdr_off = if is_vert { 16i64 } else { 20i64 };
+            let mask_off = if is_vert { 24i64 } else { 28i64 };
+            let array_off = if is_vert { 96i64 } else { 352i64 };
+            return self.emit_icb_guarded_slot(
+                &call.args[0],
+                &call.args[1],
+                instructions,
+                |this, icb_addr, slot_addr, instructions| {
+                    let bool_ty = this.type_id(&LlType::Bool)?;
+                    let u32_ty = this.type_id(&LlType::Int(32))?;
+                    let i64_ty = this.type_id(&LlType::Int(64))?;
+                    let zero = this.const_uint(0)?;
+                    let hdr_flags =
+                        this.emit_icb_load(icb_addr, 12, &LlType::Int(32), 4, instructions)?;
+                    let inh = this.const_uint(RDNA4_ICB_FLAG_INHERIT_BUFFERS)?;
+                    let m = this.fresh();
+                    instructions.push(Self::inst(
+                        Op::BitwiseAnd,
+                        Some(u32_ty),
+                        Some(m),
+                        vec![Operand::IdRef(hdr_flags), Operand::IdRef(inh)],
+                    ));
+                    let can_bind = this.fresh();
+                    instructions.push(Self::inst(
+                        Op::IEqual,
+                        Some(bool_ty),
+                        Some(can_bind),
+                        vec![Operand::IdRef(m), Operand::IdRef(zero)],
+                    ));
+                    let max_binds =
+                        this.emit_icb_load(icb_addr, max_hdr_off, &LlType::Int(32), 4, instructions)?;
+                    let lt_max = this.fresh();
+                    instructions.push(Self::inst(
+                        Op::ULessThan,
+                        Some(bool_ty),
+                        Some(lt_max),
+                        vec![Operand::IdRef(bind_idx), Operand::IdRef(max_binds)],
+                    ));
+                    let c31 = this.const_uint(31)?;
+                    let lt_31 = this.fresh();
+                    instructions.push(Self::inst(
+                        Op::ULessThan,
+                        Some(bool_ty),
+                        Some(lt_31),
+                        vec![Operand::IdRef(bind_idx), Operand::IdRef(c31)],
+                    ));
+                    let ok1 = this.fresh();
+                    instructions.push(Self::inst(
+                        Op::LogicalAnd,
+                        Some(bool_ty),
+                        Some(ok1),
+                        vec![Operand::IdRef(can_bind), Operand::IdRef(lt_max)],
+                    ));
+                    let ok = this.fresh();
+                    instructions.push(Self::inst(
+                        Op::LogicalAnd,
+                        Some(bool_ty),
+                        Some(ok),
+                        vec![Operand::IdRef(ok1), Operand::IdRef(lt_31)],
+                    ));
+                    this.emit_icb_if_else(
+                        ok,
+                        instructions,
+                        |this, instructions| {
+                            let idx64 = this.fresh();
+                            instructions.push(Self::inst(
+                                Op::UConvert,
+                                Some(i64_ty),
+                                Some(idx64),
+                                vec![Operand::IdRef(bind_idx)],
+                            ));
+                            let eight = this.const_signed_int(64, 8)?;
+                            let byte_off = this.fresh();
+                            instructions.push(Self::inst(
+                                Op::IMul,
+                                Some(i64_ty),
+                                Some(byte_off),
+                                vec![Operand::IdRef(idx64), Operand::IdRef(eight)],
+                            ));
+                            let base_off = this.const_signed_int(64, array_off)?;
+                            let rel = this.fresh();
+                            instructions.push(Self::inst(
+                                Op::IAdd,
+                                Some(i64_ty),
+                                Some(rel),
+                                vec![Operand::IdRef(base_off), Operand::IdRef(byte_off)],
+                            ));
+                            let dst = this.fresh();
+                            instructions.push(Self::inst(
+                                Op::IAdd,
+                                Some(i64_ty),
+                                Some(dst),
+                                vec![Operand::IdRef(slot_addr), Operand::IdRef(rel)],
+                            ));
+                            this.emit_icb_store(dst, 0, &LlType::Int(64), 8, buf_u64, instructions)?;
+                            let one = this.const_uint(1)?;
+                            let bit = this.fresh();
+                            instructions.push(Self::inst(
+                                Op::ShiftLeftLogical,
+                                Some(u32_ty),
+                                Some(bit),
+                                vec![Operand::IdRef(one), Operand::IdRef(bind_idx)],
+                            ));
+                            let old_mask = this.emit_icb_load(
+                                slot_addr,
+                                mask_off,
+                                &LlType::Int(32),
+                                4,
+                                instructions,
+                            )?;
+                            let new_mask = this.fresh();
+                            instructions.push(Self::inst(
+                                Op::BitwiseOr,
+                                Some(u32_ty),
+                                Some(new_mask),
+                                vec![Operand::IdRef(old_mask), Operand::IdRef(bit)],
+                            ));
+                            this.emit_icb_store(
+                                slot_addr,
+                                mask_off,
+                                &LlType::Int(32),
+                                4,
+                                new_mask,
+                                instructions,
+                            )
+                        },
+                        |this, instructions| this.emit_icb_mark_invalid(slot_addr, instructions),
+                    )
+                },
+            );
+        }
+
+        if callee == "air.draw_primitives_render_command" {
+            if call.args.len() != 7 {
+                return Err(format!("native emitter: {callee} expects 7 operands"));
+            }
+            let prim = self.value_id_in(&call.args[2].value, &call.args[2].ty, instructions)?;
+            let vstart = self.value_id_in(&call.args[3].value, &call.args[3].ty, instructions)?;
+            let vcount = self.value_id_in(&call.args[4].value, &call.args[4].ty, instructions)?;
+            let icount = self.value_id_in(&call.args[5].value, &call.args[5].ty, instructions)?;
+            let binst = self.value_id_in(&call.args[6].value, &call.args[6].ty, instructions)?;
+            return self.emit_icb_guarded_slot(
+                &call.args[0],
+                &call.args[1],
+                instructions,
+                |this, icb_addr, slot_addr, instructions| {
+                    let bool_ty = this.type_id(&LlType::Bool)?;
+                    let c5 = this.const_uint(5)?;
+                    let prim_ok = this.fresh();
+                    instructions.push(Self::inst(
+                        Op::ULessThan,
+                        Some(bool_ty),
+                        Some(prim_ok),
+                        vec![Operand::IdRef(prim), Operand::IdRef(c5)],
+                    ));
+                    this.emit_icb_draw_gate(
+                        icb_addr,
+                        slot_addr,
+                        RDNA4_ICB_CMD_BIT_DRAW,
+                        Some(prim_ok),
+                        instructions,
+                        |this, instructions| {
+                            let kind = this.const_uint(RDNA4_ICB_KIND_DRAW)?;
+                            let zero32 = this.const_uint(0)?;
+                            let zero64 = this.const_signed_int(64, 0)?;
+                            this.emit_icb_store(slot_addr, 0, &LlType::Int(32), 4, kind, instructions)?;
+                            this.emit_icb_store(slot_addr, 4, &LlType::Int(32), 4, prim, instructions)?;
+                            this.emit_icb_store(slot_addr, 8, &LlType::Int(32), 4, zero32, instructions)?;
+                            this.emit_icb_store(slot_addr, 32, &LlType::Int(32), 4, vcount, instructions)?;
+                            this.emit_icb_store(slot_addr, 36, &LlType::Int(32), 4, icount, instructions)?;
+                            this.emit_icb_store(slot_addr, 40, &LlType::Int(32), 4, vstart, instructions)?;
+                            this.emit_icb_store(slot_addr, 44, &LlType::Int(32), 4, binst, instructions)?;
+                            this.emit_icb_store(slot_addr, 48, &LlType::Int(32), 4, zero32, instructions)?;
+                            this.emit_icb_store(slot_addr, 64, &LlType::Int(64), 8, zero64, instructions)?;
+                            this.emit_icb_store(slot_addr, 72, &LlType::Int(64), 8, zero64, instructions)?;
+                            this.emit_icb_store(slot_addr, 80, &LlType::Int(64), 8, zero64, instructions)
+                        },
+                    )
+                },
+            );
+        }
+
+        if typed(callee, "air.draw_indexed_primitives_render_command") {
+            if call.args.len() != 8 {
+                return Err(format!("native emitter: {callee} expects 8 operands"));
+            }
+            let idx_type_val = if callee.contains(".p1i16")
+                || callee.contains(".p2i16")
+                || callee.ends_with(".i16")
+            {
+                0u32
+            } else {
+                1u32
+            };
+            let prim = self.value_id_in(&call.args[2].value, &call.args[2].ty, instructions)?;
+            let icount_idx = self.value_id_in(&call.args[3].value, &call.args[3].ty, instructions)?;
+            let ibuf_u64 = self.resolve_icb_ptr_u64(&call.args[4], instructions)?;
+            let inst_count = self.value_id_in(&call.args[5].value, &call.args[5].ty, instructions)?;
+            let bvert = self.value_id_in(&call.args[6].value, &call.args[6].ty, instructions)?;
+            let binst = self.value_id_in(&call.args[7].value, &call.args[7].ty, instructions)?;
+            return self.emit_icb_guarded_slot(
+                &call.args[0],
+                &call.args[1],
+                instructions,
+                |this, icb_addr, slot_addr, instructions| {
+                    let bool_ty = this.type_id(&LlType::Bool)?;
+                    let c5 = this.const_uint(5)?;
+                    let zero64 = this.const_signed_int(64, 0)?;
+                    let prim_ok = this.fresh();
+                    instructions.push(Self::inst(
+                        Op::ULessThan,
+                        Some(bool_ty),
+                        Some(prim_ok),
+                        vec![Operand::IdRef(prim), Operand::IdRef(c5)],
+                    ));
+                    let ib_ok = this.fresh();
+                    instructions.push(Self::inst(
+                        Op::INotEqual,
+                        Some(bool_ty),
+                        Some(ib_ok),
+                        vec![Operand::IdRef(ibuf_u64), Operand::IdRef(zero64)],
+                    ));
+                    let extra_ok = this.fresh();
+                    instructions.push(Self::inst(
+                        Op::LogicalAnd,
+                        Some(bool_ty),
+                        Some(extra_ok),
+                        vec![Operand::IdRef(prim_ok), Operand::IdRef(ib_ok)],
+                    ));
+                    this.emit_icb_draw_gate(
+                        icb_addr,
+                        slot_addr,
+                        RDNA4_ICB_CMD_BIT_DRAW_INDEXED,
+                        Some(extra_ok),
+                        instructions,
+                        |this, instructions| {
+                            let kind = this.const_uint(RDNA4_ICB_KIND_DRAW_INDEXED)?;
+                            let itype = this.const_uint(idx_type_val)?;
+                            let zero32 = this.const_uint(0)?;
+                            let zero64 = this.const_signed_int(64, 0)?;
+                            this.emit_icb_store(slot_addr, 0, &LlType::Int(32), 4, kind, instructions)?;
+                            this.emit_icb_store(slot_addr, 4, &LlType::Int(32), 4, prim, instructions)?;
+                            this.emit_icb_store(slot_addr, 8, &LlType::Int(32), 4, itype, instructions)?;
+                            this.emit_icb_store(slot_addr, 32, &LlType::Int(32), 4, icount_idx, instructions)?;
+                            this.emit_icb_store(slot_addr, 36, &LlType::Int(32), 4, inst_count, instructions)?;
+                            this.emit_icb_store(slot_addr, 40, &LlType::Int(32), 4, zero32, instructions)?;
+                            this.emit_icb_store(slot_addr, 44, &LlType::Int(32), 4, binst, instructions)?;
+                            this.emit_icb_store(slot_addr, 48, &LlType::Int(32), 4, bvert, instructions)?;
+                            this.emit_icb_store(slot_addr, 64, &LlType::Int(64), 8, ibuf_u64, instructions)?;
+                            this.emit_icb_store(slot_addr, 72, &LlType::Int(64), 8, zero64, instructions)?;
+                            this.emit_icb_store(slot_addr, 80, &LlType::Int(64), 8, zero64, instructions)
+                        },
+                    )
+                },
+            );
+        }
+
+        if typed(callee, "air.draw_patches_render_command")
+            || typed(callee, "air.draw_indexed_patches_render_command")
+        {
+            let indexed = typed(callee, "air.draw_indexed_patches_render_command");
+            let expected = if indexed { 12 } else { 11 };
+            if call.args.len() != expected {
+                return Err(format!(
+                    "native emitter: {callee} expects {expected} operands"
+                ));
+            }
+            let num_cp = self.value_id_in(&call.args[2].value, &call.args[2].ty, instructions)?;
+            let pstart = self.value_id_in(&call.args[3].value, &call.args[3].ty, instructions)?;
+            let pcount = self.value_id_in(&call.args[4].value, &call.args[4].ty, instructions)?;
+            let pib_u64 = self.resolve_icb_ptr_u64(&call.args[5], instructions)?;
+            let cpib_u64 = if indexed {
+                self.resolve_icb_ptr_u64(&call.args[6], instructions)?
+            } else {
+                self.const_signed_int(64, 0)?
+            };
+            let base_arg = if indexed { 7 } else { 6 };
+            let inst_count =
+                self.value_id_in(&call.args[base_arg].value, &call.args[base_arg].ty, instructions)?;
+            let binst = self.value_id_in(
+                &call.args[base_arg + 1].value,
+                &call.args[base_arg + 1].ty,
+                instructions,
+            )?;
+            let tfac_u64 = self.resolve_icb_ptr_u64(&call.args[base_arg + 2], instructions)?;
+            let istride = self.value_id_in(
+                &call.args[base_arg + 3].value,
+                &call.args[base_arg + 3].ty,
+                instructions,
+            )?;
+            let scale = self.value_id_in(
+                &call.args[base_arg + 4].value,
+                &call.args[base_arg + 4].ty,
+                instructions,
+            )?;
+            let cmd_bit = if indexed {
+                RDNA4_ICB_CMD_BIT_DRAW_INDEXED_PATCHES
+            } else {
+                RDNA4_ICB_CMD_BIT_DRAW_PATCHES
+            };
+            let kind_val = if indexed {
+                RDNA4_ICB_KIND_DRAW_INDEXED_PATCHES
+            } else {
+                RDNA4_ICB_KIND_DRAW_PATCHES
+            };
+            return self.emit_icb_guarded_slot(
+                &call.args[0],
+                &call.args[1],
+                instructions,
+                |this, icb_addr, slot_addr, instructions| {
+                    let bool_ty = this.type_id(&LlType::Bool)?;
+                    let zero64 = this.const_signed_int(64, 0)?;
+                    let tf_ok = this.fresh();
+                    instructions.push(Self::inst(
+                        Op::INotEqual,
+                        Some(bool_ty),
+                        Some(tf_ok),
+                        vec![Operand::IdRef(tfac_u64), Operand::IdRef(zero64)],
+                    ));
+                    let extra_ok = if indexed {
+                        let cp_ok = this.fresh();
+                        instructions.push(Self::inst(
+                            Op::INotEqual,
+                            Some(bool_ty),
+                            Some(cp_ok),
+                            vec![Operand::IdRef(cpib_u64), Operand::IdRef(zero64)],
+                        ));
+                        let both = this.fresh();
+                        instructions.push(Self::inst(
+                            Op::LogicalAnd,
+                            Some(bool_ty),
+                            Some(both),
+                            vec![Operand::IdRef(tf_ok), Operand::IdRef(cp_ok)],
+                        ));
+                        both
+                    } else {
+                        tf_ok
+                    };
+                    this.emit_icb_draw_gate(
+                        icb_addr,
+                        slot_addr,
+                        cmd_bit,
+                        Some(extra_ok),
+                        instructions,
+                        |this, instructions| {
+                            let kind = this.const_uint(kind_val)?;
+                            let zero32 = this.const_uint(0)?;
+                            this.emit_icb_store(slot_addr, 0, &LlType::Int(32), 4, kind, instructions)?;
+                            this.emit_icb_store(slot_addr, 4, &LlType::Int(32), 4, zero32, instructions)?;
+                            this.emit_icb_store(slot_addr, 8, &LlType::Int(32), 4, zero32, instructions)?;
+                            this.emit_icb_store(slot_addr, 32, &LlType::Int(32), 4, pcount, instructions)?;
+                            this.emit_icb_store(slot_addr, 36, &LlType::Int(32), 4, inst_count, instructions)?;
+                            this.emit_icb_store(slot_addr, 40, &LlType::Int(32), 4, pstart, instructions)?;
+                            this.emit_icb_store(slot_addr, 44, &LlType::Int(32), 4, binst, instructions)?;
+                            this.emit_icb_store(slot_addr, 48, &LlType::Int(32), 4, zero32, instructions)?;
+                            this.emit_icb_store(slot_addr, 52, &LlType::Int(32), 4, num_cp, instructions)?;
+                            this.emit_icb_store(slot_addr, 56, &LlType::Int(32), 4, istride, instructions)?;
+                            this.emit_icb_store(slot_addr, 60, &LlType::Float, 4, scale, instructions)?;
+                            this.emit_icb_store(slot_addr, 64, &LlType::Int(64), 8, cpib_u64, instructions)?;
+                            this.emit_icb_store(slot_addr, 72, &LlType::Int(64), 8, pib_u64, instructions)?;
+                            this.emit_icb_store(slot_addr, 80, &LlType::Int(64), 8, tfac_u64, instructions)
+                        },
+                    )
+                },
+            );
+        }
+
+        Err(format!("native emitter: unhandled render ICB intrinsic {callee}"))
+    }
+}
