+    fn ty_v2u32(&mut self) -> Word {
+        if let Some(id) = self.t_v2u32 {
+            return id;
+        }
+        let u = self.ty_u32();
+        let id = self.module.fresh_id();
+        self.module.types_global_values.push(Instruction::new(
+            Op::TypeVector,
+            None,
+            Some(id),
+            vec![Operand::IdRef(u), Operand::LiteralBit32(2)],
+        ));
+        self.t_v2u32 = Some(id);
