+        id
+    }
+
+    fn const_f32(&mut self, f: f32) -> Word {
+        let bits = f.to_bits();
+        if let Some(&id) = self.f32_consts.get(&bits) {
+            return id;
+        }
+        let t = self.ty_f32();
+        let id = self.module.fresh_id();
+        self.module.types_global_values.push(Instruction::new(
+            Op::Constant,
+            Some(t),
+            Some(id),
+            vec![Operand::LiteralBit32(bits)],
+        ));
+        self.f32_consts.insert(bits, id);
+        id
+    }
+
+    fn decorate(&mut self, target: Word, dec: Decoration, args: Vec<Operand>) {
+        let mut ops = vec![Operand::IdRef(target), Operand::Decoration(dec)];
+        ops.extend(args);
+        self.module
+            .annotations
+            .push(Instruction::new(Op::Decorate, None, None, ops));
+    }
+
+    fn member_decorate(&mut self, target: Word, member: u32, dec: Decoration, args: Vec<Operand>) {
+        let mut ops = vec![
+            Operand::IdRef(target),
+            Operand::LiteralBit32(member),
+            Operand::Decoration(dec),
+        ];
+        ops.extend(args);
+        self.module
+            .annotations
+            .push(Instruction::new(Op::MemberDecorate, None, None, ops));
+    }
+
+    fn op(&mut self, out: &mut Vec<Instruction>, op: Op, rt: Word, ops: Vec<Operand>) -> Word {
+        let id = self.module.fresh_id();
+        out.push(Instruction::new(op, Some(rt), Some(id), ops));
+        id
+    }
+
+    fn zero_of_type(&mut self, defs: &HashMap<Word, Instruction>, ty: Word) -> Word {
+        let Some(def) = defs.get(&ty) else {
+            return self.const_f32(0.0);
+        };
+        match def.class.opcode {
+            Op::TypeBool => {
+                if let Some(id) = self.c_false {
+                    return id;
+                }
+                let t = self.ty_bool();
+                let id = self.module.fresh_id();
+                self.module.types_global_values.push(Instruction::new(
+                    Op::ConstantFalse,
+                    Some(t),
+                    Some(id),
+                    vec![],
+                ));
+                self.c_false = Some(id);
+                id
+            }
+            Op::TypeFloat
+            | Op::TypeInt
+            | Op::TypeVector
+            | Op::TypeArray
+            | Op::TypeMatrix
+            | Op::TypeStruct => {
+                let id = self.module.fresh_id();
+                self.module.types_global_values.push(Instruction::new(
+                    Op::ConstantNull,
+                    Some(ty),
+                    Some(id),
+                    vec![],
+                ));
+                id
+            }
+            _ => self.const_f32(0.0),
+        }
+    }
+}
+
+fn defs_map(module: &Module) -> HashMap<Word, Instruction> {
+    module
+        .types_global_values
+        .iter()
+        .filter_map(|i| i.result_id.map(|id| (id, i.clone())))
+        .collect()
+}
+
+fn type_scalar_align(defs: &HashMap<Word, Instruction>, ty: Word) -> u32 {
+    fn inner(defs: &HashMap<Word, Instruction>, ty: Word, depth: u32) -> u32 {
+        if depth > 8 {
+            return 4;
+        }
+        let Some(def) = defs.get(&ty) else { return 4 };
+        match def.class.opcode {
+            Op::TypeBool => 1,
+            Op::TypeInt => match def.operands.first() {
+                Some(Operand::LiteralBit32(w)) => (*w / 8).clamp(1, 8),
+                _ => 4,
+            },
+            Op::TypeFloat => match def.operands.first() {
+                Some(Operand::LiteralBit32(w)) => (*w / 8).clamp(2, 8),
+                _ => 4,
+            },
+            Op::TypeVector | Op::TypeMatrix | Op::TypeArray | Op::TypeRuntimeArray => {
+                match def.operands.first() {
+                    Some(Operand::IdRef(elem)) => inner(defs, *elem, depth + 1),
+                    _ => 4,
+                }
+            }
+            Op::TypeStruct => def
+                .operands
+                .iter()
+                .filter_map(|o| match o {
+                    Operand::IdRef(m) => Some(inner(defs, *m, depth + 1)),
+                    _ => None,
+                })
+                .max()
+                .unwrap_or(4),
+            _ => 4,
+        }
+    }
+    inner(defs, ty, 0)
+}
+
+fn ptr_pointee(defs: &HashMap<Word, Instruction>, ptr_ty: Word) -> Option<(StorageClass, Word)> {
+    let def = defs.get(&ptr_ty)?;
+    if def.class.opcode != Op::TypePointer {
+        return None;
+    }
+    match def.operands.as_slice() {
+        [Operand::StorageClass(sc), Operand::IdRef(pt)] => Some((*sc, *pt)),
+        _ => None,
+    }
+}
+
+fn make_psb_access_operands(
+    ptr: Word,
+    val: Option<Word>,
+    extra: &[Operand],
+    pointee_ty: Word,
+    defs: &HashMap<Word, Instruction>,
+) -> Vec<Operand> {
+    let safe_align = type_scalar_align(defs, pointee_ty);
+    let mut mask = MemoryAccess::ALIGNED;
+    let mut existing_align = None;
+    let mut tail = Vec::new();
+    let mut idx = 0;
+    while idx < extra.len() {
+        match &extra[idx] {
+            Operand::MemoryAccess(ma) => {
+                mask |= *ma;
+                if ma.contains(MemoryAccess::ALIGNED) {
+                    if let Some(Operand::LiteralBit32(a)) = extra.get(idx + 1) {
+                        existing_align = Some(*a);
+                        idx += 2;
+                        continue;
+                    }
+                }
+            }
+            other => tail.push(other.clone()),
+        }
+        idx += 1;
+    }
+    let align = existing_align.map_or(safe_align, |a| a.min(safe_align).max(1));
+    let mut ops = vec![Operand::IdRef(ptr)];
+    if let Some(v) = val {
+        ops.push(Operand::IdRef(v));
+    }
+    ops.push(Operand::MemoryAccess(mask));
+    ops.push(Operand::LiteralBit32(align));
+    ops.extend(tail);
+    ops
+}
