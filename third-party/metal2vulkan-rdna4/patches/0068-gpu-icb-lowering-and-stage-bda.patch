+fn emit_psb_load32_fn(b: &mut SpirvBuilder<'_>) -> Word {
+    let u32_ty = b.ty_u32();
+    let u64_ty = b.ty_u64();
+    let bool_ty = b.ty_bool();
+    let psb_u32_ptr = b.ty_ptr(StorageClass::PhysicalStorageBuffer, u32_ty);
+
+    let c0_64 = b.const_u64(0);
+    let c3_64 = b.const_u64(3);
+    let c4_64 = b.const_u64(4);
+    let c_not3 = b.const_u64(!3u64);
+
+    let c0 = b.const_u32(0);
+    let c1 = b.const_u32(1);
+    let c2 = b.const_u32(2);
+    let c3 = b.const_u32(3);
+    let c4 = b.const_u32(4);
+    let c8 = b.const_u32(8);
+    let c32 = b.const_u32(32);
+    let c_ff = b.const_u32(0xFF);
+    let c_ffff = b.const_u32(0xFFFF);
+    let c_ffffff = b.const_u32(0x00FF_FFFF);
+    let c_all = b.const_u32(0xFFFF_FFFF);
+
+    let fn_ty = b.module.fresh_id();
+    b.module.types_global_values.push(Instruction::new(
+        Op::TypeFunction,
+        None,
+        Some(fn_ty),
+        vec![
+            Operand::IdRef(u32_ty),
+            Operand::IdRef(u64_ty),
+            Operand::IdRef(u64_ty),
+            Operand::IdRef(u32_ty),
+        ],
+    ));
+
+    let fn_id = b.module.fresh_id();
+    let p_base = b.module.fresh_id();
+    let p_off = b.module.fresh_id();
+    let p_len = b.module.fresh_id();
+
+    let l_entry = b.module.fresh_id();
+    let l_ok = b.module.fresh_id();
+    let l_w1 = b.module.fresh_id();
+    let l_w1m = b.module.fresh_id();
+    let l_unalign = b.module.fresh_id();
+    let l_sm = b.module.fresh_id();
+    let l_ret = b.module.fresh_id();
+
+    let mut e_insts = Vec::new();
+    let ok_base = b.op(
+        &mut e_insts,
+        Op::INotEqual,
+        bool_ty,
+        vec![Operand::IdRef(p_base), Operand::IdRef(c0_64)],
+    );
+    let ok_l1 = b.op(
+        &mut e_insts,
+        Op::UGreaterThanEqual,
+        bool_ty,
+        vec![Operand::IdRef(p_len), Operand::IdRef(c1)],
+    );
+    let ok_l4 = b.op(
+        &mut e_insts,
+        Op::ULessThanEqual,
+        bool_ty,
+        vec![Operand::IdRef(p_len), Operand::IdRef(c4)],
+    );
+    let ok_12 = b.op(
+        &mut e_insts,
+        Op::LogicalAnd,
+        bool_ty,
+        vec![Operand::IdRef(ok_base), Operand::IdRef(ok_l1)],
+    );
+    let inbounds = b.op(
+        &mut e_insts,
+        Op::LogicalAnd,
+        bool_ty,
+        vec![Operand::IdRef(ok_12), Operand::IdRef(ok_l4)],
+    );
+    e_insts.push(Instruction::new(
+        Op::SelectionMerge,
+        None,
+        None,
+        vec![
+            Operand::IdRef(l_ret),
+            Operand::SelectionControl(SelectionControl::NONE),
+        ],
+    ));
+    e_insts.push(Instruction::new(
+        Op::BranchConditional,
+        None,
+        None,
+        vec![
+            Operand::IdRef(inbounds),
+            Operand::IdRef(l_ok),
+            Operand::IdRef(l_ret),
+        ],
+    ));
+
+    let mut ok_insts = Vec::new();
+    let abs = b.op(
+        &mut ok_insts,
+        Op::IAdd,
+        u64_ty,
+        vec![Operand::IdRef(p_base), Operand::IdRef(p_off)],
+    );
+    let rem64 = b.op(
+        &mut ok_insts,
+        Op::BitwiseAnd,
+        u64_ty,
+        vec![Operand::IdRef(abs), Operand::IdRef(c3_64)],
+    );
+    let rem = b.op(&mut ok_insts, Op::UConvert, u32_ty, vec![Operand::IdRef(rem64)]);
+    let a0 = b.op(
+        &mut ok_insts,
+        Op::BitwiseAnd,
+        u64_ty,
+        vec![Operand::IdRef(abs), Operand::IdRef(c_not3)],
+    );
+    let ptr0 = b.op(&mut ok_insts, Op::ConvertUToPtr, psb_u32_ptr, vec![Operand::IdRef(a0)]);
+    let w0 = b.op(
+        &mut ok_insts,
+        Op::Load,
+        u32_ty,
+        vec![
+            Operand::IdRef(ptr0),
+            Operand::MemoryAccess(MemoryAccess::ALIGNED),
+            Operand::LiteralBit32(4),
+        ],
+    );
+    let span = b.op(
+        &mut ok_insts,
+        Op::IAdd,
+        u32_ty,
+        vec![Operand::IdRef(rem), Operand::IdRef(p_len)],
+    );
+    let need_w1 = b.op(
+        &mut ok_insts,
+        Op::UGreaterThan,
+        bool_ty,
+        vec![Operand::IdRef(span), Operand::IdRef(c4)],
+    );
+    ok_insts.push(Instruction::new(
+        Op::SelectionMerge,
+        None,
+        None,
+        vec![
+            Operand::IdRef(l_w1m),
+            Operand::SelectionControl(SelectionControl::NONE),
+        ],
+    ));
+    ok_insts.push(Instruction::new(
+        Op::BranchConditional,
+        None,
+        None,
+        vec![
+            Operand::IdRef(need_w1),
+            Operand::IdRef(l_w1),
+            Operand::IdRef(l_w1m),
+        ],
+    ));
+
+    let mut w1_insts = Vec::new();
+    let a1 = b.op(
+        &mut w1_insts,
+        Op::IAdd,
+        u64_ty,
+        vec![Operand::IdRef(a0), Operand::IdRef(c4_64)],
+    );
+    let ptr1 = b.op(&mut w1_insts, Op::ConvertUToPtr, psb_u32_ptr, vec![Operand::IdRef(a1)]);
+    let w1_val = b.op(
+        &mut w1_insts,
+        Op::Load,
+        u32_ty,
+        vec![
+            Operand::IdRef(ptr1),
+            Operand::MemoryAccess(MemoryAccess::ALIGNED),
+            Operand::LiteralBit32(4),
+        ],
+    );
+    w1_insts.push(Instruction::new(Op::Branch, None, None, vec![Operand::IdRef(l_w1m)]));
+
+    let mut w1m_insts = Vec::new();
+    let w1 = b.op(
+        &mut w1m_insts,
+        Op::Phi,
+        u32_ty,
+        vec![
+            Operand::IdRef(w1_val),
+            Operand::IdRef(l_w1),
+            Operand::IdRef(c0),
+            Operand::IdRef(l_ok),
+        ],
+    );
+    let rem0 = b.op(
+        &mut w1m_insts,
+        Op::IEqual,
+        bool_ty,
+        vec![Operand::IdRef(rem), Operand::IdRef(c0)],
+    );
+    w1m_insts.push(Instruction::new(
+        Op::SelectionMerge,
+        None,
+        None,
+        vec![
+            Operand::IdRef(l_sm),
+            Operand::SelectionControl(SelectionControl::NONE),
+        ],
+    ));
+    w1m_insts.push(Instruction::new(
+        Op::BranchConditional,
+        None,
+        None,
+        vec![
+            Operand::IdRef(rem0),
+            Operand::IdRef(l_sm),
+            Operand::IdRef(l_unalign),
+        ],
+    ));
+
+    let mut unalign_insts = Vec::new();
+    let sh0 = b.op(
+        &mut unalign_insts,
+        Op::IMul,
+        u32_ty,
+        vec![Operand::IdRef(rem), Operand::IdRef(c8)],
+    );
+    let sh1 = b.op(
+        &mut unalign_insts,
+        Op::ISub,
+        u32_ty,
+        vec![Operand::IdRef(c32), Operand::IdRef(sh0)],
+    );
+    let lo = b.op(
+        &mut unalign_insts,
+        Op::ShiftRightLogical,
+        u32_ty,
+        vec![Operand::IdRef(w0), Operand::IdRef(sh0)],
+    );
+    let hi = b.op(
+        &mut unalign_insts,
+        Op::ShiftLeftLogical,
+        u32_ty,
+        vec![Operand::IdRef(w1), Operand::IdRef(sh1)],
+    );
+    let comb = b.op(
+        &mut unalign_insts,
+        Op::BitwiseOr,
+        u32_ty,
+        vec![Operand::IdRef(lo), Operand::IdRef(hi)],
+    );
+    unalign_insts.push(Instruction::new(Op::Branch, None, None, vec![Operand::IdRef(l_sm)]));
+
+    let mut sm_insts = Vec::new();
+    let raw = b.op(
+        &mut sm_insts,
+        Op::Phi,
+        u32_ty,
+        vec![
+            Operand::IdRef(w0),
+            Operand::IdRef(l_w1m),
+            Operand::IdRef(comb),
+            Operand::IdRef(l_unalign),
+        ],
+    );
+    let is1 = b.op(&mut sm_insts, Op::IEqual, bool_ty, vec![Operand::IdRef(p_len), Operand::IdRef(c1)]);
+    let is2 = b.op(&mut sm_insts, Op::IEqual, bool_ty, vec![Operand::IdRef(p_len), Operand::IdRef(c2)]);
+    let is3 = b.op(&mut sm_insts, Op::IEqual, bool_ty, vec![Operand::IdRef(p_len), Operand::IdRef(c3)]);
+    let m34 = b.op(
+        &mut sm_insts,
+        Op::Select,
+        u32_ty,
+        vec![Operand::IdRef(is3), Operand::IdRef(c_ffffff), Operand::IdRef(c_all)],
+    );
+    let m24 = b.op(
+        &mut sm_insts,
+        Op::Select,
+        u32_ty,
+        vec![Operand::IdRef(is2), Operand::IdRef(c_ffff), Operand::IdRef(m34)],
+    );
+    let mask = b.op(
+        &mut sm_insts,
+        Op::Select,
+        u32_ty,
+        vec![Operand::IdRef(is1), Operand::IdRef(c_ff), Operand::IdRef(m24)],
+    );
+    let masked = b.op(
+        &mut sm_insts,
+        Op::BitwiseAnd,
+        u32_ty,
+        vec![Operand::IdRef(raw), Operand::IdRef(mask)],
+    );
+    sm_insts.push(Instruction::new(Op::Branch, None, None, vec![Operand::IdRef(l_ret)]));
+
+    let mut ret_insts = Vec::new();
+    let rphi = b.op(
+        &mut ret_insts,
+        Op::Phi,
+        u32_ty,
+        vec![
+            Operand::IdRef(masked),
+            Operand::IdRef(l_sm),
+            Operand::IdRef(c0),
+            Operand::IdRef(l_entry),
+        ],
+    );
+    ret_insts.push(Instruction::new(Op::ReturnValue, None, None, vec![Operand::IdRef(rphi)]));
+
+    let blocks = [
+        (l_entry, e_insts),
+        (l_ok, ok_insts),
+        (l_w1, w1_insts),
+        (l_w1m, w1m_insts),
+        (l_unalign, unalign_insts),
+        (l_sm, sm_insts),
+        (l_ret, ret_insts),
+    ]
+    .into_iter()
+    .map(|(lbl, insts)| Block {
+        label: Some(Instruction::new(Op::Label, None, Some(lbl), vec![])),
+        instructions: insts,
+    })
+    .collect();
+
+    b.module.functions.push(Function {
+        def: Some(Instruction::new(
+            Op::Function,
+            Some(u32_ty),
+            Some(fn_id),
+            vec![
+                Operand::FunctionControl(FunctionControl::NONE),
+                Operand::IdRef(fn_ty),
+            ],
+        )),
+        parameters: vec![
+            Instruction::new(Op::FunctionParameter, Some(u64_ty), Some(p_base), vec![]),
+            Instruction::new(Op::FunctionParameter, Some(u64_ty), Some(p_off), vec![]),
+            Instruction::new(Op::FunctionParameter, Some(u32_ty), Some(p_len), vec![]),
+        ],
+        blocks,
+        end: Some(Instruction::new(Op::FunctionEnd, None, None, vec![])),
+    });
+    fn_id
+}
+
+fn call_load32(b: &mut SpirvBuilder<'_>, out: &mut Vec<Instruction>, fn_load32: Word, base: Word, off: Word, len: u32) -> Word {
+    let u32_ty = b.ty_u32();
+    let len_c = b.const_u32(len);
+    b.op(
+        out,
+        Op::FunctionCall,
+        u32_ty,
+        vec![
+            Operand::IdRef(fn_load32),
+            Operand::IdRef(base),
+            Operand::IdRef(off),
+            Operand::IdRef(len_c),
+        ],
+    )
+}
+
+fn decode_vfmt_lanes(
+    b: &mut SpirvBuilder<'_>,
+    out: &mut Vec<Instruction>,
+    vfmt: u8,
+    w: &[Word; 4],
+) -> Result<(Vec<Word>, ScalarKind), String> {
+    let u32_ty = b.ty_u32();
+    let i32_ty = b.ty_i32();
+    let f32_ty = b.ty_f32();
+    let v2f32_ty = b.ty_vec(f32_ty, 2);
+    let glsl = b.ensure_glsl();
+    let mut lanes = Vec::new();
+    let s = match vfmt {
+        1..=4 => {
+            let n = (vfmt - 1) + 1;
+            let c8 = b.const_u32(8);
+            for c in 0..n {
+                let off = b.const_u32(u32::from(c) * 8);
+                let l = b.op(out, Op::BitFieldUExtract, u32_ty, vec![Operand::IdRef(w[0]), Operand::IdRef(off), Operand::IdRef(c8)]);
+                lanes.push(l);
+            }
+            ScalarKind::U32
+        }
+        5..=8 => {
+            let n = (vfmt - 5) + 1;
+            let c8 = b.const_u32(8);
+            let w0s = b.op(out, Op::Bitcast, i32_ty, vec![Operand::IdRef(w[0])]);
+            for c in 0..n {
+                let off = b.const_u32(u32::from(c) * 8);
+                let l = b.op(out, Op::BitFieldSExtract, i32_ty, vec![Operand::IdRef(w0s), Operand::IdRef(off), Operand::IdRef(c8)]);
+                lanes.push(l);
+            }
+            ScalarKind::S32
+        }
+        9..=12 => {
+            let n = (vfmt - 9) + 1;
+            let c8 = b.const_u32(8);
+            let scale = b.const_f32(1.0 / 255.0);
+            for c in 0..n {
+                let off = b.const_u32(u32::from(c) * 8);
+                let u = b.op(out, Op::BitFieldUExtract, u32_ty, vec![Operand::IdRef(w[0]), Operand::IdRef(off), Operand::IdRef(c8)]);
+                let f = b.op(out, Op::ConvertUToF, f32_ty, vec![Operand::IdRef(u)]);
+                let nm = b.op(out, Op::FMul, f32_ty, vec![Operand::IdRef(f), Operand::IdRef(scale)]);
+                lanes.push(nm);
+            }
+            ScalarKind::F32
+        }
+        13..=16 => {
+            let n = (vfmt - 13) + 1;
+            let c8 = b.const_u32(8);
+            let scale = b.const_f32(1.0 / 127.0);
+            let neg1 = b.const_f32(-1.0);
+            let w0s = b.op(out, Op::Bitcast, i32_ty, vec![Operand::IdRef(w[0])]);
+            for c in 0..n {
+                let off = b.const_u32(u32::from(c) * 8);
+                let s = b.op(out, Op::BitFieldSExtract, i32_ty, vec![Operand::IdRef(w0s), Operand::IdRef(off), Operand::IdRef(c8)]);
+                let f = b.op(out, Op::ConvertSToF, f32_ty, vec![Operand::IdRef(s)]);
+                let sc = b.op(out, Op::FMul, f32_ty, vec![Operand::IdRef(f), Operand::IdRef(scale)]);
+                let nm = b.op(out, Op::ExtInst, f32_ty, vec![Operand::IdRef(glsl), Operand::LiteralExtInstInteger(40), Operand::IdRef(sc), Operand::IdRef(neg1)]);
+                lanes.push(nm);
+            }
+            ScalarKind::F32
+        }
+        17 => {
+            let c8 = b.const_u32(8);
+            let scale = b.const_f32(1.0 / 255.0);
+            for byte_idx in [2u32, 1, 0, 3] {
+                let off = b.const_u32(byte_idx * 8);
+                let u = b.op(out, Op::BitFieldUExtract, u32_ty, vec![Operand::IdRef(w[0]), Operand::IdRef(off), Operand::IdRef(c8)]);
+                let f = b.op(out, Op::ConvertUToF, f32_ty, vec![Operand::IdRef(u)]);
+                let nm = b.op(out, Op::FMul, f32_ty, vec![Operand::IdRef(f), Operand::IdRef(scale)]);
+                lanes.push(nm);
+            }
+            ScalarKind::F32
+        }
+        18..=21 => {
+            let n = (vfmt - 18) + 1;
+            let c16 = b.const_u32(16);
+            for c in 0..n {
+                let word = w[(c / 2) as usize];
+                let off = b.const_u32(u32::from(c & 1) * 16);
+                let u = b.op(out, Op::BitFieldUExtract, u32_ty, vec![Operand::IdRef(word), Operand::IdRef(off), Operand::IdRef(c16)]);
+                lanes.push(u);
+            }
+            ScalarKind::U32
+        }
+        22..=25 => {
+            let n = (vfmt - 22) + 1;
+            let c16 = b.const_u32(16);
+            for c in 0..n {
+                let ws = b.op(out, Op::Bitcast, i32_ty, vec![Operand::IdRef(w[(c / 2) as usize])]);
+                let off = b.const_u32(u32::from(c & 1) * 16);
+                let s = b.op(out, Op::BitFieldSExtract, i32_ty, vec![Operand::IdRef(ws), Operand::IdRef(off), Operand::IdRef(c16)]);
+                lanes.push(s);
+            }
+            ScalarKind::S32
+        }
+        26..=29 => {
+            let n = (vfmt - 26) + 1;
+            let c16 = b.const_u32(16);
+            let scale = b.const_f32(1.0 / 65535.0);
+            for c in 0..n {
+                let word = w[(c / 2) as usize];
+                let off = b.const_u32(u32::from(c & 1) * 16);
+                let u = b.op(out, Op::BitFieldUExtract, u32_ty, vec![Operand::IdRef(word), Operand::IdRef(off), Operand::IdRef(c16)]);
+                let f = b.op(out, Op::ConvertUToF, f32_ty, vec![Operand::IdRef(u)]);
+                let nm = b.op(out, Op::FMul, f32_ty, vec![Operand::IdRef(f), Operand::IdRef(scale)]);
+                lanes.push(nm);
+            }
+            ScalarKind::F32
+        }
+        30..=33 => {
+            let n = (vfmt - 30) + 1;
+            let c16 = b.const_u32(16);
+            let scale = b.const_f32(1.0 / 32767.0);
+            let neg1 = b.const_f32(-1.0);
+            for c in 0..n {
+                let ws = b.op(out, Op::Bitcast, i32_ty, vec![Operand::IdRef(w[(c / 2) as usize])]);
+                let off = b.const_u32(u32::from(c & 1) * 16);
+                let s = b.op(out, Op::BitFieldSExtract, i32_ty, vec![Operand::IdRef(ws), Operand::IdRef(off), Operand::IdRef(c16)]);
+                let f = b.op(out, Op::ConvertSToF, f32_ty, vec![Operand::IdRef(s)]);
+                let sc = b.op(out, Op::FMul, f32_ty, vec![Operand::IdRef(f), Operand::IdRef(scale)]);
+                let nm = b.op(out, Op::ExtInst, f32_ty, vec![Operand::IdRef(glsl), Operand::LiteralExtInstInteger(40), Operand::IdRef(sc), Operand::IdRef(neg1)]);
+                lanes.push(nm);
+            }
+            ScalarKind::F32
+        }
+        34..=37 => {
+            let n = (vfmt - 34) + 1;
+            let p0 = b.op(out, Op::ExtInst, v2f32_ty, vec![Operand::IdRef(glsl), Operand::LiteralExtInstInteger(55), Operand::IdRef(w[0])]);
+            let p1 = if n > 2 {
+                Some(b.op(out, Op::ExtInst, v2f32_ty, vec![Operand::IdRef(glsl), Operand::LiteralExtInstInteger(55), Operand::IdRef(w[1])]))
+            } else {
+                None
+            };
+            for c in 0..n {
+                let pair = if c < 2 { p0 } else { p1.unwrap() };
+                let f = b.op(out, Op::CompositeExtract, f32_ty, vec![Operand::IdRef(pair), Operand::LiteralBit32(u32::from(c & 1))]);
+                lanes.push(f);
+            }
+            ScalarKind::F32
+        }
+        38..=41 => {
+            let n = (vfmt - 38) + 1;
+            for c in 0..n {
+                let f = b.op(out, Op::Bitcast, f32_ty, vec![Operand::IdRef(w[c as usize])]);
+                lanes.push(f);
+            }
+            ScalarKind::F32
+        }
+        42..=45 => {
+            let n = (vfmt - 42) + 1;
+            for c in 0..n {
+                let s = b.op(out, Op::Bitcast, i32_ty, vec![Operand::IdRef(w[c as usize])]);
+                lanes.push(s);
+            }
+            ScalarKind::S32
+        }
+        46..=49 => {
+            let n = (vfmt - 46) + 1;
+            for c in 0..n {
+                lanes.push(w[c as usize]);
+            }
+            ScalarKind::U32
+        }
+        50 => {
+            let ws = b.op(out, Op::Bitcast, i32_ty, vec![Operand::IdRef(w[0])]);
+            let c10 = b.const_u32(10);
+            let c2 = b.const_u32(2);
+            let neg1 = b.const_f32(-1.0);
+            let s511 = b.const_f32(1.0 / 511.0);
+            for c in 0..4u32 {
+                let off = b.const_u32(c * 10);
+                let bits = if c < 3 { c10 } else { c2 };
+                let s = b.op(out, Op::BitFieldSExtract, i32_ty, vec![Operand::IdRef(ws), Operand::IdRef(off), Operand::IdRef(bits)]);
+                let f = b.op(out, Op::ConvertSToF, f32_ty, vec![Operand::IdRef(s)]);
+                let sc = if c < 3 {
+                    b.op(out, Op::FMul, f32_ty, vec![Operand::IdRef(f), Operand::IdRef(s511)])
+                } else {
+                    f
+                };
+                let nm = b.op(out, Op::ExtInst, f32_ty, vec![Operand::IdRef(glsl), Operand::LiteralExtInstInteger(40), Operand::IdRef(sc), Operand::IdRef(neg1)]);
+                lanes.push(nm);
+            }
+            ScalarKind::F32
+        }
+        51 => {
+            let c10 = b.const_u32(10);
+            let c2 = b.const_u32(2);
+            let u1023 = b.const_f32(1.0 / 1023.0);
+            let u3 = b.const_f32(1.0 / 3.0);
+            for c in 0..4u32 {
+                let off = b.const_u32(c * 10);
+                let bits = if c < 3 { c10 } else { c2 };
+                let u = b.op(out, Op::BitFieldUExtract, u32_ty, vec![Operand::IdRef(w[0]), Operand::IdRef(off), Operand::IdRef(bits)]);
+                let f = b.op(out, Op::ConvertUToF, f32_ty, vec![Operand::IdRef(u)]);
+                let sc = b.op(out, Op::FMul, f32_ty, vec![Operand::IdRef(f), Operand::IdRef(if c < 3 { u1023 } else { u3 })]);
+                lanes.push(sc);
+            }
+            ScalarKind::F32
+        }
+        other => return Err(format!("icb_stage: unsupported vertex format {other}")),
+    };
+    Ok((lanes, s))
+}
+
+fn vfmt_bytes(vfmt: u8) -> Option<u32> {
+    Some(match vfmt {
+        1 | 5 | 9 | 13 => 1,
+        2 | 6 | 10 | 14 | 18 | 22 | 26 | 30 | 34 => 2,
+        3 | 7 | 11 | 15 => 3,
+        4 | 8 | 12 | 16 | 17 | 19 | 23 | 27 | 31 | 35 | 38 | 42 | 46 | 50 | 51 => 4,
+        20 | 24 | 28 | 32 | 36 => 6,
+        21 | 25 | 29 | 33 | 37 | 39 | 43 | 47 => 8,
+        40 | 44 | 48 => 12,
+        41 | 45 | 49 => 16,
+        _ => return None,
+    })
+}
+
+fn scalar_kind_of_type(defs: &HashMap<Word, Instruction>, ty: Word) -> Option<(ScalarKind, u32)> {
+    let mut t = ty;
+    let mut comps = 1u32;
+    if let Some(def) = defs.get(&ty) {
+        if def.class.opcode == Op::TypeVector {
+            let [Operand::IdRef(e), Operand::LiteralBit32(n)] = def.operands.as_slice() else {
+                return None;
+            };
+            t = *e;
+            comps = *n;
+        }
+    }
+    let def = defs.get(&t)?;
+    let kind = match def.class.opcode {
+        Op::TypeFloat => match def.operands.first() {
+            Some(Operand::LiteralBit32(16)) => ScalarKind::F16,
+            Some(Operand::LiteralBit32(32)) => ScalarKind::F32,
+            _ => return None,
+        },
+        Op::TypeInt => match def.operands.as_slice() {
+            [Operand::LiteralBit32(32), Operand::LiteralBit32(0)] => ScalarKind::U32,
+            [Operand::LiteralBit32(32), Operand::LiteralBit32(1)] => ScalarKind::S32,
+            [Operand::LiteralBit32(16), Operand::LiteralBit32(0)] => ScalarKind::U16,
+            [Operand::LiteralBit32(16), Operand::LiteralBit32(1)] => ScalarKind::S16,
+            _ => return None,
+        },
+        _ => return None,
+    };
+    Some((kind, comps))
+}
+
+fn convert_scalar(
+    b: &mut SpirvBuilder<'_>,
+    out: &mut Vec<Instruction>,
+    val: Word,
+    src: ScalarKind,
+    dst: ScalarKind,
+) -> Word {
+    use ScalarKind::*;
+    let dst_ty = b.ty_scalar(dst);
+    match (src, dst) {
+        (U32, U32) | (S32, S32) | (F32, F32) | (F16, F16) | (U16, U16) | (S16, S16) => val,
+        (F32, F16) | (F16, F32) => b.op(out, Op::FConvert, dst_ty, vec![Operand::IdRef(val)]),
+        (U32 | U16, F32 | F16) => b.op(out, Op::ConvertUToF, dst_ty, vec![Operand::IdRef(val)]),
+        (S32 | S16, F32 | F16) => b.op(out, Op::ConvertSToF, dst_ty, vec![Operand::IdRef(val)]),
+        (F32 | F16, U32 | U16) => b.op(out, Op::ConvertFToU, dst_ty, vec![Operand::IdRef(val)]),
+        (F32 | F16, S32 | S16) => b.op(out, Op::ConvertFToS, dst_ty, vec![Operand::IdRef(val)]),
+        (U32, S32) | (S32, U32) | (U16, S16) | (S16, U16) => {
+            b.op(out, Op::Bitcast, dst_ty, vec![Operand::IdRef(val)])
+        }
+        (U32 | S32, U16) | (U16, U32) | (S16, U32) => {
+            b.op(out, Op::UConvert, dst_ty, vec![Operand::IdRef(val)])
+        }
+        (U32 | S32, S16) | (S16, S32) | (U16, S32) => {
+            b.op(out, Op::SConvert, dst_ty, vec![Operand::IdRef(val)])
+        }
+    }
+}
+
+fn pad_scalar_const(b: &mut SpirvBuilder<'_>, dst: ScalarKind, lane: usize) -> Word {
+    use ScalarKind::*;
+    let one = lane == 3;
+    match dst {
+        F32 => b.const_f32(if one { 1.0 } else { 0.0 }),
+        U32 => b.const_u32(u32::from(one)),
+        S32 => b.const_i32(i32::from(one)),
+        F16 | U16 | S16 => {
+            let t = b.ty_scalar(dst);
+            let id = b.module.fresh_id();
+            b.module
+                .types_global_values
+                .push(Instruction::new(Op::ConstantNull, Some(t), Some(id), vec![]));
+            id
+        }
+    }
+}
+
+fn convert_lanes_to_type(
+    b: &mut SpirvBuilder<'_>,
+    out: &mut Vec<Instruction>,
+    lanes: &[Word],
+    src_kind: ScalarKind,
+    dst_kind: ScalarKind,
+    dst_comps: u32,
+) -> Word {
+    let mut conv = Vec::with_capacity(dst_comps as usize);
+    for c in 0..(dst_comps as usize) {
+        let v = if c < lanes.len() {
+            convert_scalar(b, out, lanes[c], src_kind, dst_kind)
+        } else if c == 3 {
+            match dst_kind {
+                ScalarKind::F16 => {
+                    let f1 = b.const_f32(1.0);
+                    convert_scalar(b, out, f1, ScalarKind::F32, ScalarKind::F16)
+                }
+                ScalarKind::U16 => {
+                    let u1 = b.const_u32(1);
+                    convert_scalar(b, out, u1, ScalarKind::U32, ScalarKind::U16)
+                }
+                ScalarKind::S16 => {
+                    let s1 = b.const_i32(1);
+                    convert_scalar(b, out, s1, ScalarKind::S32, ScalarKind::S16)
+                }
+                _ => pad_scalar_const(b, dst_kind, c),
+            }
+        } else {
+            pad_scalar_const(b, dst_kind, c)
+        };
+        conv.push(v);
+    }
+    if dst_comps == 1 {
+        return conv[0];
+    }
+    let st = b.ty_scalar(dst_kind);
+    let vt = b.ty_vec(st, dst_comps);
+    b.op(
+        out,
+        Op::CompositeConstruct,
+        vt,
+        conv.into_iter().map(Operand::IdRef).collect(),
+    )
+}
+
+fn lower_existing_psb_table_load(
+    b: &mut SpirvBuilder<'_>,
+    out: &mut Vec<Instruction>,
+    table_var: Word,
+    table_u64_arr_ptr: Option<(Word, bool)>,
+    slot_u32: u32,
+    word_group_offset: u32,
+) -> Word {
+    let u64_ty = b.ty_u64();
+    let idx = b.const_u32(word_group_offset + slot_u32);
+    let c0 = b.const_u32(0);
+    if let Some((ptr_ty, true)) = table_u64_arr_ptr {
+        let v2_ty = b.ty_v2u32();
+        let ac = b.op(
+            out,
+            Op::AccessChain,
+            ptr_ty,
+            vec![Operand::IdRef(table_var), Operand::IdRef(c0), Operand::IdRef(idx)],
+        );
+        let vec = b.op(out, Op::Load, v2_ty, vec![Operand::IdRef(ac)]);
+        return b.op(out, Op::Bitcast, u64_ty, vec![Operand::IdRef(vec)]);
+    }
+    let ptr_ty = b.ty_ptr(StorageClass::StorageBuffer, u64_ty);
+    let ac = b.op(
+        out,
+        Op::AccessChain,
+        ptr_ty,
+        vec![Operand::IdRef(table_var), Operand::IdRef(c0), Operand::IdRef(idx)],
+    );
+    b.op(out, Op::Load, u64_ty, vec![Operand::IdRef(ac)])
+}
+
+pub fn lower_icb_stage(
+    spv: &[u8],
+    stage_kind: u32,
+    stage_set: u32,
+    vattrs: &[IcbVertexAttr],
+) -> Result<(Vec<u8>, u32, u32), String> {
+    if stage_kind > 2 {
+        return Err(format!("icb_stage: unsupported stage_kind {stage_kind}"));
+    }
+    let mut module = crate::spirv_module::load_bytes(spv)
+        .map_err(|e| format!("icb_stage: invalid SPIR-V: {e:?}"))?;
+    module.sync_id_bound_from_instructions();
+
+    if let Some(hdr) = module.header.as_mut() {
+        if hdr.version() < (1, 5) {
+            hdr.set_version(1, 5);
+        }
+    }
+
+    let ep_idx = 0usize;
+    let entry_fn_id = match module
+        .entry_points
+        .get(ep_idx)
+        .and_then(|ep| ep.operands.get(1))
+    {
+        Some(Operand::IdRef(id)) => *id,
+        _ => return Err("icb_stage: module has no OpEntryPoint".into()),
+    };
+
+    let defs_initial = defs_map(&module);
+    let mut sets: HashMap<Word, u32> = HashMap::new();
+    let mut bindings: HashMap<Word, u32> = HashMap::new();
+    let mut var_builtins: HashMap<Word, BuiltIn> = HashMap::new();
+    let mut var_locs: HashMap<Word, u32> = HashMap::new();
+    let mut member_offsets: HashMap<(Word, u32), u32> = HashMap::new();
+    let mut member_builtins: HashMap<(Word, u32), BuiltIn> = HashMap::new();
+    let mut array_strides: HashMap<Word, u32> = HashMap::new();
+    let mut buffer_block_structs: HashSet<Word> = HashSet::new();
+    let mut const_u32_map: HashMap<Word, u32> = HashMap::new();
+    for inst in &module.types_global_values {
+        if inst.class.opcode == Op::Constant {
