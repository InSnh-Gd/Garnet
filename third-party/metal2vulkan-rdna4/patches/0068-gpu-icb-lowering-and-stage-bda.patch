+    fn ty_scalar(&mut self, k: ScalarKind) -> Word {
+        match k {
+            ScalarKind::U32 => self.ty_u32(),
+            ScalarKind::S32 => self.ty_i32(),
+            ScalarKind::F32 => self.ty_f32(),
+            ScalarKind::F16 => self.ty_f16(),
+            ScalarKind::U16 => self.ty_u16(),
+            ScalarKind::S16 => self.ty_i16(),
+        }
+    }
