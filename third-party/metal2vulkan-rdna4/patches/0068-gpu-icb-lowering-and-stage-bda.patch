+    fn test_translate(ll: &str, stage: crate::passes::Stage) -> Vec<u8> {
+        let tmp = std::env::temp_dir().join(format!("icb_stage_{}", std::process::id()));
+        let _ = std::fs::create_dir_all(&tmp);
