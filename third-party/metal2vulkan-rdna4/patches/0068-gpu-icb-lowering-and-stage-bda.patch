+    fn const_u32(&mut self, v: u32) -> Word {
+        if let Some(&id) = self.u32_consts.get(&v) {
+            return id;
+        }
+        let t = self.ty_u32();
+        let id = self.module.fresh_id();
+        self.module.types_global_values.push(Instruction::new(
+            Op::Constant,
+            Some(t),
+            Some(id),
+            vec![Operand::LiteralBit32(v)],
+        ));
+        self.u32_consts.insert(v, id);
+        id
+    }
+
+    fn const_i32(&mut self, v: i32) -> Word {
+        let t = self.ty_i32();
+        let bits = v as u32;
+        for inst in &self.module.types_global_values {
+            if inst.class.opcode == Op::Constant
+                && inst.result_type == Some(t)
+                && inst.operands.as_slice() == [Operand::LiteralBit32(bits)]
+            {
+                if let Some(id) = inst.result_id {
+                    return id;
+                }
+            }
+        }
+        let id = self.module.fresh_id();
+        self.module.types_global_values.push(Instruction::new(
+            Op::Constant,
+            Some(t),
+            Some(id),
+            vec![Operand::LiteralBit32(bits)],
+        ));
+        id
+    }
