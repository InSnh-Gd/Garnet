+    fn ty_vec(&mut self, elem: Word, n: u32) -> Word {
+        if n == 1 {
+            return elem;
+        }
+        for inst in &self.module.types_global_values {
+            if inst.class.opcode == Op::TypeVector
+                && inst.operands.as_slice() == [Operand::IdRef(elem), Operand::LiteralBit32(n)]
+            {
+                if let Some(id) = inst.result_id {
+                    return id;
+                }
+            }
+        }
+        let id = self.module.fresh_id();
+        self.module.types_global_values.push(Instruction::new(
+            Op::TypeVector,
+            None,
+            Some(id),
+            vec![Operand::IdRef(elem), Operand::LiteralBit32(n)],
+        ));
+        id
+    }
