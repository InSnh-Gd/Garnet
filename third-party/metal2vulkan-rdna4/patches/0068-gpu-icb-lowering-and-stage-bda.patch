+    fn const_u64(&mut self, v: u64) -> Word {
+        if let Some(&id) = self.u64_consts.get(&v) {
+            return id;
+        }
+        let t = self.ty_u64();
+        let id = self.module.fresh_id();
+        self.module.types_global_values.push(Instruction::new(
+            Op::Constant,
+            Some(t),
+            Some(id),
+            vec![Operand::LiteralBit64(v)],
