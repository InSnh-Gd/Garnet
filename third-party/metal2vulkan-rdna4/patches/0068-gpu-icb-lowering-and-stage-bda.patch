+    fn input_var_locations(spv: &[u8]) -> Vec<u32> {
+        let m = crate::spirv_module::load_bytes(spv).expect("load spv");
+        let input_vars: HashSet<Word> = m
+            .types_global_values
+            .iter()
+            .filter(|i| {
+                i.class.opcode == Op::Variable
+                    && matches!(i.operands.first(), Some(Operand::StorageClass(StorageClass::Input)))
+            })
+            .filter_map(|i| i.result_id)
+            .collect();
+        m.annotations
+            .iter()
+            .filter_map(|a| {
+                if a.class.opcode == Op::Decorate {
+                    if let [Operand::IdRef(t), Operand::Decoration(Decoration::Location), Operand::LiteralBit32(l)] =
+                        a.operands.as_slice()
+                    {
+                        if input_vars.contains(t) {
+                            return Some(*l);
+                        }
+                    }
+                }
+                None
+            })
+            .collect()
+    }
