diff --git a/tests/embedded_multisample.rs b/tests/embedded_multisample.rs
new file mode 100644
--- /dev/null
+++ b/tests/embedded_multisample.rs
@@ -0,0 +1,83 @@
+use metal2vulkan::passes::{Stage, TransformOptions};
+
+fn source(array: bool) -> String {
+    let (field, member, count, coordinate) = if array {
+        (
+            "[2 x %Image]",
+            "array<texture2d_ms<float, read>, 2>",
+            2,
+            "i64 0, i32 0, i64 %index, i32 0",
+        )
+    } else {
+        (
+            "%Image",
+            "texture2d_ms<float, read>",
+            1,
+            "i64 0, i32 0, i32 0",
+        )
+    };
+    format!(
+        r#"target triple = "air64-apple-macosx"
+%Root = type {{ {field} }}
+%Image = type {{ ptr addrspace(1) }}
+define void @entry(ptr addrspace(2) %args, ptr addrspace(1) %out, i32 %i) {{
+entry:
+  %selected = and i32 %i, 1
+  %index = zext i32 %selected to i64
+  %slot = getelementptr %Root, ptr addrspace(2) %args, {coordinate}
+  %image = load ptr addrspace(1), ptr addrspace(2) %slot, align 8
+  %read = call {{ <4 x float>, i8 }} @air.read_texture_2d_ms.v4f32(ptr addrspace(1) %image, ptr addrspace(2) null, <2 x i32> <i32 2, i32 1>, i32 2, i32 1)
+  %texel = extractvalue {{ <4 x float>, i8 }} %read, 0
+  %value = extractelement <4 x float> %texel, i32 0
+  store float %value, ptr addrspace(1) %out, align 4
+  ret void
+}}
+declare {{ <4 x float>, i8 }} @air.read_texture_2d_ms.v4f32(ptr addrspace(1), ptr addrspace(2), <2 x i32>, i32, i32)
+!air.kernel = !{{!0}}
+!0 = !{{ptr @entry, !1, !2}}
+!1 = !{{}}
+!2 = !{{!3, !6, !7}}
+!3 = !{{i32 0, !"air.indirect_buffer", !"air.buffer_size", i32 {bytes}, !"air.location_index", i32 3, i32 1, !"air.read", !"air.address_space", i32 2, !"air.struct_type_info", !4, !"air.arg_type_name", !"Root"}}
+!4 = !{{i32 0, i32 {bytes}, i32 0, !"{member}", !"images", !"air.indirect_argument", !5}}
+!5 = !{{i32 0, !"air.texture", !"air.location_index", i32 0, i32 {count}, !"air.read", !"air.arg_type_name", !"{member}"}}
+!6 = !{{i32 1, !"air.buffer", !"air.location_index", i32 0, i32 1, !"air.write", !"air.address_space", i32 1, !"air.arg_type_name", !"float*"}}
+!7 = !{{i32 2, !"air.thread_position_in_grid", !"air.arg_type_name", !"uint"}}
+"#,
+        bytes = count * 8
+    )
+}
+
+#[test]
+fn embedded_multisample_images_keep_the_sample_operand_and_reflection() {
+    for array in [false, true] {
+        let directory = std::env::temp_dir().join(format!(
+            "embedded-multisample-{}-{array}",
+            std::process::id()
+        ));
+        std::fs::create_dir_all(&directory).unwrap();
+        let (spv, reflection) = metal2vulkan::translate_sanitized_native_reflected_unvalidated(
+            &source(array),
+            Stage::Kernel,
+            &directory,
+            TransformOptions::default(),
+            None,
+        )
+        .unwrap();
+        let text = metal2vulkan::disassemble(&spv).unwrap();
+        let fetch = text
+            .lines()
+            .find(|line| line.contains("OpImageFetch "))
+            .unwrap();
+        assert!(
+            fetch.contains("Sample ") && !fetch.contains("Lod "),
+            "{text}"
+        );
+        assert!(reflection.bindings.iter().any(|binding| binding
+            .texture_shape
+            .as_ref()
+            .is_some_and(|shape| shape.multisampled)));
+        reflection.validate_descriptor_abi().unwrap();
+        metal2vulkan::tools::spirv_val_bytes(&spv, &directory).unwrap();
+        std::fs::remove_dir_all(directory).unwrap();
+    }
+}
