+pub(super) fn detect_embedded_acceleration_structures(
+    nodes: &HashMap<u32, String>,
+    argument_buffers: &ArgumentBuffers,
+) -> Vec<EmbeddedAccelerationStructure> {
+    argument_buffers
+        .iter()
+        .flat_map(|(buffer_param_index, buffer_index, sref)| {
+            embedded_argument_members(nodes, sref)
+                .into_iter()
+                .filter(|member| member.depth == 0)
+                .filter_map(move |member| {
+                    let node = nodes.get(&member.node_ref)?;
+                    let roles = role_strings(node);
+                    let is_instance = if roles.iter().any(|r| r == "instance_acceleration_structure")
+                    {
+                        true
+                    } else if roles.iter().any(|r| r == "primitive_acceleration_structure") {
+                        false
+                    } else {
+                        return None;
+                    };
+                    Some(EmbeddedAccelerationStructure {
+                        buffer_param_index,
+                        buffer_index,
+                        field_ordinal: member.field_ordinal,
+                        field_offset: member.field_offset,
+                        argument_index: member.argument_index(node),
+                        is_instance,
+                    })
+                })
+        })
+        .collect()
+}
