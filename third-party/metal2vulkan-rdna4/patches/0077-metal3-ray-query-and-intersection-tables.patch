+#[cfg(test)]
+mod tests {
+    use crate::linked_functions::{
+        IntersectionFunctionKind, LinkedFunctionLinkage, LinkedIntersectionFunction,
+    };
+    use crate::passes::{Stage, TransformOptions};
+    use crate::reflect::{
+        AccelerationStructureBindingMode, AccelerationStructureKind, ResourceKind,
+    };
+    use crate::spirv_module::load_bytes;
+    use crate::spirv_operand::Operand;
+    use spirv::{Capability, Op};
+    use std::path::Path;
+
+    fn translate_rq(
+        ll: &str,
+        stage: Stage,
+    ) -> (crate::spirv_module::Module, crate::reflect::ShaderReflection) {
+        let opts = TransformOptions::default().with_hardware_ray_query();
+        let (bytes, refl) = crate::translate_sanitized_native_reflected_unvalidated(
+            ll,
+            stage,
+            Path::new(""),
+            opts,
+            None,
+        )
+        .expect("translate ray query shader");
+        let module = load_bytes(&bytes).expect("parse SPIR-V");
+        (module, refl)
+    }
+
+    fn has_op(m: &crate::spirv_module::Module, op: Op) -> bool {
+        m.all_inst_iter().any(|i| i.class.opcode == op)
+    }
+
+    fn has_cap(m: &crate::spirv_module::Module, cap: Capability) -> bool {
+        m.capabilities
+            .iter()
+            .any(|i| i.operands.first() == Some(&Operand::Capability(cap)))
+    }
+
+    fn has_ext(m: &crate::spirv_module::Module, ext: &str) -> bool {
+        m.extensions
+            .iter()
+            .any(|i| i.operands.first() == Some(&Operand::LiteralString(ext.to_string())))
+    }
+
+    #[test]
+    fn compute_descriptor_as_instancing_triangle_and_world_space_data() {
+        let ll = r#"
+define void @rt_compute(ptr addrspace(1) %as, ptr addrspace(1) %out, i32 %tid) {
+entry:
+  %accept_any = icmp ne i32 %tid, 0
+  %hit = call { i32, float, i32, i32, ptr addrspace(1), i32, i32, <2 x float>, i1, <3 x float>, <3 x float>, <3 x float>, <3 x float>, <3 x float>, <3 x float>, <3 x float>, <3 x float> } @air.intersect.instancing.triangle_data.world_space_data(<3 x float> <float 0.0, float 0.0, float -2.0>, <3 x float> <float 0.0, float 0.0, float 1.0>, float 0.001, float 100.0, ptr addrspace(1) %as, i32 255, ptr addrspace(1) null, ptr null, i64 0, i32 0, i32 0, i32 0, i32 0, i32 0, i32 0, i32 0, i32 -1, i32 -1, i1 %accept_any, i1 false)
+  %t = extractvalue { i32, float, i32, i32, ptr addrspace(1), i32, i32, <2 x float>, i1, <3 x float>, <3 x float>, <3 x float>, <3 x float>, <3 x float>, <3 x float>, <3 x float>, <3 x float> } %hit, 1
+  %bary = extractvalue { i32, float, i32, i32, ptr addrspace(1), i32, i32, <2 x float>, i1, <3 x float>, <3 x float>, <3 x float>, <3 x float>, <3 x float>, <3 x float>, <3 x float>, <3 x float> } %hit, 7
+  %o2w3 = extractvalue { i32, float, i32, i32, ptr addrspace(1), i32, i32, <2 x float>, i1, <3 x float>, <3 x float>, <3 x float>, <3 x float>, <3 x float>, <3 x float>, <3 x float>, <3 x float> } %hit, 16
+  %bx = extractelement <2 x float> %bary, i32 0
+  %tx = extractelement <3 x float> %o2w3, i32 0
+  %s0 = fadd float %t, %bx
+  %s1 = fadd float %s0, %tx
+  %dst = getelementptr inbounds float, ptr addrspace(1) %out, i32 %tid
+  store float %s1, ptr addrspace(1) %dst, align 4
+  ret void
+}
+declare { i32, float, i32, i32, ptr addrspace(1), i32, i32, <2 x float>, i1, <3 x float>, <3 x float>, <3 x float>, <3 x float>, <3 x float>, <3 x float>, <3 x float>, <3 x float> } @air.intersect.instancing.triangle_data.world_space_data(<3 x float>, <3 x float>, float, float, ptr addrspace(1), i32, ptr addrspace(1), ptr, i64, i32, i32, i32, i32, i32, i32, i32, i32, i32, i1, i1)
+!air.kernel = !{!0}
+!0 = !{ptr @rt_compute, !1, !2}
+!1 = !{}
+!2 = !{!3, !4, !5}
+!3 = !{i32 0, !"air.instance_acceleration_structure", !"air.location_index", i32 0, i32 1, !"air.read", !"air.arg_type_name", !"acceleration_structure<instancing>"}
+!4 = !{i32 1, !"air.buffer", !"air.location_index", i32 1, i32 1, !"air.read_write", !"air.address_space", i32 1, !"air.arg_type_name", !"float"}
+!5 = !{i32 2, !"air.thread_index_in_threadgroup"}
+"#;
+        let (m, refl) = translate_rq(ll, Stage::Kernel);
+        assert!(has_cap(&m, Capability::RayQueryKHR));
+        assert!(has_ext(&m, "SPV_KHR_ray_query"));
+        assert!(has_op(&m, Op::TypeAccelerationStructureKHR));
+        assert!(has_op(&m, Op::TypeRayQueryKHR));
+        assert!(has_op(&m, Op::RayQueryInitializeKHR));
+        assert!(has_op(&m, Op::RayQueryProceedKHR));
+        assert!(has_op(&m, Op::RayQueryConfirmIntersectionKHR));
+        assert!(has_op(&m, Op::RayQueryTerminateKHR));
+        assert!(has_op(&m, Op::RayQueryGetIntersectionTypeKHR));
+        assert!(has_op(&m, Op::RayQueryGetIntersectionTKHR));
+        assert!(has_op(&m, Op::RayQueryGetIntersectionBarycentricsKHR));
+        assert!(has_op(&m, Op::RayQueryGetIntersectionFrontFaceKHR));
+        assert!(has_op(&m, Op::RayQueryGetIntersectionInstanceIdKHR));
+        assert!(has_op(&m, Op::RayQueryGetIntersectionInstanceCustomIndexKHR));
+        assert!(has_op(&m, Op::RayQueryGetIntersectionPrimitiveIndexKHR));
+        assert!(has_op(&m, Op::RayQueryGetIntersectionGeometryIndexKHR));
+        assert!(has_op(&m, Op::RayQueryGetIntersectionObjectToWorldKHR));
+        assert!(has_op(&m, Op::RayQueryGetIntersectionWorldToObjectKHR));
+
+        assert!(refl
+            .bindings
+            .iter()
+            .any(|b| b.kind == ResourceKind::AccelerationStructure && b.metal_index == 0));
+        assert_eq!(refl.acceleration_structures.len(), 1);
+        assert_eq!(
+            refl.acceleration_structures[0].kind,
+            AccelerationStructureKind::Instance
+        );
+        assert_eq!(
+            refl.acceleration_structures[0].binding_mode,
+            AccelerationStructureBindingMode::Descriptor
+        );
+    }
