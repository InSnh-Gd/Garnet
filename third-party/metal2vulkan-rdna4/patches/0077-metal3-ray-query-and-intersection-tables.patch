+//! Hardware `SPV_KHR_ray_query` pre-lowering for Apple AIR `air.intersect.*` intrinsics.
+//!
+//! Translates the complete `AirIntersectionFamily` into structured LLVM IR calling internal
+//! `@__m2v.rq.*` intrinsics (lowered in `passes::ray_query` to `OpTypeRayQueryKHR` and
+//! `OpRayQuery*KHR`). Supports:
+//! - Both descriptor-bound top-level acceleration structures (`@__m2v.rq.init`) and
+//!   argument-buffer 64-bit BDA acceleration structures (`@__m2v.rq.init.bda` ->
+//!   `OpConvertUToAccelerationStructureKHR`).
+//! - Compute (`Stage::Kernel`), Vertex (`Stage::Vertex`), Fragment (`Stage::Fragment`),
+//!   Object (`Stage::Object`), and Mesh (`Stage::Mesh`) stages.
+//! - Runtime `MTLIntersectionFunctionTable` dispatch inside the `OpRayQueryProceedKHR` loop
+//!   using the shared VFT/IFT buffer ABI (`word[0] = slot_count`, `word[1 + slot] = handle_id`)
+//!   with bounded `switch i32 %handle_id` for custom bounding-box and triangle any-hit callbacks
+//!   plus safe handle-0 / out-of-bounds fallback.
+
+use crate::linked_functions::IntersectionFunctionKind;
+use crate::meta::{AirIntersectionFamily, AirIntersectionInstancing, AirIntersectionResultField};
+use std::collections::{HashMap, HashSet};
+
+/// Semantic role of one parameter of a linked bounding-box or triangle any-hit callback.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) enum CallbackParamRole {
+    Origin,
+    WorldOrigin,
+    Direction,
+    WorldDirection,
+    MinDistance,
+    MaxDistance,
+    Barycentrics,
+    FrontFacing,
+    PrimitiveId,
+    GeometryId,
+    InstanceId,
+    UserInstanceId,
+    ObjectToWorldCol(u8),
+    WorldToObjectCol(u8),
+    PayloadPtr,
+    UserDataPtr,
+    ZeroFallback,
+}
+
+/// One linked custom intersection function callable from the `OpRayQueryProceedKHR` loop.
+#[derive(Clone, Debug)]
+pub(crate) struct LinkedRayCallback {
+    pub handle_id: u32,
+    pub kind: IntersectionFunctionKind,
+    pub llvm_symbol: String,
+    pub return_type: String,
+    pub param_types: Vec<String>,
+    pub param_roles: Vec<CallbackParamRole>,
+}
+
+#[derive(Clone)]
+struct PendingCall {
+    scope: usize,
+    line_idx: usize,
+    result_var: String,
+    family: AirIntersectionFamily,
+    raw_args: Vec<(String, String)>,
+    helper_name: String,
+    accel_is_bda: bool,
+    bda_source_load_ptr: Option<String>,
+    bda_source_val: Option<String>,
+    bda_dead_load_line: Option<usize>,
+    air_result_type: String,
+    lowered_result_type: String,
+    slot_id: u32,
+}
+
+fn llvm_line_scopes(ll: &str) -> Vec<(&str, usize)> {
+    let mut next_function = 1usize;
+    let mut scope = 0usize;
+    ll.lines()
+        .map(|line| {
+            if line.trim_start().starts_with("define ") {
+                scope = next_function;
+                next_function += 1;
+            }
+            let scoped = (line, scope);
+            if line.trim() == "}" {
+                scope = 0;
+            }
+            scoped
+        })
+        .collect()
+}
+
+fn split_top_level_commas(text: &str) -> Vec<&str> {
+    let mut out = Vec::new();
+    let mut depth_paren = 0usize;
+    let mut depth_angle = 0usize;
+    let mut depth_brace = 0usize;
+    let mut depth_bracket = 0usize;
+    let mut start = 0usize;
+    for (i, ch) in text.char_indices() {
+        match ch {
+            '(' => depth_paren += 1,
+            ')' => depth_paren = depth_paren.saturating_sub(1),
+            '<' => depth_angle += 1,
+            '>' => depth_angle = depth_angle.saturating_sub(1),
+            '{' => depth_brace += 1,
+            '}' => depth_brace = depth_brace.saturating_sub(1),
+            '[' => depth_bracket += 1,
+            ']' => depth_bracket = depth_bracket.saturating_sub(1),
+            ',' if depth_paren == 0
+                && depth_angle == 0
+                && depth_brace == 0
+                && depth_bracket == 0 =>
+            {
+                out.push(text[start..i].trim());
+                start = i + 1;
+            }
+            _ => {}
+        }
+    }
+    let tail = text[start..].trim();
+    if !tail.is_empty() {
+        out.push(tail);
+    }
+    out
+}
+
+/// Split an LLVM typed argument `"<type> <value>"` into `(type, value)`.
+fn split_typed_arg(arg: &str) -> Option<(String, String)> {
+    let arg = arg.trim();
+    if arg.is_empty() {
+        return None;
+    }
+    // Find the last top-level whitespace separating type (with optional parameter attributes)
+    // from value (`%x`, `0`, `false`, `null`, `zeroinitializer`, `<...>`, `undef`, `poison`).
+    let mut depth_paren = 0usize;
+    let mut depth_angle = 0usize;
+    let mut depth_brace = 0usize;
+    let mut depth_bracket = 0usize;
+    let mut last_ws = None;
+    let bytes = arg.as_bytes();
+    let mut i = 0;
+    while i < bytes.len() {
+        let ch = bytes[i] as char;
+        match ch {
+            '(' => depth_paren += 1,
+            ')' => depth_paren = depth_paren.saturating_sub(1),
+            '<' => depth_angle += 1,
+            '>' => depth_angle = depth_angle.saturating_sub(1),
+            '{' => depth_brace += 1,
+            '}' => depth_brace = depth_brace.saturating_sub(1),
+            '[' => depth_bracket += 1,
+            ']' => depth_bracket = depth_bracket.saturating_sub(1),
+            c if c.is_ascii_whitespace()
+                && depth_paren == 0
+                && depth_angle == 0
+                && depth_brace == 0
+                && depth_bracket == 0 =>
+            {
+                last_ws = Some(i);
+            }
+            _ => {}
+        }
+        i += 1;
+    }
+    let split = last_ws?;
+    let mut ty = arg[..split].trim();
+    let val = arg[split..].trim();
+    // Strip trailing parameter attributes on the type if any (e.g. `noundef`, `nonnull`, `nocapture`).
+    loop {
+        let trimmed = ty.trim_end();
+        let stripped = [
+            "noundef",
+            "nonnull",
+            "nocapture",
+            "readonly",
+            "writeonly",
+            "noalias",
+            "signext",
+            "zeroext",
+        ]
+        .iter()
+        .find_map(|attr| {
+            trimmed
+                .strip_suffix(attr)
+                .filter(|rest| rest.ends_with(char::is_whitespace))
+                .map(str::trim_end)
+        });
+        if let Some(next) = stripped {
+            ty = next;
+        } else {
+            break;
+        }
+    }
+    Some((ty.to_string(), val.to_string()))
+}
+
+fn find_matching_paren(s: &str, open: usize) -> Option<usize> {
+    let mut depth = 0usize;
+    for (offset, ch) in s[open..].char_indices() {
+        match ch {
+            '(' => depth += 1,
+            ')' => {
+                depth = depth.saturating_sub(1);
+                if depth == 0 {
+                    return Some(open + offset);
+                }
+            }
+            _ => {}
+        }
+    }
+    None
+}
+
+fn replace_llvm_value(line: &str, value: &str, replacement: &str) -> String {
+    let mut out = String::with_capacity(line.len());
+    let mut rest = line;
+    let is_ident = |b: u8| b.is_ascii_alphanumeric() || matches!(b, b'_' | b'.' | b'-' | b'$');
+    while let Some(pos) = rest.find(value) {
+        let before_ok = pos == 0 || !is_ident(rest.as_bytes()[pos - 1]);
+        let after = pos + value.len();
+        let after_ok = after >= rest.len() || !is_ident(rest.as_bytes()[after]);
+        if before_ok && after_ok {
+            out.push_str(&rest[..pos]);
+            out.push_str(replacement);
+            rest = &rest[after..];
+        } else {
+            out.push_str(&rest[..pos + value.len()]);
+            rest = &rest[after..];
+        }
+    }
+    out.push_str(rest);
+    out
+}
+
+fn line_uses_llvm_value(line: &str, value: &str) -> bool {
+    replace_llvm_value(line, value, "\u{0}").contains('\u{0}')
+}
+
+fn aggregate_preserving_instruction(instruction: &str) -> bool {
+    ["phi ", "select ", "freeze ", "insertvalue "]
+        .iter()
+        .any(|opcode| instruction.starts_with(opcode))
+}
+
+fn parse_md_refs(body: &str) -> Vec<u32> {
+    body.split(',')
+        .filter_map(|part| {
+            let tok = part.trim();
+            let digits = tok.strip_prefix('!')?;
+            let digits = digits.trim_end_matches('}').trim();
+            digits.parse::<u32>().ok()
+        })
+        .collect()
+}
+
+fn extract_defined_global(line: &str) -> Option<&str> {
+    let at = line.find('@')?;
+    let rest = &line[at..];
+    let end = if rest.starts_with("@\"") {
+        let close = rest[2..].find('"')?;
+        close + 3
+    } else {
+        rest.find(['(', ' ', '\t', ',', '}'])
+            .unwrap_or(rest.len())
+    };
+    Some(&rest[..end])
+}
+
+/// Discover entry parameter names that carry top-level `instance_acceleration_structure` or
+/// `primitive_acceleration_structure` metadata so we know which `accel` operands are descriptors
+/// vs argument-buffer 64-bit BDA handles. Scoped strictly to top-level stage entry parameter
+/// metadata (never nested `!air.indirect_argument` nodes or non-entry helper functions).
+fn discover_descriptor_as_params(ll: &str) -> HashSet<(usize, String)> {
+    let mut md_nodes = HashMap::<u32, &str>::new();
+    let mut stage_roots = Vec::<u32>::new();
+    for line in ll.lines() {
+        let trimmed = line.trim();
+        if !trimmed.starts_with('!') {
+            continue;
+        }
+        let Some((lhs, rhs)) = trimmed.split_once(" = ") else {
+            continue;
+        };
+        let lhs = lhs.trim();
+        let rhs = rhs.trim();
+        let Some(body) = rhs.strip_prefix("!{").and_then(|s| s.strip_suffix('}')) else {
+            continue;
+        };
+        if let Some(id_str) = lhs.strip_prefix('!') {
+            if let Ok(id) = id_str.parse::<u32>() {
+                md_nodes.insert(id, body);
+                continue;
+            }
+        }
+        if matches!(
+            lhs,
+            "!air.kernel" | "!air.vertex" | "!air.fragment" | "!air.object" | "!air.mesh"
+        ) {
+            stage_roots.extend(parse_md_refs(body));
+        }
+    }
+
+    let mut entry_as_indices = HashMap::<String, HashSet<u32>>::new();
+    for root_id in stage_roots {
+        let Some(&root_body) = md_nodes.get(&root_id) else {
+            continue;
+        };
+        let Some(entry_global) = extract_defined_global(root_body) else {
+            continue;
+        };
+        let refs = parse_md_refs(root_body);
+        // Entry root tuple is `{ ptr @entry, !outputs, !inputs, ... }`; inputs is the 2nd ref.
+        let Some(&in_list_id) = refs.get(1) else {
+            continue;
+        };
+        let Some(&in_list_body) = md_nodes.get(&in_list_id) else {
+            continue;
+        };
+        for param_ref in parse_md_refs(in_list_body) {
+            let Some(&param_body) = md_nodes.get(&param_ref) else {
+                continue;
+            };
+            if param_body.contains("!\"air.indirect_argument\"") {
+                continue;
+            }
+            if param_body.contains("!\"air.instance_acceleration_structure\"")
+                || param_body.contains("!\"air.primitive_acceleration_structure\"")
+            {
+                if let Some(first) = param_body.split(',').next() {
+                    if let Some(idx_str) = first.trim().strip_prefix("i32 ") {
+                        if let Ok(idx) = idx_str.trim().parse::<u32>() {
+                            entry_as_indices
+                                .entry(entry_global.to_string())
+                                .or_default()
+                                .insert(idx);
+                        }
+                    }
+                }
+            }
+        }
+    }
+
+    let mut out = HashSet::new();
+    let scoped = llvm_line_scopes(ll);
+    for (line, scope) in scoped {
+        let trimmed = line.trim_start();
+        if !trimmed.starts_with("define ") {
+            continue;
+        }
+        let Some(fn_global) = extract_defined_global(trimmed) else {
+            continue;
+        };
+        let Some(as_param_indices) = entry_as_indices.get(fn_global) else {
+            continue;
+        };
+        let Some(open) = trimmed.find('(') else {
+            continue;
+        };
+        let Some(close) = find_matching_paren(trimmed, open) else {
+            continue;
+        };
+        for (idx, param) in split_top_level_commas(&trimmed[open + 1..close])
+            .into_iter()
+            .enumerate()
+        {
+            if as_param_indices.contains(&(idx as u32)) {
+                if let Some((_, name)) = split_typed_arg(param) {
+                    if name.starts_with('%') {
+                        out.insert((scope, name));
+                    }
+                }
+            }
+        }
+    }
+    out
+}
+
+/// Inspect the definition of an `accel` operand within `scope` to determine whether it is a
+/// top-level descriptor parameter or a 64-bit BDA acceleration structure handle.
+fn classify_accel_operand(
+    scoped_lines: &[(&str, usize)],
+    scope: usize,
+    accel_ty: &str,
+    accel_val: &str,
+    descriptor_as_params: &HashSet<(usize, String)>,
+) -> (bool, Option<String>, Option<String>, Option<usize>) {
+    if accel_ty == "i64" {
+        return (true, None, Some(accel_val.to_string()), None);
+    }
+    if descriptor_as_params.contains(&(scope, accel_val.to_string())) {
+        return (false, None, None, None);
+    }
+    // Check if accel_val is defined inside this function by `load ptr addrspace(...)` or `inttoptr`.
+    let mut def_line = None;
+    let mut other_uses = 0usize;
+    for (idx, &(line, s)) in scoped_lines.iter().enumerate() {
+        if s != scope {
+            continue;
+        }
+        let trimmed = line.trim_start();
+        if let Some((lhs, rhs)) = trimmed.split_once(" = ") {
+            if lhs.trim() == accel_val {
+                def_line = Some((idx, rhs.trim()));
+                continue;
+            }
+        }
+        if !trimmed.contains("@air.intersect.") && line_uses_llvm_value(trimmed, accel_val) {
+            other_uses += 1;
+        }
+    }
+    if let Some((idx, rhs)) = def_line {
+        // Case A: `%as = inttoptr i64 %addr to ptr addrspace(1)`
+        if let Some(rest) = rhs.strip_prefix("inttoptr ") {
+            if let Some((src_part, _)) = rest.split_once(" to ") {
+                if let Some((src_ty, src_val)) = split_typed_arg(src_part) {
+                    if src_ty == "i64" {
+                        let dead = (other_uses == 0).then_some(idx);
+                        return (true, None, Some(src_val), dead);
+                    }
+                }
+            }
+        }
+        // Case B: `%as = load ptr addrspace(1), ptr addrspace(1) %field_ptr[, align 8]`
+        if let Some(rest) = rhs.strip_prefix("load ") {
+            let parts = split_top_level_commas(rest);
+            if parts.len() >= 2 && parts[0].trim().starts_with("ptr") {
+                if let Some((ptr_ty, ptr_val)) = split_typed_arg(parts[1]) {
+                    let dead = (other_uses == 0).then_some(idx);
+                    return (
+                        true,
+                        Some(format!("{ptr_ty} {ptr_val}")),
+                        None,
+                        dead,
+                    );
+                }
+            }
+        }
+    }
+    // Default: treat as descriptor AS parameter.
+    (false, None, None, None)
+}
+
+fn lowered_result_type(family: &AirIntersectionFamily) -> String {
+    format!(
+        "{{ {} }}",
+        family
+            .result_fields()
+            .into_iter()
+            .map(|field| match field {
+                AirIntersectionResultField::OpaquePointer => "i64",
+                _ => field.llvm_type(),
+            })
+            .collect::<Vec<_>>()
+            .join(", ")
+    )
+}
+
+/// Lower every `@air.intersect.*` call in `ll` to structured `@__m2v.rq.*` hardware ray queries.
+///
+/// Returns `Ok(None)` when `ll` contains no `@air.intersect.*` calls.
+pub(crate) fn lower_air_ray_queries(
+    ll: &str,
+    linked_callbacks: &[LinkedRayCallback],
+) -> Result<Option<String>, String> {
+    if !ll.contains("@air.intersect.") {
+        return Ok(None);
+    }
+
+    let scoped_lines = llvm_line_scopes(ll);
+    let descriptor_as_params = discover_descriptor_as_params(ll);
+    let mut pending = Vec::<PendingCall>::new();
+
+    for (line_idx, &(line, scope)) in scoped_lines.iter().enumerate() {
+        if scope == 0 {
+            continue;
+        }
+        let trimmed = line.trim_start();
+        let Some((lhs, rhs)) = trimmed.split_once(" = ") else {
+            continue;
+        };
+        let Some(at_pos) = rhs.find("@air.intersect.") else {
+            continue;
+        };
+        let Some(open_rel) = rhs[at_pos..].find('(') else {
+            continue;
+        };
+        let open = at_pos + open_rel;
+        let Some(close) = find_matching_paren(rhs, open) else {
+            return Err(format!("malformed @air.intersect call: {trimmed}"));
+        };
+        let callee = &rhs[at_pos + 1..open];
+        let Some(family) = AirIntersectionFamily::parse(callee)? else {
+            continue;
+        };
+        let raw_arg_strs = split_top_level_commas(&rhs[open + 1..close]);
+        let mut raw_args = Vec::with_capacity(raw_arg_strs.len());
+        for a in raw_arg_strs {
+            let parsed = split_typed_arg(a)
+                .ok_or_else(|| format!("malformed operand {a:?} in @{callee}"))?;
+            raw_args.push(parsed);
+        }
+        let expected = family.argument_count();
+        if raw_args.len() != expected {
+            return Err(format!(
+                "AIR intersection call @{callee} has {} operands, expected {expected}",
+                raw_args.len()
+            ));
+        }
+        let (accel_ty, accel_val) = &raw_args[4];
+        let (accel_is_bda, bda_source_load_ptr, bda_source_val, bda_dead_load_line) =
+            classify_accel_operand(
+                &scoped_lines,
+                scope,
+                accel_ty,
+                accel_val,
+                &descriptor_as_params,
+            );
+        let ordinal = pending.len();
+        pending.push(PendingCall {
+            scope,
+            line_idx,
+            result_var: lhs.trim().to_string(),
+            air_result_type: family.llvm_result_type(),
+            lowered_result_type: lowered_result_type(&family),
+            family,
+            raw_args,
+            helper_name: format!("__m2v.rq.query.{ordinal}"),
+            accel_is_bda,
+            bda_source_load_ptr,
+            bda_source_val,
+            bda_dead_load_line,
+            slot_id: ordinal as u32,
+        });
+    }
+
+    if pending.is_empty() {
+        return Ok(None);
+    }
+
+    // Track aggregates flowing from lowered calls through phi/select/freeze/insertvalue so the
+    // opaque pointer field (field 4) rewrites cleanly to i64 everywhere in that component.
+    let mut lowered_aggregates: Vec<(usize, String, String, String)> = pending
+        .iter()
+        .map(|p| {
+            (
+                p.scope,
+                p.result_var.clone(),
+                p.air_result_type.clone(),
+                p.lowered_result_type.clone(),
+            )
+        })
+        .collect();
+    loop {
+        let mut discovered = Vec::new();
+        for &(line, scope) in &scoped_lines {
+            let Some((defined, instruction)) = line.trim_start().split_once(" = ") else {
+                continue;
+            };
+            let defined = defined.trim();
+            if !aggregate_preserving_instruction(instruction)
+                || lowered_aggregates
+                    .iter()
+                    .any(|(s, r, _, _)| *s == scope && r == defined)
+            {
+                continue;
+            }
+            if let Some((_, _, air_ty, low_ty)) = lowered_aggregates.iter().find(|(s, r, air_ty, _)| {
+                *s == scope && instruction.contains(air_ty) && line_uses_llvm_value(instruction, r)
+            }) {
+                discovered.push((scope, defined.to_string(), air_ty.clone(), low_ty.clone()));
+            }
+        }
+        if discovered.is_empty() {
+            break;
+        }
+        lowered_aggregates.extend(discovered);
+    }
+
+    // Direct field-4 (`OpaquePointer`) extractions become `null` before field 4 changes to `i64`.
+    let mut opaque_extractions: Vec<(usize, String)> = Vec::new();
+    for &(line, scope) in &scoped_lines {
+        let Some((defined, instruction)) = line.trim_start().split_once(" = ") else {
+            continue;
+        };
+        let Some(rest) = instruction.strip_prefix("extractvalue ") else {
+            continue;
+        };
+        if !rest.trim_end().ends_with(", 4") {
+            continue;
+        }
+        if lowered_aggregates.iter().any(|(s, r, air_ty, _)| {
+            *s == scope && rest.starts_with(air_ty) && line_uses_llvm_value(rest, r)
+        }) {
+            opaque_extractions.push((scope, defined.trim().to_string()));
+        }
+    }
+
+    let pending_by_line: HashMap<usize, usize> = pending
+        .iter()
+        .enumerate()
+        .map(|(i, p)| (p.line_idx, i))
+        .collect();
+    let dead_load_lines: HashSet<usize> = pending
+        .iter()
+        .filter_map(|p| p.bda_dead_load_line)
+        .collect();
+
+    let mut out = String::with_capacity(ll.len() + 4096);
+    for (line_idx, &(line, scope)) in scoped_lines.iter().enumerate() {
+        let trimmed = line.trim_start();
+        // Drop old `declare ... @air.intersect.*(...)` declarations once lowered.
+        if trimmed.starts_with("declare ") && trimmed.contains("@air.intersect.") {
+            continue;
+        }
+        if dead_load_lines.contains(&line_idx) {
+            continue;
+        }
+        if let Some(&pidx) = pending_by_line.get(&line_idx) {
+            let p = &pending[pidx];
+            let indent = &line[..line.len() - trimmed.len()];
+            let mut call_args = Vec::with_capacity(p.raw_args.len());
+            for (ai, (ty, val)) in p.raw_args.iter().enumerate() {
+                if ai == 4 && p.accel_is_bda {
+                    if let Some(src_ptr) = &p.bda_source_load_ptr {
+                        let tmp = format!("%__m2v.rq.as_bda.{pidx}");
+                        out.push_str(&format!(
+                            "{indent}{tmp} = load i64, {src_ptr}, align 8\n"
+                        ));
+                        call_args.push(format!("i64 {tmp}"));
+                    } else if let Some(src_val) = &p.bda_source_val {
+                        call_args.push(format!("i64 {src_val}"));
+                    } else {
+                        call_args.push(format!("i64 {val}"));
+                    }
+                } else {
+                    call_args.push(format!("{ty} {val}"));
+                }
+            }
+            out.push_str(&format!(
+                "{indent}{} = call {} @{}({})\n",
+                p.result_var,
+                p.lowered_result_type,
+                p.helper_name,
+                call_args.join(", ")
+            ));
+            continue;
+        }
+
+        // Skip eliminated field-4 extractvalue lines.
+        if let Some((defined, instruction)) = trimmed.split_once(" = ") {
+            if instruction.starts_with("extractvalue ")
+                && opaque_extractions
+                    .iter()
+                    .any(|(s, v)| *s == scope && v == defined.trim())
+            {
+                continue;
+            }
+        }
+
+        let mut rewritten = line.to_string();
+        for (s, v) in &opaque_extractions {
+            if *s == scope {
+                rewritten = replace_llvm_value(&rewritten, v, "null");
+            }
+        }
+        for (s, r, air_ty, low_ty) in &lowered_aggregates {
+            if *s == scope && line_uses_llvm_value(&rewritten, r) && rewritten.contains(air_ty) {
+                rewritten = rewritten.replace(air_ty, low_ty);
+            }
+        }
+        out.push_str(&rewritten);
+        out.push('\n');
+    }
+
+    // Emit `@__m2v.rq.*` intrinsic declarations (only if not already present in module).
+    append_rq_intrinsic_declarations(&mut out, ll);
+
+    // Emit each structured ray-query helper function.
+    for p in &pending {
+        let helper = emit_ray_query_helper(p, linked_callbacks)?;
+        out.push_str(&helper);
+    }
+
+    Ok(Some(out))
+}
+
+fn append_rq_intrinsic_declarations(out: &mut String, existing_ll: &str) {
+    let decls = [
+        "declare void @__m2v.rq.init(i32, ptr addrspace(1), i32, i32, <3 x float>, float, <3 x float>, float)",
+        "declare void @__m2v.rq.init.bda(i32, i64, i32, i32, <3 x float>, float, <3 x float>, float)",
+        "declare i1 @__m2v.rq.proceed(i32)",
+        "declare void @__m2v.rq.terminate(i32)",
+        "declare void @__m2v.rq.confirm(i32)",
+        "declare void @__m2v.rq.generate(i32, float)",
+        "declare i32 @__m2v.rq.get_type(i32, i32)",
+        "declare float @__m2v.rq.get_t(i32, i32)",
+        "declare float @__m2v.rq.get_tmin(i32)",
+        "declare i32 @__m2v.rq.get_primitive_index(i32, i32)",
+        "declare i32 @__m2v.rq.get_geometry_index(i32, i32)",
+        "declare i32 @__m2v.rq.get_instance_id(i32, i32)",
+        "declare i32 @__m2v.rq.get_instance_custom_index(i32, i32)",
+        "declare i32 @__m2v.rq.get_sbt_offset(i32, i32)",
+        "declare <2 x float> @__m2v.rq.get_barycentrics(i32, i32)",
+        "declare i1 @__m2v.rq.get_front_face(i32, i32)",
+        "declare <3 x float> @__m2v.rq.get_world_ray_origin(i32)",
+        "declare <3 x float> @__m2v.rq.get_world_ray_direction(i32)",
+        "declare <3 x float> @__m2v.rq.get_object_ray_origin(i32, i32)",
+        "declare <3 x float> @__m2v.rq.get_object_ray_direction(i32, i32)",
+        "declare <3 x float> @__m2v.rq.get_object_to_world_col(i32, i32, i32)",
+        "declare <3 x float> @__m2v.rq.get_world_to_object_col(i32, i32, i32)",
+    ];
+    out.push('\n');
+    for d in decls {
+        if let Some(at) = d.find('@') {
+            if let Some(open) = d[at..].find('(') {
+                let sym = &d[at..at + open + 1];
+                if !existing_ll.contains(sym) {
+                    out.push_str(d);
+                    out.push('\n');
+                }
+            }
+        }
+    }
+}
+
+struct ParsedParamIndices {
+    instance_mask: Option<usize>,
+    table: usize,
+    user_data: Option<usize>,
+    payload: usize,
+    instance_ids_ptr: Option<usize>,
+    user_instance_ids_ptr: Option<usize>,
+    front_facing_winding: usize,
+    triangle_cull_mode: usize,
+    opacity_cull_mode: usize,
+    force_opacity: usize,
+    function_table_offset: usize,
+    accept_any_intersection: usize,
+}
+
+fn param_indices(family: &AirIntersectionFamily) -> ParsedParamIndices {
+    let mut cur = 5usize;
+    let instance_mask = if family.instancing != AirIntersectionInstancing::None {
+        let i = cur;
+        cur += 1;
+        Some(i)
+    } else {
+        None
+    };
+    if family.primitive_motion || family.instance_motion {
+        cur += 1; // motion_time
+    }
+    let table = cur;
+    cur += 1;
+    if family.intersection_function_buffer {
+        cur += 2; // table_size, function_stride
+    }
+    let user_data = if family.user_data {
+        let i = cur;
+        cur += 1;
+        Some(i)
+    } else {
+        None
+    };
+    let payload = cur;
+    cur += 2; // payload, payload_stride
+    let (instance_ids_ptr, user_instance_ids_ptr) =
+        if family.instancing == AirIntersectionInstancing::MultiLevel {
+            let inst_ids = cur + 1;
+            let user_inst_ids = cur + 2;
+            cur += 3; // max_levels, instance_ids, user_instance_ids
+            (Some(inst_ids), Some(user_inst_ids))
+        } else {
+            (None, None)
+        };
+    // Trailing intersection_params block (9 i32s + 1 or 2 i1s, followed by 2 IFT dispatch controls).
+    let front_facing_winding = cur;
+    let triangle_cull_mode = cur + 1;
+    let opacity_cull_mode = cur + 2;
+    let force_opacity = cur + 3;
+    let function_table_offset = cur + 5;
+    let accept_any_intersection = cur + 9;
+    ParsedParamIndices {
+        instance_mask,
+        table,
+        user_data,
+        payload,
+        instance_ids_ptr,
+        user_instance_ids_ptr,
+        front_facing_winding,
+        triangle_cull_mode,
+        opacity_cull_mode,
+        force_opacity,
+        function_table_offset,
+        accept_any_intersection,
+    }
+}
+
+fn emit_ray_query_helper(
+    p: &PendingCall,
+    linked_callbacks: &[LinkedRayCallback],
+) -> Result<String, String> {
+    let family = &p.family;
+    let idx = param_indices(family);
+    let slot = p.slot_id;
+    let ret_ty = &p.lowered_result_type;
+
+    let mut params = Vec::with_capacity(p.raw_args.len());
+    for (i, (ty, _)) in p.raw_args.iter().enumerate() {
+        let pty = if i == 4 && p.accel_is_bda {
+            "i64"
+        } else {
+            ty.as_str()
+        };
+        params.push(format!("{pty} %p{i}"));
+    }
+
+    let mut s = String::new();
+    s.push_str(&format!(
+        "\ndefine internal {ret_ty} @{}({}) {{\nentry:\n",
+        p.helper_name,
+        params.join(", ")
+    ));
+
+    // Coerce accept_any_intersection to i1 regardless of whether AIR typed it as i1 or i32.
+    let accept_any_ty = p.raw_args[idx.accept_any_intersection].0.as_str();
+    if accept_any_ty == "i1" {
+        s.push_str(&format!(
+            "  %accept_any = select i1 %p{}, i1 true, i1 false\n",
+            idx.accept_any_intersection
+        ));
+    } else {
+        s.push_str(&format!(
+            "  %accept_any = icmp ne {accept_any_ty} %p{}, 0\n",
+            idx.accept_any_intersection
+        ));
+    }
+
+    // Build SPIR-V RayFlags dynamically from Metal's intersection_params.
+    // Core SPV_KHR_ray_query flags:
+    //   0x01 OpaqueKHR, 0x02 NoOpaqueKHR, 0x04 TerminateOnFirstHitKHR,
+    //   0x10 CullBackFacingTrianglesKHR, 0x20 CullFrontFacingTrianglesKHR,
+    //   0x40 CullOpaqueKHR, 0x80 CullNoOpaqueKHR.
+    s.push_str(&format!(
+        "  %ccw = icmp eq i32 %p{}, 1\n\
+         \x20 %cull_front_req = icmp eq i32 %p{}, 1\n\
+         \x20 %cull_back_req = icmp eq i32 %p{}, 2\n\
+         \x20 %cull_vk_front = select i1 %ccw, i1 %cull_back_req, i1 %cull_front_req\n\
+         \x20 %cull_vk_back = select i1 %ccw, i1 %cull_front_req, i1 %cull_back_req\n\
+         \x20 %f_cf = select i1 %cull_vk_front, i32 32, i32 0\n\
+         \x20 %f_cb = select i1 %cull_vk_back, i32 16, i32 0\n\
+         \x20 %f_0 = or i32 %f_cf, %f_cb\n\
+         \x20 %cull_op = icmp eq i32 %p{}, 1\n\
+         \x20 %cull_nop = icmp eq i32 %p{}, 2\n\
+         \x20 %f_co = select i1 %cull_op, i32 64, i32 0\n\
+         \x20 %f_cn = select i1 %cull_nop, i32 128, i32 0\n\
+         \x20 %f_1 = or i32 %f_0, %f_co\n\
+         \x20 %f_2 = or i32 %f_1, %f_cn\n\
+         \x20 %force_op = icmp eq i32 %p{}, 1\n\
+         \x20 %force_nop = icmp eq i32 %p{}, 2\n\
+         \x20 %f_fo = select i1 %force_op, i32 1, i32 0\n\
+         \x20 %f_fn = select i1 %force_nop, i32 2, i32 0\n\
+         \x20 %f_3 = or i32 %f_2, %f_fo\n\
+         \x20 %f_4 = or i32 %f_3, %f_fn\n\
+         \x20 %f_term = select i1 %accept_any, i32 4, i32 0\n\
+         \x20 %ray_flags = or i32 %f_4, %f_term\n",
+        idx.front_facing_winding,
+        idx.triangle_cull_mode,
+        idx.triangle_cull_mode,
+        idx.opacity_cull_mode,
+        idx.opacity_cull_mode,
+        idx.force_opacity,
+        idx.force_opacity,
+    ));
+
+    let cull_mask = match idx.instance_mask {
+        Some(mi) => format!("%p{mi}"),
+        None => "255".to_string(),
+    };
+    if p.accel_is_bda {
+        s.push_str(&format!(
+            "  call void @__m2v.rq.init.bda(i32 {slot}, i64 %p4, i32 %ray_flags, i32 {cull_mask}, <3 x float> %p0, float %p2, <3 x float> %p1, float %p3)\n"
+        ));
+    } else {
+        s.push_str(&format!(
+            "  call void @__m2v.rq.init(i32 {slot}, ptr addrspace(1) %p4, i32 %ray_flags, i32 {cull_mask}, <3 x float> %p0, float %p2, <3 x float> %p1, float %p3)\n"
+        ));
+    }
+
+    let active_callbacks: Vec<&LinkedRayCallback> = if family.intersection_function_buffer {
+        linked_callbacks.iter().collect()
+    } else {
+        Vec::new()
+    };
+    let tri_callbacks: Vec<&LinkedRayCallback> = active_callbacks
+        .iter()
+        .copied()
+        .filter(|cb| cb.kind == IntersectionFunctionKind::TriangleAnyHit)
+        .collect();
+    let aabb_callbacks: Vec<&LinkedRayCallback> = active_callbacks
+        .iter()
+        .copied()
+        .filter(|cb| cb.kind == IntersectionFunctionKind::BoundingBox)
+        .collect();
+
+    s.push_str("  br label %proceed_hdr\n\n");
+    s.push_str(&format!(
+        "proceed_hdr:\n\
+         \x20 %more = call i1 @__m2v.rq.proceed(i32 {slot})\n\
+         \x20 br i1 %more, label %proceed_body, label %done\n\n"
+    ));
+
+    if active_callbacks.is_empty() {
+        // Callback-free (or empty-table) proceed loop: confirm non-opaque triangles, skip AABBs.
+        s.push_str(&format!(
+            "proceed_body:\n\
+             \x20 %ctype = call i32 @__m2v.rq.get_type(i32 {slot}, i32 0)\n\
+             \x20 %is_tri = icmp eq i32 %ctype, 0\n\
+             \x20 br i1 %is_tri, label %confirm_tri, label %proceed_hdr\n\n\
+             confirm_tri:\n\
+             \x20 call void @__m2v.rq.confirm(i32 {slot})\n\
+             \x20 br i1 %accept_any, label %term_hit, label %proceed_hdr\n\n\
+             term_hit:\n\
+             \x20 call void @__m2v.rq.terminate(i32 {slot})\n\
+             \x20 br label %proceed_hdr\n\n"
+        ));
+    } else {
+        // Runtime MTLIntersectionFunctionTable dispatch inside OpRayQueryProceedKHR loop.
+        // Buffer ABI (matching 0074 VFT): word[0] = slot_count, word[1 + slot] = handle_id.
+        let has_instancing = family.instancing != AirIntersectionInstancing::None;
+        let table_param = format!("%p{}", idx.table);
+        let fto_param = format!("%p{}", idx.function_table_offset);
+        s.push_str(&format!(
+            "proceed_body:\n\
+             \x20 %ctype = call i32 @__m2v.rq.get_type(i32 {slot}, i32 0)\n\
+             \x20 %cand_geom = call i32 @__m2v.rq.get_geometry_index(i32 {slot}, i32 0)\n"
+        ));
+        if has_instancing {
+            s.push_str(&format!(
+                "  %cand_sbt = call i32 @__m2v.rq.get_sbt_offset(i32 {slot}, i32 0)\n\
+                 \x20 %slot_0 = add i32 %cand_sbt, %cand_geom\n"
+            ));
+        } else {
+            s.push_str("  %slot_0 = add i32 %cand_geom, 0\n");
+        }
+        // Normalize negative sentinel (-1) function_table_offset to 0.
+        s.push_str(&format!(
+            "  %fto_neg = icmp slt i32 {fto_param}, 0\n\
+             \x20 %fto_safe = select i1 %fto_neg, i32 0, i32 {fto_param}\n\
+             \x20 %ift_slot = add i32 %slot_0, %fto_safe\n\
+             \x20 %ift_count = load i32, ptr addrspace(1) {table_param}, align 4\n\
+             \x20 %ift_in_bounds = icmp ult i32 %ift_slot, %ift_count\n\
+             \x20 br i1 %ift_in_bounds, label %ift_load, label %ift_oob\n\n\
+             ift_load:\n\
+             \x20 %ift_word_idx = add i32 %ift_slot, 1\n\
+             \x20 %ift_ptr = getelementptr inbounds i32, ptr addrspace(1) {table_param}, i32 %ift_word_idx\n\
+             \x20 %ift_loaded_hdl = load i32, ptr addrspace(1) %ift_ptr, align 4\n\
+             \x20 br label %ift_dispatch\n\n\
+             ift_oob:\n\
+             \x20 br label %ift_dispatch\n\n\
+             ift_dispatch:\n\
+             \x20 %ift_hdl = phi i32 [ %ift_loaded_hdl, %ift_load ], [ 0, %ift_oob ]\n\
+             \x20 %is_tri = icmp eq i32 %ctype, 0\n\
+             \x20 br i1 %is_tri, label %tri_dispatch, label %aabb_dispatch\n\n"
+        ));
+
+        // Triangle any-hit dispatch.
+        s.push_str("tri_dispatch:\n");
+        if tri_callbacks.is_empty() {
+            s.push_str("  br label %tri_default\n\n");
+        } else {
+            s.push_str("  switch i32 %ift_hdl, label %tri_default [\n");
+            for cb in &tri_callbacks {
+                s.push_str(&format!(
+                    "    i32 {}, label %tri_case_{}\n",
+                    cb.handle_id, cb.handle_id
+                ));
+            }
+            s.push_str("  ]\n\n");
+            for cb in &tri_callbacks {
+                emit_triangle_callback_case(&mut s, slot, cb, has_instancing, &idx, p)?;
+            }
+        }
+        s.push_str(&format!(
+            "tri_default:\n\
+             \x20 call void @__m2v.rq.confirm(i32 {slot})\n\
+             \x20 br i1 %accept_any, label %term_hit, label %proceed_hdr\n\n"
+        ));
+
+        // Bounding-box custom intersection dispatch.
+        s.push_str("aabb_dispatch:\n");
+        if aabb_callbacks.is_empty() {
+            s.push_str("  br label %aabb_default\n\n");
+        } else {
+            s.push_str("  switch i32 %ift_hdl, label %aabb_default [\n");
+            for cb in &aabb_callbacks {
+                s.push_str(&format!(
+                    "    i32 {}, label %aabb_case_{}\n",
+                    cb.handle_id, cb.handle_id
+                ));
+            }
+            s.push_str("  ]\n\n");
+            for cb in &aabb_callbacks {
+                emit_aabb_callback_case(&mut s, slot, cb, has_instancing, &idx, p)?;
+            }
+        }
+        s.push_str(
+            "aabb_default:\n\
+             \x20 br label %proceed_hdr\n\n",
+        );
+
+        s.push_str(&format!(
+            "term_hit:\n\
+             \x20 call void @__m2v.rq.terminate(i32 {slot})\n\
+             \x20 br label %proceed_hdr\n\n"
+        ));
+    }
+
+    // Done: UB-safe committed intersection extraction (never invoke hit-only getters on miss,
+    // never invoke triangle-only getters on generated AABB hits).
+    let has_instancing = family.instancing != AirIntersectionInstancing::None;
+    let is_multi_level = family.instancing == AirIntersectionInstancing::MultiLevel;
+    s.push_str(&format!(
+        "done:\n\
+         \x20 %comm_type = call i32 @__m2v.rq.get_type(i32 {slot}, i32 1)\n\
+         \x20 %comm_t = call float @__m2v.rq.get_t(i32 {slot}, i32 1)\n\
+         \x20 %has_hit = icmp ne i32 %comm_type, 0\n\
+         \x20 br i1 %has_hit, label %read_hit, label %after_hit\n\n\
+         read_hit:\n\
+         \x20 %hit_prim = call i32 @__m2v.rq.get_primitive_index(i32 {slot}, i32 1)\n\
+         \x20 %hit_geom = call i32 @__m2v.rq.get_geometry_index(i32 {slot}, i32 1)\n"
+    ));
+    if has_instancing {
+        s.push_str(&format!(
+            "  %hit_inst = call i32 @__m2v.rq.get_instance_id(i32 {slot}, i32 1)\n\
+             \x20 %hit_user_inst = call i32 @__m2v.rq.get_instance_custom_index(i32 {slot}, i32 1)\n"
+        ));
+        if is_multi_level {
+            if let (Some(iid_ptr), Some(uid_ptr)) =
+                (idx.instance_ids_ptr, idx.user_instance_ids_ptr)
+            {
+                s.push_str(&format!(
+                    "  store i32 %hit_inst, ptr %p{iid_ptr}, align 4\n\
+                     \x20 store i32 %hit_user_inst, ptr %p{uid_ptr}, align 4\n"
+                ));
+            }
+        }
+    }
+    if family.world_space_data {
+        for c in 0..4 {
+            s.push_str(&format!(
+                "  %hit_w2o_{c} = call <3 x float> @__m2v.rq.get_world_to_object_col(i32 {slot}, i32 1, i32 {c})\n"
+            ));
+        }
+        for c in 0..4 {
+            s.push_str(&format!(
+                "  %hit_o2w_{c} = call <3 x float> @__m2v.rq.get_object_to_world_col(i32 {slot}, i32 1, i32 {c})\n"
+            ));
+        }
+    }
+    s.push_str("  br label %after_hit\n\nafter_hit:\n");
+    s.push_str(
+        "  %res_prim = phi i32 [ %hit_prim, %read_hit ], [ 0, %done ]\n\
+         \x20 %res_geom = phi i32 [ %hit_geom, %read_hit ], [ 0, %done ]\n",
+    );
+    if has_instancing {
+        s.push_str(
+            "  %res_inst = phi i32 [ %hit_inst, %read_hit ], [ 0, %done ]\n\
+             \x20 %res_user_inst = phi i32 [ %hit_user_inst, %read_hit ], [ 0, %done ]\n",
+        );
+    }
+    if family.world_space_data {
+        let id_cols = [
+            "<float 1.000000e+00, float 0.000000e+00, float 0.000000e+00>",
+            "<float 0.000000e+00, float 1.000000e+00, float 0.000000e+00>",
+            "<float 0.000000e+00, float 0.000000e+00, float 1.000000e+00>",
+            "zeroinitializer",
+        ];
+        for c in 0..4 {
+            s.push_str(&format!(
+                "  %res_w2o_{c} = phi <3 x float> [ %hit_w2o_{c}, %read_hit ], [ {}, %done ]\n",
+                id_cols[c]
+            ));
+        }
+        for c in 0..4 {
+            s.push_str(&format!(
+                "  %res_o2w_{c} = phi <3 x float> [ %hit_o2w_{c}, %read_hit ], [ {}, %done ]\n",
+                id_cols[c]
+            ));
+        }
+    }
+
+    if family.triangle_data {
+        s.push_str(&format!(
+            "  %is_tri_hit = icmp eq i32 %comm_type, 1\n\
+             \x20 br i1 %is_tri_hit, label %read_tri, label %pack_result\n\n\
+             read_tri:\n\
+             \x20 %hit_bary = call <2 x float> @__m2v.rq.get_barycentrics(i32 {slot}, i32 1)\n\
+             \x20 %hit_front_raw = call i1 @__m2v.rq.get_front_face(i32 {slot}, i32 1)\n\
+             \x20 %hit_front = xor i1 %hit_front_raw, %ccw\n\
+             \x20 br label %pack_result\n\n\
+             pack_result:\n\
+             \x20 %res_bary = phi <2 x float> [ %hit_bary, %read_tri ], [ zeroinitializer, %after_hit ]\n\
+             \x20 %res_front = phi i1 [ %hit_front, %read_tri ], [ false, %after_hit ]\n"
+        ));
+    }
+
+    // Pack exact AirIntersectionFamily result aggregate.
+    let fields = family.result_fields();
+    let mut prev = "poison".to_string();
+    for (fi, field) in fields.iter().enumerate() {
+        let (ft, fv) = match field {
+            AirIntersectionResultField::IntersectionType => ("i32", "%comm_type".to_string()),
+            AirIntersectionResultField::Distance => ("float", "%comm_t".to_string()),
+            AirIntersectionResultField::PrimitiveId => ("i32", "%res_prim".to_string()),
+            AirIntersectionResultField::GeometryId => ("i32", "%res_geom".to_string()),
+            AirIntersectionResultField::OpaquePointer => ("i64", "0".to_string()),
+            AirIntersectionResultField::InstanceId => ("i32", "%res_inst".to_string()),
+            AirIntersectionResultField::UserInstanceId => ("i32", "%res_user_inst".to_string()),
+            AirIntersectionResultField::InstanceLevel => {
+                s.push_str("  %res_inst_lvl = select i1 %has_hit, i8 1, i8 0\n");
+                ("i8", "%res_inst_lvl".to_string())
+            }
+            AirIntersectionResultField::Barycentrics => ("<2 x float>", "%res_bary".to_string()),
+            AirIntersectionResultField::FrontFacing => ("i1", "%res_front".to_string()),
+            AirIntersectionResultField::WorldSpaceVector(v) => {
+                if *v < 4 {
+                    ("<3 x float>", format!("%res_w2o_{v}"))
+                } else {
+                    ("<3 x float>", format!("%res_o2w_{}", v - 4))
+                }
+            }
+        };
+        let next = format!("%out_{fi}");
+        s.push_str(&format!(
+            "  {next} = insertvalue {ret_ty} {prev}, {ft} {fv}, {fi}\n"
+        ));
+        prev = next;
+    }
+    s.push_str(&format!("  ret {ret_ty} {prev}\n}}\n"));
+    Ok(s)
+}
+
+fn emit_callback_args(
+    s: &mut String,
+    slot: u32,
+    prefix: &str,
+    cb: &LinkedRayCallback,
+    is_triangle: bool,
+    has_instancing: bool,
+    idx: &ParsedParamIndices,
+    p: &PendingCall,
+) -> Vec<String> {
+    let mut args = Vec::with_capacity(cb.param_types.len());
+    for (pi, (pty, role)) in cb
+        .param_types
+        .iter()
+        .zip(cb.param_roles.iter())
+        .enumerate()
+    {
+        let vname = format!("%{prefix}_a{pi}");
+        match *role {
+            CallbackParamRole::Origin => {
+                if has_instancing {
+                    s.push_str(&format!(
+                        "  {vname} = call <3 x float> @__m2v.rq.get_object_ray_origin(i32 {slot}, i32 0)\n"
+                    ));
+                } else {
+                    s.push_str(&format!(
+                        "  {vname} = call <3 x float> @__m2v.rq.get_world_ray_origin(i32 {slot})\n"
+                    ));
+                }
+                args.push(format!("{pty} {vname}"));
+            }
+            CallbackParamRole::WorldOrigin => {
+                s.push_str(&format!(
+                    "  {vname} = call <3 x float> @__m2v.rq.get_world_ray_origin(i32 {slot})\n"
+                ));
+                args.push(format!("{pty} {vname}"));
+            }
+            CallbackParamRole::Direction => {
+                if has_instancing {
+                    s.push_str(&format!(
+                        "  {vname} = call <3 x float> @__m2v.rq.get_object_ray_direction(i32 {slot}, i32 0)\n"
+                    ));
+                } else {
+                    s.push_str(&format!(
+                        "  {vname} = call <3 x float> @__m2v.rq.get_world_ray_direction(i32 {slot})\n"
+                    ));
+                }
+                args.push(format!("{pty} {vname}"));
+            }
+            CallbackParamRole::WorldDirection => {
+                s.push_str(&format!(
+                    "  {vname} = call <3 x float> @__m2v.rq.get_world_ray_direction(i32 {slot})\n"
+                ));
+                args.push(format!("{pty} {vname}"));
+            }
+            CallbackParamRole::MinDistance => {
+                s.push_str(&format!(
+                    "  {vname} = call float @__m2v.rq.get_tmin(i32 {slot})\n"
+                ));
+                args.push(format!("{pty} {vname}"));
+            }
+            CallbackParamRole::MaxDistance => {
+                // For triangle any-hit: candidate triangle hit T (intersection=0).
+                // For bounding-box: current closest committed T / ray TMax (intersection=1).
+                let isect = if is_triangle { 0 } else { 1 };
+                s.push_str(&format!(
+                    "  {vname} = call float @__m2v.rq.get_t(i32 {slot}, i32 {isect})\n"
+                ));
+                args.push(format!("{pty} {vname}"));
+            }
+            CallbackParamRole::Barycentrics => {
+                s.push_str(&format!(
+                    "  {vname} = call <2 x float> @__m2v.rq.get_barycentrics(i32 {slot}, i32 0)\n"
+                ));
+                args.push(format!("{pty} {vname}"));
+            }
+            CallbackParamRole::FrontFacing => {
+                s.push_str(&format!(
+                    "  {vname}_raw = call i1 @__m2v.rq.get_front_face(i32 {slot}, i32 0)\n\
+                     \x20 {vname} = xor i1 {vname}_raw, %ccw\n"
+                ));
+                args.push(format!("{pty} {vname}"));
+            }
+            CallbackParamRole::PrimitiveId => {
+                s.push_str(&format!(
+                    "  {vname} = call i32 @__m2v.rq.get_primitive_index(i32 {slot}, i32 0)\n"
+                ));
+                args.push(format!("{pty} {vname}"));
+            }
+            CallbackParamRole::GeometryId => {
+                s.push_str(&format!(
+                    "  {vname} = call i32 @__m2v.rq.get_geometry_index(i32 {slot}, i32 0)\n"
+                ));
+                args.push(format!("{pty} {vname}"));
+            }
+            CallbackParamRole::InstanceId => {
+                if has_instancing {
+                    s.push_str(&format!(
+                        "  {vname} = call i32 @__m2v.rq.get_instance_id(i32 {slot}, i32 0)\n"
+                    ));
+                    args.push(format!("{pty} {vname}"));
+                } else {
+                    args.push(format!("{pty} 0"));
+                }
+            }
+            CallbackParamRole::UserInstanceId => {
+                if has_instancing {
+                    s.push_str(&format!(
+                        "  {vname} = call i32 @__m2v.rq.get_instance_custom_index(i32 {slot}, i32 0)\n"
+                    ));
+                    args.push(format!("{pty} {vname}"));
+                } else {
+                    args.push(format!("{pty} 0"));
+                }
+            }
+            CallbackParamRole::ObjectToWorldCol(c) => {
+                s.push_str(&format!(
+                    "  {vname} = call <3 x float> @__m2v.rq.get_object_to_world_col(i32 {slot}, i32 0, i32 {c})\n"
+                ));
+                args.push(format!("{pty} {vname}"));
+            }
+            CallbackParamRole::WorldToObjectCol(c) => {
+                s.push_str(&format!(
+                    "  {vname} = call <3 x float> @__m2v.rq.get_world_to_object_col(i32 {slot}, i32 0, i32 {c})\n"
+                ));
+                args.push(format!("{pty} {vname}"));
+            }
+            CallbackParamRole::PayloadPtr => {
+                let pt = p.raw_args[idx.payload].0.as_str();
+                if pt == pty {
+                    args.push(format!("{pty} %p{}", idx.payload));
+                } else {
+                    args.push(format!("{pty} null"));
+                }
+            }
+            CallbackParamRole::UserDataPtr => {
+                if let Some(ui) = idx.user_data {
+                    let ut = p.raw_args[ui].0.as_str();
+                    if ut == pty {
+                        args.push(format!("{pty} %p{ui}"));
+                    } else {
+                        args.push(format!("{pty} null"));
+                    }
+                } else {
+                    args.push(format!("{pty} null"));
+                }
+            }
+            CallbackParamRole::ZeroFallback => {
+                args.push(format!("{pty} {}", llvm_zero_literal(pty)));
+            }
+        }
+    }
+    args
+}
+
+fn llvm_zero_literal(ty: &str) -> &'static str {
+    let ty = ty.trim();
+    if ty == "i1" {
+        "false"
+    } else if ty.starts_with('i') {
+        "0"
+    } else if ty == "float" || ty == "half" || ty == "double" {
+        "0.000000e+00"
+    } else if ty.starts_with("ptr") {
+        "null"
+    } else {
+        "zeroinitializer"
+    }
+}
+
+fn struct_field_types(ty: &str) -> Option<Vec<String>> {
+    let t = ty.trim();
+    let inner = t
+        .strip_prefix("<{")
+        .and_then(|r| r.strip_suffix("}>"))
+        .or_else(|| t.strip_prefix('{').and_then(|r| r.strip_suffix('}')))?;
+    Some(
+        split_top_level_commas(inner)
+            .into_iter()
+            .map(|s| s.trim().to_string())
+            .collect(),
+    )
+}
+
+fn emit_triangle_callback_case(
+    s: &mut String,
+    slot: u32,
+    cb: &LinkedRayCallback,
+    has_instancing: bool,
+    idx: &ParsedParamIndices,
+    p: &PendingCall,
+) -> Result<(), String> {
+    let hid = cb.handle_id;
+    let prefix = format!("tc{hid}");
+    s.push_str(&format!("tri_case_{hid}:\n"));
+    let args = emit_callback_args(s, slot, &prefix, cb, true, has_instancing, idx, p);
+    let rty = cb.return_type.trim();
+    s.push_str(&format!(
+        "  %{prefix}_ret = call {rty} {}({})\n",
+        cb.llvm_symbol,
+        args.join(", ")
+    ));
+    let (accept_val, continue_val) = if rty == "i1" {
+        (format!("%{prefix}_ret"), "true".to_string())
+    } else if rty == "i8" || rty == "i32" {
+        s.push_str(&format!(
+            "  %{prefix}_acc = icmp ne {rty} %{prefix}_ret, 0\n"
+        ));
+        (format!("%{prefix}_acc"), "true".to_string())
+    } else if let Some(fields) = struct_field_types(rty) {
+        let mut bool_fields = Vec::new();
+        for (fi, ft) in fields.iter().enumerate() {
+            if ft == "i1" || ft == "i8" || ft == "i32" {
+                s.push_str(&format!(
+                    "  %{prefix}_f{fi} = extractvalue {rty} %{prefix}_ret, {fi}\n"
+                ));
+                if ft == "i1" {
+                    bool_fields.push(format!("%{prefix}_f{fi}"));
+                } else {
+                    s.push_str(&format!(
+                        "  %{prefix}_b{fi} = icmp ne {ft} %{prefix}_f{fi}, 0\n"
+                    ));
+                    bool_fields.push(format!("%{prefix}_b{fi}"));
+                }
+            }
+        }
+        let acc = bool_fields
+            .first()
+            .cloned()
+            .unwrap_or_else(|| "true".to_string());
+        let cont = bool_fields
+            .get(1)
+            .cloned()
+            .unwrap_or_else(|| "true".to_string());
+        (acc, cont)
+    } else {
+        return Err(format!(
+            "unsupported triangle intersection callback return type {rty:?} on {}",
+            cb.llvm_symbol
+        ));
+    };
+    s.push_str(&format!(
+        "  %{prefix}_stop_cb = xor i1 {continue_val}, true\n\
+         \x20 %{prefix}_stop = or i1 %accept_any, %{prefix}_stop_cb\n\
+         \x20 br i1 {accept_val}, label %tri_confirm_{hid}, label %tri_reject_{hid}\n\n\
+         tri_confirm_{hid}:\n\
+         \x20 call void @__m2v.rq.confirm(i32 {slot})\n\
+         \x20 br i1 %{prefix}_stop, label %term_hit, label %proceed_hdr\n\n\
+         tri_reject_{hid}:\n\
+         \x20 br i1 %{prefix}_stop_cb, label %term_hit, label %proceed_hdr\n\n"
+    ));
+    Ok(())
+}
+
+fn emit_aabb_callback_case(
+    s: &mut String,
+    slot: u32,
+    cb: &LinkedRayCallback,
+    has_instancing: bool,
+    idx: &ParsedParamIndices,
+    p: &PendingCall,
+) -> Result<(), String> {
+    let hid = cb.handle_id;
+    let prefix = format!("ac{hid}");
+    s.push_str(&format!("aabb_case_{hid}:\n"));
+    let args = emit_callback_args(s, slot, &prefix, cb, false, has_instancing, idx, p);
+    let rty = cb.return_type.trim();
+    s.push_str(&format!(
+        "  %{prefix}_ret = call {rty} {}({})\n\
+         \x20 %{prefix}_tmin = call float @__m2v.rq.get_tmin(i32 {slot})\n\
+         \x20 %{prefix}_cur_t = call float @__m2v.rq.get_t(i32 {slot}, i32 1)\n",
+        cb.llvm_symbol,
+        args.join(", ")
+    ));
+    let (accept_val, dist_val, continue_val) = if rty == "i1" {
+        (
+            format!("%{prefix}_ret"),
+            format!("%{prefix}_tmin"),
+            "true".to_string(),
+        )
+    } else if let Some(fields) = struct_field_types(rty) {
+        let mut bool_fields = Vec::new();
+        let mut float_field = None;
+        for (fi, ft) in fields.iter().enumerate() {
+            if ft == "float" && float_field.is_none() {
+                s.push_str(&format!(
+                    "  %{prefix}_f{fi} = extractvalue {rty} %{prefix}_ret, {fi}\n"
+                ));
+                float_field = Some(format!("%{prefix}_f{fi}"));
+            } else if ft == "i1" || ft == "i8" || ft == "i32" {
+                s.push_str(&format!(
+                    "  %{prefix}_f{fi} = extractvalue {rty} %{prefix}_ret, {fi}\n"
+                ));
+                if ft == "i1" {
+                    bool_fields.push(format!("%{prefix}_f{fi}"));
+                } else {
+                    s.push_str(&format!(
+                        "  %{prefix}_b{fi} = icmp ne {ft} %{prefix}_f{fi}, 0\n"
+                    ));
+                    bool_fields.push(format!("%{prefix}_b{fi}"));
+                }
+            }
+        }
+        let acc = bool_fields
+            .first()
+            .cloned()
+            .unwrap_or_else(|| "false".to_string());
+        let dist = float_field.unwrap_or_else(|| format!("%{prefix}_tmin"));
+        let cont = bool_fields
+            .get(1)
+            .cloned()
+            .unwrap_or_else(|| "true".to_string());
+        (acc, dist, cont)
+    } else {
+        return Err(format!(
+            "unsupported bounding-box intersection callback return type {rty:?} on {}",
+            cb.llvm_symbol
+        ));
+    };
+
+    s.push_str(&format!(
+        "  %{prefix}_ge_min = fcmp oge float {dist_val}, %{prefix}_tmin\n\
+         \x20 %{prefix}_le_cur = fcmp ole float {dist_val}, %{prefix}_cur_t\n\
+         \x20 %{prefix}_in_range = and i1 %{prefix}_ge_min, %{prefix}_le_cur\n\
+         \x20 %{prefix}_valid = and i1 {accept_val}, %{prefix}_in_range\n\
+         \x20 %{prefix}_stop_cb = xor i1 {continue_val}, true\n\
+         \x20 %{prefix}_stop = or i1 %accept_any, %{prefix}_stop_cb\n\
+         \x20 br i1 %{prefix}_valid, label %aabb_gen_{hid}, label %aabb_miss_{hid}\n\n\
+         aabb_gen_{hid}:\n\
+         \x20 call void @__m2v.rq.generate(i32 {slot}, float {dist_val})\n\
+         \x20 br i1 %{prefix}_stop, label %term_hit, label %proceed_hdr\n\n\
+         aabb_miss_{hid}:\n\
+         \x20 br i1 %{prefix}_stop_cb, label %term_hit, label %proceed_hdr\n\n"
+    ));
+    Ok(())
+}
