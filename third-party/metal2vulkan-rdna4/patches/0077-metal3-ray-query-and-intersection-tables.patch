+    bindings.sort_by_key(|b| b.param_index);
+    bindings
+}
+
+fn rewrite_ift_metadata_line(line: &str, table_param_indices: &HashSet<u32>) -> Option<String> {
+    let open = line.find("!{")?;
+    let close = line.rfind('}')?;
+    if close <= open + 2 {
+        return None;
+    }
+    let body = &line[open + 2..close];
+    let first_field = body.split(',').next()?.trim();
+    let param_idx: u32 = first_field.strip_prefix("i32 ")?.trim().parse().ok()?;
+    if !table_param_indices.contains(&param_idx) {
+        return None;
+    }
+    let mut new_body = body
+        .replace("!\"air.intersection_function_table\"", "!\"air.buffer\"")
+        .replace("!\"intersection_function_table\"", "!\"uint\"");
+    if !new_body.contains("!\"air.read\"")
+        && !new_body.contains("!\"air.write\"")
+        && !new_body.contains("!\"air.read_write\"")
+    {
+        new_body.push_str(", !\"air.read\"");
+    }
+    if !new_body.contains("!\"air.address_space\"") {
+        new_body.push_str(", !\"air.address_space\", i32 1");
+    }
+    if !new_body.contains("!\"air.arg_type_size\"") {
+        new_body.push_str(", !\"air.arg_type_size\", i32 4");
+    }
+    if !new_body.contains("!\"air.arg_type_align_size\"") {
+        new_body.push_str(", !\"air.arg_type_align_size\", i32 4");
+    }
+    if !new_body.contains("!\"air.arg_type_name\"") {
+        new_body.push_str(", !\"air.arg_type_name\", !\"uint\"");
+    }
+    Some(format!("{}{}{}", &line[..open + 2], new_body, &line[close..]))
+}
+
+fn find_matching_paren_lf(text: &str, open: usize) -> Option<usize> {
+    let mut depth = 0usize;
+    for (offset, ch) in text[open..].char_indices() {
+        match ch {
+            '(' => depth += 1,
+            ')' => {
+                depth = depth.saturating_sub(1);
+                if depth == 0 {
+                    return Some(open + offset);
+                }
+            }
+            _ => {}
+        }
+    }
+    None
+}
+
+fn split_type_and_value_text(param: &str) -> Option<String> {
+    let param = param.trim();
+    if param.is_empty() {
+        return None;
+    }
+    let mut dp = 0usize;
+    let mut da = 0usize;
+    let mut db = 0usize;
+    let mut dk = 0usize;
+    let mut last_ws = None;
+    for (i, ch) in param.char_indices() {
+        match ch {
+            '(' => dp += 1,
+            ')' => dp = dp.saturating_sub(1),
+            '<' => da += 1,
+            '>' => da = da.saturating_sub(1),
+            '{' => db += 1,
+            '}' => db = db.saturating_sub(1),
+            '[' => dk += 1,
+            ']' => dk = dk.saturating_sub(1),
+            c if c.is_ascii_whitespace() && dp == 0 && da == 0 && db == 0 && dk == 0 => {
+                last_ws = Some(i);
+            }
+            _ => {}
+        }
+    }
+    let head = match last_ws {
+        Some(ws) if param[ws..].trim().starts_with('%') => param[..ws].trim(),
+        _ => param,
+    };
+    let mut ty = head;
+    loop {
+        let trimmed = ty.trim_end();
+        let stripped = [
+            "noundef",
+            "nonnull",
+            "nocapture",
+            "readonly",
+            "writeonly",
+            "noalias",
+            "signext",
+            "zeroext",
+        ]
+        .iter()
+        .find_map(|attr| {
+            trimmed
+                .strip_suffix(attr)
+                .filter(|rest| rest.ends_with(char::is_whitespace))
+                .map(str::trim_end)
+        });
+        if let Some(next) = stripped {
+            ty = next;
+        } else {
+            break;
+        }
+    }
+    Some(ty.to_string())
+}
+
+fn extract_return_type_text(before_at: &str) -> Result<String, String> {
+    let mut s = before_at.trim();
+    if let Some(rest) = s.strip_prefix("define ") {
+        s = rest.trim_start();
+    }
+    let keywords = [
+        "private",
+        "internal",
+        "available_externally",
+        "linkonce",
+        "weak",
+        "common",
+        "appending",
+        "extern_weak",
+        "linkonce_odr",
+        "weak_odr",
+        "external",
+        "dso_local",
+        "dso_preemptable",
+        "local_unnamed_addr",
+        "unnamed_addr",
+        "hidden",
+        "protected",
+        "default",
+        "ccc",
+        "fastcc",
+        "coldcc",
+        "spir_func",
+        "spir_kernel",
+        "air_kernel",
+        "noundef",
+        "zeroext",
+        "signext",
+        "inreg",
+        "noalias",
+    ];
+    loop {
+        let mut advanced = false;
+        for kw in keywords {
+            if let Some(rest) = s.strip_prefix(kw) {
+                if rest.starts_with(char::is_whitespace) {
+                    s = rest.trim_start();
+                    advanced = true;
+                    break;
+                }
+            }
+        }
+        if !advanced {
+            break;
+        }
+    }
+    if s.is_empty() {
+        return Err(format!("empty return type in header: {before_at}"));
+    }
+    Ok(s.to_string())
+}
