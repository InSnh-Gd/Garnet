+        crate::passes::Stage::Kernel => crate::meta::parse_air_kernel_meta(entry_ll)
+            .map(|m| {
+                m.roles
+                    .into_iter()
+                    .filter_map(|(param_index, role)| match role {
+                        crate::meta::KernRole::IntersectionFunctionTable(metal_index) => {
+                            Some(RuntimeIntersectionFunctionTableBinding {
+                                param_index,
+                                metal_index,
+                            })
