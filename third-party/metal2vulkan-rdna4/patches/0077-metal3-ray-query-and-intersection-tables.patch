+/// Lower runtime `MTLIntersectionFunctionTable` parameters into read-only `uint32_t[]`
+/// `StorageBuffer`s (matching the 0074 VFT buffer ABI: `word[0] = slot_count`,
+/// `word[1 + slot] = handle_id`), link all authored custom bounding-box and triangle any-hit
+/// intersection functions with deterministic 1-based handles, and lower `@air.intersect.*`
+/// calls into structured `@__m2v.rq.*` hardware ray queries with bounded `switch` dispatch.
+pub fn specialize_runtime_intersection_function_tables(
+    entry_ll: &str,
+    stage: crate::passes::Stage,
+    _entry_name: &str,
+    linkage: &LinkedFunctionLinkage,
+) -> Result<(String, Option<RuntimeIntersectionFunctionTableInfo>), String> {
+    if !linkage.runtime_intersection_tables && linkage.runtime_intersection_functions.is_empty() {
+        return Ok((entry_ll.to_string(), None));
+    }
+
+    let tables = discover_intersection_function_table_bindings(entry_ll, stage);
+    if tables.is_empty() && !entry_ll.contains("@air.intersect.intersection_function_buffer") {
+        return Ok((entry_ll.to_string(), None));
+    }
+    let table_param_indices: HashSet<u32> = tables.iter().map(|t| t.param_index).collect();
+
+    // Sort and deduplicate runtime intersection functions deterministically by symbol name.
+    let mut sorted_fns: Vec<&LinkedIntersectionFunction> =
+        linkage.runtime_intersection_functions.iter().collect();
+    sorted_fns.sort_by(|a, b| a.symbol.cmp(&b.symbol));
+    let mut unique_fns: Vec<&LinkedIntersectionFunction> = Vec::with_capacity(sorted_fns.len());
+    for f in sorted_fns {
+        if let Some(prev) = unique_fns.last() {
+            if prev.symbol == f.symbol {
+                if prev.kind != f.kind || prev.module_ll != f.module_ll {
+                    return Err(format!(
+                        "runtime intersection function {:?} provided twice with conflicting definitions",
+                        f.symbol
+                    ));
+                }
+                continue;
+            }
+        }
+        unique_fns.push(f);
+    }
+
+    // Rewrite `air.intersection_function_table` metadata entries to `air.buffer` (`uint` SSBO)
+    // and drop any dead `air.set_buffer_intersection_function_table.*` calls if unused.
+    let mut output = String::with_capacity(entry_ll.len() + 2048);
+    let mut in_func = false;
+    for raw_line in entry_ll.lines() {
+        let trimmed = raw_line.trim_start();
+        if trimmed.starts_with("define ") {
+            in_func = !trimmed.ends_with('}');
+        } else if trimmed == "}" {
+            in_func = false;
+        }
+        if !in_func
+            && trimmed.starts_with('!')
+            && trimmed.contains(" = !{")
+            && trimmed.contains("!\"air.intersection_function_table\"")
+        {
+            if let Some(rewritten) = rewrite_ift_metadata_line(raw_line, &table_param_indices) {
+                output.push_str(&rewritten);
+                output.push('\n');
+                continue;
+            }
+        }
+        output.push_str(raw_line);
+        output.push('\n');
+    }
+
+    let entry_blocks = normalized_function_blocks(&output);
+    let mut handles = Vec::with_capacity(unique_fns.len());
+    let mut callbacks = Vec::with_capacity(unique_fns.len());
+    let mut linked_modules: Vec<&str> = Vec::new();
+    let mut linked_module_set: HashSet<&str> = HashSet::new();
+
+    for (idx, func) in unique_fns.iter().enumerate() {
+        let handle_id = (idx as u32) + 1;
+        let global = llvm_global(&func.symbol)?;
+        let (return_type, param_types) = parse_callback_signature(&func.module_ll, &global)?;
+        let param_roles =
+            decode_callback_param_roles(&func.module_ll, &func.symbol, func.kind, &param_types);
+        handles.push(RuntimeIntersectionFunctionHandle {
+            handle_id,
+            symbol: func.symbol.clone(),
+            kind: func.kind,
+        });
+        callbacks.push(crate::native::ray_query_air::LinkedRayCallback {
+            handle_id,
+            kind: func.kind,
+            llvm_symbol: global.clone(),
+            return_type,
+            param_types,
+            param_roles,
+        });
+        if let Some(entry_body) = entry_blocks.get(&global) {
+            let mod_blocks = normalized_function_blocks(&func.module_ll);
+            if let Some(mod_body) = mod_blocks.get(&global) {
+                if mod_body != entry_body {
+                    return Err(format!(
+                        "runtime intersection function {:?} conflicts with existing definition in entry module",
+                        func.symbol
+                    ));
+                }
+            }
+            // Already identically defined in `entry_ll` (single-MTLLibrary shader +
+            // [[intersection(...)]] function); keep it in callbacks/handles without re-appending.
+            continue;
+        }
+        if linked_module_set.insert(func.module_ll.as_str()) {
+            linked_modules.push(func.module_ll.as_str());
+        }
+    }
+
+    // Append linked callback definitions BEFORE `lower_air_ray_queries` so `strip_matching_defined_functions`
+    // compares against the un-lowered entry function (allowing whole-library modules that also contain
+    // the entry function alongside a split-library callback) while still rejecting genuine conflicts.
+    for module in linked_modules {
+        let resolved = specialize_visible_function_references(module, linkage)?;
+        let trimmed_dep = strip_matching_defined_functions(&output, &resolved)?;
+        let newly_defined: HashSet<String> = trimmed_dep
+            .lines()
+            .filter_map(|line| {
+                let t = line.trim_start();
+                t.starts_with("define ")
+                    .then(|| definition_global(t))
+                    .flatten()
+            })
+            .collect();
+        if !newly_defined.is_empty() {
+            let mut stripped_output = String::with_capacity(output.len());
+            for line in output.lines() {
+                if let Some((global, _)) = declaration_global(line.trim_start()) {
+                    if newly_defined.contains(global) {
+                        continue;
+                    }
+                }
+                stripped_output.push_str(line);
+                stripped_output.push('\n');
+            }
+            output = stripped_output;
+            output.push('\n');
+            append_dependency_module(&mut output, &trimmed_dep)?;
+        }
+    }
+
+    // Lower `@air.intersect.*` calls into `@__m2v.rq.*` structured ray queries referencing the
+    // linked callback symbols.
+    if let Some(lowered) =
+        crate::native::ray_query_air::lower_air_ray_queries(&output, &callbacks)?
+    {
+        output = lowered;
+    }
+
+    let info = RuntimeIntersectionFunctionTableInfo {
+        abi_version: 1,
+        header_words: 1,
+        tables,
+        handles,
+    };
+    Ok((output, Some(info)))
+}
