+                        _ => None,
+                    })
+                    .collect()
+            })
+            .unwrap_or_default(),
+        crate::passes::Stage::Object => crate::meta::parse_air_object_meta(entry_ll)
+            .map(|m| {
+                m.roles
+                    .into_iter()
+                    .filter_map(|(param_index, role)| match role {
+                        crate::meta::KernRole::IntersectionFunctionTable(metal_index) => {
+                            Some(RuntimeIntersectionFunctionTableBinding {
+                                param_index,
+                                metal_index,
+                            })
+                        }
+                        _ => None,
+                    })
+                    .collect()
+            })
+            .unwrap_or_default(),
+        crate::passes::Stage::Mesh => crate::meta::parse_air_mesh_meta(entry_ll)
+            .map(|m| {
+                m.roles
+                    .into_iter()
+                    .filter_map(|(param_index, role)| match role {
+                        crate::meta::KernRole::IntersectionFunctionTable(metal_index) => {
+                            Some(RuntimeIntersectionFunctionTableBinding {
+                                param_index,
+                                metal_index,
+                            })
+                        }
+                        _ => None,
+                    })
+                    .collect()
+            })
+            .unwrap_or_default(),
+        crate::passes::Stage::Vertex => crate::meta::parse_air_vertex_meta(entry_ll)
+            .map(|m| {
+                m.roles
+                    .into_iter()
+                    .filter_map(|(param_index, role)| match role {
+                        crate::meta::VertRole::IntersectionFunctionTable(metal_index) => {
+                            Some(RuntimeIntersectionFunctionTableBinding {
+                                param_index,
+                                metal_index,
+                            })
+                        }
+                        _ => None,
+                    })
+                    .collect()
+            })
+            .unwrap_or_default(),
+        crate::passes::Stage::Fragment => crate::meta::parse_air_fragment_meta(entry_ll)
+            .map(|m| {
+                m.roles
+                    .into_iter()
+                    .filter_map(|(param_index, role)| match role {
+                        crate::meta::FragRole::IntersectionFunctionTable(metal_index) => {
+                            Some(RuntimeIntersectionFunctionTableBinding {
+                                param_index,
