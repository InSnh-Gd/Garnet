+fn parse_callback_signature(
+    module_ll: &str,
+    global: &str,
+) -> Result<(String, Vec<String>), String> {
+    for line in module_ll.lines() {
+        let trimmed = line.trim_start();
+        if !trimmed.starts_with("define ") {
+            continue;
+        }
+        if definition_global(trimmed).as_deref() != Some(global) {
+            continue;
+        }
+        let at = trimmed
+            .find(global)
+            .ok_or_else(|| format!("malformed definition header for {global}"))?;
+        let before = trimmed[..at].trim_end();
+        let return_type = extract_return_type_text(before)?;
+        let open = trimmed[at..]
+            .find('(')
+            .map(|o| at + o)
+            .ok_or_else(|| format!("missing '(' in definition header of {global}"))?;
+        let close = find_matching_paren_lf(trimmed, open)
+            .ok_or_else(|| format!("missing ')' in definition header of {global}"))?;
+        let params_str = trimmed[open + 1..close].trim();
+        let mut param_types = Vec::new();
+        if !params_str.is_empty() {
+            for p in split_top_level(params_str, ',') {
+                let ty = split_type_and_value_text(p)
+                    .ok_or_else(|| format!("cannot parse param type {p:?} in {global}"))?;
+                param_types.push(ty);
+            }
+        }
+        return Ok((return_type, param_types));
+    }
+    Err(format!(
+        "runtime intersection function {global} is not defined in its linked module"
+    ))
+}
+
+fn decode_callback_param_roles(
+    module_ll: &str,
+    _symbol: &str,
+    kind: IntersectionFunctionKind,
+    param_types: &[String],
+) -> Vec<crate::native::ray_query_air::CallbackParamRole> {
+    use crate::native::ray_query_air::CallbackParamRole as Role;
+
+    // First look for AIR parameter role metadata (`!{i32 idx, !"air.<role>", ...}`).
+    let mut by_idx: HashMap<usize, Role> = HashMap::new();
+    for line in module_ll.lines() {
+        let trimmed = line.trim();
+        if !trimmed.starts_with('!') || !trimmed.contains("!{") {
+            continue;
+        }
+        let Some(open) = trimmed.find("!{") else {
+            continue;
+        };
+        let body = &trimmed[open + 2..];
+        let Some(first) = body.split(',').next() else {
+            continue;
+        };
+        let Some(idx) = first
+            .trim()
+            .strip_prefix("i32 ")
+            .and_then(|s| s.trim().parse::<usize>().ok())
+        else {
+            continue;
+        };
+        if idx >= param_types.len() {
+            continue;
+        }
+        let role = if body.contains("!\"air.world_space_origin\"") {
+            Some(Role::WorldOrigin)
+        } else if body.contains("!\"air.origin\"") {
+            Some(Role::Origin)
+        } else if body.contains("!\"air.world_space_direction\"") {
+            Some(Role::WorldDirection)
+        } else if body.contains("!\"air.direction\"") {
+            Some(Role::Direction)
+        } else if body.contains("!\"air.min_distance\"") {
+            Some(Role::MinDistance)
+        } else if body.contains("!\"air.max_distance\"") || body.contains("!\"air.distance\"") {
+            Some(Role::MaxDistance)
+        } else if body.contains("!\"air.barycentric_coord\"") {
+            Some(Role::Barycentrics)
+        } else if body.contains("!\"air.front_facing\"") {
+            Some(Role::FrontFacing)
+        } else if body.contains("!\"air.primitive_id\"") {
+            Some(Role::PrimitiveId)
+        } else if body.contains("!\"air.geometry_id\"") {
+            Some(Role::GeometryId)
+        } else if body.contains("!\"air.user_instance_id\"") {
+            Some(Role::UserInstanceId)
+        } else if body.contains("!\"air.instance_id\"") {
+            Some(Role::InstanceId)
+        } else if body.contains("!\"air.payload\"") || body.contains("!\"air.ray_data\"") {
+            Some(Role::PayloadPtr)
+        } else if body.contains("!\"air.user_data\"")
+            || body.contains("!\"air.primitive_data\"")
+            || body.contains("!\"air.geometry_data\"")
+        {
+            Some(Role::UserDataPtr)
+        } else {
+            None
+        };
+        if let Some(r) = role {
+            by_idx.entry(idx).or_insert(r);
+        }
+    }
+
+    // Fill any unannotated parameters using standard Metal intersection signature conventions.
+    let mut vec3_seen = 0u8;
+    let mut f32_seen = 0u8;
+    let mut i32_seen = 0u8;
+    let mut out = Vec::with_capacity(param_types.len());
+    for (idx, ty) in param_types.iter().enumerate() {
+        if let Some(&r) = by_idx.get(&idx) {
+            out.push(r);
+            continue;
+        }
+        let t = ty.trim();
+        let inferred = if t == "<3 x float>" {
+            let r = match vec3_seen {
+                0 => Role::Origin,
+                1 => Role::Direction,
+                2..=5 => Role::ObjectToWorldCol(vec3_seen - 2),
+                6..=9 => Role::WorldToObjectCol(vec3_seen - 6),
+                _ => Role::ZeroFallback,
+            };
+            vec3_seen = vec3_seen.saturating_add(1);
+            r
+        } else if t == "float" {
+            let r = match f32_seen {
+                0 => Role::MinDistance,
+                1 => Role::MaxDistance,
+                _ => Role::ZeroFallback,
+            };
+            f32_seen = f32_seen.saturating_add(1);
+            r
+        } else if t == "<2 x float>" && kind == IntersectionFunctionKind::TriangleAnyHit {
+            Role::Barycentrics
+        } else if t == "i1" && kind == IntersectionFunctionKind::TriangleAnyHit {
+            Role::FrontFacing
+        } else if t == "i32" {
+            let r = match i32_seen {
+                0 => Role::PrimitiveId,
+                1 => Role::GeometryId,
+                2 => Role::InstanceId,
+                3 => Role::UserInstanceId,
+                _ => Role::ZeroFallback,
+            };
+            i32_seen = i32_seen.saturating_add(1);
+            r
+        } else if t == "ptr" || t == "ptr addrspace(0)" {
+            Role::PayloadPtr
+        } else if t.starts_with("ptr addrspace(") {
+            Role::UserDataPtr
+        } else {
+            Role::ZeroFallback
+        };
+        out.push(inferred);
+    }
+    out
+}
