--- /dev/null
+++ b/src/passes/ray_query.rs
@@ -0,0 +1,1106 @@
+//! SPIR-V `SPV_KHR_ray_query` lowering pass.
+//!
+//! Lowers internal `@__m2v.rq.*` function calls (emitted by `native::ray_query_air` and
+//! `linked_functions::specialize_runtime_intersection_function_tables`) directly into
+//! hardware `OpRayQuery*KHR` SPIR-V instructions and cleans up their temporary declarations.
+
+use super::*;
+use std::collections::{BTreeMap, HashMap};
+
+fn find_or_add_type(ctx: &mut Ctx, op: Op, operands: Vec<Operand>) -> Word {
+    for inst in ctx
+        .module
+        .types_global_values
+        .iter()
+        .chain(ctx.new_globals.iter())
+    {
+        if inst.class.opcode == op && inst.operands == operands {
+            if let Some(id) = inst.result_id {
+                return id;
+            }
+        }
+    }
+    let id = ctx.module.fresh_id();
+    ctx.new_globals.push(type_inst(op, id, operands));
+    id
+}
+
+pub(in crate::passes) fn ty_acceleration_structure(ctx: &mut Ctx) -> Word {
+    find_or_add_type(ctx, Op::TypeAccelerationStructureKHR, vec![])
+}
+
+fn ty_ray_query(ctx: &mut Ctx) -> Word {
+    find_or_add_type(ctx, Op::TypeRayQueryKHR, vec![])
+}
+
+fn ty_mat4x3(ctx: &mut Ctx) -> Word {
+    let v3f = ctx.ty_vecf(3);
+    find_or_add_type(
+        ctx,
+        Op::TypeMatrix,
+        vec![Operand::IdRef(v3f), Operand::LiteralBit32(4)],
+    )
+}
+
+fn ty_u64(ctx: &mut Ctx) -> Word {
+    find_or_add_type(
+        ctx,
+        Op::TypeInt,
+        vec![Operand::LiteralBit32(64), Operand::LiteralBit32(0)],
+    )
+}
+
+fn const_u32_from_defs(defs: &HashMap<Word, Instruction>, id: Word) -> Option<u32> {
+    let inst = defs.get(&id)?;
+    match inst.class.opcode {
+        Op::Constant => match inst.operands.first() {
+            Some(Operand::LiteralBit32(v)) => Some(*v),
+            _ => None,
+        },
+        Op::ConstantNull => Some(0),
+        _ => None,
+    }
+}
+
+fn ensure_uint(
+    ctx: &mut Ctx,
+    defs: &HashMap<Word, Instruction>,
+    val_tys: &HashMap<Word, Word>,
+    val: Word,
+    out: &mut Vec<Instruction>,
+) -> Word {
+    let uint_ty = ctx.ty_uint();
+    let Some(&vty) = val_tys.get(&val) else {
+        return val;
+    };
+    if vty == uint_ty {
+        return val;
+    }
+    if let Some(def) = defs.get(&vty) {
+        if def.class.opcode == Op::TypeInt
+            && def.operands.first() == Some(&Operand::LiteralBit32(32))
+        {
+            let cast = ctx.module.fresh_id();
+            out.push(Instruction::new(
+                Op::Bitcast,
+                Some(uint_ty),
+                Some(cast),
+                vec![Operand::IdRef(val)],
+            ));
+            return cast;
+        }
+    }
+    val
+}
+
+fn ensure_accel_value(
+    ctx: &mut Ctx,
+    defs: &HashMap<Word, Instruction>,
+    val_tys: &HashMap<Word, Word>,
+    val: Word,
+    out: &mut Vec<Instruction>,
+) -> Result<Word, String> {
+    let accel_ty = ty_acceleration_structure(ctx);
+    let Some(&vty) = val_tys.get(&val) else {
+        return Ok(val);
+    };
+    if vty == accel_ty {
+        return Ok(val);
+    }
+    let Some(ty_def) = defs.get(&vty) else {
+        return Err(format!(
+            "ray_query: acceleration structure operand {val} has unknown type {vty}"
+        ));
+    };
+    match ty_def.class.opcode {
+        Op::TypeAccelerationStructureKHR => Ok(val),
+        Op::TypeInt if ty_def.operands.first() == Some(&Operand::LiteralBit32(64)) => {
+            let u64_ty = ty_u64(ctx);
+            let src = if vty == u64_ty {
+                val
+            } else {
+                let cast = ctx.module.fresh_id();
+                out.push(Instruction::new(
+                    Op::Bitcast,
+                    Some(u64_ty),
+                    Some(cast),
+                    vec![Operand::IdRef(val)],
+                ));
+                cast
+            };
+            let accel = ctx.module.fresh_id();
+            out.push(Instruction::new(
+                Op::ConvertUToAccelerationStructureKHR,
+                Some(accel_ty),
+                Some(accel),
+                vec![Operand::IdRef(src)],
+            ));
+            Ok(accel)
+        }
+        Op::TypeVector if ty_def.operands.get(1) == Some(&Operand::LiteralBit32(2)) => {
+            let accel = ctx.module.fresh_id();
+            out.push(Instruction::new(
+                Op::ConvertUToAccelerationStructureKHR,
+                Some(accel_ty),
+                Some(accel),
+                vec![Operand::IdRef(val)],
+            ));
+            Ok(accel)
+        }
+        Op::TypePointer
+            if ty_def.operands.first()
+                == Some(&Operand::StorageClass(StorageClass::PhysicalStorageBuffer)) =>
+        {
+            let u64_ty = ty_u64(ctx);
+            let addr = ctx.module.fresh_id();
+            out.push(Instruction::new(
+                Op::ConvertPtrToU,
+                Some(u64_ty),
+                Some(addr),
+                vec![Operand::IdRef(val)],
+            ));
+            let accel = ctx.module.fresh_id();
+            out.push(Instruction::new(
+                Op::ConvertUToAccelerationStructureKHR,
+                Some(accel_ty),
+                Some(accel),
+                vec![Operand::IdRef(addr)],
+            ));
+            Ok(accel)
+        }
+        Op::TypePointer => {
+            // If an AS variable pointer was passed directly instead of a loaded AS value, load it.
+            if let Some(Operand::IdRef(pointee)) = ty_def.operands.get(1) {
+                if defs
+                    .get(pointee)
+                    .is_some_and(|d| d.class.opcode == Op::TypeAccelerationStructureKHR)
+                {
+                    let loaded = ctx.module.fresh_id();
+                    out.push(Instruction::new(
+                        Op::Load,
+                        Some(accel_ty),
+                        Some(loaded),
+                        vec![Operand::IdRef(val)],
+                    ));
+                    return Ok(loaded);
+                }
+            }
+            Err(format!(
+                "ray_query: cannot convert pointer operand {val} (type {vty}) to AccelerationStructureKHR"
+            ))
+        }
+        other => Err(format!(
+            "ray_query: unsupported acceleration structure operand {val} of opcode {other:?}"
+        )),
+    }
+}
+
+/// Lower all `@__m2v.rq.*` function calls in `entry_idx` to `OpRayQuery*KHR` instructions.
+pub(in crate::passes) fn lower_ray_query_calls(
+    ctx: &mut Ctx,
+    entry_idx: usize,
+) -> Result<(), String> {
+    let mut rq_fn_names: HashMap<Word, String> = HashMap::new();
+    for inst in &ctx.module.debug_names {
+        if inst.class.opcode != Op::Name {
+            continue;
+        }
+        if let [Operand::IdRef(id), Operand::LiteralString(name)] = inst.operands.as_slice() {
+            if name.starts_with("__m2v.rq.") {
+                rq_fn_names.insert(*id, name.clone());
+            }
+        }
+    }
+    if rq_fn_names.is_empty() {
+        return Ok(());
+    }
+
+    // Collect definitions (types + constants) and value types in the entry function.
+    let mut defs: HashMap<Word, Instruction> = HashMap::new();
+    for inst in ctx
+        .module
+        .types_global_values
+        .iter()
+        .chain(ctx.new_globals.iter())
+    {
+        if let Some(id) = inst.result_id {
+            defs.insert(id, inst.clone());
+        }
+    }
+    let mut val_tys: HashMap<Word, Word> = HashMap::new();
+    for inst in ctx
+        .module
+        .types_global_values
+        .iter()
+        .chain(ctx.new_globals.iter())
+    {
+        if let (Some(id), Some(ty)) = (inst.result_id, inst.result_type) {
+            val_tys.insert(id, ty);
+        }
+    }
+    for param in &ctx.module.functions[entry_idx].parameters {
+        if let (Some(id), Some(ty)) = (param.result_id, param.result_type) {
+            val_tys.insert(id, ty);
+        }
+    }
+    for blk in &ctx.module.functions[entry_idx].blocks {
+        for inst in &blk.instructions {
+            if let (Some(id), Some(ty)) = (inst.result_id, inst.result_type) {
+                val_tys.insert(id, ty);
+            }
+        }
+    }
+
+    // Scan entry blocks to discover all unique ray-query slot IDs referenced.
+    let mut slots: BTreeMap<u32, Word> = BTreeMap::new();
+    let mut has_any_call = false;
+    for blk in &ctx.module.functions[entry_idx].blocks {
+        for inst in &blk.instructions {
+            if inst.class.opcode != Op::FunctionCall {
+                continue;
+            }
+            let Some(Operand::IdRef(callee)) = inst.operands.first() else {
+                continue;
+            };
+            if !rq_fn_names.contains_key(callee) {
+                continue;
+            }
+            has_any_call = true;
+            let slot = inst
+                .operands
+                .get(1)
+                .and_then(|op| match op {
+                    Operand::IdRef(id) => const_u32_from_defs(&defs, *id),
+                    _ => None,
+                })
+                .unwrap_or(0);
+            slots.entry(slot).or_insert(0);
+        }
+    }
+    if !has_any_call {
+        return Ok(());
+    }
+
+    // Allocate one Function-storage OpTypeRayQueryKHR OpVariable per unique slot.
+    let rq_ty = ty_ray_query(ctx);
+    let rq_ptr_ty = ctx.ty_ptr(StorageClass::Function, rq_ty);
+    let mut rq_vars = Vec::with_capacity(slots.len());
+    for (_, var_id) in slots.iter_mut() {
+        let id = ctx.module.fresh_id();
+        *var_id = id;
+        rq_vars.push(Instruction::new(
+            Op::Variable,
+            Some(rq_ptr_ty),
+            Some(id),
+            vec![Operand::StorageClass(StorageClass::Function)],
+        ));
+    }
+    // Insert all OpVariable instructions at the very start of block 0.
+    if let Some(entry_blk) = ctx.module.functions[entry_idx].blocks.first_mut() {
+        for (i, var_inst) in rq_vars.into_iter().enumerate() {
+            entry_blk.instructions.insert(i, var_inst);
+        }
+    }
+
+    // Rewrite every `@__m2v.rq.*` OpFunctionCall across all blocks.
+    let uint_ty = ctx.ty_uint();
+    let bool_ty = ctx.ty_bool();
+    let f32_ty = ctx.ty_float();
+    let v2f_ty = ctx.ty_vecf(2);
+    let v3f_ty = ctx.ty_vecf(3);
+    let mat4x3_ty = ty_mat4x3(ctx);
+
+    let block_count = ctx.module.functions[entry_idx].blocks.len();
+    for bi in 0..block_count {
+        let old_insts =
+            std::mem::take(&mut ctx.module.functions[entry_idx].blocks[bi].instructions);
+        let mut new_insts = Vec::with_capacity(old_insts.len());
+        for inst in old_insts {
+            if inst.class.opcode != Op::FunctionCall {
+                new_insts.push(inst);
+                continue;
+            }
+            let Some(&Operand::IdRef(callee)) = inst.operands.first() else {
+                new_insts.push(inst);
+                continue;
+            };
+            let Some(name) = rq_fn_names.get(&callee).cloned() else {
+                new_insts.push(inst);
+                continue;
+            };
+            let args: Vec<Word> = inst
+                .operands
+                .iter()
+                .skip(1)
+                .filter_map(|op| match op {
+                    Operand::IdRef(id) => Some(*id),
+                    _ => None,
+                })
+                .collect();
+            let slot = args
+                .first()
+                .and_then(|&id| const_u32_from_defs(&defs, id))
+                .unwrap_or(0);
+            let rq_var = *slots
+                .get(&slot)
+                .ok_or_else(|| format!("ray_query: missing allocated slot {slot}"))?;
+            let res = inst.result_id;
+            let rty = inst.result_type;
+
+            match name.as_str() {
+                "__m2v.rq.init" | "__m2v.rq.init.bda" => {
+                    if args.len() < 8 {
+                        return Err(format!("{name} expects 8 operands, got {}", args.len()));
+                    }
+                    let accel = ensure_accel_value(ctx, &defs, &val_tys, args[1], &mut new_insts)?;
+                    let flags = ensure_uint(ctx, &defs, &val_tys, args[2], &mut new_insts);
+                    let mask = ensure_uint(ctx, &defs, &val_tys, args[3], &mut new_insts);
+                    new_insts.push(Instruction::new(
+                        Op::RayQueryInitializeKHR,
+                        None,
+                        None,
+                        vec![
+                            Operand::IdRef(rq_var),
+                            Operand::IdRef(accel),
+                            Operand::IdRef(flags),
+                            Operand::IdRef(mask),
+                            Operand::IdRef(args[4]), // origin (v3f)
+                            Operand::IdRef(args[5]), // tmin (f32)
+                            Operand::IdRef(args[6]), // direction (v3f)
+                            Operand::IdRef(args[7]), // tmax (f32)
+                        ],
+                    ));
+                }
+                "__m2v.rq.proceed" => {
+                    new_insts.push(Instruction::new(
+                        Op::RayQueryProceedKHR,
+                        Some(rty.unwrap_or(bool_ty)),
+                        res,
+                        vec![Operand::IdRef(rq_var)],
+                    ));
+                }
+                "__m2v.rq.terminate" => {
+                    new_insts.push(Instruction::new(
+                        Op::RayQueryTerminateKHR,
+                        None,
+                        None,
+                        vec![Operand::IdRef(rq_var)],
+                    ));
+                }
+                "__m2v.rq.confirm" => {
+                    new_insts.push(Instruction::new(
+                        Op::RayQueryConfirmIntersectionKHR,
+                        None,
+                        None,
+                        vec![Operand::IdRef(rq_var)],
+                    ));
+                }
+                "__m2v.rq.generate" => {
+                    if args.len() < 2 {
+                        return Err(format!("{name} expects 2 operands"));
+                    }
+                    new_insts.push(Instruction::new(
+                        Op::RayQueryGenerateIntersectionKHR,
+                        None,
+                        None,
+                        vec![Operand::IdRef(rq_var), Operand::IdRef(args[1])],
+                    ));
+                }
+                "__m2v.rq.get_tmin" => {
+                    new_insts.push(Instruction::new(
+                        Op::RayQueryGetRayTMinKHR,
+                        Some(rty.unwrap_or(f32_ty)),
+                        res,
+                        vec![Operand::IdRef(rq_var)],
+                    ));
+                }
+                "__m2v.rq.get_world_ray_origin" => {
+                    new_insts.push(Instruction::new(
+                        Op::RayQueryGetWorldRayOriginKHR,
+                        Some(rty.unwrap_or(v3f_ty)),
+                        res,
+                        vec![Operand::IdRef(rq_var)],
+                    ));
+                }
+                "__m2v.rq.get_world_ray_direction" => {
+                    new_insts.push(Instruction::new(
+                        Op::RayQueryGetWorldRayDirectionKHR,
+                        Some(rty.unwrap_or(v3f_ty)),
+                        res,
+                        vec![Operand::IdRef(rq_var)],
+                    ));
+                }
+                "__m2v.rq.get_type"
+                | "__m2v.rq.get_primitive_index"
+                | "__m2v.rq.get_geometry_index"
+                | "__m2v.rq.get_instance_id"
+                | "__m2v.rq.get_instance_custom_index"
+                | "__m2v.rq.get_sbt_offset" => {
+                    if args.len() < 2 {
+                        return Err(format!("{name} expects 2 operands"));
+                    }
+                    let op = match name.as_str() {
+                        "__m2v.rq.get_type" => Op::RayQueryGetIntersectionTypeKHR,
+                        "__m2v.rq.get_primitive_index" => {
+                            Op::RayQueryGetIntersectionPrimitiveIndexKHR
+                        }
+                        "__m2v.rq.get_geometry_index" => {
+                            Op::RayQueryGetIntersectionGeometryIndexKHR
+                        }
+                        "__m2v.rq.get_instance_id" => Op::RayQueryGetIntersectionInstanceIdKHR,
+                        "__m2v.rq.get_instance_custom_index" => {
+                            Op::RayQueryGetIntersectionInstanceCustomIndexKHR
+                        }
+                        "__m2v.rq.get_sbt_offset" => {
+                            Op::RayQueryGetIntersectionInstanceShaderBindingTableRecordOffsetKHR
+                        }
+                        _ => unreachable!(),
+                    };
+                    let isect_val = const_u32_from_defs(&defs, args[1]).unwrap_or(1);
+                    let isect_const = ctx.const_uint(isect_val);
+                    let target_ty = rty.unwrap_or(uint_ty);
+                    if target_ty == uint_ty {
+                        new_insts.push(Instruction::new(
+                            op,
+                            Some(uint_ty),
+                            res,
+                            vec![Operand::IdRef(rq_var), Operand::IdRef(isect_const)],
+                        ));
+                    } else {
+                        let raw = ctx.module.fresh_id();
+                        new_insts.push(Instruction::new(
+                            op,
+                            Some(uint_ty),
+                            Some(raw),
+                            vec![Operand::IdRef(rq_var), Operand::IdRef(isect_const)],
+                        ));
+                        new_insts.push(Instruction::new(
+                            Op::Bitcast,
+                            Some(target_ty),
+                            res,
+                            vec![Operand::IdRef(raw)],
+                        ));
+                    }
+                }
+                "__m2v.rq.get_t" => {
+                    if args.len() < 2 {
+                        return Err(format!("{name} expects 2 operands"));
+                    }
+                    let isect_val = const_u32_from_defs(&defs, args[1]).unwrap_or(1);
+                    let isect_const = ctx.const_uint(isect_val);
+                    new_insts.push(Instruction::new(
+                        Op::RayQueryGetIntersectionTKHR,
+                        Some(rty.unwrap_or(f32_ty)),
+                        res,
+                        vec![Operand::IdRef(rq_var), Operand::IdRef(isect_const)],
+                    ));
+                }
+                "__m2v.rq.get_barycentrics" => {
+                    if args.len() < 2 {
+                        return Err(format!("{name} expects 2 operands"));
+                    }
+                    let isect_val = const_u32_from_defs(&defs, args[1]).unwrap_or(1);
+                    let isect_const = ctx.const_uint(isect_val);
+                    new_insts.push(Instruction::new(
+                        Op::RayQueryGetIntersectionBarycentricsKHR,
+                        Some(rty.unwrap_or(v2f_ty)),
+                        res,
+                        vec![Operand::IdRef(rq_var), Operand::IdRef(isect_const)],
+                    ));
+                }
+                "__m2v.rq.get_front_face" => {
+                    if args.len() < 2 {
+                        return Err(format!("{name} expects 2 operands"));
+                    }
+                    let isect_val = const_u32_from_defs(&defs, args[1]).unwrap_or(1);
+                    let isect_const = ctx.const_uint(isect_val);
+                    new_insts.push(Instruction::new(
+                        Op::RayQueryGetIntersectionFrontFaceKHR,
+                        Some(rty.unwrap_or(bool_ty)),
+                        res,
+                        vec![Operand::IdRef(rq_var), Operand::IdRef(isect_const)],
+                    ));
+                }
+                "__m2v.rq.get_object_ray_origin" => {
+                    if args.len() < 2 {
+                        return Err(format!("{name} expects 2 operands"));
+                    }
+                    let isect_val = const_u32_from_defs(&defs, args[1]).unwrap_or(0);
+                    let isect_const = ctx.const_uint(isect_val);
+                    new_insts.push(Instruction::new(
+                        Op::RayQueryGetIntersectionObjectRayOriginKHR,
+                        Some(rty.unwrap_or(v3f_ty)),
+                        res,
+                        vec![Operand::IdRef(rq_var), Operand::IdRef(isect_const)],
+                    ));
+                }
+                "__m2v.rq.get_object_ray_direction" => {
+                    if args.len() < 2 {
+                        return Err(format!("{name} expects 2 operands"));
+                    }
+                    let isect_val = const_u32_from_defs(&defs, args[1]).unwrap_or(0);
+                    let isect_const = ctx.const_uint(isect_val);
+                    new_insts.push(Instruction::new(
+                        Op::RayQueryGetIntersectionObjectRayDirectionKHR,
+                        Some(rty.unwrap_or(v3f_ty)),
+                        res,
+                        vec![Operand::IdRef(rq_var), Operand::IdRef(isect_const)],
+                    ));
+                }
+                "__m2v.rq.get_object_to_world_col" | "__m2v.rq.get_world_to_object_col" => {
+                    if args.len() < 3 {
+                        return Err(format!("{name} expects 3 operands"));
+                    }
+                    let isect_val = const_u32_from_defs(&defs, args[1]).unwrap_or(1);
+                    let isect_const = ctx.const_uint(isect_val);
+                    let col = const_u32_from_defs(&defs, args[2]).unwrap_or(0).min(3);
+                    let op = if name == "__m2v.rq.get_object_to_world_col" {
+                        Op::RayQueryGetIntersectionObjectToWorldKHR
+                    } else {
+                        Op::RayQueryGetIntersectionWorldToObjectKHR
+                    };
+                    let mat_id = ctx.module.fresh_id();
+                    new_insts.push(Instruction::new(
+                        op,
+                        Some(mat4x3_ty),
+                        Some(mat_id),
+                        vec![Operand::IdRef(rq_var), Operand::IdRef(isect_const)],
+                    ));
+                    new_insts.push(Instruction::new(
+                        Op::CompositeExtract,
+                        Some(rty.unwrap_or(v3f_ty)),
+                        res,
+                        vec![Operand::IdRef(mat_id), Operand::LiteralBit32(col)],
+                    ));
+                }
+                other => {
+                    return Err(format!("ray_query: unknown internal intrinsic {other}"));
+                }
+            }
+        }
+        ctx.module.functions[entry_idx].blocks[bi].instructions = new_insts;
+    }
+
+    Ok(())
+}
