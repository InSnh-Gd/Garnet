+//! MSL 2.1 section 2.12.1 forbids copying a thread/constexpr sampler to device memory.
+
+use super::*;
+use crate::native::tir::{RetEmit, TirOperand};
+
+type Origins = HashSet<usize>;
+const STATIC_SAMPLER: usize = usize::MAX;
+
+#[derive(Clone, Default, PartialEq, Eq)]
+struct Summary {
+    returned: Origins,
+    stored: Origins,
+}
+
+fn origins(value: &LlValue, values: &HashMap<String, Origins>) -> Origins {
+    match value {
+        LlValue::Local(name) => values.get(name).cloned().unwrap_or_default(),
+        LlValue::Global(name) if meta::is_static_sampler_global(name) => {
+            HashSet::from([STATIC_SAMPLER])
+        }
+        LlValue::Struct(values_) | LlValue::Array(values_) | LlValue::Vector(values_) => values_
+            .iter()
+            .flat_map(|value| origins(&value.value, values))
+            .collect(),
+        _ => Origins::new(),
+    }
+}
+
+fn substitute(
+    summary: &Origins,
+    args: &[TypedValue],
+    values: &HashMap<String, Origins>,
+) -> Origins {
+    summary
+        .iter()
+        .flat_map(|index| {
+            if *index == STATIC_SAMPLER {
+                HashSet::from([STATIC_SAMPLER])
+            } else {
+                args.get(*index)
+                    .map(|arg| origins(&arg.value, values))
+                    .unwrap_or_default()
+            }
+        })
+        .collect()
+}
+
+fn summarize(function: &LlFunction, summaries: &HashMap<String, Summary>) -> Summary {
+    let mut values = function
+        .params
+        .iter()
+        .enumerate()
+        .map(|(index, (name, _))| (name.clone(), HashSet::from([index])))
+        .collect::<HashMap<_, _>>();
+    let mut summary = Summary::default();
+    let mut local_stores = HashMap::<String, Origins>::new();
+    loop {
+        let mut changed = false;
+        for instruction in function.carrier_insts() {
+            if let Some(store) = instruction.store() {
+                let (object, pointer) = store.as_ref();
+                if matches!(pointer.ty, LlType::Ptr(1)) {
+                    summary.stored.extend(origins(&object.value, &values));
+                } else if matches!(pointer.ty, LlType::Ptr(0)) {
+                    if let LlValue::Local(name) = &pointer.value {
+                        let stored = local_stores.entry(name.clone()).or_default();
+                        let before = stored.len();
+                        stored.extend(origins(&object.value, &values));
+                        changed |= before != stored.len();
+                    }
+                }
+            }
+            let incoming = if let Some(call) = instruction.call() {
+                if let Some(callee) = summaries.get(&call.callee) {
+                    summary
+                        .stored
+                        .extend(substitute(&callee.stored, &call.args, &values));
+                    substitute(&callee.returned, &call.args, &values)
+                } else {
+                    Origins::new()
+                }
+            } else if let Some(load) = instruction.load() {
+                match &load.ptr.value {
+                    LlValue::Local(name) if matches!(load.ptr.ty, LlType::Ptr(0)) => {
+                        local_stores.get(name).cloned().unwrap_or_default()
+                    }
+                    _ => Origins::new(),
+                }
+            } else if let Some(gep) = instruction.gep() {
+                origins(&gep.base.value, &values)
+            } else if let Some(incoming) = instruction.phi_values() {
+                incoming.flat_map(|value| origins(value, &values)).collect()
+            } else if matches!(
+                instruction.opcode.as_str(),
+                "bitcast" | "addrspacecast" | "ptrtoint" | "inttoptr" | "freeze" | "select"
+            ) {
+                instruction
+                    .operands
+                    .iter()
+                    .skip(usize::from(instruction.opcode.as_str() == "select"))
+                    .filter_map(TirOperand::as_typed_value)
+                    .flat_map(|value| origins(&value.value, &values))
+                    .collect()
+            } else {
+                Origins::new()
+            };
+            if let Some(result) = &instruction.result {
+                let known = values.entry(result.clone()).or_default();
+                let before = known.len();
+                known.extend(incoming);
+                changed |= before != known.len();
+            }
+        }
+        if !changed {
+            break;
+        }
+    }
+    for block in &function.blocks {
+        if let Some(typed) = &block.typed {
+            if let RetEmit::Value(value) = &typed.ret {
+                summary.returned.extend(origins(&value.value, &values));
+            }
+        }
+    }
+    summary
+}
+
+impl LlModule {
+    pub(super) fn validate_sampler_stores(
+        &self,
+        ll: &str,
+        kern: Option<&meta::KernMeta>,
+    ) -> Result<(), String> {
+        if !ll.contains("\"air.sampler\"") && !ll.contains("__air_sampler_state") {
+            return Ok(());
+        }
+        let mut entries = Vec::new();
+        if let (Some(meta), Some(entry)) = (kern, meta::entry_name(ll, "kernel")) {
+            entries.push((
+                entry,
+                meta.roles
+                    .iter()
+                    .filter_map(|(index, role)| {
+                        matches!(role, meta::KernRole::Sampler(_)).then_some(*index as usize)
+                    })
+                    .collect::<Origins>(),
+            ));
+        }
+        if let (Some(meta), Some(entry)) = (
+            meta::parse_air_vertex_meta(ll),
+            meta::entry_name(ll, "vertex"),
+        ) {
+            entries.push((
+                entry,
+                meta.roles
+                    .iter()
+                    .filter_map(|(index, role)| {
+                        matches!(role, meta::VertRole::Sampler(_)).then_some(*index as usize)
+                    })
+                    .collect(),
+            ));
+        }
+        if let (Some(meta), Some(entry)) = (
+            meta::parse_air_fragment_meta(ll),
+            meta::entry_name(ll, "fragment"),
+        ) {
+            entries.push((
+                entry,
+                meta.roles
+                    .iter()
+                    .filter_map(|(index, role)| {
+                        matches!(role, meta::FragRole::Sampler(_)).then_some(*index as usize)
+                    })
+                    .collect(),
+            ));
+        }
+        // Symbolic parameter origins keep helper calls independent: a legal device-loaded argument
+        // does not inherit the thread origin of a different call to the same helper.
+        let mut summaries = HashMap::new();
+        loop {
+            let mut changed = false;
+            for function in &self.functions {
+                let summary = summarize(function, &summaries);
+                if summaries.get(&function.name) != Some(&summary) {
+                    summaries.insert(function.name.clone(), summary);
+                    changed = true;
+                }
+            }
+            if !changed {
+                break;
+            }
+        }
+        for (entry, mut forbidden) in entries {
+            forbidden.insert(STATIC_SAMPLER);
+            if summaries
+                .get(&entry)
+                .is_some_and(|summary| !summary.stored.is_disjoint(&forbidden))
+            {
+                return Err("MSL 2.1 section 2.12.1: thread/constexpr sampler cannot be copied to device memory; copy directly from another argument buffer".into());
+            }
+        }
+        Ok(())
+    }
+}
