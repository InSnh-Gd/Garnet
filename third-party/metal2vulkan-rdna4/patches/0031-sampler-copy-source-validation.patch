+            .replace("ptr addrspace(1) %observed)", "ptr addrspace(1) %observed, ptr addrspace(2) %thread_sampler)")
+            .replace("  %element =", "  %unused = call ptr addrspace(2) @identity(ptr addrspace(2) %thread_sampler)\n  %element =")
+            .replace("  store ptr addrspace(2) %sampler,", "  %forward = call ptr addrspace(2) @identity(ptr addrspace(2) %sampler)\n  store ptr addrspace(2) %forward,")
+            .replace("!2 = !{!3, !4, !5, !9}", "!2 = !{!3, !4, !5, !9, !11}")
+            + "\n!11 = !{i32 4, !\"air.sampler\", !\"air.location_index\", i32 12, i32 1, !\"air.arg_type_name\", !\"sampler\", !\"air.arg_name\", !\"thread_sampler\"}\ndefine internal ptr addrspace(2) @identity(ptr addrspace(2) %value) {\nentry:\n  ret ptr addrspace(2) %value\n}\n";
+        LlModule::parse(&source).expect("legal copy inherited the unrelated call's thread origin");
