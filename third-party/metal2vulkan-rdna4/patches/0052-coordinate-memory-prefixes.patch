+#[test]
+fn ordinary_store_and_all_preceding_reads_keep_their_order_and_execute_once() {
+    let text = source(
+        "%before = load i32, ptr addrspace(2) %buffer, align 4\n \
+         store i32 %before, ptr addrspace(1) %output, align 4",
+        "float",
+    )
+    .replace(
+        " br label %exit\nexit:",
+        " store i32 %before, ptr addrspace(1) %output, align 4\n br label %exit\nexit:",
+    );
+    let blocks = rewritten(&text);
+    assert_eq!(blocks.len(), 5);
+    let TirTerminator::BrCond { t, f, .. } = &blocks[0].typed.as_ref().unwrap().terminator else {
+        panic!()
+    };
+    let guard = named(&blocks, t);
+    assert_eq!(
+        guard
+            .insts
+            .iter()
+            .map(|i| i.opcode.clone())
+            .collect::<Vec<_>>(),
+        [
+            TirOpcode::Load,
+            TirOpcode::Store,
+            TirOpcode::GetElementPtr,
+            TirOpcode::Load
+        ]
+    );
+    let merge = named(&blocks, f);
+    assert_eq!(merge.insts.len(), 2);
+    assert!(merge
+        .insts
+        .iter()
+        .any(|i| i.result.as_deref() == Some("%before")));
+    let arm = named(&blocks, "%arm");
+    assert!(!arm.insts.iter().any(|i| i.load().is_some()));
+    assert_eq!(arm.insts.iter().filter(|i| i.store().is_some()).count(), 1);
+    assert_eq!(
+        blocks
+            .iter()
+            .flat_map(|b| &b.typed.as_ref().unwrap().insts)
+            .filter(|i| i.store().is_some())
+            .count(),
+        2
+    );
+    let parsed = LlModule::parse_with_stage_meta(&text, None, Some("main")).unwrap();
+    let mut repeated = blocks.clone();
+    reconverge(&parsed, &parsed.functions[0], &mut repeated);
+    assert_eq!(
+        repeated.iter().map(BodyBlock::lines).collect::<Vec<_>>(),
+        blocks.iter().map(BodyBlock::lines).collect::<Vec<_>>()
+    );
+}
+
+#[test]
+fn store_prefix_cannot_reorder_opaque_or_ordered_preceding_reads() {
+    for prefix in [
+        "%opaque = load ptr addrspace(1), ptr addrspace(2) %buffer, align 8\n store i32 7, ptr addrspace(1) %output",
+        "%old = load volatile i32, ptr addrspace(2) %buffer, align 4\n store i32 7, ptr addrspace(1) %output",
+        "store ptr addrspace(2) %sampler, ptr addrspace(1) %output",
+    ] {
+        assert_eq!(rewritten(&source(prefix, "float")).len(), 3, "{prefix}");
+    }
+}
+
+#[test]
+fn numeric_air_conversion_keeps_the_original_store_guard_and_order() {
+    let text = source(
+        "%converted = call i32 @air.convert.u.i32.f.f32(float 0.25)\n \
+         store i32 %converted, ptr addrspace(1) %output, align 4",
+        "float",
+    );
+    let blocks = rewritten(&text);
+    assert_eq!(blocks.len(), 5);
+    let TirTerminator::BrCond { t, .. } = &blocks[0].typed.as_ref().unwrap().terminator else {
+        panic!()
+    };
+    assert_eq!(
+        named(&blocks, t)
+            .insts
+            .iter()
+            .map(|i| i.opcode.clone())
+            .collect::<Vec<_>>(),
+        [
+            TirOpcode::Call,
+            TirOpcode::Store,
+            TirOpcode::GetElementPtr,
+            TirOpcode::Load
+        ]
+    );
+    assert!(!named(&blocks, "%arm")
+        .insts
+        .iter()
+        .any(|i| i.store().is_some()));
 }
 
