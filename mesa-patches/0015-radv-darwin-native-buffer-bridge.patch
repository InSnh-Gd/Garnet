+static int
+buffer_kext(VkDevice _dev, struct acd_kext **k)
+{
+   VK_FROM_HANDLE(radv_device, device, _dev);
+   if (!device)
+      return -EINVAL;
+   if (vk_device_is_lost_no_report(&device->vk))
+      return -ECANCELED;
+   *k = ac_drm_darwin_kext(radv_amdgpu_winsys(device->ws)->dev, NULL);
+   return *k ? 0 : -ENOSYS;
+}
+
+static int
+buffer_handle(VkDevice _dev, VkDeviceMemory _mem, uint64_t offset, uint64_t size, uint32_t *handle)
+{
+   VK_FROM_HANDLE(radv_device, device, _dev);
+   VK_FROM_HANDLE(radv_device_memory, mem, _mem);
+   if (!device || !mem || mem->base.device != &device->vk || !mem->bo || mem->bo->is_virtual ||
+       mem->user_ptr || mem->import_handle_type || !size || size > RDNA4N_BUFFER_MAX_BYTES ||
+       ((offset | size) & 3) || offset > mem->alloc_size || size > mem->alloc_size - offset ||
+       offset > mem->bo->size || size > mem->bo->size - offset)
+      return -EINVAL;
+   *handle = radv_amdgpu_winsys_bo(mem->bo)->bo_handle;
+   return *handle ? 0 : -EINVAL;
+}
+
+API int
+radv_darwin_buffer_copy(VkDevice dev, VkDeviceMemory src, uint64_t src_offset,
+                        VkDeviceMemory dst, uint64_t dst_offset, uint64_t size, uint64_t *seq)
+{
+   if (!seq)
+      return -EINVAL;
+   *seq = 0;
+   struct acd_kext *k = NULL;
+   int r = buffer_kext(dev, &k);
+   if (r)
+      return r;
+   struct rdna4n_buffer_op op = {.src_offset = src_offset, .dst_offset = dst_offset, .length = size};
+   r = buffer_handle(dev, src, src_offset, size, &op.src_handle);
+   if (!r)
+      r = buffer_handle(dev, dst, dst_offset, size, &op.dst_handle);
+   return r ? r : acd_kext_buffer_op(k, &op, false, seq);
+}
+
+API int
+radv_darwin_buffer_fill(VkDevice dev, VkDeviceMemory dst, uint64_t dst_offset,
+                        uint64_t size, uint32_t pattern, uint64_t *seq)
+{
+   if (!seq)
+      return -EINVAL;
+   *seq = 0;
+   struct acd_kext *k = NULL;
+   int r = buffer_kext(dev, &k);
+   if (r)
+      return r;
+   struct rdna4n_buffer_op op = {.dst_offset = dst_offset, .length = size, .pattern = pattern};
+   r = buffer_handle(dev, dst, dst_offset, size, &op.dst_handle);
+   return r ? r : acd_kext_buffer_op(k, &op, true, seq);
+}
