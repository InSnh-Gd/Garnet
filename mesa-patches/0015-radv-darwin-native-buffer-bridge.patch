+{
+   if (!busy)
+      return -EINVAL;
+   *busy = true;
+   struct acd_kext *k = NULL;
+   int r = buffer_kext(dev, &k);
+   return r ? r : acd_kext_buffer_wait(k, seq, timeout_ns, busy);
+}
