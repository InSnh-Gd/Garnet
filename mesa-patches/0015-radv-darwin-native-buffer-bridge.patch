 int
+acd_kext_buffer_op(struct acd_kext *k, const struct rdna4n_buffer_op *op, bool fill, uint64_t *seq)
+{
+   if (!seq)
+      return -EINVAL;
+   *seq = 0;
+   if (!k || !op || !op->dst_handle || op->flags || op->reserved || !op->length ||
+       op->length > RDNA4N_BUFFER_MAX_BYTES || ((op->src_offset | op->dst_offset | op->length) & 3) ||
+       op->dst_offset > UINT64_MAX - op->length || op->src_offset > UINT64_MAX - op->length)
+      return -EINVAL;
+   if (fill ? (op->src_handle || op->src_offset) : (!op->src_handle || op->pattern))
+      return -EINVAL;
+   if (!fill && op->src_handle == op->dst_handle &&
+       op->src_offset < op->dst_offset + op->length && op->dst_offset < op->src_offset + op->length)
+      return -EINVAL;
+   if (atomic_load(&k->submit_lost))
+      return -ECANCELED;
+   int support = atomic_load(&k->buffer_support);
+   if (!support) {
+      struct rdna4n_info info;
+      int r = acd_kext_query_info(k, &info);
+      if (r)
+         return r;
+      support = info.flags & RDNA4N_INFO_BUFFER_OPS ? 1 : -1;
+      atomic_store(&k->buffer_support, support);
+   }
+   if (support < 0)
+      return -ENOSYS;
+   uint64_t out = 0;
+   uint32_t nout = 1;
+   acd_sfence();
+   int r = kcall(k, fill ? RDNA4N_SEL_BUFFER_FILL : RDNA4N_SEL_BUFFER_COPY,
+                 NULL, 0, op, sizeof(*op), &out, &nout, NULL, NULL);
+   if (r)
+      return r;
+   if (nout != 1 || !out) {
+      acd_kext_abort_submissions(k);
+      return -ECANCELED;
+   }
+   *seq = out;
+   return 0;
+}
