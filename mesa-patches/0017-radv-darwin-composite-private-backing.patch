+#ifdef HAVE_AMDGPU_DARWIN
+#define RADV_DARWIN_COMPOSITE_CHUNK (UINT64_C(256) << 20)
+#define RADV_DARWIN_COMPOSITE_CHILDREN 2048u
+
+static VkResult
+radv_amdgpu_composite_bo_create(struct radeon_winsys *_ws, uint64_t size, unsigned alignment,
+                                enum radeon_bo_domain domain, enum radeon_bo_flag flags,
+                                unsigned priority, uint64_t chunk_limit, struct radeon_winsys_bo **out_bo)
+{
+   struct radv_amdgpu_winsys *ws = radv_amdgpu_winsys(_ws);
+   *out_bo = NULL;
+   if (!size || size % 4096 || !chunk_limit || chunk_limit > RADV_DARWIN_COMPOSITE_CHUNK ||
+       chunk_limit % 4096 || (alignment && (alignment & (alignment - 1))) ||
+       alignment > chunk_limit || !(domain & RADEON_DOMAIN_VRAM) ||
+       !(flags & RADEON_FLAG_NO_CPU_ACCESS) || !(flags & RADEON_FLAG_NO_INTERPROCESS_SHARING) ||
+       (flags & (RADEON_FLAG_CPU_ACCESS | RADEON_FLAG_32BIT | RADEON_FLAG_REPLAYABLE |
+                 RADEON_FLAG_VIRTUAL | RADEON_FLAG_EMULATE_SPARSE_RESIDENCY)))
+      return VK_ERROR_OUT_OF_DEVICE_MEMORY;
+
+   struct radv_amdgpu_winsys_bo *bo = CALLOC_STRUCT(radv_amdgpu_winsys_bo);
+   if (!bo)
+      return VK_ERROR_OUT_OF_HOST_MEMORY;
+   bo->children = calloc(RADV_DARWIN_COMPOSITE_CHILDREN, sizeof(*bo->children));
+   if (!bo->children) {
+      FREE(bo);
+      return VK_ERROR_OUT_OF_HOST_MEMORY;
+   }
+   bo->base.size = size;
+   bo->base.is_local = true;
+   bo->base.initial_domain = domain;
+   bo->base.vram_no_cpu_access = true;
+   bo->base.gfx12_allow_dcc = !!(flags & RADEON_FLAG_GFX12_ALLOW_DCC);
+   bo->base.obj_id = (uintptr_t)bo;
+   bo->flags = flags;
+   bo->priority = priority;
+   const uint64_t va_size = radv_amdgpu_bo_va_size(size, flags);
+   if (va_size < size || va_size > UINT64_MAX - (ws->debug_vm ? 65536 : 0)) {
+      FREE(bo->children);
+      FREE(bo);
+      return VK_ERROR_OUT_OF_DEVICE_MEMORY;
+   }
+   unsigned va_alignment = MAX2(4096, MAX2(alignment, ws->info.pte_fragment_size));
+   uint64_t va = 0;
+   uint64_t va_gap = ws->debug_vm ? MAX2(UINT64_C(4) * va_alignment, 65536) : 0;
+   if (va_size > UINT64_MAX - va_gap) {
+      FREE(bo->children);
+      FREE(bo);
+      return VK_ERROR_OUT_OF_DEVICE_MEMORY;
+   }
+   int r = ac_drm_va_range_alloc(ws->dev, amdgpu_gpu_va_range_general,
+                                 va_size + va_gap, va_alignment, 0,
+                                 &va, &bo->va_handle, AMDGPU_VA_RANGE_HIGH);
+   if (r) {
+      FREE(bo->children);
+      FREE(bo);
+      return VK_ERROR_OUT_OF_DEVICE_MEMORY;
+   }
+   bo->base.va = va;
+   uint64_t offset = 0;
+   const uint64_t minimum = MAX2(alignment, 4096);
+   VkResult result = VK_SUCCESS;
+   while (offset < size) {
+      if (bo->child_count == RADV_DARWIN_COMPOSITE_CHILDREN) {
+         result = VK_ERROR_OUT_OF_DEVICE_MEMORY;
+         goto fail;
+      }
+      uint64_t chunk = MIN2(chunk_limit, size - offset);
+      struct radeon_winsys_bo *child = NULL;
+      for (;;) {
+         bool allocation_failed = false;
+         result = radv_amdgpu_winsys_bo_create_internal(_ws, chunk, alignment, domain,
+                   (flags & ~RADEON_FLAG_VM_PAD_1PAGE) | RADEON_FLAG_PREFER_LOCAL_BO,
+                   priority, 0, va + offset, &allocation_failed, &child);
+         if (result == VK_SUCCESS)
+            break;
+         if (!allocation_failed || result != VK_ERROR_OUT_OF_DEVICE_MEMORY || chunk <= minimum)
+            goto fail;
+         chunk = MAX2(minimum, (chunk / 2) & ~(minimum - 1));
+      }
+      bo->children[bo->child_count++] = radv_amdgpu_winsys_bo(child);
+      offset += chunk;
+      chunk_limit = chunk;
+   }
+   if (flags & RADEON_FLAG_VM_PAD_1PAGE) {
+      r = radv_amdgpu_bo_va_op(ws, bo->children[0]->bo_handle, 0, 4096, va + size,
+                               flags | RADEON_FLAG_READ_ONLY, 0, AMDGPU_VA_OP_MAP);
+      if (r) {
+         result = VK_ERROR_OUT_OF_DEVICE_MEMORY;
+         goto fail;
+      }
+      bo->composite_pad = true;
+   }
+   radv_amdgpu_log_bo(ws, bo, false);
+   *out_bo = &bo->base;
+   return VK_SUCCESS;
+fail:
+   radv_amdgpu_winsys_bo_destroy(_ws, &bo->base);
+   return result;
+}
