+static VkResult
+radv_amdgpu_winsys_bo_create(struct radeon_winsys *_ws, uint64_t size, unsigned alignment,
+                             enum radeon_bo_domain initial_domain, enum radeon_bo_flag flags, unsigned priority,
+                             uint64_t replay_address, struct radeon_winsys_bo **out_bo)
+{
+#ifdef HAVE_AMDGPU_DARWIN
+   struct radv_amdgpu_winsys *ws = radv_amdgpu_winsys(_ws);
+   if (size > UINT64_C(0xfffffffc) && ac_drm_darwin_kext(ws->dev, NULL)) {
+      if (replay_address) {
+         *out_bo = NULL;
+         return VK_ERROR_INVALID_OPAQUE_CAPTURE_ADDRESS;
+      }
+      return radv_amdgpu_composite_bo_create(_ws, size, alignment, initial_domain, flags,
+                                             priority, RADV_DARWIN_COMPOSITE_CHUNK, out_bo);
+   }
+#endif
+   return radv_amdgpu_winsys_bo_create_internal(_ws, size, alignment, initial_domain, flags,
+                                                priority, replay_address, 0, NULL, out_bo);
+}
