 };
+
+static uint64_t
+radv_get_max_allocation_size(struct radv_physical_device *pdev)
+{
+   uint64_t size = RADV_MAX_MEMORY_ALLOCATION_SIZE;
+#ifdef HAVE_AMDGPU_DARWIN
+   if (pdev->drm_device_type == RADV_DRM_DEVICE_AMDGPU_DARWIN) {
+      simple_mtx_lock(&pdev->drm_device_mtx);
+      radv_create_drm_device_locked(pdev);
+      if (pdev->drm_device && ac_drm_darwin_kext(pdev->drm_device, NULL))
+         size = MAX2(size, MIN2(UINT64_C(8) << 30, (uint64_t)pdev->info.vram_size_kb * 1024));
+      simple_mtx_unlock(&pdev->drm_device_mtx);
+   }
+#endif
+   return size;
+}
 
