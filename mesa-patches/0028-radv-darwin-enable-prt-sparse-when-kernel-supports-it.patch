+   bad = rep_bo; bad.flags = (6u << 5); /* unknown MTYPE */
+   CHECK(acd_kext_gem_va(k, &bad) == -EINVAL);
+   CHECK(f.ncalls == 0);
+   acd_kext_destroy(k);
+}
