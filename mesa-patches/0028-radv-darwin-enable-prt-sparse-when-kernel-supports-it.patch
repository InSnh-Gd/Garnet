+/* ABI 1.13: CLEAR/REPLACE/PRT translation and RDNA4N_CAP_VM_PRT capability gating. */
+static void
+test_sparse_prt_va(void)
+{
+   CHECK(RDNA4N_ABI_MINOR >= ACD_ABI_MINOR_VM_PRT);
+   CHECK(RDNA4N_CAP_VM_PRT == (1u << 4));
+
+   /* Old kernel (flags without RDNA4N_CAP_VM_PRT): rejects CLEAR/REPLACE/PRT with -EOPNOTSUPP. */
+   struct fake f;
+   struct acd_kext *k = mk(&f);
+   f.info_flags = RDNA4N_INFO_S1B_POSITIVE | RDNA4N_INFO_NATIVE_BOOT;
+   CHECK(!acd_kext_has_vm_prt(k));
+   f.ncalls = 0;
+   struct drm_amdgpu_gem_va prt_map = {.handle = 0, .operation = AMDGPU_VA_OP_MAP,
+                                       .flags = AMDGPU_VM_PAGE_PRT,
+                                       .va_address = 0xffff800100000000ull, .offset_in_bo = 0, .map_size = 0x10000};
+   struct drm_amdgpu_gem_va rep_bo = {.handle = 7, .operation = AMDGPU_VA_OP_REPLACE,
+                                      .flags = AMDGPU_VM_PAGE_READABLE | AMDGPU_VM_PAGE_WRITEABLE,
+                                      .va_address = 0xffff800100000000ull, .offset_in_bo = 0x10000, .map_size = 0x10000};
+   struct drm_amdgpu_gem_va clr = {.handle = 0, .operation = AMDGPU_VA_OP_CLEAR, .flags = 0,
+                                   .va_address = 0xffff800100000000ull, .offset_in_bo = 0, .map_size = 0x10000};
+   CHECK(acd_kext_gem_va(k, &prt_map) == -EOPNOTSUPP);
+   CHECK(acd_kext_gem_va(k, &rep_bo) == -EOPNOTSUPP);
+   CHECK(acd_kext_gem_va(k, &clr) == -EOPNOTSUPP);
+   CHECK(f.ncalls == 0); /* refused before reaching kernel */
+   acd_kext_destroy(k);
+
+   /* ABI 1.13 kernel (RDNA4N_CAP_VM_PRT advertised): accepts and translates PRT/REPLACE/CLEAR. */
+   k = mk(&f);
+   f.info_flags = RDNA4N_INFO_S1B_POSITIVE | RDNA4N_INFO_NATIVE_BOOT | RDNA4N_CAP_VM_PRT;
+   CHECK(acd_kext_has_vm_prt(k));
+   f.ncalls = 0;
+   CHECK(acd_kext_gem_va(k, &prt_map) == 0);
+   CHECK(acd_kext_gem_va(k, &rep_bo) == 0);
+   CHECK(acd_kext_gem_va(k, &clr) == 0);
+   CHECK(f.ncalls == 3);
+   const struct rdna4n_gem_va *w0 = (const struct rdna4n_gem_va *)f.calls[0].stin;
+   const struct rdna4n_gem_va *w1 = (const struct rdna4n_gem_va *)f.calls[1].stin;
+   const struct rdna4n_gem_va *w2 = (const struct rdna4n_gem_va *)f.calls[2].stin;
+   CHECK(w0->operation == RDNA4N_VA_OP_MAP && w0->handle == 0 && w0->flags == RDNA4N_VM_PAGE_PRT);
+   CHECK(w1->operation == RDNA4N_VA_OP_REPLACE && w1->handle == 7 && w1->offset_in_bo == 0x10000);
+   CHECK(w2->operation == RDNA4N_VA_OP_CLEAR && w2->handle == 0 && w2->offset_in_bo == 0);
+
+   /* Invalid combinations rejected with -EINVAL before calling kernel. */
+   f.ncalls = 0;
+   struct drm_amdgpu_gem_va bad = prt_map;
