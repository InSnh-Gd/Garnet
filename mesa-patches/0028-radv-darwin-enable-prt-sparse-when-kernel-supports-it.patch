+int
+acd_kext_translate_gem_va(const struct drm_amdgpu_gem_va *va, bool has_vm_prt,
+                          struct rdna4n_gem_va *out)
+{
+   if (!va || !out)
+      return -EINVAL;
+
+   uint32_t op;
+   switch (va->operation) {
+   case AMDGPU_VA_OP_MAP:
+      op = RDNA4N_VA_OP_MAP;
+      break;
+   case AMDGPU_VA_OP_UNMAP:
+      op = RDNA4N_VA_OP_UNMAP;
+      break;
+   case AMDGPU_VA_OP_CLEAR:
+      op = RDNA4N_VA_OP_CLEAR;
+      break;
+   case AMDGPU_VA_OP_REPLACE:
+      op = RDNA4N_VA_OP_REPLACE;
+      break;
