+static uint32_t
+radv_fill_memory_internal(struct radv_cmd_buffer *cmd_buffer, const struct radv_image *image, uint64_t dst_va,
+                          uint64_t size, uint32_t value, VkAddressCopyFlagsKHR dst_copy_flags)
+{
+   assert(!(dst_va & 3));
+   assert(!(size & 3));
+
+   struct radv_device *device = radv_cmd_buffer_device(cmd_buffer);
+   uint32_t flush_bits = 0;
+
+#ifdef HAVE_AMDGPU_DARWIN
+   if (vk_command_buffer_has_error(&cmd_buffer->vk) || !size)
+      return 0;
+#endif
+
+   if (cmd_buffer->qf == RADV_QUEUE_TRANSFER) {
+      radv_sdma_fill_memory(device, cmd_buffer->cs, dst_va, size, value);
+      return 0;
+   }
+
+#ifdef HAVE_AMDGPU_DARWIN
+   while (size) {
+      if (vk_command_buffer_has_error(&cmd_buffer->vk))
+         break;
+
+      const uint64_t chunk_size = MIN2(size, RADV_DARWIN_TRANSFER_CHUNK_SIZE);
+      flush_bits |= radv_fill_memory_chunk(cmd_buffer, image, dst_va, chunk_size, value, dst_copy_flags);
+      dst_va += chunk_size;
+      size -= chunk_size;
+   }
+#else
+   flush_bits = radv_fill_memory_chunk(cmd_buffer, image, dst_va, size, value, dst_copy_flags);
+#endif
+
+   return flush_bits;
+}
