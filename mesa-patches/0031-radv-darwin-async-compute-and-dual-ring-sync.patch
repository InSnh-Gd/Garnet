+int
+acd_kext_submit_ex(struct acd_kext *k, const struct acd_cs_plan *plan, uint64_t *last_seqno,
+                   uint64_t *aux_seqno)
+{
+   *last_seqno = 0;
+   if (aux_seqno)
+      *aux_seqno = 0;
+   if (atomic_load(&k->submit_lost))
+      return -ECANCELED;
+
+   if (plan->n_ibs == 0)
+      return -EINVAL;
+
+   uint32_t n_comp = 0, n_gfx = 0;
+   for (uint32_t i = 0; i < plan->n_ibs; i++) {
+      if (plan->ibs[i].ip_type == AMDGPU_HW_IP_COMPUTE)
+         n_comp++;
+      else
+         n_gfx++;
+   }
+   bool any_accepted = false;
+   if (n_comp == 0 || n_gfx == 0) {
+      return submit_ib_slice(k, plan->ctx_id, plan->ibs, plan->n_ibs,
+                             plan->has_fence, plan->fence_handle, plan->fence_offset,
+                             last_seqno, &any_accepted);
+   }
+
+   /* Gang submission (e.g. RADV Task+Mesh): launch ACE follower IBs on KCQ, then immediately launch
+    * GFX leader IBs on the GFX ring so both engines execute concurrently; report both seqnos so
+    * callers track compute retirement alongside the GFX leader. */
+   struct rdna4n_cs_ib *comp_ibs = malloc((size_t)n_comp * sizeof(*comp_ibs));
+   struct rdna4n_cs_ib *gfx_ibs = malloc((size_t)n_gfx * sizeof(*gfx_ibs));
+   if (!comp_ibs || !gfx_ibs) {
+      free(comp_ibs);
+      free(gfx_ibs);
+      return -ENOMEM;
+   }
+   uint32_t ci = 0, gi = 0;
+   for (uint32_t i = 0; i < plan->n_ibs; i++) {
+      if (plan->ibs[i].ip_type == AMDGPU_HW_IP_COMPUTE)
+         comp_ibs[ci++] = plan->ibs[i];
+      else
+         gfx_ibs[gi++] = plan->ibs[i];
+   }
+   uint64_t comp_seq = 0;
+   int r = submit_ib_slice(k, plan->ctx_id, comp_ibs, n_comp, false, 0, 0, &comp_seq, &any_accepted);
+   if (aux_seqno)
+      *aux_seqno = comp_seq;
+   if (!r)
+      r = submit_ib_slice(k, plan->ctx_id, gfx_ibs, n_gfx,
+                          plan->has_fence, plan->fence_handle, plan->fence_offset,
+                          last_seqno, &any_accepted);
+   free(comp_ibs);
+   free(gfx_ibs);
+   return r;
+}
+
+int
+acd_kext_submit(struct acd_kext *k, const struct acd_cs_plan *plan, uint64_t *last_seqno)
+{
+   return acd_kext_submit_ex(k, plan, last_seqno, NULL);
+}
