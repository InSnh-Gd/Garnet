# Makefile — cross-compile Garnet.kext for x86_64 from any host.
# Targets macOS 11+ ABI (including macOS 15 / 26).
#   make          build build/Garnet.kext
#   make clean

.DEFAULT_GOAL := all
PRODUCT   := Garnet
BUNDLE_ID := org.garnet.driver
ARCH      := x86_64
DEPLOY    := 11.0
HOST_OS   := $(shell uname -s)
ifeq ($(HOST_OS),Darwin)
SDK       := $(shell xcrun --sdk macosx --show-sdk-path)
NM        := nm -arch $(ARCH)
DML21_NM_DEFINED = $(NM) -gUj
CXXFILT   := c++filt
SIGN      ?= 1
else
# Kernel-only builds need MacKernelSDK, not the macOS userspace SDK.
SDK       = $(MKSDK)
NM        := llvm-nm
DML21_NM_DEFINED = $(NM) -g --defined-only -j
CXXFILT   := $(shell command -v llvm-cxxfilt || command -v c++filt || echo llvm-cxxfilt) -_
SIGN      ?= 0
endif
MKSDK     ?= ../../build-toolchain/sdk
KEXT_LD   ?=

BUILD := build
KEXT  := $(BUILD)/$(PRODUCT).kext
EXEC  := $(KEXT)/Contents/MacOS/$(PRODUCT)

ifeq ($(origin CXX),default)
CXX := clang++
endif
ifeq ($(origin CC),default)
CC  := clang
endif
CXX ?= clang++
CC  ?= clang

CXX_SRCS := src/GarnetDriver.cpp src/GarnetDriverStages.cpp src/GarnetDisplayGate.cpp \
            src/GarnetPrimaryFramebuffer.cpp src/GarnetUserClient.cpp \
            src/GarnetNativeClient.cpp src/GarnetMetalNub.cpp \
            src/GarnetDisplayNub.cpp src/ipdiscovery.cpp src/psp.cpp \
            $(wildcard src/amd/*.cpp) $(filter-out src/dcn/dcn41_dml21_bridge.cpp,$(wildcard src/dcn/*.cpp))
# Generated firmware belongs to this build, so concurrent chip builds cannot reuse stale stubs.
FW_GEN   := $(BUILD)/firmware
FW_BINS  := $(wildcard firmware/*.bin)
FW_SRCS  := $(patsubst firmware/%.bin,$(FW_GEN)/fw_%.c,$(FW_BINS))
# REQUIRED blobs: AMD firmware from linux-firmware, NOT in this repository (see BUILDING.md and
# tools/fetch-firmware.sh). The kext cannot link without them, so fail early with a clear message.
# Multi-chip builds carry the table in src/amd/amdgpu_asic.h. CHIPS selects which ones
# are REQUIRED; every blob of a chip that is not in CHIPS (and not present in firmware/) is embedded
# as a ZERO-LENGTH stub (rule below), so the symbols always link and the kext refuses that chip at
# probe (fw_chip_complete). Examples:  make CHIPS=navi48   make CHIPS=navi44   make (both)
CHIPS       ?= navi48 navi44
FW_navi48   := gc_12_0_1_imu gc_12_0_1_me gc_12_0_1_mec gc_12_0_1_pfp gc_12_0_1_rlc gc_12_0_1_uni_mes \
               psp_14_0_3_sos psp_14_0_3_ta sdma_7_0_1 smu_14_0_3
FW_navi44   := gc_12_0_0_imu gc_12_0_0_me gc_12_0_0_mec gc_12_0_0_pfp gc_12_0_0_rlc gc_12_0_0_uni_mes \
               psp_14_0_2_sos psp_14_0_2_ta sdma_7_0_0 smu_14_0_2
FW_SHARED   := dcn_4_0_1_dmcub
FW_ALLCHIPS := $(FW_navi48) $(FW_navi44) $(FW_SHARED)
FW_REQUIRED := $(foreach c,$(CHIPS),$(FW_$(c))) $(FW_SHARED)
ifneq ($(filter-out navi48 navi44,$(CHIPS)),)
$(error CHIPS may only contain navi48 and navi44, got: $(CHIPS))
endif
FW_MISSING  := $(filter-out $(patsubst firmware/%.bin,%,$(FW_BINS)),$(FW_REQUIRED))
# Our own compute test shaders, assembled from shaders/*.s (tools/build-shader.sh) and tracked as
# shaders/*.bin so no LLVM is needed to build the kext.
SHADER_FW      := shader_store_magic shader_store_magic_hsa
SHADER_FW_SRCS := $(patsubst %,$(FW_GEN)/fw_%.c,$(SHADER_FW))
FW_SRCS        := $(sort $(FW_SRCS) $(SHADER_FW_SRCS))
$(SHADER_FW_SRCS): $(FW_GEN)/fw_shader_%.c: shaders/%.bin tools/embed-firmware.py
	@mkdir -p $(dir $@)
	python3 tools/embed-firmware.py $< $@ fw_shader_$*
FW_STUBS    := $(filter-out $(patsubst firmware/%.bin,%,$(FW_BINS)), \
               $(filter-out $(FW_REQUIRED),$(FW_ALLCHIPS)))
FW_STUB_SRCS := $(patsubst %,$(FW_GEN)/fw_%.c,$(FW_STUBS))
FW_SRCS     := $(sort $(FW_SRCS) $(FW_STUB_SRCS))
$(FW_STUB_SRCS): $(FW_GEN)/fw_%.c: Makefile
	@mkdir -p $(dir $@)
	@printf '%s\n' '// GENERATED by the Makefile: firmware/$*.bin is absent, so this is an EMPTY blob (size 0).' \
	  '#include <stddef.h>' \
	  '#include <stdint.h>' \
	  'const size_t fw_$*_size = 0;' \
	  'const uint8_t fw_$*[64] __attribute__((aligned(64))) = { 0 };' > $@
	@echo "note: firmware/$*.bin absent - embedded an empty blob (optional, fail-closed)"
# dcn41 (the DCN 4.1 display register layer and its write allowlist) has its source of truth
# in ../dcn41, tested on the host by `python3 tools/dcn41/build.py all` (unit + planted-defect
# control + C++17 + kextcheck), compiled in here rather than duplicated. Plain C11, no libc
# beyond stdint/stdbool/stddef.
DCN41_DIR := ../dcn41
DCN41_SRCS := $(wildcard $(DCN41_DIR)/*.c)
DCN41_OBJS := $(patsubst $(DCN41_DIR)/%.c,$(BUILD)/dcn41/%.o,$(DCN41_SRCS))
DML21_DIR := src/dcn/dml21
include $(DML21_DIR)/sources.mk
DML21_C_OBJS := $(patsubst %.c,$(BUILD)/%.o,$(DML21_C_SRCS))
DML21_ADAPTER := src/dcn/dml21_adapter/dcn41_dml21_adapter.cpp
DML21_ADAPTER_OBJ := $(patsubst %.cpp,$(BUILD)/%.o,$(DML21_ADAPTER))
DML21_OBJS := $(DML21_C_OBJS) $(DML21_ADAPTER_OBJ)
C_SRCS   := src/kmod_info.c
$(FW_GEN)/fw_%.c: firmware/%.bin tools/embed-firmware.py
	@mkdir -p $(dir $@)
	python3 tools/embed-firmware.py $< $@ fw_$*

OBJS := $(patsubst %.cpp,$(BUILD)/%.o,$(CXX_SRCS)) $(patsubst %.c,$(BUILD)/%.o,$(C_SRCS)) \
        $(FW_SRCS:.c=.o) $(DCN41_OBJS)

COMMON := -arch $(ARCH) -target $(ARCH)-apple-macos$(DEPLOY) -isysroot $(SDK) \
  -I$(MKSDK)/Headers -Isrc -Isrc/amd -I$(DCN41_DIR) -mmacosx-version-min=$(DEPLOY) \
  -DKERNEL -DKERNEL_PRIVATE -DDRIVER_PRIVATE -DAPPLE -DNeXT \
  -D_FORTIFY_SOURCE=0 -nostdinc -fno-builtin -fno-common -fno-stack-protector \
  -mkernel -mno-sse -mno-mmx -mno-80387 -fapple-kext -Wall -Os -g
CXXFLAGS := $(COMMON) -std=c++17 -fno-exceptions -fno-rtti -fcheck-new -fno-c++-static-destructors \
  -include src/GarnetBootArgs.h   # rdna4-* boot-arg fallback (logs when a legacy token is used)
CFLAGS   := $(filter-out -fapple-kext,$(COMMON))
DML21_FP_FLAGS := $(DML21_CPPFLAGS) -DGARNET_DML21_COMPILE_ONLY -msse -msse2 -mno-avx -ffp-contract=off \
  -Wframe-larger-than=3072 -Werror=frame-larger-than
LDFLAGS  := -arch $(ARCH) -target $(ARCH)-apple-macos$(DEPLOY) -isysroot $(SDK) \
  -nostdlib -Xlinker -kext -L$(MKSDK)/Library/x86_64 \
  $(if $(wildcard $(MKSDK)/Library/x86_64/libkmodc++.a),-lkmodc++) -lkmod -Wl,-no_deduplicate \
  $(if $(KEXT_LD),--ld-path=$(KEXT_LD))

all: $(KEXT)

OBJDUMP ?= llvm-objdump
.PHONY: check-kernel-fp
check-kernel-fp: $(OBJS)
	@count=$$(python3 ../../tools/dcn41/fpu_count.py "$(OBJDUMP)" $(OBJS)) && \
	  printf 'FP/SIMD instructions in %s kernel objects: %s\n' '$(words $(OBJS))' "$$count" && test "$$count" = 0

.PHONY: check-dml21-kernel
check-dml21-kernel: $(DML21_OBJS)
	@set -e; disasm=$$($(OBJDUMP) -d --no-show-raw-insn $(DML21_OBJS)); \
	  if printf '%s\n' "$$disasm" | grep -E '^[[:space:]]*[0-9a-f]+:[[:space:]]+v[[:alnum:]]+[[:space:]]|^[[:space:]]*[0-9a-f]+:[[:space:]]+v[[:alnum:]]+$$'; then \
	    echo 'DML2.1 objects contain AVX instructions'; exit 1; fi; \
	  defined=$$($(DML21_NM_DEFINED) $(DML21_OBJS)); \
	  undefined=$$($(NM) -u -j $(DML21_OBJS)); \
	  unresolved=$$(printf '%s\n' "$$defined" '===UNDEFINED===' "$$undefined" | awk '\
	    /^===UNDEFINED===$$/ { refs=1; next } \
	    /^_/ && !refs { defs[$$0]=1 } \
	    /^_/ && refs && !defs[$$0] && $$0 !~ /^(___bzero|_memcmp|_memcpy|_memset)$$/ { print }'); \
	  if [ -n "$$unresolved" ]; then printf 'DML2.1 unresolved symbols:\n%s\n' "$$unresolved"; exit 1; fi; \
	  printf 'DML2.1: %s compile-only kernel objects, without AVX or unexpected dependencies\n' '$(words $(DML21_OBJS))'

$(OBJS): Makefile | check-firmware check-version
$(DML21_OBJS): Makefile
check-version:
	@ver=$$(tr -d ' \t\r\n' < VERSION); \
	 grep -q "GARNET_KEXT_VERSION_STR \"$$ver\"" src/garnet_version.h || { echo "error: src/garnet_version.h does not match VERSION ($$ver)"; exit 1; }; \
	 cnt=$$(grep -c "<string>$$ver</string>" Info.plist || true); \
	 [ "$$cnt" -eq 2 ] || { echo "error: Info.plist must carry <string>$$ver</string> twice (got $$cnt)"; exit 1; }
check-firmware:
	@if [ -n "$(FW_MISSING)" ]; then \
	  echo "error: missing required firmware in firmware/: $(addsuffix .bin,$(FW_MISSING))"; \
	  echo "       copy them from a linux-firmware checkout: tools/fetch-firmware.sh <path> (see BUILDING.md)"; exit 1; fi
.PHONY: check-firmware check-version

# Header dependency tracking (-MMD): a struct change in a shared header (e.g. DeviceContext
# in amdgpu_regs.h) must rebuild EVERY module, or the kext links objects with mismatched
# layouts. That exact accident produced the 0.0.6/0.0.7 builds on an earlier run.
$(BUILD)/%.o: %.cpp
	@mkdir -p $(dir $@)
	$(CXX) $(CXXFLAGS) -MMD -MP -c $< -o $@
$(BUILD)/%.o: %.c
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -MMD -MP -c $< -o $@
$(FW_GEN)/%.o: $(FW_GEN)/%.c
	$(CC) $(CFLAGS) -MMD -MP -c $< -o $@
# dcn41 -MMD so a change to the generated allowlist table or to
# dcn41_regs.h rebuilds every dcn41 object.
$(BUILD)/dcn41/%.o: $(DCN41_DIR)/%.c
	@mkdir -p $(BUILD)/dcn41
	$(CC) $(CFLAGS) -std=c11 -MMD -MP -c $< -o $@
$(DML21_C_OBJS): $(BUILD)/%.o: %.c $(DML21_DIR)/sources.mk
	@mkdir -p $(dir $@)
	$(CC) $(filter-out -mno-sse,$(CFLAGS)) $(DML21_FP_FLAGS) -std=c11 -MMD -MP -c $< -o $@
$(DML21_ADAPTER_OBJ): $(DML21_ADAPTER) $(DML21_DIR)/sources.mk
	@mkdir -p $(dir $@)
	$(CXX) $(filter-out -mno-sse,$(CXXFLAGS)) $(DML21_FP_FLAGS) -MMD -MP -c $< -o $@
-include $(OBJS:.o=.d) $(DML21_OBJS:.o=.d)

$(KEXT): $(OBJS) Info.plist
	@mkdir -p $(KEXT)/Contents/MacOS
	$(CXX) $(LDFLAGS) $(OBJS) -o $(EXEC)
	@# Verify zero undefined internal symbols that would silently prevent kernel loading.
	@$(NM) -u $(EXEC) > $(BUILD)/undefined-symbols.txt
	@bad=$$($(CXXFILT) < $(BUILD)/undefined-symbols.txt | grep -E 'Garnet|garnet::|RDNA4|amdgpu::|rdna4::|rdna4dcn::|rdna4fbprimary::|dcn41_' || true); \
	if [ -n "$$bad" ]; then \
	  echo "LINK ERROR: these symbols are OURS but undefined — the kext will not load:"; \
	  echo "$$bad" | sed 's/^/    /'; \
	  rm -f $(EXEC); exit 1; \
	fi
	cp Info.plist $(KEXT)/Contents/Info.plist
	find $(KEXT) \( -name '.DS_Store' -o -name '._*' \) -delete
ifeq ($(SIGN),1)
	# xattr -cr does NOT remove com.apple.FinderInfo from the bundle ROOT, and
	# codesign refuses any bundle carrying it ("resource fork, Finder information,
	# or similar detritus not allowed"). It reappears here from Finder/fileprovider
	# activity on the build directory, so the build failed intermittently and the
	# || fallback could not rescue it -- the fallback re-ran the same ineffective
	# xattr -cr. Strip it explicitly first; -d on a missing attribute is harmless.
	-xattr -d com.apple.FinderInfo $(KEXT) 2>/dev/null
	xattr -cr $(KEXT)
	codesign --force --sign - $(KEXT) || { xattr -d com.apple.FinderInfo $(KEXT) 2>/dev/null; xattr -cr $(KEXT); codesign --force --sign - $(KEXT); }
	@test -f $(KEXT)/Contents/_CodeSignature/CodeResources || { echo 'codesign produced no CodeResources'; exit 1; }
else ifeq ($(SIGN),0)
	@echo "Unsigned kext: for OpenCore injection; macOS kmutil loading requires separate validation."
else
	$(error SIGN must be 0 or 1)
endif
	@echo "Built $(KEXT) for $(ARCH) (min macOS $(DEPLOY))"

clean:
	rm -rf $(BUILD)
.PHONY: all clean
